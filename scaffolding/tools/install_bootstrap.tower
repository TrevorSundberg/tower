import tower;
import bootstrap_install;
import .library.bytes;
import .library.bytes_types;

extern fn puts(text: u8*): i32;

export fn main(argc: i32, argv: u8**): i32 {
    var arguments: i32 = 3; var usage: i32 = 2; var failure: i32 = 1;
    if argc != arguments { install_error("Usage: install_bootstrap BOOTSTRAP_DIRECTORY CACHE_DIRECTORY (Linux x64)"); return usage; }
    var compiler: ByteBuffer = default; defer bytes_dispose(&compiler);
    if !bootstrap_install(argv[1], argv[2], &compiler) { return failure; }
    puts(compiler.data); return 0;
}
