import tower;
import bootstrap_package;

extern fn puts(text: u8*): i32;

export fn main(argc: i32, argv: u8**): i32 {
    var normal_count: i32 = 6; var explicit_tools_count: i32 = 8;
    var usage: i32 = 2; var failure: i32 = 1;
    if argc != normal_count && argc != explicit_tools_count {
        puts("Usage: package_bootstrap COMPILER PREDECESSOR REPOSITORY NEW_OUTPUT_DIRECTORY BUILD_COMMAND [GIT LDD]");
        return usage;
    }
    var inputs: BootstrapInputs = { compiler: argv[1], predecessor: argv[2], repository: argv[3],
        output: argv[4], command: argv[5], git: "/usr/bin/git", ldd: "/usr/bin/ldd" };
    if argc == explicit_tools_count { inputs.git = argv[6]; inputs.ldd = argv[7]; }
    if !bootstrap_package(&inputs) {
        puts("Cannot package bootstrap candidate; inputs/tools must be readable and output must not exist.");
        return failure;
    }
    puts("Packaged Tower bootstrap candidate. Validate relocation and a clean successor before publishing the pin.");
    return 0;
}
