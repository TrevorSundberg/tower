import tower;
import target_pack;
import tool_files_posix;

extern fn puts(text: u8*): i32;

export fn main(argc: i32, argv: u8**): i32 {
    var arguments: i32 = 5; var usage: i32 = 2; var failure: i32 = 1;
    if argc != arguments {
        puts("Usage: package_targets RUNTIME_RESOURCE_DIRECTORY TARGET_DESCRIPTION_DIRECTORY CLANG OUTPUT_DIRECTORY");
        return usage;
    }
    var resources = realpath(argv[1], null); var descriptions = realpath(argv[2], null); var clang = realpath(argv[3], null);
    defer free(resources); defer free(descriptions); defer free(clang);
    if resources == null || descriptions == null || clang == null || !tool_directory(resources) || !tool_directory(descriptions) {
        puts("Target package inputs must exist"); return failure;
    }
    var pack: TargetPack = { resources: resources, descriptions: descriptions, clang: clang,
        output: argv[4], failure_status: failure, ..default };
    defer target_pack_close(&pack);
    if !target_pack_build(&pack) {
        puts("Target packaging failed; retained stage:");
        if pack.stage.data != null { puts(pack.stage.data); }
        return pack.failure_status;
    }
    puts("Built five runtime objects and minimal Windows/macOS import descriptions");
    return 0;
}
