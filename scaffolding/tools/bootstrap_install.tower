import tower;
import tool_files_posix;
import tool_files_linux;
import tool_read_beneath_linux;
import tool_streams_posix;
import tool_process_linux;
import .library.bytes;
import .library.bytes_types;
import .library.vector;
import .library.json_reader;
import .library.sha256;
import .library.gzip_decode;
import .library.tar_read;
import .library.tar_archive;
import .library.zip_archive;
import .library.archive_decode;
import .library.deflate;
import .compiler.host_text;
import .host.driver_files;

var InstallArchiveLimit: usize = 1073741824;
// Accept the writer's worst-case stored-block expansion plus gzip framing.
var InstallCompressedLimit: usize = InstallArchiveLimit
    + (InstallArchiveLimit / DeflateStoredLimit + 1) * DeflateStoredOverhead + GzipHeaderBytes + GzipTrailerBytes;
var InstallManifestLimit: usize = 16777216;
var InstallMemberLimit: usize = 8192;
var InstallHexBytes: usize = 64;
var InstallSchema: u64 = 1;
var InstallRegularMode: u32 = 420;
var InstallExecutableMode: u32 = 493;
struct InstallMember { name: u8*; hash: u8*; size: usize; }
struct InstallManifest {
    source: ByteBuffer; document: JsonDocument; members: vector(InstallMember);
    archive: u8*; hash: u8*;
}

fn install_error(text: u8*): bool {
    var stderr_stream: i32 = 2;
    write(stderr_stream, text, strlen(text)); write(stderr_stream, "\n", 1);
    return false;
}
fn install_manifest_dispose(manifest: InstallManifest*): void {
    vector_dispose(&manifest.members); json_dispose(&manifest.document); bytes_dispose(&manifest.source); *manifest = default;
}
fn install_string(document: JsonDocument*, node: usize): u8* {
    if node >= document.nodes.length || document.nodes.data[node].kind != JsonKind.String { return null; }
    var value = &document.nodes.data[node]; var text = document.strings.data + value.text;
    return strlen(text) == value.text_length ? text : null;
}
fn install_field(document: JsonDocument*, object: usize, key: u8*): usize { return json_find(document, object, key, strlen(key)); }
fn install_hash_valid(text: u8*): bool {
    if text == null || strlen(text) != InstallHexBytes { return false; }
    var zero: u8 = 48; var nine: u8 = 57; var lower_a: u8 = 97; var lower_f: u8 = 102;
    for (var at: usize = 0; at < InstallHexBytes; at++) {
        if !(text[at] >= zero && text[at] <= nine) && !(text[at] >= lower_a && text[at] <= lower_f) { return false; }
    }
    return true;
}
fn install_hash_matches(data: u8*, length: usize, hash: u8*): bool {
    var state: Sha256 = default; sha256_init(&state);
    if !sha256_update(&state, data, length) { return false; }
    var digest = sha256_finish(&state); var text: u8[65]; sha256_hex(&digest, &text[0]);
    return strcmp(&text[0], hash) == 0;
}
fn install_manifest_read(path: u8*, manifest: InstallManifest*): bool {
    var next: InstallManifest = default; defer install_manifest_dispose(&next);
    var limits: JsonLimits = { nodes: 65536, depth: 128, string_bytes: InstallManifestLimit };
    if !tool_read_file(path, InstallManifestLimit, &next.source)
        || json_parse(next.source.data, next.source.length, limits, &next.document).error != JsonError.Ok {
        return install_error("Cannot read a valid bootstrap JSON manifest.");
    }
    var document = &next.document; var schema: u64 = 0;
    var host = install_string(document, install_field(document, 0, "host"));
    if !json_u64(document, install_field(document, 0, "schema"), &schema) || schema != InstallSchema
        || host == null || strcmp(host, "linux-x64-ubuntu24-llvm19") != 0 { return install_error("Unsupported development bootstrap manifest."); }
    next.archive = install_string(document, install_field(document, 0, "archive"));
    next.hash = install_string(document, install_field(document, 0, "sha256"));
    if next.archive == null || !zip_name_valid(next.archive, strlen(next.archive)) || !install_hash_valid(next.hash) {
        return install_error("Invalid bootstrap archive path or hash.");
    }
    var files = install_field(document, 0, "files");
    if files == JsonNoNode || document.nodes.data[files].kind != JsonKind.Object { return install_error("Missing bootstrap members."); }
    var at = document.nodes.data[files].first_child; var total: usize = 0; var compiler = false;
    while at != JsonNoNode {
        var node = &document.nodes.data[at]; var name = document.strings.data + node.key;
        var hash = install_string(document, install_field(document, at, "sha256")); var size: u64 = 0;
        if next.members.length == InstallMemberLimit || strlen(name) != node.key_length || !zip_name_valid(name, node.key_length)
            || !install_hash_valid(hash) || !json_u64(document, install_field(document, at, "size"), &size)
            || size > convert(u64, InstallArchiveLimit - total) { return install_error("Invalid bootstrap member description."); }
        var candidate: TarEntry = { name: name, name_length: node.key_length, ..default };
        foreach (var &previous in &next.members) {
            var existing: TarEntry = { name: previous.name, name_length: strlen(previous.name), ..default };
            if tar_name_conflict(&candidate, &existing) { return install_error("Conflicting bootstrap member paths."); }
        }
        if !vector_reserve(&next.members, next.members.length + 1) { return install_error("Cannot allocate bootstrap manifest."); }
        next.members.data[next.members.length] = init(InstallMember) { name: name, hash: hash, size: convert(usize, size) };
        next.members.length++; total += convert(usize, size);
        if strcmp(name, "towerc") == 0 { compiler = true; }
        at = node.next;
    }
    if !compiler { return install_error("Bootstrap manifest has no compiler."); }
    install_manifest_dispose(manifest); *manifest = next; next = default; return true;
}

fn install_verify(directory: u8*, manifest: InstallManifest*): bool {
    var root = tool_open_directory(directory);
    if root < 0 { return false; }
    defer close(root);
    var data: ByteBuffer = default; defer bytes_dispose(&data);
    var owner_execute: u32 = 64;
    foreach (var &member in &manifest.members) {
        var mode: u32 = 0;
        if !tool_read_beneath(root, member.name, member.size, &data, &mode) || data.length != member.size
            || !install_hash_matches(data.data, data.length, member.hash)
            || strcmp(member.name, "towerc") == 0 && (mode & owner_execute) == 0 { return false; }
    }
    return true;
}
fn install_archive_verify(contents: TarContents*, manifest: InstallManifest*): bool {
    if contents.members.length != manifest.members.length { return false; }
    foreach (var &member in &contents.members) {
        var found = false;
        foreach (var &wanted in &manifest.members) {
            if strcmp(member.name.data, wanted.name) == 0 {
                if member.length != wanted.size || !install_hash_matches(member.data, member.length, wanted.hash) { return false; }
                found = true; break;
            }
        }
        if !found { return false; }
    }
    return true;
}

// Cleanup only our private mkdtemp directory and validated relative members.
// No recursive deletion of caller paths; no symlinks are created in this stage.
fn install_stage_dispose(stage: u8*, manifest: InstallManifest*): void {
    var path: ByteBuffer = default; defer bytes_dispose(&path);
    foreach (var &member in &manifest.members) { if tool_join(&path, stage, member.name) { remove(path.data); } }
    var root_length = strlen(stage); var slash: u8 = 47;
    foreach (var &member in &manifest.members) {
        if !tool_join(&path, stage, member.name) { continue; }
        for (var at = path.length; at > root_length; at--) {
            if path.data[at - 1] == slash { path.data[at - 1] = 0; rmdir(path.data); }
        }
    }
    rmdir(stage);
}
fn install_extract(cache: u8*, destination: u8*, archive: ByteBuffer*, manifest: InstallManifest*): bool {
    var decoded: ByteBuffer = default; var contents: TarContents = default;
    defer bytes_dispose(&decoded); defer tar_read_dispose(&contents);
    if gzip_decode(archive.data, archive.length, InstallArchiveLimit, &decoded) != ArchiveDecodeResult.Ok
        || tar_read(decoded.data, decoded.length, InstallMemberLimit, &contents) != ArchiveDecodeResult.Ok
        || !install_archive_verify(&contents, manifest) { return install_error("Invalid bootstrap archive members or checksums."); }
    var stage: ByteBuffer = default; var path: ByteBuffer = default;
    defer bytes_dispose(&stage); defer bytes_dispose(&path);
    if !tool_join(&stage, cache, "install_XXXXXX") || mkdtemp(stage.data) == null { return install_error("Cannot create bootstrap staging directory."); }
    var published = false;
    defer { if !published { install_stage_dispose(stage.data, manifest); } }
    foreach (var &member in &contents.members) {
        var mode = strcmp(member.name.data, "towerc") == 0 ? InstallExecutableMode : InstallRegularMode;
        if !tool_join(&path, stage.data, member.name.data) || !tool_output_parents(path.data)
            || !driver_write_file(path.data, member.data, member.length) || chmod(path.data, mode) != 0 {
            return install_error("Cannot write bootstrap member.");
        }
    }
    if !install_verify(stage.data, manifest) { return install_error("Staged bootstrap verification failed."); }
    published = tool_publish_directory(stage.data, destination);
    // A concurrent successful installer may have published the same digest.
    if !published && tool_file_kind(destination, false) != ToolFileKind.Directory { return install_error("Cannot publish bootstrap installation."); }
    return true;
}

fn bootstrap_install(root: u8*, cache: u8*, compiler: ByteBuffer*): bool {
    var manifest: InstallManifest = default; var path: ByteBuffer = default;
    var archive: ByteBuffer = default; var destination: ByteBuffer = default; var result: ByteBuffer = default;
    defer install_manifest_dispose(&manifest); defer bytes_dispose(&path); defer bytes_dispose(&archive);
    defer bytes_dispose(&destination); defer bytes_dispose(&result);
    var resolved_root = realpath(root, null);
    if resolved_root == null { return install_error("Cannot resolve bootstrap directory."); }
    defer free(resolved_root);
    if !tool_join(&path, resolved_root, "development.json") || !install_manifest_read(path.data, &manifest) { return false; }
    if !tool_join(&path, resolved_root, manifest.archive) { return false; }
    var resolved_archive = realpath(path.data, null);
    if resolved_archive == null { return install_error("Cannot resolve bootstrap archive."); }
    defer free(resolved_archive);
    var root_length = strlen(resolved_root); var archive_length = strlen(resolved_archive); var slash: u8 = 47;
    if archive_length <= root_length || root_length != 1 && resolved_archive[root_length] != slash {
        return install_error("Bootstrap archive must stay inside bootstrap directory.");
    }
    for (var at: usize = 0; at < root_length; at++) {
        if resolved_root[at] != resolved_archive[at] { return install_error("Bootstrap archive must stay inside bootstrap directory."); }
    }
    if !tool_read_file(resolved_archive, InstallCompressedLimit, &archive)
        || !install_hash_matches(archive.data, archive.length, manifest.hash) { return install_error("Bootstrap archive checksum mismatch."); }
    if !tool_join(&path, cache, "cache_directory") || !tool_output_parents(path.data) { return install_error("Cannot create bootstrap cache."); }
    var resolved_cache = realpath(cache, null);
    if resolved_cache == null { return install_error("Cannot resolve bootstrap cache."); }
    defer free(resolved_cache);
    if !tool_join(&destination, resolved_cache, manifest.hash) { return false; }
    var kind = tool_file_kind(destination.data, false);
    if kind == ToolFileKind.Missing {
        if !install_extract(resolved_cache, destination.data, &archive, &manifest) { return false; }
    } else { if kind != ToolFileKind.Directory { return install_error("Bootstrap cache destination is not a directory."); } }
    if !install_verify(destination.data, &manifest) { return install_error("Cached bootstrap member verification failed."); }
    if !tool_join(&result, destination.data, "towerc") { return false; }
    bytes_dispose(compiler); *compiler = result; result = default; return true;
}
