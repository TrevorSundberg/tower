import tower;
import .library.vector;

// Explicit Linux process ABI. Arguments borrow caller-owned, NUL-terminated
// strings until synchronous completion. No PATH lookup or shell interpretation.
enum ToolProcessKind: i32 { Exited, Signaled, PipeFailed, ForkFailed, ExecFailed, WaitFailed, ReadFailed, RedirectFailed }
struct ToolProcessResult {
    kind: ToolProcessKind;
    exit_code: i32;
    signal: i32;
    error: i32;
}
struct ToolPipe { reader: i32; writer: i32; }
struct ToolLaunchFailure { error: i32; kind: ToolProcessKind; }

extern fn pipe2(descriptors: i32*, flags: i32): i32;
extern fn fork(): i32;
extern fn execv(file: u8*, args: u8**): i32;
extern fn _exit(code: i32): void;
extern fn waitpid(pid: i32, status: i32*, options: i32): i32;
extern fn close(fd: i32): i32;
extern fn read(fd: i32, data: u8*, length: usize): i64;
extern fn write(fd: i32, data: u8*, length: usize): i64;
extern fn __errno_location(): i32*;
extern fn dup2(source: i32, destination: i32): i32;

// A typed boundary also keeps literal arguments out of generic deduction in
// the current published bootstrap, which otherwise duplicates their bytes.
fn tool_process_argument(args: vector(u8*)*, text: u8*): bool {
    return vector_push(args, text);
}

fn tool_process(executable: u8*, args: u8**): ToolProcessResult {
    var inherit_stdout: i32 = -1;
    return tool_process_output(executable, args, inherit_stdout);
}

// An explicit nonnegative descriptor redirects stdout. The caller retains its
// descriptor; the child closes its extra copy before exec. Stderr is inherited.
fn tool_process_output(executable: u8*, args: u8**, output: i32): ToolProcessResult {
    var inherit_stderr: i32 = -1;
    return tool_process_streams(executable, args, output, inherit_stderr);
}

// Separate file descriptors avoid pipe backpressure for diagnostic captures.
// Redirected stderr must not borrow stdout, which may already be redirected.
// Descriptors remain caller-owned; the child closes only extra descriptor copies.
fn tool_process_streams(executable: u8*, args: u8**, output: i32, error_output: i32): ToolProcessResult {
    var stdout_stream: i32 = 1; var stderr_stream: i32 = 2;
    var invalid_argument: i32 = 22;
    if error_output == stdout_stream {
        return init(ToolProcessResult) { kind: ToolProcessKind.RedirectFailed, error: invalid_argument, ..default };
    }
    var close_on_exec: i32 = 524288;
    var interrupted: i32 = 4;
    var io_error: i32 = 5;
    var cannot_exec: i32 = 127;
    var pipe: ToolPipe = default;
    if pipe2(&pipe.reader, close_on_exec) != 0 {
        return init(ToolProcessResult) { kind: ToolProcessKind.PipeFailed, error: *__errno_location(), ..default };
    }
    var pid = fork();
    if pid == 0 {
        close(pipe.reader);
        var failure: ToolLaunchFailure = { kind: ToolProcessKind.ExecFailed, ..default };
        var last_standard_stream = stderr_stream;
        if (output >= 0 && dup2(output, stdout_stream) < 0)
            || (error_output >= 0 && dup2(error_output, stderr_stream) < 0) { failure.kind = ToolProcessKind.RedirectFailed; }
        else {
            if output > last_standard_stream { close(output); }
            if error_output > last_standard_stream && error_output != output { close(error_output); }
            execv(executable, args);
        }
        failure.error = *__errno_location();
        var sent: usize = 0;
        while sent < sizeof(ToolLaunchFailure) {
            var count = write(pipe.writer, bits(u8*, &failure) + sent, sizeof(ToolLaunchFailure) - sent);
            if count < 0 && *__errno_location() == interrupted { continue; }
            if count <= 0 { break; }
            sent += convert(usize, count);
        }
        _exit(cannot_exec);
    }
    var fork_error = *__errno_location();
    close(pipe.writer);
    if pid < 0 {
        close(pipe.reader);
        return init(ToolProcessResult) { kind: ToolProcessKind.ForkFailed, error: fork_error, ..default };
    }
    var failure: ToolLaunchFailure = default;
    var read_error: i32 = 0;
    var received: usize = 0;
    while received < sizeof(ToolLaunchFailure) {
        var count = read(pipe.reader, bits(u8*, &failure) + received, sizeof(ToolLaunchFailure) - received);
        if count < 0 {
            if *__errno_location() == interrupted { continue; }
            read_error = *__errno_location();
            break;
        }
        if count == 0 { break; }
        received += convert(usize, count);
    }
    close(pipe.reader);
    var status: i32 = 0;
    loop {
        var waited = waitpid(pid, &status, 0);
        if waited == pid { break; }
        if waited < 0 && *__errno_location() == interrupted { continue; }
        return init(ToolProcessResult) { kind: ToolProcessKind.WaitFailed, error: *__errno_location(), ..default };
    }
    if received != 0 && received != sizeof(ToolLaunchFailure) { read_error = io_error; }
    if read_error != 0 { return init(ToolProcessResult) { kind: ToolProcessKind.ReadFailed, error: read_error, ..default }; }
    if failure.error != 0 { return init(ToolProcessResult) { kind: failure.kind, error: failure.error, ..default }; }
    var signal_mask: i32 = 127;
    var exit_shift: i32 = 8;
    var exit_mask: i32 = 255;
    var signal = status & signal_mask;
    if signal != 0 { return init(ToolProcessResult) { kind: ToolProcessKind.Signaled, signal: signal, ..default }; }
    return init(ToolProcessResult) { kind: ToolProcessKind.Exited, exit_code: (status >> exit_shift) & exit_mask, ..default };
}

fn tool_process_status(result: ToolProcessResult): i32 {
    var signal_base: i32 = 128;
    var failure: i32 = 1;
    if result.kind == ToolProcessKind.Exited { return result.exit_code; }
    if result.kind == ToolProcessKind.Signaled { return signal_base + result.signal; }
    return failure;
}
