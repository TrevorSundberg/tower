import tower;
import .compiler.utf8;
import .backend.wasm_bytes;
import .backend.wasm_link_types;
import .backend.wasm_link_prepare;
import .backend.wasm_link_options;
import .backend.wasm_link;
import .library.entities;
import .library.entity_types;
import .library.bytes;
import .library.bytes_types;
import .host.driver_files;

extern fn puts(text: u8*): i32;
extern fn abort(): void;
export fn tower_entity_finalize(lifecycle: usize, component: EntityComponent*, data: u8*): void { abort(); }

fn wasm_cli_read(link: WasmLink*, name: u8*, output: WasmBytes*): bool {
    var bytes: ByteBuffer = default;
    if !driver_read_file(name, &bytes) { return wasm_link_fail(link, WasmLinkError.Input, wasm_text_bytes(name)); }
    if !wasm_link_push(link, &link.owned, bytes) { bytes_dispose(&bytes); return false; }
    *output = init(WasmBytes) { data: bytes.data, length: bytes.length };
    return true;
}

fn wasm_cli_options(link: WasmLink*, argc: i32, argv: u8**, output: u8**): bool {
    var options: WasmLinkOptions = default;
    for (var at: i32 = 1; at < argc; at++) {
        var item: WasmLinkOption = default;
        if !wasm_link_option(link, &options, wasm_text_bytes(argv[at]), &item) { return false; }
        if item.action == WasmOptionAction.None { continue; }
        var bytes: WasmBytes = default;
        // Actions name either an entire argv string or its suffix, both NUL
        // terminated here. The backend's byte-plan adapter needs no terminator.
        if !wasm_cli_read(link, item.name.data, &bytes) || !wasm_link_option_bytes(link, &item, bytes) { return false; }
    }
    if options.output.length == 0 { return wasm_link_fail(link, WasmLinkError.Input, wasm_text_bytes("provide -o output.wasm")); }
    *output = options.output.data;
    return wasm_link_options_finish(link, &options);
}

export fn main(argc: i32, argv: u8**): i32 {
    var link: WasmLink = default;
    defer wasm_link_close(&link);
    var output: u8* = null;
    if !wasm_link_init(&link) || !wasm_cli_options(&link, argc, argv, &output) || !wasm_link_run(&link) {
        puts(wasm_link_message(link.error));
        var name: ByteBuffer = default;
        if bytes_assign_text(&name, link.error_name.data, link.error_name.length) { puts(name.data); }
        bytes_dispose(&name);
        if link.world.error != WasmReadError.None { puts(wasm_read_message(link.world.error)); print(link.world.error_offset); }
        return 1;
    }
    if !driver_write_file(output, link.output.data, link.output.length) { puts("Cannot write linked Wasm image"); return 1; }
    if link.warnings.length != 0 { puts("Typed unreachable stubs emitted for incompatible function declarations:"); print(link.warnings.length); }
    return 0;
}
