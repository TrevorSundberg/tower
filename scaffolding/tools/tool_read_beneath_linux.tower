import tower;
import tool_files_posix;
import tool_files_linux;
import tool_process_linux;
import tool_streams_posix;
import .library.bytes;
import .library.bytes_types;
import .library.zip_archive;
import .host.driver_files;

extern fn openat(directory: i32, path: u8*, flags: i32): i32;
extern fn fdopen(descriptor: i32, mode: u8*): void*;
extern fn chmod(path: u8*, mode: u32): i32;

var ToolOpenReadOnly: i32 = 0;
var ToolOpenDirectory: i32 = 65536;
var ToolOpenNoFollow: i32 = 131072;
var ToolOpenCloseOnExec: i32 = 524288;
var ToolOpenNonblocking: i32 = 2048;
var ToolCurrentDirectory: i32 = -100;

fn tool_open_directory(path: u8*): i32 {
    return openat(ToolCurrentDirectory, path, ToolOpenReadOnly | ToolOpenDirectory | ToolOpenNoFollow | ToolOpenCloseOnExec);
}
fn tool_descriptor_mode(descriptor: i32, mode: u32*): bool {
    var status: u64[32]; // Linux statx: 256 bytes, eight-byte alignment.
    var empty_path: i32 = 4096; var type_and_mode: u32 = 3; var mode_offset: usize = 28; var byte_bits: u32 = 8;
    if statx(descriptor, "", empty_path, type_and_mode, bits(void*, &status[0])) != 0 { return false; }
    var data = bits(u8*, &status[0]);
    if (convert(u32, data[0]) & type_and_mode) != type_and_mode { return false; }
    *mode = convert(u32, data[mode_offset]) | (convert(u32, data[mode_offset + 1]) << byte_bits);
    return true;
}

// Follow no member-path symlinks, including parent directories. Each open is
// relative to a retained directory descriptor, without a lstat/open race.
// Caller retains root. A successful regular-file read atomically publishes
// bytes and mode from the opened file; no PATH/cwd/environment mutation.
fn tool_read_beneath(root: i32, relative: u8*, limit: usize, out: ByteBuffer*, mode: u32*): bool {
    var length = strlen(relative);
    if !zip_name_valid(relative, length) { return false; }
    var directory_flags = ToolOpenReadOnly | ToolOpenDirectory | ToolOpenNoFollow | ToolOpenCloseOnExec;
    var directory = openat(root, ".", directory_flags);
    if directory < 0 { return false; }
    defer close(directory);
    var component: ByteBuffer = default; var next: ByteBuffer = default;
    defer bytes_dispose(&component); defer bytes_dispose(&next);
    var start: usize = 0; var slash: u8 = 47;
    for (var at: usize = 0; at < length; at++) {
        if relative[at] != slash { continue; }
        if !bytes_assign_text(&component, relative + start, at - start) { return false; }
        var child = openat(directory, component.data, directory_flags);
        if child < 0 { return false; }
        close(directory); directory = child; start = at + 1;
    }
    if !bytes_assign_text(&component, relative + start, length - start) { return false; }
    // A substituted FIFO must not block before its type can be rejected.
    var descriptor = openat(directory, component.data, ToolOpenReadOnly | ToolOpenNoFollow | ToolOpenCloseOnExec | ToolOpenNonblocking);
    if descriptor < 0 { return false; }
    var observed_mode: u32 = 0; var type_mask: u32 = 61440; var regular: u32 = 32768;
    if !tool_descriptor_mode(descriptor, &observed_mode) || (observed_mode & type_mask) != regular { close(descriptor); return false; }
    var file = fdopen(descriptor, "rb");
    if file == null { close(descriptor); return false; }
    var ok = tool_read_stream(file, limit, &next);
    if fclose(file) != 0 { ok = false; }
    if !ok { return false; }
    bytes_dispose(out); *out = next; next = default; *mode = observed_mode;
    return true;
}
