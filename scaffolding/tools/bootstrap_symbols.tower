import tower;

// These are reviewed cross-unit imports, not a wildcard permission for native
// implementations. Compare each compiler component's emitted object closure.
enum BootstrapUnit: i32 { Unknown, Utf8, Bytes, Entities, ParserNodes, Host, Interpreter, Semantics, ParserFormat, TemplateBuild }
enum SymbolByte: u8 { Nul = 0, Tab = 9, LF = 10, CR = 13, Space = 32, Underscore = 95 }
struct BootstrapSymbol { data: u8*; length: usize; }

extern fn strlen(text: u8*): usize;
extern fn memcmp(left: u8*, right: u8*, count: usize): i32;
extern fn strcmp(left: u8*, right: u8*): i32;
extern fn strstr(text: u8*, needle: u8*): u8*;

fn bootstrap_unit(name: u8*): BootstrapUnit {
    if strcmp(name, "utf8") == 0 { return BootstrapUnit.Utf8; }
    if strcmp(name, "bytes") == 0 { return BootstrapUnit.Bytes; }
    if strcmp(name, "entities") == 0 { return BootstrapUnit.Entities; }
    if strcmp(name, "parser-nodes") == 0 { return BootstrapUnit.ParserNodes; }
    if strcmp(name, "host") == 0 { return BootstrapUnit.Host; }
    if strcmp(name, "interpreter") == 0 { return BootstrapUnit.Interpreter; }
    if strcmp(name, "semantics") == 0 { return BootstrapUnit.Semantics; }
    if strcmp(name, "parser-format") == 0 { return BootstrapUnit.ParserFormat; }
    if strcmp(name, "template-build") == 0 { return BootstrapUnit.TemplateBuild; }
    return BootstrapUnit.Unknown;
}

fn bootstrap_symbol_space(byte: u8): bool {
    return byte == convert(u8, SymbolByte.Space) || byte == convert(u8, SymbolByte.Tab)
        || byte == convert(u8, SymbolByte.LF) || byte == convert(u8, SymbolByte.CR);
}

// Exact whitespace-delimited membership; prefixes and suffixes are not symbols.
fn bootstrap_symbol_in(names: u8*, symbol: u8*, length: usize): bool {
    var at: usize = 0;
    while names[at] != convert(u8, SymbolByte.Nul) {
        while bootstrap_symbol_space(names[at]) { at++; }
        var begin = at;
        while names[at] != convert(u8, SymbolByte.Nul) && !bootstrap_symbol_space(names[at]) { at++; }
        if at != begin && at - begin == length && memcmp(names + begin, symbol, length) == 0 { return true; }
    }
    return false;
}

fn bootstrap_symbol_allowed(unit: BootstrapUnit, windows: bool, wasm: bool, symbol: u8*, length: usize): bool {
    // Mach-O/COFF/Wasm spellings may prefix underscores. Preserve the previous
    // check's normalization, including __stack_pointer and __memory_base.
    while length != 0 && *symbol == convert(u8, SymbolByte.Underscore) { symbol++; length--; }
    if unit == BootstrapUnit.Unknown || unit == BootstrapUnit.Utf8 || length == 0 { return false; }
    if bootstrap_symbol_in("tower_reallocate tower_deallocate memcpy memmove memset bzero stack_pointer memory_base", symbol, length) { return true; }
    // Parser/semantic jobs use typed function values. Wasm supplies the indirect
    // table and its relocation base; neither is an external implementation.
    if wasm && (unit == BootstrapUnit.ParserNodes || unit == BootstrapUnit.Semantics)
        && bootstrap_symbol_in("indirect_function_table table_base", symbol, length) { return true; }
    // Entity budget gates and interpreter calls use the target's function table.
    if wasm && (unit == BootstrapUnit.Entities || unit == BootstrapUnit.Interpreter)
        && bootstrap_symbol_in("indirect_function_table", symbol, length) { return true; }
    // Current ECS/query workers call these Tower host transports. Keep their
    // exact interfaces explicit; never allow an arbitrary work_* dependency.
    if unit == BootstrapUnit.Entities || unit == BootstrapUnit.ParserNodes || unit == BootstrapUnit.Semantics {
        if bootstrap_symbol_in("work_signal_close work_signal_post work_signal_try work_signal_wait work_thread_capacity work_thread_close", symbol, length) { return true; }
    }
    if unit == BootstrapUnit.Entities || unit == BootstrapUnit.ParserNodes {
        if bootstrap_symbol_in("tower_trap", symbol, length) { return true; }
    }
    // Windows probes the host file reader, parallel LR builders and semantic
    // runner/float parser stacks. This does not establish a bundled runtime.
    if windows && (unit == BootstrapUnit.Host || unit == BootstrapUnit.ParserNodes || unit == BootstrapUnit.Semantics)
        && bootstrap_symbol_in("chkstk", symbol, length) { return true; }
    if unit == BootstrapUnit.ParserNodes || unit == BootstrapUnit.Semantics {
        if bootstrap_symbol_in("work_signal_open work_thread_available work_thread_open compiler_node_get compiler_node_world compiler_world_worker_limit", symbol, length) { return true; }
    }
    if unit == BootstrapUnit.Interpreter {
        // The mutually exclusive interpreter/evaluation entries own Publish;
        // semantic lookups and the shared arena retain their existing owners.
        if bootstrap_symbol_in("sem_context_snapshot sem_entry_arena sem_evaluation_get sem_find sem_known_binding sem_query_input_checked work_arena_dispose", symbol, length) { return true; }
        // Physical input/storage owners use the source world's shared budget.
        if bootstrap_symbol_in("compiler_buffer_alignment compiler_buffer_allocate compiler_buffer_allocation_size compiler_buffer_free compiler_node_world compiler_world_bind_budget compiler_world_work_budget", symbol, length) { return true; }
        // The configured interpreter unit also owns the upstream staged-call
        // continuation fixture; its world and Foundation builders are Tower.
        if bootstrap_symbol_in("compiler_world_create_result compiler_world_create_workers compiler_world_dispose compiler_world_store entity_component_add entity_create entity_register entity_release puts sem_attach sem_create tower_node_create", symbol, length) { return true; }
        if bootstrap_symbol_in("format_dispose format_unsigned foundation_execution_item foundation_execution_reference strcmp strlen", symbol, length) { return true; }
        return bootstrap_symbol_in("abort tower_allocate tower_trap im_append im_fail im_foreign im_has_foreign im_missing_foreign", symbol, length)
            || bootstrap_symbol_in("im_pointer_bytes im_root sem_get semantic_alignment semantic_mask semantic_signed semantic_size", symbol, length)
            || bootstrap_symbol_in("entity_component_data entity_component_get semantic_float semantic_width semantic_type_equal sem_require", symbol, length);
    }
    if unit == BootstrapUnit.Host {
        return bootstrap_symbol_in("malloc realloc free tower_allocate abort bytes_reserve bytes_push bytes_append bytes_dispose tower_utf8_validate", symbol, length)
            || bootstrap_symbol_in("fopen fread fwrite ferror feof fclose closedir opendir readdir strcmp", symbol, length);
    }
    if unit == BootstrapUnit.Entities {
        if bootstrap_symbol_in("compiler_buffer_alignment compiler_buffer_allocate compiler_buffer_allocation_size compiler_buffer_free", symbol, length) { return true; }
        return bootstrap_symbol_in("compiler_entity_store abort tower_allocate tower_entity_finalize compiler_node_label", symbol, length)
            || bootstrap_symbol_in("compiler_name_is compiler_name_equal compiler_node_copy_metadata compiler_generic_type compiler_component_add", symbol, length)
            || bootstrap_symbol_in("bytes_assign_text compiler_host_world foundation_node_init node_match_id node_match_label node_match_length node_match_rule", symbol, length)
            || bootstrap_symbol_in("node_match_set_id node_match_set_label node_match_set_length node_match_set_rule node_match_set_start node_match_start", symbol, length)
            || bootstrap_symbol_in("node_payload_init node_range_end node_range_set_end node_range_set_start node_range_start node_reference_capture", symbol, length)
            || bootstrap_symbol_in("node_reference_name node_reference_set_capture node_reference_set_name node_rule_generated node_rule_name", symbol, length)
            || bootstrap_symbol_in("node_rule_set_generated node_rule_set_name node_string_append node_string_data node_string_length node_string_resize", symbol, length)
            || bootstrap_symbol_in("node_string_set syntax_identifier_decode_in_place syntax_node_init syntax_nodes_equal tower_utf8_decode tower_utf8_encode", symbol, length);
    }
    if unit == BootstrapUnit.ParserNodes {
        // Diagnostic text retains the ParserFormat provider's buffer result.
        if bootstrap_symbol_in("parser_presentation_buffer_result", symbol, length) { return true; }
        if bootstrap_symbol_in("parser_structure_cache_copy parser_structure_cache_dispose", symbol, length) { return true; }
        // Configured module startup fixtures consume world and unit ownership.
        if bootstrap_symbol_in("compiler_world_create_result frontend_units_close frontend_units_create_bounded_result", symbol, length) { return true; }
        // Grammar admission retains exact results from the existing entities unit.
        if bootstrap_symbol_in("compiler_world_type_result entity_attach_result entity_component_add_result entity_create_related_result entity_create_result entity_view_open_result", symbol, length) { return true; }
        // Grammar snapshots use the world ledger and the entities arena provider.
        if bootstrap_symbol_in("compiler_buffer_alignment compiler_buffer_allocation_size compiler_world_bind_budget work_arena_allocate work_arena_allocate_result work_arena_dispose work_arena_init", symbol, length) { return true; }
        // Table buffers share the world ledger; frontend unit lifecycle and
        // configured parser fixtures retain explicit world/store boundaries.
        if bootstrap_symbol_in("compiler_world_create compiler_world_create_workers compiler_world_dispose compiler_world_work_budget entity_store_component_count entity_store_count", symbol, length) { return true; }
        // Source emitters consume the same checked Foundation through explicit
        // read-only queries; their code no longer expands the semantics unit.
        if bootstrap_symbol_in("sem_get sem_name sem_equal sem_require frontend_source_length semantic_aggregate semantic_alignment semantic_float semantic_size semantic_width", symbol, length) { return true; }
        return bootstrap_symbol_in("parse_forest_create parse_forest_create_result parse_forest_resource_error parse_forest_destroy tower_utf8_validate syntax_scan_highlight", symbol, length)
            || bootstrap_symbol_in("syntax_replacement_begin syntax_replacement_capture syntax_replacement_attempt syntax_replacement_diagnostic", symbol, length)
            || bootstrap_symbol_in("syntax_replacement_offset syntax_replacement_select syntax_replacement_commit entity_id entity_replace_child", symbol, length)
            || bootstrap_symbol_in("entity_take_last_child entity_child_name syntax_expansion_history syntax_expansion_previous syntax_expansion_trace", symbol, length)
            || bootstrap_symbol_in("syntax_expansion_origin syntax_expansion_copy_origin syntax_expansion_origin_result syntax_expansion_copy_origin_result syntax_expansion_trace_result tower_utf8_decode tower_allocate compiler_grammar_root", symbol, length)
            || bootstrap_symbol_in("compiler_grammar_rule compiler_grammar_reference compiler_grammar_literal compiler_grammar_range", symbol, length)
            || bootstrap_symbol_in("entity_component_get entity_component_data entity_component_add entity_member_index entity_create_related", symbol, length)
            || bootstrap_symbol_in("entity_attach entity_child_at entity_child_count entity_parent entity_release entity_retain compiler_parse_match", symbol, length)
            || bootstrap_symbol_in("parse_forest_leaf parse_forest_join parse_forest_attach parse_forest_take bytes_assign_text bytes_append", symbol, length)
            || bootstrap_symbol_in("core_component_type semantic_builtin_name semantic_operator semantic_scalar_name semantic_signed semantic_mask", symbol, length)
            || bootstrap_symbol_in("abort compiler_clone_tree compiler_clone_tree_result compiler_host_world compiler_world_component compiler_world_get compiler_world_grammar", symbol, length)
            || bootstrap_symbol_in("compiler_world_pinned compiler_world_store compiler_world_type entity_create entity_register fclose ferror fopen", symbol, length)
            || bootstrap_symbol_in("format_parser_host_text format_parser_label_text fread fwrite module_file_case_matches parse_forest_visits", symbol, length)
            || bootstrap_symbol_in("parser_match_get_type parser_presentation_text parser_trace_step semantic_enum semantic_source_comments", symbol, length)
            || bootstrap_symbol_in("syntax_capture_comments syntax_component_type syntax_create syntax_destroy syntax_get_error syntax_get_error_offset", symbol, length)
            || bootstrap_symbol_in("syntax_next syntax_parser_diagnostic_read syntax_parser_read syntax_parser_template_read syntax_reset syntax_trace_release", symbol, length)
            || bootstrap_symbol_in("tower_memory_allocate tower_memory_free tower_node_create", symbol, length)
            || bootstrap_symbol_in("compiler_buffer_allocate compiler_buffer_free entity_view_close entity_view_open format_same_tree format_same_tree_result format_syntax_description format_syntax_origin format_syntax_diagnostic", symbol, length)
            || bootstrap_symbol_in("parser_table_destroy parser_table_finish parser_table_finish_result parser_table_finish_buffer_result parser_table_open parser_table_open_result syntax_description_text syntax_diagnostic_text_finish", symbol, length)
            || bootstrap_symbol_in("syntax_host_clear syntax_origin_text tower_node_attach tower_node_get_child_member work_kernel_execute work_thread_retention", symbol, length);
    }
    // Separate native objects: reviewed nm closures, not ParserNodes imports.
    // Target-only runtime additions require their own observed object evidence.
    if unit == BootstrapUnit.ParserFormat {
        return bootstrap_symbol_in("compiler_buffer_alignment compiler_buffer_allocate compiler_buffer_allocation_size compiler_buffer_free compiler_node_get", symbol, length)
            || bootstrap_symbol_in("entity_child_at entity_child_count entity_child_index entity_child_name entity_component_data entity_component_get entity_parent", symbol, length)
            || bootstrap_symbol_in("format_bytes format_char format_dispose format_entity format_match format_repeat format_text format_unsigned format_write", symbol, length)
            || bootstrap_symbol_in("lr_grammar_missing_count lr_grammar_missing_name lr_grammar_name lr_grammar_name_count lr_grammar_rule_count lr_grammar_rule_data lr_grammar_symbol_count lr_grammar_symbol_data", symbol, length)
            || bootstrap_symbol_in("lr_runtime_action_count lr_runtime_actions lr_runtime_conflict lr_runtime_goto_count lr_runtime_goto_data", symbol, length)
            || bootstrap_symbol_in("parser_table_non_terminal_id_to_string_result parser_table_rule_next putchar puts syntax_nodes_equal syntax_nodes_equal_result syntax_parser_describe syntax_parser_token_name_result syntax_parser_describe_into syntax_parser_token_name_into syntax_source_location", symbol, length)
            || bootstrap_symbol_in("tower_allocate tower_trap tower_utf8_encode", symbol, length);
    }
    if unit == BootstrapUnit.TemplateBuild {
        return bootstrap_symbol_in("bytes_append compiler_buffer_free compiler_node_world tower_trap", symbol, length)
            || bootstrap_symbol_in("entity_attach entity_child_at entity_component_data entity_component_get entity_member_index entity_release entity_retain", symbol, length)
            || bootstrap_symbol_in("format_dispose format_entity frontend_revision_release frontend_revision_retain", symbol, length)
            || bootstrap_symbol_in("parser_recognizer_create_result parser_recognizer_destroy parser_recognizer_get_error parser_recognizer_resource_error parser_recognizer_step", symbol, length)
            || bootstrap_symbol_in("parser_stream_create parser_stream_destroy parser_stream_get_userdata parser_table_finish_result parser_table_finish_buffer_result parser_table_grammar parser_table_open_result", symbol, length)
            || bootstrap_symbol_in("syntax_destroy syntax_emission_find_index syntax_emission_keyword_count syntax_emission_keywords syntax_emission_production_count syntax_emission_productions syntax_emission_repetition_count syntax_emission_repetitions syntax_emission_wrapper syntax_pending_contains", symbol, length)
            || bootstrap_symbol_in("syntax_replacement_candidate syntax_replacement_error syntax_replacement_host syntax_replacement_inspect syntax_replacement_resource_fail syntax_replacement_sequence syntax_replacement_tree", symbol, length)
            || bootstrap_symbol_in("syntax_revision_reference syntax_revision_rule syntax_session_allocate syntax_session_allocate_result syntax_session_diagnostic_result syntax_session_diagnostic_buffer_result syntax_session_inputs_source syntax_session_pin_revision syntax_session_pin_version syntax_session_progress", symbol, length)
            || bootstrap_symbol_in("syntax_template_holes_revision_result syntax_template_remap_revisions_result syntax_version_create_result syntax_version_lexicon_result syntax_version_release syntax_version_seed_result", symbol, length);
    }
    if unit == BootstrapUnit.Semantics {
        // Checked semantic admission and module startup retain provider causes.
        if bootstrap_symbol_in("compiler_world_component_result entity_attach_result entity_component_add_result entity_create_related_result entity_create_result frontend_module_root_world_size_result", symbol, length) { return true; }
        // Generic publication and executable preparation consume the entities
        // unit's per-call stage outcomes, including typed lease admission.
        if bootstrap_symbol_in("entity_stage_open_result entity_stage_publish_result entity_stage_hold_result entity_stage_lease_result entity_view_open_result", symbol, length) { return true; }
        if bootstrap_symbol_in("generic_begin_result generic_register_result generic_instantiate_result generic_instantiate_deferred_result", symbol, length) { return true; }
        if bootstrap_symbol_in("compiler_buffer_alignment compiler_buffer_allocate compiler_buffer_allocation_size compiler_buffer_free semantic_known_publish_kernel work_arena_allocate_result work_arena_dispose work_arena_init", symbol, length) { return true; }
        if bootstrap_symbol_in("frontend_module_resource_error syntax_session_resource_error", symbol, length) { return true; }
        // Nested workers reserve the same world budget; source construction and
        // foreign ABI validation call their existing Tower component owners.
        if bootstrap_symbol_in("compiler_unit_kernel compiler_world_work_budget compiler_world_worker_release compiler_world_worker_reserve frontend_module_root_world_size type_object_abi_safe", symbol, length) { return true; }
        // Staged helper preparation uses the shared query plan and deferred
        // generic body exports; these are Tower implementations.
        if bootstrap_symbol_in("compiler_work_plan generic_body_cost generic_instantiate_deferred", symbol, length) { return true; }
        // Attribute aggregate staging reads interpreter-owned bytes and validates
        // function-reference relocation through these ordinary Tower exports.
        if bootstrap_symbol_in("interpreter_function_result interpreter_type_result ix_load", symbol, length) { return true; }
        return bootstrap_symbol_in("syntax_create syntax_destroy syntax_next syntax_get_error syntax_get_revision syntax_get_error_offset bytes_append", symbol, length)
            || bootstrap_symbol_in("tower_allocate tower_trap sem_match core_component_type abort entity_component_get entity_component_data", symbol, length)
            || bootstrap_symbol_in("entity_component_add entity_register tower_node_create entity_attach entity_release entity_child_at entity_child_count", symbol, length)
            || bootstrap_symbol_in("entity_parent entity_member_index foundation_node_init syntax_identifier_decode_in_place generic_begin generic_error generic_error_clear", symbol, length)
            || bootstrap_symbol_in("generic_register generic_parameter_count generic_type_parameter generic_instantiate generic_lookup generic_type_result", symbol, length)
            || bootstrap_symbol_in("generic_origin foundation_name_append foundation_nodes_prepend compiler_clone_tree compiler_clone_tree_result entity_child_name entity_component_at", symbol, length)
            || bootstrap_symbol_in("entity_component_count entity_component_type entity_id entity_retain entity_view_close entity_view_open", symbol, length)
            || bootstrap_symbol_in("format_dependent_summary format_dependent_view format_dispose format_grammar_preview format_summary", symbol, length)
            || bootstrap_symbol_in("frontend_module_alias frontend_module_at frontend_module_attach_comments frontend_module_comments frontend_module_count", symbol, length)
            || bootstrap_symbol_in("frontend_module_dependency_at frontend_module_destroy frontend_module_diagnostic frontend_module_error frontend_module_finish", symbol, length)
            || bootstrap_symbol_in("frontend_module_import_at frontend_module_import_count frontend_module_location frontend_module_name frontend_module_position", symbol, length)
            || bootstrap_symbol_in("frontend_module_root frontend_module_roots frontend_module_session frontend_module_size frontend_module_source", symbol, length)
            || bootstrap_symbol_in("frontend_module_tree generic_definition host_json_quote host_json_unsigned host_source_error host_text_terminate", symbol, length)
            || bootstrap_symbol_in("parser_match_get_type syntax_capture_comments syntax_completion_accepts syntax_completion_callable syntax_completion_close", symbol, length)
            || bootstrap_symbol_in("syntax_completion_create syntax_completion_enable syntax_completion_identifier syntax_completion_module syntax_component_type", symbol, length)
            || bootstrap_symbol_in("syntax_inspection_capture syntax_inspection_match syntax_inspection_reference syntax_inspection_template", symbol, length)
            || bootstrap_symbol_in("syntax_source_location tower_node_get_parent_member_name", symbol, length)
            || bootstrap_symbol_in("compiler_generic_body_kernel compiler_lr_action_kernel compiler_lr_first_kernel compiler_lr_kernel", symbol, length)
            || bootstrap_symbol_in("compiler_lr_link_kernel compiler_lr_propagation_kernel compiler_lr_runtime_kernel compiler_lr_state_kernel compiler_node_type", symbol, length)
            || bootstrap_symbol_in("compiler_work_accept compiler_work_anchor compiler_work_cancel compiler_work_close compiler_work_create compiler_work_done", symbol, length)
            || bootstrap_symbol_in("compiler_work_failed compiler_work_graph compiler_work_next compiler_work_subject compiler_world_create_workers compiler_world_dispose", symbol, length)
            || bootstrap_symbol_in("compiler_world_store entity_create entity_create_related entity_query_at entity_query_count entity_stage_create", symbol, length)
            || bootstrap_symbol_in("entity_stage_discard entity_stage_hold entity_stage_lease entity_stage_open entity_stage_publish entity_table_query_column", symbol, length)
            || bootstrap_symbol_in("entity_table_query_count entity_table_query_range_count entity_table_query_ranges entity_view_tables frontend_module_cyclic", symbol, length)
            || bootstrap_symbol_in("frontend_module_root_world frontend_modules_bind_world frontend_modules_configure frontend_modules_create frontend_modules_destroy", symbol, length)
            || bootstrap_symbol_in("frontend_world_clear generic_argument generic_argument_count generic_body_complete generic_body_limit generic_body_pending", symbol, length)
            || bootstrap_symbol_in("generic_specialization generic_type_result_read interpreter_invocation_dispose interpreter_invocation_init interpreter_invocation_step", symbol, length)
            || bootstrap_symbol_in("syntax_baseline_install syntax_session_open syntax_version_diagnostic_dispose syntax_version_diagnostic_text", symbol, length);
    }
    return false;
}

// llvm-nm --undefined-only emits one symbol per line. Preserve its final token
// and return the first rejected span for a deterministic, allocation-free error.
fn bootstrap_symbols_check(unit: BootstrapUnit, target: u8*, input: BootstrapSymbol, rejected: BootstrapSymbol*): bool {
    *rejected = default;
    if unit == BootstrapUnit.Unknown { return false; }
    var windows = strstr(target, "windows") != null;
    var wasm = strstr(target, "wasm32-") == target || strstr(target, "wasm64-") == target;
    var at: usize = 0;
    while at < input.length {
        var begin = at;
        while at < input.length && input.data[at] != convert(u8, SymbolByte.LF)
            && input.data[at] != convert(u8, SymbolByte.CR) { at++; }
        var end = at;
        if at < input.length { at++; }
        while end > begin && bootstrap_symbol_space(input.data[end - 1]) { end--; }
        if end == begin { continue; }
        begin = end;
        while begin != 0 && !bootstrap_symbol_space(input.data[begin - 1]) { begin--; }
        if !bootstrap_symbol_allowed(unit, windows, wasm, input.data + begin, end - begin) {
            // Borrowed view into input, never a separately owned buffer.
            *rejected = init(BootstrapSymbol) { data: input.data + begin, length: end - begin };
            return false;
        }
    }
    return true;
}
