import tower;
import .library.bytes;
import .library.bytes_types;
import .host.driver_files;
import .compiler.utf8;

// Runtime-only host tooling. The caller owns the source bytes and output buffer;
// no filesystem access occurs during compilation or strict staged evaluation.
enum LldCompatResult: i32 {
    Unchanged, Patched, ReviewRevision, ModifiedPatch, InvalidText,
    AllocationFailure, ReadFailure, WriteFailure
}

enum LldTextByte: u8 { Nul = 0, LF = 10, CR = 13 }

extern fn strlen(text: u8*): usize;
extern fn memcmp(left: u8*, right: u8*, count: usize): i32;

fn lld_text(out: ByteBuffer*, text: u8*): bool {
    return bytes_append(out, text, strlen(text));
}

// Counts non-overlapping exact byte matches, as the predecessor patcher did.
fn lld_occurrences(source: ByteBuffer*, needle: u8*, first: usize*): usize {
    var width = strlen(needle);
    var count: usize = 0;
    if width == 0 || width > source.length { return count; }
    for (var at: usize = 0; at <= source.length - width;) {
        if memcmp(source.data + at, needle, width) == 0 {
            if count == 0 { *first = at; }
            count++;
            at += width;
        } else { at++; }
    }
    return count;
}

// Match Python's universal-newline read on the supported Linux bootstrap host.
// Unchanged/rejected inputs never replace out; a patch publishes a complete LF
// buffer only after validation and allocation succeed. Input may borrow out.
fn lld_compat_rewrite(data: u8*, length: usize, out: ByteBuffer*): LldCompatResult {
    var allow_nul: u32 = 0;
    if tower_utf8_validate(data, length, allow_nul) == 0 {
        return LldCompatResult.InvalidText;
    }
    var source: ByteBuffer = default;
    defer bytes_dispose(&source);
    if !bytes_reserve(&source, length) { return LldCompatResult.AllocationFailure; }
    for (var at: usize = 0; at < length; at++) {
        var byte = data[at];
        if byte == convert(u8, LldTextByte.CR) {
            if at + 1 < length && data[at + 1] == convert(u8, LldTextByte.LF) { at++; }
            byte = convert(u8, LldTextByte.LF);
        }
        source.data[source.length] = byte;
        source.length++;
    }
    var marker = "  // Tower WASI SDK 34 compatibility: fixed-size first Wasm page.\n";
    var anchor = "  WasmSym::dsoHandle = symtab->addOptionalDataSymbol(\"__dso_handle\");\n";
    var patch = "  // Tower WASI SDK 34 compatibility: fixed-size first Wasm page.\n  if (!ctx.isPic)\n    if (auto *firstPageEnd = symtab->addOptionalDataSymbol(\"__wasm_first_page_end\"))\n      firstPageEnd->setVA(WasmPageSize);\n\n";
    var position: usize = 0;
    if lld_occurrences(&source, marker, &position) != 0 {
        return lld_occurrences(&source, patch, &position) != 0
            ? LldCompatResult.Unchanged : LldCompatResult.ModifiedPatch;
    }
    if lld_occurrences(&source, anchor, &position) != 1 {
        return LldCompatResult.ReviewRevision;
    }
    var unused: usize = 0;
    if lld_occurrences(&source, "__wasm_first_page_end", &unused) != 0 {
        return LldCompatResult.ReviewRevision;
    }
    var next: ByteBuffer = default;
    defer bytes_dispose(&next);
    if !bytes_append(&next, source.data, position) || !lld_text(&next, patch)
        || !bytes_append(&next, source.data + position, source.length - position) {
        return LldCompatResult.AllocationFailure;
    }
    bytes_dispose(out);
    *out = next;
    next = default;
    return LldCompatResult.Patched;
}

// The explicit host path is borrowed. Review failures never open it for writing.
// Like driver_write_file, I/O failure is reported and may leave partial output.
fn lld_compat_file(path: u8*): LldCompatResult {
    var source: ByteBuffer = default;
    var output: ByteBuffer = default;
    defer bytes_dispose(&source);
    defer bytes_dispose(&output);
    if !driver_read_file(path, &source) { return LldCompatResult.ReadFailure; }
    var result = lld_compat_rewrite(source.data, source.length, &output);
    if result == LldCompatResult.Patched && !driver_write_file(path, output.data, output.length) {
        return LldCompatResult.WriteFailure;
    }
    return result;
}

fn lld_compat_message(result: LldCompatResult): u8* {
    if result == LldCompatResult.ReviewRevision { return "Review LLD first-page compatibility for this LLVM revision"; }
    if result == LldCompatResult.ModifiedPatch { return "Modified LLD compatibility patch; review required"; }
    if result == LldCompatResult.InvalidText { return "LLD driver is not valid UTF-8"; }
    if result == LldCompatResult.ReadFailure { return "Cannot read LLD driver"; }
    if result == LldCompatResult.WriteFailure { return "Cannot write LLD driver"; }
    return "Cannot allocate LLD compatibility buffers";
}
