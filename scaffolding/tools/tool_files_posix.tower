import tower;
import .library.bytes;
import .library.bytes_types;
import .host.driver_files;
import .compiler.host_text;

// Native Linux/POSIX tooling only. File handles and path resolution are explicit
// runtime capabilities, never strict compile-time effects. realpath follows
// symlinks for output protection; this is not Tower module-identity resolution.
extern fn realpath(path: u8*, result: u8*): u8*;
extern fn mkdir(path: u8*, mode: u32): i32;
extern fn opendir(path: u8*): void*;
extern fn closedir(directory: void*): i32;
extern fn strlen(text: u8*): usize;
extern fn strcmp(left: u8*, right: u8*): i32;
extern fn statx(directory: i32, path: u8*, flags: i32, mask: u32, output: void*): i32;
extern fn __errno_location(): i32*;

// Owned NUL-terminated path; length excludes the terminator. Inputs may borrow
// out until successful publication. Filesystem paths do not change module identity.
fn tool_join(out: ByteBuffer*, left: u8*, right: u8*): bool {
    var next: ByteBuffer = default;
    defer bytes_dispose(&next);
    var slash: u8 = 47;
    if !bytes_append(&next, left, strlen(left)) || !bytes_push(&next, slash)
        || !bytes_append(&next, right, strlen(right)) || !host_text_terminate(&next) { return false; }
    bytes_dispose(out);
    *out = next;
    next = default;
    return true;
}

enum ToolPathByte: u8 { Nul = 0, Slash = 47 }

fn tool_directory(path: u8*): bool {
    var directory = opendir(path);
    return directory != null && closedir(directory) == 0;
}

// Make parents in written path order, leaving symlink resolution to the OS.
// A pre-existing non-directory is an error. Never invokes a shell or deletes.
fn tool_output_parents(path: u8*): bool {
    var buffer: ByteBuffer = default;
    defer bytes_dispose(&buffer);
    if !bytes_assign_text(&buffer, path, strlen(path)) { return false; }
    var directory_mode: u32 = 511;
    for (var at: usize = 1; at < buffer.length; at++) {
        if buffer.data[at] != convert(u8, ToolPathByte.Slash) { continue; }
        buffer.data[at] = convert(u8, ToolPathByte.Nul);
        var ok = mkdir(buffer.data, directory_mode) == 0 || tool_directory(buffer.data);
        buffer.data[at] = convert(u8, ToolPathByte.Slash);
        if !ok { return false; }
    }
    return true;
}

// Native Linux tools: use the same statx boundary as tool_files_linux rather
// than libc's architecture-dependent stat layout. Follow links and compare
// device+inode, including hard links which distinct realpaths cannot detect.
// Caller freezes paths between this check and writing; this is not protection
// against a concurrent filesystem rename. Only ENOENT permits a new output.
fn tool_output_distinct(source: u8*, output: u8*): bool {
    var source_status: u64[32];
    var output_status: u64[32];
    var working_directory: i32 = -100;
    var inode_mask: u32 = 256;
    var inode_word: usize = 4;
    var device_word: usize = 17;
    var no_entry: i32 = 2;
    if statx(working_directory, source, 0, inode_mask, bits(void*, &source_status[0])) != 0
        || (source_status[0] & convert(u64, inode_mask)) == 0 { return false; }
    if statx(working_directory, output, 0, inode_mask, bits(void*, &output_status[0])) != 0 {
        return *__errno_location() == no_entry;
    }
    if (output_status[0] & convert(u64, inode_mask)) == 0 { return false; }
    return source_status[inode_word] != output_status[inode_word]
        || source_status[device_word] != output_status[device_word];
}
