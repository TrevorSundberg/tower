import tower;
import llvm_scripts;

extern fn strlen(text: u8*): usize;
extern fn strcmp(left: u8*, right: u8*): i32;

extern fn write(stream: i32, data: u8*, length: usize): i64;

// This entry uses the Linux/POSIX host ABI of the documented bootstrap route.
// No command shell interprets the argument; spaces and metacharacters are paths.
export fn main(argc: i32, argv: u8**): i32 {
    var script_arguments: i32 = 4;
    var success: i32 = 0;
    var failure: i32 = 1;
    var usage: i32 = 2;
    var stderr_stream: i32 = 2;
    if argc == script_arguments {
        var restoring = strcmp(argv[2], "--restore-scripts") == 0;
        if !restoring && strcmp(argv[2], "--prepare-scripts") != 0 { return usage; }
        if llvm_scripts(argv[1], argv[3], restoring) { return success; }
        var message = "LLVM script preparation/restoration failed; retain and inspect backups at: ";
        write(stderr_stream, message, strlen(message)); write(stderr_stream, argv[3], strlen(argv[3]));
        write(stderr_stream, "\n", 1); return failure;
    }
    var message = "Usage: prepare_llvm LLVM_SOURCE_DIRECTORY --prepare-scripts|--restore-scripts BACKUP_DIRECTORY\n";
    write(stderr_stream, message, strlen(message));
    return usage;
}
