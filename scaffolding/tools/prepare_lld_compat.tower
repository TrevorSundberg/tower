import tower;
import lld_compat;
import .library.bytes;
import .library.bytes_types;

extern fn strlen(text: u8*): usize;

extern fn write(stream: i32, data: u8*, length: usize): i64;

// This entry uses the Linux/POSIX host ABI of the documented bootstrap route.
// No command shell interprets the argument; spaces and metacharacters are paths.
export fn main(argc: i32, argv: u8**): i32 {
    var expected_arguments: i32 = 2;
    var success: i32 = 0;
    var failure: i32 = 1;
    var usage: i32 = 2;
    var stderr_stream: i32 = 2;
    if argc != expected_arguments {
        var message = "Usage: prepare_lld_compat LLVM_SOURCE_DIRECTORY\n";
        write(stderr_stream, message, strlen(message));
        return usage;
    }
    var path: ByteBuffer = default;
    defer bytes_dispose(&path);
    if !lld_text(&path, argv[1]) || !lld_text(&path, "/lld/wasm/Driver.cpp")
        || !bytes_push(&path, convert(u8, LldTextByte.Nul)) { return failure; }
    var result = lld_compat_file(path.data);
    if result == LldCompatResult.Patched || result == LldCompatResult.Unchanged { return success; }
    var message = lld_compat_message(result);
    write(stderr_stream, message, strlen(message));
    write(stderr_stream, "\n", 1);
    return failure;
}
