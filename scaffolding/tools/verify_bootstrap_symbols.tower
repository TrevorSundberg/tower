import tower;
import bootstrap_symbols;
import bootstrap_comparison;
import tool_streams_posix;
import .library.bytes;
import .library.bytes_types;

extern fn puts(text: u8*): i32;

export fn main(argc: i32, argv: u8**): i32 {
    var expected_arguments: i32 = 4; var usage: i32 = 2; var failure: i32 = 1;
    if argc > 1 && strcmp(argv[1], "--compare") == 0 { return bootstrap_comparison_main(argc, argv); }
    if argc != expected_arguments {
        puts("Usage: verify_bootstrap_symbols UNIT LLVM_NM_OUTPUT TARGET"); return usage;
    }
    var unit = bootstrap_unit(argv[1]);
    if unit == BootstrapUnit.Unknown { puts("Unknown bootstrap unit"); return usage; }
    var input: ByteBuffer = default;
    defer bytes_dispose(&input);
    if !tool_read_file(argv[2], BootstrapComparisonSymbolLimit, &input) { puts("Cannot read bounded llvm-nm output"); return failure; }
    return bootstrap_verify_report(unit, argv[3], &input) ? 0 : failure;
}
