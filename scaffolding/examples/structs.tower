import tower;

// A struct groups typed fields. A pointer lets a function update the original.
struct Pair {
    first: i32;
    second: i32;
}

fn accumulate(pair: Pair*): void {
    pair.first += pair.second;
}

var pair: Pair = {
    first: 20, second: 22
};
var pointer = &pair;
accumulate(pointer);
print(pair.first);
print(pointer.second);

// A pointer to a field aliases its original storage.
var field = &pair.second;
*field = 7;
print(pair.second);
