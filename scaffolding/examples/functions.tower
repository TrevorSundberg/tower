import tower;

// Tower adds nested expressions to Foundation's functions, calls and returns.
var answer = factorial(6);
print(answer);

// Forward calls and recursion use the same foundation nodes in both backends.
fn factorial(n: i32): i32 {
    if n <= 1 {
        return 1;
    }
    return factorial(n -1) *n;
}

fn increment(value: i32*): void {
    (*value)++;
}

var pointer = &answer;
increment(pointer);
print(answer);
