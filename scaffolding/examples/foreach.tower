import bedrock;

// This is a grammar lesson: define the loop syntax ourselves, without importing
// Tower's executable foreach. The parse tree works; execution needs a replacement.
[number]
token Number = /[0-9]+/;
// Define the pieces used by the loop below.
parse Variable = Identifier;
parse Expression = Identifier | Number;
parse Statement = Expression ';';

parse ForEach = 'for' '(' $Variable 'in' $Expression ')' '{' $Statement* '}';
parse Statement |= ForEach;

for (item in items) {
    item;
    for (child in children) {
        child;
    }
}

// Change the spelling from 'for' to 'foreach' for the code below.
parse ForEach = 'foreach' '(' $Variable 'in' $Expression ')' '{' $Statement* '}';
foreach (entry in entries) {}
