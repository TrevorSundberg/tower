// Increment syntax is defined here and expands into ordinary Tower calls.
// Postfix returns the old value; prefix returns the new value.
fn post_increment(p: i32*): i32 {
    var old: i32 = *p;
    *p = old + 1;
    return old;
}

fn pre_increment(p: i32*): i32 {
    var next: i32 = *p;
    next = next + 1;
    *p = next;
    return next;
}

parse CoreValue |= '(' '*' $p:CorePlace ')' '++'
    => replace { post_increment($p) };
parse CoreValue |= '++' '*' $p:CorePlace
    => replace { pre_increment($p) };

// Pass a pointer so the helpers can update the original variable.
var value: i32 = 5;
var pointer: i32* = &value;
var before: i32 = (* pointer) ++;
// 5: the old value, then 6: the updated variable.
print(before);
print(value);
var after: i32 = ++ * pointer;
// 7: the new value, then 7: the updated variable.
print(after);
print(value);
