import tower;
import foreign_api;
import foreign_reader;
import foreign_symbol;
import text;
import target_registry_tool;
import .library.bytes;
import .library.bytes_types;
import .compiler.host_text;
import .host.driver_files;

// Build-time Foundation-to-Foundation expansion for bootstrap compilers which
// predate foreign-symbol lowering. Implementation and CLI are both Tower.
extern fn puts(text: u8*): i32;

fn foreign_expand_source(profile: u32, source: u8*, length: usize, out: ByteBuffer*, wraps: ByteBuffer*): bool {
    var i: usize = 0;
    loop {
        if i == length {
            break;
        }
        var byte = source[i];
        // Preserve strings/comments verbatim, including backticks inside them.
        var quoted = byte == 34;
        if byte == 39 {
            quoted = true;
        }
        if quoted {
            var start = i;
            i++;
            loop {
                if i == length {
                    break;
                }
                var next = source[i];
                i++;
                if next == byte {
                    break;
                }
                if next == 92 {
                    if i < length {
                        i++;
                    }
                }
            }
            var count = i -start;
            if !bytes_append(out, &source[start], count) { return false; }
            continue;
        }
        if byte == 47 {
            var next = i + 1;
            if next < length {
                var line = source[next] == 47;
                var block = source[next] == 42;
                var comment = line;
                if block {
                    comment = true;
                }
                if comment {
                    var start = i;
                    i = i + 2;
                    loop {
                        if i == length {
                            break;
                        }
                        if line {
                            if source[i] == 10 {
                                break;
                            }
                        }
                        if block {
                            if source[i] == 42 {
                                next = i + 1;
                                if next < length {
                                    if source[next] == 47 {
                                        i = i + 2;
                                        break;
                                    }
                                }
                            }
                        }
                        i++;
                    }
                    var count = i -start;
                    if !bytes_append(out, &source[start], count) { return false; }
                    continue;
                }
            }
        }
        if byte == 96 {
            var start = i;
            i++;
            var begin = i;
            loop {
                if i == length {
                    puts("Unterminated quoted Foundation name");
                    return false;
                }
                if source[i] == 96 {
                    break;
                }
                if source[i] == 92 {
                    i++;
                }
                if i == length {
                    return false;
                }
                i++;
            }
            source[i] = 0;
            var name = &source[begin];
            var macro = backend_prefix(name, "cpp_name(");
            if backend_prefix(name, "c_name(") {
                macro = true;
            }
            if macro {
                var result = foreign_symbol(profile, name);
                var error = foreign_name_error(result);
                if error[0] != 0 {
                    puts(name);
                    puts(error);
                    foreign_name_close(result);
                    source[i] = 96;
                    return false;
                }
                var symbol = foreign_name_text(result);
                var ok = bytes_append(out, "`", 1) && bytes_append(out, symbol, backend_length(symbol));
                if ok && backend_prefix(symbol, "__wrap_") {
                    ok = bytes_append(wraps, "--wrap=", 7)
                        && bytes_append(wraps, &symbol[7], backend_length(&symbol[7]))
                        && bytes_append(wraps, "\n", 1);
                }
                ok &&= bytes_append(out, "`", 1);
                foreign_name_close(result);
                if !ok { source[i] = 96; return false; }
            } else {
                source[i] = 96;
                var count = i -start;
                count++;
                if !bytes_append(out, &source[start], count) { return false; }
            }
            source[i] = 96;
            i++;
            continue;
        }
        if !bytes_append(out, &source[i], 1) { return false; }
        i++;
    }
    return true;
}

fn foreign_tool_read(path: u8*, source: ByteBuffer*): bool {
    if driver_read_file(path, source) { return true; }
    puts("Cannot read foreign source");
    puts(path);
    return false;
}

export fn main(argc: i32, argv: u8**): i32 {
    var base_arguments: i32 = 4;
    if argc == base_arguments && backend_equal(argv[1], "--llvm-targets") {
        var success: i32 = 0; var failure: i32 = 1;
        if llvm_registry_command(argv[2], argv[3]) { return success; }
        puts("Cannot generate configured LLVM target registry");
        return failure;
    }
    if argc < base_arguments {
        puts("tower-foreign target-triple input.tower output.tower [additional-wrap-source.tower ...]");
        puts("tower-foreign --llvm-targets LLVM_CONFIG_DIRECTORY output.tower");
        return 2;
    }
    var profile = foreign_profile_for_target(argv[1]);
    if profile == 0 { puts("Unsupported foreign target profile"); return 2; }
    var source: ByteBuffer = default;
    var expanded: ByteBuffer = default;
    var wraps: ByteBuffer = default;
    defer bytes_dispose(&source); defer bytes_dispose(&expanded); defer bytes_dispose(&wraps);
    if !foreign_tool_read(argv[2], &source) { return 1; }
    var ok = foreign_expand_source(profile, source.data, source.length, &expanded, &wraps);
    // Extra modules contribute only wrap flags; their declarations continue to
    // compile through ordinary imports, with no generated source duplication.
    for (var at = base_arguments; at < argc && ok; at++) {
        var extra: ByteBuffer = default;
        var scratch: ByteBuffer = default;
        defer bytes_dispose(&extra); defer bytes_dispose(&scratch);
        ok = foreign_tool_read(argv[at], &extra) && foreign_expand_source(profile, extra.data, extra.length, &scratch, &wraps);
    }
    if !ok { puts("Foreign source expansion failed"); return 1; }
    var path: ByteBuffer = default;
    defer bytes_dispose(&path);
    // Finish allocating both output paths before opening either artifact.
    ok = bytes_append(&path, argv[3], backend_length(argv[3]))
        && bytes_append(&path, ".wrap.rsp", 9) && host_text_terminate(&path);
    ok &&= driver_write_file(argv[3], expanded.data, expanded.length)
        && driver_write_file(path.data, wraps.data, wraps.length);
    if ok {
        return 0;
    }
    puts("Cannot publish foreign source and wrapper response");
    return 1;
}
