import tower;
import link_types;
import context;
import disassembly;
import import_module;
import linker_wasi;
import linker;
import lowering;
import pipeline;
import session_wasi;
import target;
import text;
import .compiler.foundation_types;
import .compiler.execution_profiles;
import .library.vector;
import .library.work_budget_types;

// Backend service over validated Foundation entities. Source parsing and worker/
// CLI scheduling belong to callers. Results own their buffers until reset/close.
struct BackendSession {
    target: vector(u8);
    response: vector(u8);
    response_fallback: u8*; // Borrows the reserved tail until reset/next response.
    backend: Backend*;
    linker: BackendLink*;
    decoder: BackendDecoder*;
    runtime: u8*;
    runtime_size: usize;
    object_only: bool;
    optimization_enabled: bool;
    times: u64[6];
}

extern fn semantic_format_type(type: FoundationType*, output: vector(u8)*): void;

fn backend_json(out: vector(u8)*, text: u8*, length: usize): bool {
    if !backend_text(out, "\"") { return false; }
    var i: usize = 0;
    var digits: u8* = "0123456789abcdef";
    for(; i != length; i++) {
        var byte = text[i];
        var escape = byte == 34;
        if byte == 92 {
            escape = true;
        }
        if escape {
            if !backend_text(out, "\\") || !backend_text_append(out, &text[i], 1) { return false; }
        } else {
            if byte < 32 {
                if !backend_text(out, "\\u00") { return false; }
                var high = convert(usize, byte) / 16;
                var low = convert(usize, byte) % 16;
                if !backend_text_append(out, &digits[high], 1) || !backend_text_append(out, &digits[low], 1) { return false; }
            } else {
                if !backend_text_append(out, &text[i], 1) { return false; }
            }
        }
    }
    return backend_text(out, "\"");
}

fn backend_json_text(out: vector(u8)*, text: u8*): bool {
    return backend_json(out, text, backend_length(text));
}

export fn backend_session_create(runtime: u8*, length: usize): BackendSession* {
    // One owned allocation reserves the bounded denial response as well. The
    // public descriptor/signatures stay unchanged; only this factory owns it.
    var s = bits(BackendSession*, alloc(u8, sizeof(BackendSession) + backend_session_failure_capacity()));
    var failed = s == null;
    if failed {
        return null;
    }
    *s = default;
    s.linker = backend_link_create();
    failed = s.linker == null;
    if failed {
        free(s);
        return null;
    }
    s.runtime = runtime;
    s.runtime_size = length;
    backend_text(&s.target, "wasm32-unknown-unknown");
    return s;
}

export fn backend_session_reset(s: BackendSession*): void {
    backend_close(s.backend);
    backend_disassembly_close(s.decoder);
    s.backend = null;
    s.decoder = null;
    s.object_only = false;
    s.response.length = 0;
    s.response_fallback = null;
    backend_link_reset_plan(s.linker);
    fill(&s.times[0], 0, sizeof(u64[6]));
}

export fn backend_session_close(s: BackendSession*): void {
    if s == null {
        return;
    }
    backend_session_reset(s);
    backend_link_close(s.linker);
    vector_dispose(&s.target);
    vector_dispose(&s.response);
    free(s);
}

export fn backend_session_set_target(s: BackendSession*, target: u8*): bool {
    if target == null {
        return false;
    }
    var valid = backend_filename(target);
    if valid {
        s.target.length = 0;
        backend_text(&s.target, target);
    }
    return valid;
}

export fn backend_session_clear_inputs(s: BackendSession*): void {
    backend_link_clear_inputs(s.linker);
}

export fn backend_session_add_input(s: BackendSession*, name: u8*, bytes: u8*, length: usize): bool {
    return backend_link_add_input(s.linker, name, bytes, length);
}

export fn backend_session_failure(s: BackendSession*, error: u8*, offset: usize): u8* {
    s.linker.output.length = 0;
    s.response.length = 0;
    s.response_fallback = null;
    if !backend_text(&s.response, "{\"status\":\"error\",\"error\":")
        || !backend_json_text(&s.response, error)
        || !backend_text(&s.response, ",\"errorOffset\":")
        || !backend_decimal(&s.response, convert(u64, offset)) { return backend_session_resource_failure(s, offset); }
    if s.backend != null && s.backend.resource_error != WorkBudgetError.None {
        var cause = s.backend.resource_error;
        var name = cause == WorkBudgetError.Memory ? "Memory" : cause == WorkBudgetError.Capacity ? "Capacity"
            : cause == WorkBudgetError.Busy ? "Busy" : cause == WorkBudgetError.Stale ? "Stale"
            : cause == WorkBudgetError.Exhausted ? "Exhausted" : "Invalid";
        if !backend_text(&s.response, ",\"resourceError\":") || !backend_json_text(&s.response, name) {
            return backend_session_resource_failure(s, offset);
        }
    }
    if !backend_text(&s.response, "}") { return backend_session_resource_failure(s, offset); }
    return s.response.data;
}

fn backend_session_failure_prefix(cause: WorkBudgetError): u8* {
    if cause == WorkBudgetError.Memory {
        return "{\"status\":\"error\",\"error\":\"Cannot allocate semantic storage\",\"resourceError\":\"Memory\",\"errorOffset\":";
    }
    if cause == WorkBudgetError.Capacity {
        return "{\"status\":\"error\",\"error\":\"Semantic memory budget exceeded\",\"resourceError\":\"Capacity\",\"errorOffset\":";
    }
    if cause == WorkBudgetError.Busy {
        return "{\"status\":\"error\",\"error\":\"Semantic worker admission failed\",\"resourceError\":\"Busy\",\"errorOffset\":";
    }
    if cause == WorkBudgetError.Stale {
        return "{\"status\":\"error\",\"error\":\"Compiler resource request failed\",\"resourceError\":\"Stale\",\"errorOffset\":";
    }
    if cause == WorkBudgetError.Exhausted {
        return "{\"status\":\"error\",\"error\":\"Compiler resource request failed\",\"resourceError\":\"Exhausted\",\"errorOffset\":";
    }
    if cause == WorkBudgetError.Invalid {
        return "{\"status\":\"error\",\"error\":\"Compiler resource request failed\",\"resourceError\":\"Invalid\",\"errorOffset\":";
    }
    return "{\"status\":\"error\",\"error\":\"Compiler resource request failed\",\"errorOffset\":";
}

fn backend_session_failure_capacity(): usize {
    var longest: usize = 0;
    for(var cause = convert(u32, WorkBudgetError.None); cause <= convert(u32, WorkBudgetError.Exhausted); cause++) {
        var length = backend_length(backend_session_failure_prefix(convert(WorkBudgetError, cause)));
        if length > longest { longest = length; }
    }
    // One decimal digit per value bit is a conservative bound, plus '}' and NUL.
    return longest + sizeof(usize) * 8 + 2;
}

fn backend_session_resource_failure(s: BackendSession*, offset: usize): u8* {
    s.linker.output.length = 0;
    s.response.length = 0;
    var cause = s.backend == null ? WorkBudgetError.None : s.backend.resource_error;
    if cause != WorkBudgetError.None { offset = s.backend.error_offset; }
    var prefix = backend_session_failure_prefix(cause);
    var length = backend_length(prefix);
    var output = bits(u8*, s) + sizeof(BackendSession);
    copy(output, prefix, length);
    var digits: u8[sizeof(usize) * 8];
    var count: usize = 0;
    loop {
        digits[count++] = convert(u8, offset % 10) + 48;
        offset /= 10;
        if offset == 0 { break; }
    }
    while count != 0 { output[length++] = digits[--count]; }
    output[length++] = 125;
    output[length] = 0;
    // Publish only the completed JSON. No allocator or mutable global is used.
    s.response_fallback = output;
    return s.response_fallback;
}

export fn backend_session_begin(s: BackendSession*, source: u8*, length: usize): u32 {
    return backend_session_begin_codegen(s, source, length, BackendCodegen.Default);
}

export fn backend_session_begin_codegen(s: BackendSession*, source: u8*, length: usize, codegen: BackendCodegen): u32 {
    backend_session_reset(s);
    var invalid = source == null;
    if length > 8388608 {
        invalid = true;
    }
    if invalid {
        backend_session_failure(s, "Invalid foundation source length", 0);
        return 0;
    }
    for(var i: usize = 0; i != length; i++) {
        if source[i] == 0 {
            backend_session_failure(s, "Foundation source cannot contain NUL bytes", 0);
            return 0;
        }
    }
    s.times[0] = backend_session_clock();
    s.backend = backend_open_codegen(s.target.data, codegen);
    if s.backend == null {
        backend_session_failure(s, "Unable to allocate backend storage", 0);
        return 0;
    }
    if backend_failed(s.backend) {
        backend_session_failure(s, backend_error(s.backend), 0);
        return 0;
    }
    return s.backend.pointer_bytes;
}

export fn backend_session_bytes(s: BackendSession*): u8* {
    if s.object_only {
        return backend_bytes(s.backend);
    }
    return s.linker.output.data;
}

export fn backend_session_size(s: BackendSession*): usize {
    if s.object_only {
        return backend_size(s.backend);
    }
    return s.linker.output.length;
}

export fn backend_session_before(s: BackendSession*): u8* {
    var present = s.backend != null;
    if present {
        present = s.backend.raw != null;
        if present {
            return s.backend.raw;
        }
    }
    return "";
}

export fn backend_session_after(s: BackendSession*): u8* {
    var present = s.backend != null;
    if present {
        present = s.backend.optimized != null;
        if present {
            return s.backend.optimized;
        }
    }
    return "";
}

export fn backend_session_disassembly(s: BackendSession*): u8* {
    if s.decoder != null {
        return backend_disassembly_text(s.decoder);
    }
    return "";
}

export fn backend_session_response(s: BackendSession*): u8* {
    if s.response_fallback != null { return s.response_fallback; }
    return s.response.data;
}

fn backend_session_names(b: Backend*, out: vector(u8)*, functions: void**, count: usize, imports: bool): void {
    backend_text(out, "[");
    var first = true;
    for(var i: usize = 1; i < count; i++) {
        var n = sem_get(functions[i]);
        var selected = n.exported;
        if imports {
            selected = n.external;
        }
        if selected {
            if !first {
                backend_text(out, ",");
            }
            backend_json_text(out, backend_function_name(b, i));
            first = false;
        }
    }
    backend_text(out, "]");
}

fn backend_session_report(s: BackendSession*, functions: void**, count: usize): void {
    var out = &s.response;
    out.length = 0;
    backend_text(out, "{\"status\":\"compiled\",\"format\":");
    var format: u8* = "elf";
    if backend_contains(s.target.data, "windows") {
        format = "pe";
    }
    if backend_contains(s.target.data, "apple") {
        format = "macho";
    }
    if s.backend.wasm {
        format = "wasm";
    }
    if s.object_only {
        format = "object";
    }
    backend_json_text(out, format);
    backend_text(out, ",\"target\":");
    backend_json_text(out, s.target.data);
    backend_text(out, ",\"imports\":");
    backend_session_names(s.backend, out, functions, count, true);
    backend_text(out, ",\"exports\":");
    backend_session_names(s.backend, out, functions, count, false);
    backend_text(out, ",\"signatures\":{");
    var first = true;
    var i: usize = 1;
    loop {
        var done = i >= count;
        if done {
            break;
        }
        var n = sem_get(functions[i]);
        if n.external {
            var comma = !first;
            if comma {
                backend_text(out, ",");
            }
            first = false;
            backend_json_text(out, backend_function_name(s.backend, i));
            backend_text(out, ":[");
            var j: usize = 0;
            loop {
                done = j == n.parameters.length;
                if done {
                    break;
                }
                comma = j != 0;
                if comma {
                    backend_text(out, ",");
                }
                var parameter = sem_get(n.parameters.data[j]);
                var name: vector(u8);
                vector_init(&name);
                semantic_format_type(&parameter.type, &name);
                backend_json(out, name.data, name.length);
                vector_dispose(&name);
                j++;
            }
            backend_text(out, "]");
        }
        i++;
    }
    backend_text(out, "},\"timings\":{");
    i = 0;
    loop {
        var done = i == 6;
        if done {
            break;
        }
        var unlinked = i == 4;
        unlinked &&= s.object_only;
        if unlinked {
            i++;
            continue;
        }
        var comma = i != 0;
        if comma {
            backend_text(out, ",");
        }
        var name: u8* = "parse";
        var `match` = i == 1;
        if `match` {
            name = "before";
        }
        `match` = i == 2;
        if `match` {
            name = "after";
        }
        `match` = i == 3;
        if `match` {
            name = "emit";
        }
        `match` = i == 4;
        if `match` {
            name = "link";
        }
        `match` = i == 5;
        if `match` {
            name = "disassembly";
        }
        backend_json_text(out, name);
        backend_text(out, ":");
        var micros = s.times[i] / 1000;
        var millis = micros / 1000;
        var fraction = micros % 1000;
        backend_decimal(out, millis);
        backend_text(out, ".");
        var padding = fraction < 100;
        if padding {
            backend_text(out, "0");
        }
        padding = fraction < 10;
        if padding {
            backend_text(out, "0");
        }
        backend_decimal(out, fraction);
        i++;
    }
    backend_text(out, "},\"bytes\":");
    backend_decimal(out, convert(u64, backend_session_size(s)));
    backend_text(out, ",\"passes\":");
    if s.optimization_enabled {
        backend_json_text(out, "sroa, mem2reg, instcombine, simplifycfg, O2");
    }
    else {
        backend_json_text(out, "disabled");
    }
    backend_text(out, "}");
}

export fn backend_session_compile(s: BackendSession*, root: void*, functions: void**, count: usize, width: u32, flags: u32): u8* {
    var started = backend_session_clock();
    s.times[0] = started - s.times[0];
    var object_flags = flags &3;
    s.object_only = object_flags != 0;
    var library_flag = flags &2;
    var library = library_flag != 0;
    var ok = backend_lower(s.backend, root, functions, count, width, library);
    var next = backend_session_clock();
    s.times[1] = next - started;
    started = next;
    if ok {
        var no_optimization = flags &8;
        var optimize = no_optimization == 0;
        s.optimization_enabled = optimize;
        ok = backend_optimize(s.backend, optimize);
    }
    next = backend_session_clock();
    s.times[2] = next - started;
    started = next;
    ok &&= backend_emit(s.backend);
    next = backend_session_clock();
    s.times[3] = next - started;
    started = next;
    var failed = !ok;
    if failed {
        return backend_session_failure(s, backend_error(s.backend), s.backend.error_offset);
    }
    if !s.object_only {
        ok = backend_link_plan(s.linker, s.target.data, functions, count, backend_bytes(s.backend), backend_size(s.backend), s.runtime, s.runtime_size);
        // Argument/input preparation precedes linking. Wall time includes both.
        started = backend_session_clock();
        ok &&= backend_link_wasi(s.linker, s.target.data);
        failed = !ok;
        if failed {
            return backend_session_failure(s, s.linker.error.data, 0);
        }
    }
    next = backend_session_clock();
    s.times[4] = next - started;
    started = next;
    s.decoder = backend_disassemble(backend_session_bytes(s), backend_session_size(s), s.target.data);
    next = backend_session_clock();
    s.times[5] = next - started;
    backend_session_report(s, functions, count);
    return s.response.data;
}

export fn backend_session_import(s: BackendSession*, root: void*, functions: void**, count: usize, width: u32, optimize: bool, output: void*): bool {
    var ok = backend_lower(s.backend, root, functions, count, width, false);
    ok &&= backend_optimize_interpreter(s.backend, optimize);
    ok &&= backend_import_foundation(s.backend, output);
    if !ok {
        backend_session_failure(s, backend_error(s.backend), s.backend.error_offset);
    }
    return ok;
}

export fn backend_session_import_report(s: BackendSession*, optimize: bool): u8* {
    return backend_session_foundation_report(s, optimize ? ExecutionProfile.Optimized : ExecutionProfile.Normalized);
}

fn backend_session_foundation_report(s: BackendSession*, profile: ExecutionProfile): u8* {
    s.response.length = 0;
    s.response_fallback = null;
    if !backend_text(&s.response, "{\"status\":\"compiled\",\"format\":\"foundation\",\"optimizationProfile\":")
        || !backend_decimal(&s.response, convert(u64, profile)) || !backend_text(&s.response, "}") {
        backend_resource_fail(s.backend, WorkBudgetError.Memory);
        return backend_session_resource_failure(s, s.backend.error_offset);
    }
    return s.response.data;
}
