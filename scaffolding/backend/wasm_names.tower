import tower;
import wasm_bytes;
import wasm_object_types;

// Derived name -> row index. Keys borrow pinned object/argument storage; row
// identities survive rehashing. Each link request owns its tables independently.
struct WasmNameSlot { name: WasmBytes; value: u32; occupied: bool; }
struct WasmNameMap { slots: WasmNameSlot*; capacity: usize; count: usize; }

fn wasm_names_dispose(map: WasmNameMap*): void { free(map.slots); *map = default; }

fn wasm_names_slot(map: WasmNameMap*, name: WasmBytes): usize {
    var at = convert(usize, wasm_bytes_hash(name)) & (map.capacity - 1);
    while map.slots[at].occupied && !wasm_bytes_equal(map.slots[at].name, name) { at = (at + 1) & (map.capacity - 1); }
    return at;
}

fn wasm_names_get(map: WasmNameMap*, name: WasmBytes): u32 {
    if map.capacity == 0 { return WasmNoIndex; }
    var at = wasm_names_slot(map, name);
    return map.slots[at].occupied ? map.slots[at].value : WasmNoIndex;
}

fn wasm_names_set(map: WasmNameMap*, name: WasmBytes, value: u32): bool {
    if map.capacity != 0 {
        var existing = wasm_names_slot(map, name);
        if map.slots[existing].occupied { map.slots[existing].value = value; return true; }
    }
    if map.capacity == 0 || map.count >= map.capacity / 2 {
        var capacity: usize = map.capacity == 0 ? 16 : map.capacity * 2;
        if capacity < map.capacity || capacity > (~convert(usize, 0)) / sizeof(WasmNameSlot) { return false; }
        var next: WasmNameMap = { slots: alloc(WasmNameSlot, capacity), capacity: capacity, count: map.count };
        if next.slots == null { return false; }
        fill(next.slots, 0, capacity * sizeof(WasmNameSlot));
        for (var at: usize = 0; at < map.capacity; at++) {
            if map.slots[at].occupied { next.slots[wasm_names_slot(&next, map.slots[at].name)] = map.slots[at]; }
        }
        free(map.slots); *map = next;
    }
    var at = wasm_names_slot(map, name);
    if !map.slots[at].occupied { map.count++; }
    map.slots[at] = init(WasmNameSlot) { name: name, value: value, occupied: true };
    return true;
}
