import tower;
import foreign_itanium;
import foreign_microsoft;
import foreign_reader;
import text;

// Returns owned text/error views; release with foreign_name_close. The profile
// describes the foreign compiler, never the host running this Tower function.
fn foreign_profile(m: ForeignName*, profile: u32): void {
    if profile == foreign_windows_arm64ec() {
        foreign_profile(m, foreign_windows_arm64());
        m.profile = foreign_windows_arm64ec();
        return;
    }
    m.profile = profile;
    m.abi = 1;
    m.pointer_bytes = 8;
    m.long_bytes = 8;
    m.arch = 2;
    if profile == foreign_wasi() {
        m.pointer_bytes = 4;
        m.long_bytes = 4;
        m.arch = 0;
    }
    if profile == foreign_macos_x64() {
        m.object_format = 1;
    }
    if profile == foreign_macos_arm64() {
        m.object_format = 1;
        m.arch = 3;
    }
    if profile == foreign_windows_x64() {
        m.object_format = 2;
        m.long_bytes = 4;
        m.abi = 2;
    }
    if profile == foreign_windows_x86() {
        m.object_format = 2;
        m.long_bytes = 4;
        m.pointer_bytes = 4;
        m.arch = 1;
        m.abi = 2;
    }
    if profile == foreign_mingw_x64() {
        m.object_format = 2;
        m.long_bytes = 4;
    }
    if profile == foreign_linux_arm64() {
        m.arch = 3;
    }
    if profile == foreign_linux_x86() {
        m.pointer_bytes = 4;
        m.long_bytes = 4;
        m.arch = 1;
    }
    if profile == foreign_windows_arm64() {
        m.object_format = 2;
        m.long_bytes = 4;
        m.arch = 3;
        m.abi = 2;
    }
    if profile == 0 {
        foreign_fail(m, "Unknown foreign ABI profile");
    }
    if profile > foreign_windows_arm64ec() {
        foreign_fail(m, "Unknown foreign ABI profile");
    }
}

fn foreign_argument_bytes(m: ForeignName*, type: ForeignType*): usize {
    if type.kind == 3 {
        return convert(usize, m.pointer_bytes);
    }
    if type.kind == 4 {
        return convert(usize, m.pointer_bytes);
    }
    if type.kind == 5 {
        return convert(usize, m.pointer_bytes);
    }
    if type.kind == 1 {
        if backend_equal(type.name, "x") {
            return 8;
        }
        if backend_equal(type.name, "y") {
            return 8;
        }
        if backend_equal(type.name, "d") {
            return 8;
        }
        if backend_equal(type.name, "e") {
            return 8;
        }
        if backend_equal(type.name, "n") {
            return 16;
        }
        if backend_equal(type.name, "o") {
            return 16;
        }
        if backend_equal(type.name, "l") {
            return convert(usize, m.long_bytes);
        }
        if backend_equal(type.name, "m") {
            return convert(usize, m.long_bytes);
        }
        return 4;
    }
    foreign_fail(m, "C byte-count decoration needs an explicit scalar/pointer ABI signature");
    return 0;
}

fn foreign_c(m: ForeignName*, object: bool): void {
    if m.name.scope != null {
        foreign_fail(m, "C linkage uses an unqualified name");
        return;
    }
    if m.name.template_id {
        foreign_fail(m, "C linkage cannot name a template");
        return;
    }
    if m.member != 0 {
        foreign_fail(m, "C linkage cannot name a member function");
        return;
    }
    var cc = m.function.convention;
    if m.function.variadic {
        cc = 1;
    }
    var decorate = m.object_format == 2;
    var counted = cc == 4;
    if m.arch == 1 {
        if cc == 2 {
            counted = true;
        }
        if cc == 3 {
            counted = true;
        }
    }
    if !decorate {
        counted = false;
    }
    if !object {
        counted = false;
    }
    if object {
        if m.profile == foreign_windows_arm64ec() {
            backend_text(&m.text, "#");
        }
        if m.object_format == 1 {
            backend_text(&m.text, "_");
        }
        if decorate {
            if m.arch == 1 {
                if cc == 3 {
                    backend_text(&m.text, "@");
                }
                else {
                    if cc != 4 {
                        backend_text(&m.text, "_");
                    }
                }
            }
        }
    }
    backend_text(&m.text, m.name.name);
    if counted {
        backend_text(&m.text, "@");
        if cc == 4 {
            backend_text(&m.text, "@");
        }
        var count: usize = 0;
        foreach(var & arg in &m.function.args) {
            count = count + foreign_argument_bytes(m, *arg);
        }
        foreign_number(&m.text, count, 10);
    }
}

export fn foreign_mangle(profile: u32, declaration: u8*, cpp: bool, object: bool): ForeignName* {
    var m = alloc(ForeignName, 1);
    if m == null {
        return null;
    }
    fill(m, 0, sizeof(ForeignName));
    m.object_symbol = object;
    foreign_profile(m, profile);
    foreign_lex(m, declaration);
    if m.error.length == 0 {
        foreign_declaration(m);
    }
    if m.error.length == 0 {
        if cpp {
            if object {
                if m.object_format == 1 {
                    backend_text(&m.text, "_");
                }
            }
            if m.abi == 1 {
                foreign_itanium(m);
            }
            else {
                foreign_microsoft(m);
            }
        } else {
            foreign_c(m, object);
        }
    }
    if m.error.length != 0 {
        m.text.length = 0;
        if m.text.data != null {
            m.text.data[0] = 0;
        }
    }
    return m;
}

export fn cpp_name(profile: u32, declaration: u8*): ForeignName* {
    return foreign_mangle(profile, declaration, true, false);
}

export fn c_name(profile: u32, declaration: u8*): ForeignName* {
    return foreign_mangle(profile, declaration, false, false);
}

export fn foreign_name_text(m: ForeignName*): u8* {
    if m == null {
        return "";
    }
    if m.text.data == null {
        return "";
    }
    return m.text.data;
}

export fn foreign_name_error(m: ForeignName*): u8* {
    if m == null {
        return "Unable to allocate foreign name result";
    }
    if m.error.data == null {
        return "";
    }
    return m.error.data;
}
