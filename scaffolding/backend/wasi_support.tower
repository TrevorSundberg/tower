export fn `cpp_name(__wrap; static llvm::sys::MemoryBlock llvm::sys::Memory::allocateMappedMemory(unsigned long, llvm::sys::MemoryBlock const*, unsigned int, std::__2::error_code&))`(out: BackendWasiMemory*, size: usize, near: BackendWasiMemory*, flags: u32, error: BackendWasiError*): void {
