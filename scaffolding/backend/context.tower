import tower;
import bindings;
import foreign_api;
import text;
import observation_types;
import .compiler.foundation_types;
import .library.vector;
import .library.work_budget_types;

extern fn semantic_collect_comments_result(source: void*, destination: void*): bool;
extern fn sem_resource_message(error: WorkBudgetError): u8*;

// The only semantic inputs are existing Foundation entities. LLVM references,
// local slots and entity/value associations below are disposable lowering caches.
extern fn sem_get(node: void*): FoundationNode*;

extern fn semantic_size(type: FoundationType*): usize;

extern fn semantic_alignment(type: FoundationType*): usize;

extern fn semantic_width(type: FoundationType*): u32;

extern fn semantic_signed(type: FoundationType*): bool;
extern fn semantic_unsigned_scalar(scalar: u32): u32;
extern fn semantic_float(type: FoundationType*): bool;

extern fn semantic_aggregate(type: FoundationType*): bool;

extern fn semantic_type_equal(a: FoundationType*, b: FoundationType*): bool;
extern fn type_object_intern(values: vector(FoundationType)*, type: FoundationType*): u64;
extern fn type_object_program(root: void*): bool;
extern fn type_object_program_result(root: void*, budget: WorkBudget*, contains: bool*): WorkBudgetError;

struct BackendAssociation {
    entity: void*;
    value: void*;
}

struct BackendLoop {
    head: void*;
    after: void*;
}

// Independently owned name and the two declaration bits needed by the linker.
struct BackendSymbol {
    name: u8*;
    external: bool;
    exported: bool;
}

struct Backend {
    observation: BackendObservation;
    discard_ir: bool;
    context: void*;
    module: void*;
    builder: void*;
    machine: void*;
    layout: void*;
    pointer_bytes: u32;
    wasm: bool;
    foreign_profile: u32;
    i8: void*;
    i32: void*;
    i64: void*;
    size_type: void*;
    pointer_type: void*;
    functions: vector(void*);
    symbols: vector(BackendSymbol);
    source_functions: vector(void*);
    source_root: void*;
    locals: vector(void*);
    globals: vector(BackendAssociation);
    strings: vector(BackendAssociation);
    type_values: vector(FoundationType);
    loops: vector(BackendLoop);
    labels: vector(BackendAssociation);
    current: void*;
    print_fn: void*;
    trap_fn: void*;
    allocate_fn: void*;
    reallocate_fn: void*;
    deallocate_fn: void*;
    source_offset: usize;
    error_offset: usize;
    error: vector(u8);
    raw: u8*;
    optimized: u8*;
    object: void*;
    failed: bool;
    resource_error: WorkBudgetError;
}

fn backend_observe(b: Backend*, phase: BackendPhase, entering: bool): void {
    backend_observation_event(&b.observation, phase, entering);
}

fn backend_fail(b: Backend*, text: u8*): void {
    if !backend_failed(b) {
        b.failed = true;
        b.error_offset = b.source_offset;
        if !backend_text(&b.error, text) { b.resource_error = WorkBudgetError.Memory; }
    }
}

fn backend_failed(b: Backend*): bool {
    return b.failed || b.error.length != 0;
}

// The first receipt never depends on allocating its presentation. The backend
// is private to one session/worker; no world or global last-error slot is read.
fn backend_resource_fail(b: Backend*, error: WorkBudgetError): void {
    if error == WorkBudgetError.None || backend_failed(b) { return; }
    b.failed = true;
    b.resource_error = error;
    b.error_offset = b.source_offset;
}

fn backend_require(b: Backend*, ok: bool): void {
    if !ok {
        backend_resource_fail(b, WorkBudgetError.Memory);
    }
}

fn backend_name(n: FoundationNode*): u8* {
    if n.name.data == null {
        return "";
    }
    return n.name.data;
}

fn backend_associate(values: vector(BackendAssociation)*, entity: void*, value: void*): bool {
    var needed = values.length + 1;
    var ok = vector_reserve(values, needed);
    if ok {
        values.data[values.length].entity = entity;
        values.data[values.length].value = value;
        values.length = needed;
    }
    return ok;
}

fn backend_find(values: vector(BackendAssociation)*, entity: void*): void* {
    var i: usize = 0;
    loop {
        if i == values.length {
            return null;
        }
        if values.data[i].entity == entity {
            return values.data[i].value;
        }
        i++;
    }
}

export fn backend_error(b: Backend*): u8* {
    if b.error.length == 0 && b.resource_error != WorkBudgetError.None {
        return sem_resource_message(b.resource_error);
    }
    if b.error.data == null {
        return "";
    }
    return b.error.data;
}

export fn backend_resource_error(b: Backend*): WorkBudgetError { return b.resource_error; }

export fn backend_error_offset(b: Backend*): usize {
    return b.error_offset;
}

export fn backend_pointer_bytes(b: Backend*): u32 {
    return b.pointer_bytes;
}

export fn backend_raw(b: Backend*): u8* {
    return b.raw;
}

// Configure only before lowering. Default preserves both immutable text views.
// Object-only callers can avoid rendering them without changing verification,
// optimization, emission or the authoritative Foundation input.
export fn backend_retain_ir(b: Backend*, retain: bool): bool {
    if b == null || b.source_root != null || b.raw != null || b.optimized != null || b.object != null { return false; }
    b.discard_ir = !retain;
    return true;
}

export fn backend_optimized(b: Backend*): u8* {
    return b.optimized;
}

export fn backend_bytes(b: Backend*): u8* {
    if b.object != null {
        return LLVMGetBufferStart(b.object);
    }
    return null;
}

export fn backend_size(b: Backend*): usize {
    if b.object != null {
        return LLVMGetBufferSize(b.object);
    }
    return 0;
}

export fn backend_close(b: Backend*): void {
    var present = b == null;
    if present {
        return;
    }
    present = b.object != null;
    if present {
        LLVMDisposeMemoryBuffer(b.object);
    }
    present = b.raw != null;
    if present {
        LLVMDisposeMessage(b.raw);
    }
    present = b.optimized != null;
    if present {
        LLVMDisposeMessage(b.optimized);
    }
    present = b.builder != null;
    if present {
        LLVMDisposeBuilder(b.builder);
    }
    present = b.module != null;
    if present {
        LLVMDisposeModule(b.module);
    }
    present = b.layout != null;
    if present {
        LLVMDisposeTargetData(b.layout);
    }
    present = b.machine != null;
    if present {
        LLVMDisposeTargetMachine(b.machine);
    }
    present = b.context != null;
    if present {
        LLVMContextDispose(b.context);
    }
    foreach(var & symbol in &b.symbols) {
        free(symbol.name);
    }
    vector_dispose(&b.symbols);
    vector_dispose(&b.functions);
    vector_dispose(&b.source_functions);
    vector_dispose(&b.locals);
    vector_dispose(&b.globals);
    vector_dispose(&b.strings);
    vector_dispose(&b.type_values);
    vector_dispose(&b.loops);
    vector_dispose(&b.labels);
    vector_dispose(&b.error);
    free(b);
}

export fn backend_function_name(b: Backend*, index: usize): u8* {
    // O2 may erase unused LLVM declarations. Keep result names independently
    // of LLVM value lifetimes, while Foundation entities retain source spelling.
    var name = b.symbols.data[index].name;
    if name == null {
        return "";
    }
    return name;
}

// The executable driver walks the frozen object symbols in declaration order.
export fn backend_link_symbol(b: Backend*, index: usize, external: bool*, exported: bool*): u8* {
    if index >= b.symbols.length { return null; }
    var symbol = &b.symbols.data[index];
    *external = symbol.external;
    *exported = symbol.exported;
    return backend_function_name(b, index);
}
