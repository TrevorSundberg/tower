import tower;
import source_api;
import session;
import text;
import context;
import import_bindings;
import .compiler.semantic_program_types;
import .compiler.format_types;
import .compiler.component_kinds;
import .compiler.execution_profiles;
import .library.vector;
import .library.entity_types;
import .library.entity_api;
import .library.work_budget_types;

// Explicit request ownership above the graph backend. A caller pins its module
// environment for compilation; returned text/artifacts belong to this session.
struct BackendSource {
    backend: BackendSession*;
    foundation: vector(u8);
}

var BackendSourceImport: u32 = 4;
var BackendSourceUnoptimized: u32 = 8;

export fn backend_source_create(runtime: u8*, length: usize): BackendSource* {
    var source = alloc(BackendSource, 1);
    if source == null {
        return null;
    }
    *source = default;
    source.backend = backend_session_create(runtime, length);
    if source.backend == null {
        free(source);
        return null;
    }
    return source;
}

export fn backend_source_close(source: BackendSource*): void {
    if source == null {
        return;
    }
    backend_session_close(source.backend);
    vector_dispose(&source.foundation);
    free(source);
}

fn backend_source_program_close(program: SemanticProgram*): void {
    var root = program.root;
    semantic_program_dispose(program);
    if root != null { entity_release(bits(Entity*, root)); }
    *program = default;
}

fn backend_source_program(program: SemanticProgram*, world: void*, text: u8*, length: usize, width: u32, environment: void*): bool {
    *program = default;
    var error = WorkBudgetError.None;
    var root = entity_create_result(bits(EntityStore*, compiler_world_store(world)), &error);
    if root == null { program.resource.error = error; return false; }
    semantic_initialize(program, bits(void*, root), width);
    var input: FrontendSource;
    input.data = text;
    input.length = length;
    frontend_compile_sources(program, &input, 1, environment);
    return true;
}

fn backend_source_resource(source: BackendSource*, error: WorkBudgetError, offset: usize): u8* {
    var backend = source.backend.backend;
    var previous = backend.source_offset;
    backend.source_offset = offset;
    backend_resource_fail(backend, error);
    backend.source_offset = previous;
    return backend_session_failure(source.backend, backend_error(backend), backend.error_offset);
}

fn backend_source_error(source: BackendSource*, program: SemanticProgram*): u8* {
    if program.resource.error != WorkBudgetError.None {
        return backend_source_resource(source, program.resource.error, program.resource.offset);
    }
    // Frontend errors are length-delimited; never assume their storage has a NUL.
    var message: vector(u8);
    vector_init(&message);
    backend_text_append(&message, program.error.data, program.error.length);
    var result = backend_session_failure(source.backend,
    message.data ?? "Unable to allocate compiler diagnostic", program.error_offset);
    vector_dispose(&message);
    return result;
}

fn backend_source_import(source: BackendSource*, program: SemanticProgram*, width: u32, optimize: bool, environment: void*): u8* {
    var imported: SemanticProgram = default;
    defer backend_source_program_close(&imported);
    var world = compiler_node_world(program.root);
    var error: WorkBudgetError;
    var root = entity_create_result(bits(EntityStore*, compiler_world_store(world)), &error);
    if root == null {
        return backend_source_resource(source, error, 0);
    }
    semantic_initialize(&imported, bits(void*, root), width);
    var backend = source.backend;
    if imported.resource.error != WorkBudgetError.None {
        return backend_source_error(source, &imported);
    }
    var result = backend_session_response(backend);
    var preserve = false;
    error = type_object_program_result(program.root, compiler_world_work_budget(world), &preserve);
    if error != WorkBudgetError.None {
        backend_resource_fail(backend.backend, error);
        return backend_session_failure(backend, backend_error(backend.backend), backend.backend.error_offset);
    }
    if preserve || backend_session_import(backend, program.root, program.functions.data,
    program.functions.length, width, optimize, imported.root) {
        var formatted: FormatResult = {checked: true, budget: compiler_world_work_budget(world), ..default};
        defer format_dispose(&formatted);
        var candidate: vector(u8) = default;
        defer vector_dispose(&candidate);
        var output = preserve ? program.root : imported.root;
        format_entity(&formatted, output, compiler_node_type(output, CompilerSyntax),
            null, compiler_node_type(output, CompilerParserMatch));
        if formatted.failed {
            return backend_source_resource(source, formatted.resource_error == WorkBudgetError.None
                ? WorkBudgetError.Invalid : formatted.resource_error, 0);
        }
        if !vector_reserve(&candidate, formatted.text.length + 1) {
            result = backend_source_resource(source, WorkBudgetError.Memory, 0);
        } else {
            copy(candidate.data, formatted.text.data, formatted.text.length);
            candidate.length = formatted.text.length;
            candidate.data[candidate.length] = 0;
            // Import and format have joined. The standalone text is now the
            // only recheck input; neither graph nor formatter spans are read
            // again. Keep the previous session output until validation commits.
            format_dispose(&formatted);
            backend_source_program_close(&imported);
            backend_source_program_close(program);
            var checked: SemanticProgram = default;
            defer backend_source_program_close(&checked);
            if !backend_source_program(&checked, world, candidate.data, candidate.length, width, environment) {
                return backend_source_error(source, &checked);
            }
            if checked.resource.error != WorkBudgetError.None || checked.error.length != 0 {
                result = backend_source_error(source, &checked);
            }
            else {
                result = preserve ? backend_session_foundation_report(backend, ExecutionProfile.Canonical)
                    : backend_session_import_report(backend, optimize);
                if backend.response_fallback == null {
                    vector_dispose(&source.foundation);
                    source.foundation = candidate;
                    candidate = default;
                }
            }
        }
    } else {
        result = backend_session_response(backend);
    }
    return result;
}

export fn backend_source_compile(source: BackendSource*, text: u8*, length: usize, flags: u32, environment: void*, foundation_error: u8*): u8* {
    // Compatibility selection stays at this boundary; the entire request,
    // including optimized Foundation reconstruction, uses one explicit world.
    var world = frontend_modules_world(environment) ?? compiler_host_world();
    return backend_source_compile_world(source, world, text, length, flags, environment, foundation_error);
}

export fn backend_source_compile_world(source: BackendSource*, world: void*, text: u8*, length: usize, flags: u32, environment: void*, foundation_error: u8*): u8* {
    var backend = source.backend;
    // Foundation import has its own IR-only policy and emits no machine code.
    var codegen = (flags & BackendSourceImport) != 0 || (flags & BackendSourceUnoptimized) == 0
        ? BackendCodegen.Default : BackendCodegen.None;
    var width = backend_session_begin_codegen(backend, text, length, codegen);
    if width == 0 {
        return backend_session_response(backend);
    }
    if world == null { return backend_session_failure(backend, "A compiler world is required", 0); }
    var bound = frontend_modules_world(environment);
    if bound != null && bound != world {
        return backend_session_failure(backend, "Module environment belongs to another compiler world", 0);
    }
    if foundation_error != null && foundation_error[0] != 0 {
        return backend_session_failure(backend, foundation_error, 0);
    }
    // The frontend's source owner accepts terminated text. Its input bytes are
    // validated above and copied once, so it never reads past the caller's span.
    var terminated = alloc(u8, length + 1);
    if terminated == null {
        return backend_session_failure(backend, "Unable to allocate foundation source", 0);
    }
    copy(terminated, text, length);
    terminated[length] = 0;
    var program: SemanticProgram;
    var created = backend_source_program(&program, world, terminated, length, width, environment);
    free(terminated);
    if !created { return backend_source_error(source, &program); }
    var result: u8* = null;
    if program.resource.error != WorkBudgetError.None || program.error.length != 0 {
        result = backend_source_error(source, &program);
    }
    else {
        if(flags &BackendSourceImport) != 0 {
            result = backend_source_import(source, &program, width,
            (flags &BackendSourceUnoptimized) == 0, environment);
        } else {
            source.foundation.length = 0;
            if source.foundation.data != null { source.foundation.data[0] = 0; }
            result = backend_session_compile(backend, program.root, program.functions.data,
            program.functions.length, width, flags);
        }
    }
    backend_source_program_close(&program);
    return result;
}

export fn backend_source_foundation(source: BackendSource*): u8* {
    return source.foundation.data ?? "";
}
