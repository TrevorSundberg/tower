import tower;
import bindings;
import context;
import observation_types;

// Pass-by-pass verification is a debugging policy. Production still verifies
// lowering and the complete optimized module at the stage boundaries.
var BackendVerifyEach: i32 = 0;

fn backend_verify(b: Backend*): bool {
    var message: u8* = null;
    // LLVMReturnStatusAction: malformed IR is a diagnostic, never process abort.
    var status = LLVMVerifyModule(b.module, 2, &message);
    if status != 0 {
        backend_fail(b, message);
    }
    LLVMDisposeMessage(message);
    var result = status == 0;
    return result;
}

export fn backend_optimize(b: Backend*, optimize: bool): bool {
    var phase = BackendPhase.Optimization;
    backend_observe(b, phase, true);
    defer backend_observe(b, phase, false);
    var failed = backend_failed(b);
    if failed {
        return false;
    }
    if optimize {
        var options = LLVMCreatePassBuilderOptions();
        LLVMPassBuilderOptionsSetVerifyEach(options, BackendVerifyEach);
        var error = LLVMRunPasses(b.module, "function(sroa,mem2reg,instcombine<no-verify-fixpoint>,simplifycfg),default<O2>", b.machine, options);
        LLVMDisposePassBuilderOptions(options);
        failed = error != null;
        if failed {
            var message = LLVMGetErrorMessage(error);
            backend_fail(b, message);
            LLVMDisposeErrorMessage(message);
            return false;
        }
    }
    var valid = backend_verify(b);
    backend_observe(b, phase, false);
    phase = BackendPhase.OptimizedText;
    backend_observe(b, phase, true);
    if valid && !b.discard_ir {
        b.optimized = LLVMPrintModuleToString(b.module);
    }
    return valid;
}

export fn backend_emit(b: Backend*): bool {
    backend_observe(b, BackendPhase.Emission, true);
    defer backend_observe(b, BackendPhase.Emission, false);
    var failed = backend_failed(b);
    if failed {
        return false;
    }
    var message: u8* = null;
    // LLVMObjectFile, not assembly or an interchange encoding.
    var status = LLVMTargetMachineEmitToMemoryBuffer(b.machine, b.module, 1, &message, &b.object);
    failed = status != 0;
    if failed {
        backend_fail(b, message);
    }
    if message != null {
        LLVMDisposeMessage(message);
    }
    var result = status == 0;
    return result;
}
