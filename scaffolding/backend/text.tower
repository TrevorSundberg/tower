import tower;
import '../library/vector';

fn backend_length(text: u8*): usize {
    var count: usize = 0;
    var present = text != null;
    if present {
        loop {
            var done = text[count] == 0;
            if done {
                return count;
            }
            count++;
        }
    }
    return count;
}

fn backend_equal(a: u8*, b: u8*): bool {
    var i: usize = 0;
    loop {
        var different = a[i] != b[i];
        if different {
            return false;
        }
        var end = a[i] == 0;
        if end {
            return true;
        }
        i++;
    }
}

fn backend_prefix(a: u8*, b: u8*): bool {
    var i: usize = 0;
    loop {
        var end = b[i] == 0;
        if end {
            return true;
        }
        var different = a[i] != b[i];
        if different {
            return false;
        }
        i++;
    }
}

fn backend_text_append(out: vector(u8)*, text: u8*, count: usize): void {
    var end = out.length + count;
    var needed = end + 1;
    var ok = vector_reserve(u8, out, needed);
    if ok {
        copy(&out.data[out.length], text, count);
        out.length = end;
        out.data[end] = 0;
    }
}

fn backend_text(out: vector(u8)*, text: u8*): void {
    backend_text_append(out, text, backend_length(text));
}

fn backend_contains(text: u8*, part: u8*): bool {
    var i: usize = 0;
    loop {
        var end = text[i] == 0;
        if end {
            return false;
        }
        var found = backend_prefix(&text[i], part);
        if found {
            return true;
        }
        i++;
    }
}
