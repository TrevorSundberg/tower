import tower;
import .library.vector;

fn backend_length(text: u8*): usize {
    var count: usize = 0;
    if text != null {
        loop {
            if text[count] == 0 {
                return count;
            }
            count++;
        }
    }
    return count;
}

fn backend_equal(a: u8*, b: u8*): bool {
    var i: usize = 0;
    loop {
        if a[i] != b[i] {
            return false;
        }
        if a[i] == 0 {
            return true;
        }
        i++;
    }
}

fn backend_prefix(a: u8*, b: u8*): bool {
    var i: usize = 0;
    loop {
        if b[i] == 0 {
            return true;
        }
        if a[i] != b[i] {
            return false;
        }
        i++;
    }
}

fn backend_text_append(out: vector(u8)*, text: u8*, count: usize): bool {
    var maximum = ~convert(usize, 0);
    if out.length == maximum || count > maximum - out.length - 1 { return false; }
    var end = out.length + count;
    var needed = end + 1;
    if vector_reserve(out, needed) {
        copy(&out.data[out.length], text, count);
        out.length = end;
        out.data[end] = 0;
        return true;
    }
    return false;
}

fn backend_text(out: vector(u8)*, text: u8*): bool {
    return backend_text_append(out, text, backend_length(text));
}

fn backend_contains(text: u8*, part: u8*): bool {
    var i: usize = 0;
    loop {
        if text[i] == 0 {
            return false;
        }
        if backend_prefix(&text[i], part) {
            return true;
        }
        i++;
    }
}
