import tower;
import bindings;
import context;
import disassembly;
import import_bindings;
import import_foundation;
import import_values;
import text;
import .compiler.foundation_tags;
import .compiler.foundation_types;
import .compiler.type_primitives;
import .library.vector;
import .library.work_vector;
import .library.work_vector_types;
import .library.work_budget_types;
import .library.float_bits;

var LLVMFloatingNegateOpcode: u32 = 66;
var LLVMOverflowProductIndex: u32 = 0;
var LLVMOverflowFlagIndex: u32 = 1;
var LLVMOverflowExtractDepth: u32 = 1;

fn bi_multiply_overflow_call(instruction: void*): bool {
    if LLVMIsACallInst(instruction) == null { return false; }
    var function = LLVMGetCalledValue(instruction);
    if LLVMGetValueKind(function) != LLVMFunctionValueKind { return false; }
    var length: usize = 0;
    return backend_prefix(LLVMGetValueName2(function, &length), "llvm.umul.with.overflow.");
}

// LLVM folds ordinary unsigned size guards to a {product, overflow} result.
// Materialize its scalar users once at the call's position. These are the same
// predeclared Foundation locals as other SSA results, not a second aggregate IR.
fn bi_multiply_overflow(c: BackendImport*, instruction: void*): void {
    if backend_failed(c.backend) { return; }
    var left = LLVMGetOperand(instruction, 0);
    var type = LLVMTypeOf(left);
    if LLVMGetTypeKind(type) != 8 || LLVMGetIntTypeWidth(type) > 64 {
        backend_fail(c.backend, "Unsigned multiplication overflow requires a scalar integer up to 64 bits");
        return;
    }
    var scalar = bi_scalar(c, type);
    var a = bi_value(c, left);
    var b = bi_value(c, LLVMGetOperand(instruction, 1));
    var product: void* = null;
    var overflow: void* = null;
    if LLVMGetIntTypeWidth(type) == 1 {
        // Unsigned i1 has only 0 and 1: multiplication is AND and cannot
        // overflow. Foundation bool has no ordered arithmetic; never construct
        // its multiply/divide/comparison even for an unused aggregate field.
        product = bi_binary(c, OAnd, a, b, SBool);
        overflow = bi_const(c, SBool, 0);
    } else {
        product = bi_mask(c, bi_binary(c, OMul, a, b, scalar), type);
        var nonzero = bi_binary(c, ONe, a, bi_const(c, scalar, 0), SBool);
        // Select a nonzero divisor before evaluating the division. Zero operands
        // have a defined product/flag and must never introduce a division trap.
        var divisor = bi_select(c, nonzero, a, bi_const(c, scalar, 1), scalar);
        var maximum = bi_const(c, scalar, bi_pow2(LLVMGetIntTypeWidth(type)) - 1);
        var limit = bi_binary(c, ODiv, maximum, divisor, scalar);
        overflow = bi_binary(c, OAnd, nonzero, bi_binary(c, OGt, b, limit, SBool), SBool);
    }
    var use = LLVMGetFirstUse(instruction);
    while use != null {
        if backend_failed(c.backend) { return; }
        var extraction = LLVMGetUser(use);
        if LLVMIsAExtractValueInst(extraction) == null || LLVMGetNumIndices(extraction) != LLVMOverflowExtractDepth {
            backend_fail(c.backend, "Unsigned multiplication overflow requires scalar extractvalue consumers");
            return;
        }
        var index = LLVMGetIndices(extraction)[0];
        if index > LLVMOverflowFlagIndex {
            backend_fail(c.backend, "Invalid unsigned multiplication overflow result index");
            return;
        }
        var local = bi_find(&c.values, extraction);
        if local == null { backend_resource_fail(c.backend, WorkBudgetError.Invalid); return; }
        bi_assign(c, bi_ref(c, local), index == LLVMOverflowProductIndex ? product : overflow);
        use = LLVMGetNextUse(use);
    }
}

fn bi_edge(c: BackendImport*, from: void*, to: void*): void {
    if backend_failed(c.backend) { return; }
    var copies: work_vector(BackendAssociation) = default;
    defer work_vector_dispose(&copies);
    var instruction = LLVMGetFirstInstruction(to);
    loop {
        if backend_failed(c.backend) { return; }
        var done = instruction == null;
        if done {
            break;
        }
        done = LLVMGetInstructionOpcode(instruction) != 44;
        if done {
            break;
        }
        var count = LLVMCountIncoming(instruction);
        var i: u32 = 0;
        loop {
            if backend_failed(c.backend) { return; }
            done = i == count;
            if done {
                break;
            }
            if LLVMGetIncomingBlock(instruction, i) == from {
                var value = bi_value(c, LLVMGetIncomingValue(instruction, i));
                var snapshot = bi_decl(c, bi_scalar(c, LLVMTypeOf(instruction)));
                bi_assign(c, bi_ref(c, snapshot), value);
                var destination = bi_find(&c.values, instruction);
                bi_associate(c, &copies, destination, snapshot);
                break;
            }
            i++;
        }
        instruction = LLVMGetNextInstruction(instruction);
    }
    foreach(var & pair in &copies) {
        if backend_failed(c.backend) { return; }
        bi_assign(c, bi_ref(c, pair.entity), bi_ref(c, pair.value));
    }
    var target = bi_find(&c.blocks, to);
    var label = bi_get(c, target);
    if label == null { return; }
    var entity = bi_node(c, 32, 3);
    var jump = bi_get(c, entity);
    if jump == null { return; }
    backend_require(c.backend, backend_text(&jump.name, label.name.data));
    jump.binding = target;
    bi_append(c, c.block, entity);
}

fn bi_print(c: BackendImport*, value: void*, code: u32): void {
    if backend_failed(c.backend) { return; }
    if code == SF32 || code == SF64 {
        value = bi_float_unpack(c, value, code);
        var printed = bi_node(c, KPrint, SVoid);
        var print_node = bi_get(c, printed);
        if print_node == null { return; }
        if print_node == null { return; }
        print_node.value = value;
        bi_append(c, c.block, printed);
        return;
    }
    if code == SVoid {
        value = bi_cast(c, value, SUSize, false);
        value = bi_cast(c, value, BackendImportPointer, true);
    } else {
        var unsigned = semantic_unsigned_scalar(code);
        value = bi_cast(c, value, unsigned, false);
        if unsigned != code { value = bi_cast(c, value, code, true); }
    }
    var entity = bi_node(c, KPrint, SVoid);
    var n = bi_get(c, entity);
    if n == null { return; }
    n.value = value;
    bi_append(c, c.block, entity);
}

fn bi_float_unpack(c: BackendImport*, value: void*, scalar: u32): void* {
    if backend_failed(c.backend) { return null; }
    value = bi_cast(c, value, scalar == SF32 ? SU32 : SU64, false);
    return bi_cast(c, value, scalar, true);
}

fn bi_float_pack(c: BackendImport*, value: void*): void* {
    if backend_failed(c.backend) { return null; }
    var node = bi_get(c, value);
    if node == null { return null; }
    if node == null { return null; }
    var type = &node.type;
    if semantic_float(type) { value = bi_cast(c, value, type.scalar == SF32 ? SU32 : SU64, true); }
    return bi_cast(c, value, SU64, false);
}

fn bi_float_parameter(c: BackendImport*, instruction: void*, index: u32): u32 {
    if backend_failed(c.backend) { return 0; }
    var argument = LLVMGetOperand(instruction, index);
    if LLVMGetValueKind(argument) != LLVMConstantIntegerValueKind {
        backend_fail(c.backend, "Floating runtime descriptor must be constant");
        return 0;
    }
    return convert(u32, LLVMConstIntGetZExtValue(argument));
}

fn bi_float_type(c: BackendImport*, width: u32): u32 {
    if backend_failed(c.backend) { return 0; }
    var scalar = type_float_scalar(convert(u64, width));
    if scalar != InvalidTypeScalar { return scalar; }
    backend_fail(c.backend, "Unsupported floating runtime width");
    return SF64;
}

fn bi_float_integer_type(c: BackendImport*, width: u32, signed: bool): u32 {
    if backend_failed(c.backend) { return 0; }
    var scalar = type_integer_scalar(convert(u64, width), signed);
    if scalar != InvalidTypeScalar { return scalar; }
    backend_fail(c.backend, "Unsupported floating integer conversion width");
    return SU64;
}

fn bi_float_call(c: BackendImport*, instruction: void*, name: u8*): void* {
    if backend_failed(c.backend) { return null; }
    var input = bi_value(c, LLVMGetOperand(instruction, 0));
    if backend_equal(name, "tower_strict_float_binary") {
        var op = bi_float_parameter(c, instruction, 2);
        var scalar = bi_float_type(c, bi_float_parameter(c, instruction, 3));
        input = bi_float_unpack(c, input, scalar);
        var right = bi_float_unpack(c, bi_value(c, LLVMGetOperand(instruction, 1)), scalar);
        var result = bi_binary(c, op, input, right, op >= OEq ? SBool : scalar);
        return bi_float_pack(c, result);
    }
    var width = bi_float_parameter(c, instruction, 1);
    if backend_equal(name, "tower_strict_float_print") {
        bi_print(c, input, bi_float_type(c, width));
        return null;
    }
    var result: void* = null;
    if backend_equal(name, "tower_strict_float_from_integer") {
        var integer = bi_float_integer_type(c, width, bi_float_parameter(c, instruction, 2) != 0);
        var unsigned = semantic_unsigned_scalar(integer);
        input = bi_cast(c, bi_cast(c, input, unsigned, false), integer, true);
        var scalar = bi_float_type(c, bi_float_parameter(c, instruction, 3));
        result = bi_cast(c, input, scalar, false);
    } else {
        input = bi_float_unpack(c, input, bi_float_type(c, width));
        var destination = bi_float_parameter(c, instruction, 2);
        if backend_equal(name, "tower_strict_float_convert") {
            result = bi_cast(c, input, bi_float_type(c, destination), false);
        } else {
            var integer = bi_float_integer_type(c, destination, bi_float_parameter(c, instruction, 3) != 0);
            result = bi_cast(c, input, integer, false);
            var unsigned = semantic_unsigned_scalar(integer);
            if unsigned != integer { result = bi_cast(c, result, unsigned, true); }
        }
    }
    return bi_float_pack(c, result);
}

fn bi_call(c: BackendImport*, instruction: void*): void* {
    if backend_failed(c.backend) { return null; }
    var callee = LLVMGetCalledValue(instruction);
    var length: usize = 0;
    var name = LLVMGetValueName2(callee, &length);
    if backend_prefix(name, "tower_strict_float_") { return bi_float_call(c, instruction, name); }
    if backend_equal(name, "tower_print") {
        var code = LLVMGetOperand(instruction, 0);
        var value = bi_value(c, LLVMGetOperand(instruction, 1));
        if LLVMGetValueKind(code) == 18 {
            bi_print(c, value, convert(u32, LLVMConstIntGetZExtValue(code)));
        }
        else {
            code = bi_value(c, code);
            for(var i: u32 = 0; i != 9; i++) {
                if backend_failed(c.backend) { return null; }
                if i != 4 {
                    var test = bi_binary(c, 8, code, bi_const(c, 1, convert(u64, i)), 2);
                    var outer = c.block;
                    defer { c.block = outer; }
                    var branch = bi_get(c, bi_if(c, test));
                    if branch == null { return null; }
                    c.block = branch.body;
                    bi_print(c, value, i);
                }
            }
        }
        return null;
    }
    if backend_equal(name, "tower_trap") {
        var entity = bi_node(c, 33, 3);
        var n = bi_get(c, entity);
        if n == null { return null; }
        n.left = bi_value(c, LLVMGetOperand(instruction, 0));
        n.right = bi_cast(c, bi_value(c, LLVMGetOperand(instruction, 1)), 1, false);
        bi_append(c, c.block, entity);
        return null;
    }
    var allocating = backend_equal(name, "tower_allocate");
    var reallocating = backend_equal(name, "tower_reallocate");
    var deallocating = backend_equal(name, "tower_deallocate");
    var memory = allocating;
    if reallocating {
        memory = true;
    }
    if deallocating {
        memory = true;
    }
    if memory {
        var kind: u32 = 26;
        if reallocating {
            kind = 27;
        }
        if deallocating {
            kind = 28;
        }
        var entity = bi_node(c, kind, BackendImportPointer);
        var n = bi_get(c, entity);
        if n == null { return null; }
        var offset: u32 = 0;
        n.element.scalar = 5;
        n.element.pointer_bytes = c.backend.pointer_bytes;
        if !allocating {
            n.left = bi_value(c, LLVMGetOperand(instruction, 0));
            offset = 1;
        }
        if deallocating {
            n.type.scalar = 3;
            n.type.pointers = 0;
            bi_append(c, c.block, entity);
            return null;
        }
        var count = bi_cast(c, bi_value(c, LLVMGetOperand(instruction, offset)), 8, false);
        offset++;
        var size = bi_cast(c, bi_value(c, LLVMGetOperand(instruction, offset)), 8, false);
        // The generated runtime guards this product. Preserve failure as null
        // for overflow without allocating a wrapped, smaller object.
        var product = bi_binary(c, 2, count, size, 8);
        var safe_size = bi_select(c, bi_binary(c, 8, size, bi_const(c, 8, 0), 2), bi_const(c, 8, 1), size, 8);
        var restored = bi_binary(c, 3, product, safe_size, 8);
        var overflow = bi_binary(c, 9, restored, count, 2);
        var nonzero_size = bi_binary(c, 9, size, bi_const(c, 8, 0), 2);
        overflow = bi_binary(c, 5, overflow, nonzero_size, 2);
        var result = bi_decl(c, BackendImportPointer);
        var outer = c.block;
        defer { c.block = outer; }
        var branch = bi_get(c, bi_if(c, overflow));
        if branch == null { return null; }
        c.block = branch.body;
        bi_assign(c, bi_ref(c, result), bi_const(c, BackendImportPointer, 0));
        c.block = branch.otherwise;
        n.right = product;
        bi_assign(c, bi_ref(c, result), entity);
        return bi_ref(c, result);
    }
    var copy = backend_prefix(name, "llvm.memcpy.");
    if backend_prefix(name, "llvm.memmove.") {
        copy = true;
    }
    var fill_memory = backend_prefix(name, "llvm.memset.");
    memory = copy;
    if fill_memory {
        memory = true;
    }
    if memory {
        var kind: u32 = 29;
        if fill_memory {
            kind = 30;
        }
        var entity = bi_node(c, kind, 3);
        var n = bi_get(c, entity);
        if n == null { return null; }
        n.left = bi_value(c, LLVMGetOperand(instruction, 0));
        n.right = bi_value(c, LLVMGetOperand(instruction, 1));
        n.value = bi_cast(c, bi_value(c, LLVMGetOperand(instruction, 2)), 8, false);
        var volatile_flag = LLVMGetOperand(instruction, 3);
        if LLVMIsNull(volatile_flag) == 0 {
            backend_fail(c.backend, "Volatile LLVM memory requires an explicit foundation contract");
        }
        bi_append(c, c.block, entity);
        return null;
    }
    var ignored = backend_prefix(name, "llvm.lifetime.");
    if backend_equal(name, "llvm.assume") {
        ignored = true;
    }
    if ignored {
        return null;
    }
    // InstCombine recognizes these ordinary scalar idioms even without target
    // vectorization. Legalize their bit semantics; do not re-optimize the graph.
    if backend_prefix(name, "llvm.ctpop.") {
        var type = LLVMTypeOf(instruction);
        if !(LLVMGetTypeKind(type) == 8) {
            backend_fail(c.backend, "Population count reconstruction requires a scalar integer");
            return null;
        }
        var width = LLVMGetIntTypeWidth(type);
        if !(width <= 64) {
            backend_fail(c.backend, "Population count reconstruction supports up to 64 bits");
            return null;
        }
        var scalar = bi_scalar(c, type);
        var value = bi_mask(c, bi_value(c, LLVMGetOperand(instruction, 0)), type);
        // Sum adjacent bit groups, doubling their width each step. The masks
        // also cover non-power-of-two LLVM widths without out-of-range shifts.
        var group: u32 = 1;
        while group < width {
            if backend_failed(c.backend) { return null; }
            var mask: u64 = 0;
            var bit: u64 = 1;
            for(var position: u32 = 0; position < width; position++) {
                if backend_failed(c.backend) { return null; }
                var part = position / group;
                part = part % 2;
                var low = part == 0;
                if low {
                    mask = mask | bit;
                }
                bit = bit * 2;
            }
            var low = bi_binary(c, OAnd, value, bi_const(c, scalar, mask), scalar);
            var high = bi_binary(c, ODiv, value, bi_const(c, scalar, bi_pow2(group)), scalar);
            high = bi_binary(c, OAnd, high, bi_const(c, scalar, mask), scalar);
            value = bi_binary(c, OAdd, low, high, scalar);
            group = group * 2;
        }
        return value;
    }
    if backend_prefix(name, "llvm.abs.") {
        var type = LLVMTypeOf(instruction);
        var scalar = bi_scalar(c, type);
        var a = bi_value(c, LLVMGetOperand(instruction, 0));
        var sign_width = LLVMGetIntTypeWidth(type) -1;
        var negative = bi_binary(c, 13, a, bi_const(c, scalar, bi_pow2(sign_width)), 2);
        var negated = bi_mask(c, bi_binary(c, 1, bi_const(c, scalar, 0), a, scalar), type);
        return bi_select(c, negative, negated, a, scalar);
    }
    var unsigned_add = backend_prefix(name, "llvm.uadd.sat.");
    var unsigned_subtract = backend_prefix(name, "llvm.usub.sat.");
    var signed_add = backend_prefix(name, "llvm.sadd.sat.");
    var signed_subtract = backend_prefix(name, "llvm.ssub.sat.");
    var saturating = unsigned_add;
    if unsigned_subtract {
        saturating = true;
    }
    if signed_add {
        saturating = true;
    }
    if signed_subtract {
        saturating = true;
    }
    if saturating {
        var type = LLVMTypeOf(instruction);
        var scalar = bi_scalar(c, type);
        var a = bi_value(c, LLVMGetOperand(instruction, 0));
        var b = bi_value(c, LLVMGetOperand(instruction, 1));
        var subtract = unsigned_subtract;
        if signed_subtract {
            subtract = true;
        }
        var operation: u32 = 0;
        if subtract {
            operation = 1;
        }
        var result = bi_mask(c, bi_binary(c, operation, a, b, scalar), type);
        var width = LLVMGetIntTypeWidth(type);
        if unsigned_add {
            var overflow = bi_binary(c, 10, result, a, 2);
            var maximum = bi_pow2(width) -1;
            return bi_select(c, overflow, bi_const(c, scalar, maximum), result, scalar);
        }
        if unsigned_subtract {
            var overflow = bi_binary(c, 10, a, b, 2);
            return bi_select(c, overflow, bi_const(c, scalar, 0), result, scalar);
        }
        var changed = bi_binary(c, 7, a, result, scalar);
        var other = bi_binary(c, 7, b, result, scalar);
        if subtract {
            other = bi_binary(c, 7, a, b, scalar);
        }
        changed = bi_binary(c, 5, changed, other, scalar);
        var sign_width = width -1;
        var sign = bi_pow2(sign_width);
        var overflow = bi_binary(c, 13, changed, bi_const(c, scalar, sign), 2);
        var negative = bi_binary(c, 13, a, bi_const(c, scalar, sign), 2);
        var maximum = sign -1;
        var limit = bi_select(c, negative, bi_const(c, scalar, sign), bi_const(c, scalar, maximum), scalar);
        return bi_select(c, overflow, limit, result, scalar);
    }
    var minimum = backend_prefix(name, "llvm.umin.");
    var maximum = backend_prefix(name, "llvm.umax.");
    var signed_minimum = backend_prefix(name, "llvm.smin.");
    var signed_maximum = backend_prefix(name, "llvm.smax.");
    var minmax = minimum;
    if maximum {
        minmax = true;
    }
    if signed_minimum {
        minmax = true;
    }
    if signed_maximum {
        minmax = true;
    }
    if minmax {
        var a = bi_value(c, LLVMGetOperand(instruction, 0));
        var b = bi_value(c, LLVMGetOperand(instruction, 1));
        var predicate: u32 = 36;
        if maximum {
            predicate = 34;
        }
        if signed_minimum {
            predicate = 40;
        }
        if signed_maximum {
            predicate = 38;
        }
        var type = LLVMTypeOf(instruction);
        var condition = bi_compare(c, predicate, a, b, type);
        return bi_select(c, condition, a, b, bi_scalar(c, type));
    }
    var binding = bi_find(&c.values, callee);
    var direct = binding != null && sem_get(binding).kind == KFunction;
    if !direct && LLVMGetValueKind(callee) == LLVMFunctionValueKind {
        backend_fail(c.backend, "Unsupported LLVM intrinsic or indirect call: ");
        backend_text(&c.backend.error, name);
        return null;
    }
    var entity = bi_node(c, KCall, bi_scalar(c, LLVMTypeOf(instruction)));
    var n = bi_get(c, entity);
    if n == null { return null; }
    var function: FoundationNode* = null;
    if direct {
        n.binding = binding;
        function = bi_get(c, binding);
        if function == null { return null; }
        n.type = function.type;
    } else {
        var type = bi_llvm_function_type(c, LLVMGetCalledFunctionType(instruction));
        if type == null { return null; }
        function = bi_get(c, type.record);
        if function == null { return null; }
        n.value = bi_cast_type(c, bi_value(c, callee), type);
        n.type = function.element;
    }
    var count = LLVMGetNumArgOperands(instruction);
    if convert(usize, count) != function.parameters.length {
        backend_fail(c.backend, "LLVM call argument count differs from its Foundation signature"); return null;
    }
    var i: u32 = 0;
    for(; i != count; i++) {
        if backend_failed(c.backend) { return null; }
        var value = bi_value(c, LLVMGetOperand(instruction, i));
        var parameter = bi_get(c, function.parameters.data[convert(usize, i)]);
        if parameter == null { return null; }
        value = bi_cast_type(c, value, &parameter.type);
        backend_require(c.backend, vector_push(&n.items, value));
    }
    // A preserved source signature may have a void base with pointer depth.
    // Only actual void lacks a value; void* and void** need the normal result
    // temporary and checked conversion back to the LLVM destination type.
    if n.type.scalar == SVoid && n.type.pointers == 0 {
        bi_append(c, c.block, entity);
        return null;
    }
    return bi_cast(c, bi_temp(c, entity), bi_scalar(c, LLVMTypeOf(instruction)), true);
}

fn bi_instruction(c: BackendImport*, instruction: void*, block: void*): void* {
    if backend_failed(c.backend) { return null; }
    if bi_multiply_overflow_call(instruction) { bi_multiply_overflow(c, instruction); return null; }
    if LLVMIsAExtractValueInst(instruction) != null && bi_multiply_overflow_call(LLVMGetOperand(instruction, 0)) {
        return null; // Its local was assigned once at the intrinsic call.
    }
    var op = LLVMGetInstructionOpcode(instruction);
    var type = LLVMTypeOf(instruction);
    var scalar = bi_scalar(c, type);
    var selected = op == 1;
    if selected {
        var entity = bi_node(c, 18, 3);
        var n = bi_get(c, entity);
        if n == null { return null; }
        if LLVMGetNumOperands(instruction) != 0 {
            n.value = bi_value(c, LLVMGetOperand(instruction, 0));
            var function = bi_get(c, c.function);
            if function == null { return null; }
            n.value = bi_cast_type(c, n.value, &function.type);
        }
        bi_append(c, c.block, entity);
        return null;
    }
    selected = op == 2;
    if selected {
        if LLVMGetNumSuccessors(instruction) == 2 {
            var condition = bi_value(c, LLVMGetCondition(instruction));
            var outer = c.block;
            defer { c.block = outer; }
            var branch = bi_get(c, bi_if(c, condition));
            if branch == null { return null; }
            c.block = branch.body;
            bi_edge(c, block, LLVMGetSuccessor(instruction, 0));
            c.block = branch.otherwise;
            bi_edge(c, block, LLVMGetSuccessor(instruction, 1));
        } else {
            bi_edge(c, block, LLVMGetSuccessor(instruction, 0));
        }
        return null;
    }
    selected = op == 7;
    if selected {
        // A defined Tower execution reaches unreachable only after an explicit
        // trap. Retain a deterministic diagnostic for corrupted/undefined input.
        var entity = bi_node(c, 33, 3);
        var n = bi_get(c, entity);
        if n == null { return null; }
        var message = bi_node(c, KString, BackendImportPointer);
        var text = bi_get(c, message);
        if text == null { return null; }
        backend_require(c.backend, backend_text(&text.name, "Reached unreachable LLVM block"));
        n.left = message;
        n.right = bi_const(c, 1, 0);
        bi_append(c, c.block, entity);
        return null;
    }
    selected = op == 44;
    if selected {
        return null;
    }
    selected = op == 45;
    if selected {
        return bi_call(c, instruction);
    }
    selected = op == 29;
    if selected {
        return bi_gep(c, instruction);
    }
    selected = op == 26;
    if selected {
        var count = LLVMGetOperand(instruction, 0);
        if !(LLVMGetValueKind(count) == 18) {
            backend_fail(c.backend, "Dynamic LLVM alloca cannot be represented by a static foundation local");
            return bi_const(c, BackendImportPointer, 0);
        }
        var bytes = LLVMABISizeOfType(c.backend.layout, LLVMGetAllocatedType(instruction));
        bytes = bytes * LLVMConstIntGetZExtValue(count);
        var storage = bi_storage(c, bytes, LLVMGetAlignment(instruction), false);
        return bi_address(c, bi_ref(c, storage));
    }
    selected = op == 28;
    var load = op == 27;
    if load {
        selected = true;
    }
    if selected {
        var invalid = LLVMGetVolatile(instruction) != 0;
        if LLVMGetOrdering(instruction) != 0 {
            invalid = true;
        }
        if invalid {
            backend_fail(c.backend, "Atomic/volatile LLVM memory requires an explicit foundation contract");
        }
        if load {
            return bi_memory_load(c, bi_value(c, LLVMGetOperand(instruction, 0)), type);
        }
        var stored = LLVMGetOperand(instruction, 0);
        bi_memory_store(c, bi_value(c, LLVMGetOperand(instruction, 1)), bi_value(c, stored), LLVMTypeOf(stored));
        return null;
    }
    // Diagnose before querying operands: some unsupported instructions have no
    // operands, and LLVM's C API requires valid indices even in release builds.
    var supported_shape = op >= 8;
    supported_shape &&= op <= 25;
    var cast_shape = op >= 30;
    cast_shape &&= op <= 32;
    if cast_shape {
        supported_shape = true;
    }
    cast_shape = op >= 39;
    cast_shape &&= op <= 42;
    if cast_shape {
        supported_shape = true;
    }
    selected = op == 46;
    if selected {
        supported_shape = true;
    }
    selected = op == 68;
    if selected {
        supported_shape = true;
    }
    if op == LLVMFloatingNegateOpcode { supported_shape = true; }
    if !supported_shape {
        backend_fail(c.backend, "Unsupported LLVM instruction in foundation return path: ");
        backend_decimal(&c.backend.error, convert(u64, op));
        return null;
    }
    var a_value = LLVMGetOperand(instruction, 0);
    var a = bi_value(c, a_value);
    if op == LLVMFloatingNegateOpcode {
        var integer = scalar == SF32 ? SU32 : SU64;
        var sign = scalar == SF32 ? Float32Sign : Float64Sign;
        var raw = bi_cast(c, a, integer, true);
        raw = bi_binary(c, OXor, raw, bi_const(c, integer, sign), integer);
        return bi_cast(c, raw, scalar, true);
    }
    selected = op == 68;
    if selected {
        return a;
    }
    selected = op == 30;
    if op == 31 {
        selected = true;
    }
    if selected {
        return bi_mask(c, a, type);
    }
    selected = op == 32;
    if selected {
        a = bi_signed(c, a, LLVMTypeOf(a_value));
        a = bi_cast(c, a, 7, true);
        return bi_mask(c, a, type);
    }
    selected = op == 39;
    if selected {
        a = bi_cast(c, a, 8, true);
        return bi_mask(c, a, type);
    }
    selected = op == 40;
    if selected {
        a = bi_cast(c, a, 8, false);
        return bi_cast(c, a, BackendImportPointer, true);
    }
    selected = op == 41;
    if selected {
        return bi_cast(c, a, scalar, true);
    }
    var b = bi_value(c, LLVMGetOperand(instruction, 1));
    selected = op == 42;
    if selected {
        return bi_compare(c, LLVMGetICmpPredicate(instruction), a, b, LLVMTypeOf(a_value));
    }
    selected = op == 46;
    if selected {
        var no = bi_value(c, LLVMGetOperand(instruction, 2));
        return bi_select(c, a, b, no, scalar);
    }
    selected = op >= 20;
    selected &&= op <= 22;
    if selected {
        return bi_shift(c, op, a, b, type, LLVMGetOperand(instruction, 1));
    }
    var binary: u32 = 99;
    selected = op == 8;
    if selected {
        binary = 0;
    }
    selected = op == 10;
    if selected {
        binary = 1;
    }
    selected = op == 12;
    if selected {
        binary = 2;
    }
    selected = op == 14;
    if selected {
        binary = 3;
    }
    selected = op == 15;
    if selected {
        binary = 3;
    }
    selected = op == 17;
    if selected {
        binary = 4;
    }
    selected = op == 18;
    if selected {
        binary = 4;
    }
    selected = op == 23;
    if selected {
        binary = 5;
    }
    selected = op == 24;
    if selected {
        binary = 6;
    }
    selected = op == 25;
    if selected {
        binary = 7;
    }
    if binary != 99 {
        var signed = op == 15;
        selected = op == 18;
        if selected {
            signed = true;
        }
        if signed {
            a = bi_signed(c, a, type);
            b = bi_signed(c, b, type);
            a = bi_binary(c, binary, a, b, 6);
            a = bi_cast(c, a, 7, true);
        } else {
            a = bi_binary(c, binary, a, b, scalar);
        }
        return bi_mask(c, a, type);
    }
    backend_fail(c.backend, "Unsupported LLVM instruction in foundation return path: ");
    backend_decimal(&c.backend.error, convert(u64, op));
    return bi_const(c, scalar, 0);
}
