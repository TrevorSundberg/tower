import tower;
import pe_types;
import pe_link_symbols;
import pe_link_emit;
import .library.work_pool;
fn pe_link_run(link: PeLink*): bool {
    link.output.length = 0;
    if link.store == null || link.started || link.workers == 0 || link.workers > WorkPoolMaximumCapacity { return pe_fail(&link.error, PeError.Input, link.entry, 0); }
    link.started = true;
    if link.error.kind == PeError.None && pe_link_symbols(link) && pe_link_emit(link) { return true; }
    link.output.length = 0;
    if link.error.kind == PeError.None { pe_fail(&link.error, PeError.Allocation, default(WasmBytes), 0); }
    return false;
}
