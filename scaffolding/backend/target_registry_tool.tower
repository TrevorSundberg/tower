import tower;
import target_registry_source;
import .tools.tool_streams_posix;
import .compiler.host_text;
import .library.bytes;
import .library.bytes_types;
import .host.driver_files;

var LlvmRegistryFileBytes: usize = 1048576;

fn llvm_registry_read(directory: u8*, name: u8*, out: ByteBuffer*): bool {
    var path: ByteBuffer = default; defer bytes_dispose(&path);
    return llvm_registry_text(&path, directory) && llvm_registry_text(&path, "/")
        && llvm_registry_text(&path, name) && host_text_terminate(&path)
        && tool_read_file(path.data, LlvmRegistryFileBytes, out);
}

// Invoked by the existing foreign build tool. All input reads finish before the
// output is opened; write/close failures propagate through the normal CLI status.
fn llvm_registry_command(directory: u8*, output: u8*): bool {
    var targets: ByteBuffer = default; var printers: ByteBuffer = default;
    var disassemblers: ByteBuffer = default; var source: ByteBuffer = default;
    defer bytes_dispose(&targets); defer bytes_dispose(&printers);
    defer bytes_dispose(&disassemblers); defer bytes_dispose(&source);
    return llvm_registry_read(directory, "Targets.def", &targets)
        && llvm_registry_read(directory, "AsmPrinters.def", &printers)
        && llvm_registry_read(directory, "Disassemblers.def", &disassemblers)
        && llvm_registry_source(&targets, &printers, &disassemblers, &source)
        && driver_write_file(output, source.data, source.length);
}
