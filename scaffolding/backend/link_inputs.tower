import tower;
import link_types;
import text;
import .library.vector;

fn backend_link_inputs_release(inputs: vector(BackendLinkInput)*): void {
    foreach (var & input in inputs) {
        vector_dispose(&input.name);
        vector_dispose(&input.bytes);
    }
    inputs.length = 0;
}

// Commit a complete owned copy only after allocation succeeds. The caller may
// pass bytes borrowed from the old entry; replacement must not invalidate them.
fn backend_link_input_store(inputs: vector(BackendLinkInput)*, name: u8*, data: u8*, length: usize): bool {
    if name == null || (data == null && length != 0) || length == ~convert(usize, 0) { return false; }
    var input: BackendLinkInput = default;
    defer { vector_dispose(&input.name); vector_dispose(&input.bytes); }
    var name_length = backend_length(name);
    backend_text_append(&input.name, name, name_length);
    backend_text_append(&input.bytes, data, length);
    if input.name.data == null || input.name.length != name_length || input.bytes.data == null || input.bytes.length != length { return false; }
    foreach (var & previous in inputs) {
        if backend_equal(previous.name.data, name) {
            vector_dispose(&previous.name); vector_dispose(&previous.bytes);
            *previous = input; input = default; return true;
        }
    }
    if !vector_push(inputs, input) { return false; }
    input = default; return true;
}
