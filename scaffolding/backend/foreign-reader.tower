        var part = convert(u64, text[i]);
        part = part - 48;
        var maximum: u64 = 18446744073709551615;
        var limit = maximum - part;
        limit = limit / 10;
        var overflow = value > limit;
        if overflow {
            foreign_fail(m, "Foreign integer literal exceeds 64 bits");
            return 0;
