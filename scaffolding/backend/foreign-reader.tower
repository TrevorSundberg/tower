}

fn foreign_qualifiers(m: ForeignName*): u32 {
    var result: u32 = 0;
    loop {
        if foreign_take(m, "const") {
            result = result | 1;
            continue;
        }
        if foreign_take(m, "volatile") {
            result = result | 2;
            continue;
        }
        if foreign_take(m, "restrict") {
            result = result | 4;
            continue;
        }
        if foreign_take(m, "__restrict") {
            result = result | 4;
            continue;
        }
        break;
    }
    return result;
}

fn foreign_cc(m: ForeignName*): u32 {
    if foreign_take(m, "__cdecl") {
        return 1;
    }
    if foreign_take(m, "__stdcall") {
        return 2;
    }
    if foreign_take(m, "__fastcall") {
        return 3;
    }
    if foreign_take(m, "__vectorcall") {
        return 4;
    }
    if foreign_take(m, "__thiscall") {
        return 5;
    }
    return 0;
}

