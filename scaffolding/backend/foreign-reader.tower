        }
        var byte = source[i];
        var space = byte <= 32;
        if space {
            i = i + 1;
            continue;
        }
        var separator = byte == 58;
        if separator {
            var next = i + 1;
            var single = source[next] != 58;
            if single {
                i = i + 1;
                continue;
            }
        }
        var start = i;
        i = i + 1;
        var word = foreign_word(byte);
        if word {
            loop {
                var more = foreign_word(source[i]);
                var foreign_condition141 = more == false;
                if foreign_condition141 {
                    more = foreign_digit(source[i]);
                }
                var foreign_condition142 = more == false;
                if foreign_condition142 {
                    break;
                }
                i = i + 1;
            }
        } else {
            var digit = foreign_digit(byte);
            if digit {
                loop {
                    var more = foreign_digit(source[i]);
                    var foreign_condition143 = more == false;
                    if foreign_condition143 {
                        break;
                    }
                    i = i + 1;
                }
            } else {
                var colon = byte == 58;
                if colon {
                    var foreign_condition144 = source[i] == 58;
                    if foreign_condition144 {
                        i = i + 1;
                    }
                }
                var amp = byte == 38;
                if amp {
                    var foreign_condition145 = source[i] == 38;
                    if foreign_condition145 {
                        i = i + 1;
                    }
                }
                var dot = byte == 46;
                if dot {
                    var foreign_condition146 = source[i] == 46;
                    if foreign_condition146 {
                        i = i + 1;
                        var foreign_condition147 = source[i] == 46;
                        if foreign_condition147 {
                            i = i + 1;
                        }
                    }
                }
            }
        }
        var count = i - start;
        foreign_require(m, vector_push(u8*, &m.tokens, foreign_copy(m, &source[start], count)));
        foreign_require(m, vector_push(usize, &m.offsets, start));
    }
    foreign_require(m, vector_push(u8*, &m.tokens, ""));
    foreign_require(m, vector_push(usize, &m.offsets, length));
}

fn foreign_peek(m: ForeignName*): u8* {
    var valid = m.at < m.tokens.length;
    if valid {
        return m.tokens.data[m.at];
    }
    return "";
}

fn foreign_take(m: ForeignName*, text: u8*): bool {
    var match = backend_equal(foreign_peek(m), text);
    if match {
        m.at = m.at + 1;
    }
    return match;
}

fn foreign_expect(m: ForeignName*, text: u8*): void {
    var ok = foreign_take(m, text);
    var foreign_condition148 = ok == false;
    if foreign_condition148 {
        foreign_fail(m, "Expected wordtext in foreign declaration: ");
        backend_text(&m.error, text);
    }
}

fn foreign_integer(m: ForeignName*): u64 {
    var text = foreign_peek(m);
    var value: u64 = 0;
    var i: usize = 0;
    loop {
