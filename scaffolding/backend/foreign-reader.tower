// Foreign declaration descriptions are temporary mangler data, not Tower IR.
// Their source spelling is the declaration supplied to cpp_name/c_name.
struct ForeignType {
    kind: u32;
    cv: u32;
    tag: u32;
    name: u8*;
    base: ForeignType*;
    scope: ForeignType*;
    args: vector(ForeignType*);
    count: u64;
    convention: u32;
    ref: u32;
    variadic: bool;
    nothrow: bool;
    template_id: bool;
    operator_name: bool;
}

struct ForeignAlias {
    name: u8*;
    type: ForeignType*;
}

struct ForeignName {
    text: vector(u8);
    error: vector(u8);
    error_offset: usize;
    tokens: vector(u8*);
    offsets: vector(usize);
    at: usize;
    memory: vector(void*);
    types: vector(ForeignType*);
    aliases: vector(ForeignAlias);
    substitutions: vector(u8*);
    ms_names: vector(u8*);
    profile: u32;
    object_symbol: bool;
    abi: u32;
    pointer_bytes: u32;
    long_bytes: u32;
    object_format: u32;
    arch: u32;
    member: u32;
    access: u32;
    special: u32;
    convention: u32;
    function: ForeignType*;
    name: ForeignType*;
    depth: u32;
    abi_tags: vector(u8*);
}

// Profile constants are functions until Foundation supports enum values.
export fn foreign_windows_arm64ec(): u32 {
    return 11;
}

export fn foreign_wasi(): u32 {
    return 1;
}

export fn foreign_linux_x64(): u32 {
    return 2;
}

export fn foreign_macos_x64(): u32 {
    return 3;
}

export fn foreign_macos_arm64(): u32 {
    return 4;
}

export fn foreign_windows_x64(): u32 {
    return 5;
}

export fn foreign_windows_x86(): u32 {
    return 6;
}

export fn foreign_mingw_x64(): u32 {
    return 7;
}

export fn foreign_linux_arm64(): u32 {
    return 8;
}

export fn foreign_linux_x86(): u32 {
    return 9;
}

export fn foreign_windows_arm64(): u32 {
    return 10;
}

fn foreign_fail(m: ForeignName*, text: u8*): void {
    var first = m.error.length == 0;
    if first {
        backend_text(&m.error, text);
        var valid = m.at < m.offsets.length;
        if valid {
            m.error_offset = m.offsets.data[m.at];
        }
    }
}

fn foreign_require(m: ForeignName*, ok: bool): void {
    var failed = ok == false;
    if failed {
        foreign_fail(m, "Unable to allocate foreign declaration storage");
    }
}

fn foreign_copy(m: ForeignName*, source: u8*, count: usize): u8* {
    var size = count + 1;
    var text = alloc(u8, size);
    var present = text != null;
    foreign_require(m, present);
    if present {
        copy(text, source, count);
        text[count] = 0;
        foreign_require(m, vector_push(void*, &m.memory, bits(void*, text)));
        return text;
    }
    return "";
}

fn foreign_node(m: ForeignName*, kind: u32): ForeignType* {
    var type = alloc(ForeignType, 1);
    var present = type != null;
    foreign_require(m, present);
    if present {
        fill(type, 0, sizeof(ForeignType));
        type.kind = kind;
        type.name = "";
        foreign_require(m, vector_push(ForeignType*, &m.types, type));
    }
    return type;
}

fn foreign_clone(m: ForeignName*, type: ForeignType*): ForeignType* {
    var result = foreign_node(m, type.kind);
    copy(result, type, sizeof(ForeignType));
    vector_init(ForeignType*, &result.args);
    var i: usize = 0;
    loop {
        var done = i == type.args.length;
        if done {
            break;
        }
        foreign_require(m, vector_push(ForeignType*, &result.args, type.args.data[i]));
        i = i + 1;
    }
    return result;
}

fn foreign_word(byte: u8): bool {
    var ok = byte >= 65;
    if ok {
        ok = byte <= 90;
    }
    if ok {
        return true;
    }
    ok = byte >= 97;
    if ok {
        ok = byte <= 122;
    }
    if ok {
        return true;
    }
    var foreign_result187 = byte == 95;
    return foreign_result187;
}

fn foreign_digit(byte: u8): bool {
    var ok = byte >= 48;
    if ok {
        ok = byte <= 57;
    }
    return ok;
}

fn foreign_lex(m: ForeignName*, source: u8*): void {
    var length = backend_length(source);
    var large = length > 16384;
    if large {
        foreign_fail(m, "Foreign declaration exceeds 16384 bytes");
        return;
    }
    var i: usize = 0;
    loop {
        var done = i == length;
        if done {
