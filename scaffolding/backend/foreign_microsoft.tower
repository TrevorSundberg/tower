import tower;
import foreign_declarators;
import foreign_itanium;
import foreign_operators;
import foreign_reader;
import text;
import .library.vector;

// Microsoft name mangling. Source of truth/reference: upstream Clang MicrosoftMangle.
// Name backreferences and parameter backreferences have separate scopes.
fn foreign_ms_builtin(type: ForeignType*): u8* {
    var code = type.name;
    if backend_equal(code, "v") {
        return "X";
    }
    if backend_equal(code, "a") {
        return "C";
    }
    if backend_equal(code, "c") {
        return "D";
    }
    if backend_equal(code, "h") {
        return "E";
    }
    if backend_equal(code, "s") {
        return "F";
    }
    if backend_equal(code, "t") {
        return "G";
    }
    if backend_equal(code, "i") {
        return "H";
    }
    if backend_equal(code, "j") {
        return "I";
    }
    if backend_equal(code, "l") {
        return "J";
    }
    if backend_equal(code, "m") {
        return "K";
    }
    if backend_equal(code, "f") {
        return "M";
    }
    if backend_equal(code, "d") {
        return "N";
    }
    if backend_equal(code, "e") {
        return "O";
    }
    if backend_equal(code, "x") {
        return "_J";
    }
    if backend_equal(code, "y") {
        return "_K";
    }
    if backend_equal(code, "n") {
        return "_L";
    }
    if backend_equal(code, "o") {
        return "_M";
    }
    if backend_equal(code, "b") {
        return "_N";
    }
    if backend_equal(code, "Du") {
        return "_Q";
    }
    if backend_equal(code, "Ds") {
        return "_S";
    }
    if backend_equal(code, "Di") {
        return "_U";
    }
    if backend_equal(code, "w") {
        return "_W";
    }
    if backend_equal(code, "Dn") {
        return "$$T";
    }
    return "";
}

fn foreign_ms_number(m: ForeignName*, value: u64): void {
    if value == 0 {
        foreign_text(m, &m.text, "A@");
        return;
    }
    if value <= 10 {
        var digit = value -1;
        foreign_number64(m, &m.text, digit, 10);
        return;
    }
    var digits: u8[32];
    var count: usize = 0;
    loop {
        var part = value % 16;
        part = part + 65;
        digits[count] = convert(u8, part);
        count++;
        value = value / 16;
        if value == 0 {
            break;
        }
    }
    loop {
        if count == 0 {
            break;
        }
        count--;
        foreign_text_append(m, &m.text, &digits[count], 1);
    }
    foreign_text(m, &m.text, "@");
}

fn foreign_ms_cv(m: ForeignName*, cv: u32): void {
    var value = cv &3;
    value = value + 65;
    var byte = convert(u8, value);
    foreign_text_append(m, &m.text, &byte, 1);
}

fn foreign_ms_identifier(m: ForeignName*, name: u8*): void {
    var i: usize = 0;
    for(; i != m.ms_names.length; i++) {
        if backend_equal(m.ms_names.data[i], name) {
            foreign_number(m, &m.text, i, 10);
            return;
        }
    }
    foreign_text(m, &m.text, name);
    foreign_text(m, &m.text, "@");
    if m.ms_names.length < 10 {
        foreign_require(m, vector_push(&m.ms_names, name));
    }
}

fn foreign_ms_component(m: ForeignName*, type: ForeignType*): void {
    if type.operator_name {
        foreign_text(m, &m.text, foreign_operator_code(m, type.name, true));
        return;
    }
    if !type.template_id {
        foreign_ms_identifier(m, type.name);
        return;
    }
    // A template-id is entered as one name into the outer backreference table.
    var outer: vector(u8*);
    copy(&outer, &m.ms_names, sizeof(vector(u8*)));
    vector_init(&m.ms_names);
    var start = m.text.length;
    foreign_text(m, &m.text, "?$");
    foreign_ms_identifier(m, type.name);
    foreach(var argument in &type.args) {
        if argument.kind == 9 {
            foreign_text(m, &m.text, "$0");
            if argument.ref != 0 {
                foreign_text(m, &m.text, "?");
            }
            foreign_ms_number(m, argument.count);
        } else {
            foreign_ms_type(m, argument, false);
        }
    }
    var count = m.text.length -start;
    var encoded = foreign_copy(m, &m.text.data[start], count);
    m.text.length = start;
    m.text.data[start] = 0;
    vector_dispose(&m.ms_names);
    copy(&m.ms_names, &outer, sizeof(vector(u8*)));
    foreign_ms_identifier(m, encoded);
}

fn foreign_ms_name(m: ForeignName*, type: ForeignType*): void {
    var part = type;
    loop {
        if part == null {
            break;
        }
        foreign_ms_component(m, part);
        part = part.scope;
    }
    foreign_text(m, &m.text, "@");
}

fn foreign_ms_cc(m: ForeignName*, cc: u32, member: bool): void {
    if cc == 0 {
        cc = 1;
        if m.arch == 1 {
            if member {
                cc = 5;
            }
        }
    }
    if m.arch != 1 {
        if cc != 4 {
            cc = 1;
        }
    }
    if cc == 1 {
        foreign_text(m, &m.text, "A");
    }
    if cc == 2 {
        foreign_text(m, &m.text, "G");
    }
    if cc == 3 {
        foreign_text(m, &m.text, "I");
    }
    if cc == 4 {
        foreign_text(m, &m.text, "Q");
    }
    if cc == 5 {
        foreign_text(m, &m.text, "E");
    }
}

fn foreign_ms_parameters(m: ForeignName*, function: ForeignType*): void {
    var saved: vector(u8*);
    copy(&saved, &m.substitutions, sizeof(vector(u8*)));
    vector_init(&m.substitutions);
    defer {
        vector_dispose(&m.substitutions);
        m.substitutions = saved;
    }
    if function.args.length == 0 {
        if !function.variadic {
            foreign_text(m, &m.text, "X");
        }
    }
    foreach(var type in &function.args) {
        var key: vector(u8);
        vector_init(&key);
        defer vector_dispose(&key);
        foreign_key(m, &key, type);
        if foreign_failed(m) { return; }
        var j: usize = 0;
        var found = false;
        for(; j != m.substitutions.length; j++) {
            if backend_equal(key.data, m.substitutions.data[j]) {
                foreign_number(m, &m.text, j, 10);
                found = true;
                break;
            }
        }
        if !found {
            var start = m.text.length;
            foreign_ms_type(m, type, false);
            var length = m.text.length -start;
            if length > 1 {
                if m.substitutions.length < 10 {
                    foreign_require(m, vector_push(&m.substitutions, foreign_copy(m, key.data, key.length)));
                }
            }
        }
    }
    if function.variadic {
        foreign_text(m, &m.text, "Z");
    }
    else {
        if function.args.length != 0 {
            foreign_text(m, &m.text, "@");
        }
    }
}

fn foreign_ms_type(m: ForeignName*, type: ForeignType*, result: bool): void {
    if type.kind == 6 {
        foreign_ms_array(m, type);
        return;
    }
    if type.kind == 8 {
        foreign_ms_member(m, type);
        return;
    }
    if type.kind == 1 {
        var code = foreign_ms_builtin(type);
        if code[0] == 0 {
            foreign_fail(m, "Unsupported Microsoft builtin type");
        }
        foreign_text(m, &m.text, code);
        return;
    }
    if type.kind == 2 {
        if result {
            foreign_text(m, &m.text, "?");
            foreign_ms_cv(m, type.cv);
        }
        if type.tag == 0 {
            foreign_fail(m, "Microsoft named types require struct/class/union/enum metadata");
            return;
        }
        if type.tag == 1 {
            foreign_text(m, &m.text, "U");
        }
        if type.tag == 2 {
            foreign_text(m, &m.text, "V");
        }
        if type.tag == 3 {
            foreign_text(m, &m.text, "T");
        }
        if type.tag == 4 {
            foreign_text(m, &m.text, "W4");
        }
        foreign_ms_name(m, type);
        return;
    }
    if type.kind == 3 {
        var byte = type.cv &3;
        byte = byte + 80;
        var value = convert(u8, byte);
        foreign_text_append(m, &m.text, &value, 1);
    } else {
        if type.kind == 4 {
            foreign_text(m, &m.text, "A");
        }
        else {
            if type.kind == 5 {
                foreign_text(m, &m.text, "$$Q");
            }
            else {
                if type.kind == 7 {
                    foreign_text(m, &m.text, "$$A6");
                    foreign_ms_cc(m, type.convention, false);
                    foreign_ms_type(m, type.base, true);
                    foreign_ms_parameters(m, type);
                    if type.nothrow {
                        foreign_text(m, &m.text, "_E");
                    }
                    else {
                        foreign_text(m, &m.text, "Z");
                    }
                    return;
                } else {
                    foreign_fail(m, "Unsupported Microsoft foreign declarator");
                    return;
                }
            }
        }
    }
    if type.base.kind == 7 {
        foreign_text(m, &m.text, "6");
        foreign_ms_cc(m, type.base.convention, false);
        foreign_ms_type(m, type.base.base, true);
        foreign_ms_parameters(m, type.base);
        if type.base.nothrow {
            foreign_text(m, &m.text, "_E");
        }
        else {
            foreign_text(m, &m.text, "Z");
        }
    } else {
        if m.pointer_bytes == 8 {
            foreign_text(m, &m.text, "E");
        }
        var restricted = type.cv &4;
        if restricted != 0 {
            foreign_text(m, &m.text, "I");
        }
        foreign_ms_cv(m, type.base.cv);
        foreign_ms_type(m, type.base, false);
    }
}

fn foreign_microsoft(m: ForeignName*): void {
    foreign_text(m, &m.text, "?");
    if m.special != 0 {
        if m.special <= 2 {
            foreign_text(m, &m.text, "?0");
        }
        else {
            if m.special == 4 {
                foreign_fail(m, "Microsoft complete destructor requires virtual-base metadata; use dtor(base)");
                return;
            }
            if m.special == 6 {
                foreign_text(m, &m.text, "?_G");
            }
            else {
                foreign_text(m, &m.text, "?1");
            }
        }
        foreign_ms_name(m, m.name.scope);
    } else {
        foreign_ms_name(m, m.name);
    }
    if m.object_symbol {
        if m.profile == foreign_windows_arm64ec {
            foreign_text(m, &m.text, "$$h");
        }
    }
    var instance = m.member == 1;
    if m.member == 3 {
        instance = true;
    }
    if m.member == 0 {
        foreign_text(m, &m.text, "Y");
    }
    else {
        var code = m.access *8;
        code = code + 65;
        if m.member == 2 {
            code = code + 2;
        }
        if m.member == 3 {
            code = code + 4;
        }
        var byte = convert(u8, code);
        foreign_text_append(m, &m.text, &byte, 1);
    }
    if instance {
        if m.pointer_bytes == 8 {
            foreign_text(m, &m.text, "E");
        }
        if m.function.ref == 1 {
            foreign_text(m, &m.text, "G");
        }
        if m.function.ref == 2 {
            foreign_text(m, &m.text, "H");
        }
        foreign_ms_cv(m, m.function.cv);
    }
    foreign_ms_cc(m, m.function.convention, instance);
    if m.special == 6 {
        if m.pointer_bytes == 8 {
            foreign_text(m, &m.text, "PEAXI@Z");
        }
        else {
            foreign_text(m, &m.text, "PAXI@Z");
        }
        return;
    }
    if m.special != 0 {
        foreign_text(m, &m.text, "@");
    }
    else {
        foreign_ms_type(m, m.function.base, true);
    }
    foreign_ms_parameters(m, m.function);
    foreign_text(m, &m.text, "Z");
}
