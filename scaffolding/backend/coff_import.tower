import tower;
import .library.vector;
import .library.bytes_interface;
import .library.bytes_types;
import .library.coff_import_object;

// COFF short-import metadata in a deterministic single-symbol archive. This
// contains no owned machine-code implementation: upstream LLD builds the import
// thunk and Windows supplies the function. The archive makes the import lazy.
// PE/COFF specification: archive linker member and import library header.
var CoffArchiveMagicBytes: usize = 8;
var CoffArchiveHeaderBytes: usize = 60;

fn coff_archive_header(data: u8*, name: u8*, name_size: usize, size: usize): void {
    fill(data, 32, CoffArchiveHeaderBytes);
    copy(data, name, name_size);
    // Fixed-width ASCII date, owner, group and mode. Timestamp zero is stable.
    data[16] = 48;
    data[28] = 48;
    data[34] = 48;
    data[40] = 48;
    var digits: u8[20];
    var count: usize = 0;
    loop {
        var digit = size % 10;
        digit = digit + 48;
        digits[count] = convert(u8, digit);
        count++;
        size = size / 10;
        if size == 0 {
            break;
        }
    }
    for(var i: usize = 48; count != 0; i++) {
        count--;
        data[i] = digits[count];
    }
    data[58] = 96;
    data[59] = 10;
}

fn coff_import_archive(out: vector(u8)*, machine: u32, symbol: u8*, dll: u8*): bool {
    var object: ByteBuffer = default; defer bytes_dispose(&object);
    if !coff_import_object(&object, machine, symbol, dll) { return false; }
    var symbol_size = coff_import_name_size(symbol);
    // Big-endian symbol count and member offset, then the NUL-terminated name.
    var index_header_bytes = CoffWordBytes * 2;
    var linker_size = index_header_bytes + symbol_size;
    var padding = linker_size &1;
    var member = CoffArchiveMagicBytes + CoffArchiveHeaderBytes;
    member = member + linker_size;
    member = member + padding;
    var object_size = object.length;
    var total = member + CoffArchiveHeaderBytes;
    total = total + object_size;
    padding = object_size & 1;
    total = total + padding;
    if !vector_reserve(out, total) {
        return false;
    }
    out.length = total;
    fill(out.data, 0, total);
    copy(out.data, "!<arch>\n", CoffArchiveMagicBytes);
    var header = &out.data[CoffArchiveMagicBytes];
    coff_archive_header(header, "/", 1, linker_size);
    var data = header + CoffArchiveHeaderBytes;
    coff_unsigned(data, 1, CoffWordBytes, true);
    coff_unsigned(&data[CoffWordBytes], convert(u32, member), CoffWordBytes, true);
    copy(&data[index_header_bytes], symbol, symbol_size);
    var odd = linker_size &1;
    var padded = odd != 0;
    if padded {
        data[linker_size] = *"\n";
    }
    header = &out.data[member];
    var member_name = "import.obj/";
    coff_archive_header(header, member_name, coff_import_name_size(member_name) - 1, object_size);
    data = header + CoffArchiveHeaderBytes;
    copy(data, object.data, object.length);
    padded = padding != 0;
    if padded {
        var last = total -1;
        out.data[last] = *"\n";
    }
    return true;
}
