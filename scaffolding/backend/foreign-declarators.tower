        var foreign_condition3009 = backend_equal(m.tokens.data[i], "::") == false;
        if foreign_condition3009 {
            return null;
        }
        i++;
        var foreign_condition3010 = i >= m.tokens.length;
        if foreign_condition3010 {
            return null;
        }
        if backend_equal(m.tokens.data[i], "*") {
            break;
        }
    }
    return foreign_name_parts(m);
}

fn foreign_ms_array(m: ForeignName*, type: ForeignType*): void {
    backend_text(&m.text, "Y");
    var rank: usize = 0;
    var base = type;
    loop {
        var foreign_condition3011 = base.kind != 6;
        if foreign_condition3011 {
