fn foreign_array(m: ForeignName*, base: ForeignType*): ForeignType* {
    var foreign_condition3003 = foreign_take(m, "[") == false;
    if foreign_condition3003 {
        return base;
    }
    var type = foreign_node(m, 6);
    var foreign_condition3004 = foreign_take(m, "]") == false;
    if foreign_condition3004 {
        type.count = foreign_integer(m);
        foreign_expect(m, "]");
    }
    m.depth++;
    var foreign_condition3005 = m.depth > 64;
    if foreign_condition3005 {
        foreign_fail(m, "Foreign declarator nesting exceeds 64");
        type.base = base;
    }
    else {
        type.base = foreign_array(m, base);
    }
    m.depth--;
    return type;
}

fn foreign_member_owner(m: ForeignName*): ForeignType* {
    var i = m.at;
    loop {
        var foreign_condition3006 = i >= m.tokens.length;
        if foreign_condition3006 {
            return null;
        }
        var word = m.tokens.data[i];
        var foreign_condition3007 = foreign_word(word[0]) == false;
        if foreign_condition3007 {
            return null;
        }
        i++;
        var foreign_condition3008 = i >= m.tokens.length;
        if foreign_condition3008 {
            return null;
