        foreign_ms_cv(m, base.cv);
    }
    foreign_ms_type(m, base, false);
}

fn foreign_ms_member(m: ForeignName*, type: ForeignType*): void {
    var cv = type.cv &3;
    cv = cv + 80;
    var byte = convert(u8, cv);
    backend_text_append(&m.text, &byte, 1);
    var foreign_condition3014 = type.base.kind == 7;
