import tower;
import foreign_api;
import foreign_reader;
import text;
import .library.vector;

export fn foreign_profile_for_target(triple: u8*): u32 {
    if backend_prefix(triple, "arm64ec") {
        return foreign_windows_arm64ec();
    }
    if backend_prefix(triple, "wasm") {
        return foreign_wasi();
    }
    var arm = backend_prefix(triple, "aarch64");
    if backend_prefix(triple, "arm64") {
        arm = true;
    }
    var x86 = backend_prefix(triple, "i386");
    if backend_prefix(triple, "i686") {
        x86 = true;
    }
    if backend_contains(triple, "windows") {
        if backend_contains(triple, "gnu") {
            return foreign_mingw_x64();
        }
        if arm {
            return foreign_windows_arm64();
        }
        if x86 {
            return foreign_windows_x86();
        }
        return foreign_windows_x64();
    }
    if backend_contains(triple, "apple") {
        if arm {
            return foreign_macos_arm64();
        }
        return foreign_macos_x64();
    }
    if arm {
        return foreign_linux_arm64();
    }
    if x86 {
        return foreign_linux_x86();
    }
    if backend_prefix(triple, "x86_64") {
        return foreign_linux_x64();
    }
    return 0;
}

// Foundation identifier -> LLVM symbol spelling. Ordinary identifiers pass
// through. __wrap/__real select the upstream linker's symbol-wrap contract.
export fn foreign_symbol(profile: u32, name: u8*): ForeignName* {
    var cpp = backend_prefix(name, "cpp_name(");
    var c = backend_prefix(name, "c_name(");
    var macro = cpp;
    if c {
        macro = true;
    }
    if macro {
        var length = backend_length(name);
        var start: usize = 9;
        if c {
            start = 7;
        }
        if length <= start {
            return foreign_mangle(profile, "", cpp, false);
        }
        var end = length -1;
        var count = end -start;
        var source = alloc(u8, length);
        if source == null {
            return null;
        }
        copy(source, &name[start], count);
        source[count] = 0;
        var prefix: u8* = "";
        var declaration = source;
        if backend_prefix(source, "__wrap;") {
            prefix = "__wrap_";
            declaration = &source[7];
        }
        if backend_prefix(source, "__real;") {
            prefix = "__real_";
            declaration = &source[7];
        }
        var result = foreign_mangle(profile, declaration, cpp, false);
        free(source);
        if result == null {
            return null;
        }
        if name[end] != 41 {
            foreign_fail(result, "Unterminated foreign name expression");
        }
        if prefix[0] != 0 {
            if result.error.length == 0 {
                var text: vector(u8);
                vector_init(u8, &text);
                backend_text(&text, prefix);
                backend_text(&text, foreign_name_text(result));
                vector_dispose(u8, &result.text);
                copy(&result.text, &text, sizeof(vector(u8)));
            }
        }
        return result;
    }
    var result = alloc(ForeignName, 1);
    if result == null {
        return null;
    }
    fill(result, 0, sizeof(ForeignName));
    backend_text(&result.text, name);
    return result;
}

fn foreign_llvm_convention(m: ForeignName*): u32 {
    if m.function == null {
        return 0;
    }
    var cc = m.function.convention;
    if m.function.variadic {
        cc = 1;
    }
    if m.arch == 1 {
        if cc == 2 {
            return 64;
        }
        if cc == 3 {
            return 65;
        }
        if cc == 5 {
            return 70;
        }
        if cc == 0 {
            if m.member == 1 {
                if m.abi == 2 {
                    return 70;
                }
            }
        }
    }
    if cc == 4 {
        if m.arch == 1 {
            return 80;
        }
        if m.arch == 2 {
            return 80;
        }
        foreign_fail(m, "vectorcall requires an x86 ABI profile");
    }
    return 0;
}
