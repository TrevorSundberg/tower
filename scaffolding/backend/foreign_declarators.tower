import tower;
import foreign_microsoft;
import foreign_reader;
import text;

fn foreign_array(m: ForeignName*, base: ForeignType*): ForeignType* {
    if foreign_take(m, "[") == false {
        return base;
    }
    var type = foreign_node(m, 6);
    if foreign_take(m, "]") == false {
        type.count = foreign_integer(m);
        foreign_expect(m, "]");
    }
    m.depth++;
    if m.depth > 64 {
        foreign_fail(m, "Foreign declarator nesting exceeds 64");
        type.base = base;
    }
    else {
        type.base = foreign_array(m, base);
    }
    m.depth--;
    return type;
}

fn foreign_member_owner(m: ForeignName*): ForeignType* {
    var i = m.at;
    loop {
        if i >= m.tokens.length {
            return null;
        }
        var word = m.tokens.data[i];
        if foreign_word(word[0]) == false {
            return null;
        }
        i++;
        if i >= m.tokens.length {
            return null;
        }
        if backend_equal(m.tokens.data[i], "::") == false {
            return null;
        }
        i++;
        if i >= m.tokens.length {
            return null;
        }
        if backend_equal(m.tokens.data[i], "*") {
            break;
        }
    }
    return foreign_name_parts(m);
}

fn foreign_ms_array(m: ForeignName*, type: ForeignType*): void {
    backend_text(&m.text, "Y");
    var rank: usize = 0;
    var base = type;
    loop {
        if base.kind != 6 {
            break;
        }
        rank++;
        base = base.base;
    }
    foreign_ms_number(m, convert(u64, rank));
    var dimension = type;
    loop {
        if dimension.kind != 6 {
            break;
        }
        foreign_ms_number(m, dimension.count);
        dimension = dimension.base;
    }
    if base.cv != 0 {
        backend_text(&m.text, "$$C");
        foreign_ms_cv(m, base.cv);
    }
    foreign_ms_type(m, base, false);
}

fn foreign_ms_member(m: ForeignName*, type: ForeignType*): void {
    var cv = type.cv &3;
    cv = cv + 80;
    var byte = convert(u8, cv);
    backend_text_append(&m.text, &byte, 1);
    if type.base.kind == 7 {
        backend_text(&m.text, "8");
        foreign_ms_name(m, type.scope);
        if m.pointer_bytes == 8 {
            backend_text(&m.text, "E");
        }
        if type.base.ref == 1 {
            backend_text(&m.text, "G");
        }
        if type.base.ref == 2 {
            backend_text(&m.text, "H");
        }
        foreign_ms_cv(m, type.base.cv);
        foreign_ms_cc(m, type.base.convention, true);
        foreign_ms_type(m, type.base.base, true);
        foreign_ms_parameters(m, type.base);
        if type.base.nothrow {
            backend_text(&m.text, "_E");
        }
        else {
            backend_text(&m.text, "Z");
        }
    } else {
        if m.pointer_bytes == 8 {
            backend_text(&m.text, "E");
        }
        cv = type.base.cv & 3;
        cv = cv + 81;
        byte = convert(u8, cv);
        backend_text_append(&m.text, &byte, 1);
        foreign_ms_name(m, type.scope);
        foreign_ms_type(m, type.base, false);
    }
}
