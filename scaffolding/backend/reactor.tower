import tower;
import link_types;
import linker_wasi;
import linker;
import text;

// The byte-only Tower linker is compiled once as its own backend unit.
extern fn backend_link_tower_wasm(link: BackendLink*): bool;

// Host build service for compiler reactors. Inputs and arguments are explicit
// capabilities supplied by the build recipe, never filesystem/tool searches.
// Keep adding Tower modules to that recipe as native adapters are ported; remove
// their prebuilt support objects only after successor/differential checks pass.
export fn backend_reactor_argument(link: BackendLink*, argument: u8*): void {
    backend_link_argument(link, "", argument);
}

export fn backend_reactor_link(link: BackendLink*): bool {
    if link.error.length != 0 { link.output.length = 0; return false; }
    // Explicit recipe opt-in uses the existing transport and input ownership.
    // The default upstream tool remains available for unsupported profiles.
    if link.arguments.length != 0 && backend_equal(link.arguments.data[0], "tower-wasm-ld") {
        return backend_link_tower_wasm(link);
    }
    foreach(var & input in &link.inputs) {
        if !backend_write_file(link, input.name.data, input.bytes.data, input.bytes.length) {
            return false;
        }
    }
    if link.error.length == 0 {
        return backend_link_wasi(link, "wasm32-unknown-unknown");
    }
    return false;
}

export fn backend_reactor_bytes(link: BackendLink*): u8* {
    return link.output.data;
}

export fn backend_reactor_size(link: BackendLink*): usize {
    return link.output.length;
}

export fn backend_reactor_error(link: BackendLink*): u8* {
    return link.error.data;
}
