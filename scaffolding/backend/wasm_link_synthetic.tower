import tower;
import wasm_bytes;
import wasm_names;
import wasm_object_types;
import wasm_link_types;
import wasm_link_prepare;

fn wasm_link_synthetic_kind(link: WasmLink*, name: WasmBytes): WasmSynthetic {
    if wasm_bytes_text(name, "__stack_pointer") { return WasmSynthetic.Stack; }
    if wasm_bytes_text(name, "__heap_base") { return WasmSynthetic.HeapBase; }
    if wasm_bytes_text(name, "__data_end") { return WasmSynthetic.DataEnd; }
    if wasm_bytes_text(name, "__memory_base") { return WasmSynthetic.MemoryBase; }
    if wasm_bytes_text(name, "__table_base") { return WasmSynthetic.TableBase; }
    if wasm_bytes_text(name, "__wasm_call_ctors") { return WasmSynthetic.Constructors; }
    if (link.shared_memory || link.has_tls) && wasm_bytes_text(name, "__wasm_init_memory") { return WasmSynthetic.InitMemory; }
    if wasm_bytes_text(name, "__tls_base") { return WasmSynthetic.TlsBase; }
    if wasm_bytes_text(name, "__tls_size") { return WasmSynthetic.TlsSize; }
    if wasm_bytes_text(name, "__tls_align") { return WasmSynthetic.TlsAlign; }
    if wasm_bytes_text(name, "__wasm_init_tls") { return WasmSynthetic.InitTls; }
    if wasm_bytes_text(name, "__indirect_function_table") { return WasmSynthetic.IndirectTable; }
    if wasm_bytes_text(name, "__dso_handle") { return WasmSynthetic.DsoHandle; }
    if wasm_bytes_text(name, "__stack_low") { return WasmSynthetic.StackLow; }
    if wasm_bytes_text(name, "__stack_high") { return WasmSynthetic.StackHigh; }
    if wasm_bytes_text(name, "__global_base") { return WasmSynthetic.GlobalBase; }
    if wasm_bytes_text(name, "__heap_end") { return WasmSynthetic.HeapEnd; }
    if wasm_bytes_text(name, "__wasm_first_page_end") { return WasmSynthetic.FirstPageEnd; }
    return WasmSynthetic.None;
}

fn wasm_link_synthetic_symbol(link: WasmLink*, name: WasmBytes, required: bool): bool {
    var synthetic = wasm_link_synthetic_kind(link, name);
    if synthetic == WasmSynthetic.None { return true; }
    var index = wasm_names_get(&link.names, name);
    if index == WasmNoIndex {
        if !required { return true; }
        var kind = WasmSymbolKind.Data;
        if synthetic == WasmSynthetic.Stack || synthetic == WasmSynthetic.TlsBase || synthetic == WasmSynthetic.TlsSize || synthetic == WasmSynthetic.TlsAlign { kind = WasmSymbolKind.Global; }
        if synthetic == WasmSynthetic.Constructors || synthetic == WasmSynthetic.InitMemory || synthetic == WasmSynthetic.InitTls { kind = WasmSymbolKind.Function; }
        if synthetic == WasmSynthetic.IndirectTable { kind = WasmSymbolKind.Table; }
        var symbol: WasmResolvedSymbol = { name: name, kind: convert(u8, kind),
            definition: { object: WasmNoIndex, symbol: WasmNoIndex },
            declaration: { object: WasmNoIndex, symbol: WasmNoIndex },
            output_index: WasmNoIndex, got_index: WasmNoIndex, ..default };
        index = convert(u32, link.symbols.length);
        if !wasm_link_push(link, &link.symbols, symbol) || !wasm_names_set(&link.names, name, index) {
            return wasm_link_fail(link, WasmLinkError.Allocation, name);
        }
    }
    var symbol = &link.symbols.data[convert(usize, index)];
    if symbol.defined {
        if (synthetic == WasmSynthetic.InitMemory || synthetic == WasmSynthetic.InitTls || synthetic == WasmSynthetic.TlsBase
            || synthetic == WasmSynthetic.TlsSize || synthetic == WasmSynthetic.TlsAlign) && symbol.synthetic != synthetic { return wasm_link_fail(link, WasmLinkError.Duplicate, name); }
        return true;
    }
    var kind = convert(WasmSymbolKind, symbol.kind);
    var valid = kind == WasmSymbolKind.Data || kind == WasmSymbolKind.Global;
    if synthetic == WasmSynthetic.Constructors || synthetic == WasmSynthetic.InitMemory || synthetic == WasmSynthetic.InitTls { valid = kind == WasmSymbolKind.Function; }
    if synthetic == WasmSynthetic.IndirectTable { valid = kind == WasmSymbolKind.Table; }
    if synthetic == WasmSynthetic.Stack || synthetic == WasmSynthetic.TlsBase || synthetic == WasmSynthetic.TlsSize || synthetic == WasmSynthetic.TlsAlign { valid = kind == WasmSymbolKind.Global; }
    if !valid { return wasm_link_fail(link, WasmLinkError.Signature, name); }
    if kind == WasmSymbolKind.Global && symbol.declaration.object != WasmNoIndex {
        var object = link.world.objects.data[convert(usize, symbol.declaration.object)].object;
        var input = &object.symbols.data[convert(usize, symbol.declaration.symbol)];
        var global = &object.globals.data[convert(usize, input.index)];
        if global.type != convert(u8, WasmValueType.I32) || ((synthetic == WasmSynthetic.Stack || synthetic == WasmSynthetic.TlsBase) && !global.mutable) {
            return wasm_link_fail(link, WasmLinkError.Signature, name);
        }
    }
    if kind == WasmSymbolKind.Function && symbol.declaration.object != WasmNoIndex {
        var object = link.world.objects.data[convert(usize, symbol.declaration.object)].object;
        var input = &object.symbols.data[convert(usize, symbol.declaration.symbol)];
        var type = &object.types.data[convert(usize, object.functions.data[convert(usize, input.index)].type_index)];
        var parameters: u32 = synthetic == WasmSynthetic.InitTls ? 1 : 0;
        if type.parameters != parameters || type.results != 0 { return wasm_link_fail(link, WasmLinkError.Signature, name); }
        if parameters != 0 {
            var reader: WasmReader = { bytes: type.bytes, ..default };
            wasm_read_byte(&reader); wasm_read_index(&reader);
            if wasm_read_byte(&reader) != convert(u8, WasmValueType.I32) { return wasm_link_fail(link, WasmLinkError.Signature, name); }
        }
    }
    symbol.defined = true; symbol.synthetic = synthetic;
    symbol.definition = init(WasmSymbolReference) { object: WasmNoIndex, symbol: WasmNoIndex };
    return true;
}

fn wasm_link_synthetics(link: WasmLink*): bool {
    if link.shared_memory || link.has_tls {
        var name = wasm_text_bytes("__wasm_init_memory");
        if !wasm_link_synthetic_symbol(link, name, true) { return false; }
        link.memory_init_symbol = wasm_names_get(&link.names, name);
    }
    if link.export_table {
        var request: WasmExportRequest = { name: wasm_text_bytes("__indirect_function_table"), required: true };
        if !wasm_link_push(link, &link.exports, request) { return false; }
    }
    // No growth while borrowing existing rows; optional symbols are synthesized
    // only if a declaration, explicit export or runtime stack contract needs it.
    for (var at: usize = 0; at < link.symbols.length; at++) {
        var name = link.symbols.data[at].name;
        if !wasm_link_synthetic_symbol(link, name, false) { return false; }
    }
    foreach (var & request in &link.exports) {
        if !wasm_link_synthetic_symbol(link, request.name, true) { return false; }
    }
    if link.has_tls || wasm_names_get(&link.names, wasm_text_bytes("__wasm_init_tls")) != WasmNoIndex {
        if !wasm_link_synthetic_symbol(link, wasm_text_bytes("__wasm_init_tls"), true)
            || !wasm_link_synthetic_symbol(link, wasm_text_bytes("__tls_base"), true) { return false; }
        link.tls_init_symbol = wasm_names_get(&link.names, wasm_text_bytes("__wasm_init_tls"));
        link.tls_base_symbol = wasm_names_get(&link.names, wasm_text_bytes("__tls_base"));
    }
    return wasm_link_synthetic_symbol(link, wasm_text_bytes("__stack_pointer"), true);
}

fn wasm_link_function_type(link: WasmLink*, index: u32): u32 {
    var symbol = &link.symbols.data[convert(usize, index)];
    var reference = symbol.defined && symbol.definition.object != WasmNoIndex ? symbol.definition : symbol.declaration;
    if reference.object == WasmNoIndex {
        var encoding: u8[4] = default;
        encoding[0] = WasmFunctionType;
        var length: usize = 3;
        var parameters: u32 = 0;
        if symbol.synthetic == WasmSynthetic.InitTls { parameters = 1; length = 4; encoding[1] = 1; encoding[2] = convert(u8, WasmValueType.I32); }
        var type: WasmFunctionTypeRecord = { bytes: { data: &encoding[0], length: length }, parameters: parameters, ..default };
        return wasm_link_type(link, &type);
    }
    var object = link.world.objects.data[convert(usize, reference.object)].object;
    var input = &object.symbols.data[convert(usize, reference.symbol)];
    return link.layouts.data[convert(usize, reference.object)].types.data[convert(usize, object.functions.data[convert(usize, input.index)].type_index)];
}
