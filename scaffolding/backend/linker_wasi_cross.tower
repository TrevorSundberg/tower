import tower;
import link_types;
import linker_wasi;
import text;
import linker_tower_elf;
import linker_tower_pe;
extern fn backend_link_tower_macho(link: BackendLink*, triple: u8*): bool;

// All production download formats use Tower byte services. LLVM supplies code
// generation only; no linker stream, process-global context or filesystem plan.

export fn backend_link_wasi(link: BackendLink*, triple: u8*): bool {
    link.output.length = 0;
    if link.error.length != 0 { return false; }
    if backend_prefix(triple, "wasm") { return backend_link_tower_wasm(link); }
    if backend_contains(triple, "windows") { return backend_link_tower_pe(link, triple); }
    if backend_contains(triple, "apple") { return backend_link_tower_macho(link, triple); }
    return backend_link_tower_elf(link, triple);
}
