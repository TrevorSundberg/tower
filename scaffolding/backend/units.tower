import .library.work_budget_types;
import .library.work_buffer;
import .library.work_buffer_types;

extern fn compiler_node_world(node: void*): void*;
extern fn frontend_world_retire_baselines(world: void*): void;
extern fn frontend_units_work_acquire(frontend: void*): void*;
extern fn frontend_units_work_release(frontend: void*): void;
extern fn frontend_units_program(frontend: void*, ordinal: usize): SemanticProgram*;
extern fn frontend_units_program_recipe(frontend: void*, ordinal: usize): SemanticProgram*;
extern fn frontend_units_pending(frontend: void*): bool;
extern fn frontend_units_step(frontend: void*, wait: bool): bool;
extern fn frontend_units_cancel(frontend: void*): void;
extern fn frontend_units_cancelled(frontend: void*): bool;
extern fn frontend_units_work_budget(frontend: void*): WorkBudget*;
extern fn frontend_units_observe(frontend: void*, phase: CompilerQuery, ordinal: usize, entering: bool): void;
extern fn frontend_units_work_extend(frontend: void*, context: void*,
    next: function(CompilerWorkKernel*, void*), settle: function(void, void*, bool)): bool;
extern fn compiler_work_graph(work: void*): WorkGraph*;
extern fn compiler_work_plan(work: void*): WorkGraph*;
extern fn compiler_work_anchor(work: void*): void*;
extern fn compiler_work_subject(work: void*, ordinal: usize): void*;
extern fn compiler_work_unit_task(work: void*, ordinal: usize): usize;
extern fn entity_create_related(anchor: void*): void*;
extern fn entity_register(kind: void*, size: usize, alignment: usize, lifecycle: usize): bool;
extern fn entity_component_add(node: void*, kind: void*): void*;
extern fn entity_component_get(node: void*, kind: void*): void*;
extern fn entity_component_remove(node: void*, kind: void*): bool;
extern fn entity_component_data(component: void*): void*;
extern fn entity_release(node: void*): usize;
extern fn entity_view_open(anchor: void*): void*;
extern fn entity_view_close(view: void*): void;

// These components extend the frontend's unit entities and dependency graph.
// Each admitted job borrows one immutable Foundation program and exclusively
// owns its LLVM context, module, target machine, diagnostics and object buffer.
struct BackendUnit {
    kernel: CompilerWorkKernel;
    batch: BackendUnits*;
    program: SemanticProgram*;
    backend: Backend*;
    view: void*;
    ordinal: usize;
    task: usize;
    ticket: WorkTicket;
    success: bool;
    library: bool;
    execution: WorkReservation;
    output: WorkReservation;
    resource_error: u8*;
}

struct BackendUnits {
    observation: BackendObservation;
    discard_ir: bool;
    frontend: void*;
    work: void*;
    graph: WorkGraph*;
    kind: void*;
    view: void*;
    pool: WorkPool;
    budget: WorkBudget*;
    own_budget: WorkBudget;
    target: WorkBuffer;
    count: usize;
    join: usize;
    completed: usize;
    failed: usize;
    library: bool;
    optimize: bool;
    started: bool;
    finished: bool;
    cancelled: bool;
    streaming: bool;
    attached: bool;
    retire_baselines: bool;
    input_failed: bool;
    lanes: usize;
    running: usize;
}

fn backend_units_job(batch: BackendUnits*, ordinal: usize): BackendUnit* {
    var subject = compiler_work_subject(batch.work, ordinal);
    if subject == null || batch.kind == null { return null; }
    return bits(BackendUnit*, entity_component_data(entity_component_get(subject, batch.kind)));
}

fn backend_units_release(batch: BackendUnits*, receipt: WorkReservation*): void {
    if receipt.active && work_budget_release_result(batch.budget, receipt) != WorkBudgetError.None {
        trap("Invalid backend unit budget receipt", 0);
    }
}

fn backend_unit_retain_output(job: BackendUnit*): void {
    if job.backend == null || job.output.active { return; }
    // LLVM exposes object length, not its internal arena capacity. Account
    // these retained bytes without claiming total LLVM heap coverage.
    if work_budget_reserve_result(job.batch.budget, 0, 0,
        backend_size(job.backend), &job.output) != WorkBudgetError.None {
        job.success = false;
        job.resource_error = "Unable to reserve retained backend output";
        // The foreign allocator is outside this ledger. Denied retained output
        // must be reclaimed before returning the failed publication receipt.
        backend_close(job.backend);
        job.backend = null;
    }
}

// Cancellation paths first join every job, then return execution grants.
// Object buffers and target text retain their separate byte grants until close.
fn backend_units_release_execution(batch: BackendUnits*): void {
    for(var ordinal: usize = 1; ordinal <= batch.count; ordinal++) {
        var job = backend_units_job(batch, ordinal);
        if job != null { backend_units_release(batch, &job.execution); }
    }
}

fn backend_units_retain_outputs(batch: BackendUnits*): void {
    for(var ordinal: usize = 1; ordinal <= batch.count; ordinal++) {
        var job = backend_units_job(batch, ordinal);
        if job != null { backend_unit_retain_output(job); }
    }
}

fn backend_unit_execute(payload: void*): void {
    var job = bits(BackendUnit*, payload);
    var batch = job.batch;
    frontend_units_observe(batch.frontend, CompilerQuery.Backend, job.ordinal, true);
    defer frontend_units_observe(batch.frontend, CompilerQuery.Backend, job.ordinal, false);
    var observation = batch.observation;
    observation.ordinal = job.ordinal;
    backend_observation_event(&observation, BackendPhase.Setup, true);
    job.backend = backend_open_codegen(batch.target.data, batch.optimize ? BackendCodegen.Default : BackendCodegen.None);
    backend_observation_event(&observation, BackendPhase.Setup, false);
    if job.backend == null { return; }
    job.backend.observation = observation;
    if !backend_retain_ir(job.backend, !batch.discard_ir) {
        job.resource_error = "Cannot configure fresh backend IR retention"; return;
    }
    var program = job.program;
    job.success = backend_lower(job.backend, program.root, program.functions.data,
        program.functions.length, program.pointer_bytes, job.library);
    job.success &&= backend_optimize(job.backend, batch.optimize);
    job.success &&= backend_emit(job.backend);
}

// Platform adapters select this callback using the same WorkPool transport.
// Linking is deliberately absent: its process/temporary-file state is exclusive.
export fn backend_thread_entry(argument: void*): void* {
    var slot = bits(WorkSlot*, argument);
    loop {
        var job = work_pool_wait(slot);
        if job == null { return null; }
        backend_unit_execute(job);
        work_pool_complete(slot);
    }
}

export fn backend_windows_entry(argument: void*): u32 {
    backend_thread_entry(argument);
    return 0;
}

fn backend_units_unpin(batch: BackendUnits*): void {
    for(var ordinal: usize = 1; ordinal <= batch.count; ordinal++) {
        var job = backend_units_job(batch, ordinal);
        if job != null && job.view != null {
            entity_view_close(job.view);
            job.view = null;
        }
    }
    if batch.view != null {
        entity_view_close(batch.view);
        batch.view = null;
    }
}

export fn backend_units_cancel(batch: BackendUnits*): void {
    if batch.finished { return; }
    if batch.attached {
        frontend_units_cancel(batch.frontend);
        return;
    }
    batch.cancelled = true;
    if batch.graph != null { work_cancel(batch.graph); }
    while batch.pool.running != 0 { work_pool_receive(&batch.pool, true); }
    backend_units_retain_outputs(batch);
    backend_units_unpin(batch);
    batch.finished = true;
    backend_units_release_execution(batch);
}

export fn backend_units_close(batch: BackendUnits*): void {
    if batch == null { return; }
    backend_units_cancel(batch);
    work_pool_close(&batch.pool);
    if batch.work != null {
        for(var ordinal: usize = 1; ordinal <= batch.count; ordinal++) {
            var job = backend_units_job(batch, ordinal);
            if job == null { continue; }
            backend_close(job.backend);
            backend_units_release(batch, &job.output);
            if !entity_component_remove(compiler_work_subject(batch.work, ordinal), batch.kind) {
                trap("Cannot release backend unit component", 0);
            }
        }
    }
    if batch.kind != null { entity_release(batch.kind); }
    if batch.frontend != null { frontend_units_work_release(batch.frontend); }
    work_buffer_dispose(&batch.target);
    if !work_budget_dispose(&batch.own_budget) { trap("Backend budget still borrowed", 0); }
    free(batch);
}

// The frontend owner must outlive this lease. Its close entry rejects an active
// backend lease; concurrent mutation or a second backend batch is not admitted.
var BackendLegacyByteLimit: usize = ~convert(usize, 0);

export fn backend_units_create(frontend: void*, count: usize, budget: usize,
target: u8*, library: bool, optimize: bool): BackendUnits* {
    return backend_units_open(frontend, count, budget, BackendLegacyByteLimit, target, library, optimize);
}

// Streaming consumers inherit the existing shared cap unchanged. A later,
// standalone backend phase may supply a separate finite cap for its own target
// and retained object bytes; the frontend's input owner remains separately live.
export fn backend_units_create_bounded(frontend: void*, count: usize, budget: usize,
retained_bytes: usize, target: u8*, library: bool, optimize: bool): BackendUnits* {
    if retained_bytes == 0 || retained_bytes == BackendLegacyByteLimit { return null; }
    if frontend != null && frontend_units_pending(frontend)
        && frontend_units_work_budget(frontend).bytes != retained_bytes { return null; }
    return backend_units_open(frontend, count, budget, retained_bytes, target, library, optimize);
}

fn backend_units_open(frontend: void*, count: usize, budget: usize, retained_bytes: usize,
target: u8*, library: bool, optimize: bool): BackendUnits* {
    if frontend == null || count == 0 || budget == 0 || budget > WorkPoolMaximumCapacity || target == null { return null; }
    var batch = alloc(BackendUnits, 1);
    if batch == null { return null; }
    *batch = default;
    batch.streaming = frontend_units_pending(frontend);
    batch.work = frontend_units_work_acquire(frontend);
    if batch.work == null { free(batch); return null; }
    batch.frontend = frontend;
    if batch.streaming { batch.budget = frontend_units_work_budget(frontend); }
    else {
        var available = work_thread_available() ? work_thread_capacity() : 1;
        if budget > available { budget = available; }
        // LLVM jobs do not reserve nested work; only this coordinator mutates
        // the standalone ledger. A streaming batch borrows the synchronized one.
        if !work_budget_init(&batch.own_budget, budget, retained_bytes, 1) {
            backend_units_close(batch); return null;
        }
        batch.budget = &batch.own_budget;
    }
    batch.library = library;
    batch.optimize = optimize;
    if compiler_work_subject(batch.work, count) == null
        || compiler_work_subject(batch.work, count + 1) != null {
        backend_units_close(batch);
        return null;
    }
    batch.count = count;
    var length: usize = 0;
    while target[length] != 0 { length++; }
    if length == ~convert(usize, 0) || work_buffer_resize(&batch.target, batch.budget,
        length + 1, 0) != WorkBudgetError.None {
        backend_units_close(batch); return null;
    }
    copy(batch.target.data, target, length + 1);
    var lanes = budget < count ? budget : count;
    batch.lanes = lanes;
    if !batch.streaming && !work_pool_open_kernel_budget(&batch.pool, lanes, backend_unit_execute, batch.budget) {
        backend_units_close(batch); return null;
    }
    // Target and pool admission have not added graph work. Keep the graph out
    // of cancellation cleanup until both succeed, so a denied setup can retry.
    batch.graph = batch.streaming ? compiler_work_plan(batch.work) : compiler_work_graph(batch.work);
    if batch.graph == null { backend_units_close(batch); return null; }
    var anchor = compiler_work_anchor(batch.work);
    batch.kind = entity_create_related(anchor);
    if batch.kind == null || !entity_register(batch.kind, sizeof(BackendUnit), alignof(BackendUnit), 0) {
        backend_units_close(batch); return null;
    }
    // A fresh argument distinguishes successive target/profile batches while
    // preserving the frontend's completed queries and their stable subjects.
    var generation = convert(u64, batch.graph.tasks.length);
    batch.join = work_request(batch.graph, anchor, convert(u32, CompilerQuery.BackendJoin), generation);
    for(var ordinal: usize = 1; ordinal <= count; ordinal++) {
        var subject = compiler_work_subject(batch.work, ordinal);
        var job = bits(BackendUnit*, entity_component_data(entity_component_add(subject, batch.kind)));
        if job == null { backend_units_close(batch); return null; }
        *job = default;
        job.kernel.payload = bits(void*, job);
        job.kernel.execute = backend_unit_execute;
        job.kernel.receive = backend_unit_receive;
        job.batch = batch;
        job.ordinal = ordinal;
        job.library = library;
        job.program = batch.streaming ? frontend_units_program_recipe(frontend, ordinal) : frontend_units_program(frontend, ordinal);
        if job.program == null { backend_units_close(batch); return null; }
        job.task = work_request(batch.graph, subject, convert(u32, CompilerQuery.Backend), generation);
        if !work_depend(batch.graph, job.task, compiler_work_unit_task(batch.work, ordinal))
            || !work_depend(batch.graph, batch.join, job.task)
            || !work_access(batch.graph, job.task, CompilerUnitDomain, CompilerProgramComponent,
                ordinal - 1, 1, WorkAccessMode.Read)
            || !work_access(batch.graph, job.task, CompilerUnitDomain, CompilerBackendComponent,
                ordinal - 1, 1, WorkAccessMode.Write)
            || !work_seal(batch.graph, job.task) {
            backend_units_close(batch); return null;
        }
    }
    if !work_access(batch.graph, batch.join, CompilerUnitDomain, CompilerBackendComponent,
        0, count, WorkAccessMode.Read) || !work_seal(batch.graph, batch.join)
        || !work_demand(batch.graph, batch.join) {
        backend_units_close(batch); return null;
    }
    if batch.streaming {
        if !frontend_units_work_extend(frontend, bits(void*, batch), backend_units_next, backend_units_settle) {
            backend_units_close(batch); return null;
        }
        batch.attached = true;
    }
    return batch;
}

// Freeze callbacks and borrowed context before dispatch; keep them alive until
// the final join. Independent unit callbacks may run concurrently.
export fn backend_units_observer(batch: BackendUnits*, context: void*,
    event: function(void, void*, usize, BackendPhase, bool)): bool {
    if batch == null || batch.started || batch.finished { return false; }
    batch.observation.context = context;
    batch.observation.event = event;
    return true;
}

export fn backend_units_retain_ir(batch: BackendUnits*, retain: bool): bool {
    if batch == null || batch.started || batch.finished { return false; }
    batch.discard_ir = !retain;
    return true;
}

// A one-shot executable only needs dependency names, source positions and
// the semantic program for its final symbol walk. Ordinary consumers may
// continue inspecting the world after join and keep their grammar baselines.
export fn backend_units_one_shot(batch: BackendUnits*): bool {
    if batch == null || !batch.streaming || batch.started || batch.finished { return false; }
    batch.retire_baselines = true;
    batch.discard_ir = true;
    return true;
}

// Override before dispatch only: a program entry and independent library units
// share the graph, but only the entry unit supplies the executable entry point.
export fn backend_units_library(batch: BackendUnits*, ordinal: usize, library: bool): bool {
    if batch.started || batch.finished { return false; }
    var job = backend_units_job(batch, ordinal);
    if job == null { return false; }
    job.library = library;
    return true;
}

fn backend_unit_receive(payload: void*): void {
    var job = bits(BackendUnit*, payload);
    var batch = job.batch;
    backend_unit_retain_output(job);
    if !work_finish(batch.graph, &job.ticket, job.success) {
        trap("Stale backend unit receipt", 0);
    }
    if batch.retire_baselines && job.success {
        entity_view_close(job.view);
        job.view = null;
        frontend_world_retire_baselines(compiler_node_world(job.program.root));
    }
    batch.completed++;
    if batch.streaming { batch.running--; }
    if !job.success && (batch.failed == 0 || job.ordinal < batch.failed) {
        batch.failed = job.ordinal;
    }
    backend_units_release(batch, &job.execution);
}

fn backend_units_receive(batch: BackendUnits*, wait: bool): bool {
    var job = work_pool_receive(&batch.pool, wait);
    if job == null { return false; }
    backend_unit_receive(job);
    return true;
}

// The frontend's coordinator invokes this against the same graph whenever a
// shared lane is free. Readiness proves the unit worker has joined; only then
// may we inspect and pin its Foundation world. Other units may still compile.
fn backend_units_next(payload: void*): CompilerWorkKernel* {
    var batch = bits(BackendUnits*, payload);
    if batch.cancelled || batch.running >= batch.lanes { return null; }
    batch.started = true;
    var receipt: WorkReservation = default;
    var admission = work_budget_reserve_result(batch.budget, 1, 1, 0, &receipt);
    if admission == WorkBudgetError.Capacity { return null; }
    if admission != WorkBudgetError.None {
        frontend_units_cancel(batch.frontend);
        return null;
    }
    var ticket: WorkTicket;
    if !work_take_query(batch.graph, &ticket, convert(u32, CompilerQuery.Backend)) {
        backend_units_release(batch, &receipt);
        if work_take_task(batch.graph, &ticket, batch.join)
            && !work_finish(batch.graph, &ticket, true) { trap("Invalid backend join", 0); }
        return null;
    }
    var subject = work_task(batch.graph, ticket.task).subject;
    var job = bits(BackendUnit*, entity_component_data(entity_component_get(subject, batch.kind)));
    job.execution = receipt;
    job.ticket = ticket;
    job.view = entity_view_open(job.program.root);
    if job.view == null {
        batch.cancelled = true;
        // The shared owner must drain other admitted receipts before cancelling
        // their graph. Settle will cancel this unsubmitted ticket as well.
        return null;
    }
    batch.running++;
    return &job.kernel;
}

// Called only after the shared transport has drained. No published artifact
// survives a frontend failure or cancellation, even if its LLVM job completed.
fn backend_units_settle(payload: void*, success: bool): void {
    var batch = bits(BackendUnits*, payload);
    backend_units_retain_outputs(batch);
    batch.input_failed = !success;
    batch.cancelled ||= frontend_units_cancelled(batch.frontend);
    batch.cancelled ||= success && batch.completed != batch.count;
    if batch.cancelled { work_cancel(batch.graph); }
    if !success && !batch.cancelled {
        for(var ordinal: usize = 1; ordinal <= batch.count; ordinal++) {
            var task = backend_units_job(batch, ordinal).task;
            var state = work_task(batch.graph, task).state;
            if (state == WorkState.Ready || state == WorkState.Waiting) && !work_fail(batch.graph, task) {
                batch.cancelled = true;
                work_cancel(batch.graph);
                break;
            }
        }
    }
    backend_units_unpin(batch);
    batch.finished = true;
    backend_units_release_execution(batch);
}

export fn backend_units_step(batch: BackendUnits*, wait: bool): bool {
    if batch.finished { return true; }
    if batch.streaming { return frontend_units_step(batch.frontend, wait); }
    if !batch.started {
        batch.view = entity_view_open(compiler_work_anchor(batch.work));
        if batch.view == null { backend_units_cancel(batch); return true; }
        for(var ordinal: usize = 1; ordinal <= batch.count; ordinal++) {
            var job = backend_units_job(batch, ordinal);
            job.view = entity_view_open(job.program.root);
            if job.view == null { backend_units_cancel(batch); return true; }
        }
        batch.started = true;
    }
    loop {
        while batch.failed == 0 && batch.pool.running < batch.pool.count {
            var receipt: WorkReservation = default;
            var admission = work_budget_reserve_result(batch.budget, 1, 1, 0, &receipt);
            if admission == WorkBudgetError.Capacity { break; }
            if admission != WorkBudgetError.None { backend_units_cancel(batch); return true; }
            var ticket: WorkTicket;
            if !work_take(batch.graph, &ticket) { backend_units_release(batch, &receipt); break; }
            if ticket.task == batch.join {
                backend_units_release(batch, &receipt);
                if !work_finish(batch.graph, &ticket, true) { trap("Invalid backend join", 0); }
                break;
            }
            var ordinal = work_task(batch.graph, ticket.task).subject;
            var job = bits(BackendUnit*, entity_component_data(entity_component_get(ordinal, batch.kind)));
            job.execution = receipt;
            job.ticket = ticket;
            if !work_pool_admit(&batch.pool, bits(void*, job)) {
                backend_units_cancel(batch); return true;
            }
            if !batch.pool.threaded { backend_unit_execute(bits(void*, job)); }
        }
        if batch.pool.running == 0 {
            if batch.failed != 0 || batch.completed == batch.count {
                // A failed earlier unit stops admission. Settle every unused
                // query before removing its component, so a later target batch
                // cannot admit an old recipe through this shared ready queue.
                if batch.failed != 0 {
                    for(var ordinal: usize = 1; ordinal <= batch.count; ordinal++) {
                        var task = backend_units_job(batch, ordinal).task;
                        var state = work_task(batch.graph, task).state;
                        if state == WorkState.Ready || state == WorkState.Waiting {
                            if !work_fail(batch.graph, task) { backend_units_cancel(batch); return true; }
                        }
                    }
                }
                backend_units_unpin(batch);
                batch.finished = true;
                return true;
            }
            // Backend tasks depend only on completed frontend work. A stalled
            // frontier here is invalid scheduling state, not an implicit wait.
            backend_units_cancel(batch);
            return true;
        }
        if !backend_units_receive(batch, wait) { return false; }
        // Immediately refill after each receipt; blocking callers may keep
        // draining, while polling callers inspect available completions only.
    }
}

export fn backend_units_failed(batch: BackendUnits*): usize { return batch.failed; }
export fn backend_units_cancelled(batch: BackendUnits*): bool { return batch.cancelled; }

export fn backend_units_result(batch: BackendUnits*, ordinal: usize): Backend* {
    if !batch.finished || batch.cancelled || batch.input_failed || batch.failed != 0 { return null; }
    var job = backend_units_job(batch, ordinal);
    return job == null ? null : job.backend;
}

export fn backend_units_error(batch: BackendUnits*): u8* {
    if !batch.finished || batch.cancelled || batch.failed == 0 { return ""; }
    var job = backend_units_job(batch, batch.failed);
    if job.resource_error != null { return job.resource_error; }
    var backend = job.backend;
    return backend == null ? "Unable to allocate backend storage" : backend_error(backend);
}

export fn backend_units_error_offset(batch: BackendUnits*): usize {
    if !batch.finished || batch.cancelled || batch.failed == 0 { return 0; }
    var backend = backend_units_job(batch, batch.failed).backend;
    return backend == null ? 0 : backend_error_offset(backend);
}
