import inheritance;
import grammar;
import backend.text;
import library.testing;

test() {
    var bedrock = grammar_file("bedrock.tower");
    defer free(bedrock);
    check_public_names(bedrock);
    var foundation = grammar_file("foundation.tower");
    defer free(foundation);
    require_parse(foundation, GrammarEntry.Foundation);
    require_parse(bedrock, GrammarEntry.Bedrock);

    var declarations = grammar_event_count(GrammarEntry.Foundation);
    for (var i: usize = 0; i < declarations; i++) { check_foundation_declaration(i); }
    var tokens = bedrock_token_count();
    for (var i: usize = 0; i < tokens; i++) {
        var name = bedrock_token_name(i);
        defer free(name);
        var found = grammar_symbol_index(GrammarEntry.Foundation, "tokens", name);
        assert(found >= 0, name);
        var defined = grammar_token_record(GrammarEntry.Bedrock, i);
        defer free(defined);
        var inherited = grammar_token_record(GrammarEntry.Foundation, convert(usize, found));
        defer free(inherited);
        assert(backend_equal(defined, inherited), name);
    }
    assert(grammar_symbol_index(GrammarEntry.Foundation, "rules", "GrammarAssignment") >= 0);
}
