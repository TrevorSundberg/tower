import tower;
import .library.entities;
import .library.entity_types;
import .library.entity_stage;
import .host.memory;
import .host.work_portable;

fn check(ok: bool): i32 { return ok ? 0 : 1; }
export fn tower_entity_finalize(lifecycle: usize, component: EntityComponent*, data: u8*): void {
    trap("Lease fixture owns no component lifecycles", 0);
}
export fn main(argc: i32, argv: u8**): i32 {
    var failures: i32 = 0;
    var store = entity_store_create();
    var root = entity_create(store);
    var old = entity_create(store);
    var next = entity_create(store);
    var child = entity_create(store);
    failures += check(entity_attach(old, root, "old") && entity_attach(next, root, "next")
        && entity_attach(child, old, "child"));
    var stage = entity_stage_open(root);
    failures += check(entity_stage_lease(stage, old));
    failures += check(!entity_attach(child, next, "child"));
    failures += check(child.parent == old && old.child_count == 1 && next.child_count == 0);
    entity_stage_discard(stage);
    // Restore only the forbidden mutation when observing the old implementation.
    if child.parent != old { failures += check(entity_attach(child, old, "child")); }
    stage = entity_stage_open(root);
    failures += check(entity_stage_lease(stage, child));
    var replacement = entity_create(store);
    failures += check(!entity_attach(replacement, old, "child"));
    failures += check(child.parent == old && child.references == 2 && replacement.parent == null
        && replacement.references == 1 && old.child_count == 1);
    entity_stage_discard(stage);
    // The old code unlinks a leased child but its guarded release does nothing.
    if child.parent == null { entity_release(child); }
    entity_release(replacement);
    entity_release(child);
    entity_release(next);
    entity_release(old);
    entity_release(root);
    failures += check(entity_store_dispose(store));
    print(failures);
    return failures == 0 ? 0 : 1;
}
