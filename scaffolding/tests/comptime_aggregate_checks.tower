import tower;
import comptime_aggregate_checks_test;
import execution_support;

fn aggregate_capture_tests(modules: void*, root: u8*): void {
    aggregate_capture_values(modules, root);
    puts("Aggregate captures: nested values, private copies, Foundation and workers pass.");
}

fn comptime_aggregate_tests(modules: void*, root: u8*): void {
    staged_aggregate_values(modules, root);
    aggregate_reject_uninitialized(modules, root);
    aggregate_reject_raw_pointer(modules, root);
    aggregate_reject_output(modules, root);
    aggregate_reject_dependency_cycle(modules, root);
    aggregate_reject_forged_callback(modules, root);
    puts("Staged aggregates: nested fields, arrays, exact bits, typed callbacks, Foundation and workers pass.");
}
