import tower;

extern fn strcmp(left: u8*, right: u8*): i32;
extern fn puts(text: u8*): i32;

enum AggregateAdmissionMode: u32 { Healthy, Failed, Cancelled, Lowering }

fn aggregate_admission_select(argc: i32, argv: u8**, mode: AggregateAdmissionMode*): bool {
    *mode = AggregateAdmissionMode.Healthy;
    if argc <= 1 || strcmp(argv[1], "healthy") == 0 { return true; }
    if strcmp(argv[1], "failed") == 0 { *mode = AggregateAdmissionMode.Failed; return true; }
    if strcmp(argv[1], "cancelled") == 0 { *mode = AggregateAdmissionMode.Cancelled; return true; }
    if strcmp(argv[1], "lowering") == 0 { *mode = AggregateAdmissionMode.Lowering; return true; }
    puts("Unknown aggregate admission selector");
    return false;
}
