import tower;
import .library.compiler_work;
import .library.entities;
import .library.work_graph;

export fn tower_entity_finalize(lifecycle: usize, component: EntityComponent*, data: u8*): void {
    trap("Unexpected unit lifecycle", 0);
}

var failures: u32 = 0;

fn check(ok: bool): void {
    if !ok {
        failures++;
    }
}

fn compiler_work_tests(): void {
    var work = compiler_work_create(4, 2, 42, 17);
    var valid = work != null;
    check(valid);
    if !valid {
        return;
    }
    check(compiler_work_subject(work, 0) is null && compiler_work_subject(work, 5) is null);
    check(entity_child_count(bits(Entity*, work.owner)) == 4);
    for(var i: usize = 1; i <= 4; i++) {
        var subject = compiler_work_subject(work, i);
        var unit = compiler_work_unit(work, i);
        check(subject is not null && unit.ordinal == i);
        check(work_task(&work.graph, unit.task).subject == bits(void*, subject));
        check(entity_context(bits(Entity*, subject)) is null);
    }
    var a = compiler_work_next(work);
    var b = compiler_work_next(work);
    var equal = a == 1;
    check(equal);
    equal = b == 2;
    check(equal);
    equal = compiler_work_next(work) == 0;
    check(equal);
    equal = compiler_work_accept(work, b, 43, 17, true) == false;
    check(equal);
    equal = compiler_work_accept(work, b, 42, 18, true) == false;
    check(equal);
    check(compiler_work_accept(work, b, 42, 17, true));
    equal = compiler_work_accept(work, b, 42, 17, true) == false;
    check(equal);
    var c = compiler_work_next(work);
    equal = c == 3;
    check(equal);
    check(compiler_work_accept(work, c, 42, 17, true));
    var d = compiler_work_next(work);
    equal = d == 4;
    check(equal);
    check(compiler_work_accept(work, d, 42, 17, false));
    equal = compiler_work_done(work) == false;
    check(equal);
    check(compiler_work_accept(work, a, 42, 17, false));
    check(compiler_work_done(work));
    equal = compiler_work_failed(work) == 1;
    check(equal);
    equal = compiler_work_peak(work) == 2;
    check(equal);
    compiler_work_close(work);
    work = compiler_work_create(1, 1, 43, 17);
    a = compiler_work_next(work);
    compiler_work_cancel(work);
    equal = compiler_work_accept(work, a, 43, 17, true) == false;
    check(equal);
    equal = compiler_work_done(work) == false;
    check(equal);
    compiler_work_close(work);
    work = compiler_work_create(1, 1, 44, 17);
    a = compiler_work_next(work);
    check(compiler_work_accept(work, a, 44, 17, true));
    check(compiler_work_done(work));
    equal = compiler_work_next(work) == 0;
    check(equal);
    equal = compiler_work_failed(work) == 0;
    check(equal);
    compiler_work_close(work);
    work = compiler_work_create(4, 2, 45, 17);
    a = compiler_work_next(work);
    b = compiler_work_next(work);
    check(compiler_work_accept(work, b, 45, 17, false));
    equal = compiler_work_next(work) == 0;
    check(equal);
    equal = compiler_work_done(work) == false;
    check(equal);
    check(compiler_work_accept(work, a, 45, 17, true));
    check(compiler_work_done(work));
    equal = compiler_work_failed(work) == 2;
    check(equal);
    equal = compiler_work_accept(work, 3, 45, 17, true) == false;
    check(equal);
    compiler_work_close(work);
    work = compiler_work_create(4, 2, 46, 17);
    a = compiler_work_next(work);
    b = compiler_work_next(work);
    check(compiler_work_accept(work, a, 46, 17, false));
    // Unit two is still running, but can no longer change the diagnostic.
    check(compiler_work_done(work));
    equal = compiler_work_failed(work) == 1;
    check(equal);
    compiler_work_cancel(work);
    equal = compiler_work_accept(work, b, 46, 17, true) == false;
    check(equal);
    compiler_work_close(work);
}

compiler_work_tests();
print(failures);
