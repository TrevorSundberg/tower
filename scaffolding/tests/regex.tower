import tower;
import regex_oracle;
import mt19937;
import utility_checks;
import .library.vector;
import .compiler.syntax_types;
import .compiler.parser_types;
import .compiler.format_types;
import .compiler.component_kinds;

extern fn compiler_world_create(): void*;
extern fn compiler_world_dispose(world: void*): bool;
extern fn compiler_world_type(world: void*, kind: u32): void*;
extern fn compiler_world_store(world: void*): void*;
extern fn entity_store_count(store: void*): usize;
extern fn frontend_world_clear(world: void*): bool;
extern fn frontend_world_pattern(world: void*, source: u8*, length: usize, error: FormatResult*): SyntaxPattern*;
extern fn syntax_pattern_release(pattern: SyntaxPattern*): void;
extern fn format_dispose(result: FormatResult*): void;
extern fn format_parser_tree(result: FormatResult*, root: void*, kind: void*): void;
extern fn regex_compile_tree(root: void*, source: u8*, kind: void*, table: LexerTable*, offset: usize*): u8*;
extern fn entity_component_get(node: void*, kind: void*): void*;
extern fn entity_component_data(component: void*): void*;
extern fn entity_view_open(node: void*): void*;
extern fn entity_view_close(view: void*): void;
extern fn lex_table_match(table: LexerTable*, source: u8*, length: usize, start: usize): usize;
extern fn tower_test_buffer_count(): usize;
extern fn tower_test_buffer_fail_after(count: usize): void;
extern fn strlen(text: u8*): usize;
extern fn strstr(text: u8*, part: u8*): u8*;

fn regex_test_append(output: vector(u8)*, source: u8*, length: usize): void {
    utility_check(vector_reserve(u8, output, output.length + length), "Regex test text allocation");
    if length != 0 { copy(&output.data[output.length], source, length); }
    output.length += length;
}

fn regex_test_text(output: vector(u8)*, source: u8*): void {
    regex_test_append(output, source, strlen(source));
}

fn regex_test_pattern(random: TestRandom*, depth: u32, output: vector(u8)*): void {
    if depth == 0 {
        var atoms: u8*[9];
        atoms[0] = "a"; atoms[1] = "b"; atoms[2] = ".";
        atoms[3] = "[a-c]"; atoms[4] = "[^b]"; atoms[5] = "\\x61";
        atoms[6] = "\\u{e9}"; atoms[7] = "[a\\-c]"; atoms[8] = "[\\]\\\\]";
        regex_test_text(output, atoms[test_random(random) % 9]);
        return;
    }
    var choice = test_random(random) % 5;
    if choice == 0 {
        regex_test_pattern(random, depth - 1, output);
        regex_test_pattern(random, depth - 1, output);
        return;
    }
    regex_test_text(output, "(");
    regex_test_pattern(random, depth - 1, output);
    if choice == 1 {
        regex_test_text(output, "|");
        regex_test_pattern(random, depth - 1, output);
    }
    regex_test_text(output, ")");
    if choice == 2 { regex_test_text(output, "*"); }
    if choice == 3 { regex_test_text(output, "+"); }
    if choice == 4 { regex_test_text(output, "?"); }
}

fn regex_test_inputs(actual: LexerTable*, reference: LexerTable*, random: TestRandom*): void {
    var fragments: u8*[10];
    var lengths: usize[10];
    var scalars: u8[8];
    scalars[0] = 195; scalars[1] = 169;
    scalars[2] = 240; scalars[3] = 159; scalars[4] = 143; scalars[5] = 176;
    scalars[6] = 255; scalars[7] = 0;
    fragments[0] = "a"; fragments[1] = "b"; fragments[2] = "c";
    fragments[3] = "]"; fragments[4] = "\\"; fragments[5] = "\n";
    fragments[6] = &scalars[0]; fragments[7] = &scalars[2];
    fragments[8] = &scalars[6]; fragments[9] = &scalars[7];
    for (var index: usize = 0; index < 10; ++index) { lengths[index] = 1; }
    lengths[6] = 2; lengths[7] = 4;
    var input: vector(u8);
    vector_init(u8, &input);
    defer vector_dispose(u8, &input);
    for (var sample: usize = 0; sample < 60; ++sample) {
        input.length = 0;
        for (var index: usize = 0; index < sample % 20; ++index) {
            var fragment = test_random(random) % 10;
            regex_test_append(&input, fragments[fragment], lengths[fragment]);
        }
        for (var offset: usize = 0; offset <= input.length; ++offset) {
            var left = lex_table_match(actual, input.data, input.length, offset);
            var right = lex_table_match(reference, input.data, input.length, offset);
            utility_check(left == right, "Regex reference longest-prefix and UTF-8 offset agreement");
        }
    }
}

fn regex_test_compare(world: void*, source: u8*, length: usize, random: TestRandom*): void {
    var error: FormatResult;
    fill(&error, 0, sizeof(FormatResult));
    defer format_dispose(&error);
    var actual = frontend_world_pattern(world, source, length, &error);
    defer syntax_pattern_release(actual);
    var reference_error: u8* = null;
    var reference = oracle_regex_compile(source, length, &reference_error);
    defer lex_table_destroy(reference);
    if (actual is null) != (reference is null) {
        var dump: vector(u8);
        vector_init(u8, &dump);
        defer vector_dispose(u8, &dump);
        regex_test_append(&dump, source, length);
        utility_check(vector_push(u8, &dump, 0), "Regex diagnostic terminator");
        puts("Regex acceptance disagreement:");
        puts(dump.data);
        utility_check(vector_push(u8, &error.text, 0), "Regex production diagnostic terminator");
        puts(error.text.data);
        puts(reference_error ?? "reference accepted");
        abort();
    }
    if actual is null {
        utility_check(error.text.length != 0 && reference_error is not null, "Both regex rejections include diagnostics");
        return;
    }
    utility_check(actual.grammar is not null && error.text.length == 0 && reference_error is null, "Regex success retains grammar and no error");
    var kind = compiler_world_type(world, CompilerParserMatch);
    var root = bits(ParserMatchData*, entity_component_data(entity_component_get(actual.grammar, kind)));
    utility_check(root is not null && root.start == 0 && root.length == length, "Regex shared-entity source span");
    regex_test_inputs(actual.table, reference, random);
}

fn regex_test_scratch_failures(world: void*): void {
    var source = "(a|bc)+[d-f]?\\u{e9}";
    var error: FormatResult;
    fill(&error, 0, sizeof(FormatResult));
    defer format_dispose(&error);
    var parsed = frontend_world_pattern(world, source, strlen(source), &error);
    utility_check(parsed is not null, "Regex allocation fixture parses");
    defer syntax_pattern_release(parsed);
    var kind = compiler_world_type(world, CompilerParserMatch);
    var before: FormatResult;
    fill(&before, 0, sizeof(FormatResult));
    defer format_dispose(&before);
    format_parser_tree(&before, parsed.grammar, kind);
    utility_check(!before.failed, "Regex initial tree formatting");
    var view = entity_view_open(parsed.grammar);
    utility_check(view is not null, "Regex lowering pins its shared input graph");
    defer entity_view_close(view);
    var baseline = tower_test_buffer_count();
    var success = false;
    for (var failure: usize = 0; failure < 256 && !success; ++failure) {
        var table = lex_table_create();
        utility_check(table is not null, "Regex scratch table allocation");
        var offset: usize = 0;
        tower_test_buffer_fail_after(failure);
        var message = regex_compile_tree(parsed.grammar, source, kind, table, &offset);
        tower_test_buffer_fail_after(~convert(usize, 0));
        utility_check(message is null || strstr(message, "allocate") is not null, "Regex scratch failure diagnostic");
        success = message is null;
        lex_table_destroy(table);
        utility_check(tower_test_buffer_count() == baseline, "Regex scratch failure releases all temporary buffers");
    }
    utility_check(success, "Regex scratch allocation sweep reaches success");
    var after: FormatResult;
    fill(&after, 0, sizeof(FormatResult));
    defer format_dispose(&after);
    format_parser_tree(&after, parsed.grammar, kind);
    utility_check(!after.failed && before.text.length == after.text.length
        && utility_equal(before.text.data, after.text.data, before.text.length), "Regex failure sweep leaves shared parse entities unchanged");
}

fn regex_test_case(world: void*, source: u8*, input: u8*, wanted: usize): void {
    var error: FormatResult;
    fill(&error, 0, sizeof(FormatResult));
    defer format_dispose(&error);
    var actual = frontend_world_pattern(world, source, strlen(source), &error);
    defer syntax_pattern_release(actual);
    var diagnostic: u8* = null;
    var reference = oracle_regex_compile(source, strlen(source), &diagnostic);
    defer lex_table_destroy(reference);
    utility_check(actual is not null && reference is not null, "Fixed regex compiles");
    utility_check(lex_table_match(actual.table, input, strlen(input), 0) == wanted, "Fixed regex production longest prefix");
    utility_check(lex_table_match(reference, input, strlen(input), 0) == wanted, "Fixed regex independent longest prefix");
}

fn regex_test_reject(world: void*, source: vector(u8)*): void {
    var error: FormatResult;
    fill(&error, 0, sizeof(FormatResult));
    defer format_dispose(&error);
    var actual = frontend_world_pattern(world, source.data, source.length, &error);
    defer syntax_pattern_release(actual);
    var diagnostic: u8* = null;
    var reference = oracle_regex_compile(source.data, source.length, &diagnostic);
    defer lex_table_destroy(reference);
    utility_check(actual is null && error.text.length != 0, "Production rejects regex complexity limit");
    utility_check(reference is null && diagnostic is not null, "Reference rejects regex complexity limit");
}

fn regex_test_limits(world: void*): void {
    var source: vector(u8);
    vector_init(u8, &source);
    defer vector_dispose(u8, &source);
    utility_check(vector_reserve(u8, &source, OracleRegexBytes + 1), "Regex source limit allocation");
    fill(source.data, 97, OracleRegexBytes + 1);
    source.length = OracleRegexBytes + 1;
    regex_test_reject(world, &source);
    // The mandatory accepting state also counts against the NFA limit.
    source.length = OracleRegexStates;
    regex_test_reject(world, &source);
    source.length = 0;
    for (var index: usize = 0; index <= OracleRegexDepth; ++index) { regex_test_text(&source, "("); }
    regex_test_text(&source, "a");
    for (var index: usize = 0; index <= OracleRegexDepth; ++index) { regex_test_text(&source, ")"); }
    regex_test_reject(world, &source);
    source.length = 0;
    regex_test_text(&source, "(a|b)*a");
    // Remembering eleven suffix positions exceeds the 1,024-subset budget.
    for (var index: usize = 0; index < 11; ++index) { regex_test_text(&source, "(a|b)"); }
    regex_test_reject(world, &source);
}

export fn regex_tests(): void {
    test_random_check();
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    utility_check(world is not null, "Regex world allocation");
    regex_test_scratch_failures(world);
    regex_test_case(world, "a|ab", "ab!", 2);
    regex_test_case(world, "a(b?)*", "abbb!", 4);
    regex_test_case(world, "[a-c]+", "abc!", 3);
    regex_test_case(world, "[^b]+", "aacb", 3);
    regex_test_case(world, "a.b", "a\nb", 0);
    regex_test_case(world, "[a\\-c]+", "a-c!", 3);
    regex_test_limits(world);
    var nodes = entity_store_count(compiler_world_store(world));
    var buffers = tower_test_buffer_count();
    var random: TestRandom;
    test_random_init(&random, 1380271960);
    {
        var source: vector(u8);
        vector_init(u8, &source);
        defer vector_dispose(u8, &source);
        for (var trial: usize = 0; trial < 300; ++trial) {
            source.length = 0;
            regex_test_pattern(&random, 3, &source);
            regex_test_compare(world, source.data, source.length, &random);
        }
        var cases: u8*[19];
        cases[0] = "()a"; cases[1] = "a()"; cases[2] = "a(b?)*"; cases[3] = "(a|)b";
        cases[4] = "[^^]"; cases[5] = "[a-b-c]"; cases[6] = "[a\\-z]"; cases[7] = "[a-]";
        cases[8] = "[]"; cases[9] = "[^]"; cases[10] = "a**"; cases[11] = "\\x0";
        cases[12] = "\\u{}"; cases[13] = "\\u{0000000}"; cases[14] = "\\u{d800}";
        cases[15] = "[z-a]"; cases[16] = "[a--b]"; cases[17] = "]"; cases[18] = "a|ab";
        for (var index: usize = 0; index < 19; ++index) { regex_test_compare(world, cases[index], strlen(cases[index]), &random); }
        var characters = "abc[]()|*+?\\nrtxu{}012-F^.$";
        var count = strlen(characters);
        for (var trial: usize = 0; trial < 500; ++trial) {
            source.length = 0;
            for (var index: usize = 0; index < trial % 13; ++index) {
                var at = convert(usize, test_random(&random)) % count;
                utility_check(vector_push(u8, &source, characters[at]), "Regex arbitrary source byte");
            }
            regex_test_compare(world, source.data, source.length, &random);
        }
        var nul: u8[3];
        nul[0] = 97; nul[1] = 0; nul[2] = 98;
        regex_test_compare(world, &nul[0], 3, &random);
        nul[1] = 255;
        regex_test_compare(world, &nul[0], 2, &random);
    }
    utility_check(entity_store_count(compiler_world_store(world)) == nodes, "Regex repeated compile releases shared trees");
    utility_check(tower_test_buffer_count() == buffers, "Regex repeated compile releases scratch buffers");
    utility_check(frontend_world_clear(world), "Regex reader cache release");
    utility_check(compiler_world_dispose(world), "Regex explicit world disposal");
    utility_check(tower_test_buffer_count() == baseline, "Regex world releases all owned buffers");
    puts("Tower regex: 300 generated patterns, 500 arbitrary byte patterns, edge cases and allocation failures passed.");
}
