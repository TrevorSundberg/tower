import tower;
import .host.memory;
import .library.work_pool;

extern fn __errno_location(): i32*;

// GNU --wrap redirects the separately compiled Linux transport's three calls.
// Only these serial probes borrow the state. Other users of the real allocator
// and the concurrent affinity fixture keep their ordinary transport.
enum AffinityMockMode: u32 { Mask, Error, ResizeError }
struct AffinityFaultState {
    mode: AffinityMockMode;
    mask: usize[33];
    calls: usize;
    fail_at: usize;
    live: void*;
    live_bytes: usize;
    peak_bytes: usize;
    queries: usize;
}
var AffinityFault: AffinityFaultState* = null;
var AffinityMockSizeError: i32 = 22;
var AffinityMockAddressError: i32 = 14;
