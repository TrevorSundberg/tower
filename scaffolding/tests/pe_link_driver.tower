import tower;
import utility_checks;
import pe_link_checks;
import .backend.pe_types;
import .backend.pe_link;
import .backend.pe_link_world;
import .backend.wasm_bytes;
import .backend.coff_import;
import .library.bytes;
import .library.bytes_types;
import .library.vector;
import .library.entities;
import .library.entity_types;
import .host.work_linux;
import .host.work_dispatch;

extern fn fopen(path: u8*, mode: u8*): void*;
extern fn fclose(file: void*): i32;
extern fn fseek(file: void*, offset: i64, mode: i32): i32;
extern fn ftell(file: void*): i64;
extern fn fread(data: u8*, size: usize, count: usize, file: void*): usize;
extern fn fwrite(data: u8*, size: usize, count: usize, file: void*): usize;
export fn tower_entity_finalize(lifecycle: usize, component: EntityComponent*, data: u8*): void { abort(); }
export fn work_kernel_execute(job: void*): void { abort(); }

fn pe_test_file(path: u8*, data: ByteBuffer*): bool {
    var file = fopen(path, "rb"); if file == null { return false; }
    defer fclose(file);
    var file_end: i32 = 2;
    if fseek(file, 0, file_end) != 0 { return false; }
    var length = ftell(file);
    if length < 0 || convert(u64, length) > convert(u64, ~convert(usize, 0)) || fseek(file, 0, 0) != 0 { return false; }
    if !bytes_reserve(data, convert(usize, length)) { return false; }
    data.length = convert(usize, length); return fread(data.data, 1, data.length, file) == data.length;
}
export fn main(argc: i32, argv: u8**): i32 {
    // Emit precisely the same lazy OS import used by the byte service so the
    // external reference linker receives identical inputs in differential runs.
    if argc == 3 && wasm_bytes_text(wasm_text_bytes(argv[2]), "--probe-import") {
        var archive: vector(u8) = default; defer vector_dispose(&archive);
        utility_check(coff_import_archive(&archive, convert(u32, PeMachineX64), "__chkstk", "kernelbase.dll"), "reference probe import");
        var file = fopen(argv[1], "wb"); utility_check(file != null, "probe import output");
        var written = fwrite(archive.data, 1, archive.length, file);
        utility_check(fclose(file) == 0 && written == archive.length, "probe import write"); return 0;
    }
    var first_input: i32 = 3;
    if argc <= first_input { puts("usage: pe_link_driver output workers object-or-archive ..."); return 1; }
    var checks = wasm_bytes_text(wasm_text_bytes(argv[first_input]), "--checks"); if checks { first_input++; }
    var inputs: vector(ByteBuffer) = default;
    defer { foreach (var & buffer in &inputs) { bytes_dispose(buffer); } vector_dispose(&inputs); }
    var probe: vector(u8) = default; defer vector_dispose(&probe);
    utility_check(coff_import_archive(&probe, convert(u32, PeMachineX64), "__chkstk", "kernelbase.dll"), "stack probe archive");
    var link: PeLink = default; defer pe_link_close(&link);
    utility_check(pe_link_open(&link), "PE world"); link.workers = convert(usize, *argv[2] - *"0");
    for (var at = first_input; at < argc; at++) {
        var buffer: ByteBuffer = default;
        utility_check(pe_test_file(argv[at], &buffer), "PE input read"); utility_check(vector_push(&inputs, buffer), "PE input ownership");
    }
    if checks {
        var library_index: usize = 2; utility_check(inputs.length > library_index, "PE library input");
        var archive: ByteBuffer = default; pe_check_archive(&inputs.data[library_index], &archive);
        bytes_dispose(&inputs.data[library_index]); inputs.data[library_index] = archive;
    }
    for (var at: usize = 0; at < inputs.length; at++) {
        if !pe_link_input(&link, wasm_text_bytes(argv[first_input + convert(i32, at)]), init(WasmBytes) { data: inputs.data[at].data, length: inputs.data[at].length }) { break; }
    }
    pe_link_input(&link, wasm_text_bytes("probe.lib"), init(WasmBytes) { data: probe.data, length: probe.length });
    var exported = wasm_text_bytes("elf_answer"); vector_push(&link.exports, exported);
    if !pe_link_run(&link) {
        puts(pe_message(link.error.kind)); var message: ByteBuffer = default; defer bytes_dispose(&message);
        bytes_assign_text(&message, link.error.name.data, link.error.name.length); puts(message.data); print(link.error.offset); return 1;
    }
    if checks {
        var probe_bytes: WasmBytes = { data: probe.data, length: probe.length };
        pe_check_inputs(&inputs, probe_bytes, &link); pe_check_patch_matrix(&inputs, probe_bytes); pe_check_byte_service(&inputs, probe_bytes, &link);
        pe_check_patch_errors(&inputs, probe_bytes);
    }
    var file = fopen(argv[1], "wb"); utility_check(file != null, "PE output open");
    var written = fwrite(link.output.data, 1, link.output.length, file);
    utility_check(fclose(file) == 0 && written == link.output.length, "PE output write");
    puts("Tower PE image linked"); print(link.jobs_run); print(link.jobs_peak); return 0;
}
