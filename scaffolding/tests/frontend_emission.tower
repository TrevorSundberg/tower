import tower;
import .library.vector;
import .compiler.syntax_view;
import .compiler.syntax_emission_types;
import .compiler.syntax_types;
import .compiler.component_kinds;
import .compiler.grammar_types;
import frontend_world;
import frontend_format;
import frontend_syntax_preview;

extern fn syntax_emit(input: SyntaxEmissionInput*): void*;

extern fn syntax_emit_inherit(input: SyntaxEmissionInput*, parent: void*): void*;

extern fn syntax_emission_destroy(value: void*): void;

extern fn syntax_emission_production_count(value: void*): usize;

extern fn syntax_emission_productions(value: void*): SyntaxEmissionProduction*;

extern fn syntax_emission_find_index(value: void*, index: usize): SyntaxEmissionProduction*;

extern fn syntax_emission_find_name(value: void*, name: u8*, alternative: usize): usize;

extern fn syntax_emission_rule_index(value: void*, name: u8*): usize;

extern fn syntax_emission_helper_count(value: void*): usize;

extern fn syntax_emission_helper(value: void*, index: usize, out: SyntaxEmissionHelper*): void;

extern fn syntax_emission_wrapper(value: void*, name: u8*): u8*;

extern fn syntax_emission_find_helper(value: void*, name: u8*): SyntaxEmissionHelper*;

extern fn syntax_emission_capture_name(value: void*, source: void*): u8*;

extern fn syntax_emission_repetitions(value: void*): SyntaxEmissionHelper*;

extern fn syntax_emission_repetition_count(value: void*): usize;

extern fn syntax_emission_literal(value: void*, name: u8*): u32;

extern fn syntax_emission_terminal(value: void*, name: u8*): u32;

extern fn syntax_emission_literal_count(value: void*): usize;

extern fn syntax_emission_literals(value: void*): SyntaxEmissionLiteral*;

extern fn syntax_emission_literal_ids(value: void*): u32*;

extern fn syntax_emission_keyword_count(value: void*): usize;

extern fn syntax_emission_keywords(value: void*): u8**;

extern fn syntax_emission_token_text(value: void*, id: u32): u8*;

fn frontend_emission_before(left: u8*, right: u8*): bool {
    var index: usize = 0;
    while left[index] == right[index] {
        var end = left[index] == 0;
        if end {
            return false;
        }
        index = index + 1;
    }
    var before = left[index] < right[index];
    return before;
}

// Exercise production exports against shared grammar components in an isolated
// world. Emission owns its rows/names; the caller pins the source entities.
fn frontend_emission_tests(): void {
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    var store = compiler_world_store(world);
    var kinds: FrontendKinds;
    frontend_world_check(frontend_world_test_kinds(world, &kinds));
    var source = entity_create(store);
    var alternatives: void*[3];
    var i: usize = 0;
    for(; i < 3; i++) {
        alternatives[i] = frontend_format_child(store, source, null);
        var data = preview_syntax(world, alternatives[i]);
        data.kind = convert(u32, SyntaxKind.Alternative);
    }
    var term_entity = frontend_format_child(store, alternatives[0], null);
    var term = preview_syntax(world, term_entity);
    term.kind = convert(u32, SyntaxKind.Term);
    term.literal = true;
    term.repetition = 43;
    frontend_world_check(bytes_append(&term.text, "x", 1));
    frontend_world_check(bytes_append(&term.capture, "items", 5));
    var first = preview_syntax(world, alternatives[0]);
    // Shared source can occur multiple times; reverse capture lookup must pick
    // its last emitted helper, even when names cross a decimal digit boundary.
    i = 0;
    while i < 12 {
        frontend_world_check(vector_push(void*, &first.items, term_entity));
        i = i + 1;
    }
    var other_entity = frontend_format_child(store, alternatives[1], null);
    var other = preview_syntax(world, other_entity);
    other.kind = convert(u32, SyntaxKind.Term);
    other.literal = true;
    other.repetition = 43;
    frontend_world_check(bytes_append(&other.text, "x", 1));
    frontend_world_check(bytes_append(&other.capture, "items", 5));
    var other_sequence = preview_syntax(world, alternatives[1]);
    frontend_world_check(vector_push(void*, &other_sequence.items, other_entity));
    var tokens: void*[2];
    tokens[0] = frontend_format_child(store, source, null);
    tokens[1] = frontend_format_child(store, source, null);
    var terminal = preview_syntax(world, tokens[0]);
    terminal.kind = convert(u32, SyntaxKind.Token);
    frontend_world_check(bytes_append(&terminal.name, "Identifier", 10));
    terminal = preview_syntax(world, tokens[1]);
    terminal.kind = convert(u32, SyntaxKind.Skip);
    frontend_world_check(bytes_append(&terminal.name, "Whitespace", 10));
    var names: u8[4];
    fill(&names, 0, 4);
    names[0] = 65;
    names[2] = 66;
    var rules: SyntaxRuleView[2];
    rules[0].name = &names[0];
    rules[0].name_length = 1;
    rules[0].alternatives = &alternatives[0];
    rules[0].count = 2;
    rules[1].name = &names[2];
    rules[1].name_length = 1;
    rules[1].alternatives = &alternatives[2];
    rules[1].count = 1;
    var input: SyntaxEmissionInput;
    fill(&input, 0, sizeof(SyntaxEmissionInput));
    input.rules = &rules[0];
    input.count = 2;
    input.tokens = &tokens[0];
    input.token_count = 2;
    input.category = "A";
    // Deliberately unsorted and sparse IDs, including a duplicate display ID.
    var literals: SyntaxEmissionLiteral[5];
    literals[0].text = "x";
    literals[0].length = 1;
    literals[0].id = 2097152;
    literals[1].text = "z";
    literals[1].length = 1;
    literals[1].id = 2097152;
    literals[2].text = "true";
    literals[2].length = 4;
    literals[2].id = 999000;
    literals[3].text = ";";
    literals[3].length = 1;
    literals[3].id = 2097159;
    literals[4].text = "(";
    literals[4].length = 1;
    literals[4].id = 2097160;
    input.literals = &literals[0];
    input.literal_count = 5;
    input.syntax_kind = kinds.syntax;
    input.rule_kind = kinds.rule;
    input.reference_kind = kinds.reference;
    input.string_kind = kinds.string;
    input.range_kind = kinds.range;
    input.root = entity_create(store);
    var revision = syntax_emit(&input);
    var ok = revision != null;
    frontend_world_check(ok);
    var rows = syntax_emission_productions(revision);
    var helper: SyntaxEmissionHelper;
    ok = syntax_emission_helper_count(revision) == 26;
    frontend_world_check(ok);
    syntax_emission_helper(revision, 0, &helper);
    var last_capture: SyntaxEmissionHelper;
    syntax_emission_helper(revision, 23, &last_capture);
    var other_capture: SyntaxEmissionHelper;
    syntax_emission_helper(revision, 25, &other_capture);
    var repetitions = syntax_emission_repetitions(revision);
    ok = syntax_emission_repetition_count(revision) == 13;
    frontend_world_check(ok);
    i = 1;
    while i < 13 {
        var previous = i -1;
        frontend_world_check(frontend_emission_before(repetitions[previous].name, repetitions[i].name));
        i = i + 1;
    }
    var wrapper = syntax_emission_wrapper(revision, "Identifier");
    ok = wrapper != null;
    frontend_world_check(ok);
    ok = syntax_emission_rule_index(revision, wrapper) != frontend_world_unlimited();
    frontend_world_check(ok);
    ok = syntax_emission_production_count(revision) == 3;
    frontend_world_check(ok);
    var first_root = input.root;
    input.root = entity_create(store);
    var second = syntax_emit(&input);
    ok = second != null;
    frontend_world_check(ok);
    // Warm entity/query capacity before counting an emission's temporary work.
    var second_root = input.root;
    // Inheritance consumes the parent's frozen views, with no native map copies.
    input.literals = null;
    input.literal_count = 0;
    input.root = entity_create(store);
    var inherited_root = input.root;
    var inherited = syntax_emit_inherit(&input, revision);
    ok = inherited != null;
    frontend_world_check(ok);
    ok = syntax_emission_rule_index(inherited, helper.name) == frontend_world_unlimited();
    frontend_world_check(ok);
    input.root = entity_create(store);
    var probe_allocations = tower_test_buffer_allocations();
    var probe = syntax_emit_inherit(&input, revision);
    probe_allocations = tower_test_buffer_allocations() - probe_allocations;
    ok = probe != null;
    frontend_world_check(ok);
    syntax_emission_destroy(probe);
    entity_release(input.root);
    var buffers = tower_test_buffer_count();
    var budget: usize = 0;
    for(; budget < probe_allocations; budget++) {
        input.root = entity_create(store);
        var actual = tower_test_buffer_allocations();
        tower_test_buffer_fail_after(budget);
        probe = syntax_emit_inherit(&input, revision);
        actual = tower_test_buffer_allocations() - actual;
        tower_test_buffer_fail_after(frontend_world_unlimited());
        // Retained component-index capacity can remove allocations on retry.
        // Require failure only when this attempt reached the injected call.
        var injected = actual > budget;
        if injected {
            ok = probe == null;
            frontend_world_check(ok);
        } else {
            ok = probe != null;
            frontend_world_check(ok);
            ok = syntax_emission_production_count(probe) == 3;
            frontend_world_check(ok);
            ok = syntax_emission_find_name(probe, "B", 0) == rows[2].index;
            frontend_world_check(ok);
        }
        syntax_emission_destroy(probe);
        entity_release(input.root);
        ok = tower_test_buffer_count() == buffers;
        frontend_world_check(ok);
    }
    // None of these temporary arrays are retained by either revision.
    var rule_bytes = sizeof(SyntaxRuleView) *2;
    fill(&rules, 0, rule_bytes);
    fill(&names, 0, 4);
    fill(&literals, 0, sizeof(SyntaxEmissionLiteral[5]));
    var literal_rows = syntax_emission_literals(revision);
    var literal_ids = syntax_emission_literal_ids(revision);
    ok = syntax_emission_literal_count(revision) == 5;
    frontend_world_check(ok);
    frontend_format_text(literal_rows[0].text, "(");
    frontend_format_text(literal_rows[1].text, ";");
    frontend_format_text(literal_rows[2].text, "true");
    frontend_format_text(literal_rows[3].text, "x");
    frontend_format_text(literal_rows[4].text, "z");
    ok = syntax_emission_keyword_count(revision) == 3;
    frontend_world_check(ok);
    var keywords = syntax_emission_keywords(revision);
    frontend_format_text(keywords[0], "true");
    frontend_format_text(keywords[1], "x");
    frontend_format_text(keywords[2], "z");
    var display = syntax_emission_token_text(revision, 2097152);
    frontend_format_text(display, "'z'");
    tower_memory_free(bits(void*, display));
    display = syntax_emission_token_text(revision, 1114112);
    frontend_format_text(display, "Identifier");
    tower_memory_free(bits(void*, display));
    display = syntax_emission_token_text(revision, 1114113);
    frontend_format_text(display, "quoted grammar literal");
    tower_memory_free(bits(void*, display));
    ok = syntax_emission_token_text(revision, 1179649) == null;
    frontend_world_check(ok);
    ok = syntax_emission_token_text(revision, 999001) == null;
    frontend_world_check(ok);
    var allocations = tower_test_buffer_allocations();
    var references = entity_references(term_entity);
    var repeat: usize = 0;
    for(; repeat < 64; repeat++) {
        i = 0;
        while i < 5 {
            ok = syntax_emission_literal(revision, literal_rows[i].text) == literal_ids[i];
            frontend_world_check(ok);
            ok = syntax_emission_literal(inherited, literal_rows[i].text) == literal_ids[i];
            frontend_world_check(ok);
            i = i + 1;
        }
        ok = syntax_emission_terminal(revision, "Identifier") == 1114112;
        frontend_world_check(ok);
        ok = syntax_emission_terminal(revision, "Whitespace") == 4294967294;
        frontend_world_check(ok);
        ok = syntax_emission_literal(revision, "Missing") == 4294967294;
        frontend_world_check(ok);
        i = 0;
        for(; i < 3; i++) {
            ok = syntax_emission_find_index(revision, rows[i].index) == &rows[i];
            frontend_world_check(ok);
            ok = syntax_emission_find_name(revision, rows[i].name, rows[i].alternative) == rows[i].index;
            frontend_world_check(ok);
        }
        ok = syntax_emission_find_name(revision, "A", 0) == rows[0].index;
        frontend_world_check(ok);
        ok = syntax_emission_rule_index(revision, "A") == rows[0].index;
        frontend_world_check(ok);
        ok = syntax_emission_rule_index(revision, "B") == rows[2].index;
        frontend_world_check(ok);
        var helper_index = rows[0].index + 1;
        ok = syntax_emission_rule_index(revision, helper.name) == helper_index;
        frontend_world_check(ok);
        var origin = syntax_emission_find_helper(revision, helper.name);
        ok = origin != null;
        frontend_world_check(ok);
        ok = origin.source == term_entity;
        frontend_world_check(ok);
        ok = origin.capture == false;
        frontend_world_check(ok);
        origin = syntax_emission_find_helper(revision, last_capture.name);
        frontend_world_check(origin.capture);
        frontend_format_text(syntax_emission_capture_name(revision, term_entity), last_capture.name);
        frontend_format_text(syntax_emission_capture_name(revision, other_entity), other_capture.name);
        ok = syntax_emission_capture_name(revision, source) == null;
        frontend_world_check(ok);
        ok = syntax_emission_find_helper(revision, "A") == null;
        frontend_world_check(ok);
        ok = syntax_emission_find_helper(revision, "Missing") == null;
        frontend_world_check(ok);
        ok = syntax_emission_wrapper(revision, "Identifier") == wrapper;
        frontend_world_check(ok);
        ok = syntax_emission_wrapper(revision, "Whitespace") == null;
        frontend_world_check(ok);
        ok = syntax_emission_wrapper(revision, "Missing") == null;
        frontend_world_check(ok);
        // A literal name may exist in the interner without defining a rule.
        ok = syntax_emission_rule_index(revision, "x") == frontend_world_unlimited();
        frontend_world_check(ok);
        ok = syntax_emission_rule_index(revision, "Missing") == frontend_world_unlimited();
        frontend_world_check(ok);
        ok = syntax_emission_find_name(revision, "B", 0) == rows[2].index;
        frontend_world_check(ok);
        ok = syntax_emission_find_name(revision, "A", 2) == frontend_world_unlimited();
        frontend_world_check(ok);
        ok = syntax_emission_find_name(revision, "Missing", 0) == frontend_world_unlimited();
        frontend_world_check(ok);
        ok = syntax_emission_find_index(revision, frontend_world_unlimited()) == null;
        frontend_world_check(ok);
    }
    // Repetition helpers occupy indices between source alternatives.
    var gap = rows[0].index + 1;
    ok = gap < rows[1].index;
    frontend_world_check(ok);
    ok = syntax_emission_find_index(revision, gap) == null;
    frontend_world_check(ok);
    ok = tower_test_buffer_allocations() == allocations;
    frontend_world_check(ok);
    ok = entity_references(term_entity) == references;
    frontend_world_check(ok);
    // Source names are borrowed only by the source graph; result text is owned.
    var capture_text: u8[64];
    fill(&capture_text, 0, 64);
    i = 0;
    while last_capture.name[i] != 0 {
        capture_text[i] = last_capture.name[i];
        i = i + 1;
    }
    var b = rows[2].index;
    syntax_emission_destroy(revision);
    entity_release(first_root);
    ok = syntax_emission_literal(inherited, "true") == 999000;
    frontend_world_check(ok);
    display = syntax_emission_token_text(inherited, 2097152);
    frontend_format_text(display, "'z'");
    tower_memory_free(bits(void*, display));
    syntax_emission_destroy(inherited);
    entity_release(inherited_root);
    ok = syntax_emission_find_name(second, "B", 0) == b;
    frontend_world_check(ok);
    ok = syntax_emission_rule_index(second, "B") == b;
    frontend_world_check(ok);
    frontend_format_text(syntax_emission_capture_name(second, term_entity), &capture_text[0]);
    ok = syntax_emission_wrapper(second, "Identifier") != null;
    frontend_world_check(ok);
    syntax_emission_destroy(second);
    entity_release(second_root);
    entity_release(source);
    frontend_world_check(compiler_world_dispose(world));
    ok = tower_test_buffer_count() == baseline;
    frontend_world_check(ok);
}
