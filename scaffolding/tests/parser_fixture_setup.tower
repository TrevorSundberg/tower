import tower;
import .library.bytes_types;
import .library.bytes_interface;
import .host.syntax_baseline_api;
import .compiler.syntax_version_types;
import utility_checks;
import storage_api;

extern fn driver_read_file(path: u8*, out: ByteBuffer*): bool;
extern fn host_text_terminate(out: ByteBuffer*): bool;
extern fn compiler_runtime_write(data: u8*, length: usize): void;

fn parser_fixture_try_baseline(path: u8*, bedrock: bool): bool {
    var input: ByteBuffer; fill(&input, 0, sizeof(ByteBuffer)); defer bytes_dispose(&input);
    if !driver_read_file(path, &input) || !host_text_terminate(&input) {
        compiler_runtime_write("Cannot read ", 12); compiler_runtime_write(path, strlen(path)); compiler_runtime_write("\n", 1); return false;
    }
    var result: SyntaxVersionDiagnostic = default;
    defer syntax_version_diagnostic_dispose(&result);
    if !syntax_host_install(compiler_host_world(), input.data, !bedrock, &result) {
        var text = syntax_version_diagnostic_text(&result);
        compiler_runtime_write(text, strlen(text)); compiler_runtime_write("\n", 1); return false;
    }
    return true;
}
fn parser_fixture_setup(): void {
    utility_check(parser_fixture_try_baseline("bedrock.tower", true) && parser_fixture_try_baseline("foundation.tower", false), "Install parser fixture grammar");
}
