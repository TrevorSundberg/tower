import tower;
import '../library/stack';
import '../library/queue';

fn collection_tests(): i32 {
    var values: stack(i32);
    var moved: stack(i32);
    stack_init(i32, &values);
    stack_init(i32, &moved);
    var output = 123;
    var ok = stack_pop(i32, &values, &output);
    if ok {
        return 1;
    }
    var good = output == 123;
    if good {} else {
        return 2;
    }
    var i = 0;
    while i < 80 {
        ok = stack_push(i32, &values, i);
        if ok {} else {
            return 3;
        }
        i = i + 1;
    }
    stack_move(i32, &values, &values);
    ok = stack_push(i32, &moved, 999);
    if ok {} else {
        return 4;
    }
    stack_move(i32, &moved, &values);
    good = values.length == 0;
    if good {} else {
        return 5;
    }
    good = values.data == null;
    if good {} else {
        return 6;
    }
    while i > 0 {
        i = i - 1;
        ok = stack_pop(i32, &moved, &output);
        if ok {} else {
            return 7;
        }
        good = output == i;
        if good {} else {
            return 8;
        }
    }
    stack_dispose(i32, &values);
    stack_dispose(i32, &moved);

    var fifo: queue(i32);
    var destination: queue(i32);
    queue_init(i32, &fifo);
    queue_init(i32, &destination);
    i = 0;
    while i < 8 {
        ok = queue_push(i32, &fifo, i);
        if ok {} else {
            return 9;
        }
        i = i + 1;
    }
    var expected_value = 0;
    while expected_value < 5 {
        ok = queue_pop(i32, &fifo, &output);
        if ok {} else {
            return 10;
        }
        good = output == expected_value;
        if good {} else {
            return 11;
        }
        expected_value = expected_value + 1;
    }
    // Wrap the ring before growing it; retain FIFO order across relocation.
    while i < 100 {
        ok = queue_push(i32, &fifo, i);
        if ok {} else {
            return 12;
        }
        i = i + 1;
    }
    var saved = fifo.length;
    ok = queue_pop(i32, &fifo, null);
    if ok {
        return 13;
    }
    good = fifo.length == saved;
    if good {} else {
        return 14;
    }
    var maximum: usize = 0;
    maximum = maximum - 1;
    var data = fifo.data;
    ok = queue_reserve(i32, &fifo, maximum);
    if ok {
        return 15;
    }
    good = fifo.data == data;
    if good {} else {
        return 16;
    }
    queue_move(i32, &fifo, &fifo);
    ok = queue_push(i32, &destination, 999);
    if ok {} else {
        return 17;
    }
    queue_move(i32, &destination, &fifo);
    good = fifo.data == null;
    if good {} else {
        return 18;
    }
    while queue_pop(i32, &destination, &output) {
        good = output == expected_value;
        if good {} else {
            return 19;
        }
        expected_value = expected_value + 1;
    }
    good = expected_value == 100;
    if good {} else {
        return 20;
    }
    output = 123;
    ok = queue_pop(i32, &destination, &output);
    if ok {
        return 21;
    }
    good = output == 123;
    if good {} else {
        return 22;
    }
    queue_dispose(i32, &fifo);
    queue_dispose(i32, &destination);

    var pointers: queue(i32*);
    queue_init(i32*, &pointers);
    ok = queue_push(i32*, &pointers, &output);
    if ok {} else {
        return 23;
    }
    var pointer: i32* = null;
    ok = queue_pop(i32*, &pointers, &pointer);
    if ok {} else {
        return 24;
    }
    good = *pointer == 123;
    if good {} else {
        return 25;
    }
    queue_dispose(i32*, &pointers);
    return 0;
}

print(collection_tests());
