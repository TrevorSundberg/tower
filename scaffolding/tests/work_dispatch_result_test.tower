import library.testing;
import work_dispatch_result;
import .compiler.compiler_kernel;
import .library.work_pool;
import .library.work_budget_types;
import .host.memory;

test() { dispatch_invalid(); }
test() { dispatch_rounds(); }
test() { dispatch_named(); }

struct DispatchObservation {
    pool: WorkPool*; jobs: DispatchResultJob*; count: usize;
    started: usize; joined: usize;
}

fn dispatch_observe(context: void*, payload: void*, ordinal: usize, lanes: usize, entering: bool): void {
    var observer = bits(DispatchObservation*, context);
    if payload == null {
        assert(ordinal == observer.count && lanes <= observer.pool.count && observer.pool.running == 0,
            "Observe a drained pool and its granted lanes at each batch boundary");
        if entering { observer.started++; }
        else {
            observer.joined++;
            for(var i: usize = 0; i < observer.count; i++) {
                assert(observer.jobs[i].observed == observer.jobs[i].calls * 2,
                    "Every executed job has paired entry and exit observations before join");
            }
        }
        return;
    }
    assert(ordinal < observer.count && payload == bits(void*, &observer.jobs[ordinal].kernel),
        "The observer receives the selected job's embedded kernel");
    var job = &observer.jobs[ordinal];
    assert(job.observed % 2 == (entering ? convert(usize, 0) : convert(usize, 1)),
        "Job observations alternate between entry and exit");
    job.observed++;
}

fn dispatch_invalid(): void {
    var closed: WorkPool = default;
    closed.resource_error = WorkBudgetError.Capacity;
    var job: DispatchResultJob = default;
    job.kernel.payload = bits(void*, &job);
    var jobs: DispatchResultJob*[1]; jobs[0] = &job;
    assert(compiler_kernel_dispatch_result(null, &jobs[0], 0) == WorkBudgetError.None,
        "An empty typed batch needs no pool");
    assert(work_pool_batch_result(null, null, 0, 0, 0) == WorkBudgetError.None,
        "An empty raw batch needs no job array");
    assert(compiler_kernel_dispatch_result(null, &jobs[0], 1) == WorkBudgetError.Invalid,
        "Reject a nonempty dispatch without a pool");
    assert(compiler_kernel_dispatch_result(&closed, &jobs[0], 1) == WorkBudgetError.Invalid,
        "Reject a nonempty dispatch on a closed pool");
    assert(compiler_kernel_dispatch_result(&closed, bits(DispatchResultJob**, null), 1)
        == WorkBudgetError.Invalid,
        "Reject a missing job array");
    jobs[0] = null;
    assert(compiler_kernel_dispatch_admitted_result(&closed, &jobs[0], 1, 1)
        == WorkBudgetError.Invalid,
        "Reject an absent job in the array");
    assert(closed.resource_error == WorkBudgetError.Capacity && job.calls == 0,
        "Invalid calls preserve the prior capacity error and execute no job");
}

fn dispatch_failure(round: usize): void {
    var jobs: DispatchResultJob[4] = default;
    var count = sizeof(decltype(jobs)) / sizeof(DispatchResultJob);
    var pool: WorkPool = default;
    assert(work_pool_open(&pool, count) && pool.threaded && pool.count == count,
        "Open four real worker slots for the retry");
    defer work_pool_close(&pool);
    var observation = init(DispatchObservation) {pool: &pool, jobs: &jobs[0], count: count, ..default};
    pool.observation = bits(void*, &observation); pool.observe = dispatch_observe;
    var pointers: DispatchResultJob*[4];
    assert(sizeof(decltype(pointers)) / sizeof(DispatchResultJob*) == count,
        "Each job has a dispatch pointer");
    for(var i: usize = 0; i < count; i++) {
        jobs[i].prefix = 12345;
        jobs[i].input = round + i;
        jobs[i].kernel.payload = bits(void*, &jobs[i]);
        pointers[i] = &jobs[i];
    }
    DispatchFailSignal = true;
    assert(compiler_kernel_dispatch_result(&pool, &pointers[0], count) == WorkBudgetError.Memory,
        "Failure to open the claim signal returns Memory");
    assert(!DispatchFailSignal && pool.claim == null && pool.running == 0
        && pool.peak == 0 && pool.resource_error == WorkBudgetError.Memory,
        "Consume the fault before acquiring a claim or running any job");
    for(var i: usize = 0; i < count; i++) {
        assert(jobs[i].calls == 0, "A pre-dispatch failure executes no job");
    }
    assert(compiler_kernel_dispatch_result(&pool, &pointers[0], 0) == WorkBudgetError.None
        && pool.resource_error == WorkBudgetError.Memory,
        "An empty retry preserves the stored memory error");
    // No execution happened on this pre-dispatch failure. A new valid call
    // resets the receipt; normal successes are checked through both APIs.
    assert(compiler_kernel_dispatch_result(&pool, &pointers[0], count) == WorkBudgetError.None,
        "Retry the same jobs after the one-shot signal fault");
    assert(pool.running == 0 && pool.resource_error == WorkBudgetError.None,
        "The successful retry drains the pool and clears its error");
    assert(compiler_kernel_dispatch_admitted(&pool, &pointers[0], count, 0),
        "The caller-only retry succeeds through the boolean API");
    for(var i: usize = 0; i < count; i++) {
        assert(jobs[i].calls == 2 && jobs[i].prefix == 12345
            && jobs[i].result == (round + i) * (round + i) + 7,
            "Both retries execute each embedded kernel and preserve its prefix and result");
    }
    // Closing a failed pool retains the fixed failure after freeing storage.
    work_signal_close(pool.claim); pool.claim = null;
    DispatchFailSignal = true;
    assert(!compiler_kernel_dispatch(&pool, &pointers[0], count),
        "The boolean API rejects a second claim-signal failure");
    assert(observation.started == 4 && observation.joined == observation.started,
        "The four nonempty batches each report entry and join");
    work_pool_close(&pool);
    assert(pool.resource_error == WorkBudgetError.Memory && pool.count == 0 && pool.slots == null,
        "Closing the failed pool releases storage and retains Memory");
}

fn dispatch_busy(): void {
    var pool: WorkPool = default;
    assert(work_pool_open(&pool, 2) && pool.threaded,
        "Open a threaded pool for the live job");
    var entered = work_signal_open();
    var release = work_signal_open();
    assert(entered != null && release != null,
        "Open the prior job's entry and release signals");
    defer work_signal_close(entered);
    defer work_signal_close(release);
    var prior: DispatchResultJob = default;
    prior.kernel.payload = bits(void*, &prior);
    prior.entered = entered; prior.release = release; prior.input = 19;
    assert(work_pool_submit(&pool, bits(void*, &prior.kernel)),
        "Submit the prior job to a real worker");
    work_signal_wait(entered);
    var next: DispatchResultJob = default;
    next.kernel.payload = bits(void*, &next);
    var jobs: DispatchResultJob*[1]; jobs[0] = &next;
    assert(compiler_kernel_dispatch_result(&pool, &jobs[0], 1) == WorkBudgetError.Busy,
        "Typed dispatch returns Busy while the earlier job is live");
    assert(!compiler_kernel_dispatch(&pool, &jobs[0], 1),
        "The boolean API rejects the same busy pool");
    assert(pool.running == 1 && pool.resource_error == WorkBudgetError.None && next.calls == 0,
        "Busy preserves the live job and leaves the proposed job untouched");
    assert(compiler_kernel_dispatch_result(&pool, &jobs[0], 0) == WorkBudgetError.None
        && pool.running == 1,
        "An empty dispatch succeeds without draining the earlier job");
    // The owner still has to unblock and drain its earlier borrow. Reading its
    // result before this join would be a race, even after the Busy rejection.
    work_signal_post(release);
    work_pool_close(&pool);
    assert(prior.calls == 1 && prior.result == 368 && next.calls == 0,
        "Closing joins the prior job with result 368 and leaves the rejected job untouched");
}

fn dispatch_named(): void {
    var jobs: DispatchResultJob[2] = default;
    var count = sizeof(decltype(jobs)) / sizeof(DispatchResultJob);
    var pool: WorkPool = default;
    assert(work_pool_open_named(&pool, count, "work_thread_entry", null),
        "Open the named Linux worker entry");
    defer work_pool_close(&pool);
    var pointers: DispatchResultJob*[2];
    assert(sizeof(decltype(pointers)) / sizeof(DispatchResultJob*) == count,
        "Each named-pool job has a dispatch pointer");
    for(var i: usize = 0; i < count; i++) {
        jobs[i].kernel.payload = bits(void*, &jobs[i]);
        pointers[i] = &jobs[i];
    }
    assert(compiler_kernel_dispatch_admitted_result(&pool, &pointers[0], count, 1)
        == WorkBudgetError.Invalid,
        "Reject batch lanes for the named entry");
    assert(pool.running == 0 && pool.claim == null && jobs[0].calls == 0 && jobs[1].calls == 0,
        "The rejected named dispatch claims no signal and executes no job");
    // Inline work never sends a batch descriptor to the named entry.
    assert(compiler_kernel_dispatch_admitted_result(&pool, &pointers[0], count, 0)
        == WorkBudgetError.None,
        "A named pool accepts caller-only execution");
    assert(jobs[0].calls == 1 && jobs[1].calls == 1,
        "Caller-only dispatch executes both named-pool jobs exactly once");
}

fn dispatch_rounds(): void {
    for(var round: usize = 0; round < 16; round++) {
        dispatch_failure(round);
        dispatch_busy();
    }
}

// Each worker borrows one kernel and its enclosing job through the join.
// The scratch allocation belongs to this invocation of the host callback.
export fn work_kernel_execute(payload: void*): void {
    var kernel = bits(CompilerKernel*, payload);
    var job = bits(DispatchResultJob*, kernel.payload);
    if job.entered != null {
        work_signal_post(job.entered);
        work_signal_wait(job.release);
    }
    var memory = alloc(u8, DispatchScratchBytes);
    assert(memory != null, "Allocate private worker scratch");
    var value = convert(u8, job.input);
    fill(memory, value, DispatchScratchBytes);
    assert(memory[0] == value && memory[DispatchScratchBytes - 1] == value,
        "Both ends of the worker scratch retain its input byte");
    free(memory);
    job.calls++;
    job.result = job.input * job.input + 7;
}
