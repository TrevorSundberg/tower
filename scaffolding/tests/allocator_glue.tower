import tower;

// Exercise the real Foundation runtime exports and the retained instrumentation
// ABI. Link this same object against the old and new allocator implementations.
extern fn tower_test_buffer_count(): usize;

extern fn tower_test_buffer_allocations(): usize;

extern fn tower_test_buffer_fail_next(): void;

extern fn tower_test_buffer_fail_after(count: usize): void;

extern fn compiler_host_reallocate(pointer: void*, bytes: usize): void*;

extern fn compiler_host_deallocate(pointer: void*): void;

extern fn puts(text: u8*): i32;

fn allocator_misaligned(address: usize, alignment: usize): bool {
    var remainder = address % alignment;
    var misaligned = remainder != 0;
    return misaligned;
}

fn allocator_glue_tests(): i32 {
    var initial = tower_test_buffer_count();
    var calls = tower_test_buffer_allocations();
    var maximum: usize = 0;
    maximum--;
    tower_test_buffer_fail_next();
    var overflow = alloc(u64, maximum);
    var check_1 = overflow != null;
    if check_1 {
        return 1;
    }
    var check_2 = tower_test_buffer_allocations() != calls;
    if check_2 {
        return 2;
    }
    var pointer = alloc(u8, 32);
    var check_3 = pointer != null;
    if check_3 {
        return 3;
    }
    calls++;
    var check_4 = tower_test_buffer_allocations() != calls;
    if check_4 {
        return 4;
    }
    var check_5 = tower_test_buffer_count() != initial;
    if check_5 {
        return 5;
    }
    pointer = alloc(u8, 32);
    var check_6 = pointer == null;
    if check_6 {
        return 6;
    }
    var live = initial + 1;
    var check_7 = tower_test_buffer_count() != live;
    if check_7 {
        return 7;
    }
    var i: usize = 0;
    for(; i < 32; i++) {
        pointer[i] = convert(u8, i);
    }
    calls = tower_test_buffer_allocations();
    tower_test_buffer_fail_next();
    var wide = bits(u64*, pointer);
    var wide_next = realloc(u64, wide, maximum);
    var check_8 = wide_next != null;
    if check_8 {
        return 8;
    }
    var check_9 = tower_test_buffer_allocations() != calls;
    if check_9 {
        return 9;
    }
    // Overflow did not consume the failure. Failed growth preserves the input.
    var next = realloc(u8, pointer, 256);
    var check_10 = next != null;
    if check_10 {
        return 10;
    }
    var check_11 = tower_test_buffer_count() != live;
    if check_11 {
        return 11;
    }
    i = 0;
    for(; i < 32; i++) {
        var check_12 = pointer[i] != convert(u8, i);
        if check_12 {
            return 12;
        }
    }
    next = realloc(u8, pointer, 256);
    var check_13 = next == null;
    if check_13 {
        return 13;
    }
    pointer = next;
    var check_14 = tower_test_buffer_count() != live;
    if check_14 {
        return 14;
    }
    i = 0;
    for(; i < 32; i++) {
        var check_15 = pointer[i] != convert(u8, i);
        if check_15 {
            return 15;
        }
    }
    // Failure injection precedes zero-size deallocation, including realloc.
    tower_test_buffer_fail_next();
    next = realloc(u8, pointer, 0);
    var check_16 = next != null;
    if check_16 {
        return 16;
    }
    var check_17 = tower_test_buffer_count() != live;
    if check_17 {
        return 17;
    }
    var check_18 = pointer[31] != 31;
    if check_18 {
        return 18;
    }
    next = realloc(u8, pointer, 0);
    var check_19 = next != null;
    if check_19 {
        return 19;
    }
    var check_20 = tower_test_buffer_count() != initial;
    if check_20 {
        return 20;
    }
    pointer = null;
    free(pointer);
    var check_21 = tower_test_buffer_count() != initial;
    if check_21 {
        return 21;
    }
    var check_22 = alloc(u8, 0) != null;
    if check_22 {
        return 22;
    }
    tower_test_buffer_fail_after(1);
    pointer = alloc(u8, 1);
    var check_23 = pointer == null;
    if check_23 {
        return 23;
    }
    next = alloc(u8, 1);
    var check_24 = next != null;
    if check_24 {
        return 24;
    }
    next = alloc(u8, 1);
    var check_25 = next == null;
    if check_25 {
        return 25;
    }
    free(next);
    free(pointer);
    var check_26 = tower_test_buffer_count() != initial;
    if check_26 {
        return 26;
    }

    // Host/node allocation bypasses buffer instrumentation intentionally. Check
    // target ABI alignment without assuming that a wasm host has 64-bit pointers.
    calls = tower_test_buffer_allocations();
    tower_test_buffer_fail_next();
    for(var size: usize = 1; size <= 257; size++) {
        var memory = compiler_host_reallocate(null, size);
        var check_27 = memory == null;
        if check_27 {
            return 27;
        }
        var address = bits(usize, memory);
        var check_28 = allocator_misaligned(address, alignof(u64));
        if check_28 {
            return 28;
        }
        var check_29 = allocator_misaligned(address, alignof(void*));
        if check_29 {
            return 29;
        }
        var check_alignment = allocator_misaligned(address, 16);
        if check_alignment {
            return 42;
        }
        var bytes = bits(u8*, memory);
        fill(bytes, 173, size);
        var grown = size + 513;
        memory = compiler_host_reallocate(memory, grown);
        var check_30 = memory == null;
        if check_30 {
            return 30;
        }
        bytes = bits(u8*, memory);
        i = 0;
        for(; i < size; i++) {
            var check_31 = bytes[i] != 173;
            if check_31 {
                return 31;
            }
        }
        address = bits(usize, memory);
        var check_32 = allocator_misaligned(address, alignof(u64));
        if check_32 {
            return 32;
        }
        var check_33 = allocator_misaligned(address, alignof(void*));
        if check_33 {
            return 33;
        }
        check_alignment = allocator_misaligned(address, 16);
        if check_alignment {
            return 43;
        }
        compiler_host_deallocate(memory);
    }
    compiler_host_deallocate(null);
    var check_34 = tower_test_buffer_allocations() != calls;
    if check_34 {
        return 34;
    }
    var check_35 = tower_test_buffer_count() != initial;
    if check_35 {
        return 35;
    }
    var check_36 = alloc(u8, 1) != null;
    if check_36 {
        return 36;
    }
    pointer = alloc(u8, 1);
    var check_37 = pointer == null;
    if check_37 {
        return 37;
    }
    free(pointer);
    var check_38 = tower_test_buffer_count() != initial;
    if check_38 {
        return 38;
    }
    return 0;
}

// Short alternating before/after trials use identical Tower workload objects.
fn allocator_glue_benchmark(): i32 {
    var initial = tower_test_buffer_count();
    var pointers: u8*[64];
    var sum: u64 = 0;
    for(var round: usize = 0; round < 10000; round++) {
        var i: usize = 0;
        for(; i < 64; i++) {
            var size = i *17;
            size++;
            var pointer = alloc(u8, size);
            var check_39 = pointer == null;
            if check_39 {
                return 39;
            }
            pointers[i] = pointer;
            pointer[0] = convert(u8, i);
        }
        i = 0;
        for(; i < 64; i++) {
            var pointer = pointers[i];
            sum = sum + convert(u64, pointer[0]);
            free(pointer);
        }
    }
    var check_40 = tower_test_buffer_count() != initial;
    if check_40 {
        return 40;
    }
    var check_41 = sum != 20160000;
    if check_41 {
        return 41;
    }
    return 0;
}

export fn main(argc: i32, argv: u8**): i32 {
    var check_42 = argc > 1;
    if check_42 {
        return allocator_glue_benchmark();
    }
    var status = allocator_glue_tests();
    var check_43 = status == 0;
    if check_43 {
        puts("Tower allocator glue passed");
    }
    return status;
}
