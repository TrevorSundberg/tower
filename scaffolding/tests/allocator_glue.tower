import tower;
import allocator_abi.allocator_glue_benchmark_test;
import allocator_abi.allocator_glue_test;

export fn main(argc: i32, argv: u8**): i32 {
    if argc > 1 {
        return allocator_glue_benchmark();
    }
    var status: i32 = 0;
    check_allocator_glue(&status);
    return status;
}
