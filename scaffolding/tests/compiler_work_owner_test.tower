import tower;
import .library.testing;
import .library.work_budget;
import .library.work_budget_types;

extern fn compiler_work_create(count: usize, workers: usize, revision: u64, profile: u64): void*;
extern fn compiler_work_close(work: void*): void;
extern fn compiler_work_subject(work: void*, ordinal: usize): void*;
extern fn compiler_work_next(work: void*): usize;
extern fn compiler_work_accept(work: void*, ordinal: usize, revision: u64, profile: u64, success: bool): bool;
extern fn compiler_work_cancel(work: void*): void;
extern fn tower_test_buffer_count(): usize;
extern fn tower_test_buffer_allocations(): usize;
extern fn tower_test_buffer_fail_after(count: usize): void;

fn work_owner_allocation_sweep(): void {
    var baseline = tower_test_buffer_count();
    var calls = tower_test_buffer_allocations();
    var work = compiler_work_create(7, 3, 123, 456);
    assert(work is not null, "unit owner allocation");
    calls = tower_test_buffer_allocations() - calls;
    assert(calls > 0, "The constructor exposes a nonempty allocation failure sweep");
    assert(compiler_work_subject(work, 0) is null && compiler_work_subject(work, 8) is null, "unit owner ordinal bounds");
    var first = compiler_work_subject(work, 1);
    assert(first is not null && compiler_work_subject(work, 2) != first, "unit owner distinct subjects");
    var task = compiler_work_next(work);
    assert(task == 1, "unit owner admission");
    compiler_work_cancel(work);
    assert(!compiler_work_accept(work, task, 123, 456, true), "cancelled unit receipt rejected");
    compiler_work_close(work);
    assert(tower_test_buffer_count() == baseline, "unit owner exact cleanup");
    // Fail every allocation in the constructor, including partial entity trees,
    // component pages, graph indexes, dependency edges and access claims.
    for(var budget: usize = 0; budget < calls; budget++) {
        tower_test_buffer_fail_after(budget);
        work = compiler_work_create(7, 3, 123, 456);
        tower_test_buffer_fail_after(~convert(usize, 0));
        assert(work is null, "unit allocation failure propagated");
        compiler_work_close(work);
        assert(tower_test_buffer_count() == baseline, "partial unit owner cleanup");
    }
    work = compiler_work_create(7, 3, 124, 456);
    assert(work is not null, "unit owner retry after failure sweep");
    compiler_work_close(work);
    assert(tower_test_buffer_count() == baseline, "retried unit owner cleanup");
}

extern fn compiler_work_create_result(count: usize, workers: usize, revision: u64, profile: u64,
    budget: WorkBudget*, work: void**): WorkBudgetError;

fn work_owner_byte_budget(): void {
    var baseline = tower_test_buffer_count();
    var budget: WorkBudget = default;
    var work: void* = null;
    assert(work_budget_init(&budget, 3, 1, 123), "Initialize the one-byte unit budget");
    assert(compiler_work_create_result(7, 3, 123, 456, &budget, &work) == WorkBudgetError.Capacity &&
        work is null, "Refuse a unit owner that cannot fit");
    assert(budget.live == 0 && budget.used_bytes == 0 && budget.used_lanes == 0 &&
        work_budget_dispose(&budget), "Refused unit owner returns every reservation");
    assert(tower_test_buffer_count() == baseline, "Refused unit owner releases its storage");

    assert(work_budget_init(&budget, 3, 1048576, 124), "Initialize the retry budget");
    assert(compiler_work_create_result(7, 3, 124, 456, &budget, &work) == WorkBudgetError.None &&
        work is not null, "Recreate the same seven units inside the retry budget");
    assert(budget.live > 0 && budget.used_bytes > 0 && budget.peak_bytes >= budget.used_bytes &&
        budget.peak_bytes <= budget.bytes, "The live unit owner charges its bounded budget");
    compiler_work_close(work);
    assert(budget.live == 0 && budget.used_bytes == 0 && budget.used_lanes == 0 &&
        work_budget_dispose(&budget), "Closing the unit owner returns every reservation");
    assert(tower_test_buffer_count() == baseline, "Closing the budgeted unit owner releases its storage");
}

test() { work_owner_allocation_sweep(); }
test() { work_owner_byte_budget(); }
