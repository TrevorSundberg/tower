// A custom grammar needs its own numeric token; the Bedrock seed has none.
[number] token Number = /[0-9]+/;
parse Expression = Identifier | Number;parse Statement = Expression ';';parse Block = '{' $Statement* '}';parse Statement |= Block;parse Statement |= 'copy' '{' $body:Statement+ '}' => replace { { $body $body } };copy { x; }