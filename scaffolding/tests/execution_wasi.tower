import tower;
import execution_suite;
import execution_support;
import .compiler.execution_session;
import .library.bytes_types;
import .library.bytes_interface;
import .host.syntax_baseline_api;
import .compiler.syntax_version_types;

extern fn fopen(path: u8*, mode: u8*): void*;
extern fn fread(data: u8*, size: usize, count: usize, file: void*): usize;
extern fn ferror(file: void*): i32;
extern fn feof(file: void*): i32;
extern fn fclose(file: void*): i32;
extern fn frontend_modules_create(): void*;
extern fn frontend_modules_destroy(modules: void*): void;
extern fn runtime_write_all(stream: u32, data: u8*, length: usize): bool;

// Shared fixture diagnostics use the existing portable runtime output binding.
export fn driver_platform_write(fd: i32, data: u8*, length: usize): void {
    runtime_write_all(convert(u32, fd), data, length);
}

export fn __main_argc_argv(argc: i32, argv: u8**): i32 {
    var file = fopen("foundation.tower", "rb");
    execution_check(file != null, "open bundled Foundation");
    var grammar: ByteBuffer;
    fill(&grammar, 0, sizeof(ByteBuffer));
    var chunk: u8[4096];
    while feof(file) == 0 {
        var count = fread(&chunk[0], 1, 4096, file);
        execution_check(ferror(file) == 0 && (count != 0 || feof(file) != 0), "read bundled Foundation");
        execution_check(bytes_append(&grammar, &chunk[0], count), "grammar storage");
    }
    execution_check(fclose(file) == 0 && host_text_terminate(&grammar), "close and terminate grammar snapshot");
    var result: SyntaxVersionDiagnostic = default;
    defer syntax_version_diagnostic_dispose(&result);
    syntax_host_install(compiler_host_world(), grammar.data, true, &result);
    var data = syntax_version_diagnostic_text(&result);
    if data[0] != 0 { execution_error("Foundation setup: ", data); }
    execution_check(data[0] == 0, "install bundled Foundation");
    bytes_dispose(&grammar);
    var modules = frontend_modules_create();
    execution_tests(modules);
    frontend_modules_destroy(modules);
    return 0;
}
