import tower;
import backend_source_test;

export fn backend_source_world_tests_runtime(bedrock: u8*, foundation: u8*, runtime: u8*, runtime_size: usize): i32 {
    return backend_source_world_cases(bedrock, foundation, runtime, runtime_size);
}

export fn backend_source_tests_runtime(environment: void*, runtime: u8*, runtime_size: usize): i32 {
    return backend_source_environment_cases(environment, runtime, runtime_size);
}
