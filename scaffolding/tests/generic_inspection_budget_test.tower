import tower;
import generic_inspection_budget;
import frontend_units;
import .compiler.completion_types;
import .compiler.format_api;
import .compiler.format_types;
import .library.vector;
import .library.work_budget;
import .library.work_budget_types;
import .library.work_pool;

// Keep the successful document alive, then deny its actual inspection producer.
// Checked registry/stage admission now precedes the expression clone. Denying
// all remaining capacity must report that first owner, not a later expression.
fn generic_inspection_late(query: void*, budget: WorkBudget*): void {
    var q = bits(CompletionQuery*, query);
    units_check(q.generic_info != null && q.program.resource.error == WorkBudgetError.None,
        "Late inspection begins on a successfully checked generic document");
    var expected_offset = sem_get(q.program.root).start;
    var store = compiler_world_store(q.world);
    var nodes = entity_store_count(store);
    var components = entity_store_component_count(store);
    var before: WorkBudgetSnapshot = default;
    var occupied: WorkReservation = default;
    units_check(work_budget_snapshot(budget, &before) && before.used_bytes < before.bytes
        && work_budget_reserve_result(budget, 0, 0, before.bytes - before.used_bytes, &occupied) == WorkBudgetError.None,
        "Late inspection pressure starts after parsing, checking and initial inspection");
    var accepted = language_document_inspect(q, true);
    var rejected = !accepted && q.generic_info == null && q.resource_error == WorkBudgetError.Capacity
        && q.program.resource.error == WorkBudgetError.Capacity
        && q.program.resource.offset == expected_offset
        && entity_store_count(store) == nodes && entity_store_component_count(store) == components
        && q.context.queries.running == 0 && q.context.workers.running == 0;
    if !rejected {
        var text: FormatResult = default;
        defer format_dispose(&text);
        var f: FormatEngine = {result: &text, ..default};
        format_text(&f, "Late inspection accepted=");
        format_unsigned(&f, accepted ? 1 : 0);
        format_text(&f, " query_error=");
        format_unsigned(&f, convert(u64, q.resource_error));
        format_text(&f, " program_error=");
        format_unsigned(&f, convert(u64, q.program.resource.error));
        format_text(&f, " offset=");
        format_unsigned(&f, convert(u64, q.program.resource.offset));
        format_text(&f, " expected_offset=");
        format_unsigned(&f, convert(u64, expected_offset));
        units_check(!text.failed && vector_push(&text.text, 0), "Late inspection receipt diagnostic");
        puts(text.text.data);
    }
    units_check(rejected, "The actual inspection registry rejects its first denied phase without partial metadata or live work");
    units_check(language_document_result(query) == null,
        "A late producer failure cannot expose the prior successful document output");
    var failed_nodes = entity_store_count(store);
    var failed_components = entity_store_component_count(store);
    units_check(work_budget_release_result(budget, &occupied) == WorkBudgetError.None,
        "Release late pressure before checking that the failed phase cannot replay");
    q.program.error.length = 0;
    units_check(!language_document_inspect(q, true) && q.generic_info == null
        && q.resource_error == WorkBudgetError.Capacity && q.program.resource.error == WorkBudgetError.Capacity
        && q.program.resource.offset == expected_offset
        && entity_store_count(store) == failed_nodes && entity_store_component_count(store) == failed_components
        && q.context.queries.running == 0 && q.context.workers.running == 0,
        "Cleared diagnostics do not replay or erase the late producer failure");
}

// Exercise the public inspection service, including its cached import path.
// A resource failure must not become a successful partial editor query.
fn generic_inspection_budget_trial(root: u8*, width: u32, workers: usize): bool {
    var bedrock: vector(u8) = default;
    var foundation: vector(u8) = default;
    units_read(root, "/bedrock.tower", &bedrock);
    units_read(root, "/foundation.tower", &foundation);
    var gate = work_signal_open();
    units_check(gate != null, "Inspection budget gate");
    work_signal_post(gate);
    var budget: WorkBudget = default;
    units_check(work_budget_init(&budget, workers, GenericInspectionBudgetBytes, 1)
        && work_budget_synchronize(&budget, gate, work_signal_wait, work_signal_post), "Inspection shared budget");
    var world = compiler_world_create_workers(workers);
    units_check(world != null && compiler_world_bind_budget(world, &budget), "Inspection frozen world budget");
    var environment = frontend_modules_create();
    units_check(environment != null && frontend_modules_bind_world(environment, world), "Inspection environment world");
    frontend_modules_configure(environment, "generic_inspection.tower", root);
    generic_inspection_baseline(world, environment, bedrock.data, false);
    generic_inspection_baseline(world, environment, foundation.data, true);
    var source: u8* = "import tower; fn inspect(T:type, callback:function(i32,i32)):i32{return 1 + 2;}";
    var query = language_document_world(world, environment, source, strlen(source), 0, width);
    units_check(query != null, "Inspection setup query");
    var output = language_document_result(query);
    units_check(output != null, "Successful inspection setup exposes its document output");
    if strstr(output, "\"complete\":true") == null { puts(output); }
    units_check(strstr(output, "\"complete\":true") != null && strstr(output, "function template") != null,
        "Inspection fixture is a valid complete generic document before denial");
    generic_inspection_late(query, &budget);
    completion_dispose(query);
    var before: WorkBudgetSnapshot = default;
    units_check(work_budget_snapshot(&budget, &before) && before.used_bytes < before.bytes,
        "Inspection setup retains space for an explicit denial reservation");
    var occupied: WorkReservation = default;
    units_check(work_budget_reserve(&budget, 0, 0, before.bytes - before.used_bytes, &occupied),
        "Inspection denial begins only after the successful setup query");
    query = language_document_world(world, environment, source, strlen(source), 0, width);
    var rejected = query == null;
    if query != null {
        puts("Resource-denied inspection returned a partial query:");
        var partial = language_document_result(query);
        if partial != null { puts(partial); }
        completion_dispose(query);
    }
    units_check(work_budget_release(&budget, &occupied), "Release inspection denial occupancy");
    query = language_document_world(world, environment, source, strlen(source), 0, width);
    units_check(query != null && strstr(language_document_result(query), "\"complete\":true") != null,
        "Inspection recovers through the preserved cache after resource denial");
    completion_dispose(query);
    frontend_modules_destroy(environment);
    units_check(frontend_world_clear(world) && compiler_world_dispose(world), "Inspection resource failure releases its world");
    var final: WorkBudgetSnapshot = default;
    units_check(work_budget_snapshot(&budget, &final) && final.live == 0 && final.used_bytes == 0
        && final.used_lanes == 0 && work_budget_dispose(&budget), "Inspection releases every byte and lane grant");
    work_signal_close(gate);
    vector_dispose(&bedrock);
    vector_dispose(&foundation);
    return rejected;
}

fn generic_inspection_budget_tests(root: u8*): void {
    for(var width: u32 = 4; width <= 8; width *= 2) {
        for(var workers: usize = 1; workers <= 4; workers *= 4) {
            units_check(generic_inspection_budget_trial(root, width, workers),
                "Inspection resource failure never becomes successful partial analysis");
        }
    }
}

test() { generic_inspection_budget_tests("scaffolding"); }
