import tower;

extern fn puts(text: u8*): i32;

extern fn atoi(text: u8*): i32;

extern fn strcmp(left: u8*, right: u8*): i32;

fn runtime_abi_benchmark(): i32 {
    var pointers: u8*[64];
    var sum: u64 = 0;
    var round: usize = 0;
    while round < 10000 {
        var i: usize = 0;
        while i < 64 {
            var size = i *17;
            size = size + 1;
            var pointer = alloc(u8, size);
            var failed = pointer == null;
            if failed {
                return 11;
            }
            pointers[i] = pointer;
            pointer[0] = convert(u8, i);
            i = i + 1;
        }
        i = 0;
        while i < 64 {
            var pointer = pointers[i];
            sum = sum + convert(u64, pointer[0]);
            free(pointer);
            i = i + 1;
        }
        round = round + 1;
    }
    var failed = sum != 20160000;
    if failed {
        return 12;
    }
    return 0;
}

// Linked against the production runtime object, with no test allocator bridge.
export fn runtime_abi_tests(): i32 {
    var maximum: usize = 0;
    maximum = maximum - 1;
    var rejected = alloc(u64, maximum);
    var bad = rejected != null;
    if bad {
        return 1;
    }
    var empty = alloc(u8, 0);
    bad = empty != null;
    if bad {
        return 2;
    }
    free(empty);
    var size: usize = 1;
    while size <= 257 {
        var data = alloc(u8, size);
        bad = data == null;
        if bad {
            return 3;
        }
        var address = bits(usize, data);
        var remainder = address % 16;
        bad = remainder != 0;
        if bad {
            return 4;
        }
        fill(data, 173, size);
        var wide = bits(u64*, data);
        var failed = realloc(u64, wide, maximum);
        bad = failed != null;
        if bad {
            return 5;
        }
        var grown = size + 513;
        var next = realloc(u8, data, grown);
        bad = next == null;
        if bad {
            return 6;
        }
        var i: usize = 0;
        while i < size {
            bad = next[i] != 173;
            if bad {
                return 7;
            }
            i = i + 1;
        }
        var target = alloc(u8, grown);
        bad = target == null;
        if bad {
            return 8;
        }
        copy(target, next, size);
        bad = target[0] != 173;
        if bad {
            return 9;
        }
        next = realloc(u8, next, 0);
        bad = next != null;
        if bad {
            return 10;
        }
        free(target);
        size = size + 1;
    }
    puts("Tower production runtime ABI passed");
    return 0;
}

export fn main(argc: i32, argv: u8**): i32 {
    if argc > 1 {
        if strcmp(argv[1], "--benchmark") == 0 {
            return runtime_abi_benchmark();
        }
        var divisor = atoi(argv[1]);
        var quotient = 7 / divisor;
        return quotient;
    }
    return runtime_abi_tests();
}

export fn __main_argc_argv(argc: i32, argv: u8**): i32 {
    return main(argc, argv);
}
