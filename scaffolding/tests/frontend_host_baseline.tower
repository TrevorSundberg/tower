import tower;
import .host.syntax_baseline_api;
import .compiler.format_types;
import .compiler.component_kinds;
import frontend_world;
import frontend_baselines;
import utility_checks;

extern fn compiler_world_type_existing(world: void*, kind: u32): void*;
extern fn strcmp(a: u8*, b: u8*): i32;
extern fn strlen(text: u8*): usize;
extern fn memcmp(a: u8*, b: u8*, length: usize): i32;

fn frontend_host_baseline_tests(): void {
    var buffers = tower_test_buffer_count();
    var first = compiler_world_create();
    var second = compiler_world_create();
    var fresh = compiler_world_create();
    utility_check(frontend_world_clear(fresh) && compiler_world_type_existing(fresh, CompilerSyntax) is null,
        "clearing a fresh world does not register syntax transport");
    utility_check(compiler_world_dispose(fresh), "dispose empty world");
    var seed = syntax_host_seed(first);
    var other_seed = syntax_host_seed(second);
    utility_check(seed != other_seed && strcmp(seed, other_seed) == 0, "seed text has independent world ownership");
    utility_check(compiler_world_type_existing(first, CompilerFoundation) is null, "seed formatting does not register Foundation");
    var formatted: FormatResult = default;
    format_entity(&formatted, frontend_world_bedrock(first), null, null, null);
    utility_check(!formatted.failed && strlen(seed) == formatted.text.length && memcmp(seed, formatted.text.data, formatted.text.length) == 0,
        "seed uses the shared canonical formatter and adds a terminator");
    format_dispose(&formatted);
    var allocation_count = tower_test_buffer_allocations();
    utility_check(syntax_host_seed(first) == seed && tower_test_buffer_allocations() == allocation_count, "seed query reuses immutable text");
    var first_source: u8* = "parse Statement = 'x';";
    var second_source: u8* = "parse Statement = 'y';";
    utility_check(syntax_host_set(first, first_source, strlen(first_source), true, null)[0] == 0, "install first world baseline");
    utility_check(syntax_host_set(second, second_source, strlen(second_source), true, null)[0] == 0, "install second world baseline");
    utility_check(syntax_world_matches(first, first_source, strlen(first_source), true) &&
        syntax_world_matches(second, second_source, strlen(second_source), true), "baseline independence");
    var invalid: u8* = "parse Statement = (";
    utility_check(syntax_host_set(first, invalid, strlen(invalid), true, null)[0] != 0, "baseline syntax diagnostic");
    utility_check(syntax_world_matches(first, first_source, strlen(first_source), true), "invalid update is atomic");
    var foundation_error = syntax_host_set(first, null, 0, true, null);
    utility_check(strcmp(foundation_error, "Bootstrap must be at most 64 KiB without NUL bytes") == 0, "null bootstrap diagnostic");
    var bedrock_error = syntax_host_set(first, "", 65537, false, null);
    utility_check(strcmp(bedrock_error, "Bedrock must be at most 64 KiB without NUL bytes") == 0 &&
        strcmp(foundation_error, "Bootstrap must be at most 64 KiB without NUL bytes") == 0, "separate borrowed diagnostic lifetimes");
    var nul: u8[3]; nul[0] = 120; nul[1] = 0; nul[2] = 121;
    utility_check(syntax_host_set(first, &nul[0], 3, true, null)[0] != 0, "embedded NUL rejected");
    utility_check(syntax_host_set(first, first_source, strlen(first_source), true, null)[0] == 0,
        "idempotent success clears prior fallback diagnostics");
    var slot = syntax_host_environment(first);
    var borrowed = compiler_world_store(second);
    // Invalid input never dereferences the borrowed context, but still selects
    // it before validation, matching the published bootstrap transport contract.
    syntax_host_set(first, null, 0, true, borrowed);
    utility_check(*slot == borrowed && *syntax_host_environment(second) is null, "environment selection is world-local");
    *slot = null;
    var view = entity_view_open(frontend_world_bedrock(first));
    utility_check(view is not null && !frontend_world_clear(first) && syntax_host_seed(first) == seed,
        "pinned readers reject cleanup without invalidating borrowed seed");
    entity_view_close(view);
    utility_check(frontend_world_clear(first) && compiler_world_dispose(first), "dispose first world transport and caches");
    utility_check(strcmp(other_seed, syntax_host_seed(second)) == 0, "other world survives cleanup");
    utility_check(frontend_world_clear(second) && compiler_world_dispose(second), "dispose second world transport and caches");
    utility_check(tower_test_buffer_count() == buffers, "all world-owned baseline transport buffers released");
}
