import tower;
import .library.entities;
import .library.entity_types;
import .library.entity_stage;
import .library.work_budget;
import .library.work_budget_types;
import .host.memory;
import entity_fault_accounting;

extern fn tower_test_buffer_count(): usize;
extern fn tower_test_buffer_allocations(): usize;
extern fn tower_test_buffer_fail_after(count: usize): void;
extern fn puts(text: u8*): i32;
extern fn fflush(stream: void*): i32;
extern fn printf(format: u8*, value: usize): i32;
var StageFaultBudgetBytes: usize = 1048576;
var StageFaultLifecycle: usize = 1;
struct StageFaultPayload { target: Entity*; value: usize; }
struct StageFaultState { finalized: usize; }
fn stage_fault_check(ok: bool): void {
    if !ok { trap("Typed stage/view allocation failure regression", 0); }
}
export fn tower_entity_finalize(lifecycle: usize, component: EntityComponent*, data: u8*): void {
    stage_fault_check(lifecycle == StageFaultLifecycle);
    bits(StageFaultState*, entity_context(component.owner)).finalized++;
    var payload = bits(StageFaultPayload*, data);
    if payload.target != null { entity_release(payload.target); }
}

fn stage_fault_open(): void {
    var baseline = tower_test_buffer_count();
    var store = entity_store_create();
    var root = entity_create(store);
    stage_fault_check(store != null && root != null);
    var live = tower_test_buffer_count();
    var error = WorkBudgetError.None;
    tower_test_buffer_fail_after(0);
    stage_fault_check(entity_stage_open_result(null, &error) == null && error == WorkBudgetError.Invalid);
    stage_fault_check(entity_stage_open_result(root, &error) == null && error == WorkBudgetError.Memory);
    tower_test_buffer_fail_after(0);
    stage_fault_check(entity_view_open_result(null, &error) == null && error == WorkBudgetError.Invalid);
    stage_fault_check(entity_view_open_result(root, &error) == null && error == WorkBudgetError.Memory);
    tower_test_buffer_fail_after(~convert(usize, 0));
    stage_fault_check(tower_test_buffer_count() == live && root.references == 1 && store.views == 0);
    var stage = entity_stage_open_result(root, &error);
    stage_fault_check(stage != null && error == WorkBudgetError.None);
    var view = entity_view_open_result(root, &error);
    stage_fault_check(view != null && error == WorkBudgetError.None);
    entity_view_close(view);
    entity_stage_discard(stage);
    entity_release(root);
    stage_fault_check(entity_store_dispose(store) && tower_test_buffer_count() == baseline);
}

fn stage_fault_lease(failure: usize, allocations: usize*): bool {
    printf("lease trial failure=%zu\n", failure); fflush(null);
    var baseline = tower_test_buffer_count();
    var store = entity_store_create();
    var root = entity_create(store);
    var node = entity_create(store);
    var stage = entity_stage_open(root);
    stage_fault_check(store != null && root != null && node != null && stage != null);
    var live = tower_test_buffer_count();
    var before = tower_test_buffer_allocations();
    tower_test_buffer_fail_after(failure);
    var result = entity_stage_lease_result(stage, node);
    tower_test_buffer_fail_after(~convert(usize, 0));
    *allocations = tower_test_buffer_allocations() - before;
    var succeeded = result == WorkBudgetError.None;
    if !succeeded {
        stage_fault_check(result == WorkBudgetError.Memory && node.stage == null && node.storage == null
            && stage.leases.data == null && stage.leases.length == 0 && stage.leases.capacity == 0
            && tower_test_buffer_count() == live);
        result = entity_stage_lease_result(stage, node);
    }
    stage_fault_check(result == WorkBudgetError.None && stage.leases.length == 1);
    before = tower_test_buffer_allocations();
    tower_test_buffer_fail_after(0);
    stage_fault_check(entity_stage_lease_result(stage, node) == WorkBudgetError.None
        && entity_stage_lease(stage, node) && tower_test_buffer_allocations() == before);
    tower_test_buffer_fail_after(~convert(usize, 0));
    entity_stage_discard(stage);
    stage_fault_check(node.stage == null && node.storage == null);
    entity_release(node); entity_release(root);
    stage_fault_check(entity_store_dispose(store) && tower_test_buffer_count() == baseline);
    return succeeded;
}

fn stage_fault_payload(stage: EntityStage*, node: Entity*, type: Entity*, target: Entity*): EntityComponent* {
    var component = entity_component_add(node, type);
    stage_fault_check(component != null);
    var payload = bits(StageFaultPayload*, component.data);
    *payload = default;
    payload.value = 4567;
    stage_fault_check(entity_stage_references(stage, &target, 1));
    payload.target = target;
    return component;
}

fn stage_fault_publish(failure: usize, allocations: usize*): bool {
    printf("publish trial failure=%zu\n", failure); fflush(null);
    var baseline = tower_test_buffer_count();
    var budget: WorkBudget = default;
    stage_fault_check(work_budget_init(&budget, 1, StageFaultBudgetBytes, 1));
    var store: EntityStore* = null;
    stage_fault_check(entity_store_create_result(&budget, &store) == WorkBudgetError.None);
    var state: StageFaultState = default;
    stage_fault_check(entity_store_set_context(store, bits(void*, &state)));
    var root = entity_create(store);
    var existing = entity_create(store);
    var first_type = entity_create(store);
    var type = entity_create(store);
    var target = entity_create(store);
    stage_fault_check(root != null && existing != null && first_type != null && type != null && target != null
        && entity_attach(existing, root, "existing")
        && entity_register(first_type, sizeof(usize), alignof(usize), 0)
        && entity_register(type, sizeof(StageFaultPayload), alignof(StageFaultPayload), StageFaultLifecycle));
    entity_release(existing);
    var stable = entity_component_add(existing, first_type);
    stage_fault_check(stable != null);
    *bits(usize*, stable.data) = 9876;
    var table = existing.table;
    var error = WorkBudgetError.None;
    var stage = entity_stage_open_result(root, &error);
    stage_fault_check(stage != null && error == WorkBudgetError.None && entity_stage_lease(stage, existing));
    var fresh = entity_stage_create_named(stage, root, "fresh");
    stage_fault_check(fresh != null);
    var fresh_component = stage_fault_payload(stage, fresh, type, target);
    var leased_component = stage_fault_payload(stage, existing, type, target);
    var expected_finalizers = stage.nodes.length + stage.leases.length;
    var address = leased_component.data;
    var roots: Entity*[4]; roots[0] = root; roots[1] = first_type; roots[2] = type; roots[3] = target;
    var root_count = sizeof(decltype(roots)) / sizeof(Entity*);
    entity_fault_census(store, &roots[0], root_count, stage);
    var entities = store.entity_count;
    var components = store.component_count;
    var identity = store.next_id;
    var before = tower_test_buffer_allocations();
    tower_test_buffer_fail_after(failure);
    var result = entity_stage_publish_result(stage);
    tower_test_buffer_fail_after(~convert(usize, 0));
    *allocations = tower_test_buffer_allocations() - before;
    var succeeded = result == WorkBudgetError.None;
    if !succeeded {
        stage_fault_check(result == WorkBudgetError.Memory && root.child_count == 1 && stage.held == 0
            && target.references == 1 && type.instance_count == 0 && store.entity_count == entities
            && store.component_count == components && store.next_id == identity && fresh.id == 0
            && existing.table == table && existing.pending_table == null && fresh.pending_table == null
            && existing.stage == bits(void*, stage) && fresh.stage == bits(void*, stage)
            && fresh.components[0] == fresh_component && existing.components[0] == stable
            && leased_component.data == address && *bits(usize*, stable.data) == 9876
            && bits(StageFaultPayload*, address).value == 4567 && state.finalized == 0);
        // Preparation retains checked index capacity but publishes no members,
        // references or table reservations. Account every surviving physical
        // owner instead of assuming that capacity growth allocated nothing.
        var census = entity_fault_census(store, &roots[0], root_count, stage);
        stage_fault_check(tower_test_buffer_count() == baseline + census.receipts
            + (budget.entries.data != null ? 1 : 0));
        result = entity_stage_publish_result(stage);
    }
    stage_fault_check(result == WorkBudgetError.None && fresh.components[0] == fresh_component
        && existing.stage == null && fresh.stage == null && root.child_count == 2
        && type.instance_count == expected_finalizers && target.references == 1 + expected_finalizers
        && leased_component.data == address && *bits(usize*, stable.data) == 9876
        && bits(StageFaultPayload*, address).value == 4567 && state.finalized == 0);
    // Publication transfers private pages/names and frees stage vectors and its
    // descriptor. Success need not retain the pre-publication byte/receipt sum.
    var census = entity_fault_census(store, &roots[0], root_count, null);
    stage_fault_check(tower_test_buffer_count() == baseline + census.receipts
        + (budget.entries.data != null ? 1 : 0));
    entity_release(target); entity_release(type); entity_release(first_type); entity_release(root);
    stage_fault_check(state.finalized == expected_finalizers && store.entity_count == 0
        && store.component_count == 0 && entity_store_dispose(store)
        && budget.used_bytes == 0 && budget.live == 0 && budget.used_lanes == 0 && work_budget_dispose(&budget)
        && tower_test_buffer_count() == baseline);
    return succeeded;
}

export fn main(argc: i32, argv: u8**): i32 {
    stage_fault_open();
    var allocations: usize = 0;
    stage_fault_check(stage_fault_lease(~convert(usize, 0), &allocations) && allocations != 0);
    var observed: usize = 0;
    for(var failure: usize = 0; failure < allocations; failure++) {
        stage_fault_check(!stage_fault_lease(failure, &observed));
    }
    stage_fault_check(stage_fault_lease(allocations, &observed) && observed == allocations);
    stage_fault_check(stage_fault_publish(~convert(usize, 0), &allocations) && allocations != 0);
    for(var failure: usize = 0; failure < allocations; failure++) {
        stage_fault_check(!stage_fault_publish(failure, &observed));
    }
    stage_fault_check(stage_fault_publish(allocations, &observed) && observed == allocations);
    puts("0");
    return 0;
}
