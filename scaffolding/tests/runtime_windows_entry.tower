import tower;
import runtime_abi;

extern fn ExitProcess(code: u32): void;

// The upstream UCRT DLL owns its own initialization. This fixture tests the
// production Tower runtime ABI on Windows without a project-owned C startup.
export fn mainCRTStartup(): void {
    var status = runtime_abi_tests();
    ExitProcess(convert(u32, status));
}
