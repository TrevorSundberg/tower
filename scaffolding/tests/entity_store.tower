import tower;
import entity_store_cases_test;

// The native ABI caller and the component store share an address space.
export fn entity_payload_write(data: u8*, value: u32): void { *bits(u32*, data) = value; }
export fn entity_payload_read(data: u8*): u32 { return *bits(u32*, data); }

export fn entity_store_tests(): void { entity_store_native_checks(); }
