import tower;
import body_runs;
import frontend_units;
import execution_support;
import execution_core;
import struct_value_checks;
import named_initialization_checks;
import .compiler.execution_session;
import .compiler.foundation_tags;
import .library.vector;

fn known_binding_tests(modules: void*, root: u8*): void {
    var source: vector(u8) = default;
    var bedrock: vector(u8) = default;
    var foundation: vector(u8) = default;
    defer vector_dispose(&source);
    defer vector_dispose(&bedrock);
    defer vector_dispose(&foundation);
    units_read(root, "/tests/known_bindings.tower", &source);
    units_read(root, "/bedrock.tower", &bedrock);
    units_read(root, "/foundation.tower", &foundation);
    var library: vector(u8) = default;
    defer vector_dispose(&library);
    units_read(root, "/tests/known_binding_library.tower", &library);
    var library_session: ExecutionSession = default;
    defer execution_session_close(&library_session);
    execution_compile(&library_session, library.data, 8, modules);
    foreach(var item in &sem_get(library_session.program.root).items) {
        var kind = sem_get(item).kind;
        execution_check(kind == KFunction || kind == KType, "Fixed library values leave no runtime initialization");
    }
    execution_roundtrip(&library_session, modules, false);
    var cycle: ExecutionSession = default;
    defer execution_session_close(&cycle);
    execution_compile(&cycle, "import tests.known_cycle_a;print(cycle_total());", 8, modules);
    execution_check(execution_session_start(&cycle), "Cyclic modules with fixed values start");
    execution_run(&cycle, 1000, 100000);
    execution_check(cycle.machine.done && cycle.error.length == 0 && execution_text(&cycle.output, "42\n"), "Cyclic module values retain bindings");
    execution_roundtrip(&cycle, modules, false);
    struct_value_reject(modules, "import tests.known_cycle_bad_a;", "Import cycle requires fixed compile-time");
    for(var width: u32 = 4; width <= 8; width += 4) {
        var graph: ExecutionSession = default;
        var fast: ExecutionSession = default;
        execution_compile(&graph, source.data, width, modules);
        execution_compile(&fast, source.data, width, modules);
        execution_check(execution_session_start(&graph) && execution_session_fast(&fast), "Known binding engines start");
        execution_run(&graph, 1000, 100000);
        execution_run(&fast, 1000, 100000);
        execution_same(&graph, &fast);
        execution_check(graph.machine.done && graph.error.length == 0 && execution_text(&graph.output, "0\n"), "Known binding execution");
        execution_roundtrip(&graph, modules, false);
        execution_session_close(&graph);
        execution_session_close(&fast);
        var canonical: vector(u8) = default;
        defer vector_dispose(&canonical);
        for(var workers: usize = 1; workers <= 8; workers *= 2) {
            body_runs_trial(source.data, workers, width, bedrock.data, foundation.data, root, &canonical);
        }
    }
    struct_value_reject(modules, "import tower;var value=1;value++;print(comptime(value));", "cannot capture runtime storage");
    struct_value_reject(modules, "import tower;var value=1;var pointer=&value;print(comptime(value));", "cannot capture runtime storage");
    struct_value_reject(modules, "import tower;var value=1;fn change():void{value=2;}print(comptime(value));", "cannot capture runtime storage");
    struct_value_reject(modules, "import tower;var count=0;fn effect():i32{count++;return 4;}var fixed=effect();print(comptime(fixed));", "Compile-time input failed");
    struct_value_reject(modules, "import tower;fn address():usize{var x=1;return bits(usize,&x);}var fixed=address();print(comptime(fixed));", "Compile-time input failed");
    struct_value_reject(modules, "import tower;fn equal():bool{var a=1;var b=2;return &a == &b;}var fixed=equal();print(comptime(fixed));", "Compile-time input failed");
    struct_value_reject(modules, "import tower;fn read():i32{return later;}var earlier=read();var later=7;print(comptime(later));", "cannot capture runtime storage");
    struct_value_reject(modules, "import tower;var a:i32=comptime(b);var b:i32=a;print(a);", "dependency cycle");
    struct_value_reject(modules, "import tower;const old:i32=1;", "before 'old'");
    named_initialization_diagnostic("import tower;var value=1;value++;fn first():i32{return comptime(value);}fn later():i32{return 2;}", "cannot capture runtime storage", bedrock.data, foundation.data, root);
    puts("Known bindings: separate immutability/staging, effects, Foundation and worker determinism pass.");
}
