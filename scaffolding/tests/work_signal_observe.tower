import tower;
import work_signal_observe_test;

extern fn strcmp(left: u8*, right: u8*): i32;

fn main(argc: i32, argv: u8**): i32 {
    if argc != 2 { return 2; }
    var polling = strcmp(argv[1], "try") == 0;
    if !polling && strcmp(argv[1], "wait") != 0 { return 2; }
    return observe_signal(polling);
}
