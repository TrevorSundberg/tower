import compound_operators;
import library.testing;

test() {
    var left: i32 = -17;
    var right: i32 = 3;
    var binary_result = left + right;
    var trace = 0;
    *destination(&left, &trace) += operand(right, &trace);
    assert(left == binary_result, "+= result");
    assert(trace == 12, "+= operand evaluation");
}

test() {
    var left: i32 = -17;
    var right: i32 = 3;
    var binary_result = left -right;
    var trace = 0;
    *destination(&left, &trace) -= operand(right, &trace);
    assert(left == binary_result, "-= result");
    assert(trace == 12, "-= operand evaluation");
}

