// Complete semantic-field/edge fingerprints, updated for ECS query ownership and
// explicit target widths. Every fixture still emits byte-identical Foundation
// to the published fb1ab1 bootstrap at both widths; runtime/round-trip checks
// remain below the fingerprint assertion. Derived ownership changes traversal IDs.
// Body-demand metadata adds one nonsemantic owned leaf. An audit matched every
// previous field/edge fingerprint with exactly that leaf excluded before updating
// these complete-tree values; normal assertions continue to include all nodes.
fn execution_semantic_integer_hash(index: usize, width: u32): u64 {
    if index == 0 { return width == 4 ? 9907626596609923109 : 5755149552227688041; }
    if index == 1 { return width == 4 ? 13795788637318273057 : 9261907403721142581; }
    if index == 2 { return width == 4 ? 16828665200364049160 : 6485169487827537940; }
    if index == 3 { return width == 4 ? 1712164860042399604 : 16139311027602897620; }
    if index == 4 { return width == 4 ? 8787359286693646892 : 9226013935365938988; }
    if index == 5 { return width == 4 ? 870611764444708035 : 9492916861103453079; }
    if index == 6 { return width == 4 ? 2834933432949767831 : 9932010356858770319; }
    if index == 7 { return width == 4 ? 18157064825486467059 : 6601247832038724147; }
    if index == 8 { return width == 4 ? 8044417266030399875 : 336083990335596555; }
    if index == 9 { return width == 4 ? 2902914094115701703 : 7856633767709365227; }
    if index == 10 { return width == 4 ? 3575171273152446599 : 6352894962340042243; }
    if index == 11 { return width == 4 ? 4110405034519070419 : 597253792722484995; }
    return 0;
}

