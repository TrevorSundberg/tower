import tower;
// Fixtures retained from the native semantic port oracle.
fn execution_semantic_valid(index: usize): u8* {
    if index == 0 { return "             \n\n// Forward module bindings and effects retain source order.\nlater = 0;\nvar result = twice(later);\nvar later: i32 = 21;\nprint(result);\nprint(twice(later));\n\nfn twice(value: i32): i32 {\n    var doubled = value + value;\n    return doubled;\n}\n\n// Layout is explicit for the selected pointer width.\nstruct Record {\n    tag: u8;\n    pointer: i32*;\n    values: i32[3];\n}\n\nvar record: Record;\nrecord.tag = 7;\nrecord.values[2] = 42;\nprint(record.tag);\nprint(record.values[2]);\nprint(sizeof(Record));\nprint(alignof(Record));\n\n// Type constructors preserve nominal instance identity and recursive pointers.\nfn box(T: type): type {\n    struct Box {\n        value: T;\n        next: Box*;\n    }\n    return Box;\n}\n\nfn identity(T: type, value: T): T {\n    return value;\n}\n\nvar item: box(i32);\nitem.value = identity(i32, 42);\nitem.next = null;\nprint(item.value);\n\n// Lexical scopes, early returns, loop control and signed literal bounds.\nfn choose(value: i32): i32 {\n    loop {\n        var positive = value > 0;\n        if positive {\n            return value;\n        }\n        break;\n    }\n    return -2147483648;\n}\n\nprint(choose(3));\nprint(choose(0));\n"; }
    if index == 1 { return "var `odd name`: i32 = 42; print(`odd name`);"; }
    if index == 2 { return "fn f(x: i32): i32 { var z = x; var a = z; { var z = a; print(z); } return a; } print(f(42));"; }
    if index == 3 { return "struct A { b: B; } struct B { value: u64; } var a: A; a.b.value = 42; print(a.b.value);"; }
    if index == 4 { return "fn arr(T: type, n: usize): type { return T[n]; } var a: arr(i32, 3); a[2] = 42; print(a[2]);"; }
    if index == 5 { return "fn alias(T: type): type { return T; } var a: alias(i32) = 42; print(a);"; }
    if index == 6 { return "var p = alloc(i32, 2); p[1] = 42; var q = p + 1; print(*q); p = realloc(i32, p, 3); free(p);"; }
    if index == 7 { return "var p: u8* = null; var q: u8* = null; var same = p == q; print(same);"; }
    if index == 8 { return "fn f(): i32 { if true { return 1; } } print(f());"; }
    if index == 9 { return "var a: u8[3]; fill(&a, 7, 3); var b: u8[3]; copy(&b, &a, 3); print(b[2]);"; }
    if index == 10 { return "var a: u64 = 18446744073709551615; var b: i64 = -9223372036854775808; print(a); print(b);"; }
    if index == 11 { return "fn f(): void { loop { if false { continue; } break; } return; } f();"; }
    return null;
}
fn execution_semantic_invalid(index: usize): u8* {
    if index == 0 { return "var a: Mystery;"; }
    if index == 1 { return "var a: void;"; }
    if index == 2 { return "var a: i32; var a: i32;"; }
    if index == 3 { return "var a = b; var b = a;"; }
    if index == 4 { return "var a = a;"; }
    if index == 5 { return "var a = f(); fn f(): void {}"; }
    if index == 6 { return "fn f(): i32 {}"; }
    if index == 7 { return "break;"; }
    if index == 8 { return "continue;"; }
    if index == 9 { return "fn f(a: i32): void {} f(true);"; }
    if index == 10 { return "fn f(): void {} f(1);"; }
    if index == 11 { return "unknown();"; }
    if index == 12 { return "print();"; }
    if index == 13 { return "struct A { a: void; }"; }
    if index == 14 { return "var a: i32[0];"; }
    if index == 15 { return "var a: i32[1048577];"; }
    if index == 16 { return "var a: void[1];"; }
    if index == 17 { return "var a: i32[1048576][2];"; }
    if index == 18 { return "var a: u8 = 256;"; }
    if index == 19 { return "var a: u64 = -1;"; }
    if index == 20 { return "var a: i64 = 9223372036854775808;"; }
    if index == 21 { return "var a: i32 = true;"; }
    if index == 22 { return "var a: i32 = null;"; }
    if index == 23 { return "var a: bool = 1;"; }
    if index == 24 { return "var a: i32; print(a.no);"; }
    if index == 25 { return "struct A { a: i32; } var a: A; print(a.no);"; }
    if index == 26 { return "var a: i32; print(a[0]);"; }
    if index == 27 { return "var a: void*; print(a[0]);"; }
    if index == 28 { return "var a: i32*; print(a[true]);"; }
    if index == 29 { return "var a: i32; print(*a);"; }
    if index == 30 { return "var a: i32; *a = 1;"; }
    if index == 31 { return "print(alloc(void, 1));"; }
    if index == 32 { return "free(1);"; }
    if index == 33 { return "var a: i32; copy(&a, 1, 4);"; }
    if index == 34 { return "var a: i32; print(convert(usize, &a));"; }
    if index == 35 { return "print(bits(u8, 1));"; }
    if index == 36 { return "print(bits(bool, true));"; }
    if index == 37 { return "var a: void*; a = a + 1;"; }
    if index == 38 { return "var a: bool = true; var b = a + a;"; }
    if index == 39 { return "struct A { a: i32; } var a: A; print(a);"; }
    if index == 40 { return "fn f(): void { return 1; }"; }
    if index == 41 { return "fn f(): i32 { return; }"; }
    if index == 42 { return "fn f(): void { fn g(): void {} }"; }
    if index == 43 { return "fn f(): void { struct S { a: i32; } }"; }
    if index == 44 { return "fn f(a: i32, a: i32): void {}"; }
    if index == 45 { return "fn print(): void {}"; }
    if index == 46 { return "fn f(): void {} fn f(): void {}"; }
    if index == 47 { return "fn f(T: type, T: type): T { return 1; }"; }
    // Inference accepts one runtime argument; zero still tests invalid arity.
    if index == 48 { return "fn f(T: type, v: T): T { return v; } f();"; }
    if index == 49 { return "fn typefn(T: type): type { return T; } print(typefn(i32));"; }
    if index == 50 { return "fn bad(T: type): type { return bad(T); } var a: bad(i32);"; }
    if index == 51 { return "fn bad(T: type): T { return true; } print(bad(i32));"; }
    if index == 52 { return "fn a(T: type, n: bool): type { return T; } var a: a(i32, true);"; }
    return null;
}

// Exact diagnostics validated against the native oracle before its retirement.
fn execution_semantic_message(index: usize): u8* {
    if index == 0 { return "Unknown type 'Mystery'"; }
    if index == 1 { return "A variable cannot have void type"; }
    if index == 2 { return "Duplicate module variable 'a'"; }
    if index == 3 { return "Cannot infer the type of 'a': initializer dependency cycle a -> b -> a; add an explicit type annotation"; }
    if index == 4 { return "Cannot infer the type of 'a': initializer dependency cycle a -> a; add an explicit type annotation"; }
    if index == 5 { return "A void call cannot be used as a value"; }
    if index == 6 { return "Function 'f' can finish without returning a value"; }
    if index == 7 { return "CoreBreak requires an enclosing loop"; }
    if index == 8 { return "CoreContinue requires an enclosing loop"; }
    if index == 9 { return "Expected i32, got bool; use an explicit conversion"; }
    if index == 10 { return "Wrong argument count for 'f'"; }
    if index == 11 { return "Unknown function 'unknown'"; }
    if index == 12 { return "Wrong argument count for 'print': expected 1"; }
    if index == 13 { return "A field cannot have void type"; }
    if index == 14 { return "Array length must be between 1 and 1,048,576"; }
    if index == 15 { return "Array length must be between 1 and 1,048,576"; }
    if index == 16 { return "An array cannot have void elements"; }
    if index == 17 { return "Array storage exceeds 4 MiB"; }
    if index == 18 { return "Integer literal out of range for u8"; }
    if index == 19 { return "Integer literal out of range for u64"; }
    if index == 20 { return "Integer literal out of range for i64"; }
    if index == 21 { return "Expected i32, got bool; use an explicit conversion"; }
    if index == 22 { return "null requires a pointer type"; }
    if index == 23 { return "An integer literal needs an integer type"; }
    if index == 24 { return "Field access requires a struct or a single pointer to a struct"; }
    if index == 25 { return "Unknown field 'no' in 'A'"; }
    if index == 26 { return "Indexing requires a pointer or an array"; }
    if index == 27 { return "Cannot index a void pointer"; }
    if index == 28 { return "Expected usize, got bool; use an explicit conversion"; }
    if index == 29 { return "Load requires a pointer"; }
    if index == 30 { return "Store requires a pointer"; }
    if index == 31 { return "Cannot allocate void elements"; }
    if index == 32 { return "Memory operations require a pointer"; }
    if index == 33 { return "copy requires source and destination pointers"; }
    if index == 34 { return "Pointer reinterpretation requires bits"; }
    if index == 35 { return "bits requires equal-width integers or pointers"; }
    if index == 36 { return "bits requires equal-width integers or pointers"; }
    if index == 37 { return "Cannot offset a void pointer"; }
    if index == 38 { return "This operation requires integer operands"; }
    if index == 39 { return "Struct values require field access or a pointer; aggregate copies are not implemented"; }
    if index == 40 { return "A void function cannot return a value"; }
    if index == 41 { return "A non-void function must return a value"; }
    if index == 42 { return "Functions must be declared at top level"; }
    if index == 43 { return "Struct types must be declared at top level"; }
    if index == 44 { return "Invalid or duplicate function parameter"; }
    if index == 45 { return "Function name 'print' already names a foundation builtin"; }
    if index == 46 { return "Missing or duplicate function 'f'"; }
    if index == 47 { return "Duplicate template parameter 'T'"; }
    if index == 48 { return "Wrong argument count for template 'f'"; }
    if index == 49 { return "Type constructor 'typefn' produces a type, not a runtime value"; }
    if index == 50 { return "Recursive type constructor 'bad' has no concrete struct to resolve\nInstantiated by bad(i32) at line 1, column 49."; }
    if index == 51 { return "Expected i32, got bool; use an explicit conversion\nInstantiated by bad(i32) at line 1, column 43."; }
    if index == 52 { return "Unexpected 'true'. Expected Identifier, Number or '-'."; }
    return null;
}
