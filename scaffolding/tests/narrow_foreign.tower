import tower;

extern fn i8_add(a: i8, b: i8): i8;
extern fn i16_add(a: i16, b: i16): i16;
extern fn u16_add(a: u16, b: u16): u16;

// Both the native companion and the browser call these with the same operands.
fn foreign_i8_sum(): i8 { return i8_add(-120, -7); }
fn foreign_i16_sum(): i16 { return i16_add(-30000, -2000); }
fn foreign_u16_sum(): u16 { return u16_add(60000, 5000); }
