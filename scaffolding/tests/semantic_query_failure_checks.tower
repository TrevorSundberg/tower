import tower;
import semantic_query_failure_checks_test;

extern fn strcmp(left: u8*, right: u8*): i32;

fn semantic_query_failure_tests(argc: i32, argv: u8**): i32 {
    if argc != 2 {
        puts("usage: semantic_query_failure_checks constructor|body|declaration");
        return 1;
    }
    var mode = QueryFailureMode.Constructor;
    if strcmp(argv[1], "body") == 0 { mode = QueryFailureMode.Body; }
    else {
        if strcmp(argv[1], "declaration") == 0 { mode = QueryFailureMode.Declaration; }
        else {
            if strcmp(argv[1], "constructor") != 0 { puts("Unknown query failure selector"); return 1; }
        }
    }
    var failures = query_failure_cases(mode);
    if failures == 0 { puts("Failed semantic dependency requests drain without replay or false progress."); }
    return failures == 0 ? 0 : 1;
}
