extern fn semantic_format_type(type: FoundationType*, text: vector(u8)*): void;

extern fn entity_component_get(node: void*, kind: void*): void*;
extern fn host_json_unsigned(out: ByteBuffer*, value: u64): bool;
extern fn sem_resource_record(program: SemanticProgram*, error: WorkBudgetError, offset: usize): void;

enum ExecutionResourceBoundary: u32 { Compile, Start, Cache, Step }
var ExecutionResourceStepLimit: usize = 10000;

fn execution_resource_trial(modules: void*, width: u32, boundary: ExecutionResourceBoundary,
    resource: WorkBudgetError, diagnostic: u8*): void {
    var source = "import tower; print(7); print(9);";
    var offset = bits(usize, strstr(source, "print(9)")) - bits(usize, source);
    var session: ExecutionSession = default;
    execution_compile(&session, source, width, modules);
    if boundary == ExecutionResourceBoundary.Step {
        execution_check(execution_session_fast(&session), "resource fixture prepares a valid cache");
    }
    var cache = session.fast;
    if diagnostic != null {
        var length = strlen(diagnostic);
        execution_check(vector_reserve(&session.program.error, length + 1), "resource fixture diagnostic");
        copy(session.program.error.data, diagnostic, length + 1);
        session.program.error.length = length;
    }
    sem_resource_record(&session.program, resource, offset);
    sem_resource_record(&session.program, WorkBudgetError.Busy, strlen(source));
    if boundary == ExecutionResourceBoundary.Compile {
        execution_check(execution_session_program_failed(&session), "compile success boundary sees fixed failure");
    }
    if boundary == ExecutionResourceBoundary.Start {
        execution_check(!execution_session_start(&session), "fixed failure refuses graph start");
    }
    if boundary == ExecutionResourceBoundary.Cache {
        execution_check(!execution_session_fast(&session), "fixed failure refuses cache construction");
    }
    execution_session_step(&session, 1);
    execution_check(session.machine.failed && session.machine.done && session.machine.steps == 0
        && session.output.length == 0 && session.fast == cache
        && session.machine.error_offset == offset && session.program.resource.offset == offset
        && session.program.resource.error == resource
        && execution_text(&session.error, diagnostic ?? sem_resource_message(resource)),
        "fixed resource failure keeps first receipt and forbids effects");
    session.error.length = 0;
    session.program.error.length = 0;
    execution_session_fail(&session, "Later unrelated error", strlen(source));
    execution_check(session.error.length == 0 && session.machine.error_offset == offset,
        "later reporting cannot pair a new message with the first failure offset");
    execution_check(!execution_session_start(&session) && !execution_session_fast(&session),
        "clearing diagnostics never recovers a failed session");
    execution_session_step(&session, 1);
    execution_check(session.machine.steps == 0 && session.output.length == 0
        && session.machine.error_offset == offset, "failed session cannot replay after diagnostic clearing");
    execution_close_checked(&session);
    execution_compile(&session, source, width, modules);
    execution_run(&session, 1, ExecutionResourceStepLimit);
    execution_check(!session.machine.failed && execution_text(&session.output, "7\n9\n"),
        "new compilation resets the old resource receipt");
    execution_close_checked(&session);
}

fn execution_resource_tests(modules: void*): void {
    for(var width: u32 = 4; width <= 8; width *= 2) {
        execution_resource_trial(modules, width, ExecutionResourceBoundary.Compile, WorkBudgetError.Capacity, null);
        execution_resource_trial(modules, width, ExecutionResourceBoundary.Start, WorkBudgetError.Memory, null);
        execution_resource_trial(modules, width, ExecutionResourceBoundary.Cache, WorkBudgetError.Invalid, "Retained source-specific resource diagnostic");
        execution_resource_trial(modules, width, ExecutionResourceBoundary.Step, WorkBudgetError.Busy, null);
    }
}

fn execution_structure_detail(left: FoundationNode*, right: FoundationNode*, part: u8*): void {
    var detail: ByteBuffer = default;
    defer bytes_dispose(&detail);
    execution_check(driver_text(&detail, part) && driver_text(&detail, " kinds ")
        && host_json_unsigned(&detail, convert(u64, left.kind)) && driver_text(&detail, "/")
        && host_json_unsigned(&detail, convert(u64, right.kind)) && driver_text(&detail, " indexes ")
        && host_json_unsigned(&detail, convert(u64, left.index)) && driver_text(&detail, "/")
        && host_json_unsigned(&detail, convert(u64, right.index)) && driver_text(&detail, " names ")
        && bytes_append(&detail, left.name.data, left.name.length) && driver_text(&detail, "/")
        && bytes_append(&detail, right.name.data, right.name.length) && host_text_terminate(&detail),
        "structural diagnostic storage");
    puts(detail.data);
}

fn execution_type_same(a: FoundationType*, b: FoundationType*): bool {
    var left: ByteBuffer;
    var right: ByteBuffer;
    fill(&left, 0, sizeof(ByteBuffer));
    fill(&right, 0, sizeof(ByteBuffer));
    semantic_format_type(a, bits(vector(u8)*, &left));
    semantic_format_type(b, bits(vector(u8)*, &right));
    var same = execution_equal(&left, &right);
    bytes_dispose(&left);
    bytes_dispose(&right);
    return same;
}

fn execution_name_same(a: FoundationNode*, b: FoundationNode*): bool {
    return a.name.length == b.name.length &&(a.name.length == 0 || memcmp(a.name.data, b.name.data, a.name.length) == 0);
}

struct ExecutionNodePair { source: void*; reconstructed: void*; }

fn execution_structure_nodes(a: void*, b: void*, pairs: vector(ExecutionNodePair)*): bool {
    if a == null || b == null {
        return a == b;
    }
    foreach(var &pair in pairs) {
        if pair.source == a { return pair.reconstructed == b; }
        if pair.reconstructed == b { return false; }
    }
    var pair: ExecutionNodePair = { source: a, reconstructed: b };
    execution_check(vector_push(ExecutionNodePair, pairs, pair), "structural correspondence storage");
    var left = sem_get(a);
    var right = sem_get(b);
    if left.kind != right.kind || left.op != right.op || !execution_type_same(&left.type, &right.type)
    || !execution_type_same(&left.element, &right.element) || !execution_name_same(left, right)
    || left.constant != right.constant || left.indirect != right.indirect || left.bits != right.bits
    || left.length != right.length || left.external != right.external || left.exported != right.exported
    || left.global != right.global {
        execution_structure_detail(left, right, "fields differ");
        return false;
    }
    if !execution_structure_nodes(left.left, right.left, pairs) || !execution_structure_nodes(left.right, right.right, pairs)
    || !execution_structure_nodes(left.value, right.value, pairs) || !execution_structure_nodes(left.target, right.target, pairs)
    || !execution_structure_nodes(left.body, right.body, pairs) || !execution_structure_nodes(left.otherwise, right.otherwise, pairs)
    || left.parameters.length != right.parameters.length || left.items.length != right.items.length
    || left.attributes.length != right.attributes.length {
        execution_structure_detail(left, right, "children differ");
        return false;
    }
    for(var i: usize = 0; i < left.parameters.length; i++) {
        if !execution_structure_nodes(left.parameters.data[i], right.parameters.data[i], pairs) {
            return false;
        }
    }
    for(var index: usize = 0; index < left.attributes.length; index++) {
        if !execution_structure_nodes(left.attributes.data[index], right.attributes.data[index], pairs) { return false; }
    }
    for(var i: usize = 0; i < left.items.length; i++) {
        if !execution_structure_nodes(left.items.data[i], right.items.data[i], pairs) {
            return false;
        }
    }
    return true;
}

fn execution_structure(a: void*, b: void*): bool {
    var pairs: vector(ExecutionNodePair) = default;
    defer vector_dispose(&pairs);
    if !execution_structure_nodes(a, b, &pairs) { return false; }
    // Declaration ordinals are compilation-local indexes. Check the actual
    // corresponding target, including sharing, scopes and forward references.
    foreach(var &pair in &pairs) {
        var left = sem_get(pair.source);
        var right = sem_get(pair.reconstructed);
        if left.binding == null && right.binding == null { continue; }
        var same = false;
        foreach(var &target in &pairs) {
            if target.source == left.binding && target.reconstructed == right.binding { same = true; break; }
        }
        if !same {
            execution_structure_detail(left, right, "binding target correspondence differs");
            return false;
        }
    }
    return true;
}

fn execution_structure_binding_tests(modules: void*): void {
    var source = "import tower; extern fn touch(p:i32*):void; var value:i32=1; touch(&value); { var value:i32=2; touch(&value); print(value); } print(value);";
    var original: ExecutionSession = default;
    var reconstructed: ExecutionSession = default;
    defer execution_session_close(&original);
    defer execution_session_close(&reconstructed);
    execution_compile(&original, source, 4, modules);
    execution_compile(&reconstructed, source, 4, modules);
    execution_check(execution_structure(original.program.root, reconstructed.program.root), "equivalent binding targets map across owners");
    var pairs: vector(ExecutionNodePair) = default;
    defer vector_dispose(&pairs);
    execution_check(execution_structure_nodes(original.program.root, reconstructed.program.root, &pairs), "negative binding fixture correspondence");
    var changed = false;
    foreach(var &pair in &pairs) {
        var left = sem_get(pair.source);
        if left.kind != KOperand || left.binding == null { continue; }
        var binding = sem_get(left.binding);
        foreach(var &candidate in &pairs) {
            var target = sem_get(candidate.source);
            if candidate.source == left.binding || target.kind != KDeclare || !execution_type_same(&binding.type, &target.type) { continue; }
            var right = sem_get(pair.reconstructed);
            var saved = right.binding;
            var other = sem_get(candidate.reconstructed);
            var source_name = target.name;
            var reconstructed_name = other.name;
            // Borrow the same spelling on both sides during this check. Restore
            // the owned vectors before either graph can be disposed.
            target.name = binding.name;
            other.name = binding.name;
            right.binding = candidate.reconstructed;
            puts("Expected negative oracle diagnostic for a different same-spelling binding:");
            var rejected = !execution_structure(original.program.root, reconstructed.program.root);
            right.binding = saved;
            target.name = source_name;
            other.name = reconstructed_name;
            execution_check(rejected, "same-spelling wrong target is rejected");
            changed = true;
            break;
        }
        if changed { break; }
    }
    execution_check(changed && execution_structure(original.program.root, reconstructed.program.root), "binding restoration recovers exact correspondence");
}

fn execution_roundtrip(original: ExecutionSession*, modules: void*, structural: bool): void {
    var text: FormatResult;
    var again: FormatResult;
    fill(&text, 0, sizeof(FormatResult));
    fill(&again, 0, sizeof(FormatResult));
    format_entity(&text, original.program.root, syntax_component_type(), null, parser_match_get_type());
    execution_check(!text.failed && text.text.length != 0, "Foundation formats");
    var round: ExecutionSession;
    fill(&round, 0, sizeof(ExecutionSession));
    execution_check(execution_session_compile(&round, text.text.data, text.text.length, original.program.pointer_bytes, modules), "Foundation recompiles");
    if structural {
        execution_check(execution_structure(original.program.root, round.program.root), "Foundation preserves graph structure/types/bindings");
    }
    format_entity(&again, round.program.root, syntax_component_type(), null, parser_match_get_type());
    execution_check(!again.failed && text.text.length == again.text.length
    && memcmp(text.text.data, again.text.data, text.text.length) == 0, "canonical text is stable");
    var root = sem_get(round.program.root);
    for(var i: usize = 0; i < root.items.length; i++) {
        var item = root.items.data[i];
        execution_check(sem_get(item) != null && entity_component_get(item, parser_match_get_type()) != null, "semantics enrich original parser entities");
    }
    // Rich fixtures can exceed the original tiny-program budget. Bound their
    // replay using the already completed graph execution, with lowering slack.
    var replay_limit = convert(usize, original.machine.steps) * 2 + 10000;
    execution_run(&round, 7, replay_limit);
    execution_check(execution_equal(&original.output, &round.output) && execution_equal(&original.error, &round.error), "round trip preserves execution");
    execution_session_close(&round);
    format_dispose(&text);
    format_dispose(&again);
}

fn execution_core_output(index: usize): u8* {
    if index == 0 {
        return "1\n";
    }
    if index == 1 {
        return "3\n";
    }
    if index == 2 {
        return "42\n";
    }
    if index == 4 {
        return "4\n";
    }
    if index == 6 {
        return "1\n3\n";
    }
    if index == 7 {
        return "720\n";
    }
    if index == 10 {
        return "4\n";
    }
    if index == 11 {
        return "2\n3\n";
    }
    if index == 12 {
        return "42\n73\n";
    }
    if index == 13 {
        return "9\n4\n";
    }
    if index == 14 {
        return "42\n7\n";
    }
    if index == 17 {
        return "42\n";
    }
    if index == 18 {
        return "";
    }
    if index == 19 {
        return "7\n9\n";
    }
    return null;
}

fn execution_core_error(index: usize): u8* {
    if index == 3 {
        return "Expected i32, got u32";
    }
    if index == 8 {
        return "without returning";
    }
    if index == 9 {
        return "Expected i32, got bool";
    }
    if index == 15 {
        return "initializer dependency cycle a -> b -> a";
    }
    if index == 16 {
        return "Unknown";
    }
    if index == 20 {
        return "Recursive by-value";
    }
    if index == 21 {
        return "missing capture";
    }
    return null;
}

fn execution_core_layout(session: ExecutionSession*, index: usize): void {
    if index != 17 && index != 18 {
        return;
    }
    var type = session.program.types.data[session.program.types.length -1];
    var record = sem_get(type);
    execution_check(entity_component_get(type, parser_match_get_type()) != null, "record retains parser component");
    if index == 17 {
        execution_check(session.program.types.length == FoundationBuiltinScalarCount + 1 && record.size == 8 && record.alignment == 4, "shared built-in/record registry");
        execution_check(sem_get(record.items.data[0]).byte_offset == 0 && sem_get(record.items.data[1]).byte_offset == 4, "Pair layout");
    } else {
        execution_check(record.size == 20 && record.alignment == 4
        && sem_get(record.items.data[record.items.length -1]).byte_offset == 16, "nested raw-pointer layout");
    }
}

fn execution_generic_tests(modules: void*): void {
    var session: ExecutionSession;
    fill(&session, 0, sizeof(ExecutionSession));
    execution_compile(&session, "import tower; fn box(T: type): type { struct S { value: T; next: S*; } return S; } fn id(T: type, v: T): T { return v; } var a: box(i32); var b: box(i32); a.value = id(i32, 42); b.value = a.value; print(b.value);", 4, modules);
    var root = sem_get(session.program.root);
    var a: FoundationNode* = null;
    var b: FoundationNode* = null;
    for(var i: usize = 0; i < root.items.length; i++) {
        var item = sem_get(root.items.data[i]);
        if item.kind == KDeclare && item.name.length == 1 {
            if item.name.data[0] == 97 {
                a = item;
            }
            if item.name.data[0] == 98 {
                b = item;
            }
        }
    }
    execution_check(a != null && b != null && a.type.record == b.type.record, "same specialization retains nominal identity");
    var type = a.type.record;
    execution_check(entity_component_get(type, parser_match_get_type()) != null, "specialized record is parser entity");
    execution_check(sem_get(sem_get(type).items.data[1]).type.record == type, "recursive pointer type identity");
    execution_run(&session, 7, 10000);
    execution_check(execution_text(&session.output, "42\n"), "generic execution");
    // Generic declarations normalize to their concrete specializations. Preserve
    // the native harness contract: canonical stability, identities and execution.
    execution_roundtrip(&session, modules, false);
    execution_session_close(&session);
    var source = "import tower; fn broken(T: type): type { struct S { value: broken(T); } return S; } var x: broken(i32);";
    execution_check(!execution_session_compile(&session, source, strlen(source), 4, modules)
    && strstr(session.error.data, "Recursive by-value") != null, "recursive specialization diagnostic");
    execution_session_close(&session);
}

fn execution_target_tests(modules: void*): void {
    puts("Explicit target round trips");
    for(var width: u32 = 4; width <= 8; width += 4) {
        var session: ExecutionSession;
        fill(&session, 0, sizeof(ExecutionSession));
        execution_compile(&session, "import tower; struct P { tag: u8; ptr: i32*; } var size: usize = sizeof(P); print(size);", width, modules);
        var record = sem_get(session.program.types.data[session.program.types.length -1]);
        execution_check(record.size == convert(usize, width) *2 && record.alignment == convert(usize, width)
        && sem_get(record.items.data[record.items.length -1]).byte_offset == convert(usize, width), "explicit target struct layout");
        execution_run(&session, 7, 10000);
        execution_check(execution_text(&session.output, width == 4 ? "8\n": "16\n"), "target sizeof execution");
        execution_session_close(&session);
        execution_compile(&session, "import tower; var value = 41; var p = &value; var flag = value == 41; var bp = &flag; var address = bits(usize, p); *p = 42; *bp = false; print(value); print(flag);", width, modules);
        var root = sem_get(session.program.root);
        for(var i: usize = 0; i < root.locals.length; i++) {
            execution_check(sem_get(root.locals.data[i]).type.pointer_bytes == width, "inferred locals retain selected target");
        }
        execution_run(&session, 7, 10000);
        execution_check(execution_text(&session.output, "42\nfalse\n"), "inferred pointer behavior");
        execution_roundtrip(&session, modules, true);
        execution_session_close(&session);
    }
}

fn execution_core_tests(modules: void*): void {
    execution_resource_tests(modules);
    execution_structure_binding_tests(modules);
    var session: ExecutionSession;
    fill(&session, 0, sizeof(ExecutionSession));
    execution_compile(&session, "import tower; print(1);", 4, modules);
    execution_session_close(&session);
    var store = compiler_world_store(compiler_host_world());
    for(var i: usize = 0; execution_core_source(i) != null; i++) {
        var source = execution_core_source(i);
        puts(source);
        var ok = execution_session_compile(&session, source, strlen(source), 4, modules);
        var diagnostic = execution_core_error(i);
        if diagnostic != null {
            execution_check(!ok && strstr(session.error.data, diagnostic) != null, "static diagnostic retained");
            execution_session_step(&session, 10000);
            execution_check(session.machine.steps == 0 && session.output.length == 0, "invalid program has no effects");
        } else {
            if !ok { puts(session.error.data); }
            execution_check(ok, "core fixture compiles");
            execution_run(&session, 1, 10000);
            if i == 5 {
                execution_check(!session.machine.done && session.machine.steps == 10000 && session.error.length == 0, "infinite loop step budget");
            } else {
                execution_check(session.machine.done && session.error.length == 0 && execution_text(&session.output, execution_core_output(i)), "core fixture result");
                execution_core_layout(&session, i);
                execution_roundtrip(&session, modules, true);
            }
        }
        execution_close_checked(&session);
    }
    execution_generic_tests(modules);
    execution_target_tests(modules);
    puts("Quoted identifier round trip");
    execution_compile(&session, "import tower; fn `add-one`(`odd name`: i32): i32 { var `var`: i32 = `odd name` + 1; return `var`; } var `x-y`: i32 = `add-one`(41); print(`x-y`);", 4, modules);
    execution_run(&session, 7, 10000);
    execution_check(execution_text(&session.output, "42\n"), "quoted identifiers execute");
    execution_roundtrip(&session, modules, true);
    execution_session_close(&session);
    puts("Foreign declaration round trip");
    execution_compile(&session, "import tower; extern fn increment(p: i32*): i32; var a: i32 = 41; var answer: i32 = increment(&a); print(answer); print(a);", 4, modules);
    execution_run(&session, 7, 10000);
    execution_check(execution_text(&session.output, "42\n42\n"), "foreign memory mutation");
    execution_roundtrip(&session, modules, true);
    execution_close_checked(&session);
    // Grammar-edit trials populate the borrowed world's immutable grammar cache.
    // Check request destruction independently, then verify steady-state node use.
    var baseline = entity_store_count(store);
    for(var i: usize = 0; i < 16; i++) {
        execution_compile(&session, "import tower; print(1);", 4, modules);
        execution_run(&session, 7, 10000);
        execution_close_checked(&session);
        execution_check(entity_store_count(store) == baseline, "repeated requests do not retain entities");
    }
}
