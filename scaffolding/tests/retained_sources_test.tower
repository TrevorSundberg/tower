extern fn compiler_world_grammar(world: void*): CompilerGrammarCache*;
extern fn frontend_modules_source(environment: void*, path: u8*, text: u8*, length: usize): bool;
extern fn printf(format: u8*, workers: usize, peak: usize): i32;

fn retained_world_observe(context: void*, phase: GrammarPhase, entering: bool, first: usize, second: usize): void {
    // LR kernels do not recursively dispatch LR work. Count overlapping events,
    // under the ordinary host gate, rather than treating queue width as overlap.
    if phase != GrammarPhase.LookaheadKernel { return; }
    var probe = bits(RetainedWorldProbe*, context);
    work_gate_enter(probe.gate);
    if entering {
        probe.active++;
        if probe.active > probe.peak { probe.peak = probe.active; }
    } else { probe.active--; }
    work_gate_leave(probe.gate);
}

fn retained_world_drained(world: void*, budget: WorkBudget*): void {
    var snapshot: WorkBudgetSnapshot = default;
    execution_check(work_budget_snapshot(budget, &snapshot) && snapshot.used_lanes == 0
        && compiler_world_grammar(world).workers.running == 0, "Retained request joins before next admission");
}

fn retained_world_expect_width(session: ExecutionSession*, world: void*, modules: void*, budget: WorkBudget*,
    source: u8*, width: u32, wanted: u8*, fast: bool): void {
    retained_world_drained(world, budget);
    execution_compile(session, source, width, modules);
    execution_check(compiler_node_world(session.program.root) == world && !session.started
        && session.machine.steps == 0 && session.output.length == 0 && session.error.length == 0
        && session.fast == null && session.machine.memory.data == null, "Retained owner replaces previous request and execution cache");
    retained_world_drained(world, budget);
    if fast { execution_check(execution_session_fast(session), "Retained source Fast admission"); }
    execution_run(session, 7, 100000);
    if !execution_text(&session.output, wanted) {
        execution_error("Expected retained output:", wanted);
        execution_error("Actual retained output:", session.output.data ?? "");
    }
    execution_check(session.machine.done && !session.machine.failed && execution_text(&session.output, wanted),
        "Retained source exact layout, staged value, body and effect order");
}

fn retained_world_expect(session: ExecutionSession*, world: void*, modules: void*, budget: WorkBudget*,
    source: u8*, wanted: u8*, fast: bool): void {
    retained_world_expect_width(session, world, modules, budget, source, 8, wanted, fast);
}

fn retained_world_target_width(session: ExecutionSession*, world: void*, modules: void*, budget: WorkBudget*, root: u8*): void {
    var path: ByteBuffer = default;
    defer bytes_dispose(&path);
    var source: ByteBuffer = default;
    defer bytes_dispose(&source);
    execution_check(driver_request_path(&path, "", root, "tests/retained_target_width/main.tower")
        && driver_read_file(path.data, &source), "Load target-width fixture");
    frontend_modules_configure(modules, path.data, root);

    // The middle usize aligns Frame to one guest word and pads it to three.
    // The forward helper adds that size to 100 from its local write and 23 from the provider.
    var narrow = "4\n12\n135\n8\n";
    var wide = "8\n24\n147\n8\n";
    retained_world_expect_width(session, world, modules, budget, source.data, 4, narrow, false);
    retained_world_expect_width(session, world, modules, budget, source.data, 8, wide, false);
    retained_world_expect_width(session, world, modules, budget, source.data, 4, narrow, false);
    retained_world_expect_width(session, world, modules, budget, source.data, 8, wide, false);
}

fn retained_world_source(modules: void*, name: u8*, source: u8*): void {
    execution_check(frontend_modules_source(modules, name, source, strlen(source)), name);
}

fn retained_world_check_envelope(session: ExecutionSession*, wanted: u8*): void {
    foreach(var node in &session.program.types) {
        var nominal = sem_get(node);
        if nominal.name.data == null || strcmp(nominal.name.data, "Envelope") != 0 { continue; }
        execution_check(nominal.items.length == 1, "Envelope has its one selected field");
        var record = sem_get(nominal.items.data[0]).type.record;
        execution_check(record != null && strcmp(sem_get(record).name.data, wanted) == 0,
            "The field retains the selected provider's nominal type across the alias edit");
        return;
    }
    execution_check(false, "Retained compilation published Envelope");
}

fn retained_world_select_provider(modules: void*, provider: u8*, projection: u8*): void {
    var source: ByteBuffer = default;
    defer bytes_dispose(&source);
    execution_check(driver_text(&source, "import tower;\nimport ") && driver_text(&source, provider)
        && driver_text(&source, " as owner;\n") && driver_text(&source, projection)
        && host_text_terminate(&source), "Build the provider import");
    retained_world_source(modules, "projection.tower", source.data);
}

fn retained_world_escaped_type(session: ExecutionSession*, world: void*, modules: void*, budget: WorkBudget*): void {
    var source = "import tower;\nimport left as west;\nimport east as east;\nimport relay as path;\nimport switcher as flag;\nvar known = comptime(forward(flag.take));\nfn forward(take:bool):i32 {return path.demand(take);}\nstruct Envelope { value:path.View; }\nprint(sizeof(Envelope)); print(known); print(path.runtime()); print(west.tag); print(east.tag);\n";
    var left = "import tower;\nstruct Word { number:u8; }\nvar model:Word=default;\nvar address=&model;\n(*address).number=11;\nvar tag:i32=31;\n";
    var east = "import tower;\nstruct Word { number:u8; }\nvar model:Word=default;\nvar address=&model;\n(*address).number=22;\nvar tag:i32=41;\n";
    var wider = "import tower;\nstruct Word { number:u16; }\nvar model:Word=default;\nvar address=&model;\n(*address).number=33;\nvar tag:i32=41;\n";
    var inactive = "import tower;\nstruct Word { number:u64; }\nvar model:Word=default;\nvar address=&model;\n(*address).number=44;\nvar tag:i32=31;\n";
    var relay = "import tower;\nimport projection as leaf;\nvar View:type=ForwardView;\nvar ForwardView:type=leaf.View;\nfn demand(take:bool):i32{return leaf.demand(take);}\nfn runtime():i32{return leaf.runtime();}\n";
    var off = "import tower;var take:bool=false;\n";
    var on = "import tower;var take:bool=true;\n";
    var projection = "var View:type=decltype(owner.model);\nfn demand(take:bool):i32 {\n    if take {return convert(i32,owner.model.number);}\n    return convert(i32,sizeof(decltype(owner.model)))+100;\n}\nfn runtime():i32 {return convert(i32,owner.model.number);}\n";
    retained_world_source(modules, "left.tower", left);
    retained_world_source(modules, "east.tower", east);
    retained_world_source(modules, "relay.tower", relay);
    retained_world_source(modules, "switcher.tower", off);
    retained_world_select_provider(modules, "left", projection);
    retained_world_expect(session, world, modules, budget, source, "1\n101\n11\n31\n41\n", false);
    retained_world_check_envelope(session, "Word@left.tower");

    // Both providers stay imported. Their one-byte records have different identities.
    retained_world_select_provider(modules, "east", projection);
    retained_world_expect(session, world, modules, budget, source, "1\n101\n22\n31\n41\n", false);
    retained_world_check_envelope(session, "Word@east.tower");
    retained_world_source(modules, "east.tower", wider);
    retained_world_expect(session, world, modules, budget, source, "2\n102\n33\n31\n41\n", false);
    retained_world_source(modules, "left.tower", inactive);
    retained_world_expect(session, world, modules, budget, source, "2\n102\n33\n31\n41\n", false);

    retained_world_source(modules, "switcher.tower", on);
    execution_check(!execution_session_compile(session, source, strlen(source), 8, modules)
        && session.program.resource.error == WorkBudgetError.None
        && execution_text(&session.error, "Compile-time expression cannot capture runtime storage: binding is mutable, escaped or lacks an initializer")
        && session.machine.done && session.machine.failed && session.machine.steps == 0 && session.output.length == 0,
        "Reached value read rejects the escaped owner before guest execution");
    retained_world_drained(world, budget);
    retained_world_source(modules, "switcher.tower", off);
    retained_world_expect(session, world, modules, budget, source, "2\n102\n33\n31\n41\n", false);
    retained_world_select_provider(modules, "left", projection);
    retained_world_expect(session, world, modules, budget, source, "8\n108\n44\n31\n41\n", false);
    retained_world_check_envelope(session, "Word@left.tower");
}

fn retained_world_diamond(session: ExecutionSession*, world: void*, modules: void*, budget: WorkBudget*): void {
    // Ordinary code alone does not store an import snapshot. Give each unchanged
    // arm its own grammar rule so both cached clones depend on the same leaf.
    var left = "import tower;import retained_leaf as sample;parse RetainedLeft = 'left_marker';fn read_seed():decltype(sample.seed){return sample.seed;}print(21);";
    var right = "import tower;import retained_leaf as origin;parse RetainedRight = 'right_marker';fn projected():i32{return origin.staged();}print(31);";
    execution_check(frontend_modules_source(modules, "retained_left.tower", left, strlen(left))
        && frontend_modules_source(modules, "retained_right.tower", right, strlen(right)), "Install both retained diamond arms once");
    var side_name = "retained_side.tower";
    var side = "import tower;var salt:i32=71;";
    var side_edit = "import tower;var salt:i32=73;";
    execution_check(frontend_modules_source(modules, side_name, side, strlen(side)), "Install independent producer");
    var source = "import tower;import retained_left as lhs;import retained_right as rhs;import retained_side as side;struct Item{value:decltype(lhs.read_seed());}var known=comptime(choose(false));var other=comptime(choose(true));fn choose(take:bool):i32{if take{return side.salt;}return rhs.projected();}print(sizeof(Item));print(known);print(lhs.read_seed());print(other);";
    var name = "retained_leaf.tower";
    var first = "import tower;var seed:u8=7;fn staged():i32{return later()+5;}fn later():i32{return 20;}print(11);";
    var changed = "import tower;var seed:u64=19;fn staged():i32{return later()+5;}fn later():i32{return 40;}print(12);";
    var broken = "import tower;var seed:MissingLeaf=19;fn staged():i32{return later()+5;}fn later():i32{return 40;}print(13);";
    var repaired = "import tower;var seed:u16=9;fn staged():i32{return later()+5;}fn later():i32{return 60;}print(14);";
    // One leaf initializer, then left and right, then root layout / staged sum / value.
    var old_output = "11\n21\n31\n1\n25\n7\n71\n";
    var new_output = "12\n21\n31\n8\n45\n19\n73\n";
    var repaired_output = "14\n21\n31\n2\n65\n9\n73\n";
    execution_check(frontend_modules_source(modules, name, first, strlen(first)), "Install shared leaf");
    retained_world_expect(session, world, modules, budget, source, old_output, false);
    retained_world_expect(session, world, modules, budget, source, old_output, true);
    execution_check(frontend_modules_source(modules, side_name, side_edit, strlen(side_edit)), "Replace only the independent producer");
    retained_world_expect(session, world, modules, budget, source, "11\n21\n31\n1\n25\n7\n73\n", false);
    execution_check(frontend_modules_source(modules, name, changed, strlen(changed)), "Replace only the shared leaf");
    retained_world_expect(session, world, modules, budget, source, new_output, false);
    retained_world_expect(session, world, modules, budget, source, new_output, true);
    execution_check(frontend_modules_source(modules, name, broken, strlen(broken)), "Install failing shared leaf");
    execution_check(!execution_session_compile(session, source, strlen(source), 8, modules)
        && session.program.resource.error == WorkBudgetError.None && execution_text(&session.error, "Unknown type 'MissingLeaf'")
        && session.machine.done && session.machine.failed && session.machine.steps == 0 && !session.started
        && session.output.length == 0 && session.fast == null && !execution_session_start(session) && !execution_session_fast(session),
        "Failing shared leaf retires the previous Fast request before any initializer runs");
    retained_world_drained(world, budget);
    execution_check(frontend_modules_source(modules, name, repaired, strlen(repaired)), "Repair only the shared leaf");
    retained_world_expect(session, world, modules, budget, source, repaired_output, true);
    retained_world_expect(session, world, modules, budget, source, repaired_output, false);
}

fn retained_world_field_address(session: ExecutionSession*, world: void*, modules: void*, budget: WorkBudget*): void {
    var provider = "retained_word.tower";
    var first = "import tower;struct Word{a:u8;b:u8;}";
    var reordered = "import tower;struct Word{b:u8;a:u8;}";
    // Set byte zero directly so the expected value is independent of native byte order.
    var source = "import tower;import retained_word as cfg;var wanted=comptime(read_field());fn read_field():i32{var storage:u16=0;var first=bits(u8*,&storage);*first=1;var word=bits(cfg.Word*,&storage);var field=&(*word).b;return convert(i32,*field);}print(wanted);";
    execution_check(frontend_modules_source(modules, provider, first, strlen(first)), "Install byte field provider");
    retained_world_expect(session, world, modules, budget, source, "0\n", false);
    execution_check(frontend_modules_source(modules, provider, reordered, strlen(reordered)), "Move only the selected byte field");
    retained_world_expect(session, world, modules, budget, source, "1\n", false);
}

fn retained_world_scalar_type(session: ExecutionSession*, world: void*, modules: void*, budget: WorkBudget*): void {
    var name = "retained_seed.tower";
    var unsigned_seed = "import tower;var seed:u8=7;";
    var signed_seed = "import tower;var seed:i8=7;";
    var bridge = "import tower;import retained_seed as chosen;fn projected():i32{return convert(i32,~chosen.seed);}";
    var source = "import tower;import retained_projection as lib;var result=comptime(forward());fn forward():i32{return lib.projected();}print(result);";
    execution_check(frontend_modules_source(modules, name, unsigned_seed, strlen(unsigned_seed))
        && frontend_modules_source(modules, "retained_projection.tower", bridge, strlen(bridge)), "Install aliased byte projection");
    retained_world_expect(session, world, modules, budget, source, "248\n", false);
    // The reached declaration still holds 0x07. Its signed type changes the
    // widening conversion performed after the complement in the called body.
    execution_check(frontend_modules_source(modules, name, signed_seed, strlen(signed_seed)), "Replace only the seed's type");
    retained_world_expect(session, world, modules, budget, source, "-8\n", false);
}

fn retained_world_capture_escape(session: ExecutionSession*, world: void*, modules: void*, budget: WorkBudget*): void {
    var file = "retained_flag.tower";
    var initial = "import tower;var take:bool=false;";
    var escaped = "import tower;var take:bool=false;var alias=&take;";
    var source = "import tower;import retained_flag as selected;var wanted:i32=comptime(answer(selected.take));fn answer(take:bool):i32{return take ? 1 : 7;}print(wanted);";
    execution_check(frontend_modules_source(modules, file, initial, strlen(initial)), "Install staged flag");
    retained_world_expect(session, world, modules, budget, source, "7\n", false);
    execution_check(frontend_modules_source(modules, file, escaped, strlen(escaped)), "Escape the live flag without changing its initializer");
    execution_check(!execution_session_compile(session, source, strlen(source), 8, modules)
        && session.program.resource.error == WorkBudgetError.None
        && execution_text(&session.error, "Compile-time expression cannot capture runtime storage: binding is mutable, escaped or lacks an initializer")
        && session.machine.failed && session.machine.steps == 0 && session.output.length == 0,
        "New escape invalidates the previously successful capture before guest execution");
    retained_world_drained(world, budget);
    execution_check(frontend_modules_source(modules, file, initial, strlen(initial)), "Repair the staged flag");
    retained_world_expect(session, world, modules, budget, source, "7\n", false);
}

fn execution_retained_sources(request: DriverRequest*, workers: usize): void {
    execution_check(work_thread_available() && work_thread_capacity() >= workers, "Retained source native transport capacity");
    var signal = work_signal_open(); execution_check(signal != null, "Retained budget signal");
    defer work_signal_close(signal); work_signal_post(signal);
    var budget: WorkBudget = default;
    var bytes: usize = 2147483648;
    execution_check(work_budget_init(&budget, workers, bytes, 1)
        && work_budget_synchronize(&budget, signal, work_signal_wait, work_signal_post), "Retained world finite budget");
    var probe: RetainedWorldProbe = {gate: work_gate_open(), ..default};
    execution_check(probe.gate != null, "Retained observation gate"); defer work_gate_close(probe.gate);
    var world: void* = null;
    execution_check(compiler_world_create_result(workers, &budget, &world) == WorkBudgetError.None, "Retained world creation");
    var modules = frontend_modules_create();
    execution_check(modules != null, "Retained module owner");
    compiler_world_grammar(world).observer = {context: bits(void*, &probe), event: retained_world_observe};
    execution_world_prepare(world, modules, request);
    var name = "retained_dep.tower";
    var first = "import tower;var seed:u8=7;fn staged():i32{return later();}fn later():i32{return 107;}fn body():i32{print(11);return convert(i32,seed);}print(1);";
    var changed = "import tower;var seed:u64=13;fn staged():i32{return later();}fn later():i32{return 207;}fn body():i32{print(31);return convert(i32,seed);}print(3);";
    var source = "import tower;import retained_dep as dep;struct Item{value:decltype(dep.seed);}var known=comptime(dep.staged());var item:Item=default;item.value=dep.seed;print(sizeof(Item));print(known);print(dep.body());print(item.value);print(2);";
    var expected_first = "1\n1\n107\n11\n7\n7\n2\n";
    var expected_changed = "3\n8\n207\n31\n13\n13\n2\n";
    var session: ExecutionSession = default;
    execution_check(frontend_modules_source(modules, name, first, strlen(first)), "Initial retained source snapshot");
    retained_world_expect(&session, world, modules, &budget, source, expected_first, false);
    retained_world_expect(&session, world, modules, &budget, source, expected_first, true);
    execution_check(frontend_modules_source(modules, name, changed, strlen(changed)), "Replace same module/declaration names");
    retained_world_expect(&session, world, modules, &budget, source, expected_changed, false);
    retained_world_expect(&session, world, modules, &budget, source, expected_changed, true);
    var nul: u8[1] = default;
    execution_check(!frontend_modules_source(modules, name, &nul[0], sizeof(decltype(nul))), "Rejected replacement preserves prior snapshot");
    retained_world_expect(&session, world, modules, &budget, source, expected_changed, false);
    var bad = "import tower;var broken:Missing;";
    execution_check(frontend_modules_source(modules, name, bad, strlen(bad)), "Admit invalid semantic source snapshot");
    execution_check(!execution_session_compile(&session, source, strlen(source), 8, modules)
        && session.program.resource.error == WorkBudgetError.None && execution_text(&session.error, "Unknown type 'Missing'")
        && session.machine.done && session.machine.failed && session.machine.steps == 0 && session.output.length == 0
        && !execution_session_start(&session) && !execution_session_fast(&session), "Retained failure exact diagnostic and no execution");
    retained_world_drained(world, &budget);
    execution_check(frontend_modules_source(modules, name, first, strlen(first)), "Repair failed retained module");
    retained_world_expect(&session, world, modules, &budget, source, expected_first, false);
    // Execution is synchronous and explicitly stepped; this discards a suspended
    // VM at a call boundary, not an unsupported mid-compilation edit/cancel.
    execution_compile(&session, "import tower;while true {}", 8, modules);
    execution_check(execution_session_fast(&session), "Retained suspended Fast program");
    execution_session_step(&session, 16);
    execution_check(!session.machine.done && session.machine.steps != 0, "Actual partial execution before replacement");
    execution_check(frontend_modules_source(modules, name, changed, strlen(changed)), "Edit after compiler workers joined");
    retained_world_expect(&session, world, modules, &budget, source, expected_changed, true);
    retained_world_escaped_type(&session, world, modules, &budget);
    retained_world_diamond(&session, world, modules, &budget);
    retained_world_scalar_type(&session, world, modules, &budget);
    retained_world_capture_escape(&session, world, modules, &budget);
    retained_world_field_address(&session, world, modules, &budget);
    retained_world_target_width(&session, world, modules, &budget, request.root);
    execution_close_checked(&session);
    retained_world_drained(world, &budget);
    execution_check(probe.active == 0 && (workers == 1 || probe.peak >= 2), "Retained native LR work actually overlaps and drains");
    printf("Retained source workers=%zu observed_lr_overlap=%zu\n", workers, probe.peak);
    compiler_world_grammar(world).observer = default;
    frontend_modules_destroy(modules);
    execution_check(frontend_world_clear(world) && compiler_world_dispose(world), "Retained world finally closes");
    var final: WorkBudgetSnapshot = default;
    execution_check(work_budget_snapshot(&budget, &final) && final.used_bytes == 0 && final.live == 0
        && final.used_lanes == 0 && work_budget_dispose(&budget), "Retained source final zero owners");
}

fn execution_retained_checks(request: DriverRequest*): void {
    for(var workers: usize = 1; workers <= 2; workers++) { execution_retained_sources(request, workers); }
    puts("Retained source edits/repeats/failure repair and suspended execution replacement: exact results and zero owners passed.");
}

test() {
    var options: DriverOptions = default;
    options.source = "./foundation.tower";
    options.bedrock = "";
    options.foundation = "";
    var request: DriverRequest = default;
    assert(driver_request_open(&request, &options, "."), "Open the retained source fixture resources");
    defer driver_request_close(&request);
    execution_retained_checks(&request);
}
