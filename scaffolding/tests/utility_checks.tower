import tower;
import .library.test_data;

extern fn puts(text: u8*): i32;

extern fn fflush(stream: void*): i32;

extern fn abort(): void;

fn utility_check(ok: bool, message: u8*): void {
    if !ok {
        puts(message);
        fflush(null);
        abort();
    }
}

fn utility_equal(left: u8*, right: u8*, count: usize): bool {
    return test_bytes_equal(left, right, count);
}

fn utility_random(state: u32*): u32 {
    return test_xorshift32(state);
}
