import tower;
import floating_checks;
import narrow_checks;
import body_runs;
import frontend_units;
import execution_support;
import execution_core;
import struct_value_checks;
import .compiler.execution_session;
import .library.vector;

fn function_tests(modules: void*, root: u8*): void {
    var source: vector(u8) = default;
    var bedrock: vector(u8) = default;
    var foundation: vector(u8) = default;
    defer vector_dispose(&source);
    defer vector_dispose(&bedrock);
    defer vector_dispose(&foundation);
    units_read(root, "/tests/function_values.tower", &source);
    units_read(root, "/bedrock.tower", &bedrock);
    units_read(root, "/foundation.tower", &foundation);
    for(var width: u32 = 4; width <= 8; width += 4) {
        var graph: ExecutionSession = default;
        var fast: ExecutionSession = default;
        defer execution_session_close(&graph);
        defer execution_session_close(&fast);
        execution_compile(&graph, source.data, width, modules);
        execution_compile(&fast, source.data, width, modules);
        execution_check(execution_session_start(&graph) && execution_session_fast(&fast), "Function engines start");
        execution_run(&graph, 1000, 100000);
        execution_run(&fast, 1000, 100000);
        execution_same(&graph, &fast);
        execution_check(graph.machine.done && graph.error.length == 0 && execution_text(&graph.output, "0\n"), "Typed function values execute");
        floating_package(&graph, modules);
        execution_roundtrip(&graph, modules, false);
        var canonical: vector(u8) = default;
        defer vector_dispose(&canonical);
        for(var workers: usize = 1; workers <= 8; workers *= 2) {
            body_runs_trial(source.data, workers, width, bedrock.data, foundation.data, root, &canonical);
        }
    }
    narrow_trap(modules, "import tower;var callback:function(i32)=null;print(callback());", "Cannot call a null function");
    struct_value_reject(modules, "import tower;fn f(x:i32):i32{return x;}var p:function(i32,u32)=f;", "Expected function");
    struct_value_reject(modules, "import tower;fn f(x:i32):i32{return x;}var p=f;print(p());", "Wrong argument count");
    struct_value_reject(modules, "import tower;var p:function(i32,void);", "cannot have void");
    struct_value_reject(modules, "import tower;fn f(x:i32):u32{return 1;}fn use(T:type,p:function(T,T)):void{}use(f);", "Conflicting inferred types");
    struct_value_reject(modules, "import tower;fn f():i32{return 1;}print(f);", "cannot be printed");
    struct_value_reject(modules, "import tower;fn f():i32{return 1;}print(comptime(bits(usize,f)));", "relocatable typed references");
    narrow_trap(modules, "import tower;fn f():i32{return 1;}var p=bits(function(i32,i32),f);print(p(1));", "Function reference signature mismatch");
    puts("Function values: typed calls, nullability, staging, cache, round trips and worker determinism pass.");
}
