import library.testing;
import generic_clone_fixture;
import generic_clone_fixture_test;
import .compiler.semantic_query_api;
import .compiler.semantic_context_types;
import .compiler.semantic_program_types;
import .compiler.semantic_declaration_types;
import .compiler.semantic_work_ids;
import .compiler.foundation_tags;
import .library.work_budget;
import .library.work_budget_types;
import .library.work_pool;
import .library.work_graph;
import .library.work_vector;
import .library.work_vector_types;

extern fn sem_workers_open(c: SemanticContext*): bool;
extern fn compiler_buffer_allocation_size(bytes: usize): usize;
extern fn entity_store_count(store: void*): usize;
extern fn entity_store_component_count(store: void*): usize;
extern fn puts(text: u8*): i32;

enum PoolBudgetEntry: u32 { Direct, Declarations, Layout }
var PoolBudgetBytes: usize = 1048576;
var PoolBudgetRevision: u64 = 95;

fn pool_budget_check(ok: bool, message: u8*, failures: u32*): void {
    if !ok { puts(message); (*failures)++; }
}

fn pool_budget_enter(c: SemanticContext*, entry: PoolBudgetEntry): bool {
    if entry == PoolBudgetEntry.Direct { return sem_workers_open(c); }
    if entry == PoolBudgetEntry.Declarations {
        return sem_declarations_pump(c) != SemanticPumpResult.Failed;
    }
    sem_layout_execute(c);
    return c.program.resource.error == WorkBudgetError.None && c.program.error.length == 0;
}

fn pool_budget_trial(width: u32, workers: usize, entry: PoolBudgetEntry, denied: bool): u32 {
    var failures: u32 = 0;
    var signal = work_signal_open();
    sem_require(signal != null);
    defer work_signal_close(signal);
    work_signal_post(signal);
    var budget: WorkBudget = default;
    sem_require(work_budget_init(&budget, workers, PoolBudgetBytes, PoolBudgetRevision)
        && work_budget_synchronize(&budget, signal, work_signal_wait, work_signal_post));
    var fixture: GenericCloneFixture = default;
    generic_clone_fixture_open(&fixture, 0, 0, workers, &budget);
    var program: SemanticProgram = default;
    semantic_initialize(&program, fixture.root, width);
    var context: SemanticContext = default;
    sem_context_init(&context, &program);
    context.generics = fixture.context;
    var batch_bytes: usize = 0;
    if entry == PoolBudgetEntry.Declarations {
        // An empty declaration pump deliberately has no pool to admit. Check
        // that fast path under full pressure, then queue actual pending work.
        var empty_before: WorkBudgetSnapshot = default;
        sem_require(work_budget_snapshot(&budget, &empty_before));
        var empty_pressure: WorkReservation = default;
        sem_require(work_budget_reserve_result(&budget, 0, 0,
            empty_before.bytes - empty_before.used_bytes, &empty_pressure) == WorkBudgetError.None);
        pool_budget_check(sem_declarations_pump(&context) == SemanticPumpResult.Complete
            && program.resource.error == WorkBudgetError.None && context.workers.count == 0,
            "An empty declaration pump completes without allocating a worker pool", &failures);
        sem_require(work_budget_release_result(&budget, &empty_pressure) == WorkBudgetError.None);
        var subject = sem_create(program.root);
        sem_attach(subject, KDeclare).start = 83;
        var declaration = sem_declaration_state(&context, subject);
        sem_require(declaration != null);
        declaration.subject = subject;
        declaration.admission = SemanticDeclarationAdmission.Pending;
        declaration.query = work_request(&context.queries, subject, convert(u32, SemanticQuery.Declaration), 0);
        sem_require(declaration.query != 0 && work_seal(&context.queries, declaration.query)
            && work_demand(&context.queries, declaration.query));
        // Measure the existing batch container's real charge, including its
        // allocation header. Leave exactly that room before denying the pool.
        var batch: work_vector(SemanticDeclaration*) = default;
        sem_require(work_vector_push_result(&batch, &budget, declaration) == WorkBudgetError.None);
        batch_bytes = batch.reservation.bytes;
        work_vector_dispose(&batch);
    }
    var before: WorkBudgetSnapshot = default;
    sem_require(work_budget_snapshot(&budget, &before));
    var pressure: WorkReservation = default;
    if denied {
        sem_require(batch_bytes < before.bytes - before.used_bytes
            && work_budget_reserve_result(&budget, 0, 0, before.bytes - before.used_bytes - batch_bytes, &pressure)
                == WorkBudgetError.None);
    }
    var entered = pool_budget_enter(&context, entry);
    var after: WorkBudgetSnapshot = default;
    sem_require(work_budget_snapshot(&budget, &after));
    if denied {
        pool_budget_check(!entered
            && program.resource.error == WorkBudgetError.Capacity
            && program.resource.offset == (entry == PoolBudgetEntry.Declarations ? 83 : 0)
            && context.workers.resource_error == WorkBudgetError.Capacity,
            "A nested semantic pool preserves actual Capacity at each owning entry", &failures);
        pool_budget_check(context.workers.count == 0 && context.workers.running == 0
            && context.workers.storage.data == null
            && after.used_bytes == before.used_bytes + pressure.bytes
            && after.live == before.live + 1 && after.used_lanes == before.used_lanes,
            "Denied pool construction publishes no slots or unaccounted storage", &failures);
        sem_require(work_budget_release_result(&budget, &pressure) == WorkBudgetError.None);
        var nodes = entity_store_count(fixture.store);
        var components = entity_store_component_count(fixture.store);
        for(var repeat: usize = 0; repeat < 3; repeat++) {
            pool_budget_check(!pool_budget_enter(&context, entry)
                && program.resource.error == WorkBudgetError.Capacity && context.workers.count == 0
                && entity_store_count(fixture.store) == nodes
                && entity_store_component_count(fixture.store) == components,
                "A failed semantic pool stays terminal after budget pressure is released", &failures);
        }
    } else {
        var storage = &context.workers.storage;
        pool_budget_check(entered && program.resource.error == WorkBudgetError.None
            && program.error.length == 0 && storage.reservation.active
            && storage.reservation.owner == &budget
            && storage.capacity == context.workers.count * sizeof(WorkSlot)
            && storage.reservation.bytes == compiler_buffer_allocation_size(storage.capacity)
            && after.used_bytes == before.used_bytes + storage.reservation.bytes
            && after.used_lanes == before.used_lanes,
            "Nested pool slots charge their physical bytes without reserving execution lanes", &failures);
        var slots = context.workers.slots;
        pool_budget_check(pool_budget_enter(&context, entry) && context.workers.slots == slots,
            "A healthy semantic pool reuses its retained slots", &failures);
        var repeated: WorkBudgetSnapshot = default;
        sem_require(work_budget_snapshot(&budget, &repeated));
        pool_budget_check(repeated.used_bytes == after.used_bytes && repeated.live == after.live,
            "Repeated pool admission does not duplicate the physical reservation", &failures);
    }
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    generic_clone_fixture_close(&fixture);
    sem_require(work_budget_snapshot(&budget, &after));
    pool_budget_check(after.used_bytes == 0 && after.used_lanes == 0 && after.live == 0
        && work_budget_dispose(&budget), "Pool, graph and world release all retained byte grants", &failures);
    return failures;
}

fn pool_budget_cases(width: u32, workers: usize): u32 {
    var failures: u32 = 0;
    failures += pool_budget_trial(width, workers, PoolBudgetEntry.Direct, false);
    failures += pool_budget_trial(width, workers, PoolBudgetEntry.Direct, true);
    failures += pool_budget_trial(width, workers, PoolBudgetEntry.Declarations, true);
    failures += pool_budget_trial(width, workers, PoolBudgetEntry.Layout, true);
    return failures;
}

test() { assert(pool_budget_cases(4, 1) == 0, "Semantic pool admission, pointer width 4, workers 1"); }
test() { assert(pool_budget_cases(4, 4) == 0, "Semantic pool admission, pointer width 4, workers 4"); }
test() { assert(pool_budget_cases(8, 1) == 0, "Semantic pool admission, pointer width 8, workers 1"); }
test() { assert(pool_budget_cases(8, 4) == 0, "Semantic pool admission, pointer width 8, workers 4"); }
