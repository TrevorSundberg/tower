import tower;
import .compiler.syntax_session_types;
import .compiler.frontend_revision_types;
import .compiler.grammar_types;
import .compiler.syntax_types;
import frontend_world;
import frontend_format;
import frontend_syntax_preview;

extern fn syntax_session_inputs_dispose(value: SyntaxSessionInputs*): void;
extern fn syntax_session_inputs_module(value: SyntaxSessionInputs*, source: u8*, module: void*): void;
extern fn syntax_session_inputs_source(value: SyntaxSessionInputs*, source: u8*, length: usize, name: u8*): bool;
extern fn syntax_session_inputs_reset(value: SyntaxSessionInputs*, source: u8*, length: usize, mode: u32, module: void*): bool;
extern fn syntax_source_retain(source: SyntaxSource*): void;
extern fn frontend_module_root_world(world: void*, source: u8*, environment: void*): void*;
extern fn frontend_module_source(module: void*): u8*;
extern fn frontend_module_destroy(module: void*): void;

fn frontend_session_inputs_tests(): void {
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    var kinds: FrontendKinds;
    frontend_world_check(frontend_world_test_kinds(world, &kinds));
    var value: SyntaxSessionInputs;
    fill(&value, 0, sizeof(SyntaxSessionInputs));
    value.world = world;
    frontend_world_check(syntax_session_inputs_reset(&value, "first!", 5, SyntaxSeedBaseline(), null));
    frontend_format_text(value.source.text.data, "first");
    frontend_format_text(value.source.name.data, "bedrock.tower");
    var retained_source = value.source;
    var retained_document = value.document;
    syntax_source_retain(retained_source);
    entity_retain(retained_document);
    frontend_world_check(syntax_session_inputs_reset(&value, "second", 6, SyntaxBedrockBaseline(), null));
    frontend_format_text(value.source.name.data, "foundation.tower");
    var allocations = tower_test_buffer_allocations();
    frontend_world_check(syntax_session_inputs_reset(&value, "third", 5, SyntaxFoundationBaseline(), null));
    var construction = tower_test_buffer_allocations() - allocations;
    frontend_format_text(value.source.name.data, "this file");
    var source = value.source;
    var document = value.document;
    var buffers = tower_test_buffer_count();
    for (var i: usize = 0; i < construction; ++i) {
        tower_test_buffer_fail_after(i);
        var ready = syntax_session_inputs_reset(&value, "trial", 5, SyntaxFoundationBaseline(), null);
        tower_test_buffer_fail_after(frontend_world_unlimited());
        frontend_world_check(!ready && value.source == source && value.document == document);
        frontend_world_check(tower_test_buffer_count() == buffers);
    }
    var view = entity_view_open(document);
    frontend_world_check(view is not null);
    frontend_world_check(!syntax_session_inputs_reset(&value, "pinned", 6, SyntaxFoundationBaseline(), null));
    frontend_world_check(value.document == document && value.source == source);
    entity_view_close(view);
    frontend_world_check(syntax_session_inputs_source(&value, "template!", 8, "replacement"));
    frontend_format_text(value.source.text.data, "template");
    frontend_format_text(value.source.name.data, "replacement");
    frontend_world_check(value.document == document);
    syntax_session_inputs_dispose(&value);
    syntax_session_inputs_dispose(&value);
    frontend_world_check(value.source is null && value.document is null && value.module is null);
    frontend_format_text(retained_source.text.data, "first");
    frontend_world_check(!compiler_world_dispose(world));
    entity_release(retained_document);
    frontend_world_check(compiler_world_dispose(world));
    syntax_source_release(retained_source);
    frontend_world_check(tower_test_buffer_count() == baseline);
}

fn frontend_session_module_tests(): void {
    // Owned and borrowed module graphs must stay in the explicit session world.
    var world = compiler_world_create();
    var kinds: FrontendKinds;
    frontend_world_check(frontend_world_test_kinds(world, &kinds));
    var warm = frontend_module_root_world(world, "warm", null);
    frontend_module_destroy(warm);
    var warmed: SyntaxSessionInputs;
    fill(&warmed, 0, sizeof(SyntaxSessionInputs));
    warmed.world = world;
    frontend_world_check(syntax_session_inputs_reset(&warmed, "warm", 4, SyntaxFoundationBaseline(), null));
    syntax_session_inputs_dispose(&warmed);
    var baseline = tower_test_buffer_count();
    var value: SyntaxSessionInputs;
    fill(&value, 0, sizeof(SyntaxSessionInputs));
    value.world = world;
    syntax_session_inputs_module(&value, "first", null);
    frontend_world_check(value.owns_module && value.module is not null);
    frontend_world_check(syntax_session_inputs_reset(&value, "first", 5, SyntaxFoundationBaseline(), null));
    frontend_format_text(value.source.name.data, "input.tower");
    var original = value.module;
    tower_test_buffer_fail_after(0);
    var ready = syntax_session_inputs_reset(&value, "failed", 6, SyntaxFoundationBaseline(), null);
    tower_test_buffer_fail_after(frontend_world_unlimited());
    frontend_world_check(!ready && value.module == original);
    frontend_format_text(frontend_module_source(value.module), "first");
    frontend_world_check(syntax_session_inputs_reset(&value, "second", 6, SyntaxFoundationBaseline(), null));
    frontend_format_text(frontend_module_source(value.module), "second");
    var borrowed = frontend_module_root_world(world, "borrowed", null);
    frontend_world_check(syntax_session_inputs_reset(&value, "borrowed", 8, SyntaxFoundationBaseline(), borrowed));
    frontend_world_check(!value.owns_module && value.module == borrowed);
    syntax_session_inputs_dispose(&value);
    frontend_format_text(frontend_module_source(borrowed), "borrowed");
    frontend_module_destroy(borrowed);
    frontend_world_check(tower_test_buffer_count() == baseline);
    frontend_world_check(compiler_world_dispose(world));
}
