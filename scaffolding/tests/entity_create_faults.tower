import tower;
import .library.entity_api;
import .library.entity_types;
import .library.work_budget_types;

extern fn tower_test_buffer_count(): usize;
extern fn tower_test_buffer_allocations(): usize;
extern fn tower_test_buffer_fail_after(count: usize): void;
extern fn puts(text: u8*): i32;

fn create_fault_check(ok: bool): void {
    if !ok { trap("Entity creation allocation failure regression", 0); }
}

export fn tower_entity_finalize(lifecycle: usize, component: EntityComponent*, data: u8*): void {
    trap("Unexpected entity creation fault finalizer", 0);
}

// Existing single-owner fault allocator only. Real allocator/transport stress
// remains separate; this test makes no claim about concurrent fault injection.
export fn main(argc: i32, argv: u8**): i32 {
    var baseline = tower_test_buffer_count();
    var store = entity_store_create();
    create_fault_check(store != null);
    var root = entity_create(store);
    create_fault_check(root != null);
    var page = store.buffers.owned;
    create_fault_check(page != null && page.components == null && page.live == 1 && page.capacity > 1);
    var peers = alloc(Entity*, page.capacity);
    create_fault_check(peers != null);
    peers[0] = root;
    var calls = tower_test_buffer_allocations();
    var error = WorkBudgetError.None;
    // A free raw-owner slot needs no allocation, even during allocation denial.
    tower_test_buffer_fail_after(0);
    var reused = entity_create_related_result(root, &error);
    tower_test_buffer_fail_after(~convert(usize, 0));
    create_fault_check(reused != null && error == WorkBudgetError.None
        && tower_test_buffer_allocations() == calls && page.live == 2);
    entity_release(reused);
    // Fill the actual page before denying the next physical allocation. Page
    // occupancy changes with descriptor geometry; one entity is not one buffer.
    for(var i: usize = 1; i < page.capacity; i++) {
        peers[i] = entity_create(store);
        create_fault_check(peers[i] != null && tower_test_buffer_allocations() == calls);
    }
    var count = page.capacity;
    create_fault_check(page.live == count && page.pool == null && store.entity_count == count);
    var prior = store.next_id;
    var live = tower_test_buffer_count();
    tower_test_buffer_fail_after(0);
    var missing = entity_create_result(store, &error);
    tower_test_buffer_fail_after(~convert(usize, 0));
    create_fault_check(missing == null && error == WorkBudgetError.Memory
        && tower_test_buffer_allocations() == calls + 1 && tower_test_buffer_count() == live
        && store.next_id == prior && store.entity_count == count && store.views == 0);
    tower_test_buffer_fail_after(0);
    missing = entity_create_related_result(root, &error);
    tower_test_buffer_fail_after(~convert(usize, 0));
    create_fault_check(missing == null && error == WorkBudgetError.Memory
        && tower_test_buffer_allocations() == calls + 2 && tower_test_buffer_count() == live
        && store.next_id == prior && store.entity_count == count && page.live == count
        && root.references == 1 && root.child_count == 0);
    var related = entity_create_related_result(root, &error);
    create_fault_check(related != null && error == WorkBudgetError.None && related.id == prior
        && related.store == store && related.parent == null && store.entity_count == count + 1
        && tower_test_buffer_allocations() == calls + 3 && tower_test_buffer_count() == live + 1);
    entity_release(related);
    for(var i: usize = 0; i < count; i++) { entity_release(peers[i]); }
    free(peers);
    create_fault_check(store.entity_count == 0 && entity_store_dispose(store)
        && tower_test_buffer_count() == baseline);
    puts("0");
    return 0;
}
