import tower;

extern fn strcmp(left: u8*, right: u8*): i32;
extern fn puts(text: u8*): i32;

enum ExecutableAdmissionMode: u32 {
    Healthy, Query, Edge, Access, Take, PartialTake, Observe, Finish, Pinned,
    Startup, Metadata, SignatureDenied, SignatureHealthy, Batch, BatchPartial, BatchGrowth, Alias
}

fn executable_admission_select(argc: i32, argv: u8**, mode: ExecutableAdmissionMode*): bool {
    *mode = ExecutableAdmissionMode.Healthy;
    if argc <= 1 || strcmp(argv[1], "healthy") == 0 { return true; }
    if strcmp(argv[1], "query") == 0 { *mode = ExecutableAdmissionMode.Query; return true; }
    if strcmp(argv[1], "edge") == 0 { *mode = ExecutableAdmissionMode.Edge; return true; }
    if strcmp(argv[1], "access") == 0 { *mode = ExecutableAdmissionMode.Access; return true; }
    if strcmp(argv[1], "take") == 0 { *mode = ExecutableAdmissionMode.Take; return true; }
    if strcmp(argv[1], "partial") == 0 { *mode = ExecutableAdmissionMode.PartialTake; return true; }
    if strcmp(argv[1], "observe") == 0 { *mode = ExecutableAdmissionMode.Observe; return true; }
    if strcmp(argv[1], "finish") == 0 { *mode = ExecutableAdmissionMode.Finish; return true; }
    if strcmp(argv[1], "pinned") == 0 { *mode = ExecutableAdmissionMode.Pinned; return true; }
    if strcmp(argv[1], "startup") == 0 { *mode = ExecutableAdmissionMode.Startup; return true; }
    if strcmp(argv[1], "metadata") == 0 { *mode = ExecutableAdmissionMode.Metadata; return true; }
    if strcmp(argv[1], "signature") == 0 { *mode = ExecutableAdmissionMode.SignatureDenied; return true; }
    if strcmp(argv[1], "signature-healthy") == 0 { *mode = ExecutableAdmissionMode.SignatureHealthy; return true; }
    if strcmp(argv[1], "batch") == 0 { *mode = ExecutableAdmissionMode.Batch; return true; }
    if strcmp(argv[1], "batch-partial") == 0 { *mode = ExecutableAdmissionMode.BatchPartial; return true; }
    if strcmp(argv[1], "batch-growth") == 0 { *mode = ExecutableAdmissionMode.BatchGrowth; return true; }
    if strcmp(argv[1], "alias") == 0 { *mode = ExecutableAdmissionMode.Alias; return true; }
    puts("Unknown executable admission selector");
    return false;
}
