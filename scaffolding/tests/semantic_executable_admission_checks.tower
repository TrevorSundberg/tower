import tower;
import .compiler.services;
import .compiler.compiler_kernels;
import .compiler.semantic_execution_work;
import .compiler.semantic_aggregates;
import .compiler.semantic_body_work;
import .compiler.semantic_lowering_work;
import .compiler.semantic_context;
import .compiler.semantic_context_types;
import .compiler.semantic_program_types;
import .compiler.semantic_lifecycle;
import .compiler.semantic_support;
import .compiler.semantic_control;
import .compiler.semantic_work_ids;
import .compiler.interpreter_context_types;
import .compiler.foundation_tags;
import .compiler.component_kinds;
import .compiler.parser_types;
import .library.work_graph;
import .library.work_budget;
import .library.work_budget_types;
import .library.work_pool;
import .library.work_buffer;

extern fn compiler_world_create_workers(workers: usize): void*;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_dispose(world: void*): bool;
extern fn compiler_world_create_result(workers: usize, budget: WorkBudget*, output: void**): WorkBudgetError;
extern fn entity_create(store: void*): void*;
extern fn entity_store_count(store: void*): usize;
extern fn entity_store_component_count(store: void*): usize;
extern fn compiler_world_component(world: void*, node: void*, kind: u32): void*;
extern fn node_match_set_label(value: ParserMatchData*, label: u8*): bool;
extern fn puts(text: u8*): i32;
extern fn strcmp(left: u8*, right: u8*): i32;
extern fn printf(format: u8*, error: usize, offset: usize, state: usize, ready: usize): i32;

enum ExecutableAdmissionMode: u32 { Healthy, Query, Edge, Access, Take, PartialTake, Observe, Finish, Pinned }
var ExecutableAdmissionBytes: usize = 1048576;
var ExecutableAdmissionRevision: u64 = 123;
var ExecutableSignatureBudgetBytes: usize = 32 * 1048576;

fn executable_admission_check(ok: bool, text: u8*, failures: u32*): void {
    if !ok { puts(text); (*failures)++; }
}

fn executable_admission_pressure(budget: WorkBudget*, pressure: WorkReservation*): void {
    var snapshot: WorkBudgetSnapshot = default;
    sem_require(work_budget_snapshot(budget, &snapshot) && snapshot.used_bytes < snapshot.bytes);
    sem_require(work_budget_reserve_result(budget, 0, 0, snapshot.bytes - snapshot.used_bytes, pressure) == WorkBudgetError.None);
}

fn executable_admission_edges(c: SemanticContext*, dependency: usize): void {
    var argument: u64 = 1;
    while c.queries.edges.length < c.queries.edges.capacity {
        var consumer = work_request(&c.queries, c.program.root, convert(u32, SemanticQuery.BodyInputs), argument++);
        sem_require(consumer != 0 && work_depend(&c.queries, consumer, dependency));
    }
    // Keep a free task slot so the next denial reaches its dependency edge.
    if c.queries.tasks.length == c.queries.tasks.capacity {
        sem_require(work_request(&c.queries, c.program.root, convert(u32, SemanticQuery.BodyInputs), argument) != 0);
    }
}

fn executable_admission_function(c: SemanticContext*, world: void*): void* {
    var subject = sem_create(c.program.root);
    var function = sem_attach(subject, KFunction);
    function.start = 17;
    function.type.scalar = SVoid;
    function.index = c.program.functions.length;
    function.body = sem_create(subject);
    sem_require(entity_attach(function.body, subject, "body"));
    var syntax = bits(ParserMatchData*, compiler_world_component(world, function.body, CompilerParserMatch));
    sem_require(node_match_set_label(syntax, "CoreBlock"));
    sem_push(&c.program.functions, subject);
    sem_require(sem_body_request(c, subject) != null);
    return subject;
}

fn executable_admission_trial(width: u32, workers: usize, mode: ExecutableAdmissionMode): u32 {
    var failures: u32 = 0;
    var world = compiler_world_create_workers(workers);
    sem_require(world != null);
    var store = compiler_world_store(world);
    var root = entity_create(store);
    sem_require(root != null);
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, width);
    sem_get(root).start = 83;
    var context: SemanticContext = default;
    sem_context_init(&context, &program);
    context.generics = generic_begin(root);
    context.source = "";
    var budget: WorkBudget = default;
    sem_require(work_budget_init(&budget, workers, ExecutableAdmissionBytes, ExecutableAdmissionRevision));
    work_dispose(&context.queries);
    sem_require(work_init_budget(&context.queries, 1, convert(u64, width), &budget));
    var subject = executable_admission_function(&context, world);
    var second: void* = null;
    if mode == ExecutableAdmissionMode.PartialTake { second = executable_admission_function(&context, world); }
    var body_state = sem_bodies_pump(&context);
    while body_state == SemanticPumpResult.Progress { body_state = sem_bodies_pump(&context); }
    sem_require(body_state == SemanticPumpResult.Complete && sem_ok(&context));
    var body_query = work_find(&context.queries, subject, BodyQuery, 0);
    sem_require(body_query != 0 && work_task(&context.queries, body_query).state == WorkState.Succeeded);
    if mode == ExecutableAdmissionMode.Observe {
        context.surface_expressions = true;
        sem_lower_parallel(&context);
        var lowering = work_find(&context.queries, subject, convert(u32, SemanticQuery.Lowering), 0);
        sem_require(sem_ok(&context) && lowering != 0 && work_task(&context.queries, lowering).state == WorkState.Succeeded);
    }
    sem_executables_begin(&context);
    var pressure: WorkReservation = default;
    if mode == ExecutableAdmissionMode.Query {
        var argument: u64 = 1;
        while context.queries.tasks.length < context.queries.tasks.capacity {
            sem_require(work_request(&context.queries, root, convert(u32, SemanticQuery.BodyInputs), argument++) != 0);
        }
    }
    if mode == ExecutableAdmissionMode.Edge { executable_admission_edges(&context, body_query); }
    if mode == ExecutableAdmissionMode.Access {
        var unused = work_request(&context.queries, root, convert(u32, SemanticQuery.BodyInputs), 1);
        sem_require(unused != 0);
        while context.queries.accesses.length < context.queries.accesses.capacity {
            sem_require(work_access(&context.queries, unused, convert(u64, SemanticWorkDomain.Compiler),
                convert(u64, SemanticAccess.Expression), context.queries.accesses.length, 1, WorkAccessMode.Read));
        }
    }
    var denied_request = mode == ExecutableAdmissionMode.Query || mode == ExecutableAdmissionMode.Edge
        || mode == ExecutableAdmissionMode.Access;
    if denied_request { executable_admission_pressure(&budget, &pressure); }
    var nodes = entity_store_count(store);
    var components = entity_store_component_count(store);
    var query = sem_executable_request(&context, subject);
    var state = SemanticPumpResult.Failed;
    if denied_request {
        executable_admission_check(query == 0 && program.resource.error == WorkBudgetError.Capacity
            && program.resource.offset == 17 && context.queries.cancelled
            && entity_store_count(store) == nodes && entity_store_component_count(store) == components,
            "Denied executable query publishes no partial snapshot or ready input", &failures);
        if mode != ExecutableAdmissionMode.Query {
            executable_admission_check(work_find(&context.queries, subject, convert(u32, SemanticQuery.ExecutableFunction), 0) != 0,
                "Edge and access denial follow successful query reservation", &failures);
        }
        sem_require(work_budget_release_result(&budget, &pressure) == WorkBudgetError.None);
    } else {
        sem_require(query != 0 && work_demand(&context.queries, query));
        if mode == ExecutableAdmissionMode.Take { work_task(&context.queries, query).dispatch = ~convert(u64, 0); }
        if second != null {
            var next = sem_executable_request(&context, second);
            sem_require(next != 0 && work_demand(&context.queries, next));
            work_task(&context.queries, next).dispatch = ~convert(u64, 0);
        }
        if mode == ExecutableAdmissionMode.Observe { executable_admission_edges(&context, body_query); }
        var consumers: usize = 0;
        if mode == ExecutableAdmissionMode.Finish {
            consumers = context.queries.ready.capacity + 1;
            for(var index: usize = 0; index < consumers; index++) {
                var consumer = work_request(&context.queries, root, convert(u32, SemanticQuery.BodyInputs), convert(u64, index + 1));
                sem_require(consumer != 0 && work_depend(&context.queries, consumer, query)
                    && work_seal(&context.queries, consumer) && work_demand(&context.queries, consumer));
            }
        }
        var denied_completion = mode == ExecutableAdmissionMode.Observe || mode == ExecutableAdmissionMode.Finish;
        if denied_completion { executable_admission_pressure(&budget, &pressure); }
        nodes = entity_store_count(store);
        components = entity_store_component_count(store);
        var pin: void* = null;
        if mode == ExecutableAdmissionMode.Pinned {
            pin = entity_view_open(root);
            sem_require(pin != null);
        }
        state = sem_executables_pump(&context);
        if pin != null { entity_view_close(pin); }
        if mode == ExecutableAdmissionMode.Pinned {
            var result = bits(SemanticExecutable*, entity_component_data(entity_component_get(subject, context.executable_functions)));
            var input = bits(IMFunctionInput*, entity_component_data(entity_component_get(subject, context.executable_ready)));
            executable_admission_check(state == SemanticPumpResult.Failed && program.resource.error == WorkBudgetError.Busy,
                "Pinned executable admission returns its actual busy failure", &failures);
            executable_admission_check(program.resource.offset == 17 && context.queries.cancelled,
                "Pinned executable admission preserves source position and cancels unsettled queries", &failures);
            executable_admission_check(result.stage == null && result.context == null && result.function == null
                && !input.ready && input.function == null,
                "Pinned executable admission releases unpublished ownership without a ready input", &failures);
            executable_admission_check(entity_store_count(store) == nodes && entity_store_component_count(store) == components,
                "Pinned executable admission leaves canonical entity and component counts unchanged", &failures);
        } else {
        if mode == ExecutableAdmissionMode.Take || mode == ExecutableAdmissionMode.PartialTake {
            executable_admission_check(state == SemanticPumpResult.Failed && program.resource.error == WorkBudgetError.Invalid
                && program.resource.offset == 83 && context.queries.cancelled
                && entity_store_count(store) == nodes && entity_store_component_count(store) == components,
                "Executable take exhaustion is a phase-owned terminal failure", &failures);
        } else { if denied_completion {
            var result = bits(SemanticExecutable*, entity_component_data(entity_component_get(subject, context.executable_functions)));
            var input = bits(IMFunctionInput*, entity_component_data(entity_component_get(subject, context.executable_ready)));
            executable_admission_check(state == SemanticPumpResult.Failed && program.resource.error == WorkBudgetError.Capacity
                && program.resource.offset == 17 && context.queries.cancelled && result.stage == null && result.context == null
                && result.function != null && !input.ready && input.function == null,
                "Joined executable graph failure preserves its cause without publishing a ready input", &failures);
            for(var index: usize = 0; index < consumers; index++) {
                var consumer = work_find(&context.queries, root, convert(u32, SemanticQuery.BodyInputs), convert(u64, index + 1));
                executable_admission_check(work_task(&context.queries, consumer).state == WorkState.Cancelled
                    && work_task(&context.queries, consumer).dispatch == 0,
                    "Partial completion cancels consumers without dispatching effects", &failures);
            }
            sem_require(work_budget_release_result(&budget, &pressure) == WorkBudgetError.None);
        } else {
            var input = bits(IMFunctionInput*, entity_component_data(entity_component_get(subject, context.executable_ready)));
            executable_admission_check(state == SemanticPumpResult.Progress && work_task(&context.queries, query).state == WorkState.Succeeded
                && input != null && input.ready && input.function != null && input.function != subject,
                "Actual checked body publishes one ordinary executable snapshot", &failures);
        } } }
    }
    if second != null {
        var first = bits(SemanticExecutable*, entity_component_data(entity_component_get(subject, context.executable_functions)));
        var next = bits(SemanticExecutable*, entity_component_data(entity_component_get(second, context.executable_functions)));
        var input = bits(IMFunctionInput*, entity_component_data(entity_component_get(subject, context.executable_ready)));
        executable_admission_check(first.stage == null && next.stage == null && first.context == null && next.context == null
            && first.function == null && next.function == null && !input.ready,
            "Partial executable admission discards acquired stages before cancelling without executing snapshots", &failures);
    }
    nodes = entity_store_count(store);
    components = entity_store_component_count(store);
    var tasks = context.queries.tasks.length;
    var retained = program.resource;
    for(var repeat: usize = 0; repeat < 3; repeat++) {
        state = sem_executables_pump(&context);
        executable_admission_check(state == (mode == ExecutableAdmissionMode.Healthy ? SemanticPumpResult.Complete : SemanticPumpResult.Failed)
            && entity_store_count(store) == nodes && entity_store_component_count(store) == components
            && context.queries.tasks.length == tasks && program.resource.error == retained.error
            && program.resource.offset == retained.offset && context.workers.running == 0 && context.queries.running == 0,
            "Repeated executable terminal pumps replay no effects or metadata", &failures);
    }
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(root);
    executable_admission_check(compiler_world_dispose(world), "Executable admission releases its world", &failures);
    var released: WorkBudgetSnapshot = default;
    sem_require(work_budget_snapshot(&budget, &released));
    executable_admission_check(released.used_bytes == 0 && released.used_lanes == 0 && released.live == 0
        && work_budget_dispose(&budget), "Executable admission releases its graph grants", &failures);
    return failures;
}

fn executable_storage_trial(width: u32, workers: usize, startup: bool): u32 {
    var failures: u32 = 0;
    var world = compiler_world_create_workers(workers);
    sem_require(world != null);
    var store = compiler_world_store(world);
    var root = entity_create(store);
    sem_require(root != null);
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, width);
    sem_get(root).start = 83;
    var context: SemanticContext = default;
    sem_context_init(&context, &program);
    context.generics = generic_begin(root);
    context.source = "";
    var subject = root;
    if !startup {
        subject = executable_admission_function(&context, world);
        var state = sem_bodies_pump(&context);
        while state == SemanticPumpResult.Progress { state = sem_bodies_pump(&context); }
        sem_require(state == SemanticPumpResult.Complete && sem_ok(&context));
        sem_executables_begin(&context);
        sem_require(sem_ok(&context));
    }
    var nodes = entity_store_count(store);
    var components = entity_store_component_count(store);
    var pin = entity_view_open(root);
    sem_require(pin != null);
    if startup { sem_executables_begin(&context); }
    else { executable_admission_check(sem_executable_request(&context, subject) == 0,
        "Pinned executable metadata admission returns no runnable query", &failures); }
    executable_admission_check(program.resource.error == WorkBudgetError.Busy
        && program.resource.offset == (startup ? 83 : 17) && context.queries.cancelled,
        "Executable storage failure retains exact cause and owner position", &failures);
    executable_admission_check(entity_store_count(store) == nodes && entity_store_component_count(store) == components,
        "Pinned executable storage admission publishes no entity or component", &failures);
    entity_view_close(pin);
    var tasks = context.queries.tasks.length;
    for(var repeat: usize = 0; repeat < 3; repeat++) {
        sem_executables_begin(&context);
        executable_admission_check(sem_executable_request(&context, subject) == 0
            && sem_executables_pump(&context) == SemanticPumpResult.Failed
            && entity_store_count(store) == nodes && entity_store_component_count(store) == components
            && context.queries.tasks.length == tasks && context.workers.running == 0,
            "Released input pin cannot revive failed executable admission", &failures);
    }
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(root);
    executable_admission_check(compiler_world_dispose(world), "Executable storage failure releases its world", &failures);
    return failures;
}

fn executable_signature_trial(width: u32, workers: usize, denied: bool): u32 {
    var failures: u32 = 0;
    var budget: WorkBudget = default;
    sem_require(work_budget_init(&budget, workers, ExecutableSignatureBudgetBytes, ExecutableAdmissionRevision));
    var gate: void* = null;
    if workers > 1 {
        gate = work_signal_open();
        sem_require(gate != null);
        work_signal_post(gate);
        sem_require(work_budget_synchronize(&budget, gate, work_signal_wait, work_signal_post));
    }
    defer { if gate != null { work_signal_close(gate); } }
    var world: void* = null;
    sem_require(compiler_world_create_result(workers, &budget, &world) == WorkBudgetError.None && world != null);
    var root = entity_create(compiler_world_store(world));
    sem_require(root != null);
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, width);
    var context: SemanticContext = default;
    sem_context_init(&context, &program);
    context.generics = generic_begin(root);
    context.source = "";
    var subject = executable_admission_function(&context, world);
    var record = sem_create(root);
    var layout = sem_attach(record, KType);
    layout.type = { scalar: SStruct, pointers: 0, record: record, pointer_bytes: width };
    layout.size = convert(usize, width);
    layout.alignment = convert(usize, width);
    var parameter = sem_create(subject);
    var value = sem_attach(parameter, KParameter);
    value.type = layout.type;
    sem_push(&sem_get(subject).parameters, parameter);
    var state = sem_bodies_pump(&context);
    while state == SemanticPumpResult.Progress { state = sem_bodies_pump(&context); }
    sem_require(state == SemanticPumpResult.Complete && sem_ok(&context) && sem_aggregate_needed(subject));
    sem_executables_begin(&context);
    var pressure: WorkReservation = default;
    if denied {
        // The payload fits the configured total but not its remaining capacity
        // alongside live owners. No allocator hook or concurrent counter is used.
        var error: WorkBudgetError;
        context.aggregate_signatures = sem_kind_result(root,
            budget.bytes / 2, alignof(SemanticAggregateSignature), &error);
        sem_require(context.aggregate_signatures != null && error == WorkBudgetError.None);
        sem_require(budget.used_bytes < budget.bytes / 2
            && work_budget_reserve_result(&budget, 0, 0, budget.bytes / 2 - budget.used_bytes, &pressure) == WorkBudgetError.None);
    }
    var query = sem_executable_request(&context, subject);
    sem_require(query != 0 && work_demand(&context.queries, query));
    state = sem_executables_pump(&context);
    var result = bits(SemanticExecutable*, entity_component_data(entity_component_get(subject, context.executable_functions)));
    var input = bits(IMFunctionInput*, entity_component_data(entity_component_get(subject, context.executable_ready)));
    executable_admission_check(state == SemanticPumpResult.Progress && result.stage == null && result.context == null
        && context.workers.running == 0 && context.queries.running == 0,
        "Executable signature result joins and retires its stage", &failures);
    if denied {
        if result.resource.error != WorkBudgetError.Capacity || result.resource.offset != 17
            || work_task(&context.queries, query).state != WorkState.Failed || input.ready {
            printf("Signature receipt: error=%zu offset=%zu state=%zu ready=%zu\n",
                convert(usize, result.resource.error), result.resource.offset,
                convert(usize, work_task(&context.queries, query).state), input.ready ? 1 : 0);
        }
        executable_admission_check(result.resource.error == WorkBudgetError.Capacity && result.resource.offset == 17
            && work_task(&context.queries, query).state == WorkState.Failed && !input.ready,
            "Executable signature admission preserves its worker cause without a ready input", &failures);
        executable_admission_check(sem_executable_failure(&context, subject)
            && program.resource.error == WorkBudgetError.Capacity && program.resource.offset == 17,
            "Executable signature denial reaches the owning source function", &failures);
        var count = context.queries.tasks.length;
        executable_admission_check(sem_executable_request(&context, subject) == 0
            && sem_executables_pump(&context) == SemanticPumpResult.Failed && context.queries.tasks.length == count,
            "Executable signature denial cannot replay or revive its query", &failures);
    } else {
        executable_admission_check(work_task(&context.queries, query).state == WorkState.Succeeded
            && input.ready && sem_aggregate_signature(&context, input.function) != null,
            "Executable signature metadata remains available after successful publication", &failures);
    }
    if pressure.active { sem_require(work_budget_release_result(&budget, &pressure) == WorkBudgetError.None); }
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(root);
    executable_admission_check(compiler_world_dispose(world), "Executable signature owner releases its world", &failures);
    var released: WorkBudgetSnapshot = default;
    executable_admission_check(work_budget_snapshot(&budget, &released) && released.used_bytes == 0
        && released.used_lanes == 0 && released.live == 0 && work_budget_dispose(&budget),
        "Executable signature cleanup releases all world budget grants", &failures);
    return failures;
}

// Exhaust only the configured world ledger, after graph/control/worker setup.
// A measured first stage plus the shared vector's initial physical allocation
// fits exactly; a second stage cannot acquire its lease. Peak accounting then
// distinguishes a charged coordinator batch from an untracked raw vector.
fn executable_batch_trial(width: u32, workers: usize, partial: bool): u32 {
    var failures: u32 = 0;
    var budget: WorkBudget = default;
    var gate = work_signal_open(); sem_require(gate != null); work_signal_post(gate);
    defer work_signal_close(gate);
    sem_require(work_budget_init(&budget, workers, ExecutableSignatureBudgetBytes, ExecutableAdmissionRevision)
        && work_budget_synchronize(&budget, gate, work_signal_wait, work_signal_post));
    var world: void* = null;
    sem_require(compiler_world_create_result(workers, &budget, &world) == WorkBudgetError.None);
    // The failed context stays terminal. Recovery is a new context in the same
    // still-owned world after pressure and all failed owners have been released.
    for(var recovery: usize = 0; recovery < 2; recovery++) {
        var store = compiler_world_store(world);
        var root = entity_create(store); sem_require(root != null);
        var program: SemanticProgram = default; semantic_initialize(&program, root, width);
        var context: SemanticContext = default; sem_context_init(&context, &program);
        context.generics = generic_begin(root); context.source = "";
        var subjects: void*[2]; var queries: usize[sizeof(decltype(subjects)) / sizeof(void*)];
        var count = partial ? sizeof(decltype(subjects)) / sizeof(void*) : 1;
        for(var i: usize = 0; i < count; i++) { subjects[i] = executable_admission_function(&context, world); }
        var state = sem_bodies_pump(&context);
        while state == SemanticPumpResult.Progress { state = sem_bodies_pump(&context); }
        sem_require(state == SemanticPumpResult.Complete && sem_ok(&context));
        for(var i: usize = 0; i < count; i++) {
            queries[i] = sem_executable_request(&context, subjects[i]);
            sem_require(queries[i] != 0 && work_demand(&context.queries, queries[i]));
        }
        sem_control_names(&context); sem_require(sem_workers_open(&context));
        // Reserve graph take/yield storage without executing or preparing a result.
        var tickets: WorkTicket[sizeof(decltype(subjects)) / sizeof(void*)];
        for(var i: usize = 0; i < count; i++) { sem_require(work_take_task(&context.queries, &tickets[i], queries[i])); }
        for(var i: usize = 0; i < count; i++) { sem_require(work_yield(&context.queries, &tickets[i])); }
        var pressure: WorkReservation = default;
        var before: WorkBudgetSnapshot = default;
        var nodes = entity_store_count(store); var components = entity_store_component_count(store);
        if recovery == 0 {
            var available: usize = 0;
            if partial {
                var measured: WorkBudgetSnapshot = default;
                sem_require(work_budget_snapshot(&budget, &measured));
                var result = bits(SemanticExecutable*, entity_component_data(entity_component_get(subjects[0], context.executable_functions)));
                var error: WorkBudgetError;
                var stage = entity_stage_open_result(root, &error);
                sem_require(stage != null && entity_stage_lease_result(stage, result.root) == WorkBudgetError.None);
                var held: WorkBudgetSnapshot = default; sem_require(work_budget_snapshot(&budget, &held));
                available = held.used_bytes - measured.used_bytes
                    + compiler_buffer_allocation_size(WorkBufferInitialElements * sizeof(SemanticExecutable*));
                entity_stage_discard(stage);
                var released: WorkBudgetSnapshot = default; sem_require(work_budget_snapshot(&budget, &released));
                sem_require(released.used_bytes == measured.used_bytes && released.live == measured.live);
            }
            sem_require(work_budget_snapshot(&budget, &before) && available < before.bytes - before.used_bytes);
            sem_require(work_budget_reserve_result(&budget, 0, 0, before.bytes - before.used_bytes - available, &pressure) == WorkBudgetError.None);
        }
        sem_require(work_budget_snapshot(&budget, &before));
        state = sem_executables_pump(&context);
        var after: WorkBudgetSnapshot = default; sem_require(work_budget_snapshot(&budget, &after));
        if recovery == 0 {
            executable_admission_check(state == SemanticPumpResult.Failed && program.resource.error == WorkBudgetError.Capacity
                && program.resource.offset == 17 && context.queries.cancelled && context.queries.running == 0
                && context.workers.running == 0, "Bounded executable batch preserves Capacity and cancels taken tickets", &failures);
            executable_admission_check(after.used_bytes == before.used_bytes && after.live == before.live
                && after.used_lanes == before.used_lanes && entity_store_count(store) == nodes
                && entity_store_component_count(store) == components,
                "Denied executable batch returns temporary storage, stages and lane grants", &failures);
            if partial { executable_admission_check(after.peak_bytes == after.bytes,
                "Partial executable wave charges batch bytes alongside its first leased stage", &failures); }
            for(var i: usize = 0; i < count; i++) {
                var result = bits(SemanticExecutable*, entity_component_data(entity_component_get(subjects[i], context.executable_functions)));
                var input = bits(IMFunctionInput*, entity_component_data(entity_component_get(subjects[i], context.executable_ready)));
                executable_admission_check(result.stage == null && result.context == null && result.function == null
                    && !input.ready && input.function == null && !work_ticket_valid(&context.queries, &result.ticket),
                    "Denied batch exposes no ready input, stage, context or usable ticket", &failures);
            }
            sem_require(work_budget_release_result(&budget, &pressure) == WorkBudgetError.None);
            executable_admission_check(sem_executables_pump(&context) == SemanticPumpResult.Failed
                && program.resource.error == WorkBudgetError.Capacity && program.resource.offset == 17,
                "Released pressure does not replay a failed executable wave", &failures);
        } else {
            executable_admission_check(state == SemanticPumpResult.Progress && sem_ok(&context),
                "Fresh executable context recovers in the same budgeted world", &failures);
            for(var i: usize = 0; i < count; i++) {
                var input = bits(IMFunctionInput*, entity_component_data(entity_component_get(subjects[i], context.executable_ready)));
                executable_admission_check(input.ready && input.function != null
                    && work_task(&context.queries, queries[i]).state == WorkState.Succeeded,
                    "Recovered executable wave publishes every checked result", &failures);
            }
            var settled: WorkBudgetSnapshot = default; sem_require(work_budget_snapshot(&budget, &settled));
            executable_admission_check(sem_executables_pump(&context) == SemanticPumpResult.Complete
                && work_budget_snapshot(&budget, &after) && after.used_bytes == settled.used_bytes
                && after.live == settled.live, "Empty executable pump acquires no batch storage", &failures);
        }
        sem_context_dispose(&context); semantic_program_dispose(&program); entity_release(root);
    }
    executable_admission_check(compiler_world_dispose(world), "Executable batch recovery releases world", &failures);
    var final: WorkBudgetSnapshot = default;
    executable_admission_check(work_budget_snapshot(&budget, &final) && final.used_bytes == 0
        && final.used_lanes == 0 && final.live == 0 && work_budget_dispose(&budget),
        "Executable batch pressure and recovery release all world grants", &failures);
    return failures;
}

export fn main(argc: i32, argv: u8**): i32 {
    if argc > 1 && (strcmp(argv[1], "batch") == 0 || strcmp(argv[1], "batch-partial") == 0) {
        var failures: u32 = 0;
        for(var width: u32 = 4; width <= 8; width *= 2) {
            for(var workers: usize = 1; workers <= 4; workers *= 4) {
                failures += executable_batch_trial(width, workers, strcmp(argv[1], "batch-partial") == 0);
            }
        }
        return failures == 0 ? 0 : 1;
    }
    if argc > 1 && (strcmp(argv[1], "signature") == 0 || strcmp(argv[1], "signature-healthy") == 0) {
        var failures: u32 = 0;
        for(var width: u32 = 4; width <= 8; width += 4) {
            for(var workers: usize = 1; workers <= 4; workers += 3) {
                failures += executable_signature_trial(width, workers, strcmp(argv[1], "signature") == 0);
            }
        }
        return failures == 0 ? 0 : 1;
    }
    if argc > 1 && (strcmp(argv[1], "startup") == 0 || strcmp(argv[1], "metadata") == 0) {
        var failures: u32 = 0;
        for(var width: u32 = 4; width <= 8; width += 4) {
            for(var workers: usize = 1; workers <= 4; workers += 3) {
                failures += executable_storage_trial(width, workers, strcmp(argv[1], "startup") == 0);
            }
        }
        return failures == 0 ? 0 : 1;
    }
    var mode = ExecutableAdmissionMode.Healthy;
    if argc > 1 {
        if strcmp(argv[1], "pinned") == 0 { mode = ExecutableAdmissionMode.Pinned; }
        else { if strcmp(argv[1], "partial") == 0 { mode = ExecutableAdmissionMode.PartialTake; }
        else { if strcmp(argv[1], "query") == 0 { mode = ExecutableAdmissionMode.Query; }
        else { if strcmp(argv[1], "edge") == 0 { mode = ExecutableAdmissionMode.Edge; }
        else { if strcmp(argv[1], "access") == 0 { mode = ExecutableAdmissionMode.Access; }
        else { if strcmp(argv[1], "take") == 0 { mode = ExecutableAdmissionMode.Take; }
        else { if strcmp(argv[1], "observe") == 0 { mode = ExecutableAdmissionMode.Observe; }
        else { if strcmp(argv[1], "finish") == 0 { mode = ExecutableAdmissionMode.Finish; }
        else { if strcmp(argv[1], "healthy") != 0 { puts("Unknown executable admission selector"); return 1; } } } } } } } } }
    }
    var failures: u32 = 0;
    for(var width: u32 = 4; width <= 8; width += 4) {
        for(var workers: usize = 1; workers <= 4; workers += 3) {
            failures += executable_admission_trial(width, workers, mode);
        }
    }
    return failures == 0 ? 0 : 1;
}
