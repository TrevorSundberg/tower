import tower;
import .library.bytes_interface;
import .library.bytes_types;

import .compiler.format_types;
import .compiler.foundation_types;
import .compiler.semantic_program_types;
import .compiler.interpreter_types;
import .compiler.execution_package;
import .compiler.execution_session;
import execution_support;
import .library.work_budget_types;
import .library.vector;

extern fn sem_resource_record(program: SemanticProgram*, error: WorkBudgetError, offset: usize): void;

fn execution_package_resource_tests(modules: void*, width: u32): void {
    var session: ExecutionSession = default;
    execution_compile(&session, "import tower; print(42);", width, modules);
    var root = session.program.root;
    var store = compiler_world_store(compiler_host_world());
    var count = entity_store_count(store);
    var output: ByteBuffer = default;
    var error: ByteBuffer = default;
    defer bytes_dispose(&output);
    defer bytes_dispose(&error);
    sem_resource_record(&session.program, WorkBudgetError.Memory, 0);
    execution_check(execution_append_text(&output, "stale package"), "resource package output seed");
    execution_check(!execution_package_encode(&session.program, modules, 0, &output, &error)
        && output.length == 0 && execution_text(&error, sem_resource_message(WorkBudgetError.Memory)),
        "empty semantic diagnostic cannot authorize package encoding");
    var diagnostic = "Retained package resource diagnostic";
    var length = strlen(diagnostic);
    var trailing = " ignored trailing bytes";
    var extra = strlen(trailing) + 1;
    execution_check(vector_reserve(&session.program.error, length + extra), "package diagnostic fixture");
    copy(session.program.error.data, diagnostic, length);
    copy(session.program.error.data + length, trailing, extra);
    session.program.error.length = length;
    execution_check(!execution_package_encode(&session.program, modules, 0, &output, &error)
        && output.length == 0 && execution_text(&error, diagnostic)
        && session.program.root == root && entity_store_count(store) == count,
        "resource package gate retains source diagnostic without reconstructing entities");
    execution_close_checked(&session);
}

fn execution_package_tests(modules: void*): void {
    puts("Canonical .towerbc reconstruction");
    for(var width: u32 = 4; width <= 8; width += 4) {
        execution_package_resource_tests(modules, width);
        var original: ExecutionSession;
        var decoded: ExecutionSession;
        fill(&original, 0, sizeof(ExecutionSession));
        fill(&decoded, 0, sizeof(ExecutionSession));
        execution_compile(&original, "import tower; var p = alloc(i32, 2); p[0] = 42; print(p[0]); print(sizeof(usize)); free(p);", width, modules);
        var bytes: ByteBuffer;
        var repeated: ByteBuffer;
        var error: ByteBuffer;
        fill(&bytes, 0, sizeof(ByteBuffer));
        fill(&repeated, 0, sizeof(ByteBuffer));
        fill(&error, 0, sizeof(ByteBuffer));
        var encoded = execution_package_encode(&original.program, modules, 0, &bytes, &error);
        if !encoded { execution_error("Package: ", error.data ?? "no diagnostic"); }
        execution_check(encoded, "package encodes");
        execution_check(bytes.length >= 56, "complete envelope");
        execution_check(execution_package_load(&decoded, bytes.data, bytes.length, modules), "package reconstructs checked graph");
        execution_check(decoded.program.pointer_bytes == width, "target width retained");
        execution_check(execution_package_encode(&decoded.program, modules, 0, &repeated, &error), "reconstructed package re-encodes");
        execution_check(execution_equal(&bytes, &repeated), "byte-identical canonical re-encoding");
        execution_run(&original, 7, 10000);
        execution_run(&decoded, 7, 10000);
        execution_same(&original, &decoded);
        bytes.data[bytes.length -1] ^= 1;
        execution_check(!execution_package_load(&decoded, bytes.data, bytes.length, modules), "corrupt cache rejected");
        execution_check(execution_text(&decoded.error, ".towerbc checksum mismatch"), "exact checksum diagnostic");
        execution_check(decoded.fast == null && decoded.program.root == null, "invalid package never publishes executable state");
        execution_check(!execution_package_load(&decoded, bytes.data, 55, modules), "truncated header rejected");
        execution_compile(&original, "import tower; print(42);", width, modules);
        execution_check(execution_session_fast(&original), "cache verification fixture starts");
        var size: usize = 0;
        // The public envelope encoder supplies a valid checksum. Only checking
        // its reconstructed Foundation against the derived cache can reject this.
        var mismatch_source = "import tower; print(43);";
        var mismatch = bytecode_encode(original.fast, mismatch_source, strlen(mismatch_source), convert(usize, width), 0, &size);
        execution_check(mismatch != null && bytecode_validate(mismatch, size) == 0, "mismatched cache has valid envelope/checksum");
        execution_check(!execution_package_load(&decoded, mismatch, size, modules)
            && execution_text(&decoded.error, bytecode_error(9)), "Foundation/cache mismatch rejected");
        execution_session_step(&decoded, 1000);
        execution_check(decoded.machine.steps == 0 && decoded.output.length == 0, "unverified cache cannot execute");
        bytecode_free(mismatch);
        var nul: u8[3]; nul[0] = 120; nul[1] = 0; nul[2] = 121;
        var embedded = bytecode_encode(original.fast, &nul[0], 3, convert(usize, width), 0, &size);
        execution_check(embedded != null && bytecode_validate(embedded, size) == 0, "embedded NUL has valid envelope/checksum");
        execution_check(!execution_package_load(&decoded, embedded, size, modules)
            && execution_text(&decoded.error, "NUL in .towerbc Foundation source"), "bounded source NUL rejected before parsing");
        bytecode_free(embedded);
        execution_session_close(&original); execution_session_close(&decoded);
        bytes_dispose(&bytes); bytes_dispose(&repeated); bytes_dispose(&error);

    }
}
