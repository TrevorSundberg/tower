import tower;
import .host.memory;
import .library.entities;
import .library.entity_stage;
import entity_stage_ownership_cases;

// The browser runs both worlds in one guest and checks the cumulative callbacks.
var failures: i32 = 0;
fn check(ok: bool): void { if !ok { failures++; } }

fn retained(): void {
    var world = ownership_case();
    publish_held_children(&world);
    entity_release(world.kind);
    entity_release(world.root);
    check(finalized == 2 && entity_store_dispose(world.store));
}

fn discarded(): void {
    var world = ownership_case();
    var view = entity_view_open(world.root);
    var stage = stage_held_child(&world, "value");
    check(entity_references(world.target) == 1);
    entity_stage_discard(stage);
    check(entity_references(world.target) == 1 && entity_child_count(world.root) == 0 && finalized == 3);
    entity_view_close(view);
    stage = reject_duplicate_children(&world);
    entity_stage_discard(stage);
    check(entity_references(world.target) == 1 && finalized == 4);
    reject_existing_child(&world);
    entity_release(world.target);
    entity_release(world.kind);
    entity_release(world.root);
    check(entity_store_dispose(world.store));
}

retained();
discarded();
print(failures);
