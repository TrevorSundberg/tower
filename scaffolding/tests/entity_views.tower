import tower;
import .library.entities;

var failures: u32 = 0;

fn check(ok: bool): void {
    if !ok {
        failures++;
    }
}

fn views(): void {
    var world = entity_store_create();
    var other = entity_store_create();
    var type = entity_create(world);
    var unregistered = entity_create(world);
    var root = entity_create(world);
    var child = entity_create(world);
    var spare = entity_create(world);
    check(entity_register(type, sizeof(i32), alignof(i32), 0));
    check(entity_attach(child, root, "value"));
    entity_release(child);
    var component = entity_component_add(child, type);
    var payload = bits(i32*, entity_component_data(component));
    *payload = 42;
    var view = entity_view_open(root);
    var nested = entity_view_open(type);
    var view_check1 = view != null;
    check(view_check1);
    var view_check2 = nested != null;
    check(view_check2);
    var view_check3 = entity_view_open(null) == null;
    check(view_check3);
    var view_check4 = entity_store_dispose(world) == false;
    check(view_check4);
    var view_check5 = entity_create(world) == null;
    check(view_check5);
    var view_check6 = entity_component_add(root, type) == null;
    check(view_check6);
    var view_check7 = entity_component_add(child, type) == component;
    check(view_check7);
    var view_check8 = entity_component_remove(child, type) == false;
    check(view_check8);
    var view_check9 = entity_register(unregistered, 1, 1, 0) == false;
    check(view_check9);
    check(entity_register(type, sizeof(i32), alignof(i32), 0));
    var view_check10 = entity_attach(child, null, null) == false;
    check(view_check10);
    var view_check11 = entity_replace_child(root, 0, spare) == false;
    check(view_check11);
    var view_check12 = entity_take_last_child(root) == null;
    check(view_check12);
    var view_check13 = entity_parent(child) == root;
    check(view_check13);

    var foreign = entity_create(other);
    var view_check14 = foreign != null;
    check(view_check14);
    check(entity_register(foreign, 8, 8, 0));
    var other_node = entity_create(other);
    var view_check15 = entity_component_add(other_node, foreign) != null;
    check(view_check15);
    check(entity_component_remove(other_node, foreign));
    entity_release(other_node);
    entity_release(foreign);
    check(entity_store_dispose(other));

    var query: EntityQuery;
    check(entity_view_query(view, type, 0, 1, &query));
    var view_check16 = query.length == 1;
    check(view_check16);
    var view_check17 = query.data[0] == component;
    check(view_check17);
    var index = query.data;
    var view_check18 = entity_view_query(view, type, 0, 2, &query) == false;
    check(view_check18);
    var view_check19 = query.data == index;
    check(view_check19);
    var view_check20 = query.length == 1;
    check(view_check20);
    var view_check21 = entity_view_query(view, type, 2, 0, &query) == false;
    check(view_check21);
    var maximum: usize = 0;
    maximum--;
    var view_check22 = entity_view_query(view, type, 0, maximum, &query) == false;
    check(view_check22);

    entity_release(type);
    entity_release(root);
    entity_release(unregistered);
    entity_release(spare);
    var view_check23 = entity_store_count(world) == 5;
    check(view_check23);
    var view_check24 = entity_store_component_count(world) == 1;
    check(view_check24);
    entity_view_close(view);
    var view_check25 = entity_store_count(world) == 5;
    check(view_check25);
    var view_check26 = query.data == index;
    check(view_check26);
    var view_check27 = query.data[0] == component;
    check(view_check27);
    var view_check28 = *payload == 42;
    check(view_check28);
    entity_view_close(nested);
    var view_check29 = entity_store_count(world) == 0;
    check(view_check29);
    var view_check30 = entity_store_component_count(world) == 0;
    check(view_check30);
    check(entity_store_dispose(world));
}

fn batches(): void {
    var world = entity_store_create();
    var other = entity_store_create();
    var type = entity_create(world);
    var foreign = entity_create(other);
    check(entity_register(type, sizeof(u32), alignof(u32), 0));
    var owners: Entity*[37];
    var i: usize = 0;
    while i < 37 {
        owners[i] = entity_create(world);
        var component = entity_component_add(owners[i], type);
        var data = bits(u32*, entity_component_data(component));
        *data = convert(u32, i);
        i++;
    }
    var view = entity_view_open(type);
    var query: EntityQuery;
    check(entity_view_query(view, type, 0, 37, &query));
    var first = query.data;
    var view_check31 = entity_view_query(view, foreign, 0, 0, &query) == false;
    check(view_check31);
    var view_check32 = query.data == first;
    check(view_check32);
    var view_check33 = query.length == 37;
    check(view_check33);
    var sum: u32 = 0;
    i = 0;
    while i < 37 {
        var count: usize = 8;
        var remaining = 37 - i;
        var tail = count > remaining;
        if tail {
            count = remaining;
        }
        check(entity_view_query(view, type, i, count, &query));
        var j: usize = 0;
        while j < query.length {
            var data = bits(u32*, entity_component_data(query.data[j]));
            sum = sum + *data;
            j++;
        }
        i = i + count;
    }
    var view_check34 = sum == 666;
    check(view_check34);
    check(entity_view_query(view, type, 37, 0, &query));
    var view_check35 = query.length == 0;
    check(view_check35);
    var view_check36 = query.data == null;
    check(view_check36);

    // A coordinator can retain a zero-reference entity while the view pins it.
    // Repeated release/retain must not insert the deferred node twice.
    entity_release(owners[0]);
    entity_retain(owners[0]);
    entity_release(owners[0]);
    entity_retain(owners[0]);
    i = 1;
    while i < 37 {
        entity_release(owners[i]);
        i++;
    }
    entity_view_close(view);
    var view_check37 = entity_store_count(world) == 2;
    check(view_check37);
    var view_check38 = entity_query_count(type) == 1;
    check(view_check38);
    var view_check39 = entity_component_owner(entity_query_at(type, 0)) == owners[0];
    check(view_check39);
    var fresh = entity_create(world);
    var view_check40 = fresh != null;
    check(view_check40);
    check(entity_component_remove(owners[0], type));
    entity_release(fresh);
    entity_release(owners[0]);
    entity_release(type);
    entity_release(foreign);
    check(entity_store_dispose(world));
    check(entity_store_dispose(other));
}

views();
batches();
print(failures);
