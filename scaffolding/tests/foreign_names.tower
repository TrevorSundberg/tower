import tower;
import .backend.foreign_api;
import .backend.foreign_reader;
import .backend.foreign_symbol;
import .backend.text;

// Expected symbols come from the pinned LLVM/lld objects, the Itanium ABI,
// and upstream clang/test/CodeGenCXX/mangle-ms.cpp. No native test definitions.
extern fn puts(text: u8*): i32;

fn foreign_test(profile: u32, declaration: u8*, cpp: bool, object: bool, wanted: u8*): bool {
    var result = foreign_mangle(profile, declaration, cpp, object);
    var ok = backend_equal(foreign_name_text(result), wanted);
    ok &&= backend_equal(foreign_name_error(result), "");
    if !ok {
        puts(declaration);
        puts(foreign_name_error(result));
        puts(foreign_name_text(result));
        puts(wanted);
    }
    foreign_name_close(result);
    return ok;
}

export fn foreign_tests(): i32 {
    var failures: i32 = 0;
    var ok = foreign_test(1, "void foo(int value)", true, false, "_Z3fooi");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "void foo(int const value)", true, false, "_Z3fooi");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "void foo(int const* first, int const* second)", true, false, "_Z3fooPKiS0_");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "bool lld::wasm::link(llvm::ArrayRef<char const*> args, llvm::raw_ostream& out, llvm::raw_ostream& err, bool, bool)", true, false, "_ZN3lld4wasm4linkEN4llvm8ArrayRefIPKcEERNS1_11raw_ostreamES7_bb");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "ctor(base) llvm::raw_fd_ostream(int, bool, bool, llvm::raw_ostream::OStreamKind)", true, false, "_ZN4llvm14raw_fd_ostreamC2EibbNS_11raw_ostream11OStreamKindE");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "dtor(base) llvm::raw_fd_ostream()", true, false, "_ZN4llvm14raw_fd_ostreamD2Ev");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "static void lld::CommonLinkerContext::destroy()", true, false, "_ZN3lld19CommonLinkerContext7destroyEv");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "llvm::raw_ostream& llvm::nulls()", true, false, "_ZN4llvm5nullsEv");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "using size_t = unsigned long; static llvm::Expected<llvm::FileOutputBuffer> llvm::FileOutputBuffer::create(llvm::StringRef, size_t, unsigned int)", true, false, "_ZN4llvm16FileOutputBuffer6createENS_9StringRefEmj");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "using size_t = unsigned long; static llvm::sys::MemoryBlock llvm::sys::Memory::allocateMappedMemory(size_t, llvm::sys::MemoryBlock const*, unsigned int, std::__2::error_code&)", true, false, "_ZN4llvm3sys6Memory20allocateMappedMemoryEmPKNS0_11MemoryBlockEjRNSt3__210error_codeE");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "static std::__2::error_code llvm::sys::Memory::releaseMappedMemory(llvm::sys::MemoryBlock&)", true, false, "_ZN4llvm3sys6Memory19releaseMappedMemoryERNS0_11MemoryBlockE");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "std::__2::error_category const& std::__2::generic_category() noexcept", true, false, "_ZNSt3__216generic_categoryEv");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "void foo(void (*callback)(int) noexcept)", true, false, "_Z3fooPDoFviE");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "method int A::get() const & noexcept", true, false, "_ZNKR1A3getEv");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "void foo(Buffer<int, 12>)", true, false, "_Z3foo6BufferIiLi12EE");
    if !ok {
        failures++;
    }
    ok = foreign_test(3, "void foo(int)", true, true, "__Z3fooi");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "int a(char)", true, false, "?a@@YAHD@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(6, "int _c(void)", true, false, "?_c@@YAHXZ");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "ctor(complete) foo()", true, false, "??0foo@@QEAA@XZ");
    if !ok {
        failures++;
    }
    ok = foreign_test(6, "ctor(complete) foo(int)", true, false, "??0foo@@QAE@H@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(6, "ctor(complete) foo(char*)", true, false, "??0foo@@QAE@PAD@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "dtor(base) foo()", true, false, "??1foo@@QEAA@XZ");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "class foo bar()", true, false, "?bar@@YA?AVfoo@@XZ");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "class foo; static foo* foo::static_method()", true, false, "?static_method@foo@@SAPEAV1@XZ");
    if !ok {
        failures++;
    }
    ok = foreign_test(6, "bool __fastcall beta(long long, wchar_t)", true, false, "?beta@@YI_N_J_W@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "bool __fastcall beta(long long, wchar_t)", true, false, "?beta@@YA_N_J_W@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(6, "void __stdcall alpha(float, double) throw()", true, false, "?alpha@@YGXMN@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "void gamma(class foo, struct bar, union baz, enum quux)", true, false, "?gamma@@YAXVfoo@@Ubar@@Tbaz@@W4quux@@@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(6, "void delta(int* const a, const long&)", true, false, "?delta@@YAXQAHABJ@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "void delta(int* const a, const long&)", true, false, "?delta@@YAXQEAHAEBJ@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(6, "void zeta(int (*callback)(int, int))", true, false, "?zeta@@YAXP6AHHH@Z@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "int foo(void* bar)", false, false, "foo");
    if !ok {
        failures++;
    }
    ok = foreign_test(3, "int foo(void* bar)", false, true, "_foo");
    if !ok {
        failures++;
    }
    ok = foreign_test(6, "int __stdcall foo(void*, double)", false, true, "_foo@12");
    if !ok {
        failures++;
    }
    ok = foreign_test(6, "int __fastcall foo(void*, double)", false, true, "@foo@12");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "int __stdcall foo(void*, double)", false, true, "foo");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "using std::ostream = std::basic_ostream<char, std::char_traits<char>>; void foo(std::ostream*)", true, false, "_Z3fooPSo");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "using std::string = std::basic_string<char, std::char_traits<char>, std::allocator<char>>; void foo(std::string, std::string)", true, false, "_Z3fooSsSs");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "abi_tag(cxx11) std::__cxx11::basic_string<char> foo()", true, false, "_Z3fooB5cxx11v");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "method int A::operator+(int)", true, false, "_ZN1AplEi");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "method int A::operator-()", true, false, "_ZN1AngEv");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "method int foo::operator+(int)", true, false, "??Hfoo@@QEAAHH@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(6, "method int foo::operator+(int)", true, false, "??Hfoo@@QAEHH@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "void foo<int>(param(0))", true, false, "_Z3fooIiEvT_");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "void foo(Buffer<int, value(unsigned int, 12)>)", true, false, "_Z3foo6BufferIiLj12EE");
    if !ok {
        failures++;
    }
    ok = foreign_test(6, "bool __fastcall beta(long long, wchar_t) throw(signed char, unsigned char)", true, false, "?beta@@YI_N_J_W@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "void foo(int (*callback)(int) noexcept)", true, false, "?foo@@YAXP6AHH@_E@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(6, "void epsilon(int a[][10][20])", true, false, "?epsilon@@YAXQAY19BE@H@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "void epsilon(int a[][10][20])", true, false, "?epsilon@@YAXQEAY19BE@H@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "void foo(int (&a)[10])", true, false, "_Z3fooRA10_i");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "void foo(int A::*)", true, false, "_Z3fooM1Ai");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "void foo(int A::*)", true, false, "?foo@@YAXPEQA@@H@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "void foo(void (A::*)() const)", true, false, "_Z3fooM1AKFvvE");
    if !ok {
        failures++;
    }
    ok = foreign_test(5, "void foo(void (A::*)() const)", true, false, "?foo@@YAXP8A@@EBAXXZ@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(1, "void foo(Buffer<value(unsigned long long, 18446744073709551615)>)", true, false, "_Z3foo6BufferILy18446744073709551615EE");
    if !ok {
        failures++;
    }
    ok = foreign_test(11, "int a(char)", true, true, "?a@@$$hYAHD@Z");
    if !ok {
        failures++;
    }
    ok = foreign_test(11, "int foo(void*)", false, true, "#foo");
    if !ok {
        failures++;
    }
    var invalid = foreign_symbol(1, "cpp_name(");
    var message = foreign_name_error(invalid);
    var empty = message[0] == 0;
    if empty {
        failures++;
    }
    foreign_name_close(invalid);
    invalid = cpp_name(5, "void foo(MissingClassMetadata)");
    message = foreign_name_error(invalid);
    empty = message[0] == 0;
    if empty {
        failures++;
    }
    foreign_name_close(invalid);
    invalid = cpp_name(1, "void foo() unexpected");
    message = foreign_name_error(invalid);
    empty = message[0] == 0;
    if empty {
        failures++;
    }
    foreign_name_close(invalid);
    return failures;
}
