import library.testing;
import .compiler.semantic_query_api;
import .compiler.semantic_context_types;
import .compiler.semantic_program_types;
import .compiler.semantic_evaluation_types;
import .compiler.semantic_work_ids;
import .compiler.foundation_tags;
import .compiler.component_kinds;
import .compiler.parser_types;
import .library.vector;
import .library.work_graph;
import .library.work_budget;
import .library.work_pool;
import .library.work_budget_types;
import .library.entity_types;

// Link the production semantic provider; this fixture owns no flow algorithm.
extern fn sem_flow_request(c: SemanticContext*, subject: void*, dependencies: vector(void*)*): void;
extern fn sem_flows_pump(c: SemanticContext*): SemanticPumpResult;
extern fn sem_flows(c: SemanticContext*): void;
extern fn compiler_world_create_workers(workers: usize): void*;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_dispose(world: void*): bool;
extern fn entity_create(store: void*): void*;
extern fn compiler_node_world(node: void*): void*;
extern fn compiler_world_component(world: void*, node: void*, kind: u32): void*;
extern fn entity_store_component_count(store: void*): usize;
extern fn puts(text: u8*): i32;
extern fn entity_view_open(anchor: void*): void*;
extern fn entity_view_close(view: void*): void;
extern fn compiler_world_bind_budget(world: void*, budget: WorkBudget*): bool;
extern fn sem_workers_open(c: SemanticContext*): bool;

enum FlowCase: u32 { Healthy, Ordered, Query, Edge, Access, Demand, Take, Finish, Cancelled, Cycle, ProducerFailure, Ready, PartialTake, KindPin, ComponentPin, Scratch, ViewOverflow, Pool, Count }
var FlowGraphBytes: usize = 1048576;
var FlowGraphRevision: u64 = 127;

fn flow_check(ok: bool, message: u8*, failures: u32*): void {
    if !ok { puts(message); (*failures)++; }
}

fn flow_pressure(budget: WorkBudget*, receipt: WorkReservation*): void {
    var snapshot: WorkBudgetSnapshot = default;
    sem_require(work_budget_snapshot(budget, &snapshot) && snapshot.used_bytes < snapshot.bytes);
    sem_require(work_budget_reserve_result(budget, 0, 0, snapshot.bytes - snapshot.used_bytes, receipt) == WorkBudgetError.None);
}

fn flow_function(c: SemanticContext*, offset: usize, missing: bool): void* {
    var subject = sem_create(c.program.root);
    var function = sem_attach(subject, KFunction);
    function.start = offset;
    var syntax = bits(ParserMatchData*, compiler_world_component(compiler_node_world(subject), subject, CompilerParserMatch));
    sem_require(syntax != null);
    syntax.start = offset;
    function.type.scalar = missing ? SI32 : SVoid;
    function.body = sem_create(subject);
    sem_require(entity_attach(function.body, subject, "body"));
    sem_attach(function.body, KBlock);
    return subject;
}

fn flow_complete(c: SemanticContext*, id: usize, success: bool): void {
    var ticket: WorkTicket = default;
    sem_require(work_take_task(&c.queries, &ticket, id) && work_finish(&c.queries, &ticket, success));
}

fn flow_trial(workers: usize, mode: FlowCase): u32 {
    var failures: u32 = 0;
    var world = compiler_world_create_workers(workers);
    sem_require(world != null);
    var scratch_budget: WorkBudget = default;
    var scratch_pressure: WorkReservation = default;
    var scratch_gate: void* = null;
    defer { if scratch_gate != null { work_signal_close(scratch_gate); } }
    if mode == FlowCase.Scratch || mode == FlowCase.Pool {
        scratch_gate = work_signal_open();
        sem_require(scratch_gate != null);
        work_signal_post(scratch_gate);
        sem_require(work_budget_init(&scratch_budget, workers, FlowGraphBytes, FlowGraphRevision)
            && work_budget_synchronize(&scratch_budget, scratch_gate, work_signal_wait, work_signal_post)
            && compiler_world_bind_budget(world, &scratch_budget));
    }
    var store = compiler_world_store(world);
    var root = entity_create(store);
    sem_require(root != null);
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, convert(u32, sizeof(void*)));
    var c: SemanticContext = default;
    sem_context_init(&c, &program);
    c.generics = generic_begin(root);
    c.source = "";
    var budget: WorkBudget = default;
    sem_require(work_budget_init(&budget, workers, FlowGraphBytes, FlowGraphRevision));
    work_dispose(&c.queries);
    sem_require(work_init_budget(&c.queries, 1, convert(u64, program.pointer_bytes), &budget));
    var first = flow_function(&c, 17, mode == FlowCase.Ordered);
    var second = flow_function(&c, 29, mode == FlowCase.Ordered);
    var input = sem_create(root);
    sem_attach(input, KOperand).start = 41;
    var producer = work_request(&c.queries, input, convert(u32, SemanticQuery.Evaluation), 0);
    sem_require(producer != 0);
    if mode != FlowCase.Cycle { sem_require(work_seal(&c.queries, producer)); }
    var dependencies: vector(void*) = default;
    defer vector_dispose(&dependencies);
    var delayed = mode == FlowCase.Healthy || mode == FlowCase.Ordered || mode == FlowCase.Cycle || mode == FlowCase.ProducerFailure;
    if delayed || mode == FlowCase.Edge { sem_require(vector_push(&dependencies, input)); }
    var pressure: WorkReservation = default;
    var denied_request = mode == FlowCase.Query || mode == FlowCase.Edge || mode == FlowCase.Access;
    if mode == FlowCase.Query {
        var argument: u64 = 1;
        while c.queries.tasks.length < c.queries.tasks.capacity {
            sem_require(work_request(&c.queries, root, convert(u32, SemanticQuery.BodyInputs), argument++) != 0);
        }
    }
    if denied_request { flow_pressure(&budget, &pressure); }
    if mode == FlowCase.ComponentPin { sem_flow_request(&c, second, &dependencies); }
    var pin: void* = null;
    if mode == FlowCase.KindPin || mode == FlowCase.ComponentPin {
        pin = entity_view_open(root);
        sem_require(pin != null);
    }
    var components = entity_store_component_count(store);
    sem_flow_request(&c, first, &dependencies);
    if pin != null { entity_view_close(pin); }
    var query = work_find(&c.queries, first, convert(u32, SemanticQuery.Flow), 0);
    var state = SemanticPumpResult.Failed;
    if mode == FlowCase.KindPin || mode == FlowCase.ComponentPin {
        flow_check(program.resource.error == WorkBudgetError.Busy && program.resource.offset == 17
            && c.queries.cancelled && c.flow_count == (mode == FlowCase.ComponentPin ? 1 : 0)
            && entity_store_component_count(store) == components,
            "Pinned kind/component admission retains its source owner and publishes no partial flow", &failures);
    } else { if denied_request {
        flow_check(program.resource.error == WorkBudgetError.Capacity && program.resource.offset == 17
            && c.queries.cancelled && c.flow_count == 0 && c.flow_results == null
            && entity_store_component_count(store) == components,
            "Denied request retains Capacity and publishes no flow metadata", &failures);
    } else {
        sem_require(query != 0 && c.flow_count == 1);
        sem_flow_request(&c, first, &dependencies);
        flow_check(c.flow_count == 1 && program.resource.error == WorkBudgetError.None,
            "Repeated sealed request retains its ordinal and claims", &failures);
        if mode == FlowCase.Scratch || mode == FlowCase.ViewOverflow || mode == FlowCase.Pool {
            if mode == FlowCase.Scratch { sem_require(sem_workers_open(&c)); }
            if mode == FlowCase.Scratch || mode == FlowCase.Pool { flow_pressure(&scratch_budget, &scratch_pressure); }
            var entity_store = bits(EntityStore*, store);
            var views = entity_store.views;
            if mode == FlowCase.ViewOverflow { entity_store.views = ~convert(usize, 0); }
            state = sem_flows_pump(&c);
            if mode == FlowCase.ViewOverflow { entity_store.views = views; }
            flow_check(state == SemanticPumpResult.Failed && program.resource.offset == 17
                && program.resource.error == (mode == FlowCase.ViewOverflow ? WorkBudgetError.Exhausted : WorkBudgetError.Capacity)
                && c.queries.cancelled && c.queries.running == 0 && c.workers.running == 0
                && work_task(&c.queries, query).dispatch == 0 && entity_store.views == 0,
                "Scratch/view/pool denial is terminal before dispatch and closes the owned view", &failures);
        } else { if mode == FlowCase.Ready || mode == FlowCase.PartialTake {
            sem_flow_request(&c, second, &dependencies);
            var later = work_find(&c.queries, second, convert(u32, SemanticQuery.Flow), 0);
            if mode == FlowCase.PartialTake { work_task(&c.queries, later).dispatch = ~convert(u64, 0); }
            state = sem_flows_pump(&c);
            if mode == FlowCase.Ready {
                flow_check(state == SemanticPumpResult.Complete && work_task(&c.queries, query).dispatch == 1
                    && work_task(&c.queries, later).dispatch == 1,
                    "Independent ready flow jobs share one joined batch", &failures);
            } else {
                flow_check(state == SemanticPumpResult.Failed && program.resource.error == WorkBudgetError.Invalid
                    && c.queries.cancelled && c.queries.running == 0 && c.workers.running == 0
                    && work_task(&c.queries, query).state == WorkState.Cancelled,
                    "Partial ticket admission cancels undispatched peers", &failures);
            }
        } else { if mode == FlowCase.Cycle {
            sem_require(work_depend(&c.queries, producer, query) && work_seal(&c.queries, producer));
            state = sem_flows_pump(&c);
            flow_check(state == SemanticPumpResult.Waiting && program.error.length == 0,
                "Ordinary flow suspension does not diagnose a cycle", &failures);
            sem_flows(&c);
            flow_check(program.error_offset == 17 && sem_equal(program.error.data, "Flow dependency cycle: 17 -> 41 -> 17"),
                "Quiescent late owner selects a deterministic dependency path", &failures);
        } else { if delayed {
            dependencies.length = 0;
            sem_flow_request(&c, second, &dependencies);
            var later = work_find(&c.queries, second, convert(u32, SemanticQuery.Flow), 0);
            state = sem_flows_pump(&c);
            flow_check(state == SemanticPumpResult.Progress && program.error.length == 0
                && work_task(&c.queries, later).dispatch == 1 && work_task(&c.queries, query).dispatch == 0,
                "Ready later work runs while the earlier owner waits without selecting a later error", &failures);
            state = sem_flows_pump(&c);
            flow_check(state == SemanticPumpResult.Waiting && program.error.length == 0,
                "Repeated wait neither replays completed flow nor diagnoses failure", &failures);
            if mode == FlowCase.ProducerFailure {
                sem_evaluation_begin(&c);
                var evaluation = bits(SemanticEvaluation*, entity_component_data(entity_component_add(input, c.evaluation_results)));
                sem_require(evaluation != null);
                *evaluation = default;
                evaluation.subject = input;
                evaluation.resource_error = WorkBudgetError.Exhausted;
                evaluation.error_offset = 41;
            }
            flow_complete(&c, producer, mode != FlowCase.ProducerFailure);
            state = sem_flows_pump(&c);
            if mode == FlowCase.Healthy {
                flow_check(state == SemanticPumpResult.Complete && work_task(&c.queries, query).dispatch == 1
                    && work_task(&c.queries, later).dispatch == 1,
                    "Resumed flow executes each ready function exactly once", &failures);
            } else { if mode == FlowCase.Ordered {
                flow_check(state == SemanticPumpResult.Failed && program.error_offset == 17
                    && sem_equal(program.error.data, "Function '' can finish without returning a value"),
                    "Source order selects the earlier missing return after reversed readiness", &failures);
            } else {
                flow_check(state == SemanticPumpResult.Failed && program.resource.error == WorkBudgetError.Exhausted
                    && program.resource.offset == 41 && work_task(&c.queries, query).dispatch == 0,
                    "Failed dependency restores its actual producer receipt without executing flow", &failures);
            } }
        } else {
            if mode == FlowCase.Demand { flow_pressure(&budget, &pressure); }
            if mode == FlowCase.Take { work_task(&c.queries, query).dispatch = ~convert(u64, 0); }
            if mode == FlowCase.Cancelled { work_cancel(&c.queries); }
            if mode == FlowCase.Finish {
                // Warm the real executing storage before denying completion's
                // ready-index growth. Counts derive from the actual graph.
                var warm = work_request(&c.queries, root, convert(u32, SemanticQuery.BodyInputs), 0);
                sem_require(warm != 0 && work_access(&c.queries, warm, 1, 1, 0, 1, WorkAccessMode.Read)
                    && work_seal(&c.queries, warm) && work_demand(&c.queries, warm));
                flow_complete(&c, warm, true);
                var consumers = c.queries.ready.capacity + 1;
                for(var i: usize = 0; i < consumers; i++) {
                    var consumer = work_request(&c.queries, root, convert(u32, SemanticQuery.BodyInputs), convert(u64, i + 1));
                    sem_require(consumer != 0 && work_depend(&c.queries, consumer, query)
                        && work_seal(&c.queries, consumer) && work_demand(&c.queries, consumer));
                }
                flow_pressure(&budget, &pressure);
            }
            state = sem_flows_pump(&c);
            var cause = mode == FlowCase.Take || mode == FlowCase.Cancelled ? WorkBudgetError.Invalid : WorkBudgetError.Capacity;
            flow_check(state == SemanticPumpResult.Failed && program.resource.error == cause
                && c.queries.cancelled && c.queries.running == 0 && c.workers.running == 0,
                "Demand/take/finish/cancellation failure drains and retains its actual graph cause", &failures);
            if mode == FlowCase.Finish {
                flow_check(work_task(&c.queries, query).dispatch == 1 && work_task(&c.queries, query).state == WorkState.Cancelled,
                    "Finish reservation denial follows one joined kernel without publishing success", &failures);
                foreach(var &task in &c.queries.tasks) {
                    if task.query == convert(u32, SemanticQuery.BodyInputs) && task.argument != 0 {
                        flow_check(task.state == WorkState.Cancelled && task.dispatch == 0,
                            "Partial finish never dispatches downstream effects", &failures);
                    }
                }
            }
        } } } }
    } }
    if pressure.active { sem_require(work_budget_release_result(&budget, &pressure) == WorkBudgetError.None); }
    if scratch_pressure.active { sem_require(work_budget_release_result(&scratch_budget, &scratch_pressure) == WorkBudgetError.None); }
    components = entity_store_component_count(store);
    var count = c.flow_count;
    var tasks = c.queries.tasks.length;
    var dispatch = query == 0 ? convert(u64, 0) : work_task(&c.queries, query).dispatch;
    var retained = program.resource;
    var offset = program.error_offset;
    for(var repeat: usize = 0; repeat < 3; repeat++) {
        sem_flow_request(&c, first, &dependencies);
        state = sem_flows_pump(&c);
        flow_check(state == (mode == FlowCase.Healthy || mode == FlowCase.Ready ? SemanticPumpResult.Complete : SemanticPumpResult.Failed)
            && c.flow_count == count && c.queries.tasks.length == tasks && entity_store_component_count(store) == components
            && (query == 0 || work_task(&c.queries, query).dispatch == dispatch)
            && program.resource.error == retained.error && program.resource.offset == retained.offset && program.error_offset == offset
            && c.queries.running == 0 && c.workers.running == 0,
            "Repeated terminal calls retain receipts and metadata without replay", &failures);
    }
    sem_context_dispose(&c);
    semantic_program_dispose(&program);
    entity_release(root);
    flow_check(compiler_world_dispose(world), "Flow fixture releases its world", &failures);
    if mode == FlowCase.Scratch || mode == FlowCase.Pool {
        var scratch_released: WorkBudgetSnapshot = default;
        sem_require(work_budget_snapshot(&scratch_budget, &scratch_released));
        flow_check(scratch_released.used_bytes == 0 && scratch_released.used_lanes == 0
            && scratch_released.live == 0 && work_budget_dispose(&scratch_budget),
            "Denied flow scratch releases every world reservation", &failures);
    }
    var released: WorkBudgetSnapshot = default;
    sem_require(work_budget_snapshot(&budget, &released));
    flow_check(released.used_bytes == 0 && released.used_lanes == 0 && released.live == 0 && work_budget_dispose(&budget),
        "Flow fixture releases graph reservations", &failures);
    return failures;
}

test() { assert(flow_trial(1, FlowCase.Healthy) == 0); }
test() { assert(flow_trial(4, FlowCase.Healthy) == 0); }
test() { assert(flow_trial(1, FlowCase.Ordered) == 0); }
test() { assert(flow_trial(4, FlowCase.Ordered) == 0); }
test() { assert(flow_trial(1, FlowCase.Query) == 0); }
test() { assert(flow_trial(4, FlowCase.Query) == 0); }
test() { assert(flow_trial(1, FlowCase.Edge) == 0); }
test() { assert(flow_trial(4, FlowCase.Edge) == 0); }
test() { assert(flow_trial(1, FlowCase.Access) == 0); }
test() { assert(flow_trial(4, FlowCase.Access) == 0); }
test() { assert(flow_trial(1, FlowCase.Demand) == 0); }
test() { assert(flow_trial(4, FlowCase.Demand) == 0); }
test() { assert(flow_trial(1, FlowCase.Take) == 0); }
test() { assert(flow_trial(4, FlowCase.Take) == 0); }
test() { assert(flow_trial(1, FlowCase.Finish) == 0); }
test() { assert(flow_trial(4, FlowCase.Finish) == 0); }
test() { assert(flow_trial(1, FlowCase.Cancelled) == 0); }
test() { assert(flow_trial(4, FlowCase.Cancelled) == 0); }
test() { assert(flow_trial(1, FlowCase.Cycle) == 0); }
test() { assert(flow_trial(4, FlowCase.Cycle) == 0); }
test() { assert(flow_trial(1, FlowCase.ProducerFailure) == 0); }
test() { assert(flow_trial(4, FlowCase.ProducerFailure) == 0); }
test() { assert(flow_trial(1, FlowCase.Ready) == 0); }
test() { assert(flow_trial(4, FlowCase.Ready) == 0); }
test() { assert(flow_trial(1, FlowCase.PartialTake) == 0); }
test() { assert(flow_trial(4, FlowCase.PartialTake) == 0); }
test() { assert(flow_trial(1, FlowCase.KindPin) == 0); }
test() { assert(flow_trial(4, FlowCase.KindPin) == 0); }
test() { assert(flow_trial(1, FlowCase.ComponentPin) == 0); }
test() { assert(flow_trial(4, FlowCase.ComponentPin) == 0); }
test() { assert(flow_trial(1, FlowCase.Scratch) == 0); }
test() { assert(flow_trial(4, FlowCase.Scratch) == 0); }
test() { assert(flow_trial(1, FlowCase.ViewOverflow) == 0); }
test() { assert(flow_trial(4, FlowCase.ViewOverflow) == 0); }
test() { assert(flow_trial(1, FlowCase.Pool) == 0); }
test() { assert(flow_trial(4, FlowCase.Pool) == 0); }
