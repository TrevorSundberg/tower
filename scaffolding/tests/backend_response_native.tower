import tower;
import backend_response_checks;
import backend_clock_native;
import utility_checks;

extern fn tower_test_buffer_count(): usize;
extern fn tower_test_buffer_allocations(): usize;
extern fn tower_test_buffer_fail_after(count: usize): void;
extern fn strcmp(left: u8*, right: u8*): i32;

export fn main(argc: i32, argv: u8**): i32 {
    utility_check(argc == 1 || argc == 2 && strcmp(argv[1], "healthy") == 0, "Backend response selector");
    backend_response_checks(argc == 2, tower_test_buffer_count, tower_test_buffer_allocations,
        tower_test_buffer_fail_after);
    return 0;
}
