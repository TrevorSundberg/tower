import tower;
import semantic_flow_checks_test;

fn main(): i32 {
    var failures: u32 = 0;
    for(var mode: u32 = 0; mode < convert(u32, FlowCase.Count); mode++) {
        failures += flow_trial(1, convert(FlowCase, mode));
        failures += flow_trial(4, convert(FlowCase, mode));
    }
    return failures == 0 ? 0 : 1;
}
