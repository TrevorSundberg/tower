import .library.testing;
import backend_constant_address_api;
import .library.bytes_interface;
import .library.bytes_types;
import .library.work_budget_types;

extern fn driver_read_file(path: u8*, out: ByteBuffer*): bool;
extern fn getenv(name: u8*): u8*;
extern fn strcmp(left: u8*, right: u8*): i32;
extern fn strstr(text: u8*, part: u8*): u8*;
extern fn memcmp(left: u8*, right: u8*, size: usize): i32;

fn constant_operand_verified(valid: bool): void {
    assert(valid, "Unsupported constant remains valid LLVM");
}

fn constant_operand_check(result: ConstantOperandResult*, prior: bool): void {
    var wanted = prior ? "Earlier constant operand error" : "Unsupported LLVM value in foundation return path";
    assert(!result.accepted && result.diagnostic != null && strcmp(result.diagnostic, wanted) == 0
        && result.resource == WorkBudgetError.None && result.offset == (prior ? 23 : 0),
        "Constant operand exact unsupported diagnostic and first cause");
    assert(result.nodes_before == result.nodes_after && result.components_before == result.components_after
        && result.children == 0 && !result.has_semantic, "Constant operand failure publishes no partial stage");
}

fn constant_address_check(width: u32, parses: usize, response: u8*, ir: u8*, foundation: u8*): void {
    assert(parses == 2 && strstr(response, "\"status\":\"compiled\"") != null
        && strstr(response, "\"format\":\"foundation\"") != null, "Compile and reparse reconstructed Foundation");
    var store = width == 4
        ? "store i8 19, ptr inttoptr (i32 sub (i32 add (i32 ptrtoint (ptr @tower.global.storage to i32), i32 4), i32 1) to ptr)"
        : "store i8 19, ptr inttoptr (i64 sub (i64 add (i64 ptrtoint (ptr @tower.global.storage to i64), i64 4), i64 1) to ptr)";
    assert(ir != null && strstr(ir, store) != null, "Store at the guest-width global address plus four minus one");
    assert(foundation != null && strstr(foundation, width == 4 ? ": u32 = 3;" : ": u64 = 3;") != null
        && strstr(foundation, ": u8 = 19;") != null, "Foundation retains the last byte displacement and value");
}

fn constant_address_case(width: u8*, workers: u8*, output: u8*): void {
    var runtime = getenv("TOWER_CONSTANT_ADDRESS_RUNTIME");
    assert(runtime != null, "Supply the Wasm runtime object for backend reconstruction");
    var args: u8*[9] = {"backend-source", ".tower/bedrock.tower", ".tower/foundation.tower", runtime,
        ".tower/tests/backend_constant_address.tower", output, width, workers, "constant-address"};
    var checks: ConstantAddressChecks = {verified: constant_operand_verified, operand: constant_operand_check, compiled: constant_address_check};
    assert(backend_source_native_run(convert(i32, sizeof(decltype(args)) / sizeof(u8*)), &args[0], &checks) == 0,
        "Write the checked Foundation and optimized LLVM");
}

fn constant_address_equal(serial: u8*, parallel: u8*): void {
    var first: ByteBuffer = default;
    var second: ByteBuffer = default;
    defer { bytes_dispose(&first); bytes_dispose(&second); }
    assert(driver_read_file(serial, &first) && driver_read_file(parallel, &second),
        "Read both reconstructed outputs");
    assert(first.length != 0 && first.length == second.length && memcmp(first.data, second.data, first.length) == 0,
        "Serial and four-worker Foundation must match byte for byte");
}

test() { constant_address_case("4", "1", "constant_address_4_1.tower"); }
test() { constant_address_case("4", "4", "constant_address_4_4.tower"); }
test() { constant_address_equal("constant_address_4_1.tower", "constant_address_4_4.tower"); }
test() { constant_address_case("8", "1", "constant_address_8_1.tower"); }
test() { constant_address_case("8", "4", "constant_address_8_4.tower"); }
test() { constant_address_equal("constant_address_8_1.tower", "constant_address_8_4.tower"); }
