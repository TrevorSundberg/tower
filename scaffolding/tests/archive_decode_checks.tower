import tower;
import utility_checks;
import .library.bytes;
import .library.bytes_types;
import .library.vector;
import .library.deflate;
import .library.inflate;
import .library.gzip_archive;
import .library.gzip_decode;
import .library.crc32;
import .library.archive_decode;
import .tools.tool_files_posix;
import .tools.tool_streams_posix;
import .tools.tool_process_linux;
import .tools.tool_capture_linux;
import .host.driver_files;

enum DecodePattern: usize { Random, Run, Alphabet, Window, Count }

fn decode_external(gzip: u8*, option: u8*, path: u8*, out: ByteBuffer*): void {
    var args: vector(u8*) = default; defer vector_dispose(&args);
    var capture_limit: usize = 16777216;
    utility_check(tool_process_argument(&args, gzip) && tool_process_argument(&args, "-n")
        && tool_process_argument(&args, "-c") && tool_process_argument(&args, option)
        && tool_process_argument(&args, "--") && tool_process_argument(&args, path)
        && tool_process_argument(&args, null), "gzip explicit argv");
    utility_check(tool_capture(gzip, args.data, capture_limit, out) == 0, "independent gzip process");
}

fn decode_compare(encoded: ByteBuffer*, input: ByteBuffer*): void {
    var output: ByteBuffer = default; defer bytes_dispose(&output);
    var result = gzip_decode(encoded.data, encoded.length, input.length, &output);
    if result != ArchiveDecodeResult.Ok { print(convert(i32, result)); }
    utility_check(result == ArchiveDecodeResult.Ok && output.length == input.length
        && utility_equal(output.data, input.data, input.length), "exact decoded bytes");
    if input.length != 0 {
        var saved = output.data;
        utility_check(gzip_decode(encoded.data, encoded.length, input.length - 1, &output) == ArchiveDecodeResult.Limit
            && output.data == saved && output.length == input.length, "bounded decoding preserves output");
    }
    utility_check(bytes_assign_text(&output, encoded.data, encoded.length)
        && gzip_decode(output.data, output.length, input.length, &output) == ArchiveDecodeResult.Ok
        && output.length == input.length && utility_equal(output.data, input.data, input.length), "aliased compressed input");
}

fn decode_corruption(): void {
    var encoded: ByteBuffer = default; var output: ByteBuffer = default;
    defer bytes_dispose(&encoded); defer bytes_dispose(&output);
    utility_check(gzip_compress("abc", 3, &encoded) && bytes_assign_text(&output, "keep", 4), "corruption fixture");
    var saved = output.data; var limit: usize = 1024;
    for (var length: usize = 0; length < encoded.length; length++) {
        utility_check(gzip_decode(encoded.data, length, limit, &output) != ArchiveDecodeResult.Ok
            && output.data == saved && output.length == 4, "every truncated gzip prefix rejected atomically");
    }
    encoded.data[encoded.length - GzipTrailerBytes] ^= 1;
    utility_check(gzip_decode(encoded.data, encoded.length, limit, &output) == ArchiveDecodeResult.Checksum, "bad CRC rejected");
    encoded.data[encoded.length - GzipTrailerBytes] ^= 1;
    encoded.data[encoded.length - 1] ^= 1;
    utility_check(gzip_decode(encoded.data, encoded.length, limit, &output) == ArchiveDecodeResult.Checksum, "bad size rejected");
    encoded.data[encoded.length - 1] ^= 1;
    utility_check(bytes_append(&encoded, encoded.data, encoded.length)
        && gzip_decode(encoded.data, encoded.length, limit, &output) == ArchiveDecodeResult.Ok
        && output.length == 6 && utility_equal(output.data, "abcabc", 6), "concatenated gzip members");
    utility_check(bytes_push(&encoded, 0) && gzip_decode(encoded.data, encoded.length, limit, &output) != ArchiveDecodeResult.Ok,
        "trailing bytes rejected");
    var reserved: u8 = 7; var consumed: usize = 123;
    utility_check(inflate_decode(&reserved, 1, limit, &output, &consumed) == ArchiveDecodeResult.InvalidBlock
        && consumed == 123, "reserved DEFLATE block and unchanged extent");
    var writer: DeflateBits = { limit: limit, ok: true, ..default }; defer bytes_dispose(&writer.output);
    var final_fixed: u32 = 3; var header_bits: u32 = 3;
    deflate_put(&writer, final_fixed, header_bits); deflate_match(&writer, 3, 1);
    deflate_symbol(&writer, DeflateEndCode); deflate_put(&writer, 0, DeflateByteBits - writer.count);
    utility_check(inflate_decode(writer.output.data, writer.output.length, limit, &output, &consumed)
        == ArchiveDecodeResult.InvalidDistance, "match cannot precede stream output");
}

fn decode_optional_header(): void {
    var encoded: ByteBuffer = default; var header: ByteBuffer = default; var output: ByteBuffer = default;
    defer bytes_dispose(&encoded); defer bytes_dispose(&header); defer bytes_dispose(&output);
    utility_check(gzip_compress("abc", 3, &encoded) && bytes_append(&header, encoded.data, GzipHeaderBytes), "optional header base");
    var flags_offset: usize = 3;
    header.data[flags_offset] = convert(u8, GzipFlag.Extra) | convert(u8, GzipFlag.Name)
        | convert(u8, GzipFlag.Comment) | convert(u8, GzipFlag.HeaderCrc) | convert(u8, GzipFlag.Text);
    utility_check(bytes_push(&header, 3) && bytes_push(&header, 0) && bytes_append(&header, "xyz", 3)
        && bytes_append(&header, "name", 5) && bytes_append(&header, "comment", 8), "optional fields");
    var checksum = crc32_update(0, header.data, header.length); var mask: u32 = 255; var byte_bits: u32 = 8;
    utility_check(bytes_push(&header, convert(u8, checksum & mask)) && bytes_push(&header, convert(u8, (checksum >> byte_bits) & mask)), "header CRC");
    var crc_at = header.length - GzipShortBytes;
    utility_check(bytes_append(&header, encoded.data + GzipHeaderBytes, encoded.length - GzipHeaderBytes)
        && gzip_decode(header.data, header.length, 3, &output) == ArchiveDecodeResult.Ok
        && output.length == 3 && utility_equal(output.data, "abc", 3), "optional gzip header decoded");
    header.data[crc_at] ^= 1;
    utility_check(gzip_decode(header.data, header.length, 3, &output) == ArchiveDecodeResult.Checksum, "header checksum rejection");
}

fn decode_dynamic_boundaries(): void {
    var writer: DeflateBits = { limit: 4096, ok: true, ..default }; defer bytes_dispose(&writer.output);
    var output: ByteBuffer = default; defer bytes_dispose(&output);
    var final_dynamic: u32 = 5; var header_bits: u32 = 3; var count_bits: u32 = 5; var code_count_bits: u32 = 4;
    var code_width_bits: u32 = 3; var extended_code_count: u32 = 14; var total_code_lengths: u32 = 18;
    var zero_order: u32 = 3; var one_order: u32 = 17; var literal_bytes: u32 = 256;
    // Literal alphabet contains only one one-bit EOB; distance alphabet empty.
    deflate_put(&writer, final_dynamic, header_bits); deflate_put(&writer, 0, count_bits);
    deflate_put(&writer, 0, count_bits); deflate_put(&writer, extended_code_count, code_count_bits);
    for (var at: u32 = 0; at < total_code_lengths; at++) {
        deflate_put(&writer, at == zero_order || at == one_order ? 1 : 0, code_width_bits);
    }
    for (var at: u32 = 0; at < literal_bytes; at++) { deflate_put(&writer, 0, 1); }
    deflate_put(&writer, 1, 1); deflate_put(&writer, 0, 1); deflate_put(&writer, 0, 1);
    if writer.count != 0 { deflate_put(&writer, 0, DeflateByteBits - writer.count); }
    var consumed: usize = 0;
    utility_check(inflate_decode(writer.output.data, writer.output.length, 0, &output, &consumed) == ArchiveDecodeResult.Ok
        && output.length == 0 && consumed == writer.output.length, "single EOB and empty distance alphabet");
    for (var length: usize = 0; length < writer.output.length; length++) {
        utility_check(inflate_decode(writer.output.data, length, 0, &output, &consumed) != ArchiveDecodeResult.Ok,
            "every truncated dynamic prefix rejected");
    }
    writer.output.length = 0; writer.pending = 0; writer.count = 0;
    deflate_put(&writer, final_dynamic, header_bits); deflate_put(&writer, 0, count_bits);
    deflate_put(&writer, 0, count_bits); deflate_put(&writer, 0, code_count_bits);
    deflate_put(&writer, 1, code_width_bits); deflate_put(&writer, 0, code_width_bits);
    deflate_put(&writer, 0, code_width_bits); deflate_put(&writer, 1, code_width_bits);
    deflate_put(&writer, 1, 1); // repeat-previous before any previous length.
    if writer.count != 0 { deflate_put(&writer, 0, DeflateByteBits - writer.count); }
    utility_check(inflate_decode(writer.output.data, writer.output.length, 0, &output, &consumed) == ArchiveDecodeResult.InvalidTree,
        "repeat without previous length rejected");
    writer.output.length = 0; writer.pending = 0; writer.count = 0;
    deflate_put(&writer, final_dynamic, header_bits); deflate_put(&writer, 0, count_bits);
    deflate_put(&writer, 0, count_bits); deflate_put(&writer, 0, code_count_bits);
    var short_code_count: u32 = 4;
    for (var at: u32 = 0; at < short_code_count; at++) { deflate_put(&writer, 1, code_width_bits); }
    if writer.count != 0 { deflate_put(&writer, 0, DeflateByteBits - writer.count); }
    utility_check(inflate_decode(writer.output.data, writer.output.length, 0, &output, &consumed) == ArchiveDecodeResult.InvalidTree,
        "oversubscribed code-length alphabet rejected");
}

export fn main(argc: i32, argv: u8**): i32 {
    var arguments: i32 = 4; var usage: i32 = 2;
    if argc != arguments { puts("Usage: archive_decode_checks FIXTURE_DIRECTORY PINNED_GZIP GZIP_EXECUTABLE"); return usage; }
    var sizes: usize[12]; var size_count: usize = 12;
    sizes[0] = 0; sizes[1] = 1; sizes[2] = 2; sizes[3] = 3; sizes[4] = 258; sizes[5] = 259;
    sizes[6] = 32767; sizes[7] = 32768; sizes[8] = 32769; sizes[9] = 65535; sizes[10] = 65536; sizes[11] = 131071;
    var path: ByteBuffer = default; var input: ByteBuffer = default; var encoded: ByteBuffer = default;
    defer bytes_dispose(&path); defer bytes_dispose(&input); defer bytes_dispose(&encoded);
    utility_check(tool_join(&path, argv[1], "fixture.bin") && tool_output_parents(path.data), "corpus path");
    var window: usize = 32768; var alphabet: usize = 26; var letter: u8 = 65;
    var byte_mask = convert(u32, ~convert(u8, 0));
    for (var pattern: usize = 0; pattern < convert(usize, DecodePattern.Count); pattern++) {
        for (var index: usize = 0; index < size_count; index++) {
            input.length = 0; utility_check(bytes_reserve(&input, sizes[index]), "corpus capacity");
            var seed: u32 = 1729;
            for (var at: usize = 0; at < sizes[index]; at++) {
                var value = convert(u8, utility_random(&seed) & byte_mask);
                if pattern == convert(usize, DecodePattern.Run) { value = letter; }
                if pattern == convert(usize, DecodePattern.Alphabet) { value = letter + convert(u8, at % alphabet); }
                if pattern == convert(usize, DecodePattern.Window) && at >= window { value = input.data[at - window]; }
                input.data[at] = value;
            }
            input.length = sizes[index];
            utility_check(gzip_compress(input.data, input.length, &encoded), "Tower encode for decoder");
            decode_compare(&encoded, &input);
            utility_check(driver_write_file(path.data, input.data, input.length), "write independent gzip input");
            decode_external(argv[3], "-9", path.data, &encoded); decode_compare(&encoded, &input);
            decode_external(argv[3], "-1", path.data, &encoded); decode_compare(&encoded, &input);
        }
    }
    var archive_limit: usize = 16777216;
    utility_check(tool_read_file(argv[2], archive_limit, &encoded), "read current pinned archive");
    decode_external(argv[3], "-d", argv[2], &input); decode_compare(&encoded, &input);
    decode_corruption(); decode_optional_header(); decode_dynamic_boundaries();
    puts("Tower archive decoding checks passed: 144 corpus streams, pinned archive and rejection fixtures");
    return 0;
}
