import library.testing;
import semantic_aggregate_admission_checks;
import semantic_admission_result;
import .compiler.semantic_query_api;
import .compiler.semantic_context_types;
import .compiler.semantic_program_types;
import .compiler.foundation_tags;
import .compiler.foundation_types;
import .library.work_graph;
import .library.work_budget_types;

extern fn admission_type_new(c: SemanticContext*, scalar: u32, pointers: u32, record: void*): FoundationType*;
extern fn admission_aggregate_prepare(c: SemanticContext*): void;
extern fn semantic_type_equal(left: FoundationType*, right: FoundationType*): bool;
extern fn compiler_world_create_workers(workers: usize): void*;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_dispose(world: void*): bool;
extern fn entity_create(store: void*): void*;

fn aggregate_admission_trial(width: u32, workers: usize, mode: AggregateAdmissionMode, result: SemanticAdmissionResult*): void {
    var world = compiler_world_create_workers(workers);
    sem_require(world != null);
    var root = entity_create(compiler_world_store(world));
    sem_require(root != null);
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, width);
    var context: SemanticContext = default;
    sem_context_init(&context, &program);
    context.generics = generic_begin(root);
    context.source = "";
    var record = sem_create(root);
    sem_attach(record, KType).type = *admission_type_new(&context, SStruct, 0, record);
    var signature = sem_create(root);
    var callback = sem_attach(signature, KType);
    callback.type = *admission_type_new(&context, SFunction, 0, signature);
    callback.element = sem_get(record).type;
    var parameter = sem_create(signature);
    sem_attach(parameter, KParameter).type = sem_get(record).type;
    sem_push(&callback.parameters, parameter);
    sem_push(&context.type_arguments, signature);
    var count = callback.parameters.length;
    var result_type = callback.element;
    var input_type = sem_get(parameter).type;
    if mode == AggregateAdmissionMode.Failed { sem_resource_record(&program, WorkBudgetError.Memory, 37); }
    if mode == AggregateAdmissionMode.Cancelled { work_cancel(&context.queries); }
    if mode == AggregateAdmissionMode.Lowering {
        var function = sem_create(root);
        var value = sem_attach(function, KFunction);
        value.type = sem_get(record).type;
        value.body = sem_create(function);
        sem_attach(value.body, KBlock);
        sem_push(&program.functions, function);
        context.node_limit = 0;
    }
    admission_aggregate_prepare(&context);
    if mode == AggregateAdmissionMode.Healthy {
        semantic_admission_check(callback.parameters.length == count + 1
            && callback.element.scalar == SVoid && sem_get(parameter).type.pointers == 1,
            "Healthy callback signature publishes aggregate arguments and result", result);
        count = callback.parameters.length;
        result_type = callback.element;
        input_type = sem_get(parameter).type;
    } else {
        semantic_admission_check(callback.parameters.length == count
            && semantic_type_equal(&callback.element, &result_type)
            && semantic_type_equal(&sem_get(parameter).type, &input_type),
            "Failed signature phase must not publish callback ABI mutation", result);
        if mode == AggregateAdmissionMode.Lowering {
            semantic_admission_check(program.error.length != 0, "Lowering case must fail in its actual worker", result);
        }
    }
    for(var repeat: usize = 0; repeat < 3; repeat++) {
        admission_aggregate_prepare(&context);
        semantic_admission_check(callback.parameters.length == count
            && semantic_type_equal(&callback.element, &result_type)
            && semantic_type_equal(&sem_get(parameter).type, &input_type)
            && context.workers.running == 0 && context.queries.running == 0,
            "Repeated phase entry preserves callback identity after joins", result);
    }
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(root);
    semantic_admission_check(compiler_world_dispose(world), "Aggregate phase releases its world", result);
}

fn aggregate_admission_cases(mode: AggregateAdmissionMode): SemanticAdmissionResult {
    var result: SemanticAdmissionResult = default;
    for(var width: u32 = 4; width <= 8; width += 4) {
        for(var workers: usize = 1; workers <= 4; workers += 3) {
            aggregate_admission_trial(width, workers, mode, &result);
        }
    }
    return result;
}

test() {
    var result = aggregate_admission_cases(AggregateAdmissionMode.Healthy);
    assert(result.failures == 0, result.first_failure);
}

test() {
    var result = aggregate_admission_cases(AggregateAdmissionMode.Failed);
    assert(result.failures == 0, result.first_failure);
}

test() {
    var result = aggregate_admission_cases(AggregateAdmissionMode.Cancelled);
    assert(result.failures == 0, result.first_failure);
}

test() {
    var result = aggregate_admission_cases(AggregateAdmissionMode.Lowering);
    assert(result.failures == 0, result.first_failure);
}
