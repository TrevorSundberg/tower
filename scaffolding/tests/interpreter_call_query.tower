import tower;
import .compiler.foundation_types;
import .compiler.foundation_tags;
import .compiler.interpreter_context_types;
import .compiler.interpreter_types;
import .library.vector;
import .library.work_budget;
import .library.work_budget_types;
import .library.work_vector;
import interpreter_call_query_support;
import interpreter_call_query_test;

fn call_query_check(ok: bool, message: u8*, failures: u32*): void {
    if !ok { puts(message); (*failures)++; }
}

// An argument mutates caller storage before the called body becomes available.
// Waiting and resuming must retain that effect exactly once, including retries
// before publication. This uses ordinary Foundation calls and the interpreter.
export fn call_query_tests(width: u32): u32 {
    var failures: u32 = 0;
    var world = compiler_world_create_workers(1);
    var root = entity_create(compiler_world_store(world));
    sem_attach(root, KProgram);
    var calls = sem_create(root);
    call_query_require(entity_register(calls, sizeof(IMFunctionInput), alignof(IMFunctionInput), 0));
    var entry = call_query_node(root, width, KFunction);
    var body = call_query_node(root, width, KBlock);
    sem_get(entry).body = body;
    sem_get(entry).frame_size = sizeof(i32);
    var counter = call_query_node(root, width, KDeclare);
    var zero = call_query_node(root, width, KOperand);
    sem_get(zero).constant = true;
    sem_get(counter).value = zero;
    call_query_push(&sem_get(entry).locals, counter);
    call_query_push(&sem_get(body).items, counter);

    var argument = call_query_node(root, width, KFunction);
    var argument_body = call_query_node(root, width, KBlock);
    sem_get(argument).body = argument_body;
    sem_get(argument).frame_size = convert(usize, width);
    var pointer = call_query_node(root, width, KParameter);
    sem_get(pointer).type.pointers = 1;
    call_query_push(&sem_get(argument).parameters, pointer);
    call_query_push(&sem_get(argument).locals, pointer);
    var loaded = call_query_node(root, width, KLoad);
    sem_get(loaded).value = call_query_read(root, width, pointer);
    var one = call_query_node(root, width, KOperand);
    sem_get(one).constant = true;
    sem_get(one).bits = 1;
    var increment = call_query_node(root, width, KBinary);
    sem_get(increment).op = OAdd;
    sem_get(increment).left = loaded;
    sem_get(increment).right = one;
    var store = call_query_node(root, width, KAssign);
    sem_get(store).target = loaded;
    sem_get(store).value = increment;
    call_query_push(&sem_get(argument_body).items, store);
    var argument_return = call_query_node(root, width, KReturn);
    sem_get(argument_return).value = loaded;
    call_query_push(&sem_get(argument_body).items, argument_return);
    var argument_input = bits(IMFunctionInput*, entity_component_data(entity_component_add(argument, calls)));
    *argument_input = default;
    argument_input.function = argument;
    argument_input.ready = true;

    var callee = call_query_node(root, width, KFunction);
    var callee_body = call_query_node(root, width, KBlock);
    sem_get(callee).body = callee_body;
    sem_get(callee).frame_size = sizeof(i32);
    var parameter = call_query_node(root, width, KParameter);
    call_query_push(&sem_get(callee).parameters, parameter);
    call_query_push(&sem_get(callee).locals, parameter);
    var callee_return = call_query_node(root, width, KReturn);
    sem_get(callee_return).value = call_query_read(root, width, parameter);
    call_query_push(&sem_get(callee_body).items, callee_return);
    var address = call_query_node(root, width, KAddress);
    sem_get(address).type.pointers = 1;
    sem_get(address).value = call_query_read(root, width, counter);
    var argument_call = call_query_node(root, width, KCall);
    sem_get(argument_call).binding = argument;
    call_query_push(&sem_get(argument_call).items, address);
    var call = call_query_node(root, width, KCall);
    sem_get(call).binding = callee;
    call_query_push(&sem_get(call).items, argument_call);
    var sum = call_query_node(root, width, KBinary);
    sem_get(sum).op = OAdd;
    sem_get(sum).left = call;
    sem_get(sum).right = call_query_read(root, width, counter);
    var returned = call_query_node(root, width, KReturn);
    sem_get(returned).value = sum;
    call_query_push(&sem_get(body).items, returned);

    // A distinct executable identity verifies selection without changing the
    // source signature or its body. Its result makes a wrong mapping observable.
    var snapshot = call_query_node(root, width, KFunction);
    var snapshot_body = call_query_node(root, width, KBlock);
    sem_get(snapshot).body = snapshot_body;
    sem_get(snapshot).frame_size = sizeof(i32);
    var snapshot_parameter = call_query_node(root, width, KParameter);
    call_query_push(&sem_get(snapshot).parameters, snapshot_parameter);
    call_query_push(&sem_get(snapshot).locals, snapshot_parameter);
    var answer = call_query_node(root, width, KOperand);
    sem_get(answer).constant = true;
    sem_get(answer).bits = 42;
    var snapshot_return = call_query_node(root, width, KReturn);
    sem_get(snapshot_return).value = answer;
    call_query_push(&sem_get(snapshot_body).items, snapshot_return);

    var invocation: IMInvocation = default;
    call_query_require(interpreter_invocation_init(&invocation, entry, convert(usize, width), null, 0, true, CallQueryFuel));
    invocation.context.type_arguments = true;
    invocation.context.executable_functions = calls;
    interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
    call_query_check(!invocation.state.done && !invocation.state.failed && invocation.context.waiting_function && invocation.context.waiting == callee,
        "An executed call suspends for its body after argument evaluation", &failures);
    var steps = invocation.state.steps;
    interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
    call_query_check(!invocation.state.failed && invocation.context.waiting_function && invocation.context.waiting == callee && invocation.state.steps == steps,
        "A still-pending body preserves the same call continuation", &failures);
    var input = bits(IMFunctionInput*, entity_component_data(entity_component_add(callee, calls)));
    *input = default;
    input.function = snapshot;
    input.ready = true;
    interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
    call_query_check(invocation.state.done && !invocation.state.failed && invocation.context.result == 43,
        "Published body resumes without replaying the argument's mutation", &failures);
    interpreter_invocation_dispose(&invocation);

    input.ready = false;
    call_query_require(interpreter_invocation_init(&invocation, entry, convert(usize, width), null, 0, true, CallQueryFuel));
    invocation.context.type_arguments = true;
    invocation.context.executable_functions = calls;
    interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
    call_query_check(invocation.context.waiting_function && invocation.context.waiting == callee && !invocation.state.failed,
        "A fresh invocation waits for pending call input", &failures);
    input.failed = true;
    input.ready = true;
    interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
    call_query_check(invocation.state.failed && invocation.context.error.length != 0,
        "Failed call publication diagnoses the retained invocation", &failures);
    interpreter_invocation_dispose(&invocation);

    input.ready = false;
    input.failed = false;
    call_query_require(interpreter_invocation_init(&invocation, entry, convert(usize, width), null, 0, true, CallQueryFuel));
    invocation.context.type_arguments = true;
    invocation.context.executable_functions = calls;
    interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
    call_query_check(invocation.context.waiting_function && invocation.context.waiting == callee && !invocation.state.failed,
        "An invocation can be disposed while its called body is pending", &failures);
    interpreter_invocation_dispose(&invocation);
    entity_release(root);
    call_query_check(compiler_world_dispose(world), "Suspended call inputs release their world", &failures);
    failures += function_query_tests(width);
    failures += map_query_tests(width);
    failures += wide_query_tests(width);
    check_input_query(width, InputQuerySmallBytes, false);
    check_input_query(width, InputQueryLargeBytes, false);
    check_input_query(width, InputQuerySmallBytes, true);
    check_input_query(width, InputQueryLargeBytes, true);
    return failures;
}

// Function references keep declaration identities outside guest memory. Exhaust
// the shared allowance only after ordinary entry storage and prior effects exist.
var FunctionQueryOffset: usize = 73;
var FunctionQueryBudgetBytes: usize = 8388608;
struct FunctionQueryCase {
    denied: bool;
    growing: bool;
    returning: bool;
}
extern fn compiler_world_create_result(limit: usize, budget: WorkBudget*, output: void**): WorkBudgetError;
extern fn strlen(text: u8*): usize;
extern fn compiler_buffer_allocation_size(bytes: usize): usize;

fn function_query_require(ok: bool, message: u8*): void {
    if !ok { puts(message); abort(); }
}

fn function_query_reference(root: void*, width: u32, binding: void*, signature: void*): void* {
    var reference = call_query_node(root, width, KFunctionReference);
    sem_get(reference).binding = binding;
    sem_get(reference).type = { scalar: SFunction, record: signature, pointer_bytes: width, ..default };
    var converted = call_query_node(root, width, KConvert);
    sem_get(converted).value = reference;
    sem_get(converted).type = sem_get(reference).type;
    sem_get(converted).start = FunctionQueryOffset;
    return converted;
}

fn function_query_print(root: void*, width: u32, number: u64): void* {
    var value = call_query_node(root, width, KOperand);
    sem_get(value).constant = true;
    sem_get(value).bits = number;
    var statement = call_query_node(root, width, KPrint);
    sem_get(statement).value = value;
    return statement;
}

fn function_query_tests(width: u32): u32 {
    var failures: u32 = 0;
    var budget: WorkBudget = default;
    var world: void* = null;
    function_query_require(work_budget_init(&budget, 1, FunctionQueryBudgetBytes, 1)
        && compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None,
        "Function-reference budgeted world creation");
    var root = entity_create(compiler_world_store(world));
    sem_attach(root, KProgram);
    var entry = call_query_node(root, width, KFunction);
    var body = call_query_node(root, width, KBlock);
    sem_get(entry).body = body;
    var signature = call_query_node(root, width, KType);
    sem_get(signature).element = { scalar: SI32, pointer_bytes: width, ..default };
    var first = call_query_node(root, width, KFunction);
    var first_value = function_query_reference(root, width, first, signature);
    call_query_push(&sem_get(body).items, first_value);
    // Obtain the actual retained extent, then construct the next ordinal before
    // any tested invocation starts. Never mutate a running input graph.
    var probe: IMInvocation = default;
    function_query_require(interpreter_invocation_init(&probe, entry, convert(usize, width), null, 0, true, CallQueryFuel),
        "Function-reference extent probe entry");
    probe.context.type_arguments = true;
    interpreter_invocation_step(&probe, convert(usize, CallQueryFuel));
    function_query_require(probe.state.done && !probe.state.failed && probe.state.function_values.length == 1,
        "Function-reference extent probe execution");
    var next_index = probe.state.function_values.capacity;
    interpreter_invocation_dispose(&probe);
    var second = call_query_node(root, width, KFunction);
    sem_get(second).index = next_index;
    var second_value = function_query_reference(root, width, second, signature);
    var first_return = call_query_node(root, width, KReturn);
    sem_get(first_return).value = sem_get(first_value).value;
    sem_get(first_return).start = FunctionQueryOffset;
    var second_return = call_query_node(root, width, KReturn);
    sem_get(second_return).value = sem_get(second_value).value;
    sem_get(second_return).start = FunctionQueryOffset;
    sem_get(body).items.length = 0;
    call_query_push(&sem_get(body).items, function_query_print(root, width, 7));
    call_query_push(&sem_get(body).items, first_value);
    call_query_push(&sem_get(body).items, function_query_print(root, width, 8));
    call_query_push(&sem_get(body).items, second_value);
    call_query_push(&sem_get(body).items, function_query_print(root, width, 9));
    // Charge unrelated memoization before pressure targets function storage.
    // Derive its extent from this complete graph, without fabricating entries.
    function_query_require(interpreter_invocation_init(&probe, entry, convert(usize, width), null, 0, false, CallQueryFuel),
        "Function-reference memoization extent probe entry");
    interpreter_invocation_step(&probe, convert(usize, CallQueryFuel));
    function_query_require(probe.state.done && !probe.state.failed && probe.context.output.data != null
        && strcmp(probe.context.output.data, "7\n8\n9\n") == 0,
        "Function-reference memoization extent probe execution");
    var sequencing_extent = probe.state.sequenced.capacity;
    interpreter_invocation_dispose(&probe);
    var baseline: WorkBudgetSnapshot = default;
    call_query_require(work_budget_snapshot(&budget, &baseline));
    var runtime_cases: FunctionQueryCase[3] = default;
    runtime_cases[1] = { denied: true, ..default };
    runtime_cases[2] = { denied: true, growing: true, ..default };
    for(var mode: usize = 0; mode < sizeof(decltype(runtime_cases)) / sizeof(FunctionQueryCase); mode++) {
        var denied = runtime_cases[mode].denied;
        var growing = runtime_cases[mode].growing;
        var invocation: IMInvocation = default;
        function_query_require(interpreter_invocation_init(&invocation, entry, convert(usize, width), null, 0, false, CallQueryFuel),
            "Function-reference runtime entry before pressure");
        invocation.context.type_arguments = true;
        function_query_require(work_vector_reserve_result(&invocation.state.sequenced, &budget, sequencing_extent)
            == WorkBudgetError.None, "Function-reference runtime pre-admits measured memoization");
        var preceding_output = growing ? "7\n8\n" : "7\n";
        var output_bytes = strlen(preceding_output);
        for(var step: u64 = 0; step < CallQueryFuel && invocation.context.output.length < output_bytes; step++) {
            interpreter_invocation_step(&invocation, 1);
        }
        function_query_require(!invocation.state.done && !invocation.state.failed
            && invocation.context.output.length == output_bytes && strcmp(invocation.context.output.data, preceding_output) == 0
            && invocation.state.function_values.length == (growing ? 1 : 0),
            "Function-reference preceding runtime effects and table extent");
        var original = invocation.state.function_values.data;
        var length = invocation.state.function_values.length;
        var capacity = invocation.state.function_values.capacity;
        var reservation = invocation.state.function_values.reservation;
        var occupied: WorkReservation = default;
        if denied {
            var remaining: WorkBudgetSnapshot = default;
            call_query_require(work_budget_snapshot(&budget, &remaining)
                && work_budget_reserve_result(&budget, 0, 0, remaining.bytes - remaining.used_bytes, &occupied)
                    == WorkBudgetError.None);
        }
        interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
        if denied {
            call_query_check(invocation.state.done && invocation.state.failed
                && invocation.state.storage_error == WorkBudgetError.Capacity
                && invocation.state.error_offset == FunctionQueryOffset
                && invocation.context.error.data == null && invocation.context.error.length == 0
                && strcmp(invocation.context.output.data, preceding_output) == 0
                && invocation.state.function_values.data == original
                && invocation.state.function_values.length == length
                && invocation.state.function_values.capacity == capacity
                && invocation.state.function_values.reservation.active == reservation.active
                && invocation.state.function_values.reservation.owner == reservation.owner
                && invocation.state.function_values.reservation.slot == reservation.slot
                && invocation.state.function_values.reservation.generation == reservation.generation
                && invocation.state.function_values.reservation.bytes == reservation.bytes,
                "Function-index denial preserves exact failure, preceding effects and original storage", &failures);
            call_query_require(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None);
            var steps = invocation.state.steps;
            interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
            call_query_check(invocation.state.done && invocation.state.failed
                && invocation.state.steps == steps && strcmp(invocation.context.output.data, preceding_output) == 0,
                "Released function-index allowance cannot replay a failed invocation", &failures);
        } else {
            call_query_check(invocation.state.done && !invocation.state.failed
                && strcmp(invocation.context.output.data, "7\n8\n9\n") == 0
                && invocation.state.function_values.length == next_index + 1
                && invocation.state.function_values.data[0] == first
                && invocation.state.function_values.data[next_index] == second
                && invocation.state.function_values.reservation.active
                && invocation.state.function_values.reservation.owner == &budget
                && invocation.state.function_values.reservation.bytes
                    == compiler_buffer_allocation_size(invocation.state.function_values.capacity * sizeof(void*)),
                "Function references preserve their declaration ordinals across table growth", &failures);
            for(var index: usize = 1; index < next_index; index++) {
                call_query_check(invocation.state.function_values.data[index] == null,
                    "Unused function ordinals remain empty", &failures);
            }
        }
        interpreter_invocation_dispose(&invocation);
        var released: WorkBudgetSnapshot = default;
        call_query_require(work_budget_snapshot(&budget, &released));
        call_query_check(released.used_bytes == baseline.used_bytes && released.live == baseline.live,
            "Function-index disposal returns every private grant to its world", &failures);
    }
    // Staged evaluation has no output capability. Exercise the same admission
    // sites without adding an unsupported effect to the fixture's contract.
    var staged_cases: FunctionQueryCase[4] = default;
    staged_cases[1] = { growing: true, ..default };
    staged_cases[2] = { returning: true, ..default };
    staged_cases[3] = { growing: true, returning: true, ..default };
    for(var mode: usize = 0; mode < sizeof(decltype(staged_cases)) / sizeof(FunctionQueryCase); mode++) {
        var growing = convert(usize, staged_cases[mode].growing);
        var returning = staged_cases[mode].returning;
        sem_get(body).items.length = 0;
        if returning {
            sem_get(entry).type = sem_get(first_value).type;
            if growing != 0 { call_query_push(&sem_get(body).items, first_value); }
            call_query_push(&sem_get(body).items, growing != 0 ? second_return : first_return);
        } else {
            call_query_push(&sem_get(body).items, first_value);
            call_query_push(&sem_get(body).items, second_value);
        }
        var invocation: IMInvocation = default;
        function_query_require(interpreter_invocation_init(&invocation, entry, convert(usize, width), null, 0, true, CallQueryFuel),
            "Function-reference staged entry before pressure");
        function_query_require(work_vector_reserve_result(&invocation.state.sequenced, &budget, sequencing_extent)
            == WorkBudgetError.None, "Function-reference staged pre-admits measured memoization");
        if growing != 0 { interpreter_invocation_step(&invocation, 1); }
        function_query_require(!invocation.state.done && !invocation.state.failed
            && invocation.state.function_values.length == growing,
            "Function-reference staged entry reaches the selected table extent");
        var original = invocation.state.function_values.data;
        var capacity = invocation.state.function_values.capacity;
        var reservation = invocation.state.function_values.reservation;
        var occupied: WorkReservation = default;
        var remaining: WorkBudgetSnapshot = default;
        function_query_require(work_budget_snapshot(&budget, &remaining)
            && work_budget_reserve_result(&budget, 0, 0, remaining.bytes - remaining.used_bytes, &occupied)
                == WorkBudgetError.None, "Function-reference staged pressure uses the actual remainder");
        interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
        call_query_check(invocation.state.done && invocation.state.failed
            && invocation.state.storage_error == WorkBudgetError.Capacity
            && invocation.state.error_offset == FunctionQueryOffset
            && invocation.context.error.data == null && invocation.context.error.length == 0
            && invocation.context.output.length == 0
            && invocation.state.function_values.data == original
            && invocation.state.function_values.length == growing
            && invocation.state.function_values.capacity == capacity
            && invocation.state.function_values.reservation.active == reservation.active
            && invocation.state.function_values.reservation.owner == reservation.owner
            && invocation.state.function_values.reservation.slot == reservation.slot
            && invocation.state.function_values.reservation.generation == reservation.generation
            && invocation.state.function_values.reservation.bytes == reservation.bytes
            && !invocation.context.returned,
            returning ? "Failed function-reference return cannot publish a result"
                : "Staged function-index denial preserves exact failure and original storage", &failures);
        call_query_require(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None);
        var steps = invocation.state.steps;
        interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
        call_query_check(invocation.state.done && invocation.state.failed && invocation.state.steps == steps,
            "Staged function-index denial stays terminal after pressure is released", &failures);
        interpreter_invocation_dispose(&invocation);
        var released: WorkBudgetSnapshot = default;
        call_query_require(work_budget_snapshot(&budget, &released));
        call_query_check(released.used_bytes == baseline.used_bytes && released.live == baseline.live,
            "Staged function-index disposal retires every private owner", &failures);
    }
    entity_release(root);
    call_query_require(compiler_world_dispose(world));
    var released: WorkBudgetSnapshot = default;
    call_query_check(work_budget_snapshot(&budget, &released) && released.used_bytes == 0
        && released.live == 0 && work_budget_dispose(&budget),
        "Function-reference world outlives and retires all private owners", &failures);
    return failures;
}

struct MapQueryCase {
    subject: void*;
    phase: usize;
    frames: usize;
    message: u8*;
    preceding: u8*;
}

var MapQueryBudgetBytes: usize = 33554432;
var MapQueryOffset: usize = 91;
var MapQueryStatementPhase: usize = 0;
var MapQueryFinishAddressPhase: usize = 5;

fn map_query_at(invocation: IMInvocation*, selected: MapQueryCase*): bool {
    if invocation.state.frame_count != selected.frames { return false; }
    var tasks = &invocation.state.frames.data[invocation.state.frames.length - 1].tasks;
    if tasks.length == 0 { return false; }
    var pending = &tasks.data[tasks.length - 1];
    return pending.node == selected.subject && pending.phase == selected.phase;
}

// Reach real continuations, then deny precisely their cache admission. All
// unrelated pre-admitted extents come from a successful run of the same graph.
fn map_query_tests(width: u32): u32 {
    var failures: u32 = 0;
    var budget: WorkBudget = default;
    var world: void* = null;
    function_query_require(work_budget_init(&budget, 1, MapQueryBudgetBytes, 1)
        && compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None, "Map query world");
    var root = entity_create(compiler_world_store(world));
    sem_attach(root, KProgram);
    var entry = call_query_node(root, width, KFunction);
    sem_get(entry).frame_size = sizeof(i32);
    var body = call_query_node(root, width, KBlock);
    sem_get(entry).body = body;
    var before = function_query_print(root, width, 7);
    sem_get(before).start = MapQueryOffset;
    call_query_push(&sem_get(body).items, before);
    var callee = call_query_node(root, width, KFunction);
    var callee_body = call_query_node(root, width, KBlock);
    sem_get(callee).body = callee_body;
    call_query_push(&sem_get(callee_body).items, function_query_print(root, width, 8));
    var result = call_query_node(root, width, KOperand);
    sem_get(result).constant = true;
    sem_get(result).bits = 37;
    var returned = call_query_node(root, width, KReturn);
    sem_get(returned).value = result;
    sem_get(returned).start = MapQueryOffset;
    call_query_push(&sem_get(callee_body).items, returned);
    var call = call_query_node(root, width, KCall);
    sem_get(call).binding = callee;
    sem_get(call).start = MapQueryOffset;
    var local = call_query_node(root, width, KDeclare);
    sem_get(local).value = call;
    sem_get(local).start = MapQueryOffset;
    call_query_push(&sem_get(body).items, local);
    var text = call_query_node(root, width, KString);
    sem_get(text).type = { scalar: SU8, pointers: 1, pointer_bytes: width, ..default };
    function_query_require(vector_push(&sem_get(text).name, convert(u8, 109)), "Map query string storage");
    var printed = call_query_node(root, width, KPrint);
    sem_get(printed).value = text;
    sem_get(printed).start = MapQueryOffset;
    call_query_push(&sem_get(body).items, printed);
    call_query_push(&sem_get(body).items, function_query_print(root, width, 9));
    var probe: IMInvocation = default;
    function_query_require(interpreter_invocation_init(&probe, entry, convert(usize, width), null, 0, false, CallQueryFuel),
        "Map query successful probe entry");
    interpreter_invocation_step(&probe, convert(usize, CallQueryFuel));
    function_query_require(probe.state.done && !probe.state.failed && probe.state.strings.length == 1,
        "Map query successful probe execution");
    var sequencing_extent = probe.state.sequenced.capacity;
    var allocation_extent = probe.state.allocations.capacity;
    var free_extent = probe.state.free_blocks.capacity;
    var memory_extent = probe.state.memory.capacity;
    interpreter_invocation_dispose(&probe);
    var cases: MapQueryCase[4] = default;
    cases[0] = { subject: before, phase: MapQueryStatementPhase, frames: 1,
        message: "Cannot allocate interpreter sequencing storage", preceding: "" };
    cases[1] = { subject: local, phase: MapQueryFinishAddressPhase, frames: 1,
        message: "Cannot allocate interpreter address storage", preceding: "7\n" };
    cases[2] = { subject: returned, phase: MapQueryStatementPhase, frames: 2,
        message: "Cannot allocate interpreter value storage", preceding: "7\n8\n" };
    cases[3] = { subject: printed, phase: MapQueryStatementPhase, frames: 1,
        message: "Cannot allocate interpreter string storage", preceding: "7\n8\n" };
    var baseline: WorkBudgetSnapshot = default;
    function_query_require(work_budget_snapshot(&budget, &baseline), "Map query baseline");
    for(var i: usize = 0; i < sizeof(decltype(cases)) / sizeof(MapQueryCase); i++) {
        var selected = &cases[i];
        var invocation: IMInvocation = default;
        function_query_require(interpreter_invocation_init(&invocation, entry, convert(usize, width), null, 0, false, CallQueryFuel),
            "Map query entry before pressure");
        if selected.subject != before {
            function_query_require(work_vector_reserve_result(&invocation.state.sequenced, &budget, sequencing_extent)
                == WorkBudgetError.None, "Map query measured sequencing admission");
        }
        if selected.subject == printed {
            function_query_require(work_vector_reserve_result(&invocation.state.memory, &budget, memory_extent)
                == WorkBudgetError.None
                && work_vector_reserve_result(&invocation.state.allocations, &budget, allocation_extent) == WorkBudgetError.None
                && work_vector_reserve_result(&invocation.state.free_blocks, &budget, free_extent) == WorkBudgetError.None,
                "Map query measured guest-storage admission");
        }
        for(var step: u64 = 0; step < CallQueryFuel && !invocation.state.done && !invocation.state.failed
            && !map_query_at(&invocation, selected); step++) { interpreter_invocation_step(&invocation, 1); }
        function_query_require(!invocation.state.done && !invocation.state.failed && map_query_at(&invocation, selected),
            "Map query reaches its real queued continuation before pressure");
        var remaining: WorkBudgetSnapshot = default;
        var occupied: WorkReservation = default;
        function_query_require(work_budget_snapshot(&budget, &remaining)
            && work_budget_reserve_result(&budget, 0, 0, remaining.bytes - remaining.used_bytes, &occupied)
                == WorkBudgetError.None, "Map query exact remaining pressure");
        interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
        call_query_check(invocation.state.done && invocation.state.failed
            && invocation.state.storage_error == WorkBudgetError.Capacity && invocation.state.error_offset == MapQueryOffset
            && invocation.context.error.data == null && invocation.context.error.length == 0
            && !invocation.context.returned && invocation.context.output.length == strlen(selected.preceding)
            && (invocation.context.output.length == 0 || strcmp(invocation.context.output.data, selected.preceding) == 0),
            selected.message, &failures);
        function_query_require(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None,
            "Map query pressure releases");
        var steps = invocation.state.steps;
        interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
        call_query_check(invocation.state.done && invocation.state.failed && invocation.state.steps == steps
            && invocation.context.output.length == strlen(selected.preceding) && !invocation.context.returned,
            "Map query failure cannot replay effects after allowance returns", &failures);
        interpreter_invocation_dispose(&invocation);
        var released: WorkBudgetSnapshot = default;
        call_query_check(work_budget_snapshot(&budget, &released) && released.used_bytes == baseline.used_bytes
            && released.live == baseline.live, "Map query disposal retires every retained owner", &failures);
    }
    entity_release(root);
    function_query_require(compiler_world_dispose(world), "Map query world disposal");
    var released: WorkBudgetSnapshot = default;
    call_query_check(work_budget_snapshot(&budget, &released) && released.used_bytes == 0 && released.live == 0
        && work_budget_dispose(&budget), "Map query budget outlives its world and invocations", &failures);
    return failures;
}

var WideQueryOffset: usize = 117;
var WideQueryFinishValuePhase: usize = 4;
var WideQueryCalleeEffect: u64 = 1000;

fn wide_query_number(root: void*, width: u32, value: u64): void* {
    var node = call_query_node(root, width, KOperand);
    sem_get(node).constant = true;
    sem_get(node).bits = value;
    return node;
}

fn wide_query_binary(root: void*, width: u32, op: u32, left: void*, right: void*): void* {
    var node = call_query_node(root, width, KBinary);
    sem_get(node).op = op;
    sem_get(node).left = left;
    sem_get(node).right = right;
    return node;
}

fn wide_query_increment(root: void*, width: u32, body: void*, pointer: void*, amount: u64): void* {
    var loaded = call_query_node(root, width, KLoad);
    sem_get(loaded).value = call_query_read(root, width, pointer);
    var assigned = call_query_node(root, width, KAssign);
    sem_get(assigned).target = loaded;
    sem_get(assigned).value = wide_query_binary(root, width, OAdd, loaded, wide_query_number(root, width, amount));
    call_query_push(&sem_get(body).items, assigned);
    return loaded;
}

// Argument effects finish before temporary admission. A denial must preserve
// those effects, skip the callee and stay terminal when allowance is restored.
fn wide_query_tests(width: u32): u32 {
    var failures: u32 = 0;
    var budget: WorkBudget = default;
    var world: void* = null;
    function_query_require(work_budget_init(&budget, 1, MapQueryBudgetBytes, 1)
        && compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None, "Wide call world");
    var root = entity_create(compiler_world_store(world));
    sem_attach(root, KProgram);
    var entry = call_query_node(root, width, KFunction);
    var body = call_query_node(root, width, KBlock);
    sem_get(entry).body = body;
    sem_get(entry).frame_size = sizeof(i32);
    var counter = call_query_node(root, width, KDeclare);
    sem_get(counter).value = wide_query_number(root, width, 0);
    call_query_push(&sem_get(entry).locals, counter);
    call_query_push(&sem_get(body).items, counter);
    var address = call_query_node(root, width, KAddress);
    sem_get(address).type.pointers = 1;
    sem_get(address).value = call_query_read(root, width, counter);
    var argument = call_query_node(root, width, KFunction);
    var argument_body = call_query_node(root, width, KBlock);
    sem_get(argument).body = argument_body;
    sem_get(argument).frame_size = convert(usize, width);
    var argument_pointer = call_query_node(root, width, KParameter);
    sem_get(argument_pointer).type.pointers = 1;
    call_query_push(&sem_get(argument).parameters, argument_pointer);
    call_query_push(&sem_get(argument).locals, argument_pointer);
    var argument_return = call_query_node(root, width, KReturn);
    sem_get(argument_return).value = wide_query_increment(root, width, argument_body, argument_pointer, 1);
    call_query_push(&sem_get(argument_body).items, argument_return);
    var callee = call_query_node(root, width, KFunction);
    var callee_body = call_query_node(root, width, KBlock);
    sem_get(callee).body = callee_body;
    var pointer = call_query_node(root, width, KParameter);
    sem_get(pointer).type.pointers = 1;
    call_query_push(&sem_get(callee).parameters, pointer);
    call_query_push(&sem_get(callee).locals, pointer);
    wide_query_increment(root, width, callee_body, pointer, WideQueryCalleeEffect);
    var call = call_query_node(root, width, KCall);
    sem_get(call).binding = callee;
    sem_get(call).start = WideQueryOffset;
    call_query_push(&sem_get(call).items, address);
    var argument_count = sizeof(InterpreterInlineArgumentStorage) / sizeof(u64);
    var sum = wide_query_number(root, width, 0);
    var wanted: u64 = 0;
    for(var i: usize = 0; i < argument_count; i++) {
        var parameter = call_query_node(root, width, KParameter);
        sem_get(parameter).byte_offset = convert(usize, width) + i * sizeof(i32);
        sem_get(parameter).index = sem_get(callee).locals.length;
        call_query_push(&sem_get(callee).parameters, parameter);
        call_query_push(&sem_get(callee).locals, parameter);
        var ordinal = convert(u64, i + 1);
        sum = wide_query_binary(root, width, OAdd, sum, wide_query_binary(root, width, OMul,
            call_query_read(root, width, parameter), wide_query_number(root, width, ordinal)));
        wanted += ordinal * ordinal;
        var value = call_query_node(root, width, KCall);
        sem_get(value).binding = argument;
        call_query_push(&sem_get(value).items, address);
        call_query_push(&sem_get(call).items, value);
    }
    sem_get(callee).frame_size = convert(usize, width) + argument_count * sizeof(i32);
    var callee_return = call_query_node(root, width, KReturn);
    sem_get(callee_return).value = sum;
    call_query_push(&sem_get(callee_body).items, callee_return);
    var returned = call_query_node(root, width, KReturn);
    sem_get(returned).value = call;
    sem_get(returned).start = WideQueryOffset;
    call_query_push(&sem_get(body).items, returned);
    var selected: MapQueryCase = { subject: call, phase: WideQueryFinishValuePhase, frames: 1, ..default };
    var baseline: WorkBudgetSnapshot = default;
    function_query_require(work_budget_snapshot(&budget, &baseline), "Wide call baseline");
    var staged: bool[2] = default;
    staged[1] = true;
    for(var mode: usize = 0; mode < sizeof(decltype(staged)) / sizeof(bool); mode++) {
        var strict = staged[mode];
        var probe: IMInvocation = default;
        function_query_require(interpreter_invocation_init(&probe, entry, convert(usize, width), null, 0, strict, CallQueryFuel),
            "Wide call successful probe entry");
        var probe_base = probe.state.frames.data[0].base;
        probe.context.type_arguments = true;
        interpreter_invocation_step(&probe, convert(usize, CallQueryFuel));
        if !probe.state.done || probe.state.failed || !probe.context.returned || probe.context.result != wanted {
            puts(probe.context.error.data ?? "Wide call probe has no diagnostic");
            input_query_number(convert(usize, probe.context.result));
            input_query_number(convert(usize, probe.state.steps));
        }
        function_query_require(probe.state.done && !probe.state.failed && probe.context.returned && probe.context.result == wanted,
            "Wide call independently weighted argument order");
        var probe_effect: i32 = 0;
        copy(&probe_effect, probe.state.memory.data + probe_base, sizeof(i32));
        function_query_require(probe_effect == convert(i32, convert(u64, argument_count) + WideQueryCalleeEffect),
            "Successful wide call enters the callee after all argument effects");
        interpreter_invocation_dispose(&probe);
        var invocation: IMInvocation = default;
        function_query_require(interpreter_invocation_init(&invocation, entry, convert(usize, width), null, 0, strict, CallQueryFuel),
            "Wide call entry before pressure");
        invocation.context.type_arguments = true;
        for(var step: u64 = 0; step < CallQueryFuel && !invocation.state.done && !invocation.state.failed
            && !map_query_at(&invocation, &selected); step++) { interpreter_invocation_step(&invocation, 1); }
        function_query_require(map_query_at(&invocation, &selected) && !invocation.state.failed && !invocation.state.done,
            "Wide call reaches its real finish continuation");
        var base = invocation.state.frames.data[0].base;
        var before_effect: i32 = 0;
        copy(&before_effect, invocation.state.memory.data + base, sizeof(i32));
        function_query_require(before_effect == convert(i32, argument_count), "Every argument effect precedes admission");
        var remaining: WorkBudgetSnapshot = default;
        var occupied: WorkReservation = default;
        function_query_require(work_budget_snapshot(&budget, &remaining)
            && work_budget_reserve_result(&budget, 0, 0, remaining.bytes - remaining.used_bytes, &occupied)
                == WorkBudgetError.None, "Wide call exact pressure");
        var stack = invocation.state.stack;
        interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
        var effect: i32 = 0;
        copy(&effect, invocation.state.memory.data + base, sizeof(i32));
        call_query_check(invocation.state.done && invocation.state.failed && !invocation.context.returned
            && invocation.state.storage_error == WorkBudgetError.Capacity && invocation.state.error_offset == WideQueryOffset
            && invocation.context.error.data == null && invocation.context.error.length == 0
            && invocation.state.frame_count == selected.frames && invocation.state.stack == stack && effect == before_effect,
            "Wide call denial preserves effects and skips callee entry", &failures);
        function_query_require(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Wide call pressure releases");
        var steps = invocation.state.steps;
        interpreter_invocation_step(&invocation, convert(usize, CallQueryFuel));
        copy(&effect, invocation.state.memory.data + base, sizeof(i32));
        call_query_check(invocation.state.done && invocation.state.failed && invocation.state.steps == steps
            && effect == before_effect && !invocation.context.returned,
            "Wide call denial cannot replay arguments after allowance returns", &failures);
        interpreter_invocation_dispose(&invocation);
        var released: WorkBudgetSnapshot = default;
        call_query_check(work_budget_snapshot(&budget, &released) && released.used_bytes == baseline.used_bytes
            && released.live == baseline.live, "Wide call retires temporary and persistent owners", &failures);
    }
    entity_release(root);
    function_query_require(compiler_world_dispose(world), "Wide call world disposal");
    var released: WorkBudgetSnapshot = default;
    call_query_check(work_budget_snapshot(&budget, &released) && released.used_bytes == 0 && released.live == 0
        && work_budget_dispose(&budget), "Wide call budget cleanup", &failures);
    return failures;
}
