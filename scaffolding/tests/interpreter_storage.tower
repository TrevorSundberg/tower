import .compiler.interpreter_types;
import tower;
import .compiler.interpreter_abi;
import .compiler.interpreter_storage;
import .library.work_budget;

// Execution-space ownership and allocation-failure tests, run at both widths.
extern fn tower_test_buffer_fail_next(): void;

extern fn tower_test_buffer_count(): usize;
extern fn compiler_buffer_allocation_size(bytes: usize): usize;

export fn interpreter_storage_tests(): i32 {
    var baseline = tower_test_buffer_count();
    var state: IMState;
    fill(&state, 0, sizeof(IMState));
    var ok = im_memory_resize(&state, 128);
    if !ok {
        return 501;
    }
    var i: usize = 0;
    for(; i != 128; i++) {
        ok = state.memory.data[i] == 0;
        if !ok {
            return 502;
        }
        state.memory.data[i] = 93;
    }
    var original = state.memory.data;
    var capacity = state.memory.capacity;
    var larger = capacity + 1;
    tower_test_buffer_fail_next();
    ok = im_memory_resize(&state, larger);
    if ok {
        return 503;
    }
    ok = state.memory.data == original;
    if !ok {
        return 504;
    }
    ok = state.memory.capacity == capacity;
    if !ok {
        return 505;
    }
    ok = state.memory.length == 128;
    if !ok {
        return 506;
    }
    ok = state.memory.data[127] == 93;
    if !ok {
        return 507;
    }
    ok = im_memory_resize(&state, 8);
    if !ok {
        return 508;
    }
    ok = im_memory_resize(&state, 16);
    if !ok {
        return 509;
    }
    ok = state.memory.data[7] == 93;
    if !ok {
        return 510;
    }
    i = 8;
    for(; i != 16; i++) {
        ok = state.memory.data[i] == 0;
        if !ok {
            return 511;
        }
    }
    ok = im_memory_resize(&state, larger);
    if !ok {
        return 512;
    }
    ok = state.memory.data[7] == 93;
    if !ok {
        return 513;
    }
    var end = larger -1;
    ok = state.memory.data[end] == 0;
    if !ok {
        return 514;
    }
    interpreter_storage_dispose(&state);
    ok = state.memory.data == null;
    if !ok {
        return 515;
    }
    var live = tower_test_buffer_count();
    ok = live == baseline;
    if !ok {
        return 516;
    }
    return interpreter_container_tests();
}

fn interpreter_container_tests(): i32 {
    var baseline = tower_test_buffer_count();
    var state: IMState;
    fill(&state, 0, sizeof(IMState));
    var i: u64 = 0;
    for(; i != 257; i++) {
        var key = i *37;
        key = key % 257;
        var value = key *3;
        im_allocations_set(&state, key, value);
    }
    im_allocations_set(&state, 18446744073709551615, 99);
    im_allocations_set(&state, 9223372036854775808, 98);
    im_allocations_set(&state, 17, 12345);
    var found: bool = false;
    var value = im_allocations_get(&state, 17, &found);
    var ok = value == 12345;
    if !ok {
        return 601;
    }
    if !found {
        return 602;
    }
    im_allocations_set(&state, 17, 51);
    value = im_allocations_get(&state, 999, &found);
    if found {
        return 603;
    }
    i = 0;
    for(; i != 257; i++) {
        value = im_allocations_get(&state, i, &found);
        if !found {
            return 604;
        }
        var wanted = i *3;
        ok = value == wanted;
        if !ok {
            return 605;
        }
        var remainder = i % 2;
        if remainder == 0 {
            value = im_allocations_take(&state, i, &found);
            if !found {
                return 606;
            }
            ok = value == wanted;
            if !ok {
                return 607;
            }
            im_allocations_get(&state, i, &found);
            if found {
                return 608;
            }
        }
    }
    value = im_allocations_get(&state, 18446744073709551615, &found);
    ok = value == 99;
    if !ok {
        return 609;
    }
    if !found {
        return 610;
    }
    im_free_blocks_set(&state, 30, 300);
    im_free_blocks_set(&state, 10, 100);
    im_free_blocks_set(&state, 20, 200);
    var neighbors: IMNeighbors;
    im_free_neighbors(&state, 20, &neighbors);
    ok = neighbors.next == 20;
    if !ok {
        return 611;
    }
    ok = neighbors.previous == 10;
    if !ok {
        return 612;
    }
    ok = neighbors.next_count == 200;
    if !ok {
        return 613;
    }
    ok = neighbors.previous_count == 100;
    if !ok {
        return 614;
    }
    var count: u64 = 0;
    value = im_free_neighbor(&state, 30, false, &count);
    ok = value == 30;
    if !ok {
        return 615;
    }
    value = im_free_neighbor(&state, 10, true, &count);
    ok = value == 0;
    if !ok {
        return 616;
    }
    im_free_blocks_erase(&state, 10);
    value = im_free_first(&state, &count);
    ok = value == 20;
    if !ok {
        return 617;
    }
    var frame: usize = 0;
    for(; frame != 17; frame++) {
        if !im_frame_push(&state, null, frame, frame, null)
            || !im_task_push(&state, null, true, 1, 3)
            || !im_task_push(&state, null, false, 2, 4) { return InterpreterScheduleFailure; }
        im_values_set(&state, 1, convert(u64, frame));
        im_addresses_set(&state, 2, 42);
    }
    loop {
        if frame == 0 {
            break;
        }
        frame--;
        var base = im_base(&state);
        ok = base == frame;
        if !ok {
            return 618;
        }
        value = im_values_get(&state, 1, &found);
        ok = value == convert(u64, frame);
        if !ok {
            return 619;
        }
        if !found {
            return 620;
        }
        im_cache_clear(&state);
        im_values_get(&state, 1, &found);
        if found {
            return 621;
        }
        im_addresses_get(&state, 2, &found);
        if found {
            return 622;
        }
        var task: IMTask;
        im_task_pop(&state, &task);
        ok = task.offset == 4;
        if !ok {
            return 623;
        }
        ok = task.loop_resume == 0;
        if !ok {
            return 624;
        }
        ok = state.task_count == 1;
        if !ok {
            return 625;
        }
        im_task_pop(&state, &task);
        ok = task.offset == 3;
        if !ok {
            return 626;
        }
        ok = task.loop_resume == 1;
        if !ok {
            return 627;
        }
        im_frame_pop(&state);
        ok = state.frame_count == frame;
        if !ok {
            return 628;
        }
    }
    interpreter_storage_dispose(&state);
    var live = tower_test_buffer_count();
    ok = live == baseline;
    if !ok {
        return 629;
    }
    if !interpreter_schedule_trial(true, true) || !interpreter_schedule_trial(true, false)
        || !interpreter_schedule_trial(false, true) || !interpreter_schedule_trial(false, false) {
        return InterpreterScheduleFailure;
    }
    if !interpreter_node_cache_trial(true) || !interpreter_node_cache_trial(false) {
        return InterpreterNodeCacheFailure;
    }
    if !interpreter_maps_trial() { return InterpreterMapFailure; }
    return 0;
}

var InterpreterScheduleFailure: i32 = 630;
var InterpreterScheduleBudgetBytes: usize = 1048576;
var InterpreterNodeCacheFailure: i32 = 631;
var InterpreterNodeCacheBudgetBytes: usize = 65536;
var InterpreterMapFailure: i32 = 632;
var InterpreterMapBudgetBytes: usize = 1048576;

extern fn puts(message: u8*): i32;

// Keep these adapters independent of the setter's result ABI so this same
// capacity oracle can run against the previous unaccounted implementation.
fn interpreter_map_allocations(state: IMState*, key: u64, value: u64): void { im_allocations_set(state, key, value); }
fn interpreter_map_free(state: IMState*, key: u64, value: u64): void { im_free_blocks_set(state, key, value); }
fn interpreter_map_strings(state: IMState*, key: u64, value: u64): void { im_strings_set(state, key, value); }
fn interpreter_map_sequenced(state: IMState*, key: u64, value: u64): void { im_sequenced_set(state, key, value); }
fn interpreter_map_values(state: IMState*, key: u64, value: u64): void { im_values_set(state, key, value); }
fn interpreter_map_addresses(state: IMState*, key: u64, value: u64): void { im_addresses_set(state, key, value); }

fn interpreter_map_trial(Map: type, state: IMState*, map: Map*,
    insert: function(void, IMState*, u64, u64), name: u8*): bool {
    var budget = state.budget;
    var baseline: WorkBudgetSnapshot = default;
    var occupied: WorkReservation = default;
    defer { if occupied.active { work_budget_release(budget, &occupied); } }
    if !work_budget_snapshot(budget, &baseline)
        || !work_budget_reserve(budget, 0, 0, baseline.bytes - baseline.used_bytes, &occupied) { return false; }
    var original = *map;
    insert(state, 0, 0);
    var denied = map.data == original.data && map.length == original.length
        && map.capacity == original.capacity && state.storage_error == WorkBudgetError.Capacity
        && map.reservation.active == original.reservation.active
        && map.reservation.owner == original.reservation.owner && map.reservation.slot == original.reservation.slot
        && map.reservation.revision == original.reservation.revision && map.reservation.lanes == original.reservation.lanes
        && map.reservation.generation == original.reservation.generation && map.reservation.bytes == original.reservation.bytes;
    if !interpreter_schedule_check(denied, name) { return false; }
    if !work_budget_release(budget, &occupied) { return false; }
    insert(state, 0, 0);
    if !interpreter_schedule_check(map.length == 1 && map.data != null,
        "A map admits its first entry after allowance returns") { return false; }
    while map.length < map.capacity {
        var key = convert(u64, map.length);
        insert(state, key, key * 3);
    }
    var charged: WorkBudgetSnapshot = default;
    if !interpreter_schedule_check(work_budget_snapshot(budget, &charged)
        && charged.used_bytes == baseline.used_bytes + compiler_buffer_allocation_size(map.capacity * sizeof(IMEntry))
        && charged.live == baseline.live + 1 && map.reservation.active && map.reservation.owner == budget
        && map.reservation.bytes == compiler_buffer_allocation_size(map.capacity * sizeof(IMEntry)),
        "A map charges its complete physical buffer to the owning world") { return false; }
    original = *map;
    if !work_budget_reserve(budget, 0, 0, charged.bytes - charged.used_bytes, &occupied) { return false; }
    // Updating an existing entry never needs growth; insertion must preserve all
    // live entries when a replacement cannot be admitted.
    insert(state, 0, 17);
    insert(state, convert(u64, map.length), 99);
    if !interpreter_schedule_check(map.data == original.data && map.length == original.length
        && map.capacity == original.capacity && state.storage_error == WorkBudgetError.Capacity
        && map.reservation.active == original.reservation.active
        && map.reservation.owner == original.reservation.owner && map.reservation.slot == original.reservation.slot
        && map.reservation.revision == original.reservation.revision && map.reservation.lanes == original.reservation.lanes
        && map.reservation.generation == original.reservation.generation && map.reservation.bytes == original.reservation.bytes,
        "Denied map growth preserves its original owner and sorted extent") { return false; }
    for(var i: usize = 0; i < map.length; i++) {
        if !interpreter_schedule_check(map.data[i].key == convert(u64, i)
            && map.data[i].value == (i == 0 ? 17 : convert(u64, i) * 3),
            "Denied map growth preserves every payload and the admitted update") { return false; }
    }
    var retained: WorkBudgetSnapshot = default;
    if !interpreter_schedule_check(work_budget_snapshot(budget, &retained)
        && retained.used_bytes == charged.used_bytes + occupied.bytes && retained.live == charged.live + 1,
        "Denied map replacement retains no tentative grant") { return false; }
    if !work_budget_release(budget, &occupied) { return false; }
    insert(state, convert(u64, map.length), 99);
    return interpreter_schedule_check(map.length == original.length + 1
        && state.storage_error == WorkBudgetError.Capacity,
        "Later low-level admission preserves the first typed failure");
}

fn interpreter_maps_trial(): bool {
    var initial_buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    var state: IMState = { budget: &budget, ..default };
    defer { interpreter_storage_dispose(&state); work_budget_dispose(&budget); }
    if !work_budget_init(&budget, 1, InterpreterMapBudgetBytes, 1)
        || !im_frame_push(&state, null, 0, 0, null) { return false; }
    var ok = interpreter_map_trial(&state, &state.allocations, interpreter_map_allocations,
        "Allocation tracking must honor initial budget denial");
    ok = interpreter_map_trial(&state, &state.free_blocks, interpreter_map_free,
        "Free-range tracking must honor initial budget denial") && ok;
    ok = interpreter_map_trial(&state, &state.strings, interpreter_map_strings,
        "String memoization must honor initial budget denial") && ok;
    ok = interpreter_map_trial(&state, &state.sequenced, interpreter_map_sequenced,
        "Sequencing memoization must honor initial budget denial") && ok;
    ok = interpreter_map_trial(&state, &state.frames.data[0].values, interpreter_map_values,
        "Frame values must honor initial budget denial") && ok;
    ok = interpreter_map_trial(&state, &state.frames.data[0].addresses, interpreter_map_addresses,
        "Frame addresses must honor initial budget denial") && ok;
    interpreter_storage_dispose(&state);
    var released: WorkBudgetSnapshot = default;
    return interpreter_schedule_check(work_budget_snapshot(&budget, &released)
        && released.used_bytes == 0 && released.live == 0 && work_budget_dispose(&budget)
        && tower_test_buffer_count() == initial_buffers,
        "Every graph map and frame owner retires before its world budget") && ok;
}

// Single-owner physical failure coverage. Threaded execution uses the production
// allocator in the ordinary compiler regression and instrumentation suites.
fn interpreter_node_cache_trial(capacity_failure: bool): bool {
    var baseline = tower_test_buffer_count();
    var budget: WorkBudget = default;
    if !work_budget_init(&budget, 1, InterpreterNodeCacheBudgetBytes, 1) { return false; }
    var state: IMState = { budget: &budget, ..default };
    var occupied: WorkReservation = default;
    defer {
        if occupied.active { work_budget_release(&budget, &occupied); }
        interpreter_storage_dispose(&state);
        work_budget_dispose(&budget);
    }
    // Prepare ledger metadata before arming physical buffer allocation failure.
    if !work_budget_reserve(&budget, 0, 0, 1, &occupied)
        || !work_budget_release(&budget, &occupied) { return false; }
    if capacity_failure {
        if !work_budget_reserve(&budget, 0, 0, budget.bytes, &occupied) { return false; }
    } else { tower_test_buffer_fail_next(); }
    var wanted = capacity_failure ? WorkBudgetError.Capacity : WorkBudgetError.Memory;
    var initialized = im_node_cache_init(&state);
    var denied: WorkBudgetSnapshot = default;
    if !interpreter_schedule_check(!initialized && state.storage_error == wanted
        && state.node_cache.data == null && state.node_cache.length == 0
        && state.node_cache.capacity == 0 && !state.node_cache.reservation.active
        && work_budget_snapshot(&budget, &denied) && denied.used_bytes == (occupied.active ? occupied.bytes : 0)
        && denied.live == (occupied.active ? 1 : 0),
        "Denied node-cache startup retains its exact failure without a partial owner") { return false; }
    if occupied.active && !work_budget_release(&budget, &occupied) { return false; }
    if !im_node_cache_init(&state) { return false; }
    var admitted: WorkBudgetSnapshot = default;
    if !interpreter_schedule_check(work_budget_snapshot(&budget, &admitted)
        && admitted.used_bytes == state.node_cache.reservation.bytes && admitted.live == 1
        && state.node_cache.reservation.owner == &budget && state.storage_error == wanted,
        "Node-cache retry owns exactly its physical grant without erasing the first failure") { return false; }
    interpreter_storage_dispose(&state);
    var released: WorkBudgetSnapshot = default;
    return interpreter_schedule_check(work_budget_snapshot(&budget, &released)
        && released.used_bytes == 0 && released.live == 0 && work_budget_dispose(&budget)
        && tower_test_buffer_count() == baseline,
        "Node-cache disposal retires both physical storage and ledger metadata");
}

fn interpreter_schedule_check(ok: bool, message: u8*): bool {
    if !ok { puts(message); }
    return ok;
}

// Both scheduling arrays must preserve their live continuation and nested owners
// on denied replacement. This fixture uses the existing serial failure allocator.
fn interpreter_schedule_trial(frames: bool, capacity_failure: bool): bool {
    var baseline = tower_test_buffer_count();
    var budget: WorkBudget = default;
    if !work_budget_init(&budget, 1, InterpreterScheduleBudgetBytes, 1) { return false; }
    var state: IMState = { budget: &budget, ..default };
    var occupied: WorkReservation = default;
    defer {
        if occupied.active { work_budget_release(&budget, &occupied); }
        interpreter_storage_dispose(&state);
        work_budget_dispose(&budget);
    }
    if !im_frame_push(&state, null, 0, 0, null) || !im_task_push(&state, null, false, 0, 0) { return false; }
    var first_tasks = state.frames.data[0].tasks.data;
    var first_receipt = state.frames.data[0].tasks.reservation;
    var previous = state.frames.capacity;
    if frames {
        // Grow after a pop/reuse cycle: all prior depth owners must survive the
        // outer vector move, even though frame pops retained their allocation.
        im_frame_pop(&state);
        for(var depth: usize = 0; depth <= previous; depth++) {
            if !im_frame_push(&state, null, depth, depth, null)
                || !im_task_push(&state, null, false, 0, depth) { return false; }
        }
        if !interpreter_schedule_check(state.frames.data[0].tasks.data == first_tasks
            && state.frames.data[0].tasks.reservation.generation == first_receipt.generation,
            "Frame growth preserves reused per-depth task ownership") { return false; }
        while state.frame_count < state.frames.capacity {
            var depth = state.frame_count;
            if !im_frame_push(&state, null, depth, depth, null)
                || !im_task_push(&state, null, false, 0, depth) { return false; }
        }
    } else {
        while state.task_count < state.frames.data[0].tasks.capacity {
            if !im_task_push(&state, null, false, 0, state.task_count) { return false; }
        }
    }
    var frame_owner = state.frames;
    var task_owner = im_frame(&state).tasks;
    var before: WorkBudgetSnapshot = default;
    if !work_budget_snapshot(&budget, &before) { return false; }
    var owned_bytes = state.frames.reservation.bytes;
    for(var depth: usize = 0; depth < state.frames.capacity; depth++) {
        owned_bytes += state.frames.data[depth].tasks.reservation.bytes;
    }
    if !interpreter_schedule_check(before.used_bytes == owned_bytes && before.used_lanes == 0,
        "Scheduling grants count the complete physical owners without worker lanes") { return false; }
    if capacity_failure {
        if !work_budget_reserve(&budget, 0, 0, before.bytes - before.used_bytes, &occupied) { return false; }
    } else { tower_test_buffer_fail_next(); }
    var pushed = frames ? im_frame_push(&state, null, state.frame_count, 0, null)
        : im_task_push(&state, null, false, 0, state.task_count);
    var wanted_error = capacity_failure ? WorkBudgetError.Capacity : WorkBudgetError.Memory;
    if !interpreter_schedule_check(!pushed && state.storage_error == wanted_error
        && state.frames.data == frame_owner.data && state.frames.length == frame_owner.length
        && state.frames.capacity == frame_owner.capacity
        && state.frames.reservation.slot == frame_owner.reservation.slot
        && state.frames.reservation.generation == frame_owner.reservation.generation
        && state.frames.reservation.bytes == frame_owner.reservation.bytes
        && im_frame(&state).tasks.data == task_owner.data && state.task_count == task_owner.length
        && im_frame(&state).tasks.capacity == task_owner.capacity
        && im_frame(&state).tasks.reservation.slot == task_owner.reservation.slot
        && im_frame(&state).tasks.reservation.generation == task_owner.reservation.generation
        && im_frame(&state).tasks.reservation.bytes == task_owner.reservation.bytes,
        "Denied scheduling growth preserves counts, payloads and exact grant identity") { return false; }
    var denied: WorkBudgetSnapshot = default;
    if !interpreter_schedule_check(work_budget_snapshot(&budget, &denied)
        && denied.used_bytes == before.used_bytes + occupied.bytes
        && denied.live == before.live + (occupied.active ? 1 : 0),
        "Denied scheduling replacement immediately retires its tentative grant") { return false; }
    for(var depth: usize = 0; depth < state.frame_count; depth++) {
        var frame = &state.frames.data[depth];
        for(var task: usize = 0; task < frame.tasks.length; task++) {
            if !interpreter_schedule_check(frame.tasks.data[task].offset == (frames ? depth : task),
                "Denied scheduling growth preserves every queued continuation") { return false; }
        }
    }
    if occupied.active && !work_budget_release(&budget, &occupied) { return false; }
    interpreter_storage_dispose(&state);
    var after: WorkBudgetSnapshot = default;
    return interpreter_schedule_check(work_budget_snapshot(&budget, &after)
        && after.used_bytes == 0 && after.live == 0 && after.peak_bytes <= after.bytes
        && work_budget_dispose(&budget) && tower_test_buffer_count() == baseline,
        "Scheduling disposal releases every retained depth and its physical grant");
}
