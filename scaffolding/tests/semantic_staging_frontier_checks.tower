import tower;
import semantic_staging_frontier_checks_test;

fn main(): i32 {
    var failures: u32 = 0;
    for(var mode = convert(u32, StagingCase.Healthy); mode < convert(u32, StagingCase.Count); mode++) {
        failures += staging_trial(1, convert(StagingCase, mode), false);
        failures += staging_trial(4, convert(StagingCase, mode), false);
        failures += staging_trial(1, convert(StagingCase, mode), true);
        failures += staging_trial(4, convert(StagingCase, mode), true);
    }
    failures += staging_ready_frontier(1, false);
    failures += staging_ready_frontier(4, false);
    failures += staging_ready_frontier(1, true);
    failures += staging_ready_frontier(4, true);
    return failures == 0 ? 0 : 1;
}
