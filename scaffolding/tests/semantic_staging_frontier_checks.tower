import tower;
import .compiler.semantic_query_api;
import .compiler.semantic_context_types;
import .compiler.semantic_program_types;
import .compiler.semantic_evaluation_types;
import .compiler.semantic_work_ids;
import .compiler.compiler_kernel;
import .compiler.foundation_tags;
import .compiler.component_kinds;
import .compiler.parser_types;
import .library.work_graph;
import .library.work_budget_types;

extern fn sem_lifecycle_queries_pump(c: SemanticContext*): SemanticPumpResult;
extern fn compiler_world_create_workers(workers: usize): void*;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_dispose(world: void*): bool;
extern fn compiler_node_world(node: void*): void*;
extern fn compiler_world_component(world: void*, node: void*, kind: u32): void*;
extern fn entity_create(store: void*): void*;
extern fn puts(message: u8*): i32;

enum StagingCase: u32 { Healthy, LowerFailure, EvaluationFailure, Cancelled, Count }
var StagingMalformedDepth: usize = 130;

fn staging_check(ok: bool, message: u8*, failures: u32*): void {
    if !ok { puts(message); (*failures)++; }
}

fn staging_node(owner: void*, kind: u32, offset: usize): void* {
    var node = sem_create(owner);
    var value = sem_attach(node, kind);
    value.start = offset;
    value.type = { scalar: SI32, pointers: 0, record: null, pointer_bytes: convert(u32, sizeof(void*)) };
    var syntax = bits(ParserMatchData*, compiler_world_component(compiler_node_world(node), node, CompilerParserMatch));
    sem_require(syntax != null);
    syntax.start = offset;
    return node;
}

fn staging_number(owner: void*, number: u64): void* {
    var node = staging_node(owner, KOperand, 0);
    sem_get(node).constant = true;
    sem_get(node).bits = number;
    return node;
}

fn staging_function(c: SemanticContext*, offset: usize): void* {
    var subject = staging_node(c.program.root, KFunction, offset);
    var function = sem_get(subject);
    function.type.scalar = SVoid;
    function.index = c.program.functions.length;
    function.body = staging_node(subject, KBlock, offset);
    sem_require(entity_attach(function.body, subject, "body"));
    sem_push(&c.program.functions, subject);
    return subject;
}

fn staging_gate(c: SemanticContext*, subject: void*, query: SemanticQuery): usize {
    var id = work_request(&c.queries, subject, convert(u32, query), 0);
    sem_require(id != 0 && work_seal(&c.queries, id) && work_demand(&c.queries, id));
    return id;
}

fn staging_complete(c: SemanticContext*, id: usize): void {
    var ticket: WorkTicket = default;
    sem_require(work_take_task(&c.queries, &ticket, id) && work_finish(&c.queries, &ticket, true));
}

fn staging_value(c: SemanticContext*, owner: void*, input: void*, requested: bool, inferred: bool, gate: usize): SemanticEvaluation* {
    var subject = staging_node(c.program.root, KOperand, 41);
    sem_get(subject).constant = true;
    var result = bits(SemanticEvaluation*, entity_component_data(entity_component_add(subject, c.evaluation_results)));
    sem_require(result != null);
    *result = default;
    result.subject = subject;
    result.literal = subject;
    result.owner = owner;
    result.expression = input;
    result.requested = requested;
    result.inferred = inferred;
    result.ready = bits(IMDependency*, entity_component_data(entity_component_add(subject, c.evaluation_ready)));
    sem_require(result.ready != null);
    *result.ready = default;
    result.ready.subject = subject;
    result.kernel.kind = CompilerKernelKind.Evaluate;
    result.kernel.payload = bits(void*, &result.invocation);
    sem_push(&c.evaluation_jobs, bits(void*, result));
    var query = work_request(&c.queries, subject, convert(u32, SemanticQuery.Evaluation), 0);
    sem_require(query != 0 && (gate == 0 || work_depend(&c.queries, query, gate)));
    sem_evaluation_request(c, result);
    return result;
}

fn staging_increment_before_wait(c: SemanticContext*, result: SemanticEvaluation*, dependency: void*): void {
    // Canonical Foundation owns a local increment before the executed read.
    // Resuming must retain the initialized local and its increment.
    result.expression = null;
    result.function = staging_node(result.subject, KFunction, 41);
    var function = sem_get(result.function);
    function.frame_size = sizeof(i32);
    function.body = staging_node(result.function, KBlock, 41);
    var block = sem_get(function.body);
    var counter = staging_node(result.function, KDeclare, 41);
    sem_get(counter).value = staging_number(result.function, 0);
    sem_push(&function.locals, counter);
    sem_push(&block.items, counter);
    var read = staging_node(result.function, KOperand, 41);
    sem_get(read).binding = counter;
    var increment = staging_node(result.function, KBinary, 41);
    sem_get(increment).op = OAdd;
    sem_get(increment).left = read;
    sem_get(increment).right = staging_number(result.function, 1);
    var assign = staging_node(result.function, KAssign, 41);
    sem_get(assign).target = read;
    sem_get(assign).value = increment;
    sem_push(&block.items, assign);
    var sum = staging_node(result.function, KBinary, 41);
    sem_get(sum).op = OAdd;
    sem_get(sum).left = dependency;
    sem_get(sum).right = read;
    var returned = staging_node(result.function, KReturn, 41);
    sem_get(returned).value = sum;
    sem_push(&block.items, returned);
}

fn staging_lazy_branch(result: SemanticEvaluation*, untaken: void*): void {
    result.function = staging_node(result.subject, KFunction, 41);
    var function = sem_get(result.function);
    function.body = staging_node(result.function, KBlock, 41);
    var branch = staging_node(result.function, KIf, 41);
    var condition = sem_get(branch);
    condition.value = staging_number(result.function, 1);
    sem_get(condition.value).type.scalar = SBool;
    condition.body = staging_node(result.function, KBlock, 41);
    condition.otherwise = staging_node(result.function, KBlock, 41);
    var selected = staging_node(result.function, KReturn, 41);
    sem_get(selected).value = staging_number(result.function, 42);
    var skipped = staging_node(result.function, KReturn, 41);
    sem_get(skipped).value = untaken;
    sem_push(&sem_get(condition.body).items, selected);
    sem_push(&sem_get(condition.otherwise).items, skipped);
    sem_push(&sem_get(function.body).items, branch);
}

fn staging_drain(c: SemanticContext*): SemanticPumpResult {
    var state = sem_lifecycle_queries_pump(c);
    while state == SemanticPumpResult.Progress { state = sem_lifecycle_queries_pump(c); }
    return state;
}

fn staging_trial(workers: usize, mode: StagingCase): u32 {
    var failures: u32 = 0;
    var world = compiler_world_create_workers(workers);
    sem_require(world != null);
    var root = entity_create(compiler_world_store(world));
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, convert(u32, sizeof(void*)));
    var c: SemanticContext = default;
    sem_context_init(&c, &program);
    c.generics = generic_begin(root);
    c.source = "";
    c.surface_expressions = true;
    sem_evaluation_begin(&c);
    var owner = staging_function(&c, 7);
    var later = staging_function(&c, 17);
    var body_gate = staging_gate(&c, later, SemanticQuery.Body);
    var producer_gate = staging_gate(&c, staging_node(root, KOperand, 31), SemanticQuery.Body);
    staging_complete(&c, staging_gate(&c, root, SemanticQuery.KnownProof));
    staging_complete(&c, staging_gate(&c, root, SemanticQuery.KnownSnapshot));
    var producer = staging_value(&c, owner, staging_number(root, 41), false, false, producer_gate);
    var division = staging_node(root, KBinary, 41);
    sem_get(division).op = ODiv;
    sem_get(division).left = staging_number(root, 1);
    sem_get(division).right = staging_number(root, 0);
    var unused = staging_value(&c, owner, division, false, false, 0);
    var consumer = staging_value(&c, owner, null, true, false, 0);
    staging_increment_before_wait(&c, consumer, producer.subject);
    var independent = staging_value(&c, owner, null, true, false, 0);
    staging_lazy_branch(independent, unused.subject);
    var owned = staging_value(&c, later, staging_number(root, 42), true, false, 0);
    var inferred = staging_value(&c, owner, staging_number(root, 42), true, true, 0);
    var bad: SemanticEvaluation* = null;
    if mode == StagingCase.LowerFailure || mode == StagingCase.EvaluationFailure {
        var invalid = staging_node(root, KBinary, 41);
        sem_get(invalid).op = ODiv;
        sem_get(invalid).left = staging_number(root, 1);
        sem_get(invalid).right = staging_number(root, 0);
        bad = staging_value(&c, owner, invalid, true, false, 0);
    }
    if mode == StagingCase.LowerFailure {
        c.has_defer = true;
        var parent = sem_get(later).body;
        for(var depth: usize = 0; depth < StagingMalformedDepth; depth++) {
            var child = staging_node(parent, KBlock, 17);
            sem_push(&sem_get(parent).items, child);
            parent = child;
        }
    }
    if mode == StagingCase.Cancelled { work_cancel(&c.queries); }
    var state = staging_drain(&c);
    if mode == StagingCase.Cancelled {
        staging_check(state == SemanticPumpResult.Failed && program.resource.error == WorkBudgetError.Invalid,
            "Cancelled lifecycle entry fails before dispatch", &failures);
    } else {
        var lower = work_find(&c.queries, later, convert(u32, SemanticQuery.Lowering), 0);
        staging_check(state == SemanticPumpResult.Waiting && program.error.length == 0 && independent.ready.ready
            && !independent.ready.failed && sem_get(independent.subject).bits == 42
            && !consumer.ready.ready && consumer.started && !owned.ready.ready && !inferred.ready.ready
            && work_task(&c.queries, lower).state == WorkState.Waiting,
            "Explicit ready stage progresses while unrelated lowering and nested executed input wait", &failures);
        var count = c.count;
        var steps = consumer.invocation.state.steps;
        var memory = consumer.invocation.state.memory.data;
        var frames = consumer.invocation.state.frame_count;
        for(var repeat: usize = 0; repeat < 3; repeat++) {
            staging_check(sem_lifecycle_queries_pump(&c) == SemanticPumpResult.Waiting && c.count == count
                && !consumer.ready.ready && consumer.invocation.state.steps == steps
                && consumer.invocation.state.memory.data == memory && consumer.invocation.state.frame_count == frames
                && program.error.length == 0,
                "Repeated waits retain interpreter effects and source-error priority", &failures);
        }
        if bad != null {
            staging_check(bad.ready.failed && bad.error.length != 0 && program.error.length == 0,
                "Executed stage failure stays private until lowering diagnostics settle", &failures);
        }
        staging_complete(&c, producer_gate);
        state = staging_drain(&c);
        staging_check(state == SemanticPumpResult.Waiting && consumer.ready.ready && !consumer.ready.failed
            && sem_get(consumer.subject).bits == 42 && !owned.ready.ready && !inferred.ready.ready
            && work_task(&c.queries, lower).state == WorkState.Waiting,
            "Executed nested producer resumes exactly-once prefix before the blanket lowering join", &failures);
        var unused_query = work_find(&c.queries, unused.subject, convert(u32, SemanticQuery.Evaluation), 0);
        staging_check(!work_task(&c.queries, unused_query).demanded && unused.function == null && !unused.started,
            "Untaken staged branch creates no producer demand or effects", &failures);
        staging_complete(&c, body_gate);
        state = staging_drain(&c);
        if mode == StagingCase.Healthy {
            staging_check(state == SemanticPumpResult.Complete && owned.ready.ready && !owned.ready.failed
                && sem_get(owned.subject).bits == 42 && inferred.ready.ready && !inferred.ready.failed
                && sem_get(inferred.subject).bits == 42, "Canonical-function inference waits for all lowering", &failures);
        } else {
            staging_check(state == SemanticPumpResult.Failed && program.error.length != 0
                && program.error_offset == (mode == StagingCase.LowerFailure ? 17 : 41),
                "Lowering retains priority over executed stage errors; completed lowering exposes stage failure", &failures);
        }
    }
    var final_state = state;
    var tasks = c.queries.tasks.length;
    for(var repeat: usize = 0; repeat < 3; repeat++) {
        staging_check(sem_lifecycle_queries_pump(&c) == final_state && c.queries.tasks.length == tasks
            && c.workers.running == 0 && c.queries.running == 0,
            "Terminal lifecycle calls neither replay work nor retain running tickets", &failures);
    }
    sem_context_dispose(&c);
    semantic_program_dispose(&program);
    entity_release(root);
    staging_check(compiler_world_dispose(world), "Staging frontier releases its world", &failures);
    return failures;
}

fn staging_ready_frontier(workers: usize): u32 {
    var failures: u32 = 0;
    var world = compiler_world_create_workers(workers);
    sem_require(world != null);
    var root = entity_create(compiler_world_store(world));
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, convert(u32, sizeof(void*)));
    var c: SemanticContext = default;
    sem_context_init(&c, &program);
    c.generics = generic_begin(root);
    c.source = "";
    c.surface_expressions = true;
    sem_evaluation_begin(&c);
    var owner = staging_function(&c, 7);
    var last = owner;
    while program.functions.length <= SemanticPreparationWindow {
        last = staging_function(&c, program.functions.length);
    }
    var result = staging_value(&c, owner, staging_number(root, 42), true, false, 0);
    var state = sem_lifecycle_queries_pump(&c);
    var pending = work_find(&c.queries, last, convert(u32, SemanticQuery.Lowering), 0);
    staging_check(state == SemanticPumpResult.Progress && result.ready.ready && !result.ready.failed
        && sem_get(result.subject).bits == 42 && work_task(&c.queries, pending).state == WorkState.Ready,
        "Ready stage finishes before the remaining ready lowering frontier without an artificial dependency", &failures);
    staging_check(staging_drain(&c) == SemanticPumpResult.Complete && c.queries.running == 0 && c.workers.running == 0,
        "Remaining ready lowering refills and joins within the shared budget", &failures);
    sem_context_dispose(&c);
    semantic_program_dispose(&program);
    entity_release(root);
    staging_check(compiler_world_dispose(world), "Ready frontier releases its world", &failures);
    return failures;
}

export fn main(): i32 {
    var failures: u32 = 0;
    for(var mode = convert(u32, StagingCase.Healthy); mode < convert(u32, StagingCase.Count); mode++) {
        failures += staging_trial(1, convert(StagingCase, mode));
        failures += staging_trial(4, convert(StagingCase, mode));
    }
    failures += staging_ready_frontier(1);
    failures += staging_ready_frontier(4);
    return failures == 0 ? 0 : 1;
}
