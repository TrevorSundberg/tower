import tower;
import frontend_units;
import execution_support;
import execution_core;
import struct_value_checks;
import .compiler.execution_session;
import .library.vector;

fn integer_negation_tests(modules: void*, root: u8*): void {
    var source: vector(u8) = default;
    defer vector_dispose(&source);
    units_read(root, "/tests/integer_negation.tower", &source);
    for (var width: u32 = 4; width <= 8; width += 4) {
        var graph: ExecutionSession = default;
        var fast: ExecutionSession = default;
        defer execution_session_close(&graph);
        defer execution_session_close(&fast);
        execution_compile(&graph, source.data, width, modules);
        execution_compile(&fast, source.data, width, modules);
        execution_check(execution_session_start(&graph) && execution_session_fast(&fast), "Negation engines start");
        execution_run(&graph, 1000, 100000);
        execution_run(&fast, 1000, 100000);
        execution_same(&graph, &fast);
        execution_check(graph.error.length == 0 && execution_text(&graph.output, "0\n"), "Negation uses ordinary operation semantics");
        execution_roundtrip(&graph, modules, false);
        execution_session_close(&graph);
        execution_compile(&graph, "import foundation;var byte:u8=-0;var word:u32=-0;var wide:u64=-0;var size:usize=-0;print(size);", width, modules);
        execution_check(execution_session_start(&graph), "Foundation zero spelling starts");
        execution_run(&graph, 1000, 100000);
        execution_check(graph.error.length == 0 && execution_text(&graph.output, "0\n"), "Foundation negative zero is zero");
        execution_roundtrip(&graph, modules, true);
    }
    struct_value_reject(modules, "import tower;var x:i32=-2147483649;", "Integer literal out of range");
    struct_value_reject(modules, "import tower;var x:i64=-(9223372036854775809);", "Integer literal out of range");
    struct_value_reject(modules, "import tower;var x:u8=-256;", "Integer literal out of range");
    struct_value_reject(modules, "import foundation;var x:u64=-1;", "Integer literal out of range");
    puts("Integer negation: zero, signed minima, unsigned wrapping, staging and Foundation pass.");
}
