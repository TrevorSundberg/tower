import tower;

fn digits(a: i32, b: i32): i32 {
    var tens = a * 10;
    return_value = tens + b;
    return return_value;
}
var return_value: i32;

var value: i32 = 1;
var pair = digits(value, value++);
print(pair);
var after_digits = value;
print(after_digits);

fn identity(n: i32): i32 { return n; }
var equal = identity(value++) == identity(value++);
print(equal);
print(value);

var array: i32[3] = {10, 20, 30};
var index: i32 = 0;
fn assign(): i32 {
    array[index++] = index++;
    return index;
}
var after_store = assign();
print(after_store);
print(array[0]);
print(array[1]);
