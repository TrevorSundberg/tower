import tower;

var effects: i32 = 0;
fn produce(value: i32): i32 {
    effects++;
    return value;
}

var from_call: decltype(produce(7)) = 42;
var forward: decltype(later) = 9;
var later: u64 = 12;
var numbers: i32[3];
var element: decltype(numbers[0]) = 8;
var address: decltype(&element) = &element;
struct Record { value: u64; }
var record: Record;
var field: decltype(record.value) = 19;
var flags: decltype(true) = true;
fn identity(T: type, value: T): T { return value; }
var generic = identity(decltype(element), element);

fn local_types(): i32 {
    var value: u8 = 4;
    var other: decltype(value++) = 6;
    if value != 4 || other != 6 { return 1; }
    {
        var value: bool = false;
        var inner: decltype(value) = true;
        if !inner { return 2; }
    }
    return 0;
}

var failures: i32 = local_types();
if effects != 0 || from_call != 42 || forward != 9 { failures++; }
if *address != 8 || field != 19 || !flags { failures++; }
if generic != element { failures++; }
print(failures);
