import tower;
import utility_checks;
import .tools.bootstrap_symbols;

fn symbol_target_case(unit: BootstrapUnit, target: u8*, text: u8*, bad: u8*): void {
    var input: BootstrapSymbol = { data: text, length: strlen(text) };
    var rejected: BootstrapSymbol = default;
    var accepted = bootstrap_symbols_check(unit, target, input, &rejected);
    if bad == null { utility_check(accepted && rejected.data == null, "accepted closure"); }
    else {
        utility_check(!accepted && rejected.length == strlen(bad)
            && memcmp(rejected.data, bad, rejected.length) == 0, "first exact rejected symbol");
    }
}

fn symbol_case(unit: BootstrapUnit, windows: bool, text: u8*, bad: u8*): void {
    symbol_target_case(unit, windows ? "x86_64-pc-windows-msvc" : "x86_64-unknown-linux-gnu", text, bad);
}

fn symbol_wasm_callback_case(unit: BootstrapUnit): void {
    symbol_target_case(unit, "wasm32-unknown-unknown", " U __indirect_function_table\n", null);
    symbol_case(unit, false, " U __indirect_function_table\n", "__indirect_function_table");
    symbol_case(unit, true, " U __indirect_function_table\n", "__indirect_function_table");
    symbol_target_case(unit, "wasm32-unknown-unknown", " U __indirect_function_table_extra\n", "__indirect_function_table_extra");
    symbol_target_case(unit, "wasm32-unknown-unknown", " U __table_base\n", "__table_base");
}

// Target spellings exercise the existing portable policy, not target execution.
fn symbol_admission_cases(unit: BootstrapUnit, wrong_unit: BootstrapUnit, name: u8*, suffixed: u8*): void {
    symbol_target_case(unit, "x86_64-unknown-linux-gnu", name, null);
    symbol_target_case(unit, "x86_64-pc-windows-msvc", name, null);
    symbol_target_case(unit, "wasm32-unknown-unknown", name, null);
    symbol_target_case(unit, "aarch64-apple-macos11", name, null);
    var length = strlen(name);
    utility_check(length != 0 && !bootstrap_symbol_allowed(unit, false, false, false, name, length - 1), "truncated admission symbol");
    symbol_target_case(unit, "x86_64-unknown-linux-gnu", suffixed, suffixed);
    symbol_target_case(wrong_unit, "x86_64-unknown-linux-gnu", name, name);
    symbol_target_case(BootstrapUnit.Entities, "x86_64-unknown-linux-gnu", name, name);
}

export fn main(): i32 {
    symbol_wasm_callback_case(BootstrapUnit.ParserFormat);
    symbol_wasm_callback_case(BootstrapUnit.TemplateBuild);
    // The staged borrowed-origin finalizer carries a relative Wasm table index.
    symbol_target_case(BootstrapUnit.Entities, "wasm32-unknown-unknown", " U __table_base\n", null);
