import tower;
import .library.entities;
import .library.entity_types;
import .library.entity_stage;
import .library.work_vector;
import .library.work_vector_types;
import .library.work_budget;
import .library.work_budget_types;
import .host.memory;

var PagePropertyBudget: usize = 8388608;
var PagePropertyLifecycle: usize = 1;
var PagePropertyStageRows: u8 = 4;
var PagePropertyRounds: usize = 2;
var PageSeedFirst: u64 = 1;
var PageSeedMixed: u64 = 314159;
var PageSeedHigh: u64 = 4294967291;
var PageRandomMultiplier: u64 = 6364136223846793005;
var PageRandomIncrement: u64 = 1442695040888963407;
var PageValueGuard: u64 = 11400714819323198485;
enum PageAction: usize { Add, Remove, Replace, Count }
struct PageValue { target: Entity*; stamp: u64; guard: u64; }
struct PageClass { kind: Entity*; padding: usize; rows: usize; }
struct PageRow { owner: Entity*; private: bool; }
struct PageCell { present: bool; address: u8*; stamp: u64; }
struct PageProperty {
    seed: u64; random: u64; operation: usize;
    added: usize; removed: usize; finalized: usize;
    budget: WorkBudget; store: EntityStore*; root: Entity*; target: Entity*;
    stage: EntityStage*;
    classes: PageClass[4];
    rows: work_vector(PageRow);
    cells: work_vector(PageCell);
}
