import tower;
import .library.entities;
import .library.entity_types;
import .library.entity_stage;
import .library.work_vector;
import .library.work_vector_types;
import .library.work_budget;
import .library.work_budget_types;
import .host.memory;

var PagePropertyBudget: usize = 8388608;
var PagePropertyLifecycle: usize = 1;
var PagePropertyStageRows: u8 = 4;
var PagePropertyRounds: usize = 2;
var PageSeedFirst: u64 = 1;
var PageSeedMixed: u64 = 314159;
var PageSeedHigh: u64 = 4294967291;
var PageRandomMultiplier: u64 = 6364136223846793005;
var PageRandomIncrement: u64 = 1442695040888963407;
var PageValueGuard: u64 = 11400714819323198485;
enum PageAction: usize { Add, Remove, Replace, Count }
struct PageValue { target: Entity*; stamp: u64; guard: u64; }
struct PageClass { kind: Entity*; padding: usize; rows: usize; }
struct PageRow { owner: Entity*; private: bool; }
struct PageCell { present: bool; address: u8*; stamp: u64; }
struct PageProperty {
    seed: u64; random: u64; operation: usize;
    added: usize; removed: usize; finalized: usize;
    budget: WorkBudget; store: EntityStore*; root: Entity*; target: Entity*;
    stage: EntityStage*;
    classes: PageClass[4];
    rows: work_vector(PageRow);
    cells: work_vector(PageCell);
}
fn page_require(s: PageProperty*, ok: bool, message: u8*): void {
    if !ok { print(s.seed); print(s.operation); trap(message, 0); }
}
fn page_random(s: PageProperty*): usize {
    s.random = s.random * PageRandomMultiplier + PageRandomIncrement;
    return convert(usize, s.random >> 32);
}
export fn tower_entity_finalize(lifecycle: usize, component: EntityComponent*, data: u8*): void {
    var s = bits(PageProperty*, entity_context(component.owner));
    var value = bits(PageValue*, data);
    page_require(s, lifecycle == PagePropertyLifecycle && value.target == s.target
        && value.guard == (value.stamp ^ PageValueGuard), "Page property finalizer value");
    s.finalized++;
    entity_release(value.target);
}
// Independent flat oracle: no page lists, buckets, slots or free chains.
fn page_verify(s: PageProperty*): void {
    var classes = sizeof(decltype(s.classes)) / sizeof(PageClass);
    var live: usize = 0;
    var published_rows: usize = 0;
    page_require(s, s.cells.length == s.rows.length * classes, "Page model extent");
    for(var row: usize = 0; row < s.rows.length; row++) {
        var owner = s.rows.data[row].owner;
        var count: usize = 0;
        if !s.rows.data[row].private { published_rows++; }
        page_require(s, owner.references == 1, "Page row ownership");
        for(var kind: usize = 0; kind < classes; kind++) {
            var model = &s.cells.data[row * classes + kind];
            var actual = entity_component_get(owner, s.classes[kind].kind);
            page_require(s, (actual != null) == model.present, "Page component presence");
            if model.present {
                count++; live++;
                page_require(s, actual.data == model.address && actual.owner == owner,
                    "Untouched page payload moved");
                var value = bits(PageValue*, actual.data);
                page_require(s, value.target == s.target && value.stamp == model.stamp
                    && value.guard == (model.stamp ^ PageValueGuard), "Page payload value");
                var padding = bits(u64*, actual.data + sizeof(PageValue));
                for(var i: usize = 0; i < s.classes[kind].padding; i++) {
                    page_require(s, padding[i] == model.stamp + convert(u64, i), "Page payload tail");
                }
            }
        }
        page_require(s, owner.component_count == count, "Page owner component count");
    }
    for(var kind: usize = 0; kind < classes; kind++) {
        var count: usize = 0;
        for(var row: usize = 0; row < s.rows.length; row++) {
            if !s.rows.data[row].private && s.cells.data[row * classes + kind].present { count++; }
        }
        page_require(s, entity_query_count(s.classes[kind].kind) == count
            && s.classes[kind].kind.references == count + 1, "Published kind ownership");
    }
    page_require(s, s.target.references == live + 1 && s.root.child_count == published_rows
        && s.root.references == (s.stage == null ? 1 : 2), "Page retained references");
    page_require(s, s.added == s.removed + live && s.finalized == s.removed, "Page finalizer conservation");
}
fn page_row(s: PageProperty*): usize {
    s.operation++;
    var error: WorkBudgetError;
    var owner = s.stage == null ? entity_create_result(s.store, &error)
        : entity_stage_create_result(s.stage, s.root, &error);
    page_require(s, owner != null && error == WorkBudgetError.None, "Page row admission");
    if s.stage == null {
        page_require(s, entity_attach_result(owner, s.root, null) == WorkBudgetError.None, "Page row attachment");
        entity_release(owner);
    }
    var row = s.rows.length;
    var entry: PageRow = {owner: owner, private: s.stage != null};
    page_require(s, work_vector_push(&s.rows, &s.budget, entry), "Page model row storage");
    var classes = sizeof(decltype(s.classes)) / sizeof(PageClass);
    for(var kind: usize = 0; kind < classes; kind++) {
        var cell: PageCell = default;
        page_require(s, work_vector_push(&s.cells, &s.budget, cell), "Page model cell storage");
    }
    return row;
}
fn page_add(s: PageProperty*, row: usize, kind: usize): EntityComponent* {
    s.operation++;
    var classes = sizeof(decltype(s.classes)) / sizeof(PageClass);
    var cell = &s.cells.data[row * classes + kind];
    var error: WorkBudgetError;
    var component = entity_component_add_result(s.rows.data[row].owner, s.classes[kind].kind, &error);
    page_require(s, component != null && error == WorkBudgetError.None, "Page component admission");
    if !cell.present {
        var stamp = s.seed + convert(u64, s.operation);
        *bits(PageValue*, component.data) = {target: s.target, stamp: stamp, guard: stamp ^ PageValueGuard};
        var padding = bits(u64*, component.data + sizeof(PageValue));
        for(var i: usize = 0; i < s.classes[kind].padding; i++) { padding[i] = stamp + convert(u64, i); }
        if s.stage == null { entity_retain(s.target); }
        else {
            page_require(s, entity_stage_references_result(s.stage, &s.target, 1) == WorkBudgetError.None
                && entity_stage_hold_result(s.stage) == WorkBudgetError.None, "Page staged reference hold");
        }
        *cell = {present: true, address: component.data, stamp: stamp};
        s.added++;
    }
    page_verify(s);
    return component;
}
fn page_remove(s: PageProperty*, row: usize, kind: usize): void {
    s.operation++;
    var classes = sizeof(decltype(s.classes)) / sizeof(PageClass);
    var cell = &s.cells.data[row * classes + kind];
    var error = entity_component_remove_result(s.rows.data[row].owner, s.classes[kind].kind);
    page_require(s, error == (cell.present ? WorkBudgetError.None : WorkBudgetError.Invalid), "Page removal result");
    if cell.present { *cell = default; s.removed++; }
    page_verify(s);
}
fn page_stage(s: PageProperty*, publish: bool): void {
    s.operation++;
    var error: WorkBudgetError;
    s.stage = entity_stage_open_result(s.root, &error);
    page_require(s, s.stage != null && error == WorkBudgetError.None, "Page stage admission");
    var first = s.rows.length;
    var classes = sizeof(decltype(s.classes)) / sizeof(PageClass);
    var row = page_row(s);
    var capacity: usize = 0;
    for(var kind: usize = 0; kind < classes; kind++) {
        var component = page_add(s, row, kind);
        page_require(s, component.page != null, "Page staged capacity probe");
        if component.page.capacity > capacity { capacity = component.page.capacity; }
    }
    for(var i: usize = 0; i < capacity; i++) {
        row = page_row(s);
        var start = page_random(s) % classes;
        for(var i: usize = 0; i < classes; i++) { page_add(s, row, (start + i) % classes); }
    }
    page_require(s, entity_component_remove_result(s.rows.data[first].owner, s.classes[0].kind)
        == WorkBudgetError.Busy, "Private page removal must be Busy");
    page_verify(s);
    s.operation++;
    if publish {
        page_require(s, entity_stage_publish_result(s.stage) == WorkBudgetError.None, "Page stage publication");
        s.stage = null;
        for(var i = first; i < s.rows.length; i++) { s.rows.data[i].private = false; }
        page_verify(s);
        // Churn a transferred page while all other payloads must stay stable.
        var kind = page_random(s) % classes;
        page_remove(s, first, kind); page_add(s, first, kind);
    } else {
        page_require(s, entity_stage_discard_result(s.stage) == WorkBudgetError.None, "Page stage discard");
        s.stage = null;
    }
    for(var i = first; i < s.rows.length; i++) {
        for(var kind: usize = 0; kind < classes; kind++) {
            if s.cells.data[i * classes + kind].present { s.removed++; }
        }
        if publish {
            page_require(s, entity_attach_result(s.rows.data[i].owner, null, null) == WorkBudgetError.None,
                "Published page row teardown");
        }
    }
    s.rows.length = first; s.cells.length = first * classes;
    page_verify(s);
}
fn page_trial(seed: u64): void {
    var s: PageProperty = default;
    s.seed = seed; s.random = seed;
    s.classes[2].padding = 7; s.classes[3].padding = 31;
    var classes = sizeof(decltype(s.classes)) / sizeof(PageClass);
    page_require(&s, work_budget_init(&s.budget, 1, PagePropertyBudget, 1), "Page budget initialization");
    page_require(&s, entity_store_create_result(&s.budget, &s.store) == WorkBudgetError.None
        && entity_store_set_context(s.store, bits(void*, &s)), "Page store initialization");
    var error: WorkBudgetError;
    s.root = entity_create_result(s.store, &error);
    page_require(&s, s.root != null && error == WorkBudgetError.None, "Page root initialization");
    s.target = entity_create_result(s.store, &error);
    page_require(&s, s.target != null && error == WorkBudgetError.None, "Page target initialization");
    for(var kind: usize = 0; kind < classes; kind++) {
        s.classes[kind].kind = entity_create_result(s.store, &error);
        page_require(&s, s.classes[kind].kind != null && error == WorkBudgetError.None
            && entity_register_stage_result(s.classes[kind].kind,
                sizeof(PageValue) + s.classes[kind].padding * sizeof(u64), alignof(PageValue),
                PagePropertyLifecycle, PagePropertyStageRows) == WorkBudgetError.None, "Page class registration");
    }
    var first = page_row(&s);
    var count: usize = 0;
    for(var kind: usize = 0; kind < classes; kind++) {
        if kind + 1 == classes {
            // Warm the public indexes, then retire this class's only payload
            // page. Pressure must deny the next physical page, not an index.
            page_add(&s, first, kind); page_remove(&s, first, kind);
            var pressure: WorkReservation = default;
            page_require(&s, work_budget_reserve_result(&s.budget, 0, 0,
                s.budget.bytes - s.budget.used_bytes, &pressure) == WorkBudgetError.None, "Page pressure grant");
            var live = s.budget.live;
            s.operation++;
            page_require(&s, entity_component_add_result(s.rows.data[first].owner, s.classes[kind].kind, &error) == null
                && error == WorkBudgetError.Capacity && s.budget.used_bytes == s.budget.bytes
                && s.budget.live == live, "Page denied admission rollback");
            page_verify(&s);
            page_require(&s, work_budget_release_result(&s.budget, &pressure) == WorkBudgetError.None, "Page pressure release");
        }
        var component = page_add(&s, first, kind);
        page_require(&s, component.page != null, "Page dense capacity probe");
        s.classes[kind].rows = component.page.capacity;
        if component.page.capacity >= count { count = component.page.capacity + 1; }
    }
    page_require(&s, work_vector_reserve(&s.rows, &s.budget, count * 2)
        && work_vector_reserve(&s.cells, &s.budget, count * 2 * classes), "Page flat model capacity");
    for(var i: usize = 1; i < count; i++) {
        var row = page_row(&s);
        var start = page_random(&s) % classes;
        for(var kind: usize = 0; kind < classes; kind++) { page_add(&s, row, (start + kind) % classes); }
    }
    // Every class crosses its measured dense-page capacity; make full pages
    // partial and re-add before the seeded mixed sequence.
    for(var kind: usize = 0; kind < classes; kind++) { page_remove(&s, 0, kind); page_add(&s, 0, kind); }
    for(var round: usize = 0; round < PagePropertyRounds; round++) {
        var actions = s.cells.length;
        for(var i: usize = 0; i < actions; i++) {
            var row = page_random(&s) % s.rows.length;
            var kind = page_random(&s) % classes;
            var action = convert(PageAction, page_random(&s) % convert(usize, PageAction.Count));
            if action != PageAction.Add { page_remove(&s, row, kind); }
            if action != PageAction.Remove { page_add(&s, row, kind); }
        }
        var publish = (page_random(&s) % 2) != 0;
        page_stage(&s, publish); page_stage(&s, !publish);
    }
    var retained = s.budget.used_bytes;
    var grants = s.budget.live;
    var peak = s.budget.peak_bytes;
    s.operation++;
    entity_release(s.root);
    page_require(&s, s.finalized == s.added && s.target.references == 1, "Page final owner release");
    entity_release(s.target);
    for(var kind: usize = 0; kind < classes; kind++) { entity_release(s.classes[kind].kind); }
    page_require(&s, s.store.entity_count == 0 && s.store.component_count == 0
        && entity_store_dispose(s.store), "Page store teardown");
    work_vector_dispose(&s.cells); work_vector_dispose(&s.rows);
    page_require(&s, s.budget.used_bytes == 0 && s.budget.live == 0 && s.budget.used_lanes == 0
        && work_budget_dispose(&s.budget), "Page zero final grants");
    // seed, operations, payload lifetimes, dense capacities, retained bytes /
    // grants and charged peak (includes the deliberate pressure reservation).
    print(s.seed); print(s.operation); print(s.added);
    for(var kind: usize = 0; kind < classes; kind++) { print(s.classes[kind].rows); }
    print(retained); print(grants); print(peak);
}
export fn main(argc: i32, argv: u8**): i32 {
    page_trial(PageSeedFirst); page_trial(PageSeedMixed); page_trial(PageSeedHigh);
    return 0;
}
