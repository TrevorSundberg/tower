import tower;
import .host.memory;
import .library.work_graph;
import .library.vector;
import utility_checks;

enum OrderTestQuery: u32 { Producer, Consumer }

fn work_order_tests(): void {
    // More than two semantic preparation windows: sort all ready work, not
    // just the first admitted window, independent of producer completion order.
    var pairs: usize = 513;
    var revision: u64 = 17;
    var profile: u64 = 8;
    var graph: WorkGraph;
    work_init(&graph, revision, profile);
    defer work_dispose(&graph);
    var producers: vector(WorkTicket) = default;
    var consumers: vector(usize) = default;
    defer vector_dispose(&producers);
    defer vector_dispose(&consumers);
    utility_check(vector_reserve(&producers, pairs), "Allocate producer receipts");
    for(var i: usize = 0; i < pairs; i++) {
        var producer = work_request(&graph, null, convert(u32, OrderTestQuery.Producer), convert(u64, i));
        var consumer = work_request(&graph, null, convert(u32, OrderTestQuery.Consumer), convert(u64, i));
        utility_check(producer != 0 && consumer != 0, "Register ordered queries");
        utility_check(vector_push(&consumers, consumer), "Retain consumer identity");
        utility_check(work_depend(&graph, consumer, producer), "Consumer waits for producer");
        utility_check(work_seal(&graph, producer) && work_seal(&graph, consumer), "Seal producer and consumer");
        utility_check(work_demand(&graph, consumer), "Demand each dependency chain");
    }
    for(var i: usize = 0; i < pairs; i++) {
        utility_check(work_take_query(&graph, &producers.data[i], convert(u32, OrderTestQuery.Producer)),
            "Admit all independent producers");
    }
    utility_check(!work_order_ready(&graph), "Ordering requires all workers to relinquish claims");
    for(var i = pairs; i != 0;) {
        utility_check(work_finish(&graph, &producers.data[--i], true), "Reverse producer completion");
    }
    var stale: WorkTicket;
    utility_check(work_take(&graph, &stale) && stale.task == consumers.data[pairs - 1],
        "Ordinary dispatch retains completion-order FIFO");
    utility_check(work_yield(&graph, &stale), "Yield leaves a consumed ready entry and stale receipt");
    utility_check(work_order_ready(&graph), "Order complete ready frontier at phase join");
    for(var i: usize = 0; i < pairs; i++) {
        var ticket: WorkTicket;
        utility_check(work_take(&graph, &ticket) && ticket.task == consumers.data[i],
            "Consumer admission follows stable request identity across all windows");
        utility_check(!work_finish(&graph, &stale, true), "Ordering never revives a stale receipt");
        utility_check(work_finish(&graph, &ticket, true), "Ordered consumer finishes once");
    }
    utility_check(work_order_ready(&graph) && graph.ready.length == 0 && graph.head == 0,
        "Ordering compacts an exhausted frontier");
    puts("Work graph: reversed dependency completions retain deterministic continuation order.");
}
