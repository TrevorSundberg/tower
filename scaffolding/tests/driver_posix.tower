import tower;
import .host.driver_support;
import .host.driver_platform;
import .host.driver_posix_api;
import .host.driver_posix;
import driver_platform_api;
import driver_posix_capture;
import driver;
import .library.bytes_types;
import .library.bytes_interface;

extern fn driver_posix_chmod(path: u8*, mode: u32): i32;

extern fn symlink(target: u8*, link: u8*): i32;

export fn driver_test_posix_tool(out: ByteBuffer*, name: u8*): bool {
    out.length = 0;
    return driver_find_tool(out, name);
}

export fn driver_test_windows_runner(out: ByteBuffer*): DriverWindowsRunner {
    if driver_test_posix_tool(out, "cmd.exe") { return DriverWindowsRunner.Direct; }
    if driver_test_posix_tool(out, "wine") { return DriverWindowsRunner.Wine; }
    return DriverWindowsRunner.Unavailable;
}

extern fn driver_resource_root(out: ByteBuffer*, executable: u8*): bool;

export fn driver_test_cli_platform(compiler: u8*): void {
    var alias = "./driver compiler symlink";
    driver_platform_remove(alias);
    var ok = symlink(compiler, alias) == 0;
    driver_check(ok, "compiler symlink fixture");
    var result = driver_test_compile(alias, "driver fixture with spaces.tower", "object", "driver symlink.o", "", null);
    ok = result == 0;
    driver_check(ok, "resource lookup follows the running executable");
    driver_platform_remove(alias);
    // Copy the complete resource directory beside the compiler, then execute
    // from a different cwd with spaces in the package and source names.
    mkdir("driver relocated", DriverTestPrivateMode);
    mkdir("driver relocated/share", DriverTestPrivateMode);
    var bytes: ByteBuffer;
    var root: ByteBuffer;
    fill(&bytes, 0, sizeof(ByteBuffer));
    fill(&root, 0, sizeof(ByteBuffer));
    driver_check(driver_read_file(compiler, &bytes), "read compiler for relocation");
    driver_check(driver_write_file("driver relocated/towerc", bytes.data, bytes.length), "write relocated compiler");
    bytes_dispose(&bytes);
    ok = driver_posix_chmod("driver relocated/towerc", DriverTestPrivateMode) == 0;
    driver_check(ok, "relocated executable mode");
    driver_check(driver_resource_root(&root, compiler), "relocation resource root");
    var args: DriverArguments;
    driver_arguments_init(&args);
    driver_argument(&args, "", "cp");
    driver_argument(&args, "", "-R");
    driver_argument(&args, "", root.data);
    driver_argument(&args, "", "driver relocated/share");
    ok = driver_command(&args) == 0;
    driver_check(ok, "relocate resource tree");
    driver_arguments_dispose(&args);
    bytes_dispose(&root);
    var depfile = "driver relocated/result.d";
    result = driver_test_compile("./driver relocated/towerc", "driver fixture with spaces.tower", "object", "driver relocated/result.o", "--depfile", depfile);
    ok = result == 0;
    driver_check(ok, "complete relocated compiler package");
    var dependencies: ByteBuffer = default;
    defer bytes_dispose(&dependencies);
    driver_check(driver_read_file(depfile, &dependencies) && strstr(dependencies.data, "share/tower/runtime-") == null,
        "object emission does not depend on a link runtime");
    result = driver_test_compile("./driver relocated/towerc", "driver fixture with spaces.tower", "exe", "driver relocated/result", "--depfile", depfile);
    driver_check(result == 0, "relocated executable link");
    driver_test_read(depfile, "driver\\ relocated/share/tower/runtime-", false);
}

export fn driver_test_platform_cases(): void {
    var path = "./driver executable text";
    driver_check(driver_write_file(path, "exit 0\n", 7), "executable text fixture");
    var ok = driver_posix_chmod(path, DriverTestPrivateMode) == 0;
    driver_check(ok, "executable fixture mode");
    var args: DriverArguments;
    driver_arguments_init(&args);
    driver_argument(&args, "", path);
    var result = driver_test_capture(&args);
    ok = result == 1;
    driver_check(ok, "executable text does not fall back to a shell");
    driver_test_read("driver stderr.txt", "Cannot execute tool: ", false);
    driver_arguments_dispose(&args);
    driver_platform_remove(path);
}
