import tower;
import .library.entities;
import .library.entity_types;
import .library.entity_stage;
import .library.work_budget;
import .library.work_budget_types;
import .host.memory;

extern fn tower_test_buffer_count(): usize;
extern fn tower_test_buffer_fail_after(count: usize): void;
extern fn puts(text: u8*): i32;

var ComponentFaultLimit: usize = 64;
var ComponentFaultBudgetBytes: usize = 1048576;

fn component_fault_check(ok: bool): void {
    if !ok { trap("Component allocation failure ownership regression", 0); }
}

export fn tower_entity_finalize(lifecycle: usize, component: EntityComponent*, data: u8*): void {
    trap("Component fault fixture has no lifecycle payloads", 0);
}

fn component_fault_trial(failure: usize, staged: bool, large: bool): bool {
    var baseline = tower_test_buffer_count();
    var budget: WorkBudget = default;
    component_fault_check(work_budget_init(&budget, 1, ComponentFaultBudgetBytes, 1));
    var store: EntityStore* = null;
    component_fault_check(entity_store_create_result(&budget, &store) == WorkBudgetError.None);
    var root = entity_create(store);
    var first_type = entity_create(store);
    var next_type = entity_create(store);
    component_fault_check(root != null && first_type != null && next_type != null
        && entity_register(first_type, sizeof(u64), 64, 0)
        && entity_register(next_type, large ? 32768 : sizeof(u64), large ? 4096 : 64, 0));
    var stage: EntityStage* = null;
    var node: Entity* = root;
    if staged {
        stage = entity_stage_open(root);
        component_fault_check(stage != null);
        node = entity_stage_create(stage, root);
        component_fault_check(node != null);
    }
    var error = WorkBudgetError.None;
    var stable = entity_component_add_result(node, first_type, &error);
    component_fault_check(stable != null && error == WorkBudgetError.None);
    var address = stable.data;
    *bits(u64*, address) = 8765;
    var table = node.table;
    var before = budget.used_bytes;
    var live = budget.live;
    tower_test_buffer_fail_after(failure);
    var component = entity_component_add_result(node, next_type, &error);
    tower_test_buffer_fail_after(~convert(usize, 0));
    var succeeded = component != null;
    if !succeeded {
        component_fault_check(error == WorkBudgetError.Memory && node.component_count == 1
            && next_type.instance_count == 0 && entity_component_get(node, next_type) == null
            && node.table == table && node.pending_table == null
            && budget.used_bytes == before && budget.live == live
            && stable.data == address && *bits(u64*, address) == 8765);
        component = entity_component_add_result(node, next_type, &error);
    }
    component_fault_check(component != null && error == WorkBudgetError.None
        && node.component_count == 2 && stable.data == address && *bits(u64*, address) == 8765);
    if staged {
        var retained = budget.used_bytes;
        var component_address = component.data;
        tower_test_buffer_fail_after(0);
        var published = entity_stage_publish(stage);
        tower_test_buffer_fail_after(~convert(usize, 0));
        component_fault_check(!published && first_type.instance_count == 0 && next_type.instance_count == 0
            && budget.used_bytes == retained && component.data == component_address && node.stage == bits(void*, stage));
        component_fault_check(entity_stage_publish(stage) && component.data == component_address
            && budget.used_bytes == retained && node.stage == null && node.storage == null);
    }
    entity_release(root); entity_release(first_type); entity_release(next_type);
    component_fault_check(store.entity_count == 0 && store.component_count == 0
        && entity_store_dispose(store) && budget.live == 0 && budget.used_bytes == 0
        && work_budget_dispose(&budget) && tower_test_buffer_count() == baseline);
    return succeeded;
}

// This existing deterministic fault allocator is single-owner. Concurrent
// receipt/allocator/transport execution is in entity_component_budget instead.
export fn main(argc: i32, argv: u8**): i32 {
    var choices: bool[2]; choices[0] = false; choices[1] = true;
    var count = sizeof(decltype(choices)) / sizeof(bool);
    for(var staged: usize = 0; staged < count; staged++) {
        for(var large: usize = 0; large < count; large++) {
            var succeeded = false;
            for(var failure: usize = 0; failure < ComponentFaultLimit; failure++) {
                if component_fault_trial(failure, choices[staged], choices[large]) { succeeded = true; break; }
            }
            component_fault_check(succeeded);
        }
    }
    puts("0");
    return 0;
}
