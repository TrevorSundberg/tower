import tower;
import entity_component_faults_fixture_test;

extern fn puts(text: u8*): i32;
extern fn strcmp(left: u8*, right: u8*): i32;

export fn main(argc: i32, argv: u8**): i32 {
    component_layout_admission(false);
    component_layout_admission(true);
    if argc == 2 && strcmp(argv[1], "inline") == 0 {
        component_inline_sweep();
    } else {
        component_growth_sweep(ComponentOwner.Direct, ComponentPayload.Small);
        component_growth_sweep(ComponentOwner.Direct, ComponentPayload.Large);
        component_growth_sweep(ComponentOwner.Staged, ComponentPayload.Small);
        component_growth_sweep(ComponentOwner.Staged, ComponentPayload.Large);
    }
    puts("0");
    return 0;
}
