import library.testing;
import .compiler.automaton;
import .compiler.lexer_table;
import .compiler.syntax_types;
import .library.work_budget;
import .library.work_budget_types;
import lexer_table_oracle;
import mt19937;
import mt19937_reference_test;
extern fn tower_test_buffer_count(): usize;
extern fn tower_test_buffer_fail_next(): void;
extern fn tower_test_buffer_fail_after(count: usize): void;
extern fn compiler_buffer_allocation_size(bytes: usize): usize;

var TestNfaRange: u32 = 0;
var TestNfaSplit: u32 = 1;
var TestNfaAccept: u32 = 2;
var TestAutomatonSuccess: u32 = 0;
var TestAutomatonAllocation: u32 = 2;
var TestAutomatonLimit: u32 = 3;
var TestSymbolBase: u32 = 2097152;
var TestSymbolLimit: u32 = 2097168;

struct TestNfaState { kind: u32; first: u32; last: u32; out: i32; other: i32; negated: bool; }

test() { symbol_sequence_budget_tests(); }
test() { test_random_check(); }
test() { automaton_allocation_tests(); }
test() { automaton_oracle_tests(); }
test() { lexer_failure_tests(); }
test() { lexer_reference_tests(); }

// Direct epsilon closure and simulation. No subset construction, table sharing,
// production helper or production-derived cache is used by this oracle.
fn test_nfa_closure(states: TestNfaState*, seeds: i32*, seed_count: usize, count: usize, result: bool*): void {
    var visited: bool[32];
    var pending: i32[96];
    for (var index: usize = 0; index < count; ++index) { visited[index] = false; result[index] = false; }
    for (var index: usize = 0; index < seed_count; ++index) { pending[index] = seeds[index]; }
    var remaining = seed_count;
    while remaining != 0 {
        var at = pending[--remaining];
        if at < 0 { continue; }
        var index = convert(usize, at);
        assert(index < count, "NFA oracle state bounds");
        if visited[index] { continue; }
        visited[index] = true;
        if states[index].kind == TestNfaSplit {
            assert(remaining + 2 <= 96, "NFA oracle work bounds");
            pending[remaining++] = states[index].out;
            pending[remaining++] = states[index].other;
        } else { result[index] = true; }
    }
}

fn automaton_allocation_tests(): void {
    var baseline = tower_test_buffer_count();
    for (var failure: usize = 0; failure < 2; ++failure) {
        tower_test_buffer_fail_after(failure);
        assert(automaton_create(128) is null, "NFA create failure");
        assert(tower_test_buffer_count() == baseline, "NFA create failure cleanup");
    }
    var success = false;
    for (var failure: usize = 0; failure < 64 && !success; ++failure) {
        var nfa = automaton_create(128);
        var table = lex_table_create();
        assert(automaton_add(nfa, TestNfaRange, 1, -1, false) == 0, "NFA add range");
        assert(automaton_range(nfa, 0, 97, 122), "NFA range bounds");
        assert(automaton_add(nfa, TestNfaAccept, -1, -1, false) == 1, "NFA add accept");
        tower_test_buffer_fail_after(failure);
        var status = automaton_compile(nfa, 0, 1, table, true);
        tower_test_buffer_fail_after(~convert(usize, 0));
        assert(status == TestAutomatonSuccess || status == TestAutomatonAllocation, "NFA compile failure status");
        success = status == TestAutomatonSuccess;
        lex_table_destroy(table);
        automaton_destroy(nfa);
        assert(tower_test_buffer_count() == baseline, "NFA compile failure cleanup");
    }
    assert(success, "NFA allocation sweep reaches success");
}

fn automaton_oracle_tests(): void {
    var baseline = tower_test_buffer_count();
    var random: TestRandom;
    test_random_init(&random, 4474433);
    for (var trial: usize = 0; trial < 150; ++trial) {
        var count = 2 + test_random(&random) % 30;
        var states: TestNfaState[32];
        var nfa = automaton_create(TestSymbolLimit);
        var table = lex_table_create();
        for (var index: u32 = 0; index < count; ++index) {
            var state = &states[index];
            state.kind = test_random(&random) % 2;
            state.first = TestSymbolBase + test_random(&random) % 16;
            state.out = convert(i32, test_random(&random) % count);
            state.other = convert(i32, test_random(&random) % count);
            state.negated = test_random(&random) % 2 != 0;
            if index == count - 1 { state.kind = TestNfaAccept; }
            var last = state.first + test_random(&random) % 4;
            state.last = last < TestSymbolLimit - 1 ? last : TestSymbolLimit - 1;
            assert(automaton_add(nfa, state.kind, state.out, state.other, state.negated) == convert(i32, index), "NFA random add");
            if state.kind == TestNfaRange { assert(automaton_range(nfa, convert(i32, index), state.first, state.last), "NFA random range"); }
        }
        var status = automaton_compile(nfa, 0, convert(usize, count - 1), table, false);
        assert(status == TestAutomatonSuccess || status == TestAutomatonLimit, "NFA random compile status");
        if status == TestAutomatonSuccess {
            for (var sample: usize = 0; sample < 25; ++sample) {
                var active: bool[32];
                var seeds: i32[32];
                seeds[0] = 0;
                test_nfa_closure(&states[0], &seeds[0], 1, convert(usize, count), &active[0]);
                var state: i32 = 0;
                assert(lex_table_accepts(table, 0) == active[count - 1], "NFA initial acceptance");
                for (var step: usize = 0; step < 20; ++step) {
                    var symbol = sample % 2 != 0 ? TestSymbolBase + test_random(&random) % 16 : test_random(&random) % 32;
                    var seed_count: usize = 0;
                    for (var index: u32 = 0; index < count; ++index) {
                        var item = &states[index];
                        if active[index] && item.kind == TestNfaRange && ((symbol >= item.first && symbol <= item.last) != item.negated) { seeds[seed_count++] = item.out; }
                    }
                    test_nfa_closure(&states[0], &seeds[0], seed_count, convert(usize, count), &active[0]);
                    if state >= 0 { state = lex_table_step(table, convert(usize, state), symbol); }
                    var empty = true;
                    for (var index: u32 = 0; index < count; ++index) { empty &&= !active[index]; }
                    assert((state < 0) == empty, "NFA direct transition comparison");
                    assert(lex_table_accepts(table, state < 0 ? ~convert(usize, 0) : convert(usize, state)) == active[count - 1], "NFA direct acceptance comparison");
                }
                assert(lex_table_step(table, 0, TestSymbolLimit) == -1, "NFA rejects symbol beyond alphabet");
            }
        }
        lex_table_destroy(table);
        automaton_destroy(nfa);
        assert(tower_test_buffer_count() == baseline, "NFA random cleanup");
    }
}

fn lexer_failure_tests(): void {
    var baseline = tower_test_buffer_count();
    tower_test_buffer_fail_next();
    assert(lex_table_create() is null, "Lexer table create failure");
    var table = lex_table_create();
    var alphabet: u32[4];
    alphabet[0] = 0; alphabet[1] = 97; alphabet[2] = 123; alphabet[3] = 1114112;
    var row: i32[3];
    row[0] = -1; row[1] = 0; row[2] = -1;
    assert(!lex_table_set_alphabet(table, &alphabet[0], 1), "Lexer short alphabet");
    assert(!lex_table_append(table, &row[0], 3, true), "Lexer row before alphabet");
    tower_test_buffer_fail_next();
    assert(!lex_table_set_alphabet(table, &alphabet[0], 4), "Lexer alphabet allocation failure");
    assert(lex_table_set_alphabet(table, &alphabet[0], 4), "Lexer alphabet recovery");
    assert(!lex_table_append(table, &row[0], 2, true), "Lexer short row");
    tower_test_buffer_fail_next();
    assert(!lex_table_append(table, &row[0], 3, true), "Lexer row allocation failure");
    for (var index: usize = 0; index < 8; ++index) { assert(lex_table_append(table, &row[0], 3, true), "Lexer append row"); }
    assert(!lex_table_set_alphabet(table, &alphabet[0], 4), "Lexer immutable active alphabet");
    tower_test_buffer_fail_next();
    assert(!lex_table_append(table, &row[0], 3, true), "Lexer accepting-state allocation failure");
    assert(lex_table_match(table, "abc!", 4, 0) == 3, "Lexer failure preserves matching");
    assert(lex_table_append(table, &row[0], 3, true), "Lexer accepting-state recovery");
    lex_table_destroy(table);
    assert(tower_test_buffer_count() == baseline, "Lexer failure sweep cleanup");
}

fn symbol_sequence_budget_tests(): void {
    var baseline = tower_test_buffer_count();
    var ranges: SymbolRange[3] = default;
    var count = sizeof(decltype(ranges)) / sizeof(SymbolRange);
    var object_bytes = compiler_buffer_allocation_size(sizeof(SymbolSequence));
    var range_bytes = compiler_buffer_allocation_size(sizeof(decltype(ranges)));
    var total = object_bytes + range_bytes;
    var limits: usize[4];
    limits[0] = object_bytes - 1;
    limits[1] = object_bytes;
    limits[2] = total - 1;
    limits[3] = total;
    for(var index: usize = 0; index < sizeof(decltype(limits)) / sizeof(usize); index++) {
        var limit = &limits[index];
        var budget: WorkBudget = default;
        assert(work_budget_init(&budget, 1, *limit, 1), "Sequence bounded memory ledger");
        var sequence = symbol_sequence_create_owned(count, &budget);
        assert((sequence != null) == (*limit == total), "Sequence object and range denial boundaries");
        var snapshot: WorkBudgetSnapshot = default;
        if sequence != null {
            for(var index: usize = 0; index < count; index++) {
                var symbol = convert(u32, index);
                symbol_sequence_set(sequence, index, symbol, symbol);
                assert(symbol_sequence_accepts(sequence, index, symbol), "Budgeted sequence preserves transitions");
            }
            assert(work_budget_snapshot(&budget, &snapshot) && snapshot.used_bytes == total,
                "Sequence retains exact object and range allocation charges");
        }
        symbol_sequence_destroy(sequence);
        assert(work_budget_snapshot(&budget, &snapshot) && snapshot.used_bytes == 0
            && snapshot.live == 0 && snapshot.peak_bytes <= *limit && work_budget_dispose(&budget),
            "Sequence denial and retirement return every physical grant");
    }
    var budget: WorkBudget = default;
    assert(work_budget_init(&budget, 1, object_bytes, 1), "Empty sequence object allowance");
    var empty = symbol_sequence_create_owned(0, &budget);
    assert(empty != null && empty.symbols == null && !symbol_sequence_accepts(empty, 0, 0),
        "Empty sequence owns no range storage and accepts no transition");
    symbol_sequence_destroy(empty);
    assert(work_budget_dispose(&budget) && tower_test_buffer_count() == baseline,
        "Sequence budget checks restore all allocator ownership");
}

fn lexer_reference_tests(): void {
    var baseline = tower_test_buffer_count();
    var random: TestRandom;
    test_random_init(&random, 1953462117);
    var alphabet: u32[13];
    alphabet[0] = 0; alphabet[1] = 1; alphabet[2] = 32; alphabet[3] = 48;
    alphabet[4] = 58; alphabet[5] = 65; alphabet[6] = 91; alphabet[7] = 97;
    alphabet[8] = 123; alphabet[9] = 128; alphabet[10] = 2048;
    alphabet[11] = 65536; alphabet[12] = 1114112;
    var fragments: u8*[12];
    var lengths: usize[12];
    fragments[0] = "a"; fragments[1] = "Z"; fragments[2] = "7"; fragments[3] = " "; fragments[4] = "";
    fragments[5] = "é"; fragments[6] = "€"; fragments[7] = "🏰";
    var malformed: u8[9];
    malformed[0] = 255; malformed[1] = 192; malformed[2] = 175;
    malformed[3] = 244; malformed[4] = 144; malformed[5] = 128; malformed[6] = 128;
    malformed[7] = 226; malformed[8] = 130;
    fragments[8] = &malformed[0]; fragments[9] = &malformed[1]; fragments[10] = &malformed[3]; fragments[11] = &malformed[7];
    lengths[0] = 1; lengths[1] = 1; lengths[2] = 1; lengths[3] = 1; lengths[4] = 1;
    lengths[5] = 2; lengths[6] = 3; lengths[7] = 4; lengths[8] = 1; lengths[9] = 2; lengths[10] = 4; lengths[11] = 2;
    for (var trial: usize = 0; trial < 500; ++trial) {
        var actual = lex_table_create();
        var oracle = reference_lex_table_create();
        assert(lex_table_set_alphabet(actual, &alphabet[0], 13), "Lexer random alphabet");
        assert(reference_lex_table_set_alphabet(oracle, &alphabet[0], 13), "Lexer reference alphabet");
        var rows = 1 + test_random(&random) % 16;
        for (var index: u32 = 0; index < rows; ++index) {
            var row: i32[12];
            for (var column: usize = 0; column < 12; ++column) { row[column] = convert(i32, test_random(&random) % (rows + 1)) - 1; }
            var accepting = test_random(&random) % 2 != 0;
            assert(lex_table_append(actual, &row[0], 12, accepting), "Lexer random row");
            assert(reference_lex_table_append(oracle, &row[0], 12, accepting), "Lexer reference row");
        }
        for (var sample: usize = 0; sample < 20; ++sample) {
            var source: u8[80];
            var length: usize = 0;
            for (var index: usize = 0; index < sample; ++index) {
                var fragment = test_random(&random) % 12;
                copy(&source[length], fragments[fragment], lengths[fragment]);
                length += lengths[fragment];
            }
            for (var start: usize = 0; start <= length + 1; ++start) {
                assert(lex_table_match(actual, &source[0], length, start) == reference_lex_table_match(oracle, &source[0], length, start), "Lexer maximal-prefix reference comparison");
            }
        }
        lex_table_destroy(actual);
        reference_lex_table_destroy(oracle);
    }
    assert(tower_test_buffer_count() == baseline, "Lexer random tables cleanup");
}
