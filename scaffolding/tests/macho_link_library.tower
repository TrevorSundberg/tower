import tower;
extern fn backtrace(frames: void**, count: i32): i32;
var MachoTestTraceCapacity: i32 = 32;
export fn macho_answer(): i32 { return 42; }
export fn macho_frame(data: u8*, size: usize): i32 { return convert(i32, data[0]) + convert(i32, data[size - 1]); }
export fn macho_trace(): i32 { var frames: void*[32]; return backtrace(&frames[0], MachoTestTraceCapacity); }
