import tower;
import .compiler.semantic_context_types;
import .compiler.semantic_program_types;
import .compiler.semantic_query_api;
import .compiler.semantic_work_ids;
import .compiler.foundation_tags;
import .library.work_budget;
import .library.work_budget_types;
import .library.work_graph;
import .library.work_pool;
import .library.vector;

extern fn compiler_world_create_workers(workers: usize): void*;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_bind_budget(world: void*, budget: WorkBudget*): bool;
extern fn compiler_world_dispose(world: void*): bool;
extern fn entity_create(store: void*): void*;
extern fn puts(text: u8*): i32;

// The existing Linux link wrapper denies one coordinator semaphore creation.
// Workers and allocation remain real; no worker reads or writes this flag.
extern fn __real_work_signal_open(): void*;
var SemanticDispatchFailSignal: bool;
export fn __wrap_work_signal_open(): void* {
    if SemanticDispatchFailSignal { SemanticDispatchFailSignal = false; return null; }
    return __real_work_signal_open();
}

fn dispatch_check(ok: bool, message: u8*, failures: u32*): void {
    if !ok { puts(message); (*failures)++; }
}

fn dispatch_trial(width: u32, deny: bool): u32 {
    var failures: u32 = 0;
    var workers: usize = 4;
    var budget: WorkBudget = default;
    var gate = work_signal_open();
    sem_require(gate != null);
    defer work_signal_close(gate);
    work_signal_post(gate);
    sem_require(work_budget_init(&budget, workers, 1048576, 89)
        && work_budget_synchronize(&budget, gate, work_signal_wait, work_signal_post));
    var world = compiler_world_create_workers(workers);
    sem_require(world != null && compiler_world_bind_budget(world, &budget));
    var root = entity_create(compiler_world_store(world));
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, width);
    var context: SemanticContext = default;
    sem_context_init(&context, &program);
    context.generics = generic_begin(root);
    context.known_bindings = sem_create(root);
    var blocks: void*[3];
    var count = sizeof(decltype(blocks)) / sizeof(void*);
    for(var i: usize = 0; i < count; i++) {
        var function = i == 0 ? root : sem_create(root);
        var value = i == 0 ? sem_get(root) : sem_attach(function, KFunction);
        value.start = 11 + i * 18;
        value.type.pointer_bytes = width;
        var block = function;
        if i != 0 {
            block = sem_create(function);
            sem_attach(block, KBlock);
            value.body = block;
            sem_require(vector_push(&program.functions, function));
        }
        blocks[i] = block;
        var item = sem_create(block);
        var literal = sem_attach(item, KOperand);
        literal.type.scalar = SI32;
        literal.type.pointer_bytes = width;
        literal.constant = true;
        literal.bits = 42;
        sem_require(vector_push(&sem_get(block).items, null)
            && vector_push(&sem_get(block).items, item));
    }
    // Complete pool construction before arming the later batch-claim failure.
    sem_require(work_pool_open(&context.workers, workers)
        && context.workers.threaded && context.workers.count == workers);
    SemanticDispatchFailSignal = deny;
    sem_known_publish(&context);
    dispatch_check(!SemanticDispatchFailSignal, "The requested dispatch claim was exercised", &failures);
    dispatch_check(context.workers.running == 0 && context.queries.running == 0,
        "Dispatch failure drains every peer and retires all claimed tickets", &failures);
    dispatch_check(context.workers.resource_error == (deny ? WorkBudgetError.Memory : WorkBudgetError.None),
        "Dispatch retains its typed allocation failure", &failures);
    dispatch_check(deny ? program.error.length != 0 && program.error_offset == 11 : program.error.length == 0,
        "Dispatch failure reports the first source ordinal", &failures);
    for(var i: usize = 0; i < count; i++) {
        var query = work_find(&context.queries, program.functions.data[i], convert(u32, SemanticQuery.KnownPublish), 0);
        dispatch_check(query != 0 && work_task(&context.queries, query).state
            == (deny ? WorkState.Failed : WorkState.Succeeded),
            "No unexecuted publication ticket succeeds", &failures);
        var items = &sem_get(blocks[i]).items;
        dispatch_check(items.length == (deny ? 2 : 1) && (deny ? items.data[0] == null : items.data[0] != null),
            "A failed dispatch cannot publish canonical compaction", &failures);
    }
    if deny {
        var tasks = context.queries.tasks.length;
        sem_known_publish(&context);
        dispatch_check(context.queries.tasks.length == tasks && context.workers.claim == null,
            "Repeated failed entry cannot retry dispatch or its effects", &failures);
    }
    work_pool_close(&context.workers);
    dispatch_check(context.workers.resource_error == (deny ? WorkBudgetError.Memory : WorkBudgetError.None),
        "Pool close preserves the fixed failure receipt", &failures);
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(root);
    dispatch_check(compiler_world_dispose(world), "Dispatch world cleanup succeeds", &failures);
    var snapshot: WorkBudgetSnapshot = default;
    sem_require(work_budget_snapshot(&budget, &snapshot));
    dispatch_check(snapshot.used_bytes == 0 && snapshot.used_lanes == 0 && snapshot.live == 0
        && work_budget_dispose(&budget), "Dispatch cleanup releases every budget receipt", &failures);
    return failures;
}

export fn main(argc: i32, argv: u8**): i32 {
    SemanticDispatchFailSignal = false;
    var failures: u32 = 0;
    for(var width: u32 = 4; width <= 8; width *= 2) {
        failures += dispatch_trial(width, false);
        failures += dispatch_trial(width, true);
    }
    if failures == 0 { puts("Semantic dispatch failures retain diagnostics without publishing or replaying work."); }
    return failures == 0 ? 0 : 1;
}
