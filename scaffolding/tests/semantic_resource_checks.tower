import tower;
import .compiler.semantic_context_types;
import .compiler.semantic_evaluation_types;
import .compiler.semantic_program_types;
import .compiler.semantic_query_api;
import .compiler.semantic_work_ids;
import .compiler.foundation_tags;
import .compiler.compiler_kernel;
import .compiler.interpreter_context_types;
import .library.work_budget;
import .library.work_budget_types;
import .library.work_graph;
import .library.work_pool;
import .library.vector;

extern fn compiler_world_create_workers(workers: usize): void*;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_bind_budget(world: void*, budget: WorkBudget*): bool;
extern fn compiler_world_dispose(world: void*): bool;
extern fn entity_create(store: void*): void*;
extern fn interpreter_invocation_step(invocation: IMInvocation*, budget: usize): void;
extern fn puts(text: u8*): i32;

var ResourceBudgetBytes: usize = 16384;
var ResourceGrowthFrameBytes: usize = 8192;
var ResourceEntryGateQuery: u32 = 1000;
var ResourceFinishValuePhase: usize = 4;

struct ResourceProbe {
    invocation: IMInvocation*;
    entry: void*;
    growth: bool;
    observed: bool;
}

fn resource_check(ok: bool, message: u8*, failures: u32*): void {
    if !ok { puts(message); (*failures)++; }
}

// Only the transport payload is opaque. Each worker owns its probe flag and
// delegates the actual invocation to the unchanged production Evaluate kernel.
// Observe the precise phase before the coordinator replaces/disposes its error.
fn resource_probe_execute(payload: void*): void {
    var kernel = bits(CompilerKernel*, payload);
    if kernel.kind != CompilerKernelKind.Evaluate { work_kernel_execute(payload); return; }
    var probe = bits(ResourceProbe*, kernel.payload);
    var invocation = probe.invocation;
    var original: CompilerKernel = {kind: CompilerKernelKind.Evaluate, payload: bits(void*, invocation)};
    work_kernel_execute(bits(void*, &original));
    var state = &invocation.state;
    if !state.failed || state.storage_error != WorkBudgetError.Capacity
        || invocation.context.error.data == null { return; }
    if probe.growth {
        probe.observed = state.steps != 0 && state.frames.length == 1
            && state.frames.data[0].function == probe.entry && state.memory.data != null
            && sem_equal(invocation.context.error.data, "Cannot grow strict evaluation stack");
        if !probe.observed {
            puts("Nested-growth denial before the expected stack request:");
            puts(invocation.context.error.data);
        }
    } else {
        probe.observed = state.steps == 0 && state.frames.length == 0 && state.memory.data == null
            && state.node_cache.data == null && state.node_cache.length == 0
            && state.node_cache.capacity == 0 && !state.node_cache.reservation.active
            && sem_equal(invocation.context.error.data, "Cannot allocate interpreter node cache");
    }
}

fn resource_entry_ready(result: SemanticEvaluation*): bool {
    var invocation = &result.invocation;
    var state = &invocation.state;
    return result.started && !state.failed && state.storage_error == WorkBudgetError.None
        && state.steps == 0 && state.memory.data != null && state.frames.length == 1
        && state.node_cache.data != null && state.node_cache.length != 0
        && state.node_cache.reservation.active && state.node_cache.reservation.owner == state.budget
        && state.frames.data[0].function == result.function
        && state.frames.data[0].tasks.length != 0 && invocation.context.root == result.function
        && invocation.context.error.length == 0 && invocation.context.output.length == 0;
}

// Execute the ordinary entry continuation until the nested call is next. This
// admits its sequencing cache through real execution before pressure, without
// predicting a map capacity or consuming the callee's stack request.
fn resource_nested_call_ready(result: SemanticEvaluation*): bool {
    var invocation = &result.invocation;
    var state = &invocation.state;
    while !state.failed && !state.done && state.frame_count == 1 {
        var frame = &state.frames.data[0];
        if frame.function != result.function || frame.tasks.length == 0 { return false; }
        var task = frame.tasks.data[frame.tasks.length - 1];
        if task.phase == ResourceFinishValuePhase && sem_get(task.node).kind == KCall {
            var call = sem_get(task.node);
            return call.binding != null && sem_get(call.binding).frame_size == ResourceGrowthFrameBytes
                && state.storage_error == WorkBudgetError.None && !invocation.context.returned
                && invocation.context.error.length == 0 && invocation.context.output.length == 0;
        }
        var steps = state.steps;
        interpreter_invocation_step(invocation, 1);
        if state.steps == steps || invocation.context.waiting != null { return false; }
    }
    return false;
}

fn resource_stage(c: SemanticContext*, offset: usize, inferred: bool, growth: bool, gate: usize): SemanticEvaluation* {
    var subject = sem_create(c.program.root);
    var value = sem_attach(subject, KOperand);
    value.type.scalar = SI32;
    value.type.pointer_bytes = c.program.pointer_bytes;
    value.constant = true;
    value.start = offset;
    var input = sem_create(c.program.root);
    var literal = sem_attach(input, KOperand);
    literal.type = value.type;
    literal.constant = true;
    literal.bits = 42;
    if growth {
        // Entry frames fit the shared budget. Only the executed nested call
        // requests this larger frame, after preparation has succeeded.
        var callee = sem_create(c.program.root);
        var function = sem_attach(callee, KFunction);
        function.type = value.type;
        function.frame_size = ResourceGrowthFrameBytes;
        function.body = sem_create(callee);
        var body = sem_attach(function.body, KBlock);
        var returned = sem_create(function.body);
        sem_attach(returned, KReturn).value = input;
        sem_require(vector_push(&body.items, returned));
        input = sem_create(c.program.root);
        var call = sem_attach(input, KCall);
        call.type = value.type;
        call.binding = callee;
    }
    var result = bits(SemanticEvaluation*, entity_component_data(entity_component_add(subject, c.evaluation_results)));
    *result = default;
    result.subject = subject;
    result.owner = c.program.root;
    result.literal = subject;
    result.expression = input;
    result.requested = true;
    result.inferred = inferred;
    result.ready = bits(IMDependency*, entity_component_data(entity_component_add(subject, c.evaluation_ready)));
    *result.ready = default;
    result.ready.subject = subject;
    result.kernel.kind = CompilerKernelKind.Evaluate;
    result.kernel.payload = bits(void*, &result.invocation);
    sem_push(&c.evaluation_jobs, bits(void*, result));
    if gate != 0 {
        // Add the fixture prerequisite while Evaluation is still Building;
        // ordinary request registration owns its preparation edge and seal.
        var query = work_request(&c.queries, subject, convert(u32, SemanticQuery.Evaluation), 0);
        sem_require(query != 0 && work_depend(&c.queries, query, gate));
    }
    sem_evaluation_request(c, result);
    if growth && !inferred {
        // The required stage consumes the existing production helper-readiness
        // contract. This checked ordinary callee is already available.
        var callee = sem_get(input).binding;
        var executable = bits(IMFunctionInput*, entity_component_data(entity_component_add(callee, c.executable_ready)));
        *executable = default;
        executable.function = callee;
        executable.ready = true;
    }
    return result;
}

fn resource_trial(width: u32, workers: usize, inferred: bool, isolated: bool, growth: bool): u32 {
    var failures: u32 = 0;
    var budget: WorkBudget = default;
    var gate = work_signal_open();
    sem_require(gate != null);
    defer work_signal_close(gate);
    work_signal_post(gate);
    sem_require(work_budget_init(&budget, workers, ResourceBudgetBytes, 91)
        && work_budget_synchronize(&budget, gate, work_signal_wait, work_signal_post));
    var occupied: WorkReservation = default;
    var world = compiler_world_create_workers(workers);
    sem_require(world != null && compiler_world_bind_budget(world, &budget));
    var root = entity_create(compiler_world_store(world));
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, width);
    var context: SemanticContext = default;
    sem_context_init(&context, &program);
    context.generics = generic_begin(root);
    sem_evaluation_begin(&context);
    if inferred {
        // The immutable-input proof is already complete. These literal inputs
        // have no captures; normal clone/preparation kernels still run below.
        var proof = work_request(&context.queries, root, convert(u32, SemanticQuery.KnownProof), 0);
        var ticket: WorkTicket = default;
        sem_require(work_seal(&context.queries, proof) && work_demand(&context.queries, proof)
            && work_take_task(&context.queries, &ticket, proof));
        sem_require(work_finish(&context.queries, &ticket, true));
    }
    var prerequisite: usize = 0;
    if growth {
        prerequisite = work_request(&context.queries, root, ResourceEntryGateQuery, 0);
        sem_require(prerequisite != 0 && work_seal(&context.queries, prerequisite));
    }
    var first = resource_stage(&context, 11, inferred, growth, prerequisite);
    var second = resource_stage(&context, 29, inferred, growth, prerequisite);
    var first_probe: ResourceProbe = {invocation: &first.invocation, growth: growth, ..default};
    var second_probe: ResourceProbe = {invocation: &second.invocation, growth: growth, ..default};
    first.kernel.payload = bits(void*, &first_probe);
    second.kernel.payload = bits(void*, &second_probe);
    // Constructors and pool storage succeed before either denial phase. Both
    // stack-owned probes remain alive through pool drain and world retirement.
    sem_require(work_pool_open_kernel_budget(&context.workers, workers, resource_probe_execute, &budget));
    context.declaration_isolated = isolated;
    if growth {
        var prepared = sem_evaluation_pump(&context);
        resource_check(prepared == SemanticPumpResult.Waiting && context.workers.running == 0
            && program.error.length == 0 && program.resource.error == WorkBudgetError.None
            && resource_entry_ready(first) && resource_entry_ready(second),
            "Nested-growth setup did not prepare both owning entry frames before pressure", &failures);
        first_probe.entry = first.function;
        second_probe.entry = second.function;
        resource_check(resource_nested_call_ready(first) && resource_nested_call_ready(second),
            "Nested-growth pressure starts at both real queued calls after entry sequencing", &failures);
        var ticket: WorkTicket = default;
        sem_require(work_take_task(&context.queries, &ticket, prerequisite)
            && work_finish(&context.queries, &ticket, true));
    }
    // Each intended request fits the total limit. Consume the measured remaining
    // capacity only after setup (and, for growth, successful joined entry prep).
    // No guessed residual allowance can turn entry denial into growth coverage.
    var available: WorkBudgetSnapshot = default;
    sem_require(work_budget_snapshot(&budget, &available) && available.used_bytes < available.bytes
        && work_budget_reserve_result(&budget, 0, 0, available.bytes - available.used_bytes, &occupied)
            == WorkBudgetError.None);
    sem_evaluation_pump(&context);
    resource_check(context.workers.running == 0 && first.started && second.started,
        "Resource denial joins every admitted preparation/evaluation peer", &failures);
    resource_check(first_probe.observed && second_probe.observed,
        growth ? "Missing exact executed nested-memory growth denial in one or both workers"
            : "Missing exact invocation startup-node-cache denial in one or both workers", &failures);
    if isolated {
        resource_check(program.error.length == 0 && program.resource.error == WorkBudgetError.None,
            "Isolated resource receipts wait for owning diagnostic selection", &failures);
        context.declaration_isolated = false;
        sem_evaluations(&context);
    }
    resource_check(program.error.length != 0 && program.error_offset == 11,
        "Required and inferred resource denial selects the first source-ordered diagnostic", &failures);
    resource_check(program.resource.error == WorkBudgetError.Capacity && program.resource.offset == program.error_offset,
        "The actual denial phase publishes its typed receipt at the selected owning source", &failures);
    if program.error.length == 0 || program.error_offset != 11 {
        puts(growth ? "Diagnostic phase: nested growth" : "Diagnostic phase: startup");
        puts(inferred ? "Diagnostic stage: inferred" : "Diagnostic stage: required");
        puts(isolated ? "Diagnostic owner: isolated" : "Diagnostic owner: immediate");
        puts(program.error_offset == 29 ? "Selected later source offset 29"
            : program.error_offset == 0 ? "Selected source offset 0" : "Selected unexpected source offset");
        puts(first.error_offset == 11 ? "Earlier receipt retains offset 11" : "Earlier receipt has unexpected offset");
        puts(second.error_offset == 29 ? "Later receipt retains offset 29" : "Later receipt has unexpected offset");
        if program.error.length != 0 { puts(program.error.data); }
    }
    for(var index: usize = 0; index < context.evaluation_jobs.length; index++) {
        var result = bits(SemanticEvaluation*, context.evaluation_jobs.data[index]);
        var query = work_find(&context.queries, result.subject, convert(u32, SemanticQuery.Evaluation), 0);
        resource_check(result.ready.ready && result.ready.failed && work_task(&context.queries, query).state == WorkState.Failed,
            "Resource failure never becomes successful optional inference", &failures);
        resource_check(result.resource_error == WorkBudgetError.Capacity,
            "Capacity receipt survives interpreter disposal", &failures);
        if result.resource_error != WorkBudgetError.Capacity {
            puts(growth ? "Resource trial: nested growth" : "Resource trial: startup");
            if result.error.length != 0 { puts(result.error.data); }
            if result.resource_error == WorkBudgetError.None { puts("Retained resource code: None"); }
            if result.resource_error == WorkBudgetError.Invalid { puts("Retained resource code: Invalid"); }
            if result.resource_error == WorkBudgetError.Memory { puts("Retained resource code: Memory"); }
        }
        resource_check(result.invocation.state.memory.data == null && sem_get(result.subject).bits == 0,
            "Failed invocations retire storage without publishing a value", &failures);
        var dispatch = work_task(&context.queries, query).dispatch;
        sem_evaluation_pump(&context);
        resource_check(work_task(&context.queries, query).dispatch == dispatch,
            "Repeated failed pumps do not replay interpreter work", &failures);
    }
    work_pool_close(&context.workers);
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(root);
    resource_check(compiler_world_dispose(world), "Resource-denied stages release their world", &failures);
    var snapshot: WorkBudgetSnapshot = default;
    sem_require(work_budget_snapshot(&budget, &snapshot));
    resource_check(snapshot.used_bytes == occupied.bytes && snapshot.live == 1,
        "Only the independent capacity holder remains after semantic cleanup", &failures);
    sem_require(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None
        && work_budget_snapshot(&budget, &snapshot));
    resource_check(snapshot.used_bytes == 0
        && snapshot.used_lanes == 0 && snapshot.live == 0 && work_budget_dispose(&budget),
        "All resource receipts retire after worker and world cleanup", &failures);
    return failures;
}

export fn semantic_resource_tests(width: u32, workers: usize): u32 {
    var failures: u32 = 0;
    for(var mode: usize = 0; mode < 2; mode++) {
        failures += resource_trial(width, workers, false, false, mode != 0);
        failures += resource_trial(width, workers, true, false, mode != 0);
        failures += resource_trial(width, workers, true, true, mode != 0);
    }
    return failures;
}
