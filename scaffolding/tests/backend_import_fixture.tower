import tower;
import backend_overflow_fixture;
import .backend.bindings;
import .backend.context;
import .backend.target;
import .backend.import_bindings;
import .backend.lowering;
import .backend.pipeline;
import .backend.text;
import .compiler.foundation_tags;

extern fn LLVMBuildPhi(builder: void*, type: void*, name: u8*): void*;
extern fn LLVMAddIncoming(phi: void*, values: void**, blocks: void**, count: u32): void;

// The same world-owned Foundation input and LLVM C boundary used by the backend
// fixtures. Fault injection starts only after this healthy module exists.
export fn backend_import_fixture_open(root: void*): Backend* {
    return backend_import_fixture_target(root, "x86_64-unknown-linux-gnu", false);
}

export fn backend_import_fixture_bytes(root: void*, target: u8*): Backend* {
    return backend_import_fixture_target(root, target, true);
}

// A counted initializer is read into a completely initialized buffer. Both
// canaries are installed before the copy and observed afterwards; no trailing
// terminator store or omitted byte can hide behind uninitialized destination
// memory. The admission-only fixture retains its original module and output.
fn backend_import_fixture_guarded(b: Backend*, source: void*, count: usize): void {
    var prefix: u8 = 91;
    var suffix: u8 = 93;
    var first = sizeof(decltype(prefix));
    var total = first + count + sizeof(decltype(suffix));
    var type = LLVMArrayType2(b.i8, convert(u64, total));
    var storage = LLVMBuildAlloca(b.builder, type, "guarded_bytes");
    LLVMBuildMemSet(b.builder, storage, LLVMConstInt(b.i8, 90, 0), backend_size_value(b, total), 1);
    var indices: void*[2]; indices[0] = backend_size_value(b, 0);
    indices[1] = backend_size_value(b, 0);
    var before = LLVMBuildGEP2(b.builder, type, storage, &indices[0], convert(u32, sizeof(decltype(indices)) / sizeof(void*)), "");
    LLVMBuildStore(b.builder, LLVMConstInt(b.i8, convert(u64, prefix), 0), before);
    indices[1] = backend_size_value(b, first + count);
    var after = LLVMBuildGEP2(b.builder, type, storage, &indices[0], convert(u32, sizeof(decltype(indices)) / sizeof(void*)), "");
    LLVMBuildStore(b.builder, LLVMConstInt(b.i8, convert(u64, suffix), 0), after);
    indices[1] = backend_size_value(b, first);
    var destination = LLVMBuildGEP2(b.builder, type, storage, &indices[0], convert(u32, sizeof(decltype(indices)) / sizeof(void*)), "");
    LLVMBuildMemMove(b.builder, destination, 1, source, 1, backend_size_value(b, count));
    for (var index: usize = 0; index < total; index++) {
        indices[1] = backend_size_value(b, index);
        var address = LLVMBuildGEP2(b.builder, type, storage, &indices[0], convert(u32, sizeof(decltype(indices)) / sizeof(void*)), "");
        var byte = LLVMBuildLoad2(b.builder, b.i8, address, "");
        var args: void*[3];
        args[0] = LLVMConstInt(b.i32, convert(u64, SI32), 0);
        args[1] = LLVMBuildZExt(b.builder, byte, b.i64, "");
        args[2] = LLVMConstInt(b.i32, convert(u64, b.pointer_bytes), 0);
        backend_call_values(b, b.print_fn, &args[0], convert(u32, sizeof(decltype(args)) / sizeof(void*)));
    }
}

fn backend_import_fixture_target(root: void*, target: u8*, execute_bytes: bool): Backend* {
    var b = backend_open(target);
    if b == null { return null; }
    b.source_root = root;
    var program = sem_attach(root, KProgram);
    program.type.scalar = SVoid;
    program.type.pointer_bytes = b.pointer_bytes;
    backend_require(b, backend_text(&program.comments, "// reconstruction admission\n"));
    backend_runtime_declarations(b);
    // Exercise counted byte-run reconstruction, including interior NUL runs,
    // through the same real import stage and serial admission-failure trials.
    var bytes: u8[6] = default;
    bytes[0] = 65; bytes[2] = 128; bytes[3] = 255; bytes[5] = 67;
    var initializer = LLVMConstStringInContext(b.context, &bytes[0], convert(u32, sizeof(decltype(bytes))), 1);
    var global = LLVMAddGlobal(b.module, LLVMTypeOf(initializer), "counted_bytes");
    LLVMSetInitializer(global, initializer);
    var parameters: void*[1]; parameters[0] = b.i32;
    var signature = LLVMFunctionType(b.i32, &parameters[0], convert(u32, sizeof(decltype(parameters)) / sizeof(void*)), 0);
    var choose = LLVMAddFunction(b.module, "choose", signature);
    var entry = LLVMAppendBasicBlockInContext(b.context, choose, "entry");
    var yes = LLVMAppendBasicBlockInContext(b.context, choose, "yes");
    var no = LLVMAppendBasicBlockInContext(b.context, choose, "no");
    var join = LLVMAppendBasicBlockInContext(b.context, choose, "join");
    LLVMPositionBuilderAtEnd(b.builder, entry);
    LLVMBuildCondBr(b.builder, LLVMBuildICmp(b.builder, 33, LLVMGetParam(choose, 0), LLVMConstInt(b.i32, 0, 0), ""), yes, no);
    LLVMPositionBuilderAtEnd(b.builder, yes); LLVMBuildBr(b.builder, join);
    LLVMPositionBuilderAtEnd(b.builder, no); LLVMBuildBr(b.builder, join);
    LLVMPositionBuilderAtEnd(b.builder, join);
    var phi = LLVMBuildPhi(b.builder, b.i32, "answer");
    var values: void*[2]; values[0] = LLVMConstInt(b.i32, 42, 0); values[1] = LLVMConstInt(b.i32, 40, 0);
    var blocks: void*[2]; blocks[0] = yes; blocks[1] = no;
    LLVMAddIncoming(phi, &values[0], &blocks[0], convert(u32, sizeof(decltype(values)) / sizeof(void*)));
    LLVMBuildRet(b.builder, phi);
    var function = LLVMAddFunction(b.module, "tower_main", LLVMFunctionType(LLVMVoidTypeInContext(b.context), null, 0, 0));
    LLVMPositionBuilderAtEnd(b.builder, LLVMAppendBasicBlockInContext(b.context, function, "entry"));
    var slot = LLVMBuildAlloca(b.builder, b.pointer_type, "callback");
    LLVMBuildStore(b.builder, choose, slot);
    var callback = LLVMBuildLoad2(b.builder, b.pointer_type, slot, "loaded");
    var argument: void*[1]; argument[0] = LLVMConstInt(b.i32, 1, 0);
    var result = LLVMBuildCall2(b.builder, signature, callback, &argument[0], convert(u32, sizeof(decltype(argument)) / sizeof(void*)), "result");
    var print_args: void*[3];
    print_args[0] = LLVMConstInt(b.i32, convert(u64, SI32), 0);
    print_args[1] = LLVMBuildZExt(b.builder, result, b.i64, "");
    print_args[2] = LLVMConstInt(b.i32, convert(u64, b.pointer_bytes), 0);
    backend_call_values(b, b.print_fn, &print_args[0], convert(u32, sizeof(decltype(print_args)) / sizeof(void*)));
    if execute_bytes {
        backend_import_fixture_guarded(b, global, sizeof(decltype(bytes)));
        var runs: u8[8] = default;
        runs[2] = 128; runs[3] = 128; runs[4] = 255; runs[5] = 255;
        var repeated = LLVMConstStringInContext(b.context, &runs[0], convert(u32, sizeof(decltype(runs))), 1);
        var run_global = LLVMAddGlobal(b.module, LLVMTypeOf(repeated), "counted_runs");
        LLVMSetInitializer(run_global, repeated);
        backend_import_fixture_guarded(b, run_global, sizeof(decltype(runs)));
    }
    LLVMBuildRetVoid(b.builder);
    if !backend_optimize(b, false) { backend_close(b); return null; }
    return b;
}

export fn backend_import_fixture_failure(b: Backend*, offset: usize): void {
    b.source_offset = offset;
    backend_fail(b, "Earlier backend diagnostic");
}

export fn backend_import_fixture_unsupported(b: Backend*): void {
    var type = LLVMIntTypeInContext(b.context, 128);
    LLVMAddFunction(b.module, "unsupported", LLVMFunctionType(type, null, 0, 0));
}
