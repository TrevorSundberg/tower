import tower;
import driver;
import driver_formatting_test;
import driver_platform_api;
import .host.driver_support;
import .host.driver_platform;
import .library.bytes_types;
import .library.bytes_interface;

extern fn puts(text: u8*): i32;

fn driver_format_command(compiler: u8*, source: u8*, output: u8*, check: bool): i32 {
    var args: DriverArguments;
    driver_arguments_init(&args); defer driver_arguments_dispose(&args);
    driver_argument(&args, "", compiler); driver_argument(&args, "", source);
    if check { driver_argument(&args, "", "--check-format"); }
    else { driver_argument(&args, "", "--emit"); driver_argument(&args, "", "source"); }
    if output != null { driver_argument(&args, "", "-o"); driver_argument(&args, "", output); }
    // Source formatting must not create a backend or invoke a toolchain.
    driver_argument(&args, "", "--target"); driver_argument(&args, "", "formatter-has-no-machine-target");
    driver_argument(&args, "", "--cc"); driver_argument(&args, "", "formatter-must-not-launch-clang");
    return driver_test_capture(&args);
}

fn driver_test_formatting(compiler: u8*, library: u8*): void {
    var fixture = format_fixture(compiler);
    format_canonical_and_overwrite(fixture);
    format_imports_and_unchecked_names(fixture);
    format_reject_syntax(fixture);
    format_reject_missing_module(fixture);
    format_reject_changed_grammar(fixture);
    format_reject_invalid_utf8(fixture);
    format_reject_embedded_nul(fixture);
    format_output_errors_and_empty_source(fixture);
    format_bedrock_and_foundation(compiler, library);
    puts("Scoped native source formatting, canonical checks, imports and failure preservation passed.");
}
