import tower;
import frontend_units;
import utility_checks;
import unit_stream_clock;
import .library.compiler_work_types;
import .library.vector;
import .library.work_gate;
import .compiler.grammar_types;
import .compiler.format_api;
import .compiler.format_types;
import .compiler.semantic_program_types;
import .compiler.interpreter_context_types;

extern fn printf(format: u8*, seed: u32, workers: usize, mode: u8*, revision: u64): i32;
extern fn frontend_units_observer(batch: void*, context: void*,
    callback: function(void, void*, CompilerQuery, usize, bool)): bool;

extern fn pthread_self(): usize;

// Native observation only: each callback writes its own ordinal's slot. The
// coordinator reads slots after joining; no observer delays or compiler writes.
struct DependencyUnitSpan { start: u64; end: u64; thread: usize; }
struct DependencyUnitObserver { spans: DependencyUnitSpan*; count: usize; }
var DependencyUnitByteLimit: usize = 2147483648;
var DependencyUnitProfile: u64 = 1;

fn dependency_unit_event(payload: void*, phase: CompilerQuery, ordinal: usize, entering: bool): void {
    var observer = bits(DependencyUnitObserver*, payload);
    units_check(phase == CompilerQuery.Unit && ordinal != 0 && ordinal <= observer.count,
        "Dependency unit observer has a valid private slot");
    var span = &observer.spans[ordinal - 1];
    if entering { span.start = unit_stream_clock(); span.thread = pthread_self(); }
    else { span.end = unit_stream_clock(); }
}

fn dependency_unit_append(out: vector(u8)*, text: u8*): void {
    var length = strlen(text);
    for(var i: usize = 0; i < length; i++) {
        units_check(vector_push(out, text[i]), "Dependency fixture source snapshot");
    }
}

var StagingExtentWorkers: usize = 4;
struct StagingExtentObserver {
    gate: void*;
    active: usize;
    peak: usize;
    threads: usize[StagingExtentWorkers];
    count: usize;
    calls: usize;
}

fn staging_extent_event(context: void*, phase: GrammarPhase, entering: bool, ordinal: usize, kind: usize): void {
    if phase != GrammarPhase.SemanticKernel { return; }
    var observer = bits(StagingExtentObserver*, context);
    work_gate_enter(observer.gate);
    defer work_gate_leave(observer.gate);
    if !entering { observer.active--; return; }
    observer.calls++;
    observer.active++;
    if observer.active > observer.peak { observer.peak = observer.active; }
    var thread = pthread_self();
    for(var i: usize = 0; i < observer.count; i++) { if observer.threads[i] == thread { return; } }
    units_check(observer.count < sizeof(decltype(observer.threads)) / sizeof(usize), "Staging kernel thread ceiling");
    observer.threads[observer.count++] = thread;
}

struct SeedReceipt { canonical: vector(u8); diagnostic: vector(u8); offset: usize; }

fn seed_answer(program: SemanticProgram*, name: u8*, wanted: u64, ordinal: usize): bool {
    var target: void* = null;
    foreach(var function in &program.functions) {
        var node = sem_get(function);
        if node.name.length == strlen(name) && strcmp(node.name.data, name) == 0 { target = function; }
    }
    var invocation: IMInvocation = default;
    defer interpreter_invocation_dispose(&invocation);
    if target == null || !interpreter_invocation_init(&invocation, target,
        convert(usize, program.pointer_bytes), null, 0, true, 10000) { return false; }
    while !invocation.state.done && !invocation.state.failed { interpreter_invocation_step(&invocation, 7); }
    if invocation.state.failed { puts(invocation.context.error.data); }
    var ok = invocation.state.done && !invocation.state.failed && invocation.context.result == wanted;
    if !ok {
        var report: FormatResult = default; defer format_dispose(&report);
        var out: FormatEngine = {result: &report, ..default};
        format_text(&out, "request unit="); format_unsigned(&out, convert(u64, ordinal));
        format_text(&out, " "); format_text(&out, name); format_text(&out, " actual="); format_unsigned(&out, invocation.context.result);
        format_text(&out, " wanted="); format_unsigned(&out, wanted);
        units_check(!report.failed && vector_push(&report.text, 0), "Seeded mismatch diagnostic"); puts(report.text.data);
    }
    return ok;
}

fn seed_receipts_differ(serial: SeedReceipt*, parallel: SeedReceipt*): bool {
    return serial.offset != parallel.offset || serial.canonical.length != parallel.canonical.length
        || serial.diagnostic.length != parallel.diagnostic.length
        || !utility_equal(serial.canonical.data, parallel.canonical.data, serial.canonical.length)
        || !utility_equal(serial.diagnostic.data, parallel.diagnostic.data, serial.diagnostic.length);
}

fn seed_receipt_dispose(receipt: SeedReceipt*): void {
    vector_dispose(&receipt.canonical); vector_dispose(&receipt.diagnostic);
}
