import tower;
import .compiler.format_parser_table_types;
import .compiler.format_types;
import .compiler.parser_table_types;
import .compiler.parser_markers;
import .compiler.grammar_types;
import frontend_table_owner;
import frontend_world;

extern fn parser_format_create(table: ParserHostTable*, kind: ParserFormatKind, first: usize, second: usize, names: bool, descriptions: bool): ParserFormat*;

extern fn parser_format_destroy(request: ParserFormat*): void;

extern fn parser_format_next(request: ParserFormat*): ParserFormatNeed;

extern fn parser_format_index(request: ParserFormat*): usize;

extern fn parser_format_reply(request: ParserFormat*, text: u8*, length: usize): void;

extern fn parser_format_result(request: ParserFormat*): FormatResult*;

fn parser_text_equal(result: FormatResult*, wanted: u8*): void {
    var ok = !result.failed;
    table_owner_check(ok, 101);
    var index: usize = 0;
    for(; index < result.text.length; index++) {
        ok = wanted[index] != 0;
        table_owner_check(ok, 102);
        ok = result.text.data[index] == wanted[index];
        table_owner_check(ok, 103);
    }
    ok = wanted[index] == 0;
    table_owner_check(ok, 104);
}

fn parser_text_plain(table: ParserHostTable*, kind: ParserFormatKind, first: usize, second: usize, wanted: u8*): void {
    var request = parser_format_create(table, kind, first, second, false, false);
    var present = request != null;
    table_owner_check(present, 105);
    var done = parser_format_next(request) == ParserFormatNeed.Done;
    table_owner_check(done, 106);
    parser_text_equal(parser_format_result(request), wanted);
    done = parser_format_next(request) == ParserFormatNeed.Done;
    table_owner_check(done, 107);
    parser_format_destroy(request);
}

fn parser_text_callbacks(): void {
    var baseline = tower_test_buffer_count();
    parser_text_plain(null, ParserFormatKind.Scalar, convert(usize, ParserStreamEnd()), 0, "$");
    parser_text_plain(null, ParserFormatKind.Scalar, convert(usize, ParserLookahead()), 0, "#");
    parser_text_plain(null, ParserFormatKind.Scalar, 4294967295, 0, "4294967295");
    parser_text_plain(null, ParserFormatKind.Range, 65, 90, "[65-90]");
    parser_text_plain(null, ParserFormatKind.Range, 65, 65, "65");
    parser_text_plain(null, ParserFormatKind.Expected, convert(usize, ParserStreamEnd()), 0, "end of input");
    parser_text_plain(null, ParserFormatKind.Unexpected, convert(usize, ParserStreamEnd()), 0, "Unexpected end of input.");
    parser_text_plain(null, ParserFormatKind.Unexpected, 65, 0, "Unexpected 65.");
    var request = parser_format_create(null, ParserFormatKind.Range, 65, 90, true, false);
    var ok = parser_format_next(request) == ParserFormatNeed.Name;
    table_owner_check(ok, 108);
    ok = parser_format_index(request) == 65;
    table_owner_check(ok, 109);
    ok = parser_format_next(request) == ParserFormatNeed.Name;
    table_owner_check(ok, 110);
    parser_text_equal(parser_format_result(request), "[");
    var label: u8[1];
    label[0] = 65;
    parser_format_reply(request, &label[0], 1);
    label[0] = 88;
    ok = parser_format_next(request) == ParserFormatNeed.Name;
    table_owner_check(ok, 111);
    ok = parser_format_index(request) == 90;
    table_owner_check(ok, 112);
    parser_format_reply(request, null, 0);
    ok = parser_format_next(request) == ParserFormatNeed.Done;
    table_owner_check(ok, 113);
    parser_text_equal(parser_format_result(request), "[A-90]");
    parser_format_destroy(request);
    request = parser_format_create(null, ParserFormatKind.Scalar, 65, 0, true, false);
    parser_format_next(request);
    parser_format_reply(request, "", 0);
    ok = parser_format_next(request) == ParserFormatNeed.Done;
    table_owner_check(ok, 114);
    parser_text_equal(parser_format_result(request), "");
    parser_format_destroy(request);
    request = parser_format_create(null, ParserFormatKind.Scalar, 65, 0, true, false);
    parser_format_next(request);
    var bytes: u8[3];
    bytes[0] = 65;
    bytes[1] = 0;
    bytes[2] = 66;
    parser_format_reply(request, &bytes[0], 3);
    ok = parser_format_next(request) == ParserFormatNeed.Done;
    table_owner_check(ok, 151);
    ok = request.result.text.length == 3;
    table_owner_check(ok, 152);
    ok = request.result.text.data[1] == 0;
    table_owner_check(ok, 153);
    ok = request.result.text.data[2] == 66;
    table_owner_check(ok, 154);
    parser_format_destroy(request);
    request = parser_format_create(null, ParserFormatKind.Scalar, 65, 0, true, false);
    parser_format_next(request);
    parser_format_reply(request, null, 1);
    table_owner_check(request.result.failed, 115);
    parser_format_destroy(request);
    request = parser_format_create(null, ParserFormatKind.Scalar, 65, 0, true, false);
    parser_format_next(request);
    parser_format_destroy(request);
    request = parser_format_create(null, ParserFormatKind.Scalar, 65, 0, false, false);
    parser_format_reply(request, null, 0);
    table_owner_check(request.result.failed, 116);
    parser_format_destroy(request);
    ok = tower_test_buffer_count() == baseline;
    table_owner_check(ok, 117);
}

fn parser_text_table_tests(): void {
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    var kinds: FrontendKinds;
    frontend_world_check(frontend_world_test_kinds(world, &kinds));
    var root = table_owner_grammar(&kinds, TableOwnerFixture.Sequence);
    var table = parser_table_open(root, &kinds, null, ParserPresentation.Numeric, 0);
    table_owner_check(parser_table_build(table, false), 120);
    entity_release(root);
    table_owner_check(compiler_world_dispose(world), 121);
    parser_text_plain(table, ParserFormatKind.Item, 1, 1, "Root = 97 •98 ");
    parser_text_plain(table, ParserFormatKind.Rule, 0, 0, "S' = Root ");
    parser_text_plain(table, ParserFormatKind.Grammar, 0, 0,
    "S' = Root \nRoot = 97 98 \nnon_terminal(0, S')\n  S' = Root \nnon_terminal(1, Root)\n  Root = 97 98 \n");
    parser_text_plain(table, ParserFormatKind.Edge, 1, ParserNoIndex(), "reduce(1, Root = 97 98 •)");
    parser_text_plain(table, ParserFormatKind.Edge, ParserNoIndex(), 2, "shift(2, 97)");
    parser_text_plain(table, ParserFormatKind.State, 0, 0, "state(0):\n  edge(97, shift(2, 97))\n  goto(Root, state(1, Root))\n");
    parser_text_plain(table, ParserFormatKind.Tables, 0, 0,
    "~~~~~~~~~~\nstate(0):\n  edge(97, shift(2, 97))\n  goto(Root, state(1, Root))\n\nstate(1, Root):\n  edge($, reduce(0, S' = Root •))\n\nstate(2, 97):\n  edge(98, shift(3, 98))\n\nstate(3, 98):\n  edge($, reduce(1, Root = 97 98 •))\n\n..........\n");
    parser_text_plain(table, ParserFormatKind.Conflict, 0, 0, "");
    var request = parser_format_create(table, ParserFormatKind.Rule, 9999, 0, false, false);
    parser_format_next(request);
    table_owner_check(request.result.failed, 122);
    parser_format_destroy(request);
    var buffers = tower_test_buffer_count();
    var count = tower_test_buffer_allocations();
    request = parser_format_create(table, ParserFormatKind.Tables, 0, 0, false, false);
    parser_format_next(request);
    var ok = !request.result.failed;
    table_owner_check(ok, 123);
    count = tower_test_buffer_allocations() - count;
    parser_format_destroy(request);
    for(var budget: usize = 0; budget < count; budget++) {
        tower_test_buffer_fail_after(budget);
        request = parser_format_create(table, ParserFormatKind.Tables, 0, 0, false, false);
        var present = request != null;
        if present {
            var done = parser_format_next(request) == ParserFormatNeed.Done;
            table_owner_check(done, 124);
            table_owner_check(request.result.failed, 125);
        }
        tower_test_buffer_fail_after(frontend_world_unlimited());
        parser_format_destroy(request);
        ok = tower_test_buffer_count() == buffers;
        table_owner_check(ok, 126);
    }
    parser_table_destroy(table);
    ok = tower_test_buffer_count() == baseline;
    table_owner_check(ok, 127);
}

fn parser_text_conflict_tests(): void {
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    var kinds: FrontendKinds;
    frontend_world_check(frontend_world_test_kinds(world, &kinds));
    var root = table_owner_grammar(&kinds, TableOwnerFixture.Missing);
    var table = parser_table_open(root, &kinds, null, ParserPresentation.Numeric, 0);
    parser_text_plain(table, ParserFormatKind.Missing, 0, 0, "Unresolved grammar rule: Missing");
    parser_table_build(table, false);
    parser_text_plain(table, ParserFormatKind.Conflict, 0, 0, "Unresolved grammar rule");
    parser_table_destroy(table);
    entity_release(root);
    root = table_owner_grammar(&kinds, TableOwnerFixture.EmptyClosure);
    table = parser_table_open(root, &kinds, null, ParserPresentation.Numeric, 0);
    table_owner_check(parser_table_build(table, false), 130);
    parser_text_plain(table, ParserFormatKind.Rule, 2, 0, "Maybe = ");
    parser_text_plain(table, ParserFormatKind.Item, 2, 0, "Maybe = •");
    parser_table_destroy(table);
    entity_release(root);
    root = table_owner_grammar(&kinds, TableOwnerFixture.Ambiguous);
    table = parser_table_open(root, &kinds, null, ParserPresentation.Numeric, 0);
    table_owner_check(parser_table_build(table, false), 131);
    parser_text_plain(table, ParserFormatKind.Conflict, 0, 0,
    "Grammar conflict (reduce/reduce) on $: the parser could finish A = 120 , or finish B = 120 . Make these alternatives distinct; their order does not resolve the conflict.");
    var request = parser_format_create(table, ParserFormatKind.Conflict, 0, 0, true, true);
    var ok = parser_format_next(request) == ParserFormatNeed.Description;
    table_owner_check(ok, 132);
    ok = parser_format_index(request) == 3;
    table_owner_check(ok, 133);
    parser_format_reply(request, "custom A", 8);
    ok = parser_format_next(request) == ParserFormatNeed.Description;
    table_owner_check(ok, 134);
    ok = parser_format_index(request) == 4;
    table_owner_check(ok, 135);
    parser_format_reply(request, "", 0);
    ok = parser_format_next(request) == ParserFormatNeed.Name;
    table_owner_check(ok, 136);
    ok = parser_format_index(request) == 120;
    table_owner_check(ok, 137);
    parser_format_reply(request, "x-value", 7);
    ok = parser_format_next(request) == ParserFormatNeed.Done;
    table_owner_check(ok, 138);
    parser_text_equal(&request.result,
    "Grammar conflict (reduce/reduce) on $: the parser could finish custom A, or finish B = x-value . Make these alternatives distinct; their order does not resolve the conflict.");
    parser_format_destroy(request);
    parser_table_destroy(table);
    entity_release(root);
    table_owner_check(compiler_world_dispose(world), 139);
    ok = tower_test_buffer_count() == baseline;
    table_owner_check(ok, 140);
}

// Real ambiguous grammars exercise closure fallback, the three-alternative cap
// and preference for kernel contexts. No fabricated runtime/conflict indexes.
fn parser_text_shift_tests(kernels: bool): void {
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    var kinds: FrontendKinds;
    frontend_world_check(frontend_world_test_kinds(world, &kinds));
    var builder: GrammarBuilder;
    grammar_builder_init(&builder, &kinds);
    var rule = grammar_builder_rule(&builder, "Root", false);
    grammar_builder_reference(&builder, rule, "Root", "");
    if kernels {
        grammar_builder_literal(&builder, rule, "+");
    }
    grammar_builder_reference(&builder, rule, "Root", "");
    if kernels {
        rule = grammar_builder_rule(&builder, "Root", false);
        grammar_builder_literal(&builder, rule, "x");
    } else {
        rule = grammar_builder_rule(&builder, "Root", false);
        grammar_builder_literal(&builder, rule, "ab");
        rule = grammar_builder_rule(&builder, "Root", false);
        grammar_builder_literal(&builder, rule, "ac");
        rule = grammar_builder_rule(&builder, "Root", false);
        grammar_builder_literal(&builder, rule, "ad");
        rule = grammar_builder_rule(&builder, "Root", false);
        grammar_builder_literal(&builder, rule, "ae");
        rule = grammar_builder_rule(&builder, "Root", false);
        grammar_builder_literal(&builder, rule, "af");
        rule = grammar_builder_rule(&builder, "Root", false);
        grammar_builder_literal(&builder, rule, "a");
    }
    var root = grammar_builder_finish(&builder);
    var table = parser_table_open(root, &kinds, null, ParserPresentation.Numeric, 0);
    table_owner_check(parser_table_build(table, false), 145);
    var request = parser_format_create(table, ParserFormatKind.Conflict, 0, 0, false, true);
    var count: usize = 0;
    loop {
        var need = parser_format_next(request);
        var done = need == ParserFormatNeed.Done;
        if done {
            break;
        }
        var description = need == ParserFormatNeed.Description;
        table_owner_check(description, 146);
        count++;
        parser_format_reply(request, "choice", 6);
    }
    var ok: bool;
    if kernels {
        ok = count == 2;
        table_owner_check(ok, 147);
        parser_text_equal(&request.result, "Grammar conflict (shift/reduce) on 43: the parser could continue choice, or finish choice. Make these alternatives distinct; their order does not resolve the conflict.");
    } else {
        ok = count == 4;
        table_owner_check(ok, 148);
        parser_text_equal(&request.result, "Grammar conflict (shift/reduce) on 97: the parser could continue choice or choice or choice, or finish choice. Make these alternatives distinct; their order does not resolve the conflict.");
    }
    parser_format_destroy(request);
    parser_table_destroy(table);
    entity_release(root);
    table_owner_check(compiler_world_dispose(world), 149);
    ok = tower_test_buffer_count() == baseline;
    table_owner_check(ok, 150);
}

fn frontend_parser_text_tests(): void {
    parser_text_callbacks();
    parser_text_table_tests();
    parser_text_conflict_tests();
    parser_text_shift_tests(false);
    parser_text_shift_tests(true);
}
