import tower;
import .library.bytes;
import .library.bytes_types;
import .tools.tool_capture_linux;

extern fn runtime_write_all(stream: u32, data: u8*, length: usize): bool;
extern fn memcmp(left: u8*, right: u8*, length: usize): i32;
extern fn strlen(text: u8*): usize;

export fn main(argc: i32, argv: u8**): i32 {
    var stderr_fd: u32 = 2;
    if argc < 3 {
        var usage = "Usage: tower-selected-test-count SUMMARY COMPILER [ARG...]\n";
        runtime_write_all(stderr_fd, usage, strlen(usage));
        return 1;
    }

    var diagnostics: ByteBuffer = default;
    defer bytes_dispose(&diagnostics);
    var status = tool_capture_stderr(argv[2], argv + 2, ~convert(usize, 0), &diagnostics);
    if status != 0 { return status; }
    if !runtime_write_all(stderr_fd, diagnostics.data, diagnostics.length) { return 1; }

    // The driver writes its final summary to stderr after the guest completes.
    // Compare a whole terminal line, including the boundary before the count.
    var summary = argv[1];
    var length = strlen(summary);
    if diagnostics.length > length && diagnostics.data[diagnostics.length - 1] == *"\n" {
        var start = diagnostics.length - 1 - length;
        if (start == 0 || diagnostics.data[start - 1] == *"\n")
            && memcmp(diagnostics.data + start, summary, length) == 0 { return 0; }
    }
    var prefix = "Expected final test summary: ";
    runtime_write_all(stderr_fd, prefix, strlen(prefix));
    runtime_write_all(stderr_fd, summary, length);
    runtime_write_all(stderr_fd, "\n", 1);
    return 1;
}
