import allocator_abi.case;
import guest_runtime_abi;

extern fn `llvm.wasm.memory.size.i32`(memory: u32): u32;

// Production runtime owns the initial heap suffix and grows it up to 512 KiB.
abi_entry(check_guest_growth)
test() {
    var common = guest_runtime_tests();
    abi_assert(common == 0, common, "Run the shared guest ABI checks");
    var before = `llvm.wasm.memory.size.i32`(0);
    var first = alloc(u8, 160000);
    abi_assert(first != null, 20, "Allocate beyond the initial heap");
    var grown = `llvm.wasm.memory.size.i32`(0);
    abi_assert(grown > before, 21, "Increase the page count");
    fill(first, 91, 160000);
    var failed = realloc(u8, first, 1048576);
    abi_assert(failed == null, 22, "Refuse realloc beyond maximum memory");
    var i: usize = 0;
    while i < 160000 {
        abi_assert(first[i] == 91, 23, "Preserve every byte after failed growth");
        ++i;
    }
    free(first);
    var reused = alloc(u8, 160000);
    abi_assert(reused != null, 24, "Reuse released capacity");
    abi_assert(`llvm.wasm.memory.size.i32`(0) == grown, 25, "Reuse without committing more pages");
    free(reused);
}
