import tower;

extern fn strcmp(left: u8*, right: u8*): i32;
extern fn puts(text: u8*): i32;

enum CaptureContinuationMode: u32 { Healthy, Take, Suspend, Observe, Finish }

fn capture_continuation_select(argc: i32, argv: u8**, mode: CaptureContinuationMode*): bool {
    *mode = CaptureContinuationMode.Healthy;
    if argc <= 1 || strcmp(argv[1], "healthy") == 0 { return true; }
    if strcmp(argv[1], "take") == 0 { *mode = CaptureContinuationMode.Take; return true; }
    if strcmp(argv[1], "suspend") == 0 { *mode = CaptureContinuationMode.Suspend; return true; }
    if strcmp(argv[1], "observe") == 0 { *mode = CaptureContinuationMode.Observe; return true; }
    if strcmp(argv[1], "finish") == 0 { *mode = CaptureContinuationMode.Finish; return true; }
    puts("Unknown capture continuation selector");
    return false;
}
