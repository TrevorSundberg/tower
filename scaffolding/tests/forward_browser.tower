import tower;
import library.testing;
import tests.forward_parser_cases;

// The host supplies observations from the actual parser and LLVM/Wasm reactor.
extern fn parser_open(root: u8*, file: u8*): usize;
extern fn parser_close(handle: usize): void;
extern fn parser_step_is(handle: usize, wanted: u8*): bool;
extern fn parser_pending(handle: usize, rule: u8*): bool;
extern fn parser_revision(handle: usize): usize;
extern fn parser_diagnostic(handle: usize, message: u8*, offset: usize): bool;
extern fn foundation_contains(root: u8*, rule: u8*): bool;
extern fn output_equals(engine: u8*, wanted: u8*): bool;
extern fn compile_rejected(file: u8*, message: u8*, offset: usize): bool;

fn browser_check(ok: bool, message: u8*): void { assert(ok, message); }

fn browser_parser(): ForwardParser {
    return {root: null, open: parser_open, close: parser_close,
        step_is: parser_step_is, pending: parser_pending, revision: parser_revision, diagnostic: parser_diagnostic,
        foundation_contains: foundation_contains, check: browser_check};
}

fn browser_module(): void {
    var wanted = forward_expected_output();
    assert(output_equals("interpreter", wanted), "Forward module interpreter output");
    assert(output_equals("LLVM source", wanted), "LLVM execution of forward module source");
    assert(output_equals("LLVM Foundation", wanted), "LLVM execution of canonical Foundation");
    assert(compile_rejected("duplicate.tower", "Duplicate module variable 'x'", 30), "Duplicate module variable");
    assert(compile_rejected("local.tower", "Unknown local 'later'", 42), "Forward local use");
}

extern fn selected(name: u8*): bool;

fn browser_registration(): void {
    var parser = browser_parser();
    if selected("graph") { forward_graph(&parser); return; }
    if selected("activation") { forward_activation(&parser); return; }
    if selected("pinned") { forward_pinned(&parser); return; }
    assert(selected("module"), "Unknown forward-reference registration");
    browser_module();
}
browser_registration();
