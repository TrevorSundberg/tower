import tower;
import lr_analysis_comparisons_test;
import lr_control_checks;
import utility_checks;

fn lr_analysis_comparison_tests(current_contract: bool): void {
    lr_prediction_and_shift_order(current_contract);
    lr_shift_grouping(current_contract);
    lr_lookahead_and_suffixes(current_contract);
    lr_repeated_cores(current_contract);
    lr_fixed_graphs_and_control(current_contract);
    lr_random_graphs_and_propagation(current_contract);
    puts("LR comparison: closure, states, runtime actions, control/probes and 150 randomized grammar/propagation trials passed.");
}
