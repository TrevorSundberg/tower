import tower;
import library.testing;
import syntax_live_support;
import syntax_live_support_test;
import .compiler.syntax_types;
import .compiler.format_types;
import .library.bytes_types;
import .library.bytes_interface;
import storage_api;
import utility_checks;

extern fn driver_read_file(path: u8*, out: ByteBuffer*): bool;
extern fn syntax_kind_name(kind: u32): u8*;

// Import the complete ordinary declaration grammar, including its precedence
// dependencies. Each test still begins from the immutable declaration seed.
fn attribute_grammar_prefix(): u8* { return "import bedrock;"; }
var AttributeGrammarDeclarations: usize = 1;

fn attribute_grammar_reject(source: u8*, diagnostic: u8*): void {
    var text: ByteBuffer = default;
    defer bytes_dispose(&text);
    live_join(&text, attribute_grammar_prefix(), source, "");
    var session = live_open(text.data);
    defer syntax_destroy(bits(void*, session));
    live_declarations(session, AttributeGrammarDeclarations);
    live_failure(session);
    var error = syntax_get_error(bits(void*, session));
    var matched = strstr(error, diagnostic) != null;
    if !matched { puts(error); fflush(null); }
    assert(matched, diagnostic);
}

fn attribute_grammar_roundtrip(declaration: u8*, style: u8*, contextual: bool): void {
    var source: ByteBuffer = default;
    defer bytes_dispose(&source);
    live_join(&source, attribute_grammar_prefix(), declaration, "");
    var session = live_open(source.data);
    defer syntax_destroy(bits(void*, session));
    live_declarations(session, AttributeGrammarDeclarations);
    var root = live_next(session);
    defer tower_node_release_ref(root);
    var node = tower_node_get_child(root, 0);
    var value = syntax_get(node);
    assert(value.attributes.length != 0 && live_text(&value.style, style) && value.contextual == contextual,
        "Grammar attributes have shared entities and actual lexical behavior");
    foreach(var attribute in &value.attributes) {
        var data = syntax_get(attribute);
        assert(data.kind == convert(u32, SyntaxKind.Attribute) && data.source == value.source
            && data.start >= value.start && data.end <= value.end, "Attribute identity and provenance");
    }
    var formatted: FormatResult = default;
    defer format_dispose(&formatted);
    live_format(&formatted, node);
    assert(strstr(formatted.text.data, "[") != null, "Canonical grammar preserves attribute spelling");
    var again: ByteBuffer = default;
    defer bytes_dispose(&again);
    live_join(&again, attribute_grammar_prefix(), formatted.text.data, "");
    var second = live_open(again.data);
    defer syntax_destroy(bits(void*, second));
    live_declarations(second, AttributeGrammarDeclarations);
    var second_root = live_next(second);
    defer tower_node_release_ref(second_root);
    assert(syntax_equal(node, tower_node_get_child(second_root, 0), false), "Attribute canonical structure round trip");
    live_end(session);
    live_end(second);
}

fn attribute_editor_labels(): void {
    assert(strcmp(syntax_kind_name(convert(u32, SyntaxKind.Attribute)), "attribute") == 0,
        "Editor tree labels grammar attributes");
    assert(strcmp(syntax_kind_name(convert(u32, SyntaxKind.AttributeName)), "attribute name") == 0,
        "Editor tree labels named attribute arguments");
    assert(strcmp(syntax_kind_name(convert(u32, SyntaxKind.AttributeString)), "attribute string") == 0,
        "Editor tree labels string attribute arguments");
    assert(strcmp(syntax_kind_name(convert(u32, SyntaxKind.AttributeInteger)), "attribute integer") == 0,
        "Editor tree labels integer attribute arguments");
}

fn attribute_lexical_roundtrips(): void {
    attribute_grammar_roundtrip("[comment] skip Hash = /#[^\\r\\n]*/;", "comment", false);
    attribute_grammar_roundtrip("[contextual][style(\"custom style\")] token Word = /[a-z]+/;", "custom style", true);
    attribute_grammar_roundtrip("[keyword] token Word = /[a-z]+/ when expected;", "keyword", true);
}

fn attribute_precedence_roundtrips(): void {
    attribute_grammar_roundtrip("[precedence(12,\"L>R\")] parse Bound = 'n';", "", false);
    attribute_grammar_roundtrip("[precedence(12,\"R<L\")] parse Bound = 'n';", "", false);
}

fn attribute_invalid_lexical(): void {
    attribute_grammar_reject("[unknown] token Word = /[a-z]+/;", "Unknown grammar attribute");
    attribute_grammar_reject("[comment][keyword] skip Hash = /#/;", "Duplicate highlight style");
    attribute_grammar_reject("[comment] skip Hash = /#/ as comment;", "Duplicate highlight style");
    attribute_grammar_reject("[contextual] skip Hash = /#/;", "Skip rules cannot be contextual");
    attribute_grammar_reject("[style(1)] token Word = /x/;", "style requires one name or string");
    attribute_grammar_reject("[comment(1)] token Word = /x/;", "Highlight markers take no arguments");
    attribute_grammar_reject("[comment] parse Expression = 'n';", "Lexical attributes apply only to token and skip declarations");
}

fn attribute_invalid_precedence(): void {
    attribute_grammar_reject("[precedence(0,left)] parse Expression = 'n';", "Grammar precedence must be positive");
    attribute_grammar_reject("[precedence(4294967296,left)] parse Expression = 'n';", "Grammar precedence exceeds u32");
    attribute_grammar_reject("[precedence(10,unknown)] parse Expression = 'n';", "Unknown grammar associativity");
    attribute_grammar_reject("[precedence(10,left)] token Word = /x/;", "Precedence applies only to parse declarations");
    attribute_grammar_reject("[precedence(10,left)][precedence(20,right)] parse Bound = 'n';", "Duplicate grammar precedence");
    attribute_grammar_reject("[precedence(10,left)] parse Bound = 'n' @ 20 right;", "Duplicate grammar precedence");
}

// The callable native/Wasm self-test also runs on hosts exposing only the
// builtin grammar files. Its linked companion checks the raw fixture against
// this embedded input before passing the file bytes to the same parser.
fn attribute_input_line(source: ByteBuffer*, text: u8*): void {
    assert(bytes_append(source, text, strlen(text)) && bytes_push(source, 10), "Append grammar attribute fixture line");
}

fn attribute_expression_input(source: ByteBuffer*): void {
    attribute_input_line(source, attribute_grammar_prefix());
    attribute_input_line(source, "[comment] skip Hash = /#[^\\r\\n]*/;");
    attribute_input_line(source, "# skipped by the attribute");
    attribute_input_line(source, "parse AttributeExpression = 'n';");
    attribute_input_line(source, "[precedence(10,left)] parse AttributeExpression |= $left:AttributeExpression '+' $right:AttributeExpression;");
    attribute_input_line(source, "[precedence(20,left)] parse AttributeExpression |= $left:AttributeExpression '*' $right:AttributeExpression;");
    attribute_input_line(source, "[precedence(30,right)] parse AttributeExpression |= $left:AttributeExpression '^' $right:AttributeExpression;");
    attribute_input_line(source, "[precedence(5,nonassoc)] parse AttributeExpression |= $left:AttributeExpression '<' $right:AttributeExpression;");
    attribute_input_line(source, "parse Statement = 'emit' AttributeExpression ';';");
    attribute_input_line(source, "emit n+n*n;");
    attribute_input_line(source, "emit n+n+n;");
    attribute_input_line(source, "emit n^n^n;");
    attribute_input_line(source, "emit n<n<n;");
    assert(host_text_terminate(source), "Terminate grammar attribute input");
}

fn attribute_expression_checks(source: u8*): void {
    var session = live_open(source);
    defer syntax_destroy(bits(void*, session));
    var expression_declarations: usize = 7;
    live_declarations(session, AttributeGrammarDeclarations + expression_declarations);
    var first = live_next(session);
    defer tower_node_release_ref(first);
    var expression = live_find(first, "AttributeExpression");
    assert(live_source_matches(tower_node_get_child_member(expression, "right"), source, "n*n"),
        "Live syntax exact original source span");
    var second = live_next(session);
    defer tower_node_release_ref(second);
    expression = live_find(second, "AttributeExpression");
    assert(live_source_matches(tower_node_get_child_member(expression, "left"), source, "n+n"),
        "Live syntax exact original source span");
    var third = live_next(session);
    defer tower_node_release_ref(third);
    expression = live_find(third, "AttributeExpression");
    assert(live_source_matches(tower_node_get_child_member(expression, "right"), source, "n^n"),
        "Live syntax exact original source span");
    live_failure(session);
}

fn attribute_run_aggregate(): void {
    attribute_editor_labels();
    attribute_lexical_roundtrips();
    attribute_precedence_roundtrips();
    attribute_invalid_lexical();
    attribute_invalid_precedence();
    var source: ByteBuffer = default;
    defer bytes_dispose(&source);
    attribute_expression_input(&source);
    attribute_expression_checks(source.data);
    puts("Grammar attributes: lexical effects, precedence, associativity, diagnostics and shared-node round trips pass.");
}

test() { attribute_editor_labels(); }

test() { attribute_lexical_roundtrips(); }

test() { attribute_precedence_roundtrips(); }

test() { attribute_invalid_lexical(); }

test() { attribute_invalid_precedence(); }

test() {
    var input: ByteBuffer = default;
    defer bytes_dispose(&input);
    assert(driver_read_file("tests/syntax_attribute_inputs/precedence.tower", &input), "Read grammar attribute fixture");
    var embedded: ByteBuffer = default;
    defer bytes_dispose(&embedded);
    attribute_expression_input(&embedded);
    assert(input.length == embedded.length && utility_equal(input.data, embedded.data, input.length),
        "Callable self-test and native fixture use the same grammar and statements");
    attribute_expression_checks(input.data);
}
