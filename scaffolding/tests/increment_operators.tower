import tower;

// Built-in operator coverage uses Tower's complete expression grammar, separately
// from the Bedrock-only increment example and the custom replacement fixture.
fn post_increment(p: i32*): i32 {
    var old: i32 = *p;
    *p = old + 1;
    return old;
}

fn pre_increment(p: i32*): i32 {
    var next: i32 = *p;
    next++;
    *p = next;
    return next;
}
