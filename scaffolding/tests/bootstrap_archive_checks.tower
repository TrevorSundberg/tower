import tower;
import utility_checks;
import .library.bytes;
import .library.bytes_types;
import .library.tar_archive;
import .library.gzip_archive;
import .tools.tool_files_posix;
import .host.driver_files;

extern fn strlen(text: u8*): usize;

export fn main(argc: i32, argv: u8**): i32 {
    var arguments: i32 = 2; var usage: i32 = 2;
    if argc != arguments { puts("Supply an isolated fixture directory"); return usage; }
    var files: TarEntry[4];
    var file_count: usize = 4; var regular_mode: u32 = 420; var executable_mode: u32 = 493;
    var binary: u8[513]; var binary_bytes: usize = 513; var alphabet: usize = 256;
    for (var at: usize = 0; at < binary_bytes; at++) { binary[at] = convert(u8, at % alphabet); }
    var long_name: ByteBuffer = default;
    defer bytes_dispose(&long_name);
    var prefix_letter: u8 = 97; var suffix_letter: u8 = 98; var slash: u8 = 47;
    for (var at: usize = 0; at < TarPrefixBytes; at++) { utility_check(bytes_push(&long_name, prefix_letter), "long prefix"); }
    utility_check(bytes_push(&long_name, slash), "long name slash");
    for (var at: usize = 0; at < TarNameBytes; at++) { utility_check(bytes_push(&long_name, suffix_letter), "long suffix"); }
    utility_check(bytes_push(&long_name, 0), "long name terminator");
    files[0] = init(TarEntry) { name: "bin/runner", name_length: strlen("bin/runner"), data: "abc", length: 3, mode: executable_mode };
    files[1] = init(TarEntry) { name: "empty", name_length: strlen("empty"), data: null, length: 0, mode: regular_mode };
    files[2] = init(TarEntry) { name: long_name.data, name_length: long_name.length - 1,
        data: &binary[0], length: binary_bytes, mode: regular_mode };
    files[3] = init(TarEntry) { name: "unicode_π.txt", name_length: strlen("unicode_π.txt"), data: "utf8\n", length: 5, mode: regular_mode };
    var limit: usize = 1048576;
    var archive: ByteBuffer = default; var repeated: ByteBuffer = default; var compressed: ByteBuffer = default;
    var path: ByteBuffer = default; var expected_root: ByteBuffer = default;
    defer bytes_dispose(&archive); defer bytes_dispose(&repeated); defer bytes_dispose(&compressed);
    defer bytes_dispose(&path); defer bytes_dispose(&expected_root);
    utility_check(tar_write(&files[0], file_count, limit, &archive) == TarResult.Ok, "ustar boundary fixture");
    utility_check(tar_write(&files[0], file_count, limit, &repeated) == TarResult.Ok
        && archive.length == repeated.length && utility_equal(archive.data, repeated.data, archive.length), "ustar repeatability");
    utility_check(gzip_compress(archive.data, archive.length, &compressed), "gzip frame");
    utility_check(gzip_compress(repeated.data, repeated.length, &repeated) && compressed.length == repeated.length
        && utility_equal(compressed.data, repeated.data, repeated.length), "gzip aliasing and repeatability");
    utility_check(tool_join(&path, argv[1], "fixture.tar") && tool_output_parents(path.data)
        && driver_write_file(path.data, archive.data, archive.length), "write tar fixture");
    utility_check(tool_join(&path, argv[1], "fixture.tar.gz")
        && driver_write_file(path.data, compressed.data, compressed.length), "write gzip fixture");
    utility_check(tool_join(&expected_root, argv[1], "expected"), "expected root");
    for (var at: usize = 0; at < file_count; at++) {
        utility_check(tool_join(&path, expected_root.data, files[at].name) && tool_output_parents(path.data)
            && driver_write_file(path.data, files[at].data, files[at].length), "write independent member data");
    }
    var saved = archive.data; var saved_length = archive.length;
    utility_check(tar_write(&files[0], file_count, saved_length - 1, &archive) == TarResult.Limit, "complete padded size limit");
    var first = files[0];
    files[0].name = "../escape"; files[0].name_length = strlen("../escape");
    utility_check(tar_write(&files[0], file_count, limit, &archive) == TarResult.InvalidName, "unsafe path rejection");
    files[0] = first;
    var second = files[1]; files[1].name = "bin"; files[1].name_length = strlen("bin");
    utility_check(tar_write(&files[0], file_count, limit, &archive) == TarResult.DuplicateName, "file parent collision rejected");
    files[1] = first;
    utility_check(tar_write(&files[0], file_count, limit, &archive) == TarResult.DuplicateName, "duplicate member rejected");
    files[1] = second;
    files[0].mode = TarModeLimit + 1;
    utility_check(tar_write(&files[0], file_count, limit, &archive) == TarResult.Limit, "mode range checked");
    files[0] = first;
    files[0].length = convert(usize, TarSizeLimit + 1);
    utility_check(tar_write(&files[0], file_count, limit, &archive) == TarResult.Limit, "unsupported size rejected before data read");
    files[0] = first;
    utility_check(archive.data == saved && archive.length == saved_length, "rejections preserve destination");
    utility_check(bytes_assign_text(&repeated, first.data, first.length), "prepare alias");
    files[0].data = repeated.data;
    utility_check(tar_write(&files[0], 1, limit, &repeated) == TarResult.Ok
        && utility_equal(repeated.data + TarBlockBytes, "abc", 3), "tar aliased input survives publication");
    utility_check(tar_write(null, 0, limit, &archive) == TarResult.Ok && archive.length == TarRecordBytes, "empty padded tar");
    utility_check(gzip_compress(null, 0, &compressed) && tool_join(&path, argv[1], "empty.gz")
        && driver_write_file(path.data, compressed.data, compressed.length), "empty gzip fixture");
    puts("Tower bootstrap archive checks passed; extract fixture.tar.gz and compare expected");
    return 0;
}
