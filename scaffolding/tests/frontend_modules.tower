import tower;
import module_cache_suite_test;
import module_cache_cases.admission_test;
import module_cache_cases.leases_test;
import test_file_rule_checks;

export fn frontend_modules_tests(): usize {
    var result = module_resolution_checks();
    if result != 0 {
        return result;
    }
    result = module_session_tests();
    if result != 0 { return result; }
    module_clone_budget_test(false);
    module_clone_budget_test(true);
    module_startup_test();
    module_baseline_imports_test();
    return 0;
}
