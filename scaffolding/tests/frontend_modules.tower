// Exercise the compatibility host entry point in this legacy test suite.
extern fn syntax_create(source: u8*, module: FrontendModule*): void*;
extern fn entity_component_add(node: void*, kind: void*): void*;
extern fn entity_component_get(node: void*, kind: void*): void*;
extern fn entity_component_data(component: void*): void*;
extern fn compiler_world_create_workers(workers: usize): void*;
extern fn compiler_world_create_result(workers: usize, budget: WorkBudget*, output: void**): WorkBudgetError;
extern fn compiler_world_bind_budget(world: void*, budget: WorkBudget*): bool;
extern fn compiler_world_dispose(world: void*): bool;
extern fn frontend_world_clear(world: void*): bool;
extern fn compiler_world_pinned(world: void*): bool;
extern fn compiler_node_world(node: void*): void*;
extern fn syntax_world_revision(world: void*, mode: u32): FrontendRevision*;
extern fn frontend_revision_release(revision: FrontendRevision*): void;
extern fn syntax_revision_rule(revision: FrontendRevision*, name: u8*, length: usize): SyntaxRuleView*;
extern fn entity_references(entity: void*): usize;
extern fn entity_retain(entity: void*): usize;
extern fn entity_child_at(parent: void*, index: usize): void*;
extern fn puts(text: u8*): i32;
extern fn syntax_baseline_install(world: void*, environment: void*, source: u8*, foundation: bool,
    diagnostic: SyntaxVersionDiagnostic*): bool;
extern fn syntax_version_diagnostic_dispose(diagnostic: SyntaxVersionDiagnostic*): void;
extern fn entity_store_count(store: void*): usize;
extern fn entity_store_component_count(store: void*): usize;
extern fn frontend_units_create_bounded_result(count: usize, workers: usize, retained_bytes: usize, width: u32,
    revision: u64, profile: u64, bedrock: u8*, foundation: u8*, library: u8*, error: WorkBudgetError*): void*;
extern fn frontend_units_close(batch: void*): void;

fn module_test_source(environment: ModuleEnvironment*, name: u8*, source: u8*): void {
    module_require(frontend_modules_source(environment, name, source, syntax_text_length(source)));
}

fn module_test_parse(environment: ModuleEnvironment*, source: u8*, count: usize, succeeds: bool): bool {
    var module = frontend_module_root(source, environment);
    var session = syntax_create(source, module);
    loop {
        var node = syntax_next(session);
        if node == null {
            break;
        }
        entity_release(node);
    }
    var error = syntax_get_error(session);
    var clean = error[0] == 0;
    var ok = clean == succeeds;
    if clean {
        frontend_module_finish(module);
        ok = frontend_module_count(module) == count;
    }
    syntax_destroy(session);
    frontend_module_destroy(module);
    return ok;
}

var ModuleOrderFailure: usize = 844;
var ModuleSeedFailure: usize = 845;

fn module_test_order(environment: ModuleEnvironment*): bool {
    var names: u8*[4];
    names[0] = "shared.tower";
    names[1] = "left.tower";
    names[2] = "right.tower";
    names[3] = "main.tower";
    var diamond_module_count: usize = 4;
    if frontend_modules_used_count(environment) != diamond_module_count { return false; }
    for (var i: usize = 0; i < diamond_module_count; i++) {
        if !module_equal(frontend_modules_used_name(environment, i), names[i]) { return false; }
    }
    return !frontend_modules_implicit(environment);
}

fn module_test_seed(environment: ModuleEnvironment*): bool {
    // No import is needed to define an unrelated language from the seed.
    if !module_test_parse(environment, "parse Statement = 'hello'; hello", 1, true) { return false; }
    if !module_test_parse(environment, "", 1, true) { return false; }
    var source: u8* = "print(42);";
    var module = frontend_module_root(source, environment);
    defer frontend_module_destroy(module);
    var session = syntax_create(source, module);
    defer syntax_destroy(session);
    var root = syntax_next(session);
    if root is not null { entity_release(root); return false; }
    return module_equal(syntax_get_error(session), "This syntax needs a language import. Use 'import tower;' for normal code, 'import foundation;' for basic operations, or 'import bedrock;' to define a grammar.");
}

export fn frontend_modules_tests(): usize {
    var environment = frontend_modules_create();
    frontend_modules_configure(environment, "main.tower", "");
    module_test_source(environment, "shared.tower", "parse Statement = 'shared';");
    module_test_source(environment, "left.tower", "import shared; parse Statement = 'left'; left");
    module_test_source(environment, "right.tower", "import shared; shared");
    var result: usize = 0;
    // Diamond identity and isolated overrides: right still parses 'shared'.
    var ok = module_test_parse(environment, "import left; import './left.tower'; import right; parse Statement = 'root'; root", 4, true);
    if !ok {
        result = 801;
    }
    if !module_test_order(environment) { return ModuleOrderFailure; }
    // Repeat with cached imports; shared appears once, before both importers.
    if !module_test_parse(environment, "import left; import right;", 4, true)
        || !module_test_order(environment) { return ModuleOrderFailure; }
    if !module_test_seed(environment) { return ModuleSeedFailure; }
    // A grammar import may contain ordinary roots, but semantic attachments
    // must never leak from one requesting graph into its cached snapshot.
    if !module_cache_isolation(environment) { return ModuleCacheFailure; }
    // Declaration entities remain reusable across requesting graphs.
    ok = module_test_parse(environment, "import shared; shared", 2, true);
    if !ok {
        result = 802;
    }
    module_test_source(environment, "shared.tower", "parse Statement = 'changed';");
    ok = module_test_parse(environment, "import shared; changed", 2, true);
    if !ok {
        result = 803;
    }
    ok = module_test_parse(environment, "import shared; shared", 0, false);
    if !ok {
        result = 804;
    }
    module_test_source(environment, "a.tower", "import b;");
    module_test_source(environment, "b.tower", "import a;");
    ok = module_test_parse(environment, "import a;", 0, false);
    if !ok {
        result = 805;
    }
    ok = module_test_parse(environment, "import missing;", 0, false);
    if !ok {
        result = 806;
    }
    ok = module_test_parse(environment, "parse Late = 'late'; import shared;", 0, false);
    if !ok {
        result = 807;
    }
    var invalid: u8[2];
    invalid[0] = 192;
    invalid[1] = 0;
    ok = frontend_modules_source(environment, "invalid.tower", &invalid[0], 1);
    if ok {
        result = 808;
    }
    invalid[0] = 0;
    ok = frontend_modules_source(environment, "invalid.tower", &invalid[0], 1);
    if ok {
        result = 809;
    }
    // Failed parses must not poison later parses, and '..name' is an ordinary segment.
    ok = module_test_parse(environment, "import './..name/../shared.tower'; changed", 2, true);
    if !ok {
        result = 810;
    }
    frontend_modules_configure(environment, "main.tower", "lib");
    module_test_source(environment, "pkg/owner.tower", "import shared_rule;");
    module_test_source(environment, "lib/shared_rule.tower", "parse Statement = 'original';");
    ok = module_test_parse(environment, "import pkg.owner; original", 3, true);
    if !ok {
        result = 811;
    }
    // A new relative file changes resolution even while the old source is unchanged.
    module_test_source(environment, "pkg/shared_rule.tower", "parse Statement = 'shadow';");
    ok = module_test_parse(environment, "import pkg.owner; shadow", 3, true);
    if !ok {
        result = 812;
    }
    module_test_source(environment, "custom/selected.tower", "parse Statement = 'selected';");
    frontend_modules_builtin(environment, "shared_rule", "custom/selected.tower");
    ok = module_test_parse(environment, "import shared_rule; selected", 2, true);
    if !ok {
        result = 813;
    }
    frontend_modules_fallback(environment, "bundled");
    module_test_source(environment, "bundled/extra.tower", "parse Statement = 'packaged';");
    ok = module_test_parse(environment, "import extra; packaged", 2, true);
    if !ok {
        result = 814;
    }
    module_test_source(environment, "lib/extra.tower", "parse Statement = 'primary';");
    ok = module_test_parse(environment, "import extra; primary", 2, true);
    if !ok {
        result = 815;
    }
    var path: vector(u8);
    vector_init(u8, &path);
    ok = module_path("c:/project/src/../main.tower", &path);
    ok &&= module_equal(path.data, "C:/project/main.tower");
    if !ok {
        result = 816;
    }
    ok = module_path("C:/../escape", &path);
    if ok {
        result = 817;
    }
    ok = module_path("//server/share/folder/../main.tower", &path);
    ok &&= module_equal(path.data, "//server/share/main.tower");
    if !ok {
        result = 818;
    }
    ok = module_path("//server/share/../escape", &path);
    if ok {
        result = 819;
    }
    vector_dispose(u8, &path);
    frontend_modules_destroy(environment);
    if result != 0 {
        return result;
    }
    result = module_session_tests();
    if result != 0 { return result; }
    module_clone_budget_test(false);
    module_clone_budget_test(true);
    module_startup_test();
    module_baseline_imports_test();
    return 0;
}

var ModuleCloneBudgetBytes: usize = 134217728;

fn module_baseline_request(environment: ModuleEnvironment*, source: u8*): FrontendModule* {
    var request = frontend_module_root_world(environment.world, source, environment);
    module_require(request != null);
    var session = frontend_module_session(request);
    module_require(session != null);
    while module_session_step(session) {}
    module_startup_check(syntax_get_error(session)[0] == 0 && frontend_module_error(request)[0] == 0,
        "Retained baseline imports parse through the ordinary module path");
    frontend_module_finish(request);
    return request;
}

fn module_baseline_imports_test(): void {
    var budget: WorkBudget = default;
    module_require(work_budget_init(&budget, 1, ModuleCloneBudgetBytes, 1));
    var world: void* = null;
    module_require(compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None);
    var environment = frontend_modules_create();
    module_require(environment != null && frontend_modules_bind_world(environment, world));
    frontend_modules_configure(environment, "main.tower", "");
    module_test_source(environment, "shared.tower", "parse Statement = 'cached';");
    var diagnostic: SyntaxVersionDiagnostic = default;
    module_startup_check(syntax_baseline_install(world, bits(void*, environment), "import shared;", true, &diagnostic),
        "Initial Foundation import installation");
    syntax_version_diagnostic_dispose(&diagnostic);
    module_startup_check(environment.cache.length != 0 && environment.compilation_session == null,
        "Initial Foundation retains import snapshots but retires the parser");
    var cached = environment.cache.data[0];
    module_require(cached.declarations.length != 0);
    var declaration = cached.declarations.data[0];
    var original = module_baseline_request(environment, "import shared; cached");
    module_startup_check(original.dependencies.data[0].declarations.data[0] == declaration,
        "Imported grammar reuses the exact immutable declaration");
    var generation = environment.session_generation;
    module_startup_check(syntax_baseline_install(world, bits(void*, environment), "import shared;", true, &diagnostic)
        && environment.session_generation == generation && environment.cache.data[0] == cached,
        "Unchanged baseline preserves its existing cache generation");
    syntax_version_diagnostic_dispose(&diagnostic);
    module_startup_check(!syntax_baseline_install(world, bits(void*, environment), "parse Statement = ;", true, &diagnostic)
        && environment.session_generation == generation && environment.cache.data[0] == cached,
        "Failed baseline replacement preserves prior snapshots and live requests");
    syntax_version_diagnostic_dispose(&diagnostic);
    module_test_source(environment, "shared.tower", "parse Statement = 'changed';");
    var changed = module_baseline_request(environment, "import shared; changed");
    module_startup_check(changed.dependencies.data[0].declarations.data[0] != declaration,
        "Changed imported source invalidates the retained snapshot");
    module_startup_check(syntax_baseline_install(world, bits(void*, environment), "parse Statement = 'replacement';", true, &diagnostic)
        && environment.cache.length == 0 && environment.session_generation != generation,
        "Replacing Foundation retains full cache invalidation");
    syntax_version_diagnostic_dispose(&diagnostic);
    module_startup_check(original.dependencies.data[0].declarations.data[0] == declaration,
        "Replacement does not retire a live request's declaration owner");
    var before_clear = module_baseline_request(environment, "import shared; changed");
    module_require(environment.cache.length != 0 && frontend_world_clear(world));
    module_startup_check(syntax_baseline_install(world, bits(void*, environment), "import shared;", true, &diagnostic)
        && environment.cache.length == 0, "First baseline after world clear purges pre-existing snapshots");
    syntax_version_diagnostic_dispose(&diagnostic);
    frontend_module_destroy(before_clear);
    frontend_module_destroy(changed);
    frontend_module_destroy(original);
    frontend_modules_destroy(environment);
    module_require(frontend_world_clear(world) && compiler_world_dispose(world));
    var final: WorkBudgetSnapshot = default;
    module_startup_check(work_budget_snapshot(&budget, &final) && final.used_bytes == 0
        && final.live == 0 && final.used_lanes == 0, "Baseline import owners release every grant");
    module_require(work_budget_dispose(&budget));
}

fn module_startup_check(ok: bool, message: u8*): void {
    if !ok { trap(message, 0); }
}

fn module_startup_test(): void {
    var budget: WorkBudget = default;
    module_require(work_budget_init(&budget, 1, ModuleCloneBudgetBytes, 1));
    var world: void* = null;
    module_require(compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None);
    var error = WorkBudgetError.Invalid;
    var environment = frontend_modules_create_result(&error);
    module_startup_check(environment != null && error == WorkBudgetError.None, "Checked module environment");
    frontend_modules_configure(environment, "main.tower", "");
    module_test_source(environment, "leaf.tower", "parse Statement = 'marker';");
    var text: u8* = "import leaf; marker";
    var request = frontend_module_root_world_size_result(world, text, syntax_text_length(text), environment, &error);
    module_startup_check(request != null && error == WorkBudgetError.None && environment.world == world,
        "Checked module startup binds its world");
    var session = frontend_module_session(request);
    while module_session_step(session) {}
    module_startup_check(syntax_get_error(session)[0] == 0, "Checked startup ordinary import");
    frontend_module_finish(request);
    module_startup_check(frontend_module_count(request) == environment.inputs.length + 1, "Checked startup imported module count");
    frontend_module_destroy(request);
    // Keep an active graph beside an idle parser and populated immutable cache.
    request = frontend_module_root_world_size_result(world, "", 0, environment, &error);
    module_require(request != null && error == WorkBudgetError.None);
    frontend_module_finish(request);
    frontend_module_position(request, 0);
    frontend_module_diagnostic(request, 0);
    var prior = *environment;
    module_require(prior.cache.length != 0 && prior.used.length != 0 && prior.compilation_session != null);
    var cached = prior.cache.data[0];
    var used_name = prior.used.data[0];
    var store = compiler_world_store(world);
    var entities = entity_store_count(store);
    var components = entity_store_component_count(store);
    var before: WorkBudgetSnapshot = default;
    module_require(work_budget_snapshot(&budget, &before));
    var occupied: WorkReservation = default;
    module_require(work_budget_reserve_result(&budget, 0, 0, before.bytes - before.used_bytes, &occupied) == WorkBudgetError.None);
    var denied = frontend_module_root_world_size_result(world, text, syntax_text_length(text), environment, &error);
    module_startup_check(denied == null && error == WorkBudgetError.Capacity, "Module startup preserves actual Capacity");
    module_startup_check(environment.active == prior.active && environment.active_graphs == prior.active_graphs
        && environment.world == prior.world && environment.anchor == prior.anchor
        && environment.compilation_session == prior.compilation_session && environment.session_generation == prior.session_generation
        && environment.cache.length == prior.cache.length && environment.cache.data[0] == cached
        && environment.used.length == prior.used.length && environment.used.data[0] == used_name
        && environment.sources.length == prior.sources.length && environment.sources.data[0] == request.source
        && environment.bases.length == prior.bases.length && environment.bases.data[0] == 0
        && environment.diagnostic == prior.diagnostic && environment.diagnostic_offset == prior.diagnostic_offset,
        "Denied startup preserves active graph, sources, cache and parser lease");
    module_startup_check(entity_store_count(store) == entities && entity_store_component_count(store) == components,
        "Denied startup releases private entities and components");
    // A new caller-owned environment must remain unbound on the same denial.
    var unbound = frontend_modules_create_result(&error);
    module_require(unbound != null);
    denied = frontend_module_root_world_size_result(world, "", 0, unbound, &error);
    module_startup_check(denied == null && error == WorkBudgetError.Capacity && unbound.world == null
        && unbound.anchor == null && unbound.active == null && unbound.active_graphs == 0,
        "Denied startup does not publish a prepared anchor");
    frontend_modules_destroy(unbound);
    denied = frontend_module_root_world_size_result(world, "", 0, null, &error);
    module_startup_check(denied == null && error == WorkBudgetError.Capacity
        && entity_store_count(store) == entities && entity_store_component_count(store) == components,
        "Denied startup releases its private environment");
    var failed: WorkBudgetSnapshot = default;
    module_require(work_budget_snapshot(&budget, &failed));
    module_startup_check(failed.used_bytes == before.bytes && failed.live == before.live + 1,
        "Denied startup retains no additional budget grants");
    module_require(work_budget_release(&budget, &occupied));
    var retry = frontend_module_root_world_size_result(world, text, syntax_text_length(text), environment, &error);
    module_startup_check(retry != null && error == WorkBudgetError.None, "Module startup admission retry");
    session = frontend_module_session(retry);
    module_startup_check(session == prior.compilation_session, "Retry reuses the preserved parser");
    while module_session_step(session) {}
    frontend_module_finish(retry);
    module_startup_check(syntax_get_error(session)[0] == 0 && frontend_module_count(retry) == environment.inputs.length + 1,
        "Retry reuses imported grammar correctly");
    frontend_module_destroy(retry);
    frontend_module_destroy(request);
    frontend_modules_destroy(environment);
    module_require(frontend_world_clear(world) && compiler_world_dispose(world));
    module_startup_check(work_budget_snapshot(&budget, &failed) && failed.used_bytes == 0 && failed.live == 0,
        "Checked startup leaves no retained world grants");
    module_require(work_budget_dispose(&budget));
    var batch = frontend_units_create_bounded_result(1, 1, 1, 8, 1, 1, "", "", "", &error);
    // A representable physical allocation exceeding the total byte cap is
    // Capacity, as is exhaustion of the remaining capacity exercised above.
    module_startup_check(batch == null && error == WorkBudgetError.Capacity, "Unit startup preserves total byte Capacity");
    batch = frontend_units_create_bounded_result(1, 1, ModuleCloneBudgetBytes, 8, 1, 1, "", "", "", &error);
    module_startup_check(batch != null && error == WorkBudgetError.None, "Unit startup admission retry");
    frontend_units_close(batch);
}

// Real parsed grammar and ordinary roots, with denial only after setup. A full
// cache must retain every old entry when a private replacement fails midway.
fn module_clone_budget_test(read_cached: bool): void {
    var budget: WorkBudget = default;
    module_require(work_budget_init(&budget, 1, ModuleCloneBudgetBytes, 1));
    var world = compiler_world_create_workers(1);
    module_require(world != null && compiler_world_bind_budget(world, &budget));
    var environment = frontend_modules_create();
    module_require(frontend_modules_bind_world(environment, world));
    frontend_modules_configure(environment, "main.tower", "");
    module_test_source(environment, "shared.tower", "parse Statement = 'shared';");
    module_test_source(environment, "left.tower", "import shared; parse Statement = 'left'; left");
    var request = frontend_module_root_world(world, "import left; left", environment);
    var session = frontend_module_session(request);
    while module_session_step(session) {}
    module_require(syntax_get_error(session)[0] == 0);
    frontend_module_finish(request);
    var source = request.dependencies.data[0];
    module_require(source.roots.length == 1 && source.dependencies.length == 1);
    while environment.cache.length < ModuleCacheEntries { module_require(module_cache_store(source)); }
    var prior: vector(FrontendModule*) = default;
    foreach(var cached in &environment.cache) { module_require(vector_push(&prior, cached)); }
    var store = compiler_world_store(world);
    var nodes = entity_store_count(store);
    var components = entity_store_component_count(store);
    var before: WorkBudgetSnapshot = default;
    module_require(work_budget_snapshot(&budget, &before));
    var occupied: WorkReservation = default;
    module_require(work_budget_reserve(&budget, 0, 0, before.bytes - before.used_bytes, &occupied));
    if read_cached {
        var reader = frontend_module_root_world(world, "", environment);
        module_require(module_clone(reader.graph, prior.data[prior.length - 1]) == null);
        module_require(frontend_module_resource_error(reader) == WorkBudgetError.Capacity
            && frontend_module_error(reader)[0] != 0);
        // A failed request cannot resume with one of its partially cloned nodes.
        module_require(module_clone(reader.graph, prior.data[prior.length - 1]) == null);
        frontend_module_destroy(reader);
    } else {
        module_require(!module_cache_store(source));
        module_require(frontend_module_resource_error(source) == WorkBudgetError.Capacity
            && frontend_module_error(source)[0] != 0);
        module_require(!module_cache_store(source));
    }
    module_require(environment.cache.length == prior.length);
    for(var i: usize = 0; i < prior.length; i++) {
        module_require(environment.cache.data[i] == prior.data[i]);
    }
    module_require(entity_store_count(store) == nodes && entity_store_component_count(store) == components);
    var failed: WorkBudgetSnapshot = default;
    module_require(work_budget_snapshot(&budget, &failed) && failed.used_bytes == before.bytes
        && failed.live == before.live + 1);
    module_require(work_budget_release(&budget, &occupied));
    frontend_module_destroy(request);
    // The unchanged cached graph remains usable after the failed request retires.
    request = frontend_module_root_world(world, "import left; left", environment);
    session = frontend_module_session(request);
    while module_session_step(session) {}
    module_require(syntax_get_error(session)[0] == 0 && frontend_module_error(request)[0] == 0);
    frontend_module_finish(request);
    module_require(frontend_module_count(request) == 3);
    frontend_module_destroy(request);
    vector_dispose(&prior);
    frontend_modules_destroy(environment);
    module_require(frontend_world_clear(world) && compiler_world_dispose(world));
    var final: WorkBudgetSnapshot = default;
    module_require(work_budget_snapshot(&budget, &final) && final.live == 0 && final.used_bytes == 0);
    module_require(work_budget_dispose(&budget));
}

var ModuleCacheFailure: usize = 843;

fn module_cache_request(environment: ModuleEnvironment*): FrontendModule* {
    var source: u8* = "import left; left";
    var module = frontend_module_root(source, environment);
    var session = frontend_module_session(module);
    while module_session_step(session) {}
    module_require(syntax_get_error(session)[0] == 0);
    frontend_module_finish(module);
    return module;
}

fn module_cache_isolation(environment: ModuleEnvironment*): bool {
    var kind = entity_create(compiler_world_store(environment.world));
    defer entity_release(kind);
    module_require(entity_register(kind, sizeof(usize), alignof(usize), 0));
    var first = module_cache_request(environment);
    defer frontend_module_destroy(first);
    var imported = first.dependencies.data[0];
    var cached: FrontendModule* = null;
    foreach(var candidate in &environment.cache) {
        if module_equal(candidate.source.name.data, imported.source.name.data) { cached = candidate; }
    }
    if cached is null || cached.roots.length != 1 || imported.roots.length != 1 { return false; }
    var root = imported.roots.data[0];
    var component = entity_component_add(root, kind);
    module_require(component is not null);
    *bits(usize*, entity_component_data(component)) = 17;
    var second = module_cache_request(environment);
    defer frontend_module_destroy(second);
    var fresh = second.dependencies.data[0];
    if fresh.roots.length != 1 || fresh.roots.data[0] == root { return false; }
    if entity_component_get(fresh.roots.data[0], kind) is not null { return false; }
    if entity_component_get(cached.roots.data[0], kind) is not null { return false; }
    if fresh.declarations.data[0] != imported.declarations.data[0] { return false; }
    // Retiring snapshots must preserve both outstanding request graphs.
    frontend_modules_reset_compilation(environment);
    if environment.cache.length != 0 { return false; }
    if *bits(usize*, entity_component_data(entity_component_get(root, kind))) != 17 { return false; }
    return entity_component_get(fresh.roots.data[0], kind) is null;
}

fn module_session_step(session: void*): bool {
    var node = syntax_next(session);
    var present = node != null;
    if present {
        entity_release(node);
    }
    return present;
}

fn module_session_check(ok: bool, code: usize, result: usize*): void {
    if !ok {
        if *result == 0 {
            *result = code;
        }
    }
}

fn module_session_tests(): usize {
    var result: usize = 0;
    var environment = frontend_modules_create();
    var other = frontend_modules_create();
    var left = frontend_module_root("parse Statement = 'left'; left left", environment);
    var left_session = frontend_module_session(left);
    module_session_check(module_session_step(left_session), 820, &result);
    var right = frontend_module_root("parse Statement = 'right'; right", environment);
    var right_session = frontend_module_session(right);
    var isolated = left_session != right_session;
    module_session_check(isolated, 821, &result);
    module_session_check(module_session_step(right_session), 822, &result);
    var same = frontend_module_session(left) == left_session;
    module_session_check(same, 823, &result);
    module_session_check(module_session_step(left_session), 824, &result);
    module_session_check(module_session_step(right_session), 825, &result);
    // Reset invalidates caches without destroying or rewinding live requests.
    frontend_modules_reset_compilation(environment);
    module_session_check(module_session_step(left_session), 826, &result);
    var done = syntax_next(left_session) == null;
    module_session_check(done, 827, &result);
    done = syntax_next(right_session) == null;
    module_session_check(done, 828, &result);
    var error = syntax_get_error(left_session);
    var clean = error[0] == 0;
    module_session_check(clean, 829, &result);
    error = syntax_get_error(right_session);
    clean = error[0] == 0;
    module_session_check(clean, 830, &result);
    var busy = frontend_modules_try_destroy(environment) == false;
    module_session_check(busy, 831, &result);
    // A second environment remains usable while the first has outstanding leases.
    var foreign = frontend_module_root("parse Statement = 'other'; other", other);
    var foreign_session = frontend_module_session(foreign);
    module_session_check(module_session_step(foreign_session), 832, &result);
    module_session_check(module_session_step(foreign_session), 833, &result);
    frontend_module_destroy(right);
    frontend_module_destroy(left);
    var retired = environment.compilation_session == null;
    module_session_check(retired, 834, &result);
    // A current-generation lease is returned to the one-entry idle cache.
    var fresh = frontend_module_root("parse Statement = 'fresh'; fresh", environment);
    var fresh_session = frontend_module_session(fresh);
    module_session_check(module_session_step(fresh_session), 835, &result);
    module_session_check(module_session_step(fresh_session), 836, &result);
    frontend_module_destroy(fresh);
    var cached = environment.compilation_session == fresh_session;
    module_session_check(cached, 837, &result);
    var reused = frontend_module_root("parse Statement = 'again'; again", environment);
    var reused_session = frontend_module_session(reused);
    same = reused_session == fresh_session;
    module_session_check(same, 838, &result);
    module_session_check(module_session_step(reused_session), 839, &result);
    module_session_check(module_session_step(reused_session), 840, &result);
    frontend_module_destroy(reused);
    frontend_module_destroy(foreign);
    module_session_check(frontend_modules_try_destroy(environment), 841, &result);
    module_session_check(frontend_modules_try_destroy(other), 842, &result);
    return result;
}

// Empty-cache reset with old idle and active leases shares this existing test unit.
fn module_cache_lease_check(ok: bool, message: u8*): void {
    if !ok { trap(message, 0); }
}

// Check the actual parsed root's world and source span against literal expected
// output, including the old request's still-unconsumed statement after reset.
fn module_cache_lease_root(session: void*, text: u8*): void* {
    var root = syntax_next(session);
    module_cache_lease_check(root != null, "Lease continuation produces its expected parse root");
    var reader = bits(SyntaxSession*, session);
    var span = bits(ParserMatchData*, compiler_node_get(root, CompilerParserMatch));
    module_cache_lease_check(compiler_node_world(root) == reader.inputs.world && span != null,
        "Lease parse root belongs to its owning world");
    var length = syntax_text_length(text);
    module_cache_lease_check(span.start <= reader.source_length && span.length <= reader.source_length - span.start
        && span.length == length && syntax_bytes_compare(reader.source + span.start, span.length, text, length) == 0,
        "Lease parse output matches the exact expected source bytes");
    return root;
}

fn module_cache_lease_next(session: void*, text: u8*): void {
    entity_release(module_cache_lease_root(session, text));
}

fn module_cache_lease_end(module: FrontendModule*, session: void*): void {
    module_cache_lease_check(syntax_next(session) == null && syntax_get_error(session)[0] == 0
        && frontend_module_error(module)[0] == 0, "Lease completes without syntax or module errors");
    frontend_module_finish(module);
}

export fn module_cache_empty_seed_leases(): void {
    var budget: WorkBudget = default;
    module_cache_lease_check(work_budget_init(&budget, 1, ModuleCloneBudgetBytes, 1), "Lease budget initialization");
    var world: void* = null;
    module_cache_lease_check(compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None, "Lease world creation");
    var environment = frontend_modules_create();
    module_cache_lease_check(environment != null && frontend_modules_bind_world(environment, world), "Lease environment binding");
    frontend_modules_configure(environment, "main.tower", "");
    var shared: u8* = "parse Statement = 'cached' $value:Identifier;";
    module_cache_lease_check(frontend_modules_source(environment, "shared.tower", shared, syntax_text_length(shared)), "Lease import input");

    var idle = frontend_module_root_world(world, "parse Statement = 'idle'; idle", environment);
    var active = frontend_module_root_world(world, "parse Statement = 'old'; old old", environment);
    module_cache_lease_check(idle != null && active != null, "Two independent seed-only requests");
    var idle_session = frontend_module_session(idle);
    var active_session = frontend_module_session(active);
    module_cache_lease_check(idle_session != null && active_session != null && idle_session != active_session, "Distinct parser leases");
    module_cache_lease_next(idle_session, "parse Statement = 'idle';");
    module_cache_lease_next(idle_session, "idle");
    module_cache_lease_end(idle, idle_session);
    module_cache_lease_next(active_session, "parse Statement = 'old';");
    module_cache_lease_next(active_session, "old");
    var reader = bits(SyntaxSession*, active_session);
    var old_seed = syntax_world_revision(world, SyntaxSeedBaseline);
    module_cache_lease_check(old_seed != null && reader.pins.bedrock == old_seed
        && bits(SyntaxSession*, idle_session).pins.bedrock == old_seed, "Both leases pin the original seed");
    var idle_document = bits(SyntaxSession*, idle_session).inputs.document;
    entity_retain(idle_document); // Independent witness; never dereference a retired parser.
    frontend_module_destroy(idle);
    var generation = environment.session_generation;
    var cursor = reader.cursor;
    module_cache_lease_check(environment.cache.length == 0 && environment.compilation_session == idle_session
        && environment.active_graphs == 1 && entity_references(idle_document) == 2,
        "Empty snapshots coexist with one idle parser and one active lease");

    // No parser call/job or ECS view is outstanding. Revision/entity references
    // keep outputs alive; they do not pin the world's cache registry against clear.
    module_cache_lease_check(!compiler_world_pinned(world) && frontend_world_clear(world), "Quiescent world clear with retained leases");
    module_cache_lease_check(!compiler_world_dispose(world), "Environment and leases still own the world");
    var current_seed = syntax_world_revision(world, SyntaxSeedBaseline);
    module_cache_lease_check(current_seed != null && current_seed != old_seed && environment.cache.length == 0
        && environment.compilation_session == idle_session && entity_references(idle_document) == 2,
        "Reinitialized seed leaves old idle/active owners intact before publication");
    var diagnostic: SyntaxVersionDiagnostic = default;
    module_cache_lease_check(syntax_baseline_install(world, bits(void*, environment), "import shared;", true, &diagnostic),
        "Importing Foundation publishes after empty-cache world clear");
    syntax_version_diagnostic_dispose(&diagnostic);
    module_cache_lease_check(environment.session_generation != generation && environment.compilation_session == null
        && entity_references(idle_document) == 1, "Publication advances generation and releases the old idle document owner");
    module_cache_lease_check(environment.cache.length == 1, "Initial import snapshot is retained");
    var snapshot = environment.cache.data[0];
    module_cache_lease_check(frontend_module_world(snapshot) == world && snapshot.declarations.length == 1,
        "Retained snapshot owns the imported declaration in this world");
    var declaration = snapshot.declarations.data[0];
    module_cache_lease_check(compiler_node_world(declaration) == world, "Snapshot declaration world identity");
    var foundation = syntax_world_revision(world, SyntaxFoundationBaseline);
    var name: u8* = "ImportDeclaration";
    var seed_rule = syntax_revision_rule(current_seed, name, syntax_text_length(name));
    var old_rule = syntax_revision_rule(old_seed, name, syntax_text_length(name));
    var installed_rule = syntax_revision_rule(foundation, name, syntax_text_length(name));
    module_cache_lease_check(seed_rule != null && old_rule != null && installed_rule != null && seed_rule.count != 0
        && installed_rule.count == seed_rule.count && old_rule.count == seed_rule.count, "Published seed rule shape");
    for(var i: usize = 0; i < seed_rule.count; i++) {
        module_cache_lease_check(installed_rule.alternatives[i] == seed_rule.alternatives[i]
            && installed_rule.alternatives[i] != old_rule.alternatives[i], "Published grammar retains current, not retired, seed entities");
    }
    name = "Statement";
    var statement = syntax_revision_rule(foundation, name, syntax_text_length(name));
    var node = bits(SyntaxNode*, compiler_node_get(declaration, CompilerSyntax));
    module_cache_lease_check(node != null && statement != null && statement.count == node.items.length && statement.count != 0,
        "Published statement belongs to the retained snapshot");
    for(var i: usize = 0; i < statement.count; i++) {
        module_cache_lease_check(statement.alternatives[i] == node.items.data[i], "Exact cached declaration publication identity");
    }

    module_cache_lease_check(reader.pins.bedrock == old_seed && reader.cursor == cursor
        && active.session_generation == generation, "Old active continuation retains its seed, cursor and lease generation");
    module_cache_lease_next(active_session, "old");
    module_cache_lease_end(active, active_session);
    frontend_module_destroy(active);
    module_cache_lease_check(environment.compilation_session == null, "Retired active lease cannot refill even an empty idle slot");
    var fresh = frontend_module_root_world(world, "import shared; cached first cached second", environment);
    module_cache_lease_check(fresh != null, "New-generation request");
    var fresh_session = frontend_module_session(fresh);
    module_cache_lease_check(fresh_session != null && bits(SyntaxSession*, fresh_session).pins.bedrock == current_seed,
        "New request pins the current seed");
    module_cache_lease_next(fresh_session, "import shared;");
    var first = module_cache_lease_root(fresh_session, "cached first");
    var second = module_cache_lease_root(fresh_session, "cached second");
    var first_statement = entity_child_at(first, 0);
    var second_statement = entity_child_at(second, 0);
    var first_value = syntax_reader_member(first_statement, "value");
    var second_value = syntax_reader_member(second_statement, "value");
    module_cache_lease_check(first_value != null && second_value != null && first_value != second_value
        && entity_parent(first_value) == first_statement && entity_parent(second_value) == second_statement,
        "Each parsed value capture belongs to its own statement");
    module_cache_lease_end(fresh, fresh_session);
    module_cache_lease_check(fresh.dependencies.length == 1
        && fresh.dependencies.data[0].declarations.length == snapshot.declarations.length
        && fresh.dependencies.data[0].declarations.data[0] == declaration,
        "New request reuses the exact retained declaration and parses cached");
    frontend_module_destroy(fresh);
    module_cache_lease_check(environment.compilation_session == fresh_session && environment.active_graphs == 0,
        "Current-generation lease returns to idle after all requests drain");
    frontend_modules_reset_compilation(environment);
    module_cache_lease_check(environment.compilation_session == null && environment.cache.length == 0,
        "Idle parser and imported snapshots are retired");
    module_cache_lease_check(entity_release(first) == 0, "First statement root releases its last owner");
    module_cache_lease_check(syntax_reader_member(second_statement, "value") == second_value
        && entity_parent(second_value) == second_statement,
        "Surviving statement resolves its value after parser, import and sibling-root release");
    entity_release(second);
    entity_release(idle_document);
    frontend_revision_release(foundation);
    frontend_revision_release(current_seed);
    frontend_revision_release(old_seed);
    module_cache_lease_check(frontend_modules_try_destroy(environment) && frontend_world_clear(world) && compiler_world_dispose(world),
        "All parser, snapshot, revision and world owners drain");
    var final: WorkBudgetSnapshot = default;
    module_cache_lease_check(work_budget_snapshot(&budget, &final) && final.used_bytes == 0 && final.live == 0 && final.used_lanes == 0,
        "Lease teardown leaves zero bytes, grants and lanes");
    module_cache_lease_check(work_budget_dispose(&budget), "Lease budget disposal");
    puts("Empty-cache seed-clear idle/active leases, cached output and zero ownership passed.");
}

extern fn syntax_version_cache_dispose(cache: SyntaxVersionCache*): void;

fn module_nested_reader(root: FrontendModule*, name: u8*, text: u8*): SyntaxSession* {
    var child = module_new_result(root.graph, name, text, syntax_text_length(text));
    module_cache_lease_check(child != null, "Nested reader source");
    var error = WorkBudgetError.None;
    var reader = syntax_session_open_result(root.graph.world, bits(void*, root.graph.environment),
        text, child, SyntaxFoundationBaseline, &error);
    module_cache_lease_check(reader != null && error == WorkBudgetError.None, "Nested reader admission");
    return reader;
}

fn module_first_import_order(grammar: FrontendRevision*): void {
    var copy = frontend_revision_create(grammar.rules.data, grammar.rules.length, grammar.tokens.data, grammar.tokens.length);
    module_cache_lease_check(copy != null && frontend_revision_identical(copy, grammar), "Private grammar index agrees with its source");
    defer frontend_revision_release(copy);
    var rule = syntax_revision_rule(copy, "Statement", syntax_text_length("Statement"));
    module_cache_lease_check(rule != null && rule.count >= 2 && copy.tokens.length >= 2, "Two distinct alternatives and tokens");
    var first = rule.alternatives[0];
    rule.alternatives[0] = rule.alternatives[1];
    rule.alternatives[1] = first;
    module_cache_lease_check(!frontend_revision_identical(copy, grammar), "Reordered alternatives miss");
    rule.alternatives[1] = rule.alternatives[0];
    rule.alternatives[0] = first;
    module_cache_lease_check(frontend_revision_identical(copy, grammar), "Restore the original rule order");
    first = copy.tokens.data[0];
    copy.tokens.data[0] = copy.tokens.data[1];
    copy.tokens.data[1] = first;
    module_cache_lease_check(!frontend_revision_identical(copy, grammar), "Reordered tokens miss");
}

export fn module_first_import_leases(): void {
    var budget: WorkBudget = default;
    module_cache_lease_check(work_budget_init(&budget, 1, ModuleCloneBudgetBytes, 1), "Import reader budget");
    var world: void* = null;
    module_cache_lease_check(compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None, "Import reader world");
    var env = frontend_modules_create();
    module_cache_lease_check(env != null && frontend_modules_bind_world(env, world), "Import reader environment");
    var old_rules = "token LoanA = /loan_a/;token LoanB = /loan_b/;parse Statement = 'old';parse Statement |= 'another';";
    var new_rules = "parse Statement = 'new';";
    var language = "import rules as origin;parse Marker = 'marker';";
    var wrapper = "import lang;";
    var drain = "parse Fresh = 'fresh';";
    module_cache_lease_check(frontend_modules_source(env, "rules.tower", old_rules, syntax_text_length(old_rules))
        && frontend_modules_source(env, "lang.tower", language, syntax_text_length(language))
        && frontend_modules_source(env, "drain.tower", drain, syntax_text_length(drain))
        && frontend_modules_source(env, "wrapper.tower", wrapper, syntax_text_length(wrapper)), "Initial grammar and transparent wrapper");
    frontend_modules_builtin(env, "reader_language", "lang.tower");

    var root = frontend_module_root_world(world, "import lang;import drain;parse Later = 'later';", env);
    var lender = bits(SyntaxSession*, frontend_module_session(root));
    module_cache_lease_next(bits(void*, lender), "import lang;");
    var original = lender.pins.version;
    module_first_import_order(lender.pins.grammar);
    var before: WorkBudgetSnapshot = default;
    var occupied: WorkReservation = default;
    var error = WorkBudgetError.None;
    var child_text = "import reader_language;old";
    var child_module = module_new_result(root.graph, "child.tower", child_text, syntax_text_length(child_text));
    module_cache_lease_check(child_module != null && work_budget_snapshot(&budget, &before)
        && work_budget_reserve(&budget, 0, 0, before.bytes - before.used_bytes, &occupied), "Occupy remaining bytes before reader admission");
    var count = original.references;
    var failed = syntax_session_open_result(world, bits(void*, env), child_text, child_module, SyntaxFoundationBaseline, &error);
    module_cache_lease_check(failed == null && error == WorkBudgetError.Capacity && original.references == count
        && work_budget_release(&budget, &occupied), "Denied reader preserves lender and releases no live pin");
    var child = syntax_session_open_result(world, bits(void*, env), child_text, child_module, SyntaxFoundationBaseline, &error);
    module_cache_lease_check(child != null && error == WorkBudgetError.None, "Retry reader admission");
    module_cache_lease_next(bits(void*, child), "import reader_language;");
    module_cache_lease_check(child.pins.version == original && original.references == count + 1, "First import takes exactly one reader pin");

    // The second path exports the very same declaration entities. Resolution
    // still selects a different provider, so this reader must build locally.
    frontend_modules_builtin(env, "reader_language", "wrapper.tower");
    var redirected = module_nested_reader(root, "redirect.tower", child_text);
    module_cache_lease_next(bits(void*, redirected), "import reader_language;");
    module_cache_lease_check(frontend_revision_identical(redirected.pins.grammar, child.pins.grammar)
        && redirected.pins.version != original, "A different resolved path misses even with identical ordered grammar");
    module_cache_lease_next(bits(void*, redirected), "old");
    syntax_destroy(bits(void*, redirected));

    // The transparent wrapper left the graph's idle import reader on this
    // version too. Its next file replaces that pin through ordinary reset.
    module_cache_lease_next(bits(void*, lender), "import drain;");
    module_cache_lease_next(bits(void*, lender), "parse Later = 'later';");
    syntax_version_cache_dispose(&lender.cache);
    module_cache_lease_check(child.pins.version == original && original.references == 1, "Evict donor while suspended reader remains the last owner");
    module_cache_lease_check(frontend_modules_source(env, "rules.tower", new_rules, syntax_text_length(new_rules)), "Edit grammar behind alias");
    var replacement = frontend_module_root_world(world, "import lang;new", env);
    var current = bits(SyntaxSession*, frontend_module_session(replacement));
    module_cache_lease_next(bits(void*, current), "import lang;");
    module_cache_lease_check(current.pins.version != original && !frontend_revision_identical(current.pins.grammar, child.pins.grammar),
        "Transitive alias edit creates a different version");
    module_cache_lease_next(bits(void*, current), "new");
    module_cache_lease_next(bits(void*, child), "old");
    syntax_destroy(bits(void*, child));
    frontend_module_destroy(root);
    frontend_module_destroy(replacement);
    frontend_modules_destroy(env);
    module_cache_lease_check(frontend_world_clear(world) && compiler_world_dispose(world)
        && work_budget_snapshot(&budget, &before) && before.used_lanes == 0 && before.used_bytes == 0
        && before.live == 0 && work_budget_dispose(&budget), "Last reader, world and ledger drained");
}
