import tower;
import .backend.target_api;
import .library.work_pool;

var InitializerRepeats: usize = 64;

struct TargetOnceJob { entered: void*; begin: void*; completed: bool; }

export fn work_kernel_execute(payload: void*): void {
    var job = bits(TargetOnceJob*, payload);
    work_signal_post(job.entered);
    work_signal_wait(job.begin);
    for(var repeat: usize = 0; repeat < InitializerRepeats; repeat++) { backend_initialize_targets(); }
    job.completed = true;
}
