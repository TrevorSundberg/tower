import tower;
import .compiler.semantic_query_api;
import .compiler.semantic_context_types;
import .compiler.semantic_program_types;
import .compiler.foundation_types;
import .compiler.foundation_tags;
import .library.work_budget;
import .library.work_budget_types;
import .library.work_graph;
import .library.work_pool;
import .library.vector;

// Opt-in Linux x64 profile of the actual layout pump, not a second scheduler.
// Bound charged scratch and worker slots independently of the layout payload size.
var LayoutProfileBudgetBytes: usize = 1024 * 1024;
var LayoutProfilePointerBytes: u32 = 8;
var LayoutProfileCheckBranches: usize = 4;
// This opt-in input exercises the production parallel layout grain.
var LayoutProfileWideFields: usize = 8192;

extern fn compiler_buffer_allocation_size(bytes: usize): usize;
extern fn printf(format: u8*, index: usize, wanted: usize, actual: usize): i32;
extern fn sem_workers_open(context: SemanticContext*): bool;
extern fn work_arena_snapshot(arena: WorkArena*, snapshot: WorkArenaSnapshot*): bool;
extern fn puts(text: u8*): i32;
extern fn compiler_world_create_workers(workers: usize): void*;
extern fn compiler_world_bind_budget(world: void*, budget: WorkBudget*): bool;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_dispose(world: void*): bool;
extern fn entity_create(store: void*): void*;
extern fn entity_release(node: void*): usize;
extern fn entity_store_count(store: void*): usize;
extern fn entity_store_component_count(store: void*): usize;
extern fn clock_gettime(clock: i32, result: i64*): i32;
extern fn getrusage(who: i32, result: i64*): i32;
extern fn strcmp(left: u8*, right: u8*): i32;
extern fn runtime_print_value(kind: u32, value: u64, pointer_bytes: u32): bool;

fn layout_profile_check(ok: bool, message: u8*): void {
    if !ok { trap(message, 0); }
}

fn layout_profile_time(): i64 {
    var stamp: i64[2];
    layout_profile_check(clock_gettime(1, &stamp[0]) == 0, "Unable to read monotonic clock");
    return stamp[0] * 1000000000 + stamp[1];
}

fn layout_profile_number(value: u64): void {
    layout_profile_check(runtime_print_value(SU64, value, 8), "Unable to print layout measurement");
}

fn layout_profile_record(owner: void*): void* {
    var node = sem_create(owner);
    var value = sem_attach(node, KType);
    value.type = { scalar: SStruct, pointers: 0, record: node, pointer_bytes: LayoutProfilePointerBytes };
    return node;
}

fn layout_profile_field(owner: void*, record: void*): void {
    var node = sem_create(owner);
    var value = sem_attach(node, KOperand);
    value.type = { scalar: record == null ? SI32 : SStruct, pointers: 0, record: record, pointer_bytes: LayoutProfilePointerBytes };
    sem_push(&sem_get(owner).items, node);
}

fn layout_profile_trial(workers: usize, branches: usize, fields: usize, chained: bool,
    warm: bool, report: bool, wrong: bool): bool {
    var gate = work_signal_open();
    layout_profile_check(gate != null, "Unable to open layout budget gate");
    defer work_signal_close(gate);
    work_signal_post(gate);
    var budget: WorkBudget = default;
    layout_profile_check(work_budget_init(&budget, workers, LayoutProfileBudgetBytes, 1)
        && work_budget_synchronize(&budget, gate, work_signal_wait, work_signal_post), "Unable to initialize synchronized layout budget");
    var outer: WorkReservation = default;
    layout_profile_check(work_budget_reserve_result(&budget, 1, 1, 0, &outer) == WorkBudgetError.None, "Unable to reserve outer lane");
    var world = compiler_world_create_workers(workers);
    layout_profile_check(world != null && compiler_world_bind_budget(world, &budget), "Unable to bind world to layout budget");
    var store = compiler_world_store(world);
    var owner = entity_create(store);
    layout_profile_check(owner != null, "Unable to create layout owner");
    var program: SemanticProgram;
    semantic_initialize(&program, owner, LayoutProfilePointerBytes);
    var context: SemanticContext;
    sem_context_init(&context, &program);
    layout_profile_check(program.resource.error == WorkBudgetError.None, "Unable to initialize semantic scratch within the layout budget");

    // Unique owning fields preserve ordered publication and disjoint writes.
    // The two shapes have identical reference sizes/offsets. In chained mode,
    // every branch's first field needs the sole initially ready leaf layout.
    var scalar_bytes = sizeof(i32);
    var leaf = layout_profile_record(owner);
    layout_profile_field(leaf, null);
    var sink = layout_profile_record(owner);
    layout_profile_field(sink, leaf);
    for(var i: usize = 0; i < branches; i++) {
        var branch = layout_profile_record(owner);
        for(var field: usize = 0; field < fields; field++) {
            layout_profile_field(branch, chained && field == 0 ? leaf : null);
        }
        layout_profile_field(sink, branch);
    }
    var query = sem_layout_discover(&context, sink);
    layout_profile_check(query != 0 && context.layout_jobs.length == branches + 2 && context.queries.running == 0, "Incomplete layout discovery or already running queries");
    var initially_ready: usize = 0;
    foreach(var &task in &context.queries.tasks) { if task.state == WorkState.Ready { initially_ready++; } }
    layout_profile_check(initially_ready == (chained ? convert(usize, 1) : branches + 1), "Wrong initial layout frontier");
    var startup: i64 = 0;
    if warm {
        var opening = layout_profile_time();
        layout_profile_check(sem_workers_open(&context), "Unable to open warm layout pool");
        startup = layout_profile_time() - opening;
    }
    var before: i64[18]; var after: i64[18];
    layout_profile_check(getrusage(0, &before[0]) == 0, "Unable to read initial CPU usage");
    var start = layout_profile_time();
    var completed = sem_layout_execute(&context);
    var elapsed = layout_profile_time() - start;
    layout_profile_check(getrusage(0, &after[0]) == 0, "Unable to read final CPU usage");
    layout_profile_check(completed == branches + 2 && program.resource.error == WorkBudgetError.None && program.error.length == 0
        && context.workers.running == 0 && context.queries.running == 0
        && work_task(&context.queries, query).state == WorkState.Succeeded, "Layout pump failed to publish and drain all jobs");
    foreach(var &task in &context.queries.tasks) {
        layout_profile_check(task.state == WorkState.Succeeded, "A discovered layout task did not succeed");
    }
    layout_profile_check(sem_get(leaf).size == scalar_bytes && sem_get(leaf).alignment == alignof(i32)
        && sem_get(sem_get(leaf).items.data[0]).byte_offset == 0, "Wrong leaf size, alignment or offset");
    var aggregate = sem_get(sink);
    layout_profile_check(aggregate.items.length == branches + 1 && aggregate.size == (1 + branches * fields) * scalar_bytes
        && aggregate.alignment == alignof(i32), "Wrong sink size, alignment or field count");
    var sink_fields = aggregate.items.length;
    // Save the first discrepancy so the negative oracle also proves teardown.
    var mismatch = sink_fields;
    var wanted: usize = 0;
    var actual: usize = 0;
    for(var i: usize = 0; i < aggregate.items.length; i++) {
        var field = sem_get(aggregate.items.data[i]);
        var wanted_offset: usize = i == 0 ? 0 : (1 + (i - 1) * fields) * scalar_bytes;
        if wrong && i == 1 { wanted_offset++; }
        if field.byte_offset != wanted_offset && mismatch == sink_fields {
            mismatch = i; wanted = wanted_offset; actual = field.byte_offset;
        }
        if i == 0 { continue; }
        var branch = sem_get(field.type.record);
        layout_profile_check(branch.items.length == fields && branch.size == fields * scalar_bytes && branch.alignment == alignof(i32), "Wrong branch size, alignment or field count");
        for(var item: usize = 0; item < branch.items.length; item++) {
            layout_profile_check(sem_get(branch.items.data[item]).byte_offset == item * scalar_bytes, "Wrong branch field offset");
        }
    }
    // The joined pool and scratch arena still own physical bytes until context disposal.
    var snapshot: WorkBudgetSnapshot;
    var scratch: WorkArenaSnapshot;
    var slots = &context.workers.storage.reservation;
    layout_profile_check(work_arena_snapshot(&context.scratch.arena, &scratch) && scratch.chunks != 0
        && context.scratch.arena.budget == &budget, "Semantic scratch lost its world budget");
    layout_profile_check(context.workers.count > 0 && context.workers.count <= workers
        && (report || context.workers.count == workers) && slots.lanes == 0
        && slots.bytes == compiler_buffer_allocation_size(context.workers.count * sizeof(WorkSlot))
        && work_budget_validate_result(&budget, slots) == WorkBudgetError.None, "Wrong layout pool capacity or slot reservation");
    layout_profile_check(work_budget_snapshot(&budget, &snapshot) && snapshot.used_lanes == outer.lanes
        && work_budget_validate_result(&budget, &outer) == WorkBudgetError.None
        && snapshot.live == scratch.chunks + 2 && snapshot.used_bytes == scratch.retained + slots.bytes
        && snapshot.peak_lanes <= workers, "Joined ledger must contain only the outer lane, scratch and pool slots");
    if report {
        // warm pool, workers, fields/branch, chained, initial ready, wall ns, CPU us, RSS KiB,
        // pool peak (admitted slots, NOT overlap), ledger peak, entities, components.
        // Final startup ns is separate only in warm mode. Cold timing includes it.
        layout_profile_number(warm ? 1 : 0);
        layout_profile_number(convert(u64, workers)); layout_profile_number(convert(u64, fields));
        layout_profile_number(chained ? 1 : 0); layout_profile_number(convert(u64, initially_ready));
        layout_profile_number(convert(u64, elapsed));
        layout_profile_number(convert(u64, (after[0] - before[0] + after[2] - before[2]) * 1000000
            + after[1] - before[1] + after[3] - before[3]));
        layout_profile_number(convert(u64, after[4])); layout_profile_number(convert(u64, context.workers.peak));
        layout_profile_number(convert(u64, snapshot.peak_lanes));
        layout_profile_number(convert(u64, entity_store_count(store)));
        layout_profile_number(convert(u64, entity_store_component_count(store)));
        layout_profile_number(convert(u64, startup));
    }
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(owner);
    layout_profile_check(entity_store_component_count(store) == 0 && compiler_world_dispose(world), "Layout world retained entities, components or views");
    layout_profile_check(work_budget_release_result(&budget, &outer) == WorkBudgetError.None
        && work_budget_snapshot(&budget, &snapshot) && snapshot.used_bytes == 0 && snapshot.used_lanes == 0
        && snapshot.live == 0 && work_budget_dispose(&budget), "Layout teardown leaked a byte or lane reservation");
    if mismatch != sink_fields {
        printf("Wrong sink field offset at %zu: wanted %zu, got %zu\n", mismatch, wanted, actual);
        return false;
    }
    return true;
}

export fn main(argc: i32, argv: u8**): i32 {
    layout_profile_check(work_thread_available(), "Layout frontier profile requires native thread transport");
    if argc == 2 && strcmp(argv[1], "smoke") == 0 {
        return layout_profile_trial(1, LayoutProfileCheckBranches, 8, true, false, false, false)
            && layout_profile_trial(1, LayoutProfileCheckBranches, 8, false, true, false, false) ? 0 : 1;
    }
    if argc < 2 || argc > 4 || (strcmp(argv[1], "cold") != 0 && strcmp(argv[1], "warm") != 0) {
        puts("Usage: layout-frontier-profile smoke | cold|warm [1|4 [wrong]]");
        return 2;
    }
    var warm = strcmp(argv[1], "warm") == 0;
    if argc >= 3 {
        if (strcmp(argv[2], "1") != 0 && strcmp(argv[2], "4") != 0)
            || (argc == 4 && strcmp(argv[3], "wrong") != 0) { return 2; }
        var workers: usize = strcmp(argv[2], "1") == 0 ? 1 : 4;
        var wrong = argc == 4;
        if !layout_profile_trial(workers, LayoutProfileCheckBranches, LayoutProfileWideFields, true, warm, false, wrong)
            || !layout_profile_trial(workers, LayoutProfileCheckBranches, LayoutProfileWideFields, false, warm, false, wrong) { return 1; }
        puts("Layout frontier chain and fanout passed. All reservations released.");
        return 0;
    }
    for(var size: usize = 0; size < 3; size++) {
        var fields: usize = size == 0 ? 8 : (size == 1 ? 1024 : 4096);
        for(var workers: usize = 1; workers <= 8; workers *= 2) {
            if !layout_profile_trial(workers, 32, fields, true, warm, true, false)
                || !layout_profile_trial(workers, 32, fields, false, warm, true, false) { return 1; }
        }
    }
    return 0;
}
