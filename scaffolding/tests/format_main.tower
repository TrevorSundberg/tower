import tower;
import .host.syntax_baseline_api;
import .compiler.syntax_version_types;
import .host.driver_types;
import .host.driver_support;
import .host.driver_request;
import .host.driver_api;
import .host.driver_execution;
import .library.bytes_types;
import .library.bytes_interface;
import format_suite;
import format_repository;

import utility_checks;

extern fn work_thread_available(): bool;
extern fn work_thread_capacity(): usize;

export fn main(argc: i32, argv: u8**): i32 {
    utility_check(!work_thread_available() && work_thread_capacity() == 1,
        "Formatter fault injection requires the single-owner work host");
    utility_check(argc == 2 || argc == 3, "Formatter test resource root and optional repository list");
    var path: ByteBuffer; fill(&path, 0, sizeof(ByteBuffer));
    defer bytes_dispose(&path);
    utility_check(driver_text(&path, argv[1]) && driver_text(&path, "/foundation.tower") && host_text_terminate(&path), "Formatter resource path");
    var options: DriverOptions; fill(&options, 0, sizeof(DriverOptions));
    options.source = path.data; options.bedrock = ""; options.foundation = "";
    var request: DriverRequest;
    utility_check(driver_request_open(&request, &options, argv[1]), "Formatter bootstrap snapshots");
    defer driver_request_close(&request);
    driver_request_bind(&request, syntax_host_environment(compiler_host_world()));
    var result: SyntaxVersionDiagnostic = default;
    defer syntax_version_diagnostic_dispose(&result);
    utility_check(syntax_host_install(compiler_host_world(), request.text[DriverBedrockText].data, false, &result), "install Bedrock" );
    utility_check(syntax_host_install(compiler_host_world(), request.text[DriverFoundationText].data, true, &result), "install Foundation" );
    // These session fixtures have no imports, matching the old parser harness.
    // Keep the resource request owned, without lending its module cache.
    *request.slot = null;
    formatter_tests();
    if argc == 3 {
        *request.slot = request.modules;
        format_repository_tests(argv[2], argv[1], request.modules);
    }

    return 0;
}
