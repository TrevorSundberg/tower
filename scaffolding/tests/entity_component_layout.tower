import tower;
import .library.entities;
import .library.entity_types;
import .library.entity_stage;
import .library.work_budget;
import .library.work_budget_types;
import .host.memory;

var ComponentLayoutBudgetBytes: usize = 1048576;
var ComponentLayoutLargeBytes: usize = 32768;
var ComponentLayoutAlignment: usize = 4096;

fn child_index_storage(): void {
    var budget: WorkBudget = default;
    component_layout_check(work_budget_init(&budget, 1, ComponentLayoutBudgetBytes, 1));
    var store: EntityStore* = null;
    component_layout_check(entity_store_create_result(&budget, &store) == WorkBudgetError.None);
    var root = entity_create(store);
    var anchor = entity_create(store); // Keep this descriptor page alive for reuse.
    component_layout_check(root != null && anchor != null);
    var nodes: Entity*[5];
    for(var i: usize = 0; i < sizeof(decltype(nodes)) / sizeof(Entity*); i++) {
        nodes[i] = entity_create(store); component_layout_check(nodes[i] != null);
    }
    var before = budget.used_bytes; var receipts = budget.live;
    component_layout_check(entity_attach_result(nodes[0], root, null) == WorkBudgetError.None
        && root.children == &root.inline_children[0] && root.child_capacity == 1
        && budget.used_bytes == before && budget.live == receipts);
    var view = entity_view_open(root);
    component_layout_check(view != null && entity_attach_result(nodes[1], root, null) == WorkBudgetError.Busy);
    entity_view_close(view);
    var block: WorkReservation = default;
    var charge = compiler_buffer_allocation_size(sizeof(EntityBufferAllocation)
        + EntityChildIndexMinimum * sizeof(EntityChild));
    component_layout_check(work_budget_reserve(&budget, 0, 0, budget.bytes - budget.used_bytes - charge + 1, &block));
    component_layout_check(entity_attach_result(nodes[1], root, null) == WorkBudgetError.Capacity
        && root.children == &root.inline_children[0] && root.child_count == 1
        && root.children[0].entity == nodes[0] && nodes[0].references == 2
        && nodes[1].parent == null && nodes[1].references == 1);
    component_layout_check(work_budget_release(&budget, &block)
        && entity_attach_result(nodes[1], root, null) == WorkBudgetError.None
        && root.children != &root.inline_children[0] && root.child_capacity == EntityChildIndexMinimum);
    for(var i: usize = 2; i < root.child_capacity; i++) {
        component_layout_check(entity_attach_result(nodes[i], root, null) == WorkBudgetError.None);
    }
    var previous = root.children; before = budget.used_bytes;
    charge = compiler_buffer_allocation_size(sizeof(EntityBufferAllocation) + root.child_capacity * 2 * sizeof(EntityChild));
    component_layout_check(work_budget_reserve(&budget, 0, 0, budget.bytes - budget.used_bytes - charge + 1, &block));
    var last = nodes[sizeof(decltype(nodes)) / sizeof(Entity*) - 1];
    component_layout_check(entity_attach_result(last, root, null) == WorkBudgetError.Capacity
        && root.children == previous && root.child_count == EntityChildIndexMinimum && last.parent == null);
    component_layout_check(work_budget_release(&budget, &block) && budget.used_bytes == before
        && entity_attach_result(last, root, null) == WorkBudgetError.None);
    for(var i: usize = 0; i < sizeof(decltype(nodes)) / sizeof(Entity*); i++) {
        component_layout_check(root.children[i].entity == nodes[i] && nodes[i].parent == root && nodes[i].references == 2);
    }
    var error = WorkBudgetError.None;
    var taken = entity_take_last_child_result(root, &error);
    component_layout_check(taken == last && error == WorkBudgetError.None && last.references == 2);
    entity_release(taken);
    component_layout_check(entity_attach_result(last, root, "restored") == WorkBudgetError.None);
    var stage = entity_stage_open(root);
    var staged = entity_stage_create(stage, root);
    var staged_child = entity_stage_create(stage, staged);
    component_layout_check(staged != null && staged_child != null && entity_stage_publish(stage)
        && staged.children == &staged.inline_children[0] && staged.child_count == 1
        && staged_child.parent == staged);
    stage = entity_stage_open(root);
    var discarded = entity_stage_create(stage, root);
    component_layout_check(discarded != null && entity_stage_create(stage, discarded) != null
        && entity_stage_prepare_result(stage) == WorkBudgetError.None
        && discarded.children == &discarded.inline_children[0]);
    entity_stage_discard(stage);
    for(var i: usize = 0; i < sizeof(decltype(nodes)) / sizeof(Entity*); i++) { entity_release(nodes[i]); }
    var recycled = root;
    entity_release(root);
    root = entity_create(store);
    component_layout_check(root == recycled && root.children == null && root.child_capacity == 0 && root.child_count == 0);
    entity_release(root); entity_release(anchor);
    component_layout_check(entity_store_dispose(store) && budget.used_bytes == 0 && budget.live == 0
        && budget.used_lanes == 0 && work_budget_dispose(&budget));
}

fn component_layout_check(ok: bool): void {
    if !ok { trap("Component allocation target layout regression", 0); }
}

export fn tower_entity_finalize(lifecycle: usize, component: EntityComponent*, data: u8*): void {
    trap("Component layout fixture has no lifecycle payloads", 0);
}

fn component_stage_policy(): void {
    var budget: WorkBudget = default;
    component_layout_check(work_budget_init(&budget, 1, ComponentLayoutBudgetBytes, 1));
    var store: EntityStore* = null;
    component_layout_check(entity_store_create_result(&budget, &store) == WorkBudgetError.None);
    var root = entity_create(store);
    var kind = entity_create(store);
    var pending = entity_create(store);
    component_layout_check(root != null && kind != null && pending != null
        && entity_register_stage_result(kind, sizeof(u64), alignof(u64), 0, 1) == WorkBudgetError.Invalid
        && !kind.registered
        && entity_register_stage_result(kind, sizeof(u64), alignof(u64), 0, 4) == WorkBudgetError.None
        && entity_register_stage_result(kind, sizeof(u64), alignof(u64), 0, 0) == WorkBudgetError.Busy);
    var stage = entity_stage_open(root);
    component_layout_check(stage != null);
    var owners: Entity*[5]; // One more than the explicit four-slot policy.
    var count = sizeof(decltype(owners)) / sizeof(Entity*);
    for(var i: usize = 0; i < count; i++) {
        owners[i] = entity_stage_create(stage, root);
        component_layout_check(owners[i] != null
            && entity_reserve_components(store.budget, &owners[i].components, &owners[i].component_capacity, 0) == WorkBudgetError.None);
    }
    var view = entity_view_open(root);
    component_layout_check(view != null
        && entity_register_stage_result(pending, sizeof(u64), alignof(u64), 0, 4) == WorkBudgetError.Busy
        && !pending.registered
        && entity_register_stage_result(kind, sizeof(u64), alignof(u64), 0, 4) == WorkBudgetError.None);
    var first: EntityComponent* = null;
    for(var i: usize = 0; i + 1 < count; i++) {
        var component = entity_component_add(owners[i], kind);
        component_layout_check(component != null && component.page.capacity == convert(usize, kind.stage_page_rows));
        if first == null { first = component; }
        component_layout_check(component.page == first.page);
        *bits(u64*, component.data) = convert(u64, i);
    }
    var address = first.data;
    var identity = store.next_id;
    var block: WorkReservation = default;
    component_layout_check(work_budget_reserve(&budget, 0, 0, budget.bytes - budget.used_bytes, &block));
    var error = WorkBudgetError.None;
    store.resource_error = WorkBudgetError.Stale;
    component_layout_check(entity_component_add_result(owners[count - 1], kind, &error) == null
        && error == WorkBudgetError.Capacity && store.resource_error == WorkBudgetError.Stale
        && owners[count - 1].component_count == 0 && kind.instance_count == 0
        && store.next_id == identity && first.data == address && first.page.live == count - 1);
    component_layout_check(work_budget_release(&budget, &block));
    var last = entity_component_add_result(owners[count - 1], kind, &error);
    component_layout_check(last != null && error == WorkBudgetError.None && last.page != first.page
        && entity_stage_hold_result(stage) == WorkBudgetError.None);
    entity_view_close(view);
    component_layout_check(entity_stage_publish_result(stage) == WorkBudgetError.None
        && first.data == address && first.page.owner == &store.storage && kind.instance_count == count);
    for(var i: usize = 0; i + 1 < count; i++) {
        component_layout_check(*bits(u64*, entity_component_get(owners[i], kind).data) == convert(u64, i));
    }
    entity_release(root); entity_release(kind); entity_release(pending);
    component_layout_check(store.entity_count == 0 && store.component_count == 0
        && entity_store_dispose(store) && budget.used_bytes == 0 && budget.live == 0
        && work_budget_dispose(&budget));
}

fn component_inline_index(): void {
    var budget: WorkBudget = default;
    component_layout_check(work_budget_init(&budget, 1, ComponentLayoutBudgetBytes, 1));
    var store: EntityStore* = null;
    component_layout_check(entity_store_create_result(&budget, &store) == WorkBudgetError.None);
    var root = entity_create(store);
    var kinds: Entity*[5]; // First, second and fifth index transitions.
    var count = sizeof(decltype(kinds)) / sizeof(Entity*);
    for(var i: usize = 0; i < count; i++) {
        kinds[i] = entity_create(store);
        component_layout_check(kinds[i] != null && entity_register(kinds[i], sizeof(u64), alignof(u64), 0));
    }
    var stage = entity_stage_open(root);
    var node = entity_stage_create(stage, root);
    component_layout_check(node != null);
    var first = entity_component_add(node, kinds[0]);
    component_layout_check(first != null && node.components == &node.inline_components[0]
        && node.component_capacity == sizeof(decltype(node.inline_components)) / sizeof(EntityComponent*));
    *bits(u64*, first.data) = 7654;
    var address = first.data;
    var index = node.components;
    for(var i: usize = 1; i < count; i++) {
        if node.component_count == node.component_capacity {
            var capacity = node.component_capacity;
            var block: WorkReservation = default;
            var available: usize = 0;
            if node.components != &node.inline_components[0] {
                var previous = bits(EntityBufferAllocation*, bits(u8*, node.components) - sizeof(EntityBufferAllocation));
                var old_bytes = compiler_buffer_allocation_size(previous.allocation.capacity);
                var new_bytes = compiler_buffer_allocation_size(sizeof(EntityBufferAllocation)
                    + capacity * 2 * sizeof(EntityComponent*));
                // Enough for net growth, insufficient for old + new live storage.
                available = new_bytes - old_bytes;
            }
            component_layout_check(work_budget_reserve(&budget, 0, 0, budget.bytes - budget.used_bytes - available, &block));
            var charged = budget.used_bytes;
            var receipts = budget.live;
            var error = WorkBudgetError.None;
            component_layout_check(entity_component_add_result(node, kinds[i], &error) == null
                && error == WorkBudgetError.Capacity && node.components == index
                && node.component_capacity == capacity && node.component_count == i
                && budget.used_bytes == charged && budget.live == receipts
                && node.components[0] == first && first.data == address && *bits(u64*, address) == 7654);
            component_layout_check(work_budget_release(&budget, &block));
        }
        component_layout_check(entity_component_add(node, kinds[i]) != null
            && node.components != &node.inline_components[0] && node.components[0] == first);
        index = node.components;
    }
    component_layout_check(entity_stage_publish_result(stage) == WorkBudgetError.None
        && node.components == index && first.data == address);
    component_layout_check(entity_component_remove(node, kinds[0]) && node.component_count == count - 1
        && entity_component_add(node, kinds[0]) != null && node.components == index);

    // A single-component descriptor survives publication and stage destruction;
    // removal/re-add reuses its inline slot without freeing descriptor storage.
    stage = entity_stage_open(root);
    var single = entity_stage_create(stage, root);
    var component = entity_component_add(single, kinds[0]);
    component_layout_check(component != null && entity_stage_publish_result(stage) == WorkBudgetError.None
        && single.components == &single.inline_components[0] && single.components[0] == component);
    component_layout_check(entity_component_remove(single, kinds[0]) && single.component_count == 0
        && entity_component_add(single, kinds[0]) != null && single.components == &single.inline_components[0]);
    component = single.components[0];
    *bits(u64*, component.data) = 4321;
    stage = entity_stage_open(root);
    var other = entity_stage_open(root);
    component_layout_check(entity_stage_lease_result(stage, single) == WorkBudgetError.None
        && entity_stage_lease_result(other, single) == WorkBudgetError.Busy);
    var view = entity_view_open(root);
    component_layout_check(view != null && entity_component_add(single, kinds[1]) != null
        && single.components != &single.inline_components[0] && single.components[0] == component);
    entity_view_close(view);
    component_layout_check(entity_stage_discard_result(stage) == WorkBudgetError.None
        && single.stage == null && single.component_count == 1 && single.components[0] == component
        && *bits(u64*, component.data) == 4321 && entity_component_get(single, kinds[1]) == null
        && entity_stage_discard_result(other) == WorkBudgetError.None);
    entity_release(root);
    for(var i: usize = 0; i < count; i++) { entity_release(kinds[i]); }
    component_layout_check(store.entity_count == 0 && entity_store_dispose(store)
        && budget.used_bytes == 0 && budget.live == 0 && work_budget_dispose(&budget));
}

// Run unchanged on native and wasm32. All receipts and offsets use this
// target's actual types; no x64 header size is embedded in the reference.
export fn main(argc: i32, argv: u8**): i32 {
    child_index_storage();
    component_inline_index();
    component_stage_policy();
    var budget: WorkBudget = default;
    component_layout_check(work_budget_init(&budget, 1, ComponentLayoutBudgetBytes, 1));
    var store: EntityStore* = null;
    component_layout_check(entity_store_create_result(&budget, &store) == WorkBudgetError.None);
    var store_bytes = budget.used_bytes;
    var owner = entity_create(store);
    var other = entity_create(store);
    var type = entity_create(store);
    var large_type = entity_create(store);
    component_layout_check(owner != null && other != null && type != null && large_type != null
        && entity_register(type, sizeof(u64), alignof(u64), 0)
        && entity_register(large_type, ComponentLayoutLargeBytes, ComponentLayoutAlignment, 0));
    var error = WorkBudgetError.Invalid;
    var first = entity_component_add_result(owner, type, &error);
    component_layout_check(first != null && error == WorkBudgetError.None && first.page != null);
    *bits(u64*, first.data) = 1234567;
    var second = entity_component_add_result(other, type, &error);
    component_layout_check(second != null && error == WorkBudgetError.None
        && second.page == first.page && first.page.live == 2
        && second.data == first.data + first.page.stride
        && bits(usize, first.data) % alignof(u64) == 0
        && entity_component_from_data(first.data) == first
        && entity_component_from_data(second.data) == second);
    var page_bytes = compiler_buffer_allocation_size(first.page.allocation.capacity);
    // Non-owning receipt snapshots test this payload's exact grant/lifetime.
    // Descriptor/index grants are separate; entity_accounting checks their census.
    var page_receipt = first.page.allocation.reservation;
    component_layout_check(page_receipt.bytes == page_bytes
        && work_budget_validate_result(&budget, &page_receipt) == WorkBudgetError.None
        && budget.used_bytes > store_bytes + page_bytes);
    var block: WorkReservation = default;
    component_layout_check(work_budget_reserve(&budget, 0, 0, budget.bytes - budget.used_bytes - 1, &block));
    component_layout_check(entity_component_add_result(owner, large_type, &error) == null
        && error == WorkBudgetError.Capacity && owner.component_count == 1);
    component_layout_check(work_budget_release(&budget, &block));
    var large = entity_component_add_result(owner, large_type, &error);
    component_layout_check(large != null && error == WorkBudgetError.None && large.page == null
        && bits(usize, large.data) % large_type.layout.data_alignment == 0
        && entity_component_from_data(large.data) == large);
    fill(large.data, 91, large_type.layout.data_size);
    var allocation = bits(EntityComponentAllocation*, large);
    var large_bytes = compiler_buffer_allocation_size(allocation.allocation.capacity);
    var large_receipt = allocation.allocation.reservation;
    component_layout_check(&allocation.component == large
        && allocation.allocation.data == bits(u8*, large) && large_receipt.bytes == large_bytes
        && work_budget_validate_result(&budget, &large_receipt) == WorkBudgetError.None
        && work_budget_validate_result(&budget, &page_receipt) == WorkBudgetError.None
        && large.data[large_type.layout.data_size - 1] == 91 && *bits(u64*, first.data) == 1234567);
    var view = entity_view_open(owner);
    component_layout_check(view != null && entity_component_add_result(owner, type, &error) == first
        && error == WorkBudgetError.None);
    entity_view_close(view);
    print(sizeof(usize)); print(sizeof(WorkBuffer)); print(sizeof(EntityComponentPage));
    print(sizeof(EntityComponentAllocation)); print(page_bytes); print(large_bytes);
    print(sizeof(EntityComponent));
    component_layout_check(entity_component_remove(owner, type)
        && work_budget_validate_result(&budget, &page_receipt) == WorkBudgetError.None
        && work_budget_validate_result(&budget, &large_receipt) == WorkBudgetError.None);
    component_layout_check(entity_component_remove(other, type)
        && work_budget_validate_result(&budget, &page_receipt) == WorkBudgetError.Stale
        && work_budget_validate_result(&budget, &large_receipt) == WorkBudgetError.None);
    component_layout_check(entity_component_remove(owner, large_type)
        && work_budget_validate_result(&budget, &large_receipt) == WorkBudgetError.Stale
        && store.storage.owned == null && budget.used_bytes > store_bytes);
    entity_release(owner); entity_release(other); entity_release(type); entity_release(large_type);
    component_layout_check(store.entity_count == 0 && store.component_count == 0
        && entity_store_dispose(store) && budget.used_bytes == 0 && budget.live == 0
        && work_budget_dispose(&budget));
    print(0);
    return 0;
}
