import tower;
import .library.work_graph;
import .library.work_graph_types;
import .library.work_pool_api;
import .library.work_pool_types;
import .library.work_budget;
import .library.work_budget_types;
import .host.memory;
import .host.work_linux;
import .host.work_dispatch;

extern fn pthread_self(): usize;

fn schedule_check(ok: bool): void {
    if !ok { trap("Scheduling storage budget regression", 0); }
}

fn schedule_denial(): void {
    var budget: WorkBudget = default;
    var index_bytes = compiler_buffer_allocation_size(16 * sizeof(usize));
    var task_bytes = compiler_buffer_allocation_size(8 * sizeof(WorkTask));
    schedule_check(work_budget_init(&budget, 1, task_bytes, 1));
    var hold: WorkReservation = default;
    schedule_check(work_budget_reserve(&budget, 0, 0, task_bytes - index_bytes, &hold));
    var graph: WorkGraph;
    schedule_check(work_init_budget(&graph, 1, 7, &budget));
    schedule_check(work_request(&graph, null, 1, 0) == 0);
    schedule_check(graph.resource_error == WorkBudgetError.Capacity
        && graph.tasks.length == 0 && graph.task_index.length == 16);
    var snapshot: WorkBudgetSnapshot;
    schedule_check(work_budget_snapshot(&budget, &snapshot)
        && snapshot.used_bytes == task_bytes && snapshot.live == 2 && snapshot.used_lanes == 0);
    schedule_check(work_request(&graph, null, 1, 0) == 0
        && graph.resource_error == WorkBudgetError.Capacity);
    work_dispose(&graph);
    schedule_check(work_budget_release(&budget, &hold));
    schedule_check(work_budget_snapshot(&budget, &snapshot) && snapshot.used_bytes == 0 && snapshot.live == 0);
    schedule_check(work_budget_dispose(&budget));

    // Denial happens before a slot buffer or host thread can be created. Close
    // preserves the fixed receipt even though all partially owned state is gone.
    schedule_check(work_budget_init(&budget, 4, compiler_buffer_allocation_size(4 * sizeof(WorkSlot)), 2));
    schedule_check(work_budget_reserve(&budget, 0, 0, 1, &hold));
    var pool: WorkPool = default;
    schedule_check(!work_pool_open_budget(&pool, 4, &budget)
        && pool.resource_error == WorkBudgetError.Capacity && pool.slots == null && pool.count == 0);
    work_pool_close(&pool);
    schedule_check(pool.resource_error == WorkBudgetError.Capacity);
    schedule_check(work_budget_release(&budget, &hold));
    schedule_check(work_budget_snapshot(&budget, &snapshot) && snapshot.used_bytes == 0 && snapshot.live == 0);
    schedule_check(work_budget_dispose(&budget));
}

fn schedule_reset(): void {
    var budget: WorkBudget = default;
    schedule_check(work_budget_init(&budget, 1, 1048576, 1));
    var graph: WorkGraph;
    schedule_check(work_init_budget(&graph, 1, 9, &budget));
    for(var i: usize = 0; i < 8; i++) {
        var id = work_request(&graph, null, 1, convert(u64, i));
        schedule_check(id == i + 1 && work_seal(&graph, id) && work_demand(&graph, id));
    }
    var ticket: WorkTicket;
    while work_take(&graph, &ticket) { schedule_check(work_finish(&graph, &ticket, true)); }
    var before: WorkBudgetSnapshot;
    schedule_check(work_budget_snapshot(&budget, &before) && before.used_bytes != 0);
    schedule_check(work_reset(&graph, 2, 9) && graph.budget == &budget);
    var after: WorkBudgetSnapshot;
    schedule_check(work_budget_snapshot(&budget, &after)
        && before.used_bytes == after.used_bytes && before.live == after.live);
    schedule_check(!work_finish(&graph, &ticket, true));
    var hold: WorkReservation = default;
    schedule_check(work_budget_reserve(&budget, 0, 0, budget.bytes - after.used_bytes, &hold));
    for(var i: usize = 0; i < 8; i++) {
        schedule_check(work_request(&graph, null, 1, convert(u64, i)) == i + 1);
    }
    var tasks = graph.tasks.data;
    var index = graph.task_index.data;
    schedule_check(work_request(&graph, null, 1, 8) == 0
        && graph.resource_error == WorkBudgetError.Capacity
        && graph.tasks.length == 8 && graph.tasks.data == tasks && graph.task_index.data == index);
    for(var i: usize = 0; i < 8; i++) { schedule_check(graph.tasks.data[i].argument == convert(u64, i)); }
    schedule_check(work_budget_release(&budget, &hold));
    work_dispose(&graph);
    schedule_check(work_budget_snapshot(&budget, &after) && after.used_bytes == 0 && after.live == 0);
    schedule_check(work_budget_dispose(&budget));
}

struct ScheduleBudgetJob {
    graph: WorkGraph;
    entered: void*;
    release: void*;
    thread: usize;
    cancelled: bool;
    completed: usize;
}

export fn work_kernel_execute(payload: void*): void {
    var job = bits(ScheduleBudgetJob*, payload);
    job.thread = pthread_self();
    for(var i: usize = 0; i < 32; i++) {
        var id = work_request(&job.graph, null, 1, convert(u64, i));
        schedule_check(id == i + 1);
        schedule_check(work_access(&job.graph, id, 1, 1, i, 1, WorkAccessMode.Write));
        schedule_check(work_seal(&job.graph, id) && work_demand(&job.graph, id));
    }
    work_signal_post(job.entered);
    work_signal_wait(job.release);
    var ticket: WorkTicket;
    schedule_check(work_take(&job.graph, &ticket));
    if job.cancelled {
        work_cancel(&job.graph);
        schedule_check(!work_finish(&job.graph, &ticket, true));
        return;
    }
    schedule_check(work_finish(&job.graph, &ticket, true));
    job.completed++;
    while work_take(&job.graph, &ticket) {
        schedule_check(work_finish(&job.graph, &ticket, true));
        job.completed++;
    }
}

fn schedule_shared(): void {
    var gate = work_signal_open();
    var entered = work_signal_open();
    var release = work_signal_open();
    schedule_check(gate != null && entered != null && release != null);
    defer work_signal_close(gate);
    defer work_signal_close(entered);
    defer work_signal_close(release);
    work_signal_post(gate);
    var budget: WorkBudget = default;
    schedule_check(work_budget_init(&budget, 4, 1048576, 1));
    schedule_check(work_budget_synchronize(&budget, gate, work_signal_wait, work_signal_post));
    var pool: WorkPool = default;
    schedule_check(work_pool_open_budget(&pool, 4, &budget) && pool.threaded && pool.count == 4);
    var slot_bytes = compiler_buffer_allocation_size(4 * sizeof(WorkSlot));
    var before: WorkBudgetSnapshot;
    schedule_check(work_budget_snapshot(&budget, &before) && before.used_bytes == slot_bytes
        && before.live == 1 && before.used_lanes == 0);
    var jobs: ScheduleBudgetJob[4] = default;
    for(var i: usize = 0; i < 4; i++) {
        schedule_check(work_init_budget(&jobs[i].graph, 1, 7, &budget));
        jobs[i].entered = entered;
        jobs[i].release = release;
        schedule_check(work_pool_submit(&pool, bits(void*, &jobs[i])));
    }
    for(var i: usize = 0; i < 4; i++) { work_signal_wait(entered); }
    schedule_check(work_budget_snapshot(&budget, &before) && before.used_bytes > slot_bytes && before.live > 1);
    jobs[2].cancelled = true;
    for(var i: usize = 0; i < 4; i++) { work_signal_post(release); }
    // No explicit receive: close must drain all admitted jobs before retiring
    // slots. Their private graph buffers deliberately remain owned after join.
    work_pool_close(&pool);
    var after: WorkBudgetSnapshot;
    schedule_check(work_budget_snapshot(&budget, &after) && after.used_bytes != 0 && after.used_lanes == 0);
    for(var i: usize = 0; i < 4; i++) {
        schedule_check(jobs[i].completed == (i == 2 ? 0 : 32)
            && jobs[i].graph.resource_error == WorkBudgetError.None);
        for(var j: usize = 0; j < i; j++) { schedule_check(jobs[i].thread != jobs[j].thread); }
        work_dispose(&jobs[i].graph);
    }
    schedule_check(work_budget_snapshot(&budget, &after) && after.used_bytes == 0 && after.live == 0);
    schedule_check(work_budget_dispose(&budget));
}

// Model terminal processing after the transport has joined both jobs. The
// graph's Running receipts are still unsettled; this is not a thread-kill test.
// Both success publication and failure propagation can need additional storage.
fn schedule_terminal_denial(success: bool): void {
    var budget: WorkBudget = default;
    schedule_check(work_budget_init(&budget, 2, 1048576, 17));
    var graph: WorkGraph;
    schedule_check(work_init_budget(&graph, 17, 3, &budget));
    var producer = work_request(&graph, null, 1, 0);
    var peer = work_request(&graph, null, 2, 0);
    schedule_check(producer != 0 && peer != 0 && work_seal(&graph, producer)
        && work_seal(&graph, peer) && work_demand(&graph, producer) && work_demand(&graph, peer));
    var fanout = graph.ready.capacity + 1;
    for(var i: usize = 0; i < fanout; i++) {
        var consumer = work_request(&graph, null, 3, convert(u64, i));
        schedule_check(consumer != 0 && work_depend(&graph, consumer, producer)
            && work_seal(&graph, consumer) && work_demand(&graph, consumer));
    }
    schedule_check(fanout > graph.scratch.capacity);
    var ticket: WorkTicket;
    var other: WorkTicket;
    schedule_check(work_take(&graph, &ticket) && ticket.task == producer
        && work_take(&graph, &other) && other.task == peer && graph.running == 2);
    var snapshot: WorkBudgetSnapshot;
    schedule_check(work_budget_snapshot(&budget, &snapshot));
    var hold: WorkReservation = default;
    schedule_check(work_budget_reserve(&budget, 0, 0, budget.bytes - snapshot.used_bytes, &hold));
    schedule_check(!work_finish(&graph, &ticket, success)
        && graph.resource_error == WorkBudgetError.Capacity && graph.running == 1);
    // The first receipt has already been released and some coordinator state
    // changed. The latched error prevents settling the peer through normal APIs.
    schedule_check(!work_ticket_valid(&graph, &other) && !work_finish(&graph, &other, true));
    work_cancel(&graph);
    schedule_check(graph.running == 0 && graph.executing.length == 0 && graph.ready.length == 0
        && graph.resource_error == WorkBudgetError.Capacity && !work_ticket_valid(&graph, &ticket));
    for(var i: usize = 0; i < graph.tasks.length; i++) {
        var task = &graph.tasks.data[i];
        schedule_check(task.state == WorkState.Cancelled || (success && i + 1 == producer
            && task.state == WorkState.Succeeded));
    }
    work_dispose(&graph);
    schedule_check(work_budget_release(&budget, &hold)
        && work_budget_snapshot(&budget, &snapshot) && snapshot.live == 0 && snapshot.used_bytes == 0);
    schedule_check(work_budget_dispose(&budget));
}

export fn main(argc: i32, argv: u8**): i32 {
    schedule_denial();
    schedule_reset();
    schedule_terminal_denial(true);
    schedule_terminal_denial(false);
    schedule_shared();
    print(0);
    return 0;
}
