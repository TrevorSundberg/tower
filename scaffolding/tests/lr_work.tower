import tower;
import .compiler.lr_work;
import .compiler.lr_state_work;
import .compiler.lr_runtime;
import .compiler.lr_analysis;
import .compiler.lr_lalr;
import .compiler.lr_states;
import .compiler.lr_types;
import .library.work_graph;
import .compiler.parser_workers;
import .compiler.compiler_kernel;
import .library.work_pool;

extern fn compiler_world_create(): void*;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_dispose(world: void*): bool;
extern fn entity_create(store: void*): void*;
extern fn entity_store_count(store: void*): usize;
extern fn entity_store_component_count(store: void*): usize;
extern fn frontend_world_clear(world: void*): bool;

// Repeated grammar builds retain threads, never payloads or an active lease.
// Check rejection/isolation and drain an actual closure before freeing its input.
fn lr_worker_lifetime(): bool {
    var world = compiler_world_create();
    var other = compiler_world_create();
    if world == null || other == null { return false; }
    defer compiler_world_dispose(world);
    defer compiler_world_dispose(other);
    var root = entity_create(compiler_world_store(world));
    var second = entity_create(compiler_world_store(other));
    if root == null || second == null { return false; }
    defer entity_release(root);
    defer entity_release(second);
    var lease: ParserWorkers;
    if !parser_workers_open(&lease, root, 4) { return false; }
    defer parser_workers_close(&lease);
    var slots = lease.pool.slots;
    var thread = slots[0].thread;
    var rejected: ParserWorkers;
    if parser_workers_open(&rejected, root, 4) { parser_workers_close(&rejected); return false; }
    if frontend_world_clear(world) || compiler_world_dispose(world) { return false; }
    var independent: ParserWorkers;
    if !parser_workers_open(&independent, second, 4) { return false; }
    defer parser_workers_close(&independent);
    if independent.pool == lease.pool || independent.pool.slots == slots { return false; }
    parser_workers_close(&independent);

    var rule: LRProduction;
    fill(&rule, 0, sizeof(LRProduction));
    var analysis = lr_analysis_create(&rule, 1, null, 0, 1);
    if analysis == null { return false; }
    defer lr_analysis_destroy(analysis);
    if !lr_analysis_compute(analysis) { return false; }
    var task: LRClosureTask;
    fill(&task, 0, sizeof(LRClosureTask));
    var item: LRItem;
    fill(&item, 0, sizeof(LRItem));
    var needed: u8 = 1;
    var closure: LRKernelClosure* = null;
    task.analysis = analysis;
    task.items = &item;
    task.needed = &needed;
    task.closures = &closure;
    task.count = 1;
    task.kernel.kind = CompilerKernelKind.LRClosure;
    task.kernel.payload = bits(void*, &task);
    var view = entity_view_open(root);
    if view == null { return false; }
    var submitted = work_pool_submit(lease.pool, bits(void*, &task.kernel));
    parser_workers_close(&lease);
    // Close is the cancellation/join boundary; the stack task and analysis can
    // now be reclaimed even when no explicit receive occurred.
    entity_view_close(view);
    var ok = submitted && task.success && closure != null;
    lr_kernel_closure_destroy(closure);
    if !ok || !parser_workers_open(&lease, root, 4) { return false; }
    if lease.pool.slots != slots || lease.pool.slots[0].thread != thread
        || lease.pool.running != 0 { return false; }
    parser_workers_close(&lease);
    if !frontend_world_clear(world) || compiler_world_grammar(world).workers.count != 0 { return false; }
    if !parser_workers_open(&lease, root, 4) { return false; }
    parser_workers_close(&lease);
    // A non-world caller keeps a local pool and closes it at the same boundary.
    if !parser_workers_open(&lease, null, 2) { return false; }
    if lease.cache != null { return false; }
    parser_workers_close(&lease);
    return lease.local.count == 0;
}

fn lr_work_equal(a: LRStates*, b: LRStates*): bool {
    if a.states.length != b.states.length { return false; }
    for(var i: usize = 0; i < a.states.length; i++) {
        var x = a.states.data[i];
        var y = b.states.data[i];
        if x.origin != y.origin || x.base != y.base || x.edges.length != y.edges.length
            || x.actions.length != y.actions.length || x.items.values.length != y.items.values.length { return false; }
        for(var j: usize = 0; j < x.items.values.length; j++) {
            var left = &x.items.values.data[j];
            var right = &y.items.values.data[j];
            if left.rule != right.rule || left.position != right.position
                || left.first != right.first || left.last != right.last { return false; }
        }
        for(var j: usize = 0; j < x.edges.length; j++) {
            if x.edges.data[j].symbol != y.edges.data[j].symbol
                || x.edges.data[j].state != y.edges.data[j].state { return false; }
        }
        for(var j: usize = 0; j < x.actions.length; j++) {
            var left = &x.actions.data[j];
            var right = &y.actions.data[j];
            if left.rule != right.rule || left.state != right.state
                || left.first != right.first || left.last != right.last { return false; }
        }
    }
    return true;
}

// Both paths run over one immutable analysis in an independent world. Compare
// every item, transition and action, including conflict-bearing tables; verify
// transient ECS jobs leave neither entities nor components behind.
fn lr_work_trial(anchor: void*, rules: LRProduction*, count: usize,
                  symbols: LRSymbol*, length: usize, names: usize): bool {
    var analysis = lr_analysis_create(rules, count, symbols, length, names);
    if analysis == null { return false; }
    var ok = lr_analysis_compute(analysis);
    var serial: LRStates* = null;
    var threaded: LRStates* = null;
    if ok {
        serial = lr_states_create(analysis);
        threaded = lr_states_create_parallel(analysis, anchor);
        ok = serial != null && threaded != null;
    }
    for(var mode: usize = 0; mode < 2 && ok; mode++) {
        ok = lr_states_lalr(serial, mode != 0);
        ok &&= lr_states_lalr_parallel(threaded, mode != 0, anchor);
        ok &&= lr_work_equal(serial, threaded);
        if ok {
            var a = lr_runtime_create(serial);
            var b = lr_runtime_create(threaded);
            ok = a != null && b != null;
            if ok {
                var x: LRConflict;
                var y: LRConflict;
                var conflict = lr_runtime_conflict(a, &x);
                ok = conflict == lr_runtime_conflict(b, &y);
                if conflict && ok {
                    ok = x.state == y.state && x.left.rule == y.left.rule && x.right.rule == y.right.rule
                        && x.left.first == y.left.first && x.right.first == y.right.first;
                }
            }
            lr_runtime_destroy(a);
            lr_runtime_destroy(b);
        }
    }
    lr_states_destroy(serial);
    lr_states_destroy(threaded);
    lr_analysis_destroy(analysis);
    return ok;
}

fn lr_propagation_work_trial(anchor: void*): bool {
    var owner = entity_create_related(anchor);
    if owner == null { return false; }
    defer entity_release(owner);
    var graph: WorkGraph;
    work_init(&graph, 1, 0);
    defer work_dispose(&graph);
    var pool: WorkPool;
    if !work_pool_open(&pool, work_thread_capacity()) { return false; }
    defer work_pool_close(&pool);
    var a = lr_propagation_create(1032);
    var b = lr_propagation_create(1032);
    defer { lr_propagation_destroy(a); lr_propagation_destroy(b); }
    if a == null || b == null { return false; }
    // Many independent cyclic lanes expose a wide frontier across several
    // joined waves. Duplicate/self/diamond edges must preserve exact distinct
    // overlapping ranges. An unseeded cycle must stay empty and terminate.
    for(var mode: usize = 0; mode < 2; mode++) {
        var value = mode == 0 ? a : b;
        for(var lane: usize = 0; lane < 129; lane++) {
            var start = lane * 8;
            for(var i: usize = 0; i < 8; i++) {
                if !lr_propagation_edge(value, start + i, start + (i + 1) % 8) { return false; }
                if !lr_propagation_edge(value, start + i, start + i) { return false; }
            }
            if !lr_propagation_edge(value, start, start + 1)
                || !lr_propagation_edge(value, start, start + 2) { return false; }
            if lane < 128 {
                var first = convert(u32, lane * 8 + 32);
                if !lr_propagation_seed(value, start, first, first + 3)
                    || !lr_propagation_seed(value, start + 7, first + 2, first + 4) { return false; }
            }
        }
    }
    if !lr_propagation_solve(a) || !lr_propagation_solve_parallel(b, owner, &graph, &pool) { return false; }
    if a.pending.length != 0 || b.pending.length != 0 { return false; }
    if pool.count > 1 && (pool.peak < 2 || graph.revision < 3) { return false; }
    for(var i: usize = 0; i < a.count; i++) {
        var x = &a.nodes[i];
        var y = &b.nodes[i];
        if x.queued || y.queued || x.ranges.length != y.ranges.length { return false; }
        if y.ranges.length != (i < 1024 ? 2 : 0) { return false; }
        for(var j: usize = 0; j < x.ranges.length; j++) {
            if x.ranges.data[j].first != y.ranges.data[j].first
                || x.ranges.data[j].last != y.ranges.data[j].last { return false; }
        }
    }
    return true;
}

export fn lr_work_tests(): u32 {
    var world = compiler_world_create();
    var store = compiler_world_store(world);
    var root = entity_create(store);
    var entities = entity_store_count(store);
    var components = entity_store_component_count(store);
    var failures: u32 = 0;
    if !lr_propagation_work_trial(root) { failures++; }
    if !lr_worker_lifetime() { failures++; }
    var symbols: LRSymbol[2048];
    var rules: LRProduction[516];
    fill(&rules, 0, sizeof(LRProduction[516]));
    for(var i: usize = 0; i < 2048; i++) {
        symbols[i].nonterminal = lr_none();
        symbols[i].first = convert(u32, i + 2097152);
        symbols[i].last = symbols[i].first;
    }
    // Many distinct dotted productions and state/hash-table resizes.
    rules[0].count = 2048;
    if !lr_work_trial(root, &rules[0], 1, &symbols[0], 2048, 1) { failures++; }

    // Root -> 256 terminals List, List -> Item List | empty, Item -> 512
    // alternatives. Exercise both closure batches and multiple action ranges.
    // Duplicate/overlapping tokens deliberately retain conflicts.
    fill(&rules, 0, sizeof(LRProduction[516]));
    rules[0].count = 257;
    symbols[256].nonterminal = 1;
    rules[1].owner = 1;
    rules[1].begin = 257;
    rules[1].count = 2;
    symbols[257].nonterminal = 2;
    symbols[258].nonterminal = 1;
    rules[2].owner = 1;
    rules[2].begin = 259;
    for(var i: usize = 0; i < 512; i++) {
        rules[i + 3].owner = 2;
        rules[i + 3].begin = i + 259;
        rules[i + 3].count = 1;
        symbols[i + 259].first = convert(u32, i / 2 + 32);
        symbols[i + 259].last = symbols[i + 259].first + convert(u32, i % 2);
    }
    if !lr_work_trial(root, &rules[0], 515, &symbols[0], 771, 3) { failures++; }
    // A nullable cycle in the grammar is valid fixed-point input, distinct from
    // an impossible recursive by-value type or compile-time execution cycle.
    rules[515].owner = 2;
    rules[515].begin = 771;
    rules[515].count = 1;
    symbols[771].nonterminal = 1;
    if !lr_work_trial(root, &rules[0], 516, &symbols[0], 772, 3) { failures++; }
    if entity_store_count(store) != entities || entity_store_component_count(store) != components { failures++; }
    entity_release(root);
    if !compiler_world_dispose(world) { failures++; }
    return failures;
}
