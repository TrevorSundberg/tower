import tower;
import '../host/guest-memory';
import '../host/guest-wasm';

// Link with 128 KiB initial / 512 KiB maximum memory. No libc allocator runs
// alongside this explicit arena. The host only invokes this exported fixture.
export fn allocator_wasm_tests(): i32 {
    var bad = sizeof(usize) != 4;
    if bad { return 1; }
    bad = sizeof(GuestBlock) != 16;
    if bad { return 2; }
    bad = guest_wasm_limit(65536) != 4294967295;
    if bad { return 3; }
    var heap: GuestHeap;
    var initialized = guest_wasm_init(&heap);
    if !initialized { return 4; }
    var begin = heap.cursor;
    var initial_pages = guest_wasm_pages();
    var zero = guest_wasm_allocate(&heap, 0, 1);
    bad = zero == null;
    if bad { return 5; }
    var address = bits(usize, zero);
    var remainder = address % 16;
    bad = remainder != 0;
    if bad { return 6; }
    var wanted = initial_pages + 1;
    bad = guest_wasm_pages() != wanted;
    if bad { return 7; }
    guest_heap_free(&heap, zero);
    bad = heap.cursor != begin;
    if bad { return 8; }
    var first = guest_wasm_allocate(&heap, 65520, 1);
    bad = first == null;
    if bad { return 9; }
    bad = guest_wasm_pages() != wanted;
    if bad { return 10; }
    var bytes = bits(u8*, first);
    fill(bytes, 91, 65520);
    var second = guest_wasm_allocate(&heap, 17, 1);
    bad = second == null;
    if bad { return 11; }
    wanted++;
    bad = guest_wasm_pages() != wanted;
    if bad { return 12; }
    bad = bytes[0] != 91;
    if bad { return 13; }
    bad = bytes[65519] != 91;
    if bad { return 14; }
    var next = guest_wasm_reallocate(&heap, first, 70000, 1);
    bad = next == null;
    if bad { return 15; }
    first = next;
    bytes = bits(u8*, first);
    var i: usize = 0;
    while i < 65520 {
        bad = bytes[i] != 91;
        if bad { return 16; }
        i++;
    }
    var cursor = heap.cursor;
    var limit = heap.limit;
    var available = heap.available;
    var pages = guest_wasm_pages();
    // Failed growth and multiplication/rounding/address overflow preserve both
    // existing bytes and the arena's free-list/cursor/committed-limit state.
    next = guest_wasm_reallocate(&heap, first, 1048576, 1);
    bad = next != null;
    if bad { return 17; }
    next = guest_wasm_reallocate(&heap, first, 4294967295, 2);
    bad = next != null;
    if bad { return 18; }
    next = guest_wasm_allocate(&heap, 4294967295, 1);
    bad = next != null;
    if bad { return 19; }
    next = guest_wasm_allocate(&heap, 4294901760, 1);
    bad = next != null;
    if bad { return 20; }
    bad = heap.cursor != cursor;
    if bad { return 21; }
    bad = heap.limit != limit;
    if bad { return 22; }
    bad = heap.available != available;
    if bad { return 23; }
    bad = guest_wasm_pages() != pages;
    if bad { return 24; }
    bad = bytes[65519] != 91;
    if bad { return 25; }
    next = guest_wasm_reallocate(&heap, first, 4, 1);
    bad = next != first;
    if bad { return 26; }
    guest_heap_free(&heap, second);
    next = guest_wasm_reallocate(&heap, first, 0, 1);
    bad = next != null;
    if bad { return 27; }
    bad = heap.cursor != begin;
    if bad { return 28; }
    var reused = guest_wasm_allocate(&heap, 100000, 1);
    bad = reused == null;
    if bad { return 29; }
    bad = guest_wasm_pages() != pages;
    if bad { return 30; }
    guest_heap_free(&heap, reused);
    // A context can keep its committed storage if someone else grew memory,
    // but must not claim the new foreign suffix when it needs more storage.
    var foreign_previous = `llvm.wasm.memory.grow.i32`(0, 1);
    bad = foreign_previous != pages;
    if bad { return 31; }
    var capacity = heap.limit - heap.cursor;
    next = guest_wasm_allocate(&heap, capacity, 1);
    bad = next != null;
    if bad { return 32; }
    bad = heap.limit != limit;
    if bad { return 33; }
    bad = heap.cursor != begin;
    if bad { return 34; }
    return 0;
}
