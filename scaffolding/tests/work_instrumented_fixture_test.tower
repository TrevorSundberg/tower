import .library.testing;
import .library.work_pool;
import .library.work_budget_types;

import work_instrumented_fixture;

export fn work_kernel_execute(payload: void*): void {
    var job = bits(InstrumentedWork*, payload);
    job.thread = pthread_self();
    assert(*job.order == job.index, "Instrumented jobs keep deterministic admission order");
    ++*job.order;
    var bytes = alloc(u8, InstrumentedScratchBytes);
    job.success = bytes is not null;
    if job.success {
        fill(bytes, convert(u8, job.index), InstrumentedScratchBytes);
        job.result = convert(u64, bytes[0]) + convert(u64, bytes[InstrumentedScratchBytes - 1]);
        free(bytes);
    }
}

fn instrumented_work_trial(completed: usize*): bool {
    var pool: WorkPool;
    if !work_pool_open(&pool, 4) {
        assert(pool.resource_error == WorkBudgetError.Memory, "Refused slot allocation reports Memory");
        return false;
    }
    defer work_pool_close(&pool);
    assert(!pool.threaded && pool.count == 1, "Single-owner allocator explicitly selects the portable work host");
    var order: usize = 0;
    var owner = pthread_self();
    for (var index: usize = 0; index < InstrumentedJobCount; ++index) {
        var job: InstrumentedWork = { order: &order, index: index, ..default };
        assert(work_pool_submit(&pool, bits(void*, &job)), "Instrumented job admission");
        assert(work_pool_receive(&pool, true) == bits(void*, &job) && job.thread == owner,
            "Instrumented completion executes on allocator owner");
        if !job.success { return false; }
        assert(job.result == convert(u64, index * 2), "Instrumented work preserves computed results");
        ++*completed;
    }
    return true;
}

fn instrumented_sweep(): void {
    assert(!work_thread_available() && work_thread_capacity() == 1, "Instrumented runtime selects the explicit single-owner work profile");
    var baseline = tower_test_buffer_count();
    var calls: usize[InstrumentedMaxAttempts];
    var completed: usize[InstrumentedMaxAttempts];
    var successful_attempt: usize = 0;
    for (var round: usize = 0; round < 2; ++round) {
        var success = false;
        for (var attempt: usize = 0; attempt < InstrumentedMaxAttempts && !success; ++attempt) {
            var before = tower_test_buffer_allocations();
            var done: usize = 0;
            tower_test_buffer_fail_after(attempt);
            success = instrumented_work_trial(&done);
            tower_test_buffer_fail_after(~convert(usize, 0));
            var allocations = tower_test_buffer_allocations() - before;
            assert(tower_test_buffer_count() == baseline, "Every instrumented worker failure releases all allocations");
            if attempt == 0 {
                assert(!success && allocations != 0 && done == 0, "The first allocation refusal admits no jobs");
            }
            if round == 0 {
                calls[attempt] = allocations;
                completed[attempt] = done;
                if success { successful_attempt = attempt; }
            } else {
                assert(attempt <= successful_attempt && calls[attempt] == allocations && completed[attempt] == done,
                    "Repeated failure injection has exact allocation counts and completion prefix");
                assert(success == (attempt == successful_attempt), "Repeated failure injection succeeds at the same point");
            }
            if success { assert(done == InstrumentedJobCount, "All instrumented jobs complete after failure sweep"); }
        }
        assert(success, "Instrumented allocation sweep reaches success");
    }
}

test() { instrumented_sweep(); }
