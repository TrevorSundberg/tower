import tower;
import .host.memory;
import .compiler.compiler_kernel;
import .library.work_pool_api;
import .library.work_pool_types;
import .host.work_linux;
import .host.work_dispatch;

extern fn clock_gettime(clock: i32, result: i64*): i32;
extern fn getrusage(who: i32, result: i64*): i32;

struct OverheadJob { kernel: CompilerKernel; input: usize; result: usize; }
fn overhead_check(ok: bool): void { if !ok { trap("Small kernel dispatch mismatch", 0); } }
fn overhead_time(): i64 {
    var stamp: i64[2];
    overhead_check(clock_gettime(1, &stamp[0]) == 0);
    return stamp[0] * 1000000000 + stamp[1];
}
export fn work_kernel_execute(payload: void*): void {
    var kernel = bits(CompilerKernel*, payload);
    var job = bits(OverheadJob*, kernel.payload);
    job.result = job.input * job.input + 7;
}
fn overhead_case(workers: usize, count: usize, rounds: usize): void {
    var pool: WorkPool = default;
    overhead_check(work_pool_open(&pool, workers) && pool.count == workers);
    defer work_pool_close(&pool);
    var jobs = alloc(OverheadJob, count);
    var pointers = alloc(OverheadJob*, count);
    overhead_check(jobs != null && pointers != null);
    defer free(jobs); defer free(pointers);
    for(var i: usize = 0; i < count; i++) {
        jobs[i] = default;
        jobs[i].kernel.payload = bits(void*, &jobs[i]);
        pointers[i] = &jobs[i];
    }
    // Warm retained transport once; report this steady dispatch separately
    // from the million-byte SHA fixture's first-use batch setup.
    overhead_check(compiler_kernel_dispatch(&pool, pointers, count));
    var before: i64[18]; var after: i64[18];
    overhead_check(getrusage(0, &before[0]) == 0);
    var start = overhead_time();
    for(var round: usize = 0; round < rounds; round++) {
        for(var i: usize = 0; i < count; i++) { jobs[i].input = round + i; jobs[i].result = 0; }
        overhead_check(compiler_kernel_dispatch(&pool, pointers, count));
        for(var i: usize = 0; i < count; i++) {
            overhead_check(jobs[i].result == (round + i) * (round + i) + 7);
        }
    }
    var elapsed = overhead_time() - start;
    overhead_check(getrusage(0, &after[0]) == 0);
    print(workers); print(count); print(rounds); print(elapsed);
    print((after[0] - before[0] + after[2] - before[2]) * 1000000
        + after[1] - before[1] + after[3] - before[3]);
    print(after[4]);
    print(count * (sizeof(OverheadJob) + sizeof(OverheadJob*)) + pool.count * sizeof(WorkSlot));
}
export fn main(argc: i32, argv: u8**): i32 {
    overhead_case(1, 1, 100000);
    overhead_case(8, 1, 100000);
    overhead_case(1, 32, 1000);
    overhead_case(2, 32, 1000);
    overhead_case(4, 32, 1000);
    overhead_case(8, 32, 1000);
    overhead_case(8, 1024, 100);
    return 0;
}
