import tower;
import frontend_units;
import utility_checks;
import .backend.execution_functions;
import .compiler.format_types;
import .compiler.foundation_types;
import .library.vector;

extern fn tower_test_buffer_count(): usize;
extern fn tower_test_buffer_fail_after(count: usize): void;
extern fn sem_get(node: void*): FoundationNode*;

fn backend_execution_index_case(root: u8*): void {
    var bedrock: vector(u8) = default;
    var foundation: vector(u8) = default;
    var source: vector(u8) = default;
    var entry: vector(u8) = default;
    defer vector_dispose(&bedrock);
    defer vector_dispose(&foundation);
    defer vector_dispose(&source);
    defer vector_dispose(&entry);
    units_read(root, "/bedrock.tower", &bedrock);
    units_read(root, "/foundation.tower", &foundation);
    units_read(root, "/tests/backend_execution_roots.tower", &source);
    var filename = "/tests/backend_execution_roots.tower";
    for(var i: usize = 0; i < strlen(root); i++) { units_check(vector_push(&entry, root[i]), "execution-index source root"); }
    for(var i: usize = 0; i <= strlen(filename); i++) { units_check(vector_push(&entry, filename[i]), "execution-index source path"); }
    var batch = frontend_units_create(1, 1, 8, 1, 8, bedrock.data, foundation.data, root);
    units_check(batch != null, "execution-index private compilation owner");
    defer frontend_units_close(batch);
    units_check(frontend_units_source(batch, 1, entry.data, source.data, source.length),
        "execution-index source snapshot");
    while !frontend_units_step(batch, true) { }
    units_check(frontend_units_failed(batch) == 0 && !frontend_units_cancelled(batch),
        "execution-index source checks successfully");
    var program = frontend_units_program(batch, 1);
    units_check(program != null, "execution-index completed program");
    var before: FormatResult = default;
    var after: FormatResult = default;
    defer format_dispose(&before);
    defer format_dispose(&after);
    format_entity(&before, program.root, null, null, null);
    units_check(!before.failed && before.text.length != 0, "execution-index original canonical Foundation");

    var retained: vector(u8) = default;
    defer vector_dispose(&retained);
    units_check(backend_execution_functions(program.root, program.functions.data, program.functions.length, &retained),
        "execution-index derives runtime function roots");
    var observed: usize = 0;
    var dead: usize = 0;
    var called: usize = 0;
    for(var index: usize = 1; index < program.functions.length; index++) {
        var name = sem_get(program.functions.data[index]).name.data;
        if strcmp(name, "unused_type") == 0 {
            units_check(retained.data[index] == 0, "unused declaration stays outside executable index");
            dead = index;
            observed++;
        }
        if strcmp(name, "direct") == 0 || strcmp(name, "callback") == 0
            || strcmp(name, "recursive") == 0 || strcmp(name, "retained_export") == 0 {
            units_check(retained.data[index] != 0, "calls, function values, recursion and exports remain executable");
            observed++;
            if strcmp(name, "direct") == 0 { called = index; }
        }
    }
    units_check(observed == 5 && retained.data[0] != 0, "execution-index known source declarations and module effects");
    vector_dispose(&retained);

    // Change only a disposable caller index: declaration identities and the
    // canonical graph must survive rejection of the mismatched function slot.
    var mismatched: vector(void*) = default;
    defer vector_dispose(&mismatched);
    foreach(var function in &program.functions) {
        units_check(vector_push(&mismatched, function), "execution-index identity fixture");
    }
    mismatched.data[called] = program.functions.data[dead];
    units_check(!backend_execution_functions(program.root, mismatched.data, mismatched.length, &retained),
        "execution-index rejects mismatched declaration identity");
    vector_dispose(&retained);

    // This runner uses the existing serial fault allocator. It does not claim
    // to instrument concurrent workers or LLVM's independent allocations.
    var baseline = tower_test_buffer_count();
    var succeeded = false;
    var rejected = false;
    for(var limit: usize = 0; limit < 64; limit++) {
        tower_test_buffer_fail_after(limit);
        succeeded = backend_execution_functions(program.root, program.functions.data, program.functions.length, &retained);
        tower_test_buffer_fail_after(~convert(usize, 0));
        vector_dispose(&retained);
        units_check(tower_test_buffer_count() == baseline, "execution-index allocation failure releases private vectors");
        if succeeded { break; }
        rejected = true;
    }
    units_check(succeeded && rejected, "execution-index allocation sweep exercises failure and reaches success");
    format_entity(&after, program.root, null, null, null);
    units_check(!after.failed && before.text.length == after.text.length
        && utility_equal(before.text.data, after.text.data, before.text.length),
        "execution-index success and failures preserve exact canonical Foundation");
}

export fn backend_execution_index_tests(root: u8*): void {
    var baseline = tower_test_buffer_count();
    backend_execution_index_case(root);
    units_check(tower_test_buffer_count() == baseline, "execution-index closes the source world and all output owners");
}
