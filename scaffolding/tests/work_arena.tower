import tower;
import .library.work_arena;
import .library.work_arena_types;
import .library.work_budget;
import .library.work_budget_types;
import .host.memory;

fn arena_check(ok: bool): void {
    if !ok { trap("Stable chunk ownership regression", 0); }
}

fn arena_retention(): void {
    var budget: WorkBudget = default;
    var other: WorkBudget = default;
    var chunk_bytes: usize = 4096;
    var charged = compiler_buffer_allocation_size(chunk_bytes);
    arena_check(work_budget_init(&budget, 1, charged * 2, 1));
    arena_check(work_budget_init(&other, 1, charged, 1));
    var parent: WorkArena = default;
    var worker: WorkArena = default;
    var wrong: WorkArena = default;
    arena_check(work_arena_init(&parent, &budget, chunk_bytes));
    arena_check(work_arena_init(&worker, &budget, chunk_bytes));
    arena_check(work_arena_init(&wrong, &other, chunk_bytes));
    var first = work_arena_allocate(&parent, 3500, 8);
    var second = work_arena_allocate(&worker, 2000, 16);
    arena_check(first != null && second != null);
    fill(first, 41, 3500); fill(second, 73, 2000);
    var output = first;
    arena_check(work_arena_allocate_result(&parent, 2000, 8, &output) == WorkBudgetError.Capacity);
    arena_check(output == first && first[3499] == 41 && second[1999] == 73);
    arena_check(!work_arena_append(&wrong, &worker) && wrong.first == null && worker.first != null);
    arena_check(work_arena_append(&parent, &worker) && worker.first == null && worker.last == null);
    arena_check(work_arena_append(&parent, &parent));
    arena_check(first[3499] == 41 && second[1999] == 73 && budget.used_bytes == charged * 2);
    arena_check(!work_budget_dispose(&budget));
    arena_check(work_arena_allocate_result(&worker, 1, 1, &output) == WorkBudgetError.Capacity && output == first);
    var snapshot: WorkArenaSnapshot;
    arena_check(work_arena_snapshot(&parent, &snapshot));
    arena_check(snapshot.chunks == 2 && snapshot.payload == 5500 && snapshot.retained == charged * 2);
    arena_check(work_arena_allocate_result(&parent, 1, 3, &output) == WorkBudgetError.Invalid && output == first);
    arena_check(work_arena_allocate_result(&parent, ~convert(usize, 0), 8, &output) == WorkBudgetError.Invalid);
    work_arena_dispose(&parent);
    arena_check(budget.used_bytes == 0 && budget.live == 0);
    // A moved worker can reuse its empty configuration, while a disposed owner
    // must be initialized again. Neither operation changes another owner.
    arena_check(work_arena_allocate(&worker, 1, 1) != null);
    arena_check(work_arena_allocate(&parent, 1, 1) == null);
    work_arena_dispose(&worker);
    work_arena_dispose(&wrong);
    arena_check(work_budget_dispose(&budget) && work_budget_dispose(&other));
}

fn arena_addresses(): void {
    var budget: WorkBudget = default;
    arena_check(work_budget_init(&budget, 1, 65536, 2));
    var arena: WorkArena = default;
    arena_check(work_arena_init(&arena, &budget, 4096));
    var addresses: u8*[128];
    var sizes: usize[128];
    var payload: usize = 0;
    for(var i: usize = 0; i < 128; i++) {
        sizes[i] = 1 + (i * 13) % 93;
        var alignment: usize = 1 << (i % 7);
        addresses[i] = work_arena_allocate(&arena, sizes[i], alignment);
        arena_check(addresses[i] != null && bits(usize, addresses[i]) % alignment == 0);
        fill(addresses[i], convert(u8, i + 1), sizes[i]);
        payload += sizes[i];
    }
    var large = work_arena_allocate(&arena, 8193, 256);
    arena_check(large != null && bits(usize, large) % 256 == 0);
    fill(large, 97, 8193);
    payload += 8193;
    var zero = work_arena_allocate(&arena, 0, 1);
    var next = work_arena_allocate(&arena, 0, 1);
    arena_check(zero != null && next != null && zero != next);
    payload += 2;
    for(var i: usize = 0; i < 128; i++) {
        for(var byte: usize = 0; byte < sizes[i]; byte++) { arena_check(addresses[i][byte] == convert(u8, i + 1)); }
    }
    arena_check(large[8192] == 97);
    var snapshot: WorkArenaSnapshot;
    arena_check(work_arena_snapshot(&arena, &snapshot));
    arena_check(snapshot.payload == payload && snapshot.capacity >= snapshot.used
        && snapshot.used >= payload + snapshot.chunks * sizeof(WorkArenaChunk));
    arena_check(snapshot.retained == budget.used_bytes
        && snapshot.retained == snapshot.capacity + snapshot.chunks * sizeof(usize) * 4);
    work_arena_dispose(&arena);
    arena_check(budget.used_bytes == 0 && budget.live == 0 && work_budget_dispose(&budget));
    arena_check(work_arena_init(&arena, null, 4096) && work_arena_allocate(&arena, 16, 16) != null);
    work_arena_dispose(&arena);
}

export fn main(argc: i32, argv: u8**): i32 {
    arena_retention();
    arena_addresses();
    print(0);
    return 0;
}
