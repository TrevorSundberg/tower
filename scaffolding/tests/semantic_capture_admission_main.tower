import semantic_capture_admission_checks;
import semantic_capture_admission_checks_test;

export fn main(argc: i32, argv: u8**): i32 {
    var mode: CaptureAdmissionMode;
    if !capture_admission_select(argc, argv, &mode) { return 1; }
    var result = capture_admission_cases(mode);
    return result.failures == 0 ? 0 : 1;
}
