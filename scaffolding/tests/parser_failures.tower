import tower;
import parser_trace_failures;
import frontend_world;
import frontend_table_owner;
import .compiler.parser_table_types;
import .compiler.grammar_types;
import .compiler.parser_markers;
import .compiler.parser_diagnostic_types;

extern fn parser_table_finish(table: ParserHostTable*, error: u8**, specialize: bool): ParserHostTable*;

extern fn parser_stream_utf8_null_terminated_create(text: u8*): void*;

extern fn parser_stream_destroy(stream: void*): void;

extern fn parser_recognizer_create(table: ParserHostTable*, stream: void*): void*;

extern fn parser_recognizer_destroy(request: void*): void;

extern fn parser_recognizer_step(request: void*, running: bool*): void*;

extern fn parser_recognizer_diagnostic(request: void*, reader: ParserDiagnosticReader, source: void*): ParserDiagnostic*;

extern fn parser_diagnostic_destroy(result: ParserDiagnostic*): void;

extern fn tower_test_buffer_allocations(): usize;

extern fn tower_test_buffer_count(): usize;

extern fn tower_test_buffer_fail_after(count: usize): void;

fn parser_failure_tests(): void {
    parser_trace_failure_tests();
    var before = tower_test_buffer_count();
    var world = compiler_world_create();
    var kinds: FrontendKinds;
    frontend_world_check(frontend_world_test_kinds(world, &kinds));
    var root = table_owner_grammar(&kinds, TableOwnerFixture.Sequence);
    var table = parser_table_open(root, &kinds, null, ParserPresentation.Numeric, 0);
    table = parser_table_finish(table, null, false);
    var stream = parser_stream_utf8_null_terminated_create("ab");
    var baseline = tower_test_buffer_count();
    var budget: usize = 0;
    loop {
        tower_test_buffer_fail_after(budget);
        var request = parser_recognizer_create(table, stream);
        tower_test_buffer_fail_after(ParserNoIndex());
        var success = request != null;
        parser_recognizer_destroy(request);
        var ok = tower_test_buffer_count() == baseline;
        frontend_world_check(ok);
        if success {
            break;
        }
        budget = budget + 1;
        ok = budget < 32;
        frontend_world_check(ok);
    }
    parser_stream_destroy(stream);
    stream = parser_stream_utf8_null_terminated_create("a");
    var request = parser_recognizer_create(table, stream);
    var running: bool = true;
    while running {
        parser_recognizer_step(request, &running);
    }
    baseline = tower_test_buffer_count();
    budget = 0;
    loop {
        var calls = tower_test_buffer_allocations();
        tower_test_buffer_fail_after(budget);
        var diagnostic = parser_recognizer_diagnostic(request, ParserDiagnosticReader.None, null);
        tower_test_buffer_fail_after(ParserNoIndex());
        calls = tower_test_buffer_allocations() - calls;
        var completed = diagnostic is not null && diagnostic.complete;
        parser_diagnostic_destroy(diagnostic);
        var ok = tower_test_buffer_count() == baseline;
        frontend_world_check(ok);
        if !(calls > budget) {
            frontend_world_check(completed);
            break;
        }
        budget = budget + 1;
        ok = budget < 256;
        frontend_world_check(ok);
    }
    parser_recognizer_destroy(request);
    parser_stream_destroy(stream);
    parser_table_destroy(table);
    entity_release(root);
    frontend_world_check(compiler_world_dispose(world));
    var ok = tower_test_buffer_count() == before;
    frontend_world_check(ok);
}
