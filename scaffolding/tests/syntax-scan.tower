import tower;

// Tokens keep the existing parser EOF contract and shared-node ownership even
// when any one of the node/payload/text allocations fails.
fn syntax_scan_tests(context: void*, match_kind: void*): usize {
    var budget: usize = 0;
    loop {
        var exhausted = budget == 128;
        if exhausted {
            return 601;
        }
        var buffers = tower_test_buffer_count();
        var input: SyntaxScanInput;
        fill(&input, 0, sizeof(SyntaxScanInput));
        input.context = context;
        input.match_kind = match_kind;
        input.lexicon = lexicon_create();
        lexicon_literal(input.lexicon, "alpha", 5, 7, false);
        input.source = "alpha";
        input.size = 5;
        var result: SyntaxScanResult;
        fill(&result, 0, sizeof(SyntaxScanResult));
        tower_test_buffer_fail_after(budget);
        var node = syntax_scan_read(&input, &result);
        tower_test_buffer_fail_after(lr_none());
        var ran = node != null;
        var ok: bool = true;
        if ran {
            var data = lr_tree_match(node, match_kind);
            ok = data.id == 7;
            if ok {
                ok = data.rule == lr_none();
            }
            if ok {
                ok = data.start == 0;
            }
            if ok {
                ok = data.length == 5;
            }
            if ok {
                ok = lr_name_equal(node_text_get(&data.label), "alpha");
            }
        } else {
            ok = result.error != null;
        }
        if ran {
            entity_release(node);
        }
        syntax_scan_dispose(&result);
        if ran {
            fill(&result, 0, sizeof(SyntaxScanResult));
            node = syntax_scan_read(&input, &result);
            if ok {
                ok = node == null;
            }
            if ok {
                ok = result.id == 4294967294;
            }
            if ok {
                ok = result.error == null;
            }
            if ok {
                ok = result.start == 5;
            }
            var allocated = node != null;
            if allocated {
                entity_release(node);
            }
            syntax_scan_dispose(&result);
            input.source = "🗼";
            input.size = 4;
            input.cursor = 0;
            fill(&result, 0, sizeof(SyntaxScanResult));
            node = syntax_scan_read(&input, &result);
            if ok {
                ok = node == null;
            }
            if ok {
                ok = result.length == 4;
            }
            if ok {
                ok = input.cursor == 4;
            }
            if ok {
                ok = lr_name_equal(result.error, "No token rule matches source");
            }
            allocated = node != null;
            if allocated {
                entity_release(node);
            }
            syntax_scan_dispose(&result);
        }
        lexicon_destroy(input.lexicon);
        var balanced = tower_test_buffer_count() == buffers;
        if balanced {} else {
            return 602;
        }
        if ok {} else {
            return 603;
        }
        if ran {
            return 0;
        }
        budget = budget + 1;
    }
}
