enum GenericResultOperation: u32 { Begin, Register, Instantiate, Deferred, Count }
enum SemanticAdmissionOperation: u32 { Constructor, Begin, Expression, Prepare, Clone, Count }
enum KnownAdmissionOperation: u32 { Source, Capture, Publish, Count, Dispatch }
enum ScratchAdmissionOperation: u32 { Initialize, List, Table, Entry, Push, Clone, Count }
enum NodeAdmissionOperation: u32 { Source, Operand, Block, Synthetic, Read, Local, Staged, Count }
var GenericResultBudgetBytes: usize = 1048576;
var GenericResultOrdinaryKind: u32 = 0;

fn generic_result_call(operation: GenericResultOperation, fixture: GenericCloneFixture*, argument: void*, error: WorkBudgetError*): void* {
    if operation == GenericResultOperation.Begin { return generic_begin_result(fixture.root, error); }
    if operation == GenericResultOperation.Register {
        var kind = generic_register_result(fixture.context, fixture.definition, error);
        return kind == GenericResultOrdinaryKind ? null : fixture.definition;
    }
    if operation == GenericResultOperation.Instantiate {
        return generic_instantiate_result(fixture.context, fixture.definition, fixture.definition, &argument, 1, error);
    }
    return generic_instantiate_deferred_result(fixture.context, fixture.definition, fixture.definition, &argument, 1, error);
}

fn generic_result_storage_tests(result_sweep: function(void)): void {
    var unlimited = ~convert(usize, 0);
    for(var tag = convert(u32, NodeAdmissionOperation.Source); tag < convert(u32, NodeAdmissionOperation.Count); tag++) {
        var operation = convert(NodeAdmissionOperation, tag);
        var calls = semantic_node_storage_trial(operation, unlimited, WorkBudgetError.None);
        for(var allowed: usize = 0; allowed < calls; allowed++) {
            semantic_node_storage_trial(operation, allowed, WorkBudgetError.Memory);
        }
        semantic_node_storage_trial(operation, unlimited, WorkBudgetError.Capacity);
        if operation != NodeAdmissionOperation.Staged { semantic_node_storage_trial(operation, unlimited, WorkBudgetError.Busy); }
    }
    for(var tag = convert(u32, ScratchAdmissionOperation.Initialize); tag < convert(u32, ScratchAdmissionOperation.Count); tag++) {
        var operation = convert(ScratchAdmissionOperation, tag);
        var calls = semantic_scratch_storage_trial(operation, unlimited, false);
        for(var allowed: usize = 0; allowed < calls; allowed++) {
            semantic_scratch_storage_trial(operation, allowed, false);
        }
        semantic_scratch_storage_trial(operation, unlimited, true);
    }
    semantic_scratch_table_atomicity();
    var create_calls = semantic_create_storage_trial(unlimited);
    for(var allowed: usize = 0; allowed < create_calls; allowed++) {
        semantic_create_storage_trial(allowed);
    }
    semantic_attach_storage_trial();
    var layout_calls = semantic_layout_storage_trial(unlimited);
    for(var allowed: usize = 0; allowed < layout_calls; allowed++) {
        semantic_layout_storage_trial(allowed);
    }
    result_sweep();
    generic_result_admission_tests();
    for(var width: u32 = 4; width <= 8; width *= 2) {
        semantic_known_admission_trial(width, KnownAdmissionOperation.Dispatch, 0, WorkBudgetError.Memory);
        for(var tag = convert(u32, KnownAdmissionOperation.Source); tag < convert(u32, KnownAdmissionOperation.Count); tag++) {
            var operation = convert(KnownAdmissionOperation, tag);
            var calls = semantic_known_admission_trial(width, operation, unlimited, WorkBudgetError.None);
            for(var allowed: usize = 0; allowed < calls; allowed++) {
                semantic_known_admission_trial(width, operation, allowed, WorkBudgetError.Memory);
            }
            semantic_known_admission_trial(width, operation, unlimited, WorkBudgetError.Capacity);
            semantic_known_admission_trial(width, operation, unlimited, WorkBudgetError.Busy);
            if operation != KnownAdmissionOperation.Publish {
                semantic_known_admission_trial(width, operation, unlimited, WorkBudgetError.Exhausted);
            }
        }
        for(var tag = convert(u32, SemanticAdmissionOperation.Constructor); tag < convert(u32, SemanticAdmissionOperation.Count); tag++) {
            var operation = convert(SemanticAdmissionOperation, tag);
            var calls = semantic_admission_storage_trial(width, operation, unlimited, WorkBudgetError.None);
            for(var allowed: usize = 0; allowed < calls; allowed++) {
                semantic_admission_storage_trial(width, operation, allowed, WorkBudgetError.Memory);
            }
            semantic_admission_storage_trial(width, operation, unlimited, WorkBudgetError.Capacity);
            semantic_admission_storage_trial(width, operation, unlimited, WorkBudgetError.Busy);
            if operation != SemanticAdmissionOperation.Expression {
                semantic_admission_storage_trial(width, operation, unlimited, WorkBudgetError.Exhausted);
            }
        }
        var initialize_calls = semantic_initialize_storage_trial(width, unlimited, WorkBudgetError.None);
        for(var allowed: usize = 0; allowed < initialize_calls; allowed++) {
            semantic_initialize_storage_trial(width, allowed, WorkBudgetError.Memory);
        }
        semantic_initialize_storage_trial(width, unlimited, WorkBudgetError.Capacity);
        semantic_initialize_storage_trial(width, unlimited, WorkBudgetError.Busy);
        semantic_initialize_storage_trial(width, unlimited, WorkBudgetError.Exhausted);
        generic_result_lifecycle_trial(width, false);
        generic_result_lifecycle_trial(width, true);
    }
}

// Admission and joined publication are separate injection windows. Worker
// execution uses the production allocator; its lexical scratch is not part of
// this metadata test. Failed admission cannot execute or replay that work.
fn semantic_known_admission_trial(width: u32, operation: KnownAdmissionOperation, allowed: usize, wanted: WorkBudgetError): usize {
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    var world: void* = null;
    utility_check(work_budget_init(&budget, 1, GenericResultBudgetBytes, 1)
        && compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None, "Known admission bounded world");
    var store = bits(EntityStore*, compiler_world_store(world));
    var root = entity_create(bits(void*, store));
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, width);
    var context: SemanticContext = default;
    sem_context_init(&context, &program);
    var error: WorkBudgetError;
    var base = sem_attach_result(root, KProgram, &error);
    base.start = 73;
    var subject = generic_clone_child(bits(void*, store), root, "CoreDeclare", null, base.start);
    var value = sem_attach_result(subject, KDeclare, &error);
    value.start = base.start;
    value.global = true;
    utility_check(vector_push(&base.items, subject), "Known admission original declaration identity");
    var proof: usize = 0;
    if operation == KnownAdmissionOperation.Publish || operation == KnownAdmissionOperation.Dispatch {
        proof = sem_source_binding_request(&context, subject);
        utility_check(proof != 0 && work_demand(&context.queries, proof), "Known admission demanded proof");
        if operation == KnownAdmissionOperation.Publish {
            utility_check(sem_source_bindings_pump(&context) == SemanticPumpResult.Progress,
                "Known metadata injection begins after the scan has joined");
        }
    }
    var occupied: WorkReservation = default;
    var view: void* = null;
    var next_id = store.next_id;
    if wanted == WorkBudgetError.Capacity {
        utility_check(work_budget_reserve_result(&budget, 0, 0, budget.bytes - budget.used_bytes, &occupied)
            == WorkBudgetError.None, "Known admission physical page pressure");
    }
    if wanted == WorkBudgetError.Busy { view = entity_view_open(root); utility_check(view != null, "Known admission lifetime pin"); }
    if wanted == WorkBudgetError.Exhausted { store.next_id = ~convert(usize, 0); }
    var unlimited = ~convert(usize, 0);
    var calls = tower_test_buffer_allocations();
    tower_test_buffer_fail_after(allowed);
    var query: usize = 0;
    var outcome = SemanticPumpResult.Waiting;
    if operation == KnownAdmissionOperation.Publish || operation == KnownAdmissionOperation.Dispatch { outcome = sem_source_bindings_pump(&context); }
    else { query = operation == KnownAdmissionOperation.Source ? sem_source_binding_request(&context, subject) : sem_capture_request(&context, subject); }
    tower_test_buffer_fail_after(unlimited);
    calls = tower_test_buffer_allocations() - calls;
    if wanted == WorkBudgetError.Exhausted { store.next_id = next_id; }
    if view != null { entity_view_close(view); }
    if program.resource.error != wanted {
        puts("Known admission: operation, width, allowed, actual, wanted");
        generic_clone_number(convert(usize, operation)); generic_clone_number(convert(usize, width)); generic_clone_number(allowed);
        generic_clone_number(convert(usize, program.resource.error)); generic_clone_number(convert(usize, wanted));
    }
    utility_check(program.resource.error == wanted && context.workers.running == 0 && context.queries.running == 0,
        "Known admission retains its exact first typed failure and drains tickets");
    if wanted == WorkBudgetError.None {
        if operation == KnownAdmissionOperation.Publish {
            var binding = sem_source_binding(&context, subject);
            utility_check(outcome == SemanticPumpResult.Progress && binding != null && binding.immutable
                && binding.owner == null && binding.ordinal == 0 && work_task(&context.queries, proof).state == WorkState.Succeeded,
                "Source facts publish only after the exact proof receipt succeeds");
        } else {
            utility_check(query != 0 && work_task(&context.queries, query).state != WorkState.Succeeded
                && (operation == KnownAdmissionOperation.Source ? sem_source_binding_request(&context, subject) : sem_capture_request(&context, subject)) == query,
                "Known and capture admission preserve resumable query identity without executing effects");
        }
    } else {
        utility_check(query == 0 && program.resource.offset == base.start && sem_source_binding(&context, subject) == null,
            "Failed known admission publishes no partial immutable declaration fact");
        var tasks = context.queries.tasks.length;
        var before = tower_test_buffer_allocations();
        sem_resource_record(&program, WorkBudgetError.Invalid, 0);
        utility_check(sem_source_binding_request(&context, subject) == 0 && sem_capture_request(&context, subject) == 0
            && sem_source_bindings_pump(&context) == SemanticPumpResult.Failed && sem_capture_pump(&context) == SemanticPumpResult.Failed
            && context.queries.tasks.length == tasks && tower_test_buffer_allocations() == before
            && program.resource.error == wanted && program.resource.offset == base.start,
            "Rejected known/capture consumers neither replay effects nor replace the first cause");
    }
    if context.value_inputs != null {
        var input = bits(IMValueInput*, entity_component_data(entity_component_get(subject, context.value_inputs)));
        utility_check(input == null || input.producer == null && input.known_producer == null,
            "Admission never publishes an unevaluated captured value");
    }
    if occupied.active { utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Known pressure release"); }
    work_cancel(&context.queries);
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(root);
    utility_check(compiler_world_dispose(world) && budget.live == 0 && budget.used_bytes == 0
        && work_budget_dispose(&budget) && tower_test_buffer_count() == buffers,
        "Known admission retires partial kinds, jobs, proof metadata and graph ownership");
    return calls;
}

fn semantic_admission_storage_trial(width: u32, operation: SemanticAdmissionOperation, allowed: usize, wanted: WorkBudgetError): usize {
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    var world: void* = null;
    utility_check(work_budget_init(&budget, 1, GenericResultBudgetBytes, 1)
        && compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None, "Semantic admission bounded world");
    var store = bits(EntityStore*, compiler_world_store(world));
    var root = entity_create(bits(void*, store));
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, width);
    var context: SemanticContext = default;
    sem_context_init(&context, &program);
    var error: WorkBudgetError;
    sem_attach_result(root, KProgram, &error).start = 73;
    var subject = generic_clone_child(bits(void*, store), root, "CoreType", null, 73);
    var value = sem_attach_result(subject, KOperand, &error);
    value.start = 73;
    value.type = { scalar: SI32, pointer_bytes: width, ..default };
    var input = sem_create_result(root, &error);
    var literal = sem_attach_result(input, KOperand, &error);
    literal.type = value.type;
    literal.constant = true;
    literal.bits = 42;
    var parent: SemanticDeclaration = { scope: context.scope, current: root, ..default };
    var preparing = operation == SemanticAdmissionOperation.Prepare || operation == SemanticAdmissionOperation.Clone;
    if operation == SemanticAdmissionOperation.Constructor {
        generic_clone_child(bits(void*, store), subject, "args", "args", 73);
    }
    if operation == SemanticAdmissionOperation.Expression || preparing {
        // Warm the separate executable/capture prerequisites outside injection.
        // Their ownership is independent of evaluation's state/preparation chain.
        var warm = generic_clone_child(bits(void*, store), root, "CoreOperand", null, 73);
        sem_evaluation_expression(&context, warm, input, root, false);
        utility_check(program.resource.error == WorkBudgetError.None, "Admission prerequisite setup");
    }
    if preparing {
        sem_evaluation_expression(&context, subject, input, root, false);
        if operation == SemanticAdmissionOperation.Clone {
            var proof = work_request(&context.queries, root, convert(u32, SemanticQuery.KnownProof), 0);
            utility_check(proof != 0 && work_seal(&context.queries, proof) && work_demand(&context.queries, proof), "Clone proof setup");
            var ticket: WorkTicket;
            utility_check(work_take_task(&context.queries, &ticket, proof) && work_finish(&context.queries, &ticket, true), "Clone proof completion");
            var evaluation = sem_evaluation_get(&context, subject);
            evaluation.inferred = true;
            var clone = work_request(&context.queries, subject, convert(u32, SemanticQuery.KnownClone), 0);
            var preparation = work_find(&context.queries, subject, convert(u32, SemanticQuery.EvaluationPrepare), 0);
            utility_check(clone != 0 && work_depend(&context.queries, clone, proof)
                && work_depend(&context.queries, preparation, clone), "Clone dependency setup");
        }
    }
    var occupied: WorkReservation = default;
    var view: void* = null;
    var next_id = store.next_id;
    if wanted == WorkBudgetError.Capacity {
        if operation == SemanticAdmissionOperation.Expression {
            var kind_entity = bits(Entity*, context.evaluation_results);
            utility_check(kind_entity.instance_count != 0, "Warm evaluation component exists");
            var page = kind_entity.instances[0].page;
            while page != null && (page.used < page.capacity || page.free_slot != 0) {
                var filler = sem_create_result(root, &error);
                utility_check(filler != null && entity_component_add(filler, context.evaluation_results) != null,
                    "Fill the actual remaining evaluation page slots");
            }
        }
        utility_check(work_budget_reserve_result(&budget, 0, 0, budget.bytes - budget.used_bytes, &occupied)
            == WorkBudgetError.None, "Admission page pressure");
    }
    if wanted == WorkBudgetError.Busy { view = entity_view_open(root); utility_check(view != null, "Admission lifetime pin"); }
    if wanted == WorkBudgetError.Exhausted { store.next_id = ~convert(usize, 0); }
    var unlimited = ~convert(usize, 0);
    var calls = tower_test_buffer_allocations();
    tower_test_buffer_fail_after(allowed);
    var constructor: SemanticDeclaration* = null;
    var kind: void* = null;
    if operation == SemanticAdmissionOperation.Constructor { constructor = sem_constructor_add(&context, subject, &parent); }
    if operation == SemanticAdmissionOperation.Begin { sem_evaluation_begin(&context); }
    if operation == SemanticAdmissionOperation.Expression { sem_evaluation_expression(&context, subject, input, root, false); }
    if preparing { kind = sem_evaluation_work_register(&context, operation == SemanticAdmissionOperation.Clone); }
    tower_test_buffer_fail_after(unlimited);
    calls = tower_test_buffer_allocations() - calls;
    if wanted == WorkBudgetError.Exhausted { store.next_id = next_id; }
    if view != null { entity_view_close(view); }
    // Entity descriptors and containment are not component-page grants. A
    // kind-only begin succeeds under page pressure; do not invent Capacity.
    var cause = operation == SemanticAdmissionOperation.Begin && wanted == WorkBudgetError.Capacity ? WorkBudgetError.None : wanted;
    if program.resource.error != cause {
        puts("Semantic admission: operation, width, allowed, actual, wanted");
        generic_clone_number(convert(usize, operation)); generic_clone_number(convert(usize, width)); generic_clone_number(allowed);
        generic_clone_number(convert(usize, program.resource.error)); generic_clone_number(convert(usize, cause));
    }
    utility_check(program.resource.error == cause, "Semantic admission preserves its exact producer failure");
    if cause == WorkBudgetError.None {
        if operation == SemanticAdmissionOperation.Constructor {
            utility_check(constructor != null && constructor.query != 0 && constructor.current == parent.current
                && constructor.construction_owner == &parent && !constructor.checked,
                "Constructor admission retains its exact declaration/frame and unfinished ticket");
            var jobs = context.declaration_jobs.length;
            utility_check(sem_constructor_add(&context, subject, &parent) == constructor
                && context.declaration_jobs.length == jobs, "Constructor admission reuses its retained query identity");
        } else {
            utility_check(context.evaluation_results != null && context.evaluation_ready != null, "Evaluation kinds publish together");
            if preparing {
                utility_check(kind != null && (operation == SemanticAdmissionOperation.Clone ? context.evaluation_clone_registered
                    : context.evaluation_registered) == context.evaluation_jobs.length, "Preparation registration advances only its complete frontier");
            }
        }
    } else {
        if program.resource.offset != 73 || constructor != null || kind != null || value.bits != 0 {
            puts("Failed semantic admission operation, allowed, offset, constructor, kind, value");
            generic_clone_number(convert(usize, operation)); generic_clone_number(allowed);
            generic_clone_number(program.resource.offset); generic_clone_number(bits(usize, constructor));
            generic_clone_number(bits(usize, kind)); generic_clone_number(convert(usize, value.bits));
        }
        utility_check(program.resource.offset == 73 && constructor == null && kind == null
            && value.bits == 0, "Admission failure cannot publish a constructor or evaluated value");
        if operation == SemanticAdmissionOperation.Begin {
            utility_check(context.evaluation_results == null && context.evaluation_ready == null,
                "Failed evaluation kind pair is retired before publication");
        }
        var allocations = tower_test_buffer_allocations();
        var tasks = context.queries.tasks.length;
        sem_resource_record(&program, WorkBudgetError.Invalid, 11);
        if operation == SemanticAdmissionOperation.Constructor { utility_check(sem_constructor_add(&context, subject, &parent) == null, "Failed constructor cannot retry"); }
        if operation == SemanticAdmissionOperation.Begin { sem_evaluation_begin(&context); }
        if operation == SemanticAdmissionOperation.Expression { sem_evaluation_expression(&context, subject, input, root, false); }
        if preparing { utility_check(sem_evaluation_work_register(&context, operation == SemanticAdmissionOperation.Clone) == null, "Failed preparation cannot retry"); }
        utility_check(program.resource.error == wanted && program.resource.offset == 73
            && tower_test_buffer_allocations() == allocations && context.queries.tasks.length == tasks,
            "Fatal admission retains first cause without allocation or query replay");
    }
    foreach(var job in &context.evaluation_jobs) {
        var evaluation = bits(SemanticEvaluation*, job);
        utility_check(!evaluation.started && evaluation.ready != null && !evaluation.ready.ready,
            "Admission never starts an interpreter or publishes a partial readiness payload");
    }
    work_cancel(&context.queries);
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(root);
    utility_check(compiler_world_dispose(world), "Admission world cleanup");
    if occupied.active { utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Admission pressure release"); }
    utility_check(budget.live == 0 && budget.used_bytes == 0 && work_budget_dispose(&budget)
        && tower_test_buffer_count() == buffers, "Admission releases every partial owner and budget grant");
    return calls;
}

fn semantic_initialize_storage_trial(width: u32, allowed: usize, wanted: WorkBudgetError): usize {
    var buffers = tower_test_buffer_count();
    var unlimited = ~convert(usize, 0);
    var budget: WorkBudget = default;
    var world: void* = null;
    utility_check(work_budget_init(&budget, 1, GenericResultBudgetBytes, 1)
        && compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None,
        "Root initialization physical owner");
    var store = bits(EntityStore*, compiler_world_store(world));
    var root = entity_create(bits(void*, store));
    var next_id = store.next_id;
    var view: void* = null;
    var occupied: WorkReservation = default;
    if wanted == WorkBudgetError.Exhausted { store.next_id = ~convert(usize, 0); }
    if wanted == WorkBudgetError.Busy {
        view = entity_view_open(root);
        utility_check(view != null, "Root initialization pin");
    }
    if wanted == WorkBudgetError.Capacity {
        utility_check(work_budget_reserve_result(&budget, 0, 0, budget.bytes - budget.used_bytes,
            &occupied) == WorkBudgetError.None, "Root initialization page pressure");
    }
    var program: SemanticProgram = default;
    var calls = tower_test_buffer_allocations();
    tower_test_buffer_fail_after(allowed);
    semantic_initialize(&program, root, width);
    tower_test_buffer_fail_after(unlimited);
    calls = tower_test_buffer_allocations() - calls;
    if wanted == WorkBudgetError.Exhausted { store.next_id = next_id; }
    if view != null { entity_view_close(view); }
    if occupied.active {
        utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None,
            "Root initialization releases pressure");
    }
    utility_check(program.root == root && program.pointer_bytes == width && program.resource.error == wanted,
        "Root initialization retains its exact per-call admission failure");
    if wanted == WorkBudgetError.None {
        utility_check(program.functions.length == 1 && program.functions.data[0] == root,
            "Successful root initialization publishes one program entry");
    } else {
        utility_check(program.functions.length == 0 && program.resource.offset == 0,
            "Failed root initialization publishes no program entry");
        var before = tower_test_buffer_allocations();
        semantic_compile_budget(&program, null, null, 0, "", 0);
        frontend_compile_sources(&program, null, 1, null);
        sem_resource_record(&program, WorkBudgetError.Invalid, 37);
        utility_check(program.resource.error == wanted && program.resource.offset == 0
            && program.functions.length == 0 && tower_test_buffer_allocations() == before,
            "Failed root admission stops both compiler entry points without replay or overwriting its cause");
    }
    semantic_program_dispose(&program);
    entity_release(root);
    utility_check(compiler_world_dispose(world) && budget.live == 0 && budget.used_bytes == 0
        && budget.used_lanes == 0 && work_budget_dispose(&budget) && tower_test_buffer_count() == buffers,
        "Root initialization failure retires all payloads, indexes and physical owners");
    return calls;
}

fn semantic_create_storage_trial(allowed: usize): usize {
    var buffers = tower_test_buffer_count();
    var world = compiler_world_create_workers(1);
    utility_check(world != null, "Semantic create result world");
    var store = compiler_world_store(world);
    var root = entity_create(store);
    var nodes = entity_store_count(store);
    var calls = tower_test_buffer_allocations();
    var error: WorkBudgetError;
    var unlimited = ~convert(usize, 0);
    tower_test_buffer_fail_after(allowed);
    var child = sem_create_result(root, &error);
    tower_test_buffer_fail_after(unlimited);
    calls = tower_test_buffer_allocations() - calls;
    if allowed == unlimited {
        utility_check(child != null && error == WorkBudgetError.None && entity_child_count(root) == 1,
            "Semantic create transfers one child to containment");
    } else {
        utility_check(child == null && error == WorkBudgetError.Memory && entity_child_count(root) == 0
            && entity_store_count(store) == nodes,
            "Semantic create retires its private node when allocation or attachment fails");
        utility_check(sem_create_result(root, &error) != null && error == WorkBudgetError.None,
            "Semantic create retries after its failed private allocation drains");
    }
    utility_check(sem_create_result(null, &error) == null && error == WorkBudgetError.Invalid,
        "Semantic create rejects a missing owner without a default-world fallback");
    entity_release(root);
    utility_check(compiler_world_dispose(world) && tower_test_buffer_count() == buffers,
        "Semantic create result releases all owners");
    return calls;
}

// Sweep actual production allocator calls across a dependent layout frontier.
// Fault injection is serial and ends before any healthy kernel execution.
fn semantic_layout_storage_trial(allowed: usize): usize {
    var buffers = tower_test_buffer_count();
    var world = compiler_world_create_workers(1);
    utility_check(world != null, "Layout storage world");
    var root = entity_create(compiler_world_store(world));
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, 8);
    var context: SemanticContext = default;
    sem_context_init(&context, &program);
    var error: WorkBudgetError;
    var record = sem_create_result(root, &error);
    var base = sem_attach_result(record, KType, &error);
    base.type = { scalar: SStruct, pointer_bytes: program.pointer_bytes, record: record, ..default };
    base.start = 41;
    var field_node = sem_create_result(record, &error);
    var field = sem_attach_result(field_node, KDeclare, &error);
    field.type = { scalar: SI32, pointer_bytes: program.pointer_bytes, ..default };
    utility_check(vector_push(&base.items, field_node), "Layout storage field");
    var subject = sem_create_result(root, &error);
    var array = sem_attach_result(subject, KType, &error);
    array.type = { scalar: SArray, pointer_bytes: program.pointer_bytes, record: subject, ..default };
    array.element = base.type;
    array.length = 3;
    array.start = 37;
    var unlimited = ~convert(usize, 0);
    var calls = tower_test_buffer_allocations();
    tower_test_buffer_fail_after(allowed);
    var query = sem_layout_discover(&context, subject);
    tower_test_buffer_fail_after(unlimited);
    calls = tower_test_buffer_allocations() - calls;
    if allowed == unlimited {
        utility_check(query != 0 && program.resource.error == WorkBudgetError.None
            && work_task(&context.queries, query).state != WorkState.Succeeded,
            "Layout discovery suspends without recursively executing its dependencies");
        var jobs = context.layout_jobs.length;
        utility_check(sem_layout_discover(&context, subject) == query && context.layout_jobs.length == jobs
            && sem_layout_execute(&context) == jobs && work_task(&context.queries, query).state == WorkState.Succeeded
            && base.size == sizeof(i32) && array.size == array.length * base.size && field.byte_offset == 0,
            "Dependent layouts publish once and preserve canonical query identity");
    } else {
        utility_check(query == 0 && program.resource.error == WorkBudgetError.Memory
            && (program.resource.offset == array.start || program.resource.offset == base.start)
            && array.size == 0 && base.size == 0 && context.workers.running == 0,
            "Layout allocation denial preserves its producer and publishes no sizes");
        var tasks = context.queries.tasks.length;
        var before = tower_test_buffer_allocations();
        utility_check(sem_layout_discover(&context, subject) == 0 && sem_layout_execute(&context) == 0
            && context.queries.tasks.length == tasks && tower_test_buffer_allocations() == before,
            "Failed dependent layout admission cannot replay storage or execute a partial frontier");
    }
    work_cancel(&context.queries);
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(root);
    utility_check(compiler_world_dispose(world) && tower_test_buffer_count() == buffers,
        "Layout admission retires every partial payload, offset vector and graph owner");
    return calls;
}

fn semantic_attach_storage_trial(): void {
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    var world: void* = null;
    utility_check(work_budget_init(&budget, 1, GenericResultBudgetBytes, 1)
        && compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None,
        "Semantic component uses a fully bound world");
    var root = entity_create(compiler_world_store(world));
    var occupied: WorkReservation = default;
    utility_check(work_budget_reserve_result(&budget, 0, 0, budget.bytes - budget.used_bytes,
        &occupied) == WorkBudgetError.None, "Semantic component page pressure");
    var error: WorkBudgetError;
    utility_check(sem_attach_result(root, KType, &error) == null && error == WorkBudgetError.Capacity,
        "Semantic component preserves physical page Capacity");
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None,
        "Semantic component page pressure release");
    var value = sem_attach_result(root, KType, &error);
    utility_check(value != null && error == WorkBudgetError.None && value.kind == KType,
        "Semantic component retries with ordinary Foundation initialization");
    value.start = 37;
    var child = sem_create_result(root, &error);
    utility_check(child != null, "Semantic component uninitialized child");
    var view = entity_view_open(root);
    utility_check(view != null, "Semantic component caller lifetime pin");
    utility_check(sem_attach_result(child, KOperand, &error) == null && error == WorkBudgetError.Busy,
        "A missing component respects structural admission");
    utility_check(sem_attach_result(root, KOperand, &error) == value && error == WorkBudgetError.None
        && value.kind == KOperand && value.start == 37,
        "An owned existing payload write preserves fields under a lifetime pin");
    entity_view_close(view);
    utility_check(sem_attach_result(child, KOperand, &error) != null && error == WorkBudgetError.None,
        "Missing component attachment succeeds after the pin closes");
    utility_check(sem_attach_result(null, KType, &error) == null && error == WorkBudgetError.Invalid,
        "Semantic attachment rejects a missing world owner");
    var custom = sem_create_result(root, &error);
    var custom_value = semantic_component_attach(child, custom, KType);
    utility_check(custom_value != null && custom_value != value,
        "Explicit custom semantic component compatibility remains available");
    custom_value.start = 83;
    utility_check(semantic_component_attach(child, custom, KOperand) == custom_value
        && custom_value.kind == KOperand && custom_value.start == 83,
        "Custom component reattachment preserves its distinct payload");
    entity_release(root);
    utility_check(compiler_world_dispose(world) && budget.live == 0 && budget.used_bytes == 0
        && budget.used_lanes == 0 && work_budget_dispose(&budget) && tower_test_buffer_count() == buffers,
        "Semantic component trial retires every payload and budget owner");
}

// Measure the real context's entity demand before positioning the ID boundary.
// This reaches generic_begin inside semantic_compile_budget, after successful
// context setup, without inserting a test hook or duplicating that setup logic.
fn generic_result_lifecycle_trial(width: u32, prior_failure: bool): void {
    var buffers = tower_test_buffer_count();
    var world = compiler_world_create_workers(1);
    utility_check(world != null, "Generic lifecycle world");
    var store = bits(EntityStore*, compiler_world_store(world));
    var probe = entity_create(bits(void*, store));
    var program: SemanticProgram = default;
    semantic_initialize(&program, probe, width);
    var context: SemanticContext = default;
    var first = store.next_id;
    sem_context_init(&context, &program);
    var context_nodes = store.next_id - first;
    first = store.next_id;
    context.generics = generic_begin(probe);
    var registry_nodes = store.next_id - first;
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(probe);
    puts("Generic lifecycle measured context entities and registry entities");
    generic_clone_number(context_nodes); generic_clone_number(registry_nodes);
    utility_check(registry_nodes != 0, "Generic lifecycle derives actual producer ID demand");
    for(var admitted: usize = 0; admitted < registry_nodes; admitted++) {
        var root = entity_create(bits(void*, store));
        program = default;
        semantic_initialize(&program, root, width);
        if prior_failure { sem_resource_record(&program, WorkBudgetError.Capacity, admitted); }
        var next = store.next_id;
        store.next_id = ~convert(usize, 0) - context_nodes - admitted;
        var boundary = store.next_id;
        var calls = tower_test_buffer_allocations();
        semantic_compile_budget(&program, null, null, 0, "", sizeof(FoundationNode));
        var wanted = prior_failure ? WorkBudgetError.Capacity : WorkBudgetError.Exhausted;
        utility_check(store.next_id == (prior_failure ? boundary : ~convert(usize, 0))
            && (!prior_failure || tower_test_buffer_allocations() == calls) && program.resource.error == wanted
            && program.resource.offset == (prior_failure ? admitted : 0),
            "Actual semantic lifecycle preserves ID failure or stops without replaying an earlier resource failure");
        semantic_program_dispose(&program);
        entity_release(root);
        // Every temporary high-ID owner has now retired; future entities can
        // reuse the original monotonic sequence without colliding with one.
        store.next_id = next;
    }
    utility_check(compiler_world_dispose(world) && tower_test_buffer_count() == buffers,
        "Generic lifecycle early exits dispose context scratch and all world owners");
}

fn generic_result_admission_tests(): void {
    var buffers = tower_test_buffer_count();
    var fixture: GenericCloneFixture = default;
    generic_clone_fixture_open(&fixture, 1, 1, 1, null);
    var argument = generic_clone_child(fixture.store, fixture.root, "Argument", null, 0);
    var error = WorkBudgetError.None;
    utility_check(generic_begin_result(null, &error) == null && error == WorkBudgetError.Invalid,
        "Generic begin rejects a missing owner");
    utility_check(generic_register_result(null, fixture.definition, &error) == GenericResultOrdinaryKind
        && error == WorkBudgetError.Invalid, "Generic registration rejects a missing context");
    utility_check(generic_instantiate_result(fixture.context, fixture.definition, fixture.definition, null, 1, &error) == null
        && error == WorkBudgetError.Invalid, "Generic instantiation requires storage for nonempty arguments");
    utility_check(generic_instantiate_deferred_result(fixture.context, null, fixture.definition, &argument, 1, &error) == null
        && error == WorkBudgetError.Invalid, "Deferred generic instantiation rejects a missing definition");
    var store = bits(EntityStore*, fixture.store);
    var nodes = store.entity_count;
    var components = store.component_count;
    var next = store.next_id;
    for(var tag = convert(u32, GenericResultOperation.Begin); tag < convert(u32, GenericResultOperation.Count); tag++) {
        var operation = convert(GenericResultOperation, tag);
        var view = entity_view_open(fixture.root);
        utility_check(view != null, "Generic result admission pins its real input store");
        var result = generic_result_call(operation, &fixture, argument, &error);
        entity_view_close(view);
        utility_check(result == null && error == WorkBudgetError.Busy
            && store.entity_count == nodes && store.component_count == components,
            "Generic operations preserve Busy without changing published owners");
        generic_error_clear(fixture.context);
        if operation != GenericResultOperation.Register {
            store.next_id = ~convert(usize, 0);
            result = generic_result_call(operation, &fixture, argument, &error);
            store.next_id = next;
            utility_check(result == null && error == WorkBudgetError.Exhausted
                && store.entity_count == nodes && store.component_count == components,
                "Generic node creation preserves exhausted entity identifiers");
            generic_error_clear(fixture.context);
        }
    }
    generic_clone_fixture_close(&fixture);
    utility_check(tower_test_buffer_count() == buffers, "Generic admission trials release all buffers");
}

// Injection remains on the serial storage transport. Every trial executes the
// production scratch/clone producer, then retries under its retained failure.
fn semantic_scratch_storage_trial(operation: ScratchAdmissionOperation, allowed: usize, pressure: bool): usize {
    var buffers = tower_test_buffer_count();
    var unlimited = ~convert(usize, 0);
    var budget: WorkBudget = default;
    var world: void* = null;
    utility_check(work_budget_init(&budget, 1, GenericResultBudgetBytes, 1)
        && compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None, "Scratch bounded world");
    var store = compiler_world_store(world);
    var root = entity_create(store);
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, 8);
    var error: WorkBudgetError;
    sem_attach_result(root, KProgram, &error).start = 73;
    var context: SemanticContext = default;
    var list: vector(void*)* = null;
    var table: SemanticTable* = null;
    var original: void* = null;
    if operation != ScratchAdmissionOperation.Initialize {
        sem_context_init(&context, &program);
        list = sem_list(&context);
        table = sem_table(&context);
        utility_check(list != null && table != null, "Scratch trial admits its initial owners");
        utility_check(sem_push_checked(&context, list, root), "Scratch initial list value");
        var entry = sem_state(&context, table, root);
        utility_check(entry != null, "Scratch initial table entry");
        entry.value = root;
        if operation == ScratchAdmissionOperation.Push {
            while list.length < list.capacity { utility_check(sem_push_checked(&context, list, root), "Scratch fill admitted capacity"); }
        }
        if operation == ScratchAdmissionOperation.Clone {
            original = sem_create_result(root, &error);
            var source = sem_attach_result(original, KBlock, &error);
            source.start = 73;
            utility_check(vector_push(&source.name, convert(u8, 120))
                && vector_push(&source.comments, convert(u8, 121)), "Clone owns original text");
            var child = sem_create_result(original, &error);
            var value = sem_attach_result(child, KOperand, &error);
            value.start = source.start;
            value.constant = true;
            value.bits = 42;
            utility_check(vector_push(&source.items, child), "Clone owns its original operation list");
        }
        // Exhaust the actual remaining arena slice, not an assumed chunk size.
        var tail = context.scratch.arena.last;
        var remaining = tail.storage.capacity - tail.used;
        var padding: u8* = null;
        if remaining != 0 {
            utility_check(work_arena_allocate_result(&context.scratch.arena, remaining, 1, &padding) == WorkBudgetError.None,
                "Scratch denial starts at the next physical arena grant");
        }
    }
    var previous_list = list == null ? default(vector(void*)) : *list;
    var previous_table = table == null ? default(SemanticTable) : *table;
    var occupied: WorkReservation = default;
    if pressure {
        utility_check(work_budget_reserve_result(&budget, 0, 0, budget.bytes - budget.used_bytes, &occupied)
            == WorkBudgetError.None, "Scratch capacity pressure");
    }
    var calls = tower_test_buffer_allocations();
    tower_test_buffer_fail_after(allowed);
    var output: void* = null;
    if operation == ScratchAdmissionOperation.Initialize { sem_context_init(&context, &program); }
    if operation == ScratchAdmissionOperation.List { output = bits(void*, sem_list(&context)); }
    if operation == ScratchAdmissionOperation.Table { output = bits(void*, sem_table(&context)); }
    if operation == ScratchAdmissionOperation.Entry { output = bits(void*, sem_state(&context, table, null)); }
    if operation == ScratchAdmissionOperation.Push { if sem_push_checked(&context, list, null) { output = root; } }
    if operation == ScratchAdmissionOperation.Clone { output = sem_defer_clone(&context, root, original, table, list); }
    tower_test_buffer_fail_after(unlimited);
    calls = tower_test_buffer_allocations() - calls;
    var wanted = pressure ? WorkBudgetError.Capacity : allowed == unlimited ? WorkBudgetError.None : WorkBudgetError.Memory;
    if program.resource.error != wanted {
        puts("Scratch operation, allowed, actual, wanted");
        generic_clone_number(convert(usize, operation)); generic_clone_number(allowed);
        generic_clone_number(convert(usize, program.resource.error)); generic_clone_number(convert(usize, wanted));
    }
    utility_check(program.resource.error == wanted, "Scratch preserves exact physical failure");
    if wanted != WorkBudgetError.None {
        if output != null || program.resource.offset != 73 {
            puts("Scratch failed-result operation, allowed, output, offset");
            generic_clone_number(convert(usize, operation)); generic_clone_number(allowed);
            generic_clone_number(bits(usize, output)); generic_clone_number(program.resource.offset);
        }
        utility_check(output == null && program.resource.offset == 73, "Scratch failure has no successful output and retains source position");
        if operation == ScratchAdmissionOperation.Push {
            utility_check(list.data == previous_list.data && list.length == previous_list.length
                && list.capacity == previous_list.capacity, "Denied list growth preserves its previous owner");
        }
        if operation == ScratchAdmissionOperation.Entry {
            utility_check(table.entries == previous_table.entries && table.capacity == previous_table.capacity
                && table.count == previous_table.count && sem_find(table, null, root).value == root,
                "Denied insertion preserves the published table and values");
        }
        var before = tower_test_buffer_allocations();
        tower_test_buffer_fail_after(0);
        utility_check(sem_list(&context) == null && sem_table(&context) == null
            && sem_allocate(&context, sizeof(SemanticEntry)) == null
            && sem_state(&context, table, root) == null
            && sem_defer_clone(&context, root, original, table, list) == null
            && sem_control_local(&context, root, null) == null
            && sem_control_read(&context, root, null) == null
            && sem_lift_value(&context, root, root) == null
            && sem_defer_exit(&context, root, 0) == 0
            && tower_test_buffer_allocations() == before && program.resource.error == wanted
            && program.resource.offset == 73, "Terminal scratch retries allocate nothing and publish nothing");
        tower_test_buffer_fail_after(unlimited);
    } else { utility_check(operation == ScratchAdmissionOperation.Initialize || output != null, "Healthy scratch producer publishes a result"); }
    if occupied.active { utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Scratch pressure release"); }
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(root);
    utility_check(compiler_world_dispose(world) && budget.live == 0 && budget.used_bytes == 0
        && work_budget_dispose(&budget) && tower_test_buffer_count() == buffers,
        "Scratch descriptors, failed registrations, clone payloads and all grants retire");
    return calls;
}

fn semantic_scratch_table_atomicity(): void {
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    utility_check(work_budget_init(&budget, 1, GenericResultBudgetBytes, 1), "Table transaction budget");
    var arena: WorkArena = default;
    utility_check(work_arena_init(&arena, &budget, sizeof(WorkArenaChunk) + sizeof(SemanticEntry) + alignof(SemanticEntry)),
        "Table transaction uses an actual entry-sized arena chunk");
    var table: SemanticTable = default;
    var sentinel: SemanticEntry = default;
    var output = &sentinel;
    // The bucket allocation succeeds, then the distinct entry allocation fails.
    tower_test_buffer_fail_after(1);
    var error = sem_entry_arena(&arena, &table, "key", null, &output);
    tower_test_buffer_fail_after(~convert(usize, 0));
    utility_check(error == WorkBudgetError.Memory && table.entries == null && table.count == 0
        && table.capacity == 0 && output == &sentinel, "Table admits buckets and entry before committing either descriptor");
    work_arena_dispose(&arena);
    utility_check(budget.live == 0 && budget.used_bytes == 0 && work_budget_dispose(&budget)
        && tower_test_buffer_count() == buffers, "Unpublished table storage remains accounted and retires");
}

// Source-node admission must carry a real component/store denial through the
// semantic API. Existing payloads and source identity remain owned by the world.
fn semantic_node_call(context: SemanticContext*, operation: NodeAdmissionOperation, subject: void*, initial: void*): void* {
    if operation == NodeAdmissionOperation.Source {
        return sem_node_result(context, subject, KOperand) == null ? null : subject;
    }
    if operation == NodeAdmissionOperation.Operand { return sem_operand(context, subject, null); }
    if operation == NodeAdmissionOperation.Block {
        sem_block(context, subject, 0);
        return context.program.resource.error == WorkBudgetError.None ? subject : null;
    }
    if operation == NodeAdmissionOperation.Synthetic || operation == NodeAdmissionOperation.Staged { return sem_control_node(context, subject, KOperand); }
    if operation == NodeAdmissionOperation.Read { return sem_control_read(context, subject, initial); }
    return sem_control_local(context, subject, initial);
}

// The first edge and component index fit inline. Both stable slots come from
// pages already charged to this world. Keep that pair alive so the next
// attachment must promote the full child index to a physical buffer.
fn semantic_node_reuse(context: SemanticContext*, operation: NodeAdmissionOperation,
    parent: Entity*, initial: void*, budget: WorkBudget*): Entity* {
    var pressure: WorkReservation = default;
    utility_check(work_budget_reserve_result(budget, 0, 0, budget.bytes - budget.used_bytes, &pressure)
        == WorkBudgetError.None, "Reserve the remaining bytes before pooled node reuse");
    var allocations = tower_test_buffer_allocations();
    var buffers = tower_test_buffer_count();
    var live = budget.live;
    var nodes = parent.store.entity_count;
    var components = parent.store.component_count;
    var result = bits(Entity*, semantic_node_call(context, operation, bits(void*, parent), initial));
    utility_check(result != null && result.parent == parent && result.references == 1
        && parent.children == &parent.inline_children[0] && parent.child_count == parent.child_capacity
        && parent.children[0].entity == result && result.components == &result.inline_components[0]
        && result.component_count == 1 && result.components[0].owner == result
        && result.components[0].data == bits(u8*, sem_get(bits(void*, result)))
        && parent.store.entity_count == nodes + 1 && parent.store.component_count == components + 1,
        "Pooled admission publishes one parent-owned child and its Foundation payload");
    utility_check(tower_test_buffer_allocations() == allocations && tower_test_buffer_count() == buffers
        && budget.live == live && budget.used_bytes == budget.bytes,
        "The first synthetic child and payload reuse precharged capacity with no physical allocation");
    utility_check(work_budget_release_result(budget, &pressure) == WorkBudgetError.None,
        "Release pooled node admission pressure");
    return result;
}

fn semantic_node_storage_trial(operation: NodeAdmissionOperation, allowed: usize, wanted: WorkBudgetError): usize {
    var buffers = tower_test_buffer_count();
    var unlimited = ~convert(usize, 0);
    var budget: WorkBudget = default;
    var world: void* = null;
    utility_check(work_budget_init(&budget, 1, GenericResultBudgetBytes, 1)
        && compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None, "Node admission bounded world");
    var store = compiler_world_store(world);
    var root = entity_create(store);
    var program: SemanticProgram = default;
    semantic_initialize(&program, root, 8);
    var context: SemanticContext = default;
    sem_context_init(&context, &program);
    // Parser offsets are module-relative; the receipt and synthetic descendants
    // retain the same canonical source position, including the module base.
    var source_offset: usize = 73;
    var module_base: usize = 101;
    sem_state(&context, context.source_bases, root).number = module_base;
    sem_get(root).start = source_offset + module_base;
    var label = operation == NodeAdmissionOperation.Operand ? "42"
        : operation == NodeAdmissionOperation.Block ? "CoreBlock" : "CoreOperand";
    var subject = generic_clone_child(store, root, label, null, source_offset);
    if operation == NodeAdmissionOperation.Operand {
        parser_match_create(subject).rule = unlimited;
        context.generics = generic_begin(root);
        utility_check(context.generics != null, "Operand admission owns its ordinary generic context");
    }
    var initial: void* = null;
    if operation == NodeAdmissionOperation.Read || operation == NodeAdmissionOperation.Local {
        // These helpers consume a checked initializer and only admit its new
        // read/local. The enclosing block is already a valid Foundation owner.
        var block = sem_node_result(&context, subject, KBlock);
        initial = sem_control_node(&context, root, KOperand);
        sem_get(initial).type = { scalar: SI32, pointer_bytes: program.pointer_bytes, ..default };
        sem_get(initial).constant = true;
        sem_get(initial).bits = 42;
        utility_check(block != null && initial != null, "Node initializer is admitted before injection");
    }
    utility_check(program.resource.error == WorkBudgetError.None && program.error.length == 0, "Node fixture is healthy before denial");
    if operation == NodeAdmissionOperation.Staged {
        context.entity_stage = entity_stage_open(root);
        utility_check(context.entity_stage != null, "Worker-private node stage opens before denial");
    }
    var owner = bits(Entity*, subject);
    var first: Entity* = null;
    if operation == NodeAdmissionOperation.Synthetic || operation == NodeAdmissionOperation.Read {
        first = semantic_node_reuse(&context, operation, owner, initial, &budget);
        utility_check(sem_get(bits(void*, first)).start == source_offset + module_base,
            "Reused Foundation slot retains the parent source position");
    }
    var previous_scope = context.scope;
    var previous_frame = sem_get(root).frame_size;
    var previous_locals = sem_get(root).locals.length;
    var previous_items = sem_get(subject) == null ? 0 : sem_get(subject).items.length;
    var previous_children = entity_child_count(subject);
    var previous_nodes = entity_store_count(store);
    var previous_components = entity_store_component_count(store);
    var previous_count = context.count;
    var occupied: WorkReservation = default;
    if wanted == WorkBudgetError.Capacity {
        utility_check(work_budget_reserve_result(&budget, 0, 0, budget.bytes - budget.used_bytes, &occupied)
            == WorkBudgetError.None, "Node admission denies actual component storage");
    }
    var view = wanted == WorkBudgetError.Busy || operation == NodeAdmissionOperation.Staged ? entity_view_open(root) : null;
    var calls = tower_test_buffer_allocations();
    tower_test_buffer_fail_after(allowed);
    var result = semantic_node_call(&context, operation, subject, initial);
    tower_test_buffer_fail_after(unlimited);
    calls = tower_test_buffer_allocations() - calls;
    if first != null && wanted == WorkBudgetError.None {
        utility_check(calls != 0 && owner.children != &owner.inline_children[0]
            && owner.child_capacity >= owner.child_count && owner.child_count == previous_children + 1,
            "The next healthy synthetic child grows the full inline index");
    }
    if program.resource.error != wanted || (result != null) != (wanted == WorkBudgetError.None) {
        puts("Node admission: operation, allowed, actual, wanted");
        generic_clone_number(convert(usize, operation)); generic_clone_number(allowed);
        generic_clone_number(convert(usize, program.resource.error)); generic_clone_number(convert(usize, wanted));
    }
    utility_check(program.resource.error == wanted && (result != null) == (wanted == WorkBudgetError.None),
        "Node producer and direct consumer preserve their exact physical cause");
    utility_check(context.scope == previous_scope && context.current == root && context.value_depth == 0,
        "Denied and completed node admission restore lexical context");
    if occupied.active { utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Node admission pressure release"); }
    if wanted != WorkBudgetError.None {
        utility_check(program.resource.offset == source_offset + module_base && program.error_offset == program.resource.offset,
            "Node admission preserves the canonical module source offset");
        if first != null {
            utility_check(entity_child_count(subject) == previous_children && entity_store_count(store) == previous_nodes
                && entity_store_component_count(store) == previous_components && context.count == previous_count
                && owner.children[0].entity == first && first.references == 1 && first.components[0].owner == first,
                "Refused synthetic admission retains the earlier pair and retires its private owner");
        }
        utility_check(sem_get(subject) == null || sem_get(subject).items.length == previous_items,
            "No failed node or local is published to executable items");
        if sem_get(root).locals.length == previous_locals {
            utility_check(sem_get(root).frame_size == previous_frame, "An unregistered local cannot advance its frame");
        }
        var before = tower_test_buffer_allocations();
        var nodes = entity_store_count(store);
        var count = context.count;
        tower_test_buffer_fail_after(0);
        utility_check(semantic_node_call(&context, operation, subject, initial) == null
            && sem_node_result(&context, root, KOperand) == null
            && sem_control_node(&context, subject, KOperand) == null
            && tower_test_buffer_allocations() == before && entity_store_count(store) == nodes
            && context.count == count && program.resource.error == wanted
            && program.resource.offset == source_offset + module_base,
            "Terminal node retries preserve the first cause without allocation, mutation or effect replay");
        tower_test_buffer_fail_after(unlimited);
    } else {
        utility_check(sem_get(result) != null && sem_get(result).start == source_offset + module_base,
            "Healthy source and synthetic results preserve their source identity");
        if operation == NodeAdmissionOperation.Operand { utility_check(sem_get(result).constant && sem_get(result).bits == 42, "Ordinary operand checking retains its known value"); }
        if operation == NodeAdmissionOperation.Read { utility_check(sem_get(result).binding == initial, "Synthetic reads retain declaration identity"); }
        if operation == NodeAdmissionOperation.Local { utility_check(sem_get(result).value == initial, "Synthetic locals retain initializer order and identity"); }
    }
    if context.entity_stage != null {
        utility_check(entity_child_count(subject) == previous_children, "Private stage nodes cannot publish before the owning join");
        entity_stage_discard(context.entity_stage);
        context.entity_stage = null;
    }
    if view != null { entity_view_close(view); }
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(root);
    utility_check(compiler_world_dispose(world) && budget.live == 0 && budget.used_bytes == 0
        && work_budget_dispose(&budget) && tower_test_buffer_count() == buffers, "Denied node admission leaves no owner or grant");
    return calls;
}
