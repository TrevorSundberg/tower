import tower;
import library.vector;

var Word: type = integer_type(4 * 8, 1);
var Bytes: type = array_type(u8, 1 << 3);
var Float: type = float_type(16 * 2);
var HelperBytes: type = array_type(u8, twice(4));
var NestedBytes: type = array_type(u8, nested_bound());
var module_count: usize = 4;
var CapturedBytes: type = array_type(u8, module_count + 1);
enum Tag: integer_type(16 * 2, 1) { First }

fn unavailable(): i32 { return 9; }

fn twice(value: usize): usize { return value * 2; }
fn sum(count: usize): usize {
    var total: usize = 0;
    for (var i: usize = 0; i < count; i++) { total += i; }
    return total;
}
fn recursive(value: usize): usize { return value == 0 ? 0 : 1 + recursive(value - 1); }
fn indirect(callback: function(usize, usize), value: usize): usize { return callback(value); }
fn nested_bound(): usize {
    var storage: u8[twice(3)];
    return sizeof(decltype(storage));
}
fn header_bound(): usize {
    var total: usize = 0;
    for (var i: usize = 0; i < sizeof(u8[twice(2)]); i++) { total++; }
    return total;
}
struct Measure { count: usize; }
fn measure(value: usize): Measure { return { count: value }; }
fn measured(value: usize): usize { var result = measure(value); return result.count; }
fn module_bound(): usize { return module_count; }

fn signed_word(width: usize): type { return integer_type(width * 2, 1); }
fn buffer(T: type, length: usize): type {
    struct Buffer { data: T[length + 1]; }
    return Buffer;
}

fn first_capture(): usize {
    var count = 3;
    var values: u8[comptime(count)];
    return sizeof(decltype(values));
}

fn second_capture(): usize {
    var count = 6;
    var values: u8[count];
    return sizeof(decltype(values));
}

fn verify(): i32 {
    var failures: i32 = 0;
    var first: i32[2 + 3];
    var second: buffer(u8, 3 * 2);
    var nested: u8[comptime(2 + 3)];
    var lazy: u8[true ? 7 : 1 / 0];
    var lazy_call: u8[true ? 7 : unavailable()];
    var target: u8[sizeof(usize) * 2];
    var count = 5;
    var extended = count + 2;
    var captured: u8[extended];
    var selected = true ? count : unavailable();
    var captured_lazy: u8[selected];
    {
        var count = 9;
        count++;
    }
    var after_shadow: u8[count];
    for(var count = 0; count < 2; count++) {}
    var values: vector(u8) = default;
    vector_push(&values, convert(u8, 1));
    foreach(var count in &values) { count = 0; }
    vector_dispose(&values);
    var after_loops: u8[count];
    var runtime = 3;
    runtime++;
    var lazy_capture: u8[true ? count : runtime];
    var explicit_capture: u8[comptime(count + 1)];
    var called: u8[sum(4)];
    var recursive_call: u8[recursive(5)];
    var callback_call: u8[indirect(&twice, 3)];
    var header_call: u8[header_bound()];
    var aggregate_call: u8[measured(5)];
    var local_count = twice(3);
    var helper_captured: u8[local_count + 1];
    var through_call: u8[module_bound()];
    { var local_count: usize = 9; local_count++; }
    if sizeof(decltype(first)) != 20 || sizeof(decltype(second)) != 7 { failures++; }
    if sizeof(Word) != 4 || sizeof(Bytes) != 8 { failures++; }
    if sizeof(Float) != 4 || sizeof(signed_word(16)) != 4 { failures++; }
    if sizeof(Tag) != 4 || sizeof(decltype(lazy_call)) != 7 { failures++; }
    if sizeof(decltype(nested)) != 5 || sizeof(decltype(lazy)) != 7 { failures++; }
    if sizeof(decltype(target)) != sizeof(usize) * 2 { failures++; }
    if sizeof(decltype(captured)) != 7 || sizeof(decltype(captured_lazy)) != 5
        || sizeof(decltype(after_shadow)) != 5 || sizeof(decltype(after_loops)) != 5
        || sizeof(decltype(lazy_capture)) != 5 { failures++; }
    if first_capture() != 3 || second_capture() != 6
        || sizeof(decltype(explicit_capture)) != 6 { failures++; }
    if sizeof(HelperBytes) != 8 || sizeof(decltype(called)) != 6 { failures++; }
    if sizeof(decltype(recursive_call)) != 5 || sizeof(decltype(callback_call)) != 6 { failures++; }
    if sizeof(NestedBytes) != 6 || sizeof(decltype(header_call)) != 4 { failures++; }
    if sizeof(decltype(aggregate_call)) != 5 { failures++; }
    if sizeof(CapturedBytes) != 5 || sizeof(decltype(helper_captured)) != 7 { failures++; }
    if sizeof(decltype(through_call)) != 4 { failures++; }
    return failures;
}
print(verify());
