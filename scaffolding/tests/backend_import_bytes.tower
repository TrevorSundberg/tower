import tower;
import backend_import_storage;
import frontend_units;
import storage_api;
import utility_checks;
import .library.vector;
import .library.work_budget;
import .library.work_budget_types;
import .compiler.format_types;
import .compiler.interpreter_context_types;

extern fn backend_import_fixture_bytes(root: void*, target: u8*): void*;
extern fn ix_init(execution: IMExecution*): void;
extern fn putchar(value: i32): i32;

enum BackendByteOracle: u32 { Correct, WrongByte, WrongGuard }
var BackendByteStepLimit: usize = 100000;

fn backend_import_bytes_trial(resource: u8*, width: u32, oracle: BackendByteOracle): bool {
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    var world: void* = null;
    utility_check(work_budget_init(&budget, 1, BackendAdmissionBytes, 1)
        && compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None, "Counted byte import world");
    var store = compiler_world_store(world);
    var root = entity_create(store);
    var output = entity_create(store);
    var target = width == 4 ? "wasm32-unknown-unknown" : "wasm64-unknown-unknown";
    var backend = backend_import_fixture_bytes(root, target);
    utility_check(root != null && output != null && backend != null, "LLVM counted byte fixture");
    var imported = backend_import_foundation(backend, output);
    if !imported { puts(backend_error(backend)); }
    utility_check(imported && backend_resource_error(backend) == WorkBudgetError.None, "Complete counted byte reconstruction");
    var text: FormatResult = {checked: true, budget: &budget, ..default};
    format_entity(&text, output, null, null, null);
    utility_check(!text.failed, "Counted byte Foundation formatting");
    for (var index: usize = 0; index < text.text.length; index++) {
        utility_check(text.text.data[index] != 0 && text.text.data[index] < 128, "Counted byte source remains ASCII");
    }
    backend_close(backend); entity_release(output); entity_release(root);
    utility_check(compiler_world_dispose(world), "Original LLVM/import world closes before fresh parsing");

    var bedrock: vector(u8) = default;
    var foundation: vector(u8) = default;
    units_read(resource, "/bedrock.tower", &bedrock);
    units_read(resource, "/foundation.tower", &foundation);
    var batch = frontend_units_create(1, 1, width, 1, 1, bedrock.data, foundation.data, resource);
    utility_check(batch != null && frontend_units_source(batch, 1, "counted_initializer_foundation.tower",
        text.text.data, text.text.length), "Fresh Foundation source snapshot");
    format_dispose(&text); vector_dispose(&foundation); vector_dispose(&bedrock);
    utility_check(budget.live == 0 && budget.used_bytes == 0 && budget.used_lanes == 0
        && work_budget_dispose(&budget), "No original reconstruction grants survive recheck");
    while !frontend_units_step(batch, true) {}
    if frontend_units_failed(batch) != 0 { puts(frontend_units_error(batch)); }
    utility_check(frontend_units_failed(batch) == 0 && !frontend_units_cancelled(batch), "Counted initializer fresh parse/check");
    var program = frontend_units_program(batch, 1);
    utility_check(program != null && program.pointer_bytes == width, "Fresh explicit target profile");
    var invocation: IMInvocation = default;
    invocation.state.stack = 16;
    invocation.state.heap = BackendAdmissionBytes;
    invocation.context.root = program.root;
    invocation.context.pointer_bytes = convert(usize, width);
    var execution = init(IMExecution) {state: &invocation.state, context: &invocation.context};
    ix_init(&execution);
    var steps: usize = 0;
    while !invocation.state.done && !invocation.state.failed && steps < BackendByteStepLimit {
        interpreter_invocation_step(&invocation, 7); steps++;
    }
    if invocation.state.failed { puts(invocation.context.error.data); }
    utility_check(invocation.state.done && !invocation.state.failed, "Finite reconstructed initializer execution");

    // Literal oracle, independent of initializer reconstruction: callback/phi42,
    // then each guard and all six original bytes, then adjacent zero/high runs.
    var wanted = "42\n91\n65\n0\n128\n255\n0\n67\n93\n91\n0\n0\n128\n128\n255\n255\n0\n0\n93\n";
    var actual = &invocation.context.output;
    var correct = actual.length == strlen(wanted) && utility_equal(actual.data, wanted, actual.length);
    if !correct {
        puts("Actual counted initializer output:");
        for (var index: usize = 0; index < actual.length; index++) { putchar(convert(i32, actual.data[index])); }
    }
    utility_check(correct, "Every initializer byte, endpoint, guard and original effect matches literal data");
    if oracle == BackendByteOracle.WrongByte {
        wanted = "42\n91\n65\n0\n129\n255\n0\n67\n93\n91\n0\n0\n128\n128\n255\n255\n0\n0\n93\n";
    }
    if oracle == BackendByteOracle.WrongGuard {
        wanted = "42\n91\n65\n0\n128\n255\n0\n67\n94\n91\n0\n0\n128\n128\n255\n255\n0\n0\n93\n";
    }
    var accepted = actual.length == strlen(wanted) && utility_equal(actual.data, wanted, actual.length);
    interpreter_invocation_dispose(&invocation);
    frontend_units_close(batch);
    utility_check(tower_test_buffer_count() == buffers, "Fresh byte execution releases all buffers and world owners");
    return accepted;
}

fn backend_import_bytes_tests(resource: u8*, oracle: BackendByteOracle): i32 {
    var accepted = true;
    for (var width: u32 = 4; width <= 8; width *= 2) {
        if !backend_import_bytes_trial(resource, width, oracle) { accepted = false; }
    }
    if accepted { puts("Counted LLVM bytes: fresh Foundation execution, guards, callback/phi and zero owners passed at32/64 bits."); return 0; }
    puts(oracle == BackendByteOracle.WrongByte ? "Wrong expected byte129 rejected after clean teardown." : "Wrong expected guard94 rejected after clean teardown.");
    return 1;
}
