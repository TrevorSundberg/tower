import tower;
import .compiler.generic_body_types;
import .compiler.parser_types;
import .library.work_budget;
import .library.work_budget_types;
import generic_clone_fixture;
import storage_api;
import utility_checks;

extern fn entity_store_count(store: void*): usize;
extern fn entity_store_component_count(store: void*): usize;
extern fn entity_view_open(anchor: void*): void*;
extern fn entity_view_close(view: void*): void;
extern fn entity_stage_open(anchor: void*): void*;
extern fn entity_stage_hold(stage: void*): void;
extern fn entity_stage_publish(stage: void*): bool;
extern fn entity_stage_discard(stage: void*): void;
extern fn generic_body_complete(context: void*, node: void*, copied: usize): void;
extern fn compiler_generic_body_kernel(payload: void*): void;
extern fn compiler_clone_tree_result(source: void*, limit: usize, copied: usize*, storage_error: WorkBudgetError*): void*;
extern fn compiler_clone_tree(source: void*, limit: usize, copied: usize*): void*;

var GenericCloneBudgetBytes: usize = 131072;
var GenericCloneInitialFrames: usize = 16;
var GenericCloneFrameWords: usize = 3;
var GenericCloneHeaderWords: usize = 4;

enum CloneTreeOutcome: u32 { Success, NodeLimit, CapacityStart, CapacityGrow, Memory, MemoryNode }

// The public synchronous API must obtain its budget from the source world;
// callers do not supply a second, potentially different ledger.
fn generic_clone_tree_trial(width: usize, depth: usize, outcome: CloneTreeOutcome): void {
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    utility_check(work_budget_init(&budget, 1, GenericCloneBudgetBytes, 1), "Public clone byte budget");
    var fixture: GenericCloneFixture = default;
    generic_clone_fixture_open(&fixture, width, depth, 1, &budget);
    var nodes = entity_store_count(fixture.store);
    var components = entity_store_component_count(fixture.store);
    var occupied: WorkReservation = default;
    var first = (GenericCloneInitialFrames * GenericCloneFrameWords + GenericCloneHeaderWords) * sizeof(usize);
    if outcome == CloneTreeOutcome.CapacityStart || outcome == CloneTreeOutcome.CapacityGrow {
        var available = outcome == CloneTreeOutcome.CapacityGrow ? first : 0;
        utility_check(work_budget_reserve(&budget, 0, 0, GenericCloneBudgetBytes - available, &occupied),
            "Public clone reserves the exact denial boundary");
    }
    var count = width * depth + 1;
    var limit = outcome == CloneTreeOutcome.NodeLimit ? count - 1 : count;
    var copied: usize = 0;
    var error = WorkBudgetError.Invalid;
    var memory_failure = outcome == CloneTreeOutcome.Memory || outcome == CloneTreeOutcome.MemoryNode;
    // With a fresh ledger, its entry and the frame buffer precede the first node.
    if memory_failure { tower_test_buffer_fail_after(outcome == CloneTreeOutcome.MemoryNode ? 2 : 0); }
    var clone = compiler_clone_tree_result(fixture.body, limit, &copied, &error);
    tower_test_buffer_fail_after(~convert(usize, 0));
    if outcome == CloneTreeOutcome.Success {
        utility_check(clone != null && copied == count && error == WorkBudgetError.None,
            "Public clone returns its exact complete tree");
        utility_check(entity_child_count(clone) == width, "Public clone preserves branch order");
        for(var branch: usize = 0; branch < width; branch++) {
            var cursor = entity_child_at(clone, branch);
            for(var level: usize = 0; level < depth; level++) {
                utility_check(cursor != null, "Public clone preserves branch depth");
                var span = parser_match_create(cursor);
                utility_check(span.start == branch * depth + level + 1 && strcmp(span.label.data, "CloneLeaf") == 0,
                    "Public clone preserves source metadata");
                utility_check(entity_child_count(cursor) == (level + 1 < depth ? 1 : 0),
                    "Public clone preserves exact leaf shape");
                if level + 1 < depth { cursor = entity_child_at(cursor, entity_member_index(cursor, "next")); }
            }
        }
        entity_release(clone);
        clone = compiler_clone_tree(fixture.body, count, &copied);
        utility_check(clone != null && copied == count, "Compatible clone wrapper shares the bounded implementation");
        entity_release(clone);
    } else {
        var expected_count = outcome == CloneTreeOutcome.NodeLimit ? count - 1
            : outcome == CloneTreeOutcome.CapacityGrow ? GenericCloneInitialFrames : 0;
        var expected_error = outcome == CloneTreeOutcome.NodeLimit ? WorkBudgetError.None
            : memory_failure ? WorkBudgetError.Memory : WorkBudgetError.Capacity;
        var matched = clone == null && copied == expected_count && error == expected_error;
        if !matched {
            puts("Public clone failure receipt: copied, expected copied, error, expected error");
            generic_clone_number(copied); generic_clone_number(expected_count);
            generic_clone_number(convert(usize, error)); generic_clone_number(convert(usize, expected_error));
        }
        utility_check(matched,
            "Public clone distinguishes node quota, capacity and allocation failure");
    }
    utility_check(entity_store_count(fixture.store) == nodes && entity_store_component_count(fixture.store) == components,
        "Public clone retires all complete or partial output ownership");
    var released: WorkBudgetSnapshot = default;
    utility_check(work_budget_snapshot(&budget, &released) && released.used_bytes == occupied.bytes
        && released.live == (occupied.active ? 1 : 0) && released.peak_bytes <= released.bytes,
        "Public clone retires frame grants before returning");
    if occupied.active { utility_check(work_budget_release(&budget, &occupied), "Release public clone denial occupancy"); }
    generic_clone_fixture_close(&fixture);
    utility_check(work_budget_dispose(&budget) && tower_test_buffer_count() == buffers,
        "Public clone releases its world and every physical buffer");
}

// The production registry and deferred-header API create the actual instance.
// Only fixture syntax is synthetic; no second clone implementation is compared.
fn generic_clone_storage_trial(width: usize, depth: usize, failure_index: usize, short_limit: bool,
    budgeted: bool, deny_growth: bool): void {
    var fail_allocation = failure_index != ~convert(usize, 0);
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    if budgeted {
        utility_check(work_budget_init(&budget, 1, GenericCloneBudgetBytes, 1), "Clone fixture byte budget");
    }
    var fixture: GenericCloneFixture = default;
    generic_clone_fixture_open(&fixture, width, depth, 1, budgeted ? &budget : null);
    var store = fixture.store;
    var instance = generic_clone_fixture_instance(&fixture);
    var destination = generic_clone_fixture_body(instance);
    var nodes = entity_store_count(store);
    var components = entity_store_component_count(store);
    var stage = entity_stage_open(fixture.root);
    var view = entity_view_open(fixture.root);
    utility_check(stage != null && view != null, "Clone fixture stage and input view");
    var count = width * depth;
    var request: GenericBodyCopy = { context: fixture.context, node: instance, stage: stage,
        limit: short_limit ? count - 1 : count, budget: budgeted ? &budget : null, ..default };
    var occupied: WorkReservation = default;
    if deny_growth {
        var first = (GenericCloneInitialFrames * GenericCloneFrameWords + GenericCloneHeaderWords) * sizeof(usize);
        utility_check(work_budget_reserve(&budget, 0, 0, GenericCloneBudgetBytes - first, &occupied),
            "Clone growth test leaves room for exactly the initial stack");
    }
    var started = tower_test_buffer_allocations();
    if fail_allocation { tower_test_buffer_fail_after(failure_index); }
    compiler_generic_body_kernel(bits(void*, &request));
    tower_test_buffer_fail_after(~convert(usize, 0));
    var allocations = tower_test_buffer_allocations() - started;
    entity_stage_hold(stage);
    entity_view_close(view);
    if fail_allocation || short_limit || deny_growth {
        var copied = fail_allocation ? 0 : deny_growth ? GenericCloneInitialFrames : count - 1;
        var error = fail_allocation ? WorkBudgetError.Memory : deny_growth ? WorkBudgetError.Capacity : WorkBudgetError.None;
        var matched = !request.success && request.copied == copied && request.storage_error == error;
        if !matched {
            puts("Staged clone failure receipt: fault index, copied, expected copied, error, expected error");
            generic_clone_number(failure_index); generic_clone_number(request.copied); generic_clone_number(copied);
            generic_clone_number(convert(usize, request.storage_error)); generic_clone_number(convert(usize, error));
        }
        utility_check(matched,
            "Clone failure reports exact partial count and distinct resource error");
        entity_stage_discard(stage);
        utility_check(entity_child_count(destination) == 0 && entity_store_count(store) == nodes
            && entity_store_component_count(store) == components, "Failed clone publishes no children or retained payloads");
    } else {
        utility_check(request.success && request.copied == count && request.storage_error == WorkBudgetError.None
            && entity_stage_publish(stage), "Clone success publishes exact node count");
        generic_body_complete(fixture.context, instance, request.copied);
        generic_clone_fixture_check(&fixture, instance);
        puts("Generic clone: width, depth, copied nodes, serial allocator calls during kernel");
        generic_clone_number(width); generic_clone_number(depth);
        generic_clone_number(request.copied); generic_clone_number(allocations);
    }
    if budgeted {
        var released: WorkBudgetSnapshot = default;
        utility_check(work_budget_snapshot(&budget, &released) && released.used_bytes == occupied.bytes
            && released.live == (occupied.active ? 1 : 0) && released.peak_bytes <= released.bytes,
            "Clone scratch is retired before publication result cleanup");
        if occupied.active { utility_check(work_budget_release(&budget, &occupied), "Release clone test occupancy"); }
        puts("Generic clone physical budget: peak bytes including replacement overlap");
        generic_clone_number(released.peak_bytes);
    }
    generic_clone_fixture_close(&fixture);
    if budgeted { utility_check(work_budget_dispose(&budget), "Clone budget outlives the world"); }
    utility_check(tower_test_buffer_count() == buffers, "Clone fixture releases all allocations");
}

fn generic_clone_storage_tests(): void {
    generic_clone_tree_trial(256, 1, CloneTreeOutcome.Success);
    generic_clone_tree_trial(1, 600, CloneTreeOutcome.Success);
    generic_clone_tree_trial(16, 2, CloneTreeOutcome.NodeLimit);
    generic_clone_tree_trial(1, 600, CloneTreeOutcome.CapacityStart);
    generic_clone_tree_trial(1, 600, CloneTreeOutcome.CapacityGrow);
    generic_clone_tree_trial(16, 2, CloneTreeOutcome.Memory);
    generic_clone_tree_trial(16, 2, CloneTreeOutcome.MemoryNode);
    var no_failure = ~convert(usize, 0);
    generic_clone_storage_trial(256, 1, no_failure, false, false, false);
    generic_clone_storage_trial(1, 600, no_failure, false, false, false);
    generic_clone_storage_trial(16, 2, no_failure, true, false, false);
    generic_clone_storage_trial(16, 2, 0, false, false, false);
    generic_clone_storage_trial(256, 1, no_failure, false, true, false);
    generic_clone_storage_trial(1, 600, no_failure, false, true, false);
    generic_clone_storage_trial(1, 600, no_failure, false, true, true);
    // The instance header warmed the ledger. Failure0 is the frame allocation;
    // subsequent points exercise staged node/index/metadata allocation failures.
    for(var failure: usize = 0; failure <= 4; failure++) {
        generic_clone_storage_trial(16, 2, failure, false, true, false);
    }
}
