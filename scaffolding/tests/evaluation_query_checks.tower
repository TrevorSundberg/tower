import tower;
import .compiler.semantic_context_types;
import .compiler.semantic_evaluation_types;
import semantic_source_proof_checks;
import semantic_resource_checks;
import type_execution_receipts;
import semantic_world;
import .compiler.foundation_tags;
import .compiler.semantic_program_types;
import .compiler.interpreter_context_types;
import .compiler.semantic_query_api;
import .compiler.semantic_declaration_types;
import .compiler.component_kinds;
import .compiler.parser_types;
import .compiler.semantic_work_ids;
import .compiler.compiler_kernel;
import .library.work_graph;
import .library.work_pool;
import .library.vector;

extern fn compiler_world_create_workers(limit: usize): void*;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_dispose(world: void*): bool;
extern fn entity_create(store: void*): void*;
extern fn puts(text: u8*): i32;
extern fn compiler_world_component(world: void*, node: void*, kind: u32): void*;
extern fn node_match_set_label(value: ParserMatchData*, label: u8*): bool;

enum BodyQueryFixture: u32 { Resume, Cycle, Cancel, InvalidBody, LaterWindow }
var BodyQueryFixtureCount: usize = 4;
var BodyQueryWindowCount: usize = BodyPreparationWindow + 1;

// A small real CoreBlock tree avoids reparsing a grammar for scheduler tests.
// Its declared void header is published separately, then ordinary discovery and
// body kernels must execute, join and retire the same ECS continuation once.
fn body_query_tests(width: u32, workers: usize, mode: BodyQueryFixture): u32 {
    var failures: u32 = 0;
    var world = compiler_world_create_workers(workers);
    var root = entity_create(compiler_world_store(world));
    var program: SemanticProgram;
    semantic_initialize(&program, root, width);
    var context: SemanticContext;
    sem_context_init(&context, &program);
    context.generics = generic_begin(root);
    var headers: vector(usize) = default;
    defer vector_dispose(&headers);
    var count = mode == BodyQueryFixture.LaterWindow ? BodyQueryWindowCount : BodyQueryFixtureCount;
    for(var i: usize = 0; i < count; i++) {
        var subject = sem_create(root);
        var function = sem_attach(subject, KFunction);
        function.type.scalar = SVoid;
        function.type.pointer_bytes = width;
        function.index = program.functions.length;
        sem_push(&program.functions, subject);
        var block = sem_create(subject);
        function.body = block;
        sem_require(entity_attach(block, subject, "body"));
        var syntax = bits(ParserMatchData*, compiler_world_component(world, block, CompilerParserMatch));
        sem_require(node_match_set_label(syntax, mode == BodyQueryFixture.InvalidBody && i == 0 ? "UnsupportedBlock" : "CoreBlock"));
        var header = work_request(&context.queries, subject, convert(u32, SemanticQuery.Declaration), 0);
        var declaration = sem_declaration_state(&context, subject);
        declaration.subject = subject;
        declaration.query = header;
        sem_require(work_seal(&context.queries, header));
        sem_require(vector_push(&headers, header));
    }
    context.body_roots = true;
    evaluation_query_check(sem_bodies_pump(&context) == SemanticPumpResult.Progress,
        "Body admission persists its source frontier before checking", &failures);
    var state = entity_component_data(entity_component_get(root, context.body_pipeline));
    if mode == BodyQueryFixture.LaterWindow {
        evaluation_query_check(sem_bodies_pump(&context) == SemanticPumpResult.Progress,
            "A blocked source window admits later function producers", &failures);
    }
    if mode == BodyQueryFixture.Resume {
        context.surface_expressions = true;
        var snapshot = work_request(&context.queries, root, convert(u32, SemanticQuery.KnownSnapshot), 0);
        sem_require(work_seal(&context.queries, snapshot));
        evaluation_query_check(sem_lower_pump(&context, false) == SemanticPumpResult.Waiting,
            "Lowering cannot mutate expressions before inferred captures are cloned", &failures);
        var ticket: WorkTicket = default;
        sem_require(work_take_task(&context.queries, &ticket, snapshot));
        sem_require(work_finish(&context.queries, &ticket, true));
        evaluation_query_check(sem_lower_pump(&context, false) == SemanticPumpResult.Progress
            && sem_lower_pump(&context, false) == SemanticPumpResult.Waiting,
            "Lowering publishes a ready root while function bodies remain suspended", &failures);
    }
    if mode == BodyQueryFixture.Cycle {
        var ticket: WorkTicket = default;
        sem_require(work_take_task(&context.queries, &ticket, headers.data[0]));
        var body = work_find(&context.queries, program.functions.data[1], convert(u32, SemanticQuery.Body), 0);
        sem_require(work_suspend(&context.queries, &ticket, body));
    }
    evaluation_query_check(sem_bodies_pump(&context) == SemanticPumpResult.Waiting
        && program.error.length == 0 && context.workers.running == 0
        && sem_bodies_admitted(&context) == count,
        "Body checking yields without forcing headers or prematurely selecting a cycle", &failures);
    // This structural write also verifies that no input view survives the pump.
    var marker = sem_create(root);
    sem_attach(marker, KOperand);
    if mode == BodyQueryFixture.Resume || mode == BodyQueryFixture.InvalidBody || mode == BodyQueryFixture.LaterWindow {
        if mode == BodyQueryFixture.LaterWindow {
            var ticket: WorkTicket = default;
            sem_require(work_take_task(&context.queries, &ticket, headers.data[count - 1]));
            sem_require(work_finish(&context.queries, &ticket, true));
            evaluation_query_check(sem_bodies_pump(&context) == SemanticPumpResult.Progress
                && work_task(&context.queries, work_find(&context.queries, program.functions.data[count], convert(u32, SemanticQuery.Body), 0)).state == WorkState.Succeeded
                && work_task(&context.queries, work_find(&context.queries, program.functions.data[1], convert(u32, SemanticQuery.Body), 0)).state == WorkState.Waiting,
                "A ready body beyond the original window executes while earlier headers wait", &failures);
        }
        foreach(var header in &headers) {
            if work_task(&context.queries, header).state == WorkState.Succeeded { continue; }
            var ticket: WorkTicket = default;
            sem_require(work_take_task(&context.queries, &ticket, header));
            sem_require(work_finish(&context.queries, &ticket, true));
        }
        var outcome = sem_bodies_pump(&context);
        if mode == BodyQueryFixture.InvalidBody {
            evaluation_query_check(outcome == SemanticPumpResult.Failed && program.error.length != 0
                && sem_equal(program.error.data, "Expected a CoreBlock tree") && context.workers.running == 0,
                "Malformed bodies fail through joined discovery components", &failures);
        } else {
            evaluation_query_check(outcome == SemanticPumpResult.Progress
                && program.error.length == 0 && context.workers.running == 0,
                "Published headers resume real body discovery and checking kernels", &failures);
            if mode == BodyQueryFixture.Resume {
                var lowering_kind = context.lowering_results;
                evaluation_query_check(sem_lower_pump(&context, false) == SemanticPumpResult.Progress
                    && sem_lower_pump(&context, false) == SemanticPumpResult.Complete
                    && context.lowering_results == lowering_kind && context.workers.running == 0,
                    "Body receipts release existing lowering components without replaying the root", &failures);
                var root_lowering = work_find(&context.queries, root, convert(u32, SemanticQuery.Lowering), 0);
                evaluation_query_check(work_task(&context.queries, root_lowering).dispatch == 1,
                    "Repeated lowering pumps execute the completed root only once", &failures);
            }
            foreach(var header in &headers) {
                var subject = work_task(&context.queries, header).subject;
                var body = work_find(&context.queries, subject, convert(u32, SemanticQuery.Body), 0);
                evaluation_query_check(work_task(&context.queries, body).state == WorkState.Succeeded
                    && work_task(&context.queries, body).dispatch == 1 && sem_get(subject).body != null,
                    "Resumed body publishes exactly once", &failures);
            }
            evaluation_query_check(sem_bodies_pump(&context) == SemanticPumpResult.Complete
                && sem_bodies_pump(&context) == SemanticPumpResult.Complete
                && entity_component_data(entity_component_get(root, context.body_pipeline)) == state
                && sem_bodies_admitted(&context) == count,
                "Completed body pipeline keeps its identity without replay", &failures);
        }
    } else {
        if mode == BodyQueryFixture.Cycle {
            sem_body_pipeline_finish(&context);
            evaluation_query_check(program.error.length != 0
                && sem_equal(program.error.data, "Body checking dependency cycle"),
                "Quiescent body/header cycle is diagnosed by the shared graph", &failures);
        } else {
            work_cancel(&context.queries);
            evaluation_query_check(sem_bodies_pump(&context) == SemanticPumpResult.Failed
                && context.workers.running == 0, "Cancelled body pipeline has no outstanding worker borrow", &failures);
        }
    }
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(root);
    evaluation_query_check(compiler_world_dispose(world), "Suspended body pipeline releases its work and world", &failures);
    return failures;
}

fn evaluation_query_check(ok: bool, message: u8*, failures: u32*): void {
    if !ok { puts(message); *failures += 1; }
}

extern fn call_query_tests(width: u32): u32;

fn evaluation_query_stage(c: SemanticContext*, input: void*, requested: bool): SemanticEvaluation* {
    var subject = sem_create(c.program.root);
    var value = sem_attach(subject, KOperand);
    value.type = sem_get(input).type;
    value.constant = true;
    var result = bits(SemanticEvaluation*, entity_component_data(entity_component_add(subject, c.evaluation_results)));
    *result = default;
    result.subject = subject;
    result.owner = c.program.root;
    result.literal = subject;
    result.expression = input;
    result.requested = requested;
    result.ready = bits(IMDependency*, entity_component_data(entity_component_add(subject, c.evaluation_ready)));
    *result.ready = default;
    result.ready.subject = subject;
    result.kernel.kind = CompilerKernelKind.Evaluate;
    result.kernel.payload = bits(void*, &result.invocation);
    sem_push(&c.evaluation_jobs, bits(void*, result));
    sem_evaluation_request(c, result);
    return result;
}

// Exercise a dependency discovered after its consumer has already started, then
// append another consumer to the same graph. An unreachable stage must never
// acquire executable nodes; pumping a completed graph must not replay work.
export fn evaluation_query_tests(width: u32, workers: usize): u32 {
    var failures: u32 = 0;
    failures += semantic_source_proof_tests(width, workers);
    failures += semantic_resource_tests(width, workers);
    type_execution_receipt_tests(width);
    failures += call_query_tests(width);
    failures += body_query_tests(width, workers, BodyQueryFixture.Resume);
    failures += body_query_tests(width, workers, BodyQueryFixture.Cycle);
    failures += body_query_tests(width, workers, BodyQueryFixture.Cancel);
    failures += body_query_tests(width, workers, BodyQueryFixture.InvalidBody);
    failures += body_query_tests(width, workers, BodyQueryFixture.LaterWindow);
    var world = compiler_world_create_workers(workers);
    var root = entity_create(compiler_world_store(world));
    var program: SemanticProgram;
    semantic_initialize(&program, root, width);
    var context: SemanticContext;
    sem_context_init(&context, &program);
    sem_evaluation_begin(&context);
    var input = sem_create(root);
    var value = sem_attach(input, KOperand);
    value.type.scalar = SI32;
    value.type.pointer_bytes = width;
    value.constant = true;
    value.bits = 42;
    var producer = evaluation_query_stage(&context, input, false);
    var unused = evaluation_query_stage(&context, input, false);
    var consumer = evaluation_query_stage(&context, producer.subject, true);
    sem_evaluation_work_register(&context, false);
    sem_require(work_demand(&context.queries, work_find(&context.queries, consumer.subject, convert(u32, SemanticQuery.Evaluation), 0)));
    sem_evaluation_prepare_all(&context);
    evaluation_query_check(consumer.started && !consumer.ready.ready && !producer.started && !unused.started,
        "Demanded preparation owns interpreter startup without executing or starting unrelated stages", &failures);
    sem_evaluations(&context);
    evaluation_query_check(program.error.length == 0 && consumer.ready.ready && !consumer.ready.failed
        && sem_get(consumer.subject).bits == 42, "Interpreter demand prepares and resumes a nested stage", &failures);
    var prepare = work_find(&context.queries, producer.subject, convert(u32, SemanticQuery.EvaluationPrepare), 0);
    evaluation_query_check(work_task(&context.queries, prepare).dispatch == 1,
        "Late dependency prepares exactly once", &failures);
    var unused_prepare = work_find(&context.queries, unused.subject, convert(u32, SemanticQuery.EvaluationPrepare), 0);
    evaluation_query_check(!work_task(&context.queries, unused_prepare).demanded && unused.function == null
        && !unused.started, "Unreachable stage has no prepared function or interpreter", &failures);
    var count = context.count;
    var kind = context.evaluation_preparations;
    var function = consumer.function;
    sem_evaluations(&context);
    evaluation_query_check(context.count == count && context.evaluation_preparations == kind
        && consumer.function == function, "Repeated scheduler pump retains published work", &failures);
    var late = evaluation_query_stage(&context, consumer.subject, true);
    sem_evaluations(&context);
    evaluation_query_check(program.error.length == 0 && late.ready.ready && !late.ready.failed
        && sem_get(late.subject).bits == 42 && context.evaluation_preparations == kind,
        "Appended stage reuses the graph and preparation components", &failures);
    evaluation_query_check(unused.function == null && !unused.started,
        "Appended demand leaves unrelated work dormant", &failures);
    var frontier = context.evaluation_jobs.length;
    for(var i: usize = 0; i <= SemanticPreparationWindow; i++) {
        // Independent readers span more than one bounded publication window.
        // Every third reader discovers a fresh producer only during execution.
        var dependency = i % 3 == 0 ? evaluation_query_stage(&context, input, false).subject : consumer.subject;
        evaluation_query_stage(&context, dependency, true);
    }
    sem_evaluations(&context);
    evaluation_query_check(program.error.length == 0, "Ready evaluation windows drain dynamic dependencies", &failures);
    for(var i = frontier; i < context.evaluation_jobs.length; i++) {
        var result = bits(SemanticEvaluation*, context.evaluation_jobs.data[i]);
        evaluation_query_check(result.ready.ready && !result.ready.failed && sem_get(result.subject).bits == 42,
            "Refilled evaluation windows publish the ordinary interpreter result", &failures);
        var prepared = work_find(&context.queries, result.subject, convert(u32, SemanticQuery.EvaluationPrepare), 0);
        evaluation_query_check(work_task(&context.queries, prepared).dispatch == 1,
            "Refilled evaluation windows prepare each dependency once", &failures);
    }
    evaluation_query_check(unused.function == null && !unused.started,
        "Refilled evaluation windows preserve undemanded work", &failures);
    // A producer owned by another compiler phase is not an evaluation cycle.
    var blocked = evaluation_query_stage(&context, input, true);
    var owner = sem_create(root);
    sem_attach(owner, KFunction);
    var prerequisite = work_request(&context.queries, owner, convert(u32, SemanticQuery.Body), 0);
    sem_require(work_seal(&context.queries, prerequisite));
    // A checked type receipt still waits for its producing body. The pump must
    // preserve that continuation rather than forcing its producer recursively.
    var declaration = sem_declaration_state(&context, input);
    declaration.subject = input;
    declaration.checked = true;
    declaration.calls_scanned = true;
    declaration.kernel.payload = bits(void*, declaration);
    declaration.query = work_request(&context.queries, input, convert(u32, SemanticQuery.Declaration), 0);
    sem_require(work_depend(&context.queries, declaration.query, prerequisite));
    sem_require(work_access(&context.queries, declaration.query, convert(u64, SemanticWorkDomain.Compiler),
        convert(u64, SemanticAccess.Declaration), declaration.query, 1, WorkAccessMode.Write));
    sem_require(work_seal(&context.queries, declaration.query));
    var preparation = work_find(&context.queries, blocked.subject, convert(u32, SemanticQuery.EvaluationPrepare), 0);
    sem_require(work_depend(&context.queries, preparation, declaration.query));
    evaluation_query_check(sem_evaluation_pump(&context) == SemanticPumpResult.Waiting
        && program.error.length == 0 && !blocked.started && context.workers.running == 0,
        "Evaluation pump yields to another phase without a false cycle or worker borrow", &failures);
    evaluation_query_check(sem_declarations_pump(&context) == SemanticPumpResult.Waiting
        && program.error.length == 0 && context.workers.running == 0,
        "Declaration pump preserves an unfinished producer without forcing it", &failures);
    var receipt: WorkTicket = default;
    sem_require(work_take_task(&context.queries, &receipt, prerequisite));
    sem_require(work_finish(&context.queries, &receipt, true));
    evaluation_query_check(sem_declarations_pump(&context) == SemanticPumpResult.Progress
        && work_task(&context.queries, declaration.query).state == WorkState.Succeeded,
        "Body publication releases the waiting declaration continuation", &failures);
    evaluation_query_check(sem_declarations_pump(&context) == SemanticPumpResult.Complete,
        "Completed declarations do not replay when the phase is pumped again", &failures);
    evaluation_query_check(sem_evaluation_pump(&context) == SemanticPumpResult.Progress
        && blocked.ready.ready && sem_get(blocked.subject).bits == 42,
        "Published body receipt resumes the same interpreter consumer", &failures);
    evaluation_query_check(sem_evaluation_pump(&context) == SemanticPumpResult.Complete,
        "Settled evaluation pump reports completion without replay", &failures);
    evaluation_query_check(!unused.started, "Cross-phase resumption keeps undemanded stages dormant", &failures);
    work_pool_close(&context.workers);
    sem_context_dispose(&context);
    semantic_program_dispose(&program);
    entity_release(root);
    evaluation_query_check(compiler_world_dispose(world), "Demanded stage workers release world ownership", &failures);
    return failures;
}
