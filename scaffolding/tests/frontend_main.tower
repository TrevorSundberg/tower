import tower;
import compiler_buffer_owner;
import compiler_work_owner;
import frontend_world;
import frontend_session_world;
import frontend_units_allocation;
import editor_world;
import body_runs;
import parser_failures;
import frontend_diagnostic_revision;
import frontend_session_format;
import frontend_session_scan;
import regex;
import syntax_lexer;

extern fn parser_tests(): void;

extern fn lr_work_tests(): u32;

extern fn tower_test_buffer_count(): usize;

extern fn puts(text: u8*): i32;

// Focused production-API checks, including allocation-failure cleanup.
// This entry does not walk or reformat the repository's source files.
export fn main(argc: i32, argv: u8**): i32 {
    if argc == 3 && strcmp(argv[2], "allocations") == 0 {
        frontend_units_allocation_root_tests(argv[1]);
        return 0;
    }
    if argc == 3 && strcmp(argv[2], "editor") == 0 {
        editor_world_tests(argv[1]);
        return 0;
    }
    if argc == 3 && strcmp(argv[2], "parser") == 0 {
        parser_tests();
        parser_failure_tests();
        return 0;
    }
    if argc != 2 {
        return 1;
    }
    compiler_buffer_owner_tests();
    compiler_work_owner_tests();
    frontend_world_tests();
    frontend_session_world_tests();
    frontend_units_allocation_root_tests(argv[1]);
    editor_world_tests(argv[1]);
    var body_buffers = tower_test_buffer_count();
    body_runs_tests(argv[1]);
    if tower_test_buffer_count() != body_buffers {
        puts("Body continuation scratch cleanup failed");
        return 2;
    }
    var lr_buffers = tower_test_buffer_count();
    if lr_work_tests() != 0 || tower_test_buffer_count() != lr_buffers {
        puts("LR worker graph or scratch cleanup failed");
        return 3;
    }
    parser_tests();
    parser_failure_tests();
    frontend_diagnostic_revision_tests();
    frontend_session_format_tests();
    frontend_session_setup_tests();
    frontend_session_scan_tests();
    regex_tests();
    syntax_lexer_tests();
    return 0;
}
