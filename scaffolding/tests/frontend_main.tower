import tower;
import compiler_buffer_owner;
import compiler_work_owner;
import frontend_world;
import frontend_session_world;
import frontend_syntax_version;
import frontend_template_build;
import frontend_units_allocation;
import backend_execution_index;
import editor_world;
import body_runs;
import parser_failures;
import frontend_diagnostic_revision;
import frontend_session_format;
import frontend_session_scan;
import regex;
import syntax_lexer;
import frontend_iteration_profile;
import parser_structure_reuse;
import presentation_budget;
import parser_diagnostic_budget;
import frontend_diagnostic_text;
import lr_analysis_comparisons;
import lr_analysis_failures;

extern fn parser_tests(): void;
extern fn syntax_tests(): void;

extern fn lr_work_tests(): u32;

extern fn tower_test_buffer_count(): usize;

extern fn puts(text: u8*): i32;

// Focused production-API checks, including allocation-failure cleanup.
// This entry does not walk or reformat the repository's source files.
export fn main(argc: i32, argv: u8**): i32 {
    if argc == 3 && strcmp(argv[2], "presentation-budget") == 0 {
        presentation_budget_tests();
        presentation_diagnostic_lifetime();
        parser_diagnostic_budget_tests();
        frontend_diagnostic_text_tests();
        frontend_diagnostic_revision_tests();
        frontend_session_format_tests();
        regex_test_pattern_resources();
        return 0;
    }
    if argc == 3 && strcmp(argv[2], "lr-order") == 0 {
        lr_analysis_storage_failures();
        lr_analysis_comparison_tests(true);
        return 0;
    }
    if argc == 3 && strcmp(argv[2], "lr-suffix") == 0 {
        frontend_suffix_profile();
        return 0;
    }
    if argc == 3 && strcmp(argv[2], "structure-reuse") == 0 {
        parser_structure_reuse_tests();
        return 0;
    }
    if argc == 3 && strcmp(argv[2], "grammar-equivalence") == 0 {
        parser_tests();
        syntax_tests();
        return 0;
    }
    if argc == 3 && (strcmp(argv[2], "iteration-installed") == 0 || strcmp(argv[2], "iteration-cold") == 0) {
        frontend_iteration_profile(argv[1], strcmp(argv[2], "iteration-installed") == 0);
        return 0;
    }
    if argc == 3 && strcmp(argv[2], "execution-index") == 0 {
        backend_execution_index_tests(argv[1]);
        return 0;
    }
    if argc == 3 && strcmp(argv[2], "allocations") == 0 {
        frontend_units_allocation_root_tests(argv[1]);
        return 0;
    }
    if argc == 3 && strcmp(argv[2], "editor") == 0 {
        editor_world_tests(argv[1]);
        return 0;
    }
    if argc == 3 && strcmp(argv[2], "grammar-resource") == 0 {
        frontend_syntax_version_tests();
        frontend_syntax_construction_tests();
        frontend_template_build_tests();
        return 0;
    }
    if argc == 3 && strcmp(argv[2], "regex") == 0 {
        regex_tests();
        return 0;
    }
    if argc == 3 && strcmp(argv[2], "parser") == 0 {
        parser_tests();
        parser_failure_tests();
        return 0;
    }
    if argc == 3 && strcmp(argv[2], "diagnostics") == 0 {
        frontend_diagnostic_revision_tests();
        return 0;
    }
    if argc != 2 {
        return 1;
    }
    puts("frontend: compiler_buffer_owner_tests");
    compiler_buffer_owner_tests();
    puts("frontend: compiler_work_owner_tests");
    compiler_work_owner_tests();
    puts("frontend: frontend_world_tests");
    frontend_world_tests();
    puts("frontend: frontend_session_world_tests");
    frontend_session_world_tests();
    puts("frontend: frontend_units_allocation_root_tests");
    frontend_units_allocation_root_tests(argv[1]);
    puts("frontend: backend_execution_index_tests");
    backend_execution_index_tests(argv[1]);
    puts("frontend: editor_world_tests");
    editor_world_tests(argv[1]);
    var body_buffers = tower_test_buffer_count();
    puts("frontend: body_runs_tests");
    body_runs_tests(argv[1]);
    if tower_test_buffer_count() != body_buffers {
        puts("Body continuation scratch cleanup failed");
        return 2;
    }
    puts("frontend: lr_work_tests");
    var lr_buffers = tower_test_buffer_count();
    if lr_work_tests() != 0 || tower_test_buffer_count() != lr_buffers {
        puts("LR worker graph or scratch cleanup failed");
        return 3;
    }
    puts("frontend: parser_tests");
    parser_tests();
    puts("frontend: parser_failure_tests");
    parser_failure_tests();
    puts("frontend: frontend_diagnostic_revision_tests");
    frontend_diagnostic_revision_tests();
    puts("frontend: frontend_session_format_tests");
    frontend_session_format_tests();
    puts("frontend: frontend_session_setup_tests");
    frontend_session_setup_tests();
    puts("frontend: frontend_session_scan_tests");
    frontend_session_scan_tests();
    puts("frontend: regex_tests");
    regex_tests();
    puts("frontend: syntax_lexer_tests");
    syntax_lexer_tests();
    return 0;
}
