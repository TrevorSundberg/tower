import tower;
import syntax_reader_test;

extern fn puts(text: u8*): i32;

export fn syntax_reader_tests(): void {
    reader_test_identifiers();
    reader_test_identifier_storage();
    reader_test_rules();
    reader_test_replacement();
    reader_test_tokens();
    reader_test_skips();
    reader_test_missing_capture();
    puts("Syntax reader: 1000 byte fixtures, exact independent Tower reference trees/errors, malformed spans and allocation failures passed.");
}
