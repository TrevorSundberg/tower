import .library.bytes_types;
import .compiler.grammar_types;
import .compiler.semantic_program_types;
import .backend.import_bindings;
import .library.work_budget_types;

extern fn driver_read_file(path: u8*, out: ByteBuffer*): bool;
extern fn driver_write_file(path: u8*, data: u8*, length: usize): bool;
extern fn compiler_world_create_result(workers: usize, budget: WorkBudget*, world: void**): WorkBudgetError;
extern fn compiler_world_grammar(world: void*): CompilerGrammarCache*;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_type_existing(world: void*, kind: u32): void*;
extern fn compiler_buffer_allocation_size(bytes: usize): usize;
extern fn fflush(stream: void*): i32;
extern fn printf(format: u8*, phase: usize, entering: usize, entities: usize,
    components: usize, bytes: usize, grants: usize, lanes: usize): i32;

struct ReconstructionProbe {
    world: void*; budget: WorkBudget*; source: BackendSource*; output: u8*;
    parses: usize; deny: bool; census: bool; occupied: WorkReservation;
}

struct ReconstructionRule { id: u32; label: u8*; count: usize; leaves: usize; wrappers: usize; bytes: usize; }
struct ReconstructionUsage {
    user_seconds: i64; user_micros: i64; system_seconds: i64; system_micros: i64;
    peak_rss: i64; shared: i64; data: i64; stack: i64; minor: i64; major: i64;
    swaps: i64; reads: i64; writes: i64; sent: i64; received: i64; signals: i64;
    voluntary: i64; involuntary: i64;
}
extern fn getrusage(who: i32, usage: ReconstructionUsage*): i32;

fn reconstruction_buffer(data: u8*): usize {
    if data == null { return 0; }
    var header = bits(EntityBufferAllocation*, data - sizeof(EntityBufferAllocation));
    return compiler_buffer_allocation_size(header.allocation.capacity);
}

// Capacity survives publication; used is the high-water slot count, while live
// excludes removed rows. Multiple never-filled pages cannot come solely from
// the coordinator's fill-first pool: private stages publish their own pages.
fn reconstruction_foundation_pages(store: EntityStore*, kind: Entity*): void {
    var maximum: usize = 0;
    var page = store.storage.owned;
    while page != null {
        if page.type_id == kind.id && page.capacity > maximum { maximum = page.capacity; }
        page = page.owned_next;
    }
    for(var capacity: usize = 2; capacity <= maximum; capacity++) {
        var pages: usize = 0; var live: usize = 0; var used: usize = 0;
        var bytes: usize = 0; var never_full: usize = 0; var never_full_live: usize = 0;
        page = store.storage.owned;
        while page != null {
            if page.type_id == kind.id && page.capacity == capacity {
                pages++; live += page.live; used += page.used;
                bytes += compiler_buffer_allocation_size(page.allocation.capacity);
                if page.used < page.capacity { never_full++; never_full_live += page.live; }
            }
            page = page.owned_next;
        }
        if pages != 0 {
            printf("foundation_capacity=%zu pages=%zu live=%zu used=%zu physical=%zu never_full=%zu never_full_live=%zu\n",
                capacity, pages, live, used, bytes, never_full, never_full_live);
        }
    }
}

fn reconstruction_ir(probe: ReconstructionProbe*): void {
    var functions: usize = 0; var declarations: usize = 0; var blocks: usize = 0; var instructions: usize = 0;
    var function = LLVMGetFirstFunction(probe.source.backend.backend.module);
    while function != null {
        functions++;
        var block = LLVMGetFirstBasicBlock(function);
        if block == null { declarations++; }
        while block != null {
            blocks++;
            var instruction = LLVMGetFirstInstruction(block);
            while instruction != null { instructions++; instruction = LLVMGetNextInstruction(instruction); }
            block = LLVMGetNextBasicBlock(block);
        }
        function = LLVMGetNextFunction(function);
    }
    printf("llvm_functions=%zu declarations=%zu blocks=%zu instructions=%zu reserved=%zu reserved=%zu reserved=%zu\n",
        functions, declarations, blocks, instructions, 0, 0, 0);
}

// Read-only debugger entry uses the actual Tower layout, not guessed offsets.
export fn backend_reconstruction_error(payload: void*): usize {
    var program = bits(SemanticProgram*, payload);
    printf("frontend_resource=%zu offset=%zu functions=%zu types=%zu diagnostic_bytes=%zu reserved=%zu reserved=%zu\n",
        convert(usize, program.resource.error), program.resource.offset, program.functions.length,
        program.types.length, program.error.length, 0, 0);
    fflush(null);
    return convert(usize, program.resource.error);
}
