// Separate test entry imports only types and declaration boundaries for the LR
// algorithms. Keep the public-bootstrap parser aggregate below its expansion cap.
extern fn frontend_units_create(count: usize, budget: usize, width: u32, revision: u64, profile: u64, bedrock: u8*, foundation: u8*, library: u8*): void*;
extern fn frontend_units_close(batch: void*): void;
extern fn compiler_world_create_workers(limit: usize): void*;
extern fn compiler_world_create_result(limit: usize, budget: WorkBudget*, world: void**): WorkBudgetError;
extern fn compiler_world_bind_budget(world: void*, budget: WorkBudget*): bool;
extern fn compiler_world_dispose(world: void*): bool;
extern fn compiler_world_store(world: void*): void*;
extern fn entity_create(store: void*): void*;
extern fn entity_release(node: void*): usize;
extern fn lr_state_wide_admission(root: void*, size: usize, admits: bool): bool;
extern fn lr_first_work_trial(root: void*, mode: usize): bool;
extern fn lr_propagation_budget_trial(anchor: void*): bool;
extern fn lr_work_trial(root: void*, rules: LRProduction*, count: usize,
    symbols: LRSymbol*, length: usize, names: usize): bool;
extern fn lr_action_rebuild_trial(root: void*, rules: LRProduction*, count: usize, symbols: LRSymbol*, length: usize): bool;
extern fn lr_propagation_create_budget_result(count: usize, budget: WorkBudget*, error: WorkBudgetError*): void*;
extern fn lr_propagation_seed_result(value: void*, node: usize, first: u32, last: u32): WorkBudgetError;
extern fn lr_propagation_count(value: void*, node: usize): usize;
extern fn lr_propagation_data(value: void*, node: usize): SymbolRange*;
extern fn lr_propagation_destroy(value: void*): void;

fn lr_pool_memory_budget(root: void*, budget: WorkBudget*): bool {
    var before: WorkBudgetSnapshot = default;
    if !work_budget_snapshot(budget, &before) { return false; }
    var capacity = compiler_worker_capacity(root);
    var probe: WorkPool = default;
    if !work_pool_open_budget(&probe, capacity, budget) { return false; }
    var bytes = probe.storage.reservation.bytes;
    var charged: WorkBudgetSnapshot = default;
    var measured = work_budget_snapshot(budget, &charged) && bytes != 0
        && charged.used_bytes == before.used_bytes + bytes && charged.used_lanes == before.used_lanes
        && charged.live == before.live + 1;
    work_pool_close(&probe);
    if !measured { return false; }
    var competing: WorkReservation = default;
    if work_budget_reserve_result(budget, 0, 0, before.bytes - before.used_bytes - (bytes - 1),
        &competing) != WorkBudgetError.None { return false; }
    defer {
        if competing.active && work_budget_release_result(budget, &competing) != WorkBudgetError.None {
            trap("LR pool fixture lost storage grant", 0);
        }
    }
    var lease: ParserWorkers = default;
    var error = parser_workers_open_result(&lease, root, capacity);
    parser_workers_close(&lease);
    if error != WorkBudgetError.Capacity || !work_budget_snapshot(budget, &charged)
        || charged.used_bytes != before.used_bytes + competing.bytes || charged.live != before.live + 1
        || charged.used_lanes != before.used_lanes { return false; }
    if work_budget_release_result(budget, &competing) != WorkBudgetError.None { return false; }
    error = parser_workers_open_result(&lease, root, capacity);
    if error != WorkBudgetError.None { return false; }
    var valid = lease.pool.storage.reservation.bytes == bytes && work_budget_snapshot(budget, &charged)
        && charged.used_bytes == before.used_bytes + bytes && charged.live == before.live + 1
        && charged.used_lanes == before.used_lanes;
    parser_workers_close(&lease);
    return valid;
}

// Use a measured retained lower bound to force denial inside runtime creation,
// including worker-produced rows. Joined failure must restore the original
// ledger; releasing the competing grant must allow the same source to retry.
fn lr_runtime_memory_budget(root: void*, budget: WorkBudget*): bool {
    var rules: LRProduction[2] = default;
    var symbols: LRSymbol[2] = default;
    var rule_count = sizeof(decltype(rules)) / sizeof(LRProduction);
    var symbol_count = sizeof(decltype(symbols)) / sizeof(LRSymbol);
    rules[0].count = 1;
    rules[1].owner = 1; rules[1].begin = 1; rules[1].count = 1;
    symbols[0].nonterminal = rules[1].owner;
    symbols[1] = {nonterminal: ~convert(usize, 0), first: 65, last: 65};
    var analysis = lr_analysis_create(&rules[0], rule_count, &symbols[0], symbol_count, rule_count);
    if analysis == null { return false; }
    defer lr_analysis_destroy(analysis);
    if !lr_analysis_compute(analysis) { return false; }
    var states = lr_states_create(analysis);
    if states == null { return false; }
    defer lr_states_destroy(states);
    if !lr_states_lalr(states, false) { return false; }
    var width: usize = 2;
    if width > lr_states_count(states) { width = lr_states_count(states); }
    // Retained pool storage is a separate owner, not a runtime-table leak.
    var workers: ParserWorkers = default;
    if !parser_workers_open(&workers, root, width) { return false; }
    parser_workers_close(&workers);
    var before: WorkBudgetSnapshot = default;
    if !work_budget_snapshot(budget, &before) { return false; }
    var error = WorkBudgetError.None;
    if lr_runtime_create_owned_result(null, budget, &error) != null || error != WorkBudgetError.Invalid { return false; }
    var value = lr_runtime_create_owned_result(states, budget, &error);
    if value == null || error != WorkBudgetError.None { return false; }
    var retained: WorkBudgetSnapshot = default;
    var measured = work_budget_snapshot(budget, &retained);
    lr_runtime_destroy(value);
    if !measured || retained.used_bytes <= before.used_bytes { return false; }
    var available = retained.used_bytes - before.used_bytes - 1;
    var competing: WorkReservation = default;
    if work_budget_reserve_result(budget, 0, 0, before.bytes - before.used_bytes - available,
        &competing) != WorkBudgetError.None { return false; }
    defer {
        if competing.active && work_budget_release_result(budget, &competing) != WorkBudgetError.None {
            trap("LR memory fixture lost competing storage", 0);
        }
    }
    value = lr_runtime_create_owned_result(states, budget, &error);
    var denied = value == null && error == WorkBudgetError.Capacity;
    lr_runtime_destroy(value);
    if !denied { return false; }
    value = lr_runtime_create_work_result(states, root, width, &error);
    denied = value == null && error == WorkBudgetError.Capacity;
    lr_runtime_destroy(value);
    var after: WorkBudgetSnapshot = default;
    if !denied || !work_budget_snapshot(budget, &after)
        || after.used_bytes != before.used_bytes + competing.bytes
        || after.used_lanes != before.used_lanes || after.live != before.live + 1 { return false; }
    if work_budget_release_result(budget, &competing) != WorkBudgetError.None { return false; }
    value = lr_runtime_create_work_result(states, root, width, &error);
    if value == null || error != WorkBudgetError.None { return false; }
    var conflict: LRConflict = default;
    var valid = !lr_runtime_conflict(value, &conflict) && lr_runtime_row_count(value) != 0;
    lr_runtime_destroy(value);
    return valid && work_budget_snapshot(budget, &after) && after.used_bytes == before.used_bytes
        && after.used_lanes == before.used_lanes && after.live == before.live;
}

// Hold competing outer reservations without blocking a worker. A previously
// retained wide pool must obey the current shared grant, including no extras.
// Actual overlap and transport races are covered by the production observer run.
struct LRDispatchProbe {
    kernel: CompilerKernel;
    gate: void*;
    release: void*;
    active: usize*;
    peak: usize*;
    participants: usize;
    budget: WorkBudget*;
    result: void*;
    success: bool;
}

fn lr_dispatch_probe_execute(payload: void*): void {
    var job = bits(LRDispatchProbe*, bits(CompilerKernel*, payload).payload);
    work_signal_wait(job.gate);
    (*job.active)++;
    if *job.peak < *job.active { *job.peak = *job.active; }
    if *job.active == job.participants {
        for(var i: usize = 0; i < job.participants; i++) { work_signal_post(job.release); }
    }
    work_signal_post(job.gate);
    work_signal_wait(job.release);
    var error = WorkBudgetError.None;
    job.result = lr_propagation_create_budget_result(1, job.budget, &error);
    job.success = job.result != null && error == WorkBudgetError.None;
    for(var i: u32 = 0; i < 33 && job.success; i++) {
        job.success = lr_propagation_seed_result(job.result, 0, i * 2, i * 2) == WorkBudgetError.None;
    }
    work_signal_wait(job.gate);
    (*job.active)--;
    work_signal_post(job.gate);
}

// Both scratch jobs must finish. With a peer available a two-party barrier
// requires actual overlap. With every child held the caller runs both jobs.
fn lr_dispatch_probe(participants: usize): bool {
    var gate = work_signal_open();
    var release = work_signal_open();
    if gate == null || release == null {
        if gate != null { work_signal_close(gate); }
        if release != null { work_signal_close(release); }
        return false;
    }
    defer work_signal_close(gate);
    defer work_signal_close(release);
    work_signal_post(gate);
    var budget: WorkBudget = default;
    if !work_budget_init(&budget, 2, 1048576, 1)
        || !work_budget_synchronize(&budget, gate, work_signal_wait, work_signal_post) { return false; }
    defer { if !work_budget_dispose(&budget) { trap("Overlapping LR scratch retained receipts", 0); } }
    var jobs: LRDispatchProbe[2] = default;
    var pointers: LRDispatchProbe*[2];
    var count = sizeof(decltype(jobs)) / sizeof(LRDispatchProbe);
    defer { for(var i: usize = 0; i < count; i++) { lr_propagation_destroy(jobs[i].result); } }
    var active: usize = 0;
    var peak: usize = 0;
    var pool: WorkPool = default;
    if !work_pool_open_kernel(&pool, count, lr_dispatch_probe_execute) { return false; }
    defer work_pool_close(&pool);
    if pool.count != participants || pool.threaded != (participants > 1) { return false; }
    for(var i: usize = 0; i < count; i++) {
        jobs[i] = init(LRDispatchProbe) {gate: gate, release: release, active: &active,
            peak: &peak, participants: participants, budget: &budget, ..default};
        jobs[i].kernel.payload = bits(void*, &jobs[i]);
        pointers[i] = &jobs[i];
    }
    if !compiler_kernel_dispatch_admitted(&pool, &pointers[0], count, count - 1) { return false; }
    if active != 0 || peak != participants || pool.peak != participants - 1 { return false; }
    for(var i: usize = 0; i < count; i++) {
        if !jobs[i].success || lr_propagation_count(jobs[i].result, 0) != 33 { return false; }
        var data = lr_propagation_data(jobs[i].result, 0);
        for(var at: u32 = 0; at < 33; at++) {
            if data[at].first != at * 2 || data[at].last != at * 2 { return false; }
        }
    }
    if budget.used_bytes == 0 || budget.live == 0 { return false; }
    for(var i: usize = 0; i < count; i++) {
        lr_propagation_destroy(jobs[i].result);
        jobs[i].result = null;
    }
    return budget.used_bytes == 0 && budget.live == 0 && budget.used_lanes == 0;
}

fn lr_dispatch_caller_overlap(): bool {
    return !work_thread_available() || work_thread_capacity() < 2 || lr_dispatch_probe(2);
}

// Run in a fresh four-child group. Pending unit handles own their outer pools
// until close, even before any source is submitted.
export fn lr_competing_frontend_tests(): bool {
    var units: usize = 2;
    if work_thread_capacity() != units * 2 { return false; }
    var first = frontend_units_create(units, units, 4, 1, 1, "", "", ".");
    if first == null { return false; }
    defer frontend_units_close(first);
    var second = frontend_units_create(units, units, 4, 2, 1, "", "", ".");
    if second == null { return false; }
    defer frontend_units_close(second);
    return lr_dispatch_probe(1);
}

var LRActionTrialLength: usize = 1024;

fn lr_budget_terminals(symbols: LRSymbol*, count: usize): void {
    for(var i: usize = 0; i < count; i++) {
        var literal = convert(u32, i + 32);
        symbols[i] = {nonterminal: ~convert(usize, 0), first: literal, last: literal};
    }
}

// The long start production admits action workers. Its leading choice gives
// construct mode more lookaheads than an EOF-only action row can hold.
fn lr_budget_rebuild_rows(root: void*): bool {
    var symbols: LRSymbol[LRActionTrialLength];
    var count = sizeof(decltype(symbols)) / sizeof(LRSymbol);
    lr_budget_terminals(&symbols[0], count);
    var alternatives: LRProduction[WorkBufferInitialElements + 2] = default;
    var rules = sizeof(decltype(alternatives)) / sizeof(LRProduction);
    var prefix = count - (rules - 1);
    alternatives[0].count = prefix;
    symbols[0].nonterminal = 1;
    for(var i: usize = 1; i < rules; i++) {
        alternatives[i] = {owner: 1, begin: prefix + i - 1, count: 1, ..default};
    }
    return lr_action_rebuild_trial(root, &alternatives[0], rules, &symbols[0], count);
}

// Exercise charged propagation, action replacement and overlap in both hosts.
var LRBoundedTrialBytes: usize = 64 * 1024 * 1024;
export fn lr_bounded_propagation_tests(): bool {
    var lanes: usize = 2;
    if !work_thread_available() || work_thread_capacity() < lanes || !lr_dispatch_caller_overlap() { return false; }
    var gate = work_signal_open();
    if gate == null { return false; }
    defer work_signal_close(gate);
    work_signal_post(gate);
    var budget: WorkBudget = default;
    if !work_budget_init(&budget, lanes, LRBoundedTrialBytes, 1) { return false; }
    defer { if !work_budget_dispose(&budget) { trap("Bounded LR trial retained a grant", 0); } }
    if !work_budget_synchronize(&budget, gate, work_signal_wait, work_signal_post) { return false; }
    var before: WorkBudgetSnapshot = default;
    if !work_budget_snapshot(&budget, &before) { return false; }
    {
        var caller: WorkReservation = default;
        if work_budget_reserve_result(&budget, 1, 1, 0, &caller) != WorkBudgetError.None { return false; }
        defer { if !work_budget_release(&budget, &caller) { trap("Bounded LR trial lost caller lane", 0); } }
        var world: void* = null;
        if compiler_world_create_result(lanes, &budget, &world) != WorkBudgetError.None { return false; }
        defer { if !compiler_world_dispose(world) { trap("Bounded LR trial retained its world", 0); } }
        var root = entity_create(compiler_world_store(world));
        if root == null { return false; }
        defer entity_release(root);
        if compiler_world_work_budget(compiler_node_world(root)) != &budget
            || !lr_propagation_budget_trial(root) || !lr_budget_rebuild_rows(root) { return false; }
    }
    var after: WorkBudgetSnapshot = default;
    return work_budget_snapshot(&budget, &after) && after.peak_lanes == lanes && after.peak_bytes == before.bytes
        && after.used_bytes == before.used_bytes && after.live == before.live && after.used_lanes == before.used_lanes;
}

fn lr_shared_worker_budget(): bool {
    var limit = work_thread_capacity();
    var test_limit: usize = 4;
    if limit > test_limit { limit = test_limit; }
    var gate = work_signal_open();
    if gate == null { return false; }
    defer work_signal_close(gate);
    work_signal_post(gate);
    var budget: WorkBudget = default;
    // This fixture saturates lanes while allowing physical parser buffers.
    // Byte-denial and retained-owner checks use separate bounded fixtures.
    if !work_budget_init(&budget, limit, ~convert(usize, 0), 1)
        || !work_budget_synchronize(&budget, gate, work_signal_wait, work_signal_post) { return false; }
    defer { if !work_budget_dispose(&budget) { trap("LR fixture retained worker budget", 0); } }
    var outer: WorkReservation = default;
    if work_budget_reserve_result(&budget, 1, 1, 0, &outer) != WorkBudgetError.None { return false; }
    defer {
        if work_budget_release_result(&budget, &outer) != WorkBudgetError.None {
            trap("LR fixture lost caller reservation", 0);
        }
    }
    var world = compiler_world_create_workers(limit);
    if world == null { return false; }
    defer { if world != null && !compiler_world_dispose(world) { trap("LR budget fixture retained world", 0); } }
    if !compiler_world_bind_budget(world, &budget) || compiler_world_bind_budget(world, &budget) { return false; }
    var root = entity_create(compiler_world_store(world));
    if root == null { return false; }
    defer { if root != null { entity_release(root); } }
    if !lr_pool_memory_budget(root, &budget) { return false; }
    if !lr_runtime_memory_budget(root, &budget) { return false; }
    if !lr_first_work_trial(root, 0) { return false; }
    // One worker fails after bounded scratch admission; an unreachable bad
    // suffix stays lazy. Both joined paths must retire every private result.
    if !lr_first_work_trial(root, 1) || !lr_first_work_trial(root, 2) { return false; }
    if !lr_propagation_budget_trial(root) { return false; }
    if !lr_state_wide_admission(root, 512, true) { return false; }
    var other: WorkReservation = default;
    defer {
        if other.active && work_budget_release_result(&budget, &other) != WorkBudgetError.None {
            trap("LR fixture lost competing reservation", 0);
        }
    }
    if work_budget_reserve_result(&budget, limit - 1, limit - 1, 0, &other) != WorkBudgetError.None { return false; }
    if !lr_state_wide_admission(root, 512, false) || !lr_first_work_trial(root, 0) { return false; }
    if other.active && work_budget_release_result(&budget, &other) != WorkBudgetError.None { return false; }
    if limit > 2 {
        if work_budget_reserve_result(&budget, limit - 2, limit - 2, 0, &other) != WorkBudgetError.None { return false; }
        var admission: ParserAdmission = default;
        if !parser_admission_open(&admission, root, limit) { return false; }
        var admitted = admission.extra == 1;
        parser_admission_close(&admission, null);
        if !admitted || !lr_state_wide_admission(root, 512, true) { return false; }
        if work_budget_release_result(&budget, &other) != WorkBudgetError.None { return false; }
    }
    var symbols: LRSymbol[LRActionTrialLength];
    var count = sizeof(decltype(symbols)) / sizeof(LRSymbol);
    lr_budget_terminals(&symbols[0], count);
    var rule: LRProduction = {owner: 0, begin: 0, count: count, precedence: 0, associativity: 0};
    if !lr_work_trial(root, &rule, 1, &symbols[0], count, 1) { return false; }
    if limit > 1 && !lr_budget_rebuild_rows(root) { return false; }
    var snapshot: WorkBudgetSnapshot = default;
    var retained = &compiler_world_grammar(world).workers.storage.reservation;
    var owners: usize = (outer.active ? 1 : 0) + (retained.active ? 1 : 0);
    if !work_budget_snapshot(&budget, &snapshot) || snapshot.used_lanes != outer.lanes
        || snapshot.live != owners || snapshot.used_bytes != retained.bytes || snapshot.peak_lanes > limit { return false; }
    entity_release(root);
    root = null;
    if !compiler_world_dispose(world) { return false; }
    world = null;
    return work_budget_snapshot(&budget, &snapshot) && snapshot.used_bytes == 0
        && snapshot.used_lanes == outer.lanes && snapshot.live == (outer.active ? 1 : 0);
}
