import tower;
import semantic_lifecycle_frontier_checks_test;

export fn semantic_lifecycle_frontier_tests(): i32 {
    var failures = lifecycle_admission_cases();
    failures += lifecycle_late_registration_cases();
    failures += lifecycle_first_signature_cases();
    failures += lifecycle_frontier_cases();
    failures += lifecycle_denial_cases();
    return failures == 0 ? 0 : 1;
}
