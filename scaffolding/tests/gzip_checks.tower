import tower;
import utility_checks;
import .library.gzip;
import .library.gzip_test_data;
import .library.bytes;
import .library.bytes_types;
import .compiler.host_text;
import .tools.tool_files_posix;
import .tools.tool_streams_posix;
import .tools.tool_capture_linux;
import .tools.tool_process_linux;
import .library.vector;
import .host.driver_files;

fn gzip_reference(path: u8*, limit: usize, output: ByteBuffer*): i32 {
    var args: vector(u8*) = default; defer vector_dispose(&args);
    utility_check(tool_process_argument(&args, "/usr/bin/gzip") && tool_process_argument(&args, "-dc")
        && tool_process_argument(&args, path) && tool_process_argument(&args, null), "reference decoder arguments");
    return tool_capture(args.data[0], args.data, limit, output);
}

fn gzip_fixture(directory: u8*, name: u8*, input: ByteBuffer*): void {
    var encoded: ByteBuffer = default; var repeated: ByteBuffer = default;
    var source: ByteBuffer = default; var path: ByteBuffer = default;
    defer bytes_dispose(&encoded); defer bytes_dispose(&repeated);
    defer bytes_dispose(&source); defer bytes_dispose(&path);
    utility_check(gzip_deterministic_member(input, &encoded, &repeated), "deterministic gzip member");
    utility_check(gzip_rejects_invalid_input(&encoded, &repeated), "invalid gzip input leaves output unchanged");
    utility_check(gzip_encodes_aliased_input(input, &encoded, &repeated), "aliased gzip input publication");
    utility_check(tool_join(&source, directory, name) && bytes_append(&source, ".bin", 4)
        && host_text_terminate(&source) && tool_output_parents(source.data)
        && driver_write_file(source.data, input.data, input.length), "write independent gzip reference");
    utility_check(tool_join(&path, directory, name) && bytes_append(&path, ".gz", 3)
        && host_text_terminate(&path) && driver_write_file(path.data, encoded.data, encoded.length), "write gzip member");
    var decoded: ByteBuffer = default; defer bytes_dispose(&decoded);
    utility_check(gzip_reference(path.data, input.length, &decoded) == 0 && decoded.length == input.length
        && utility_equal(decoded.data, input.data, input.length), "Tower-owned round trip through independent gzip decoder");
}

fn gzip_rejection_checks(directory: u8*): void {
    var encoded: ByteBuffer = default; var decoded: ByteBuffer = default; var path: ByteBuffer = default;
    defer bytes_dispose(&encoded); defer bytes_dispose(&decoded); defer bytes_dispose(&path);
    var input = "123456789"; var length = strlen(input);
    utility_check(gzip_compress(input, length, &encoded) && tool_join(&path, directory, "malformed.gz")
        && bytes_assign_text(&decoded, input, length), "prepare gzip rejection control");
    var trailer = encoded.length - GzipWordBytes * 2;
    var retained = decoded.data;
    for (var cut: usize = 0; cut < encoded.length; cut++) {
        utility_check(driver_write_file(path.data, encoded.data, cut)
            && gzip_reference(path.data, length, &decoded) != 0
            && decoded.data == retained && decoded.length == length
            && utility_equal(decoded.data, input, length), "truncated gzip rejected without partial publication");
    }
    // Reject a reserved block type and then a bad checksum, preserving the good bytes.
    var offsets: usize[2]; offsets[0] = GzipHeaderBytes; offsets[1] = trailer;
    for (var at: usize = 0; at < sizeof(decltype(offsets)) / sizeof(usize); at++) {
        var offset = offsets[at];
        var saved = encoded.data[offset];
        encoded.data[offset] = offset == GzipHeaderBytes ? 7 : saved ^ 1;
        utility_check(driver_write_file(path.data, encoded.data, encoded.length)
            && gzip_reference(path.data, length, &decoded) != 0 && decoded.data == retained
            && utility_equal(decoded.data, input, length), "malformed gzip rejected without partial publication");
        encoded.data[offset] = saved;
    }
    utility_check(driver_write_file(path.data, encoded.data, encoded.length)
        && gzip_reference(path.data, length, &decoded) == 0 && decoded.length == length
        && utility_equal(decoded.data, input, length), "reference decoder recovers after malformed inputs");
}

export fn main(argc: i32, argv: u8**): i32 {
    var required: i32 = 2; var with_payload: i32 = 3; var usage: i32 = 2;
    if argc != required && argc != with_payload { puts("Supply a corpus directory and optional real support archive"); return usage; }
    var input: ByteBuffer = default; defer bytes_dispose(&input);
    utility_check(gzip_fixed_cases(u8*, argv[1], gzip_fixture), "build fixed gzip corpus");
    var seed = GzipTestSeed;
    for (var trial: usize = 0; trial < GzipSeededTrials; trial++) {
        utility_check(gzip_seeded_input(&input, &seed), "build seeded gzip input");
        var name: ByteBuffer = default; defer bytes_dispose(&name);
        utility_check(bytes_append(&name, "seeded_", strlen("seeded_"))
            && host_json_unsigned(&name, convert(u64, trial)) && host_text_terminate(&name), "seeded corpus name");
        gzip_fixture(argv[1], name.data, &input);
    }
    gzip_rejection_checks(argv[1]);
    if argc == with_payload {
        var payload_limit: usize = 67108864;
        utility_check(tool_read_file(argv[2], payload_limit, &input), "read real support payload");
        gzip_fixture(argv[1], "support", &input);
    }
    puts("Gzip corpus, deterministic/aliased publication, reference round trips and malformed checks passed");
    return 0;
}
