import tower;
import driver_c_tools;
import driver;
import .host.driver_support;
import .library.bytes_types;
import .library.bytes_interface;

fn driver_c_fixture(root: u8*, directory: u8*, name: u8*): ByteBuffer {
    var path: ByteBuffer = default; var source: ByteBuffer = default;
    defer bytes_dispose(&path);
    driver_check(driver_text(&path, root) && driver_text(&path, directory)
        && driver_text(&path, name) && driver_text(&path, ".tower") && host_text_terminate(&path)
        && driver_read_file(path.data, &source) && host_text_terminate(&source), "read required C fixture");
    return source;
}
