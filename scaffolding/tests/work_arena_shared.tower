import tower;
import .library.work_arena;
import .library.work_budget;
import .library.work_budget_types;
import .library.work_pool;
import .host.memory;
import .host.work_linux;
import .host.work_dispatch;

extern fn pthread_self(): usize;

struct ArenaValue { index: usize; owner: usize; first: u64; last: u64; }
struct ArenaJob {
    arena: WorkArena;
    entered: void*;
    release: void*;
    first: ArenaValue*;
    last: ArenaValue*;
    ordinal: usize;
    thread: usize;
    cancelled: bool;
    denied: bool;
    success: bool;
}

fn shared_arena_check(ok: bool): void {
    if !ok { trap("Concurrent stable chunk regression", 0); }
}

export fn work_kernel_execute(payload: void*): void {
    var job = bits(ArenaJob*, payload);
    job.thread = pthread_self();
    job.first = bits(ArenaValue*, work_arena_allocate(&job.arena, sizeof(ArenaValue), alignof(ArenaValue)));
    shared_arena_check(job.first != null);
    *job.first = init(ArenaValue) {owner: job.ordinal, first: 17, last: 29, ..default};
    job.last = job.first;
    work_signal_post(job.entered);
    work_signal_wait(job.release);
    if job.cancelled { job.success = true; return; }
    if job.denied {
        var output = bits(u8*, job.first);
        job.success = work_arena_allocate_result(&job.arena, 4096, 8, &output) == WorkBudgetError.Capacity
            && output == bits(u8*, job.first);
        return;
    }
    for(var i: usize = 1; i < 2048; i++) {
        var value = bits(ArenaValue*, work_arena_allocate(&job.arena, sizeof(ArenaValue), alignof(ArenaValue)));
        if value == null { return; }
        *value = init(ArenaValue) {index: i, owner: job.ordinal, first: 17, last: 29};
        job.last = value;
        if job.first.index != 0 || job.first.owner != job.ordinal || job.first.last != 29 { return; }
    }
    job.success = true;
}

fn shared_arenas(cancelled: bool, denied: bool): void {
    var gate = work_signal_open();
    var entered = work_signal_open();
    var release = work_signal_open();
    shared_arena_check(gate != null && entered != null && release != null);
    defer work_signal_close(gate); defer work_signal_close(entered); defer work_signal_close(release);
    work_signal_post(gate);
    var budget: WorkBudget = default;
    var initial = 4 * compiler_buffer_allocation_size(4096);
    shared_arena_check(work_budget_init(&budget, 4, denied ? initial : 524288, 1));
    shared_arena_check(work_budget_synchronize(&budget, gate, work_signal_wait, work_signal_post));
    var joined: WorkArena = default;
    shared_arena_check(work_arena_init(&joined, &budget, 4096));
    var jobs: ArenaJob[4] = default;
    var lanes: WorkReservation[4] = default;
    var pool: WorkPool = default;
    shared_arena_check(work_pool_open(&pool, 4) && pool.threaded && pool.count == 4);
    for(var i: usize = 0; i < 4; i++) {
        jobs[i].ordinal = i + 1;
        jobs[i].entered = entered;
        jobs[i].release = release;
        jobs[i].denied = denied;
        shared_arena_check(work_arena_init(&jobs[i].arena, &budget, 4096));
        shared_arena_check(work_budget_reserve(&budget, 1, 1, 0, &lanes[i]));
        shared_arena_check(work_pool_submit(&pool, bits(void*, &jobs[i])));
    }
    for(var i: usize = 0; i < 4; i++) { work_signal_wait(entered); }
    var state: WorkBudgetSnapshot;
    shared_arena_check(work_budget_snapshot(&budget, &state) && state.used_bytes == initial && state.used_lanes == 4);
    shared_arena_check(work_pool_receive(&pool, false) == null);
    for(var i: usize = 0; i < 4; i++) { jobs[i].cancelled = cancelled; }
    for(var i: usize = 0; i < 4; i++) { work_signal_post(release); }
    while pool.running != 0 { work_pool_receive(&pool, true); }
    work_pool_close(&pool);
    for(var i: usize = 0; i < 4; i++) {
        shared_arena_check(jobs[i].success && jobs[i].thread != pthread_self());
        for(var j: usize = 0; j < i; j++) { shared_arena_check(jobs[i].thread != jobs[j].thread); }
        shared_arena_check(work_budget_release(&budget, &lanes[i]));
        shared_arena_check(work_arena_append(&joined, &jobs[i].arena));
        work_arena_dispose(&jobs[i].arena);
        shared_arena_check(jobs[i].first.index == 0 && jobs[i].first.owner == i + 1);
        shared_arena_check(jobs[i].last.index == (cancelled || denied ? 0 : 2047) && jobs[i].last.last == 29);
    }
    var snapshot: WorkArenaSnapshot;
    shared_arena_check(work_arena_snapshot(&joined, &snapshot) && work_budget_snapshot(&budget, &state));
    shared_arena_check(state.used_lanes == 0 && state.used_bytes == snapshot.retained
        && snapshot.payload == 4 * (cancelled || denied ? 1 : 2048) * sizeof(ArenaValue));
    shared_arena_check(!work_budget_dispose(&budget));
    work_arena_dispose(&joined);
    shared_arena_check(work_budget_snapshot(&budget, &state) && state.used_bytes == 0 && state.live == 0);
    shared_arena_check(work_budget_dispose(&budget));
}

export fn main(argc: i32, argv: u8**): i32 {
    shared_arenas(false, false);
    shared_arenas(true, false);
    shared_arenas(false, true);
    print(0);
    return 0;
}
