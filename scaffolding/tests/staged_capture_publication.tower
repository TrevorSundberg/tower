import tower;
import execution_support;
import utility_checks;
import staged_capture_identity;
import .compiler.semantic_program_types;
import .compiler.semantic_context_types;
import .compiler.foundation_types;
import .compiler.interpreter_context_types;

import .compiler.semantic_known_types;
import .compiler.semantic_evaluation_types;
import .compiler.semantic_work_ids;
import .compiler.grammar_types;
import .library.work_graph;

extern fn capture_publish_original(job: SemanticKnownWork*): void;
extern fn compiler_world_grammar(world: void*): CompilerGrammarCache*;
extern fn sem_evaluation_get(c: SemanticContext*, subject: void*): SemanticEvaluation*;
extern fn sem_find(table: SemanticTable*, name: u8*, owner: void*): SemanticEntry*;
extern fn compiler_node_world(node: void*): void*;
extern fn sem_member(node: void*, name: u8*): void*;
extern fn sem_parent(node: void*): void*;
extern fn entity_component_get(node: void*, kind: void*): void*;
extern fn entity_component_data(component: void*): void*;

export fn capture_observe(world: void*, check: CaptureCheck*): void {
    compiler_world_grammar(world).observer.context = bits(void*, check);
}

fn capture_declaration(c: SemanticContext*, path: u8*, name: u8*): void* {
    var owner = sem_member(c.program.modules.scopes, path);
    utility_check(owner != null, "Capture source module");
    var entry = sem_find(c.globals, name, owner);
    utility_check(entry != null && entry.value != null, "Module-owned source declaration");
    return entry.value;
}

fn capture_depends(graph: WorkGraph*, consumer: usize, producer: usize): bool {
    var edge = work_task(graph, consumer).dependencies;
    while edge != 0 {
        var dependency = &graph.edges.data[edge - 1];
        if dependency.dependency == producer { return true; }
        edge = dependency.next_dependency;
    }
    return false;
}

fn capture_from_salt(c: SemanticContext*, stage: SemanticEvaluation*, salt: void*): bool {
    var graph = &c.queries;
    var id = work_find(graph, salt, convert(u32, SemanticQuery.CaptureInput), 0);
    if id == 0 || !capture_depends(graph, stage.ticket.task, id) { return false; }
    var task = work_task(graph, id);
    if !task.demanded || task.state != WorkState.Succeeded { return false; }
    var input = bits(IMValueInput*, entity_component_data(entity_component_get(salt, c.value_inputs)));
    // Required evaluation reads producer. The optional known_producer can be a different job.
    if input == null || input.owner != null || input.producer == null || sem_parent(input.producer) != salt { return false; }
    var value = sem_evaluation_get(c, input.producer);
    return value != null && value.capture_order && value.capture_ordinal == input.ordinal
        && value.literal == input.producer && !value.inferred && value.ready.ready
        && !value.ready.failed && sem_get(value.literal).bits == 23 && capture_depends(graph, id, value.ticket.task);
}

// Only the root job inspects this world's receipt. Its snapshot is frozen through
// the join, before KnownPublish replaces reads with their published literals.
export fn semantic_known_publish_kernel(job: SemanticKnownWork*): void {
    var c = job.context;
    if job.subject == c.program.root {
        var world = compiler_node_world(job.subject);
        var check = bits(CaptureCheck*, compiler_world_grammar(world).observer.context);
        utility_check(check != null && !check.observed, "One joined evaluation frontier per fresh compile");
        var selected = capture_declaration(c, check.entry, "selected");
        var salt = capture_declaration(c, check.provider, "salt");
        var model = capture_declaration(c, check.provider, "model");
        var stage = sem_evaluation_get(c, sem_get(selected).value);
        utility_check(stage != null && !stage.inferred && stage.ready.ready && !stage.ready.failed, "Completed required selected initializer");
        check.salt = capture_from_salt(c, stage, salt);
        var id = work_find(&c.queries, model, convert(u32, SemanticQuery.CaptureInput), 0);
        check.model_demanded = id != 0 && work_task(&c.queries, id).demanded;
        check.observed = true;
    }
    capture_publish_original(job);
}
