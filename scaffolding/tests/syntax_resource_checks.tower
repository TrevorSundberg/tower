extern fn tower_test_buffer_fail_next(): void;
extern fn strlen(text: u8*): usize;
extern fn strcmp(left: u8*, right: u8*): i32;
extern fn printf(format: u8*, value: u32): i32;
extern fn tower_test_buffer_count(): usize;
extern fn syntax_reset(session: void*, source: u8*, module: void*): void;
extern fn syntax_destroy(session: void*): void;
extern fn syntax_get_error(session: void*): u8*;
extern fn syntax_source_retain(source: SyntaxSource*): void;
extern fn syntax_source_release(source: SyntaxSource*): void;

extern fn compiler_world_create_result(workers: usize, budget: WorkBudget*, world: void**): WorkBudgetError;
extern fn compiler_world_dispose(world: void*): bool;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_type(world: void*, kind: u32): void*;
extern fn compiler_world_component(world: void*, node: void*, kind: u32): void*;
extern fn entity_component_from_data(data: u8*): EntityComponent*;
extern fn entity_owned_page(data: u8*): EntityComponentPage*;
extern fn entity_create(store: void*): void*;
extern fn entity_retain(node: void*): usize;
extern fn entity_release(node: void*): usize;
extern fn entity_attach(node: void*, parent: void*, name: u8*): bool;
extern fn entity_take_last_child(parent: void*): void*;
extern fn syntax_expansion_trace(rule: u8*, start: usize, end: usize, invocation: void*): void*;
extern fn syntax_expansion_origin_result(trace: void*, node: void*, source: void*, generated: bool): WorkBudgetError;
extern fn syntax_trace_release(trace: void*): void;
extern fn entity_view_open(node: void*): void*;
extern fn entity_view_close(view: void*): void;
extern fn syntax_session_allocate_result(world: void*, environment: void*, error: WorkBudgetError*): SyntaxSession*;
extern fn syntax_session_inputs_reset(value: SyntaxSessionInputs*, source: u8*, length: usize, mode: u32, module: void*): bool;
extern fn syntax_session_inputs_reset_result(value: SyntaxSessionInputs*, source: u8*, length: usize, mode: u32, module: void*): WorkBudgetError;
extern fn syntax_session_resource_error(session: void*): WorkBudgetError;
extern fn syntax_get_origin(node: void*): SyntaxOrigin*;
extern fn expansion_copy_node(state: ExpansionState*, source: void*, copied: bool): void*;
extern fn expansion_splice(state: ExpansionState*, trace: void*, node: void*, work: ExpansionWork*): bool;
