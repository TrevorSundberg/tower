extern fn frontend_modules_create(): void*;
extern fn frontend_modules_destroy(modules: void*): void;
extern fn frontend_modules_configure(modules: void*, source: u8*, library: u8*): void;

// These fixtures are complete files. Select their language explicitly while
// retaining the independently frozen body text and source-map expectations.
fn format_test_input(body: u8*, source: vector(u8)*): void {
    var language = "import foundation;\n";
    utility_check(storage_assign(source, language, strlen(language)), "Formatter explicit language import");
    for(var i: usize = 0; body[i] != 0; i++) {
        utility_check(vector_push(source, body[i]), "Formatter fixture body");
    }
    utility_check(vector_push(source, 0), "Formatter fixture terminator");
    --source.length;
}

fn format_test_imported_fixture(id: usize, actual: FormatResult*): void {
    var language = "import foundation;\n";
    var prefix = id == 6 || id == 14 ? "import foundation;\n\n" : language;
    var length = strlen(prefix);
    var source_offset = strlen(language);
    utility_check(actual.text.length >= length && utility_equal(actual.text.data, prefix, length)
        && actual.spans.length != 0, "Formatter explicit import text");
    format_fixture_span(actual, 0, 0, source_offset, 0);
    var body: FormatResult = default;
    defer format_dispose(&body);
    utility_check(storage_assign(&body.text, actual.text.data + length, actual.text.length - length), "Formatter reference body");
    for(var i: usize = 1; i < actual.spans.length; i++) {
        var span = actual.spans.data[i];
        utility_check(span.begin >= length && span.end >= length && span.source >= source_offset, "Formatter imported span bounds");
        span.begin -= length;
        span.end -= length;
        span.source -= source_offset;
        utility_check(vector_push(&body.spans, span), "Formatter reference spans");
    }
    format_fixture_check(id, &body);
}

struct TestFormatComment { start: usize; end: usize; }
extern fn format_source(out: FormatResult*, roots: void**, count: usize, source: u8*, length: usize,
    comments: TestFormatComment*, comment_count: usize, syntax: void*, foundation: void*, match_kind: void*): void;

fn format_test_source(input: u8*, out: FormatResult*): void {
    var session = syntax_create(input, null);
    utility_check(session is not null, "Formatter source session");
    defer syntax_destroy(session);
    loop { var root = syntax_next(session); if root is null { break; } tower_node_release_ref(root); }
    if syntax_get_error(session)[0] != 0 { puts(syntax_get_error(session)); puts(input); }
    utility_check(syntax_get_error(session)[0] == 0, "Formatter source parsed");
    var error: u8*;
    var ready = syntax_format_into(session, out, &error);
    if error[0] != 0 { puts(error); }
    utility_check(ready && error[0] == 0, "Formatter shared source result has no error");
}
fn format_test_compile_bytes(input: u8*, length: usize, program: SemanticProgram*, modules: void*): void {
    semantic_initialize(program, tower_node_create(), 4);
    var source: FrontendSource; source.data = input; source.length = length;
    frontend_compile_sources(program, &source, 1, modules);
    if program.error.length != 0 {
        utility_check(vector_push(&program.error, 0), "Formatter compile diagnostic terminator");
        --program.error.length;
        puts(program.error.data);
    }
    utility_check(program.error.length == 0, "Formatter Foundation fixture compiles");
}
fn format_test_compile(input: u8*, program: SemanticProgram*, modules: void*): void { format_test_compile_bytes(input, strlen(input), program, modules); }
fn format_test_program_dispose(program: SemanticProgram*): void {
    semantic_program_dispose(program); tower_node_release_ref(program.root);
}
fn format_test_entity(out: FormatResult*, root: void*): void {
    format_entity(out, root, syntax_component_type(), null, parser_match_get_type());
}
fn format_test_equal(actual: FormatResult*, oracle: FormatResult*, spans: bool): void {
    utility_check(!actual.failed && !oracle.failed && actual.text.length == oracle.text.length
        && utility_equal(actual.text.data, oracle.text.data, actual.text.length), "Formatter exact canonical text");
    if spans {
        utility_check(actual.spans.length == oracle.spans.length, "Formatter exact span count");
        for (var index: usize = 0; index < actual.spans.length; ++index) {
            var a = &actual.spans.data[index]; var b = &oracle.spans.data[index];
            utility_check(a.begin == b.begin && a.end == b.end && a.source == b.source, "Formatter exact ordered span triples");
        }
    }
}
fn format_test_source_fixture(id: usize, input: u8*): void {
    var source: vector(u8) = default;
    defer vector_dispose(&source);
    if id != 8 { format_test_input(input, &source); input = source.data; }
    var actual: FormatResult; fill(&actual, 0, sizeof(FormatResult)); defer format_dispose(&actual);
    format_test_source(input, &actual);
    if id == 8 { format_fixture_check(id, &actual); }
    else { format_test_imported_fixture(id, &actual); }
    var again: FormatResult; fill(&again, 0, sizeof(FormatResult)); defer format_dispose(&again);
    format_test_source(actual.text.data, &again);
    format_test_equal(&actual, &again, false);
}
fn format_test_foundation_fixture(id: usize, input: u8*, modules: void*): void {
    var source: vector(u8) = default;
    defer vector_dispose(&source);
    format_test_input(input, &source);
    var program: SemanticProgram; format_test_compile(source.data, &program, modules); defer format_test_program_dispose(&program);
    var actual: FormatResult; fill(&actual, 0, sizeof(FormatResult)); defer format_dispose(&actual);
    format_test_entity(&actual, program.root);
    format_fixture_check(id, &actual);
    utility_check(vector_push(u8, &actual.text, 0), "Formatter Foundation terminator"); --actual.text.length;
    var rebuilt: SemanticProgram; format_test_compile_bytes(actual.text.data, actual.text.length, &rebuilt, modules); defer format_test_program_dispose(&rebuilt);
    var again: FormatResult; fill(&again, 0, sizeof(FormatResult)); defer format_dispose(&again);
    format_test_entity(&again, rebuilt.root);
    format_test_equal(&actual, &again, false);
}
fn format_test_generated(): void {
    var entity = tower_node_create(); defer tower_node_release_ref(entity);
    var value = tower_node_create(); defer tower_node_release_ref(value);
    var declaration = semantic_component_attach(entity, core_component_type(), KDeclare);
    var literal = semantic_component_attach(value, core_component_type(), KString);
    var name: u8[9]; name[0] = 97; name[1] = 0; name[2] = 10; name[3] = 13; name[4] = 9; name[5] = 96; name[6] = 92; name[7] = 195; name[8] = 169;
    utility_check(storage_assign(&declaration.name, &name[0], 9), "Generated name including NUL/backtick/UTF-8");
    var text: u8[11]; copy(&text[0], "quote'\\\n\r\t", 10); text[10] = 0;
    utility_check(storage_assign(&literal.name, &text[0], 11), "Generated literal including NUL/quote/backslash");
    declaration.type.scalar = SU8; declaration.type.pointers = 1; declaration.value = value;
    var actual: FormatResult; fill(&actual, 0, sizeof(FormatResult)); defer format_dispose(&actual);
    format_test_entity(&actual, entity);
    utility_check(!actual.failed && actual.spans.length == 1, "Generated entities need no fabricated provenance");
    format_fixture_check(13, &actual);
}
struct FormatConstructorCase { op: u32; left: void*; right: void*; second_bits: u64; wanted: u8*; }

fn format_test_type_constructors(): void {
    var entity = tower_node_create(); defer tower_node_release_ref(entity);
    var left = tower_node_create(); defer tower_node_release_ref(left);
    var right = tower_node_create(); defer tower_node_release_ref(right);
    var reference = tower_node_create(); defer tower_node_release_ref(reference);
    var operation = semantic_component_attach(entity, core_component_type(), KTypeConstruct);
    var width = semantic_component_attach(left, core_component_type(), KOperand);
    var second = semantic_component_attach(right, core_component_type(), KOperand);
    var type = semantic_component_attach(reference, core_component_type(), KTypeReference);
    operation.type.scalar = SType;
    width.type.scalar = SU64; width.constant = true; width.bits = 32;
    second.type.scalar = SU64; second.constant = true;
    type.type.scalar = SType; type.element.scalar = SI32;
    var cases: FormatConstructorCase[8];
    cases[0] = { op: convert(u32, TypeConstructionKind.Integer), left: left, right: right, second_bits: 0, wanted: "integer_type(convert(integer_type(64, 0), 32), convert(integer_type(64, 0), 0));\n" };
    cases[1] = { op: convert(u32, TypeConstructionKind.Floating), left: left, right: null, second_bits: 0, wanted: "float_type(convert(integer_type(64, 0), 32));\n" };
    cases[2] = { op: convert(u32, TypeConstructionKind.Pointer), left: reference, right: null, second_bits: 0, wanted: "pointer_type(type_value(integer_type(32, 1)));\n" };
    cases[3] = { op: convert(u32, TypeConstructionKind.Array), left: reference, right: right, second_bits: 8, wanted: "array_type(type_value(integer_type(32, 1)), convert(integer_type(64, 0), 8));\n" };
    cases[4] = { op: ~convert(u32, 0), left: left, right: right, second_bits: 0, wanted: null };
    cases[5] = { op: convert(u32, TypeConstructionKind.Integer), left: null, right: right, second_bits: 0, wanted: null };
    cases[6] = { op: convert(u32, TypeConstructionKind.Integer), left: left, right: null, second_bits: 0, wanted: null };
    cases[7] = { op: convert(u32, TypeConstructionKind.Floating), left: left, right: right, second_bits: 0, wanted: null };
    for(var index: usize = 0; index < sizeof(decltype(cases)) / sizeof(FormatConstructorCase); index++) {
        var test = &cases[index];
        operation.op = test.op;
        operation.left = test.left;
        operation.right = test.right;
        second.bits = test.second_bits;
        var actual: FormatResult = default;
        defer format_dispose(&actual);
        format_test_entity(&actual, entity);
        if test.wanted != null { format_fixture_text(&actual, test.wanted, 1); }
        else { utility_check(actual.failed, "Malformed type constructor formatting fails"); }
    }
}

fn format_test_comments(): void {
    var input: u8* = "import foundation;\n// header\nfn f():void { /* body */ print(1); /* after */ } // tail\n";
    var session = syntax_create(input, null); defer syntax_destroy(session);
    var roots: vector(void*); fill(&roots, 0, sizeof(vector(void*)));
    defer { for (var index: usize = 0; index < roots.length; ++index) { tower_node_release_ref(roots.data[index]); } vector_dispose(void*, &roots); }
    loop { var root = syntax_next(session); if root is null { break; } utility_check(vector_push(void*, &roots, root), "Comment roots retained"); }
    utility_check(syntax_get_error(session)[0] == 0, "Comment fixture parsed");
    // Exact lexer-derived ranges from the original fixture, also checked by the
    // syntax_format route which obtains its own lexer comments independently.
    var comments: TestFormatComment[4];
    var comment_count = sizeof(decltype(comments)) / sizeof(TestFormatComment);
    comments[0].start = 0; comments[0].end = 9;
    comments[1].start = 24; comments[1].end = 34;
    comments[2].start = 45; comments[2].end = 56;
    comments[3].start = 59; comments[3].end = 66;
    var source_offset = strlen("import foundation;\n");
    for(var i: usize = 0; i < comment_count; i++) {
        comments[i].start += source_offset;
        comments[i].end += source_offset;
    }
    var oracle: FormatResult; fill(&oracle, 0, sizeof(FormatResult)); defer format_dispose(&oracle);
    format_test_source(input, &oracle);
    format_test_imported_fixture(14, &oracle);
    for (var order: usize = 0; order < 2; ++order) {
        var actual: FormatResult; fill(&actual, 0, sizeof(FormatResult));
        format_source(&actual, roots.data, roots.length, input, strlen(input), &comments[0], comment_count, syntax_component_type(), null, parser_match_get_type());
        format_test_equal(&actual, &oracle, true); format_dispose(&actual);
        for (var index: usize = 0; index < comment_count / 2; ++index) {
            var back = comment_count - 1 - index;
            var saved = comments[index];
            comments[index] = comments[back];
            comments[back] = saved;
        }
    }
    // Keep the caller's unsorted order for the complete original failure sweep.
    for (var index: usize = 0; index < comment_count / 2; ++index) {
        var back = comment_count - 1 - index;
        var saved = comments[index];
        comments[index] = comments[back];
        comments[back] = saved;
    }
    var buffers = tower_test_buffer_count();
    for (var failure: usize = 0; failure < 32; ++failure) {
        var actual: FormatResult; fill(&actual, 0, sizeof(FormatResult));
        tower_test_buffer_fail_after(failure);
        format_source(&actual, roots.data, roots.length, input, strlen(input), &comments[0], comment_count, syntax_component_type(), null, parser_match_get_type());
        tower_test_buffer_fail_after(~convert(usize, 0));
        if !actual.failed { format_test_equal(&actual, &oracle, true); }
        format_dispose(&actual);
        utility_check(actual.text.length == 0 && actual.spans.length == 0 && tower_test_buffer_count() == buffers, "Source failure cleanup releases all partial text/spans");
    }
}
fn format_test_failures(modules: void*): void {
    var program: SemanticProgram; format_test_compile("import foundation;fn f():i32 { return 42; } var x:i32=f();", &program, modules); defer format_test_program_dispose(&program);
    var oracle: FormatResult; fill(&oracle, 0, sizeof(FormatResult)); defer format_dispose(&oracle);
    format_test_entity(&oracle, program.root); format_fixture_check(15, &oracle);
    var buffers = tower_test_buffer_count();
    for (var failure: usize = 0; failure < 32; ++failure) {
        var actual: FormatResult = default;
        tower_test_buffer_fail_after(failure);
        syntax_format_node(program.root, &actual);
        tower_test_buffer_fail_after(~convert(usize, 0));
        if actual.failed {
            utility_check(actual.text.length == 0 && actual.spans.length == 0, "Formatter failure publishes empty source and spans");
        } else {
            format_test_equal(&actual, &oracle, true);
        }
        format_dispose(&actual);
        utility_check(tower_test_buffer_count() == buffers, "Foundation failure cleanup releases all partial text/spans");
    }
}
export fn formatter_tests(resource_root: u8*): void {
    var modules = frontend_modules_create();
    utility_check(modules is not null, "Formatter module environment");
    var slot = syntax_host_environment(compiler_host_world());
    var previous = *slot;
    *slot = modules;
    defer { *slot = previous; frontend_modules_destroy(modules); }
    frontend_modules_configure(modules, "formatter_fixture.tower", resource_root);
    format_test_source_fixture(0, "// before\nvar x:i32=1; // inline\n\n/* block */ fn f(a:i32*):i32{return *a;} // after\n");
    format_test_source_fixture(1, "parse Statement |= 'show' $x:CoreOperand ';' => replace { print($x); }; show 42;");
    format_test_source_fixture(2, "parse Prefix = '~~' Identifier; parse Statement |= 'prefix' Prefix ';'; prefix ~~ x;");
    format_test_source_fixture(3, "parse Statement |= 'postfix' Identifier '!!' ';'; postfix x !!;");
    format_test_source_fixture(4, "token Context = /abc/ when expected as identifier; parse Extra = Context; parse Statement = Extra ';'; abc;");
    format_test_source_fixture(5, "var `if`:i32=1; var `with space`:i32=`if`; print(`with space`);");
    format_test_source_fixture(6, "struct Pair{a:i32;b:u8;} fn f(p:Pair*):i32{if true{return p.a;}else{return 0;}}");
    format_test_source_fixture(7, "var a:i32[2]; var p:i32*=&a[0]; *p=1; var x:i32=*p + a[1];");
    format_test_source_fixture(8, "// only comment\n\n/* final */");
    format_test_foundation_fixture(9, "var lo:i64=-9223372036854775808; var hi:u64=18446744073709551615; var b:bool=true; var p:i32*=null;", modules);
    format_test_foundation_fixture(10, "struct S { x:i32; } extern fn ext(a:i32):i32; export fn f(a:i32):i32 { var x:i32=ext(a); return x; }", modules);
    format_test_foundation_fixture(11, "var p:i32*=alloc(i32,2); p=realloc(i32,p,3); fill(p,0,12); copy(p,p,12); var x:usize=sizeof(i32); x=alignof(i32); free(p);", modules);
    format_test_foundation_fixture(12, "var x:u32=convert(u32,1); var y:i32=bits(i32,x); loop { if true { break; } else { continue; } } print(y);", modules);
    format_test_generated(); format_test_type_constructors(); format_test_comments(); format_test_failures(modules);
    puts("Formatter: exact legacy text/spans, Foundation round trips, generated names and failure cleanup passed.");
}
