import tower;
import format_suite_test;
import format_fixture;
import utility_checks;

export fn formatter_tests(resource_root: u8*): void {
    var fixture = format_fixture_open(resource_root);
    defer format_fixture_close(&fixture);
    format_test_declaration_comments(&fixture);
    format_test_replacement(&fixture);
    format_test_prefix(&fixture);
    format_test_postfix(&fixture);
    format_test_contextual_token(&fixture);
    format_test_quoted_names(&fixture);
    format_test_structure(&fixture);
    format_test_pointers(&fixture);
    format_test_comments_only(&fixture);
    format_test_scalar_limits(&fixture);
    format_test_linkage(&fixture);
    format_test_memory_operations(&fixture);
    format_test_conversions(&fixture);
    format_test_generated(&fixture);
    format_test_type_constructors();
    format_test_comments(&fixture);
    format_test_failures(&fixture);
    puts("Formatter: exact legacy text/spans, Foundation round trips, generated names and failure cleanup passed.");
}
