import tower;

fn runtime_abi_benchmark(): i32 {
    var pointers: u8*[64];
    var sum: u64 = 0;
    var round: usize = 0;
    while round < 10000 {
        var i: usize = 0;
        while i < 64 {
            var size = i *17;
            size = size + 1;
            var pointer = alloc(u8, size);
            var failed = pointer == null;
            if failed {
                return 11;
            }
            pointers[i] = pointer;
            pointer[0] = convert(u8, i);
            i = i + 1;
        }
        i = 0;
        while i < 64 {
            var pointer = pointers[i];
            sum = sum + convert(u64, pointer[0]);
            free(pointer);
            i = i + 1;
        }
        round = round + 1;
    }
    var failed = sum != 20160000;
    if failed {
        return 12;
    }
    return 0;
}
