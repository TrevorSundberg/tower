import tower;
import .backend.bindings;
import .backend.context;
import .backend.import_bindings;
import .backend.target;
import .backend.lowering;
import .backend.pipeline;
import .backend.import_instructions;
import .compiler.foundation_tags;

extern fn LLVMStructTypeInContext(context: void*, elements: void**, count: u32, packed: i32): void*;
extern fn LLVMBuildExtractValue(builder: void*, aggregate: void*, index: u32, name: u8*): void*;
extern fn LLVMVectorType(element: void*, count: u32): void*;
extern fn strcmp(left: u8*, right: u8*): i32;

var OverflowEqual: u32 = 32;
var OverflowNotEqual: u32 = 33;
struct OverflowCase { left: u64; right: u64; product: u64; overflow: bool; }

// Compare independent expected arguments, never the reconstruction algorithm.
// Every extraction is a separate SSA value; branches exercise dominating-call
// assignments to users outside the call's block as well as repeated users.
fn overflow_fixture_mismatch(b: Backend*, pair: void*, probe: void*, mode: u8*): void* {
    var bad = LLVMConstInt(LLVMIntTypeInContext(b.context, 1), 0, 0);
    if strcmp(mode, "flag") != 0 {
        var product = LLVMBuildExtractValue(b.builder, pair, 0, "product");
        bad = LLVMBuildOr(b.builder, bad,
            LLVMBuildICmp(b.builder, OverflowNotEqual, product, LLVMGetParam(probe, 2), ""), "");
    }
    if strcmp(mode, "product") != 0 {
        var flag = LLVMBuildExtractValue(b.builder, pair, 1, "overflow");
        bad = LLVMBuildOr(b.builder, bad,
            LLVMBuildICmp(b.builder, OverflowNotEqual, flag, LLVMGetParam(probe, 3), ""), "");
    }
    return bad;
}

fn overflow_fixture_cases(b: Backend*, probe: void*, type: void*, cases: OverflowCase*, count: usize, wrong: bool): void* {
    var errors = LLVMConstInt(b.i32, 0, 0);
    for(var index: usize = 0; index < count; index++) {
        var row = &cases[index];
        var arguments: void*[4];
        arguments[0] = LLVMConstInt(type, row.left, 0);
        arguments[1] = LLVMConstInt(type, row.right, 0);
        arguments[2] = LLVMConstInt(type, wrong && index == 0 ? row.product ^ 1 : row.product, 0);
        arguments[3] = LLVMConstInt(LLVMIntTypeInContext(b.context, 1), row.overflow ? 1 : 0, 0);
        var result = backend_call_values(b, probe, &arguments[0], convert(u32, sizeof(decltype(arguments)) / sizeof(void*)));
        errors = LLVMBuildAdd(b.builder, errors, result, "");
    }
    return errors;
}

// Verifier-only LLVM construction retains calls with parameter operands. No
// optimizer can fold these tests to the expected output before reconstruction.
export fn backend_import_fixture_overflow(root: void*, target: u8*, width: u32, mode: u8*): Backend* {
    return overflow_fixture_open(root, target, width, mode, false);
}

// One deliberately incorrect expected argument, using the same generator/oracle.
export fn backend_import_fixture_overflow_wrong(root: void*, target: u8*, width: u32, mode: u8*): Backend* {
    return overflow_fixture_open(root, target, width, mode, true);
}

fn overflow_fixture_open(root: void*, target: u8*, width: u32, mode: u8*, wrong: bool): Backend* {
    var b = backend_open(target);
    if b == null { return null; }
    b.source_root = root;
    var program = sem_attach(root, KProgram);
    program.type.scalar = SVoid; program.type.pointer_bytes = b.pointer_bytes;
    backend_runtime_declarations(b);
    var type = LLVMIntTypeInContext(b.context, width);
    var flag_type = LLVMIntTypeInContext(b.context, 1);
    var name = width == 1 ? "llvm.umul.with.overflow.i1" : width == 8 ? "llvm.umul.with.overflow.i8"
        : width == 16 ? "llvm.umul.with.overflow.i16" : width == 32 ? "llvm.umul.with.overflow.i32"
        : width == 64 ? "llvm.umul.with.overflow.i64" : "llvm.umul.with.overflow.i128";
    if strcmp(mode, "vector") == 0 {
        type = LLVMVectorType(type, 2); flag_type = LLVMVectorType(LLVMIntTypeInContext(b.context, 1), 2);
        name = "llvm.umul.with.overflow.v2i8";
    }
    var fields: void*[2]; fields[0] = type; fields[1] = flag_type;
    var aggregate = LLVMStructTypeInContext(b.context, &fields[0], convert(u32, sizeof(decltype(fields)) / sizeof(void*)), 0);
    var operands: void*[2]; operands[0] = type; operands[1] = type;
    var intrinsic = LLVMAddFunction(b.module, name, LLVMFunctionType(aggregate, &operands[0], convert(u32, sizeof(decltype(operands)) / sizeof(void*)), 0));
    var main = LLVMAddFunction(b.module, "tower_main", LLVMFunctionType(LLVMVoidTypeInContext(b.context), null, 0, 0));
    var main_entry = LLVMAppendBasicBlockInContext(b.context, main, "entry");
    if strcmp(mode, "aggregate") == 0 || strcmp(mode, "vector") == 0 || width > 64 {
        LLVMPositionBuilderAtEnd(b.builder, main_entry);
        var arguments: void*[2]; arguments[0] = LLVMConstNull(type); arguments[1] = LLVMConstNull(type);
        var pair = backend_call_values(b, intrinsic, &arguments[0], convert(u32, sizeof(decltype(arguments)) / sizeof(void*)));
        // A valid LLVM aggregate consumer, deliberately outside our scalar
        // extract contract. No invalid index or malformed IR bypasses verifier.
        LLVMBuildStore(b.builder, pair, LLVMBuildAlloca(b.builder, aggregate, "pair_slot"));
        LLVMBuildRetVoid(b.builder);
    } else {
        var parameters: void*[4]; parameters[0] = type; parameters[1] = type;
        parameters[2] = type; parameters[3] = LLVMIntTypeInContext(b.context, 1);
        var probe = LLVMAddFunction(b.module, "overflow_probe", LLVMFunctionType(b.i32, &parameters[0], convert(u32, sizeof(decltype(parameters)) / sizeof(void*)), 0));
        var entry = LLVMAppendBasicBlockInContext(b.context, probe, "entry");
        var zero = LLVMAppendBasicBlockInContext(b.context, probe, "zero");
        var nonzero = LLVMAppendBasicBlockInContext(b.context, probe, "nonzero");
        LLVMPositionBuilderAtEnd(b.builder, entry);
        var arguments: void*[2]; arguments[0] = LLVMGetParam(probe, 0); arguments[1] = LLVMGetParam(probe, 1);
        var pair = backend_call_values(b, intrinsic, &arguments[0], convert(u32, sizeof(decltype(arguments)) / sizeof(void*)));
        var first = overflow_fixture_mismatch(b, pair, probe, mode);
        LLVMBuildCondBr(b.builder, LLVMBuildICmp(b.builder, OverflowEqual, arguments[0], LLVMConstInt(type, 0, 0), ""), zero, nonzero);
        var blocks: void*[2]; blocks[0] = zero; blocks[1] = nonzero;
        for(var index: usize = 0; index < sizeof(decltype(blocks)) / sizeof(void*); index++) {
            LLVMPositionBuilderAtEnd(b.builder, blocks[index]);
            var bad = LLVMBuildOr(b.builder, first, overflow_fixture_mismatch(b, pair, probe, mode), "");
            LLVMBuildRet(b.builder, LLVMBuildZExt(b.builder, bad, b.i32, ""));
        }
        LLVMPositionBuilderAtEnd(b.builder, main_entry);
        var errors: void* = null;
        if width == 1 {
            // Exhaustive unsigned one-bit multiplication truth table.
            var cases: OverflowCase[4] = default;
            cases[1] = {left: 0, right: 1, product: 0, overflow: false};
            cases[2] = {left: 1, right: 0, product: 0, overflow: false};
            cases[3] = {left: 1, right: 1, product: 1, overflow: false};
            errors = overflow_fixture_cases(b, probe, type, &cases[0], sizeof(decltype(cases)) / sizeof(OverflowCase), wrong);
        } else {
            var maximum = width == 64 ? ~convert(u64, 0) : (convert(u64, 1) << width) - 1;
            var half = convert(u64, 1) << (width / 2);
            // Factor identities: (half-1)(half+1)=2^width-1 fits;
            // half^2=2^width is the first out-of-range power, wraps to zero.
            // (max)^2 wraps to one. No quotient/guard oracle mirrors importer.
            var cases: OverflowCase[10] = default;
            cases[0] = {left: 0, right: maximum, product: 0, overflow: false};
            cases[1] = {left: maximum, right: 0, product: 0, overflow: false};
            cases[2] = {left: 1, right: 1, product: 1, overflow: false};
            cases[3] = {left: maximum, right: 1, product: maximum, overflow: false};
            cases[4] = {left: 1, right: maximum, product: maximum, overflow: false};
            cases[5] = {left: maximum, right: 2, product: maximum - 1, overflow: true};
            cases[6] = {left: half, right: half, product: 0, overflow: true};
            cases[7] = {left: half - 1, right: half + 1, product: maximum, overflow: false};
            cases[8] = {left: maximum / 2 + 1, right: 2, product: 0, overflow: true};
            cases[9] = {left: maximum, right: maximum, product: 1, overflow: true};
            errors = overflow_fixture_cases(b, probe, type, &cases[0], sizeof(decltype(cases)) / sizeof(OverflowCase), wrong);
        }
        var print_args: void*[3]; print_args[0] = LLVMConstInt(b.i32, convert(u64, SU32), 0);
        print_args[1] = LLVMBuildZExt(b.builder, errors, b.i64, "");
        print_args[2] = LLVMConstInt(b.i32, convert(u64, b.pointer_bytes), 0);
        backend_call_values(b, b.print_fn, &print_args[0], convert(u32, sizeof(decltype(print_args)) / sizeof(void*)));
        LLVMBuildRetVoid(b.builder);
    }
    if !backend_optimize(b, false) { backend_close(b); return null; }
    return b;
}

export fn backend_import_fixture_overflow_optimize(b: Backend*): bool {
    // The verifier-only constructor already owns one textual snapshot.
    LLVMDisposeMessage(b.optimized); b.optimized = null;
    return backend_optimize(b, true);
}

export fn backend_import_fixture_overflow_calls(b: Backend*): usize {
    var count: usize = 0;
    var function = LLVMGetFirstFunction(b.module);
    while function != null {
        var block = LLVMGetFirstBasicBlock(function);
        while block != null {
            var instruction = LLVMGetFirstInstruction(block);
            while instruction != null {
                if bi_multiply_overflow_call(instruction) { count++; }
                instruction = LLVMGetNextInstruction(instruction);
            }
            block = LLVMGetNextBasicBlock(block);
        }
        function = LLVMGetNextFunction(function);
    }
    return count;
}
