// Linux x64 observation ABI. Each invocation owns fresh worlds; filesystem
// caches may be warm. Timed work ends before reference execution/formatting.
struct UnitsProfileTime { seconds: i64; fraction: i64; }
struct UnitsProfileUsage {
    user: UnitsProfileTime;
    system: UnitsProfileTime;
    peak_rss: i64;
    shared_memory: i64; unshared_data: i64; unshared_stack: i64;
    minor_faults: i64; major_faults: i64; swaps: i64;
    block_inputs: i64; block_outputs: i64;
    messages_sent: i64; messages_received: i64; signals: i64;
    voluntary_switches: i64; involuntary_switches: i64;
}
struct UnitsProfileSpan { start: u64; end: u64; thread: usize; cpu_start: u64; cpu_end: u64; }
struct UnitsProfileEvents { spans: UnitsProfileSpan*; count: usize; phases: usize; }
var UnitsGrammarPhaseCount: usize = convert(usize, GrammarPhase.Count);
struct UnitsGrammarPhase {
    span: UnitsProfileSpan;
    depth: usize; calls: usize; work: usize; wall: u64; cpu: u64;
    kernel_wall: u64; kernel_cpu: u64; kernel_peak: usize; threads: usize;
    covered: u64; lane_ns: u64; observer_wall: u64; observer_cpu: u64;
}
var UnitsKernelKindCount: usize = convert(usize, CompilerKernelKind.Count);
struct UnitsGrammarObservation {
    phases: UnitsGrammarPhase[UnitsGrammarPhaseCount];
    jobs: UnitsProfileSpan[WorkPoolMaximumCapacity];
    semantic_jobs: UnitsProfileSpan*; semantic_kinds: usize*; semantic_capacity: usize;
    kernels: UnitsGrammarPhase[UnitsKernelKindCount];
    pool_before: usize; pool_creations: usize; pool_slots: usize;
}
var UnitsProfileMaximumUnits: usize = 32;
var UnitsProfileMaximumBodies: usize = 4096;
var UnitsProfileBodyBands: usize = 4;
var UnitsProfileTransientUnits: usize = 4;
var UnitsProfileFrontendPhase: usize = 0;
var UnitsProfileBackendPhase: usize = 1;
extern fn clock_gettime(clock: i32, out: UnitsProfileTime*): i32;
extern fn getrusage(who: i32, out: UnitsProfileUsage*): i32;
extern fn pthread_self(): usize;
extern fn host_json_unsigned(out: ByteBuffer*, value: u64): bool;
extern fn host_text_terminate(out: ByteBuffer*): bool;
extern fn frontend_units_observer(batch: void*, context: void*,
    callback: function(void, void*, CompilerQuery, usize, bool)): bool;
extern fn compiler_world_store(world: void*): void*;
extern fn entity_store_count(store: void*): usize;
extern fn entity_store_component_count(store: void*): usize;
extern fn frontend_units_create_bounded(count: usize, budget: usize, retained_bytes: usize, width: u32,
    revision: u64, profile: u64, bedrock: u8*, foundation: u8*, library: u8*): void*;
extern fn backend_units_create(frontend: void*, count: usize, budget: usize, target: u8*, library: bool, optimize: bool): void*;
extern fn backend_units_observer(batch: void*, context: void*, event: function(void, void*, usize, BackendPhase, bool)): bool;
extern fn backend_units_retain_ir(batch: void*, retain: bool): bool;
extern fn backend_units_close(batch: void*): void;
extern fn backend_units_step(batch: void*, wait: bool): bool;
extern fn backend_units_failed(batch: void*): usize;
extern fn backend_units_cancelled(batch: void*): bool;
extern fn backend_units_result(batch: void*, ordinal: usize): void*;
extern fn backend_units_error(batch: void*): u8*;
extern fn backend_bytes(backend: void*): u8*;
extern fn backend_size(backend: void*): usize;
extern fn fwrite(data: void*, size: usize, count: usize, file: void*): usize;
extern fn frontend_units_environment(batch: void*, ordinal: usize): void*;
extern fn frontend_modules_source(environment: void*, name: u8*, source: u8*, length: usize): bool;
extern fn frontend_modules_world(environment: void*): void*;
extern fn compiler_world_grammar(world: void*): CompilerGrammarCache*;

fn units_profile_thread_cpu(): u64 {
    var time: UnitsProfileTime;
    var thread_cpu_clock: i32 = 3; // Linux CLOCK_THREAD_CPUTIME_ID.
    units_check(clock_gettime(thread_cpu_clock, &time) == 0, "profile thread CPU clock");
    return convert(u64, time.seconds) * 1000000000 + convert(u64, time.fraction);
}

fn units_profile_clock(): u64 {
    var time: UnitsProfileTime;
    units_check(clock_gettime(1, &time) == 0, "profile monotonic clock");
    return convert(u64, time.seconds) * 1000000000 + convert(u64, time.fraction);
}

// One observer per world. Kernels write only their ordinal's slot; the owning
// coordinator reads/aggregates it after the dispatch joins. No observer lock.
fn units_profile_grammar(context: void*, phase: GrammarPhase, entering: bool, first: usize, second: usize): void {
    var observation = bits(UnitsGrammarObservation*, context);
    var index = convert(usize, phase);
    units_check(index < UnitsGrammarPhaseCount, "grammar profile phase");
    if phase == GrammarPhase.LookaheadKernel || phase == GrammarPhase.SemanticKernel {
        var semantic = phase == GrammarPhase.SemanticKernel;
        var capacity = semantic ? observation.semantic_capacity : sizeof(decltype(observation.jobs)) / sizeof(UnitsProfileSpan);
        units_check(first < capacity, "profile kernel ordinal");
        var job = semantic ? &observation.semantic_jobs[first] : &observation.jobs[first];
        if semantic && entering {
            units_check(second < UnitsKernelKindCount, "profile kernel kind");
            observation.semantic_kinds[first] = second;
        }
        if entering { job.start = units_profile_clock(); job.thread = pthread_self(); job.cpu_start = units_profile_thread_cpu(); }
        else { job.cpu_end = units_profile_thread_cpu(); job.end = units_profile_clock(); }
        return;
    }
    var entry = &observation.phases[index];
    var semantic = phase == GrammarPhase.SemanticDispatch;
    var wave = phase == GrammarPhase.PropagationWave || phase == GrammarPhase.ActionWave || semantic;
    if entering {
        entry.depth++;
        if entry.depth != 1 { return; }
        if wave {
            if semantic && first > observation.semantic_capacity {
                free(observation.semantic_jobs); free(observation.semantic_kinds);
                observation.semantic_jobs = alloc(UnitsProfileSpan, first);
                observation.semantic_kinds = alloc(usize, first);
                units_check(observation.semantic_jobs != null && observation.semantic_kinds != null, "semantic observer slots");
                observation.semantic_capacity = first;
            }
            var jobs = semantic ? observation.semantic_jobs : &observation.jobs[0];
            var capacity = semantic ? observation.semantic_capacity : sizeof(decltype(observation.jobs)) / sizeof(UnitsProfileSpan);
            units_check(first <= capacity, "profile wave extent");
            for(var i: usize = 0; i < first; i++) { jobs[i] = default; }
        }
        if phase == GrammarPhase.PoolOpen { observation.pool_before = second; }
        entry.span.start = units_profile_clock(); entry.span.cpu_start = units_profile_thread_cpu();
        entry.span.thread = pthread_self();
        return;
    }
    units_check(entry.depth != 0, "profile balanced phase");
    entry.depth--;
    if entry.depth != 0 { return; }
    var end_cpu = units_profile_thread_cpu();
    var end = units_profile_clock();
    entry.calls++; entry.work += second;
    entry.wall += end - entry.span.start; entry.cpu += end_cpu - entry.span.cpu_start;
    if phase == GrammarPhase.PoolOpen && observation.pool_before != second {
        observation.pool_creations++; observation.pool_slots += second;
    }
    if !wave { return; }
    if semantic { entry.lane_ns += (end - entry.span.start) * convert(u64, second); }
    var jobs = semantic ? observation.semantic_jobs : &observation.jobs[0];
    var threads: usize = 0;
    for(var i: usize = 0; i < first; i++) {
        var job = &jobs[i];
        if job.start == 0 { continue; }
        units_check(job.start >= entry.span.start && job.end >= job.start && job.end <= end, "grammar joined kernel interval");
        entry.kernel_wall += job.end - job.start; entry.kernel_cpu += job.cpu_end - job.cpu_start;
        units_check(job.cpu_end >= job.cpu_start, "profile kernel CPU interval");
        var active: usize = 0; var kind_active: usize = 0; var seen = false;
        var covered_until = job.start;
        for(var j: usize = 0; j < first; j++) {
            var other = &jobs[j];
            if other.start <= job.start && other.end > job.start {
                active++;
                if semantic && observation.semantic_kinds[j] == observation.semantic_kinds[i] { kind_active++; }
            }
            if j < i && other.thread == job.thread { seen = true; }
            if (other.start < job.start || (other.start == job.start && j < i)) && other.end > covered_until { covered_until = other.end; }
        }
        if job.end > covered_until { entry.covered += job.end - covered_until; }
        if semantic {
            units_check(active <= second, "profile kernel admission ceiling");
            var kernel = &observation.kernels[observation.semantic_kinds[i]];
            kernel.calls++; kernel.wall += job.end - job.start; kernel.cpu += job.cpu_end - job.cpu_start;
            if kind_active > kernel.kernel_peak { kernel.kernel_peak = kind_active; }
        }
        if !seen { threads++; }
        if active > entry.kernel_peak { entry.kernel_peak = active; }
    }
    if threads > entry.threads { entry.threads = threads; }
    // Collection is coordinator work after join, outside dispatch/kernel clocks.
    // Report it explicitly: enclosing phase spans include this diagnostic cost.
    entry.observer_cpu += units_profile_thread_cpu() - end_cpu;
    entry.observer_wall += units_profile_clock() - end;
}

fn units_profile_cpu(usage: UnitsProfileUsage*): u64 {
    return convert(u64, usage.user.seconds + usage.system.seconds) * 1000000
        + convert(u64, usage.user.fraction + usage.system.fraction);
}

fn units_profile_event(context: void*, phase: CompilerQuery, ordinal: usize, entering: bool): void {
    var events = bits(UnitsProfileEvents*, context);
    units_check((phase == CompilerQuery.Unit || phase == CompilerQuery.Backend)
        && ordinal != 0 && ordinal <= events.count, "profile phase and ordinal");
    var index = phase == CompilerQuery.Unit ? UnitsProfileFrontendPhase : UnitsProfileBackendPhase;
    units_check(index < events.phases, "profile configured phase");
    var span = &events.spans[index * events.count + ordinal - 1];
    if entering { span.start = units_profile_clock(); span.thread = pthread_self(); span.cpu_start = units_profile_thread_cpu(); }
    else { span.cpu_end = units_profile_thread_cpu(); span.end = units_profile_clock(); }
}

fn units_profile_backend_event(context: void*, phase_ordinal: usize, phase: BackendPhase, entering: bool): void {
    var events = bits(UnitsProfileEvents*, context);
    var index = convert(usize, phase);
    units_check(index < events.phases && phase_ordinal != 0 && phase_ordinal <= events.count, "profile backend phase bounds");
    var span = &events.spans[index * events.count + phase_ordinal - 1];
    if entering { span.start = units_profile_clock(); span.thread = pthread_self(); }
    else { span.end = units_profile_clock(); }
}

fn units_profile_text(out: ByteBuffer*, text: u8*): void {
    units_check(bytes_append(out, text, strlen(text)), "profile text");
}

fn units_profile_number(out: ByteBuffer*, number: u64): void {
    units_check(host_json_unsigned(out, number), "profile number");
}

// Optional post-join artifacts for exact cross-worker comparison and native
// execution through the existing CLI. The caller supplies an existing directory.
fn units_profile_save(directory: u8*, ordinal: usize, suffix: u8*, data: u8*, length: usize): void {
    if directory == null { return; }
    var path: ByteBuffer = default;
    defer bytes_dispose(&path);
    units_profile_text(&path, directory); units_profile_text(&path, "/");
    if ordinal != 0 { units_profile_text(&path, "unit_"); units_profile_number(&path, convert(u64, ordinal)); }
    units_profile_text(&path, suffix);
    units_check(host_text_terminate(&path), "profile artifact path");
    var file = fopen(path.data, "wb");
    units_check(file != null, "profile artifact open");
    var written = fwrite(bits(void*, data), 1, length, file);
    var closed = fclose(file);
    units_check(written == length && closed == 0, "profile complete artifact write");
}

fn units_profile_argument(text: u8*): usize {
    var value: usize = 0;
    for(var i: usize = 0; text[i] != 0; i++) {
        units_check(text[i] >= 48 && text[i] <= 57 && value < 100000, "profile integer argument");
        value = value * 10 + convert(usize, text[i] - 48);
    }
    return value;
}

fn units_profile_object_has(data: u8*, length: usize, text: u8*): bool {
    var count = strlen(text);
    if count > length { return false; }
    for(var i: usize = 0; i <= length - count; i++) {
        var matches = true;
        for(var j: usize = 0; j < count; j++) { if data[i + j] != text[j] { matches = false; break; } }
        if matches { return true; }
    }
    return false;
}

fn units_profile_result(function: void*, arguments: u64*, count: usize): void {
    var invocation: IMInvocation = default;
    units_check(interpreter_invocation_init(&invocation, function, 8, arguments, count, true, 10000), "profile invocation");
    while !invocation.state.done && !invocation.state.failed { interpreter_invocation_step(&invocation, 7); }
    units_check(!invocation.state.failed && invocation.context.result == 42, "profile independent result");
    interpreter_invocation_dispose(&invocation);
}

export fn main(argc: i32, argv: u8**): i32 {
    if argc < 5 || sizeof(usize) != 8 { return 2; }
    units_check(work_thread_available(), "profile requires production native worker transport");
    var backend_mode = false;
    var spread = false;
    var optimize = false;
    var dependencies = false;
    var grammar_profile = false;
    var artifacts: u8* = null;
    for(var i: i32 = 5; i < argc; i++) {
        if strcmp(argv[i], "backend") == 0 && !backend_mode { backend_mode = true; }
        else { if strcmp(argv[i], "grammar") == 0 && !grammar_profile { grammar_profile = true; }
        else { if strcmp(argv[i], "dependencies") == 0 && !dependencies { dependencies = true; }
        else { if strcmp(argv[i], "artifacts") == 0 && artifacts == null && i + 1 < argc { artifacts = argv[++i]; }
        else { if strcmp(argv[i], "spread") == 0 && !spread { spread = true; }
        else { if strcmp(argv[i], "optimized") == 0 && !optimize { optimize = true; } else { return 2; } } } } } }
    }
    var count = units_profile_argument(argv[2]);
    var budget = units_profile_argument(argv[3]);
    var bodies = units_profile_argument(argv[4]);
    units_check(count != 0 && count <= UnitsProfileMaximumUnits && budget != 0
        && budget <= work_thread_capacity() && bodies <= UnitsProfileMaximumBodies,
        "profile workload bounds");
    var bedrock: vector(u8) = default;
    var foundation: vector(u8) = default;
    defer vector_dispose(&bedrock);
    defer vector_dispose(&foundation);
    units_read(argv[1], "/bedrock.tower", &bedrock);
    units_read(argv[1], "/foundation.tower", &foundation);
    var source: ByteBuffer = default;
    defer bytes_dispose(&source);
    units_profile_text(&source, "import tower; ");
    if dependencies { units_profile_text(&source, "import dependency_shared; "); }
    if backend_mode { units_profile_text(&source, "export "); }
    if dependencies {
        units_profile_text(&source, "fn answer():i32{var ignored:decltype(unused(1));var value:chosen_type()=comptime(pick(false));var next:decltype(identity(value))=comptime(later());return identity(next)+value;}fn later():i32{return 0;}");
    } else { units_profile_text(&source, "fn answer():i32{return comptime(later());} fn later():i32{return 42;}"); }
    var imported: ByteBuffer = default;
    defer bytes_dispose(&imported);
    if dependencies {
        units_profile_text(&imported, "import tower;var Selected=comptime(pick(false));");
        units_profile_text(&imported, dependency_unit_helpers_source());
        units_check(host_text_terminate(&imported), "profile imported source");
    }
    var small = source.length;
    var lengths = alloc(usize, bodies + 1);
    units_check(lengths != null, "profile body prefix lengths");
    defer free(lengths);
    lengths[0] = small;
    for(var i: usize = 0; i < bodies; i++) {
        if backend_mode { units_profile_text(&source, "export "); }
        units_profile_text(&source, "fn body_"); units_profile_number(&source, convert(u64, i));
        units_profile_text(&source, "(x:i32):i32{var y:decltype(x)=x;for(var j:i32=0;j<4;j++){y+=j;}return y;}");
        lengths[i + 1] = source.length;
    }
    units_check(host_text_terminate(&source), "profile source terminator");
    var phases = backend_mode ? UnitsProfileBackendPhase + 1 : UnitsProfileFrontendPhase + 1;
    var span_count = count * phases;
    var spans = alloc(UnitsProfileSpan, span_count);
    units_check(spans != null, "profile spans");
    fill(spans, 0, span_count * sizeof(UnitsProfileSpan));
    defer free(spans);
    var events = init(UnitsProfileEvents) { spans: spans, count: count, phases: phases };
    var grammar_observations: UnitsGrammarObservation* = null;
    if grammar_profile {
        grammar_observations = alloc(UnitsGrammarObservation, count);
        units_check(grammar_observations != null, "grammar observer slots");
        fill(grammar_observations, 0, count * sizeof(UnitsGrammarObservation));
    }
    defer {
        if grammar_observations != null {
            for(var i: usize = 0; i < count; i++) {
                free(grammar_observations[i].semantic_jobs); free(grammar_observations[i].semantic_kinds);
            }
        }
        free(grammar_observations);
    }
    var backend_phase_count = backend_mode ? convert(usize, BackendPhase.Count) : 0;
    var backend_spans: UnitsProfileSpan* = null;
    if backend_phase_count != 0 {
        backend_spans = alloc(UnitsProfileSpan, count * backend_phase_count);
        units_check(backend_spans != null, "profile backend spans");
        fill(backend_spans, 0, count * backend_phase_count * sizeof(UnitsProfileSpan));
    }
    defer free(backend_spans);
    var backend_events = init(UnitsProfileEvents) { spans: backend_spans, count: count, phases: backend_phase_count };
    var before: UnitsProfileUsage;
    var after: UnitsProfileUsage;
    units_check(getrusage(0, &before) == 0, "profile before usage");
    var started = units_profile_clock();
    // This many-world profile has an explicit per-input ceiling plus transient
    // headroom. The production driver's project limit is unchanged.
    var retained_limit = (count + UnitsProfileTransientUnits) * DriverUnitRetainedByteLimit;
    var batch = frontend_units_create_bounded(count, budget, retained_limit,
        8, 81, 19, bedrock.data, foundation.data, argv[1]);
    units_check(batch != null, "profile batch");
    defer frontend_units_close(batch);
    units_check(frontend_units_observer(batch, bits(void*, &events), units_profile_event), "profile observer");
    for(var i: usize = 1; i <= count; i++) {
        if grammar_profile {
            var world = frontend_modules_world(frontend_units_environment(batch, i));
            compiler_world_grammar(world).observer = { context: bits(void*, &grammar_observations[i - 1]), event: units_profile_grammar };
        }
        var unit_bodies = spread ? bodies * ((i - 1) % UnitsProfileBodyBands + 1) / UnitsProfileBodyBands
            : (i == count ? bodies : 0);
        units_check(frontend_units_source(batch, i, "profile_unit.tower", source.data,
            lengths[unit_bodies]), "profile source snapshot");
        if dependencies {
            var environment = frontend_units_environment(batch, i);
            units_check(environment != null && frontend_modules_source(environment, "dependency_shared.tower",
                imported.data, imported.length), "profile imported dependency snapshot");
        }
    }
    var backend: void* = null;
    if backend_mode {
        backend = backend_units_create(batch, count, budget, "x86_64-pc-linux-gnu", true, optimize);
        units_check(backend != null, "profile bounded streaming backend");
        units_check(backend_units_retain_ir(backend, false), "profile object-only IR policy");
        units_check(backend_units_observer(backend, bits(void*, &backend_events), units_profile_backend_event), "profile backend observer");
    }
    defer { if backend != null { backend_units_close(backend); } }
    while !frontend_units_step(batch, true) {}
    if backend != null { while !backend_units_step(backend, true) {} }
    var elapsed = units_profile_clock() - started;
    units_check(getrusage(0, &after) == 0, "profile after usage");
    // Read only after the timed region. The frozen workload and reference
    // outputs stay identical to the earlier profile without ledger reporting.
    var reservation: WorkBudgetSnapshot = default;
    units_check(work_budget_snapshot(frontend_units_work_budget(batch), &reservation)
        && reservation.used_lanes == 0 && reservation.peak_lanes <= reservation.lanes
        && reservation.peak_bytes <= reservation.bytes, "profile joined budget snapshot");
    if frontend_units_failed(batch) != 0 { puts(frontend_units_error(batch)); }
    units_check(!frontend_units_cancelled(batch) && frontend_units_failed(batch) == 0, "profile compilation");
    var object_bytes: usize = 0;
    var object_hash: u64 = 14695981039346656037;
    if backend != null {
        if backend_units_failed(backend) != 0 { puts(backend_units_error(backend)); }
        units_check(!backend_units_cancelled(backend) && backend_units_failed(backend) == 0, "profile backend compilation");
        for(var ordinal: usize = 1; ordinal <= count; ordinal++) {
            var result = backend_units_result(backend, ordinal);
            units_check(result != null && backend_size(result) >= 4, "profile retained object");
            var data = backend_bytes(result);
            units_check(data != null && data[0] == 127 && data[1] == *"E" && data[2] == *"L" && data[3] == *"F",
                "profile target object envelope");
            units_check(units_profile_object_has(data, backend_size(result), "answer"), "profile emitted answer export");
            object_bytes += backend_size(result);
            units_profile_save(artifacts, ordinal, ".o", data, backend_size(result));
            for(var i: usize = 0; i < backend_size(result); i++) {
                object_hash = (object_hash ^ convert(u64, data[i])) * 1099511628211;
            }
        }
    }
    var hash: u64 = 14695981039346656037;
    var entities: usize = 0;
    var components: usize = 0;
    var peak: usize = 0;
    var separate_workers = false;
    var worker_ns: u64 = 0;
    var outer_cpu_ns: u64 = 0;
    var kernel_peak: usize = 0;
    var kernel_ns: u64 = 0;
    var first = started + elapsed;
    var last_start: u64 = 0;
    var last_end: u64 = 0;
    var refill_ns: u64 = 0;
    var refill_max_ns: u64 = 0;
    var refills: usize = 0;
    for(var i: usize = 0; i < span_count; i++) {
        var span = &spans[i];
        units_check(span.start >= started && span.end >= span.start && span.end <= started + elapsed
            && span.thread != 0, "profile all kernel bounds");
        if span.start < first { first = span.start; }
        if span.end > last_end { last_end = span.end; }
        if i < count && span.start > last_start { last_start = span.start; }
        kernel_ns += span.end - span.start;
        units_check(span.cpu_end >= span.cpu_start, "profile CPU interval");
        outer_cpu_ns += span.cpu_end - span.cpu_start;
        var active: usize = 0;
        var previous: u64 = 0;
        for(var j: usize = 0; j < span_count; j++) {
            if spans[j].start <= span.start && spans[j].end > span.start { active++; }
            if j != i && spans[j].thread == span.thread && spans[j].end <= span.start
                && spans[j].end > previous { previous = spans[j].end; }
        }
        if active > kernel_peak { kernel_peak = active; }
        // These frontend inputs were all ready before dispatch. This interval
        // also includes receipt publication or legitimate nested lane use; it
        // is observable thread reuse latency, not proof of avoidable idle time.
        if i < count && previous != 0 {
            var gap = span.start - previous;
            refill_ns += gap; refills++;
            if gap > refill_max_ns { refill_max_ns = gap; }
        }
    }
    var outer_limit = count < reservation.lanes ? count : reservation.lanes;
    units_check(kernel_peak <= outer_limit, "profile outer dispatch ceiling");
    // Integrate unoccupied OUTER slots while at least one frontend remains
    // unstarted. Nested kernels may occupy the shared lanes during this time;
    // this is an upper bound on idle capacity, not an eligible-work assertion.
    var ready_vacancy_ns: u64 = 0;
    var cursor = first;
    while cursor < last_start {
        var next = last_start;
        var active: usize = 0;
        var ready: usize = 0;
        for(var i: usize = 0; i < span_count; i++) {
            var span = &spans[i];
            if span.start <= cursor && span.end > cursor { active++; }
            if i < count && span.start > cursor { ready++; }
            if span.start > cursor && span.start < next { next = span.start; }
            if span.end > cursor && span.end < next { next = span.end; }
        }
        var vacant = outer_limit > active ? outer_limit - active : 0;
        if vacant > ready { vacant = ready; }
        ready_vacancy_ns += (next - cursor) * convert(u64, vacant);
        cursor = next;
    }
    for(var i: usize = 1; i <= count; i++) {
        var span = &spans[i - 1];
        units_check(span.end >= span.start && span.start >= started && span.thread != 0, "profile event bounds");
        worker_ns += span.end - span.start;
        var active: usize = 0;
        for(var j: usize = 0; j < count; j++) {
            if spans[j].start <= span.start && spans[j].end > span.start {
                active++;
                if spans[j].thread != span.thread { separate_workers = true; }
            }
        }
        if active > peak { peak = active; }
        var program = frontend_units_program(batch, i);
        units_check(program != null, "profile result");
        var store = compiler_world_store(compiler_node_world(program.root));
        entities += entity_store_count(store);
        components += entity_store_component_count(store);
        var answer: void* = null;
        var body: void* = null;
        foreach(var function in &program.functions) {
            var node = sem_get(function);
            if node.name.length == 6 && strcmp(node.name.data, "answer") == 0 { answer = function; }
            if node.name.length == 6 && strcmp(node.name.data, "body_0") == 0 { body = function; }
        }
        units_check(answer != null, "profile answer binding");
        units_profile_result(answer, null, 0);
        var unit_bodies = spread ? bodies * ((i - 1) % UnitsProfileBodyBands + 1) / UnitsProfileBodyBands
            : (i == count ? bodies : 0);
        units_profile_save(artifacts, i, ".tower", source.data, lengths[unit_bodies]);
        if unit_bodies != 0 {
            units_check(body != null, "profile ordinary loop body binding");
            var arguments: u64[1]; arguments[0] = 36;
            units_profile_result(body, &arguments[0], sizeof(decltype(arguments)) / sizeof(u64));
            if backend != null {
                var result = backend_units_result(backend, i);
                units_check(units_profile_object_has(backend_bytes(result), backend_size(result), "body_0"), "profile emitted body export");
            }
        }
        var formatted: FormatResult = default;
        format_entity(&formatted, program.root, compiler_node_type(program.root, CompilerSyntax),
            compiler_node_type(program.root, CompilerFoundation), compiler_node_type(program.root, CompilerParserMatch));
        units_check(!formatted.failed, "profile canonical output");
        units_profile_save(artifacts, i, ".foundation", formatted.text.data, formatted.text.length);
        foreach(var byte in &formatted.text) { hash = (hash ^ convert(u64, byte)) * 1099511628211; }
        format_dispose(&formatted);
    }
    var out: ByteBuffer = default;
    if dependencies { units_profile_save(artifacts, 0, "dependency_shared.tower", imported.data, imported.length); }
    defer bytes_dispose(&out);
    units_profile_text(&out, "{\"units\":"); units_profile_number(&out, convert(u64, count));
    units_profile_text(&out, ",\"budget\":"); units_profile_number(&out, convert(u64, budget));
    units_profile_text(&out, ",\"bodies\":"); units_profile_number(&out, convert(u64, bodies));
    units_profile_text(&out, ",\"backend\":"); units_profile_number(&out, backend_mode ? 1 : 0);
    units_profile_text(&out, ",\"optimized\":"); units_profile_number(&out, optimize ? 1 : 0);
    units_profile_text(&out, ",\"dependencies\":"); units_profile_number(&out, dependencies ? 1 : 0);
    units_profile_text(&out, ",\"spread\":"); units_profile_number(&out, spread ? 1 : 0);
    units_profile_text(&out, ",\"wall_ns\":"); units_profile_number(&out, elapsed);
    units_profile_text(&out, ",\"cpu_us\":"); units_profile_number(&out, units_profile_cpu(&after) - units_profile_cpu(&before));
    units_profile_text(&out, ",\"outer_cpu_ns\":"); units_profile_number(&out, outer_cpu_ns);
    units_profile_text(&out, ",\"voluntary_switches\":"); units_profile_number(&out, convert(u64, after.voluntary_switches - before.voluntary_switches));
    units_profile_text(&out, ",\"involuntary_switches\":"); units_profile_number(&out, convert(u64, after.involuntary_switches - before.involuntary_switches));
    units_profile_text(&out, ",\"peak_rss_kib\":"); units_profile_number(&out, convert(u64, after.peak_rss));
    units_profile_text(&out, ",\"outer_peak\":"); units_profile_number(&out, convert(u64, peak));
    units_profile_text(&out, ",\"outer_ns\":"); units_profile_number(&out, worker_ns);
    units_profile_text(&out, ",\"kernel_peak\":"); units_profile_number(&out, convert(u64, kernel_peak));
    units_profile_text(&out, ",\"kernel_ns\":"); units_profile_number(&out, kernel_ns);
    units_profile_text(&out, ",\"outer_limit\":"); units_profile_number(&out, convert(u64, outer_limit));
    units_profile_text(&out, ",\"shared_lane_limit\":"); units_profile_number(&out, convert(u64, reservation.lanes));
    units_profile_text(&out, ",\"nested_extra_limit\":"); units_profile_number(&out, convert(u64, reservation.lanes - 1));
    units_profile_text(&out, ",\"startup_ns\":"); units_profile_number(&out, first - started);
    units_profile_text(&out, ",\"last_frontend_start_ns\":"); units_profile_number(&out, last_start - first);
    units_profile_text(&out, ",\"tail_ns\":"); units_profile_number(&out, last_end - last_start);
    units_profile_text(&out, ",\"ready_outer_vacancy_ns\":"); units_profile_number(&out, ready_vacancy_ns);
    units_profile_text(&out, ",\"refills\":"); units_profile_number(&out, convert(u64, refills));
    units_profile_text(&out, ",\"refill_ns\":"); units_profile_number(&out, refill_ns);
    units_profile_text(&out, ",\"refill_max_ns\":"); units_profile_number(&out, refill_max_ns);
    units_profile_text(&out, ",\"reserved_peak_lanes\":"); units_profile_number(&out, convert(u64, reservation.peak_lanes));
    units_profile_text(&out, ",\"retained_bytes\":"); units_profile_number(&out, convert(u64, reservation.used_bytes));
    units_profile_text(&out, ",\"byte_limit\":"); units_profile_number(&out, convert(u64, reservation.bytes));
    units_profile_text(&out, ",\"object_bytes\":"); units_profile_number(&out, convert(u64, object_bytes));
    units_profile_text(&out, ",\"object_hash\":"); units_profile_number(&out, object_hash);
    units_profile_text(&out, ",\"reserved_peak_bytes\":"); units_profile_number(&out, convert(u64, reservation.peak_bytes));
    units_profile_text(&out, ",\"ledger_storage_bytes\":"); units_profile_number(&out, convert(u64, reservation.retained));
    units_profile_text(&out, ",\"entities\":"); units_profile_number(&out, convert(u64, entities));
    units_profile_text(&out, ",\"components\":"); units_profile_number(&out, convert(u64, components));
    units_profile_text(&out, ",\"canonical_hash\":"); units_profile_number(&out, hash);
    units_profile_text(&out, ",\"backend_phase_ns\":[");
    for(var phase: usize = 0; phase < backend_phase_count; phase++) {
        var total: u64 = 0;
        for(var ordinal: usize = 0; ordinal < count; ordinal++) {
            var span = &backend_spans[phase * count + ordinal];
            var outer = &spans[UnitsProfileBackendPhase * count + ordinal];
            units_check(span.start >= outer.start && span.end >= span.start && span.end <= outer.end
                && span.thread == outer.thread, "profile backend phase interval");
            total += span.end - span.start;
        }
        if phase != 0 { units_profile_text(&out, ","); }
        units_profile_number(&out, total);
    }
    units_profile_text(&out, "],\"grammar\":[");
    if grammar_profile {
        for(var phase: usize = 0; phase < UnitsGrammarPhaseCount; phase++) {
            var total: UnitsGrammarPhase = default;
            var creations: usize = 0; var slots: usize = 0;
            for(var ordinal: usize = 0; ordinal < count; ordinal++) {
                var observed = &grammar_observations[ordinal].phases[phase];
                total.calls += observed.calls; total.work += observed.work;
                total.wall += observed.wall; total.cpu += observed.cpu;
                total.kernel_wall += observed.kernel_wall; total.kernel_cpu += observed.kernel_cpu;
                total.covered += observed.covered; total.lane_ns += observed.lane_ns;
                total.observer_wall += observed.observer_wall; total.observer_cpu += observed.observer_cpu;
                if observed.kernel_peak > total.kernel_peak { total.kernel_peak = observed.kernel_peak; }
                if observed.threads > total.threads { total.threads = observed.threads; }
                creations += grammar_observations[ordinal].pool_creations; slots += grammar_observations[ordinal].pool_slots;
            }
            if phase != 0 { units_profile_text(&out, ","); }
            units_profile_text(&out, "{\"phase\":"); units_profile_number(&out, convert(u64, phase));
            units_profile_text(&out, ",\"calls\":"); units_profile_number(&out, convert(u64, total.calls));
            units_profile_text(&out, ",\"work\":"); units_profile_number(&out, convert(u64, total.work));
            units_profile_text(&out, ",\"wall_ns\":"); units_profile_number(&out, total.wall);
            units_profile_text(&out, ",\"cpu_ns\":"); units_profile_number(&out, total.cpu);
            units_profile_text(&out, ",\"kernel_ns\":"); units_profile_number(&out, total.kernel_wall);
            units_profile_text(&out, ",\"kernel_cpu_ns\":"); units_profile_number(&out, total.kernel_cpu);
            units_profile_text(&out, ",\"covered_ns\":"); units_profile_number(&out, total.covered);
            units_profile_text(&out, ",\"admitted_lane_ns\":"); units_profile_number(&out, total.lane_ns);
            units_profile_text(&out, ",\"observer_ns\":"); units_profile_number(&out, total.observer_wall);
            units_profile_text(&out, ",\"observer_cpu_ns\":"); units_profile_number(&out, total.observer_cpu);
            units_profile_text(&out, ",\"kernel_peak\":"); units_profile_number(&out, convert(u64, total.kernel_peak));
            units_profile_text(&out, ",\"threads\":"); units_profile_number(&out, convert(u64, total.threads));
            if phase == convert(usize, GrammarPhase.PoolOpen) {
                units_profile_text(&out, ",\"creations\":"); units_profile_number(&out, convert(u64, creations));
                units_profile_text(&out, ",\"slots\":"); units_profile_number(&out, convert(u64, slots));
            }
            units_profile_text(&out, "}");
        }
    }
    units_profile_text(&out, "],\"semantic_kernels\":[");
    if grammar_profile {
        for(var kind: usize = 0; kind < UnitsKernelKindCount; kind++) {
            var total: UnitsGrammarPhase = default;
            for(var ordinal: usize = 0; ordinal < count; ordinal++) {
                var observed = &grammar_observations[ordinal].kernels[kind];
                total.calls += observed.calls; total.wall += observed.wall; total.cpu += observed.cpu;
                if observed.kernel_peak > total.kernel_peak { total.kernel_peak = observed.kernel_peak; }
            }
            if kind != 0 { units_profile_text(&out, ","); }
            units_profile_text(&out, "{\"kind\":"); units_profile_number(&out, convert(u64, kind));
            units_profile_text(&out, ",\"jobs\":"); units_profile_number(&out, convert(u64, total.calls));
            units_profile_text(&out, ",\"wall_ns\":"); units_profile_number(&out, total.wall);
            units_profile_text(&out, ",\"cpu_ns\":"); units_profile_number(&out, total.cpu);
            units_profile_text(&out, ",\"peak\":"); units_profile_number(&out, convert(u64, total.kernel_peak));
            units_profile_text(&out, "}");
        }
    }
    units_profile_text(&out, "],\"spans\":[");
    for(var i: usize = 0; i < span_count; i++) {
        if i != 0 { units_profile_text(&out, ","); }
        units_profile_text(&out, "{\"phase\":"); units_profile_number(&out, convert(u64, i / count));
        units_profile_text(&out, ",\"unit\":"); units_profile_number(&out, convert(u64, i % count + 1));
        units_profile_text(&out, ",\"start_ns\":"); units_profile_number(&out, spans[i].start - started);
        units_profile_text(&out, ",\"end_ns\":"); units_profile_number(&out, spans[i].end - started);
        units_profile_text(&out, ",\"thread\":"); units_profile_number(&out, convert(u64, spans[i].thread));
        units_profile_text(&out, ",\"cpu_ns\":"); units_profile_number(&out, spans[i].cpu_end - spans[i].cpu_start);
        units_profile_text(&out, "}");
    }
    units_profile_text(&out, "]}");
    units_check(host_text_terminate(&out), "profile JSON terminator");
    puts(out.data);
    // Keep failed observations above. Equal independent units are the control
    // for native concurrency; requested lanes alone cannot validate this run.
    if count > 1 && budget > 1 && bodies == 0 {
        units_check(peak > 1 && separate_workers && reservation.peak_lanes > 1,
            "profile equal-unit control did not overlap native work");
    }
    return 0;
}
