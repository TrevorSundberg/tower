import semantic_capture_continuation_checks;
import semantic_capture_continuation_checks_test;

export fn main(argc: i32, argv: u8**): i32 {
    var mode: CaptureContinuationMode;
    if !capture_continuation_select(argc, argv, &mode) { return 1; }
    var result = capture_continuation_cases(mode);
    return result.failures == 0 ? 0 : 1;
}
