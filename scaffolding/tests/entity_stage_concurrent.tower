import library.testing;
import entity_stage_concurrent_fixture_test;

extern fn getrusage(who: i32, result: i64*): i32;

export fn main(argc: i32, argv: u8**): i32 {
    if argc == 1 { stage_transitions(); }
    var finalized = stage_worker_trials();
    var usage: i64[18];
    assert(getrusage(0, &usage[0]) == 0);
    // Completed finalizers, process CPU us and process peak RSS KiB. Exact
    // store/component teardown is checked per trial, not inferred from RSS.
    print(finalized);
    print((usage[0] + usage[2]) * 1000000 + usage[1] + usage[3]);
    print(usage[4]);
    return 0;
}
