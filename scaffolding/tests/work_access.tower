import tower;
import .host.memory;
import .library.work_graph;

var failures: u32 = 0;

fn check(ok: bool): void {
    if !ok {
        failures++;
    }
}

fn task(g: WorkGraph*, key: u64, domain: u64, component: u64, first: usize, count: usize, mode: WorkAccessMode): usize {
    var id = work_request(g, null, 1, key);
    check(work_access(g, id, domain, component, first, count, mode));
    check(work_seal(g, id));
    check(work_demand(g, id));
    return id;
}

fn access_tests(): void {
    var g: WorkGraph;
    work_init(&g, 7, 9);
    var read = task(&g, 1, 1, 1, 0, 10, WorkAccessMode.Read);
    var write = task(&g, 2, 1, 1, 5, 10, WorkAccessMode.Write);
    var shared = task(&g, 3, 1, 1, 5, 10, WorkAccessMode.Read);
    var disjoint = task(&g, 4, 1, 1, 15, 10, WorkAccessMode.Write);
    var structure = task(&g, 5, 1, 9, 100, 1, WorkAccessMode.Structure);
    var private = task(&g, 6, 2, 1, 0, 100, WorkAccessMode.Structure);
    var a: WorkTicket;
    var b: WorkTicket;
    var c: WorkTicket;
    var d: WorkTicket;
    check(work_take(&g, &a));
    var equal = a.task == read;
    check(equal);
    check(work_take(&g, &b));
    equal = b.task == shared;
    check(equal);
    check(work_take(&g, &c));
    equal = c.task == disjoint;
    check(equal);
    check(work_take(&g, &d));
    equal = d.task == private;
    check(equal);
    var spare: WorkTicket;
    var blocked = work_take(&g, &spare) == false;
    check(blocked);
    a.revision = 8;
    blocked = work_finish(&g, &a, true) == false;
    check(blocked);
    a.revision = 7;
    check(work_finish(&g, &a, true));
    blocked = work_take(&g, &spare) == false;
    check(blocked);
    check(work_finish(&g, &b, true));
    check(work_take(&g, &a));
    equal = a.task == write;
    check(equal);
    check(work_finish(&g, &a, true));
    blocked = work_take(&g, &spare) == false;
    check(blocked);
    check(work_finish(&g, &c, true));
    check(work_take(&g, &a));
    equal = a.task == structure;
    check(equal);
    work_cancel(&g);
    blocked = work_finish(&g, &d, true) == false;
    check(blocked);
    work_dispose(&g);

    // Range overflow and zero-length declarations cannot bypass exclusion.
    work_init(&g, 1, 1);
    var id = work_request(&g, null, 1, 1);
    var maximum: usize = 0;
    maximum--;
    blocked = work_access(&g, id, 1, 1, maximum, 1, WorkAccessMode.Write) == false;
    check(blocked);
    work_dispose(&g);
    work_init(&g, 1, 1);
    id = work_request(&g, null, 1, 1);
    blocked = work_access(&g, id, 1, 1, 0, 0, WorkAccessMode.Read) == false;
    check(blocked);
    work_dispose(&g);
}

access_tests();
print(failures);
