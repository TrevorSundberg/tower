import tower;
import frontend_units;
import frontend_units_memory;
import work_named;
import .library.vector;
import .library.work_pool;
import .library.compiler_work_types;
import .library.work_budget;
import .library.work_budget_types;
import .compiler.format_api;

extern fn backend_units_create(frontend: void*, count: usize, budget: usize, target: u8*, library: bool, optimize: bool): void*;
extern fn backend_units_create_bounded(frontend: void*, count: usize, budget: usize, retained_bytes: usize,
    target: u8*, library: bool, optimize: bool): void*;
extern fn backend_units_close(batch: void*): void;
extern fn backend_units_step(batch: void*, wait: bool): bool;
extern fn backend_units_failed(batch: void*): usize;
extern fn backend_units_cancelled(batch: void*): bool;
extern fn backend_units_cancel(batch: void*): void;
extern fn backend_units_result(batch: void*, ordinal: usize): void*;
extern fn backend_units_error(batch: void*): u8*;
extern fn backend_bytes(backend: void*): u8*;
extern fn backend_size(backend: void*): usize;
extern fn frontend_units_observer(frontend: void*, context: void*,
    event: function(void, void*, CompilerQuery, usize, bool)): bool;
extern fn frontend_units_peak(frontend: void*): usize;
extern fn frontend_units_pending(frontend: void*): bool;
extern fn frontend_units_input_bytes(frontend: void*): usize;
extern fn pthread_self(): usize;
extern fn sched_yield(): i32;
extern fn fflush(stream: void*): i32;

struct UnitStreamTime { seconds: i64; nanoseconds: i64; }
extern fn clock_gettime(clock: i32, value: UnitStreamTime*): i32;
var UnitStreamMonotonicClock: i32 = 1;
var UnitStreamNanosecondsPerSecond: u64 = 1000000000;
var UnitStreamTimeoutNanoseconds: u64 = 30000000000;
var UnitStreamHeldFrontend: usize = 2;
var UnitStreamFirstBackend: usize = 1;
struct UnitStreamOverlap {
    backend_entered: void*;
    frontend_released: void*;
    frontend_thread: usize;
    backend_thread: usize;
    frontend_wait_ns: u64;
}

fn unit_stream_clock(): u64 {
    var now: UnitStreamTime;
    units_check(clock_gettime(UnitStreamMonotonicClock, &now) == 0, "stream monotonic clock");
    units_check(now.seconds >= 0 && now.nanoseconds >= 0
        && convert(u64, now.nanoseconds) < UnitStreamNanosecondsPerSecond, "stream valid monotonic timestamp");
    var seconds = convert(u64, now.seconds);
    var nanos = convert(u64, now.nanoseconds);
    var maximum = ~convert(u64, 0);
    units_check(seconds <= maximum / UnitStreamNanosecondsPerSecond, "stream monotonic seconds fit nanoseconds");
    var whole = seconds * UnitStreamNanosecondsPerSecond;
    units_check(nanos <= maximum - whole, "stream monotonic timestamp does not overflow");
    return whole + nanos;
}

fn unit_stream_elapsed(started: u64): u64 {
    var now = unit_stream_clock();
    units_check(now >= started, "stream monotonic clock does not move backwards");
    return now - started;
}

// One private line per event, flushed before an assertion can abort. This uses
// no shared timing state and does not change admission or the overlap deadline.
fn unit_stream_trace(phase: CompilerQuery, ordinal: usize, event: u8*): void {
    var now = unit_stream_clock();
    var text: FormatResult = default;
    defer format_dispose(&text);
    var out: FormatEngine = { result: &text, ..default };
    format_text(&out, "Stream event ns=");
    format_unsigned(&out, now);
    format_text(&out, phase == CompilerQuery.Unit ? " frontend=" : " backend=");
    format_unsigned(&out, convert(u64, ordinal));
    format_text(&out, " ");
    format_text(&out, event);
    format_text(&out, " thread=");
    format_unsigned(&out, convert(u64, pthread_self()));
    units_check(!text.failed && vector_push(&text.text, 0), "stream trace formatting");
    puts(text.text.data);
    fflush(null);
}

fn unit_stream_wait(signal: void*, diagnostic: u8*, phase: CompilerQuery, ordinal: usize, wait_ns: u64): void {
    units_check(wait_ns >= UnitStreamTimeoutNanoseconds && wait_ns < ~convert(u64, 0), "stream finite wait bound");
    var started = unit_stream_clock();
    while !work_signal_try(signal) {
        if unit_stream_elapsed(started) >= wait_ns {
            unit_stream_trace(phase, ordinal, "timeout");
            units_check(false, diagnostic);
        }
        sched_yield();
    }
}

fn unit_stream_observe(payload: void*, phase: CompilerQuery, ordinal: usize, entering: bool): void {
    unit_stream_trace(phase, ordinal, entering ? "enter" : "leave");
    if !entering { return; }
    var overlap = bits(UnitStreamOverlap*, payload);
    if phase == CompilerQuery.Unit && ordinal == UnitStreamHeldFrontend {
        overlap.frontend_thread = pthread_self();
        unit_stream_wait(overlap.backend_entered,
            "frontend/backend overlap deadline: frontend unit 2 awaits backend unit 1", phase, ordinal, overlap.frontend_wait_ns);
        work_signal_post(overlap.frontend_released);
    }
    if phase == CompilerQuery.Backend && ordinal == UnitStreamFirstBackend {
        overlap.backend_thread = pthread_self();
        work_signal_post(overlap.backend_entered);
        unit_stream_wait(overlap.frontend_released,
            "frontend/backend overlap deadline: backend unit 1 awaits frontend unit 2", phase, ordinal, UnitStreamTimeoutNanoseconds);
    }
}

var BackendFixtureUnits: usize = 4;
var BackendFixtureRevision: u64 = 75;
var BackendFixtureProfile: u64 = 19;

fn backend_units_inputs(width: u32, budget: usize, root: u8*, bedrock: u8*, foundation: u8*): void* {
    var frontend = frontend_units_create(BackendFixtureUnits, budget, width,
        BackendFixtureRevision, BackendFixtureProfile, bedrock, foundation, root);
    units_check(frontend != null, "backend frontend create");
    var source: u8* = "import tower; export fn answer():i32 {var x:decltype(later())=comptime(later());return x;} fn later():i32{return 42;}";
    for(var ordinal: usize = 1; ordinal <= BackendFixtureUnits; ordinal++) {
        units_check(frontend_units_source(frontend, ordinal, "backend_unit.tower", source, strlen(source)), "backend source");
    }
    return frontend;
}

fn backend_units_frontend(width: u32, root: u8*, bedrock: u8*, foundation: u8*): void* {
    var frontend = backend_units_inputs(width, 1, root, bedrock, foundation);
    while !frontend_units_step(frontend, true) {}
    units_check(frontend_units_failed(frontend) == 0 && !frontend_units_cancelled(frontend), "backend frontend completed");
    return frontend;
}

fn backend_units_trial(frontend: void*, budget: usize, target: u8*, output: vector(u8)*): void {
    var streaming = frontend_units_pending(frontend);
    var before: WorkBudgetSnapshot;
    units_check(work_budget_snapshot(frontend_units_work_budget(frontend), &before), "backend input accounting");
    var input_bytes = frontend_units_input_bytes(frontend);
    var output_bytes = units_memory_span_bytes(strlen(target));
    units_check(backend_units_create(frontend, ~convert(usize, 0), budget, target, true, true) == null,
        "backend rejects invalid count before allocating or walking units");
    var batch = backend_units_create(frontend, BackendFixtureUnits, budget, target, true, true);
    units_check(batch != null, "backend batch create");
    defer { if batch != null { backend_units_close(batch); } }
    units_check(backend_units_result(batch, 1) == null, "backend unpublished output");
    units_check(backend_units_create(frontend, BackendFixtureUnits, budget, target, true, true) == null,
        "backend rejects competing graph owner");
    while !backend_units_step(batch, true) {}
    if backend_units_failed(batch) != 0 { puts(backend_units_error(batch)); }
    units_check(!backend_units_cancelled(batch) && backend_units_failed(batch) == 0, "backend compilation succeeds");
    for(var ordinal: usize = 1; ordinal <= BackendFixtureUnits; ordinal++) {
        var backend = backend_units_result(batch, ordinal);
        units_check(backend != null && backend_size(backend) != 0, "backend object produced");
        output_bytes += backend_size(backend);
        var bytes = backend_bytes(backend);
        for(var i: usize = 0; i < backend_size(backend); i++) {
            units_check(vector_push(output, bytes[i]), "backend object snapshot");
        }
    }
    units_check(backend_units_result(batch, BackendFixtureUnits + 1) == null, "backend invalid result ordinal");
    var retained: WorkBudgetSnapshot;
    units_check(work_budget_snapshot(frontend_units_work_budget(frontend), &retained)
        && retained.used_lanes == 0 && retained.peak_lanes <= retained.lanes
        && retained.peak_bytes <= retained.bytes && frontend_units_input_bytes(frontend) == input_bytes,
        "backend joins all shared execution grants");
    if streaming {
        units_check(retained.used_bytes >= before.used_bytes + output_bytes,
            "streaming objects retain their byte reservations after join");
    }
    // Streaming compilation also creates retained frontend tables. Measure the
    // exact backend release against the joined frontend baseline, not its
    // earlier state before parsing. Later targets use a separate backend ledger.
    backend_units_close(batch);
    batch = null;
    var released: WorkBudgetSnapshot;
    units_check(work_budget_snapshot(frontend_units_work_budget(frontend), &released)
        && released.used_lanes == 0 && released.peak_bytes <= released.bytes
        && frontend_units_input_bytes(frontend) == input_bytes, "Backend disposal preserves retained inputs and cap");
    if streaming {
        units_check(retained.used_bytes == released.used_bytes + output_bytes
            && retained.live == released.live + BackendFixtureUnits + 1
            && released.used_bytes >= before.used_bytes && released.live >= before.live,
            "Backend disposal releases exactly target and object receipts beside retained frontend owners");
    } else {
        units_check(released.used_bytes == before.used_bytes && released.live == before.live,
            "Separate backend ledger leaves frontend accounting unchanged");
    }
}

fn backend_units_memory(frontend: void*, target: u8*): void {
    units_check(backend_units_create_bounded(frontend, BackendFixtureUnits, 1, 0, target, true, true) == null
        && backend_units_create_bounded(frontend, BackendFixtureUnits, 1, ~convert(usize, 0), target, true, true) == null,
        "bounded backend rejects missing or unbounded policy");
    var bytes = units_memory_span_bytes(strlen(target));
    units_check(backend_units_create_bounded(frontend, BackendFixtureUnits, 1, bytes - 1, target, true, true) == null,
        "target cap rejection leaves frontend graph usable");
    var batch = backend_units_create_bounded(frontend, BackendFixtureUnits, 1, bytes, target, true, true);
    units_check(batch != null, "exact target payload and allocator header admitted before allocation");
    defer backend_units_close(batch);
    while !backend_units_step(batch, true) {}
    units_check(!backend_units_cancelled(batch) && backend_units_failed(batch) == 1
        && strcmp(backend_units_error(batch), "Unable to reserve retained backend output") == 0
        && backend_units_result(batch, 1) == null, "denied object output is reclaimed before failed publication");
}

fn backend_units_stream_trial(width: u32, budget: usize, root: u8*, bedrock: u8*, foundation: u8*,
    target: u8*, serial: vector(u8)*, parallel: vector(u8)*, frontend_wait_ns: u64): void {
    var streaming = backend_units_inputs(width, budget, root, bedrock, foundation);
    defer frontend_units_close(streaming);
    var overlap: UnitStreamOverlap = default;
    overlap.frontend_wait_ns = frontend_wait_ns;
    overlap.backend_entered = work_signal_open();
    overlap.frontend_released = work_signal_open();
    units_check(overlap.backend_entered != null && overlap.frontend_released != null, "stream overlap signals");
    defer work_signal_close(overlap.backend_entered);
    defer work_signal_close(overlap.frontend_released);
    if budget > 1 {
        units_check(frontend_units_observer(streaming, bits(void*, &overlap), unit_stream_observe), "stream observer");
    }
    parallel.length = 0;
    backend_units_trial(streaming, budget, target, parallel);
    units_check(frontend_units_failed(streaming) == 0 && !frontend_units_cancelled(streaming), "stream frontend success");
    units_check(frontend_units_peak(streaming) <= budget, "shared frontend/backend budget");
    units_check(serial.length == parallel.length, "stream deterministic object lengths");
    for(var i: usize = 0; i < serial.length; i++) {
        units_check(serial.data[i] == parallel.data[i], "stream deterministic object bytes");
    }
    if budget > 1 {
        units_check(overlap.frontend_thread != 0 && overlap.backend_thread != 0
            && overlap.frontend_thread != overlap.backend_thread
            && overlap.frontend_thread != pthread_self() && overlap.backend_thread != pthread_self(),
            "actual frontend/backend overlap on distinct worker threads");
    }
}

fn unit_stream_calibration(baseline_ns: u64, wait_ns: u64): void {
    var text: FormatResult = default;
    defer format_dispose(&text);
    var out: FormatEngine = { result: &text, ..default };
    format_text(&out, "Backend overlap calibration: serial_frontend_ns=");
    format_unsigned(&out, baseline_ns);
    format_text(&out, " frontend_wait_ns=");
    format_unsigned(&out, wait_ns);
    format_text(&out, " backend_wait_ns=");
    format_unsigned(&out, UnitStreamTimeoutNanoseconds);
    units_check(!text.failed && vector_push(&text.text, 0), "stream calibration formatting");
    puts(text.text.data);
    fflush(null);
}

// Calibration measures the already-required complete serial frontend batch.
// The resulting bound is frozen before dispatch and only covers frontend 2's
// wait for backend 1; the backend acknowledgement always has the original bound.
fn backend_units_overlap_run(root: u8*, calibrated: bool): void {
    var bedrock: vector(u8) = default;
    var foundation: vector(u8) = default;
    var serial: vector(u8) = default;
    var parallel: vector(u8) = default;
    defer vector_dispose(&bedrock);
    defer vector_dispose(&foundation);
    defer vector_dispose(&serial);
    defer vector_dispose(&parallel);
    units_read(root, "/bedrock.tower", &bedrock);
    units_read(root, "/foundation.tower", &foundation);
    puts("Backend overlap: preparing the serial 64-bit object baseline");
    fflush(null);
    var started: u64 = 0;
    if calibrated { started = unit_stream_clock(); }
    var frontend = backend_units_frontend(8, root, bedrock.data, foundation.data);
    defer frontend_units_close(frontend);
    var wait_ns = UnitStreamTimeoutNanoseconds;
    if calibrated {
        var baseline_ns = unit_stream_elapsed(started);
        if baseline_ns > wait_ns { wait_ns = baseline_ns; }
        unit_stream_calibration(baseline_ns, wait_ns);
    }
    var target: u8* = "x86_64-unknown-linux-gnu";
    backend_units_trial(frontend, 1, target, &serial);
    puts("Backend overlap: running the existing two-worker streaming case");
    fflush(null);
    backend_units_stream_trial(8, 2, root, bedrock.data, foundation.data, target, &serial, &parallel, wait_ns);
    puts("Backend overlap: exact objects and distinct worker overlap passed");
}

export fn backend_units_overlap_tests(root: u8*): void {
    backend_units_overlap_run(root, false);
}

export fn backend_units_overlap_calibrated_tests(root: u8*): void {
    backend_units_overlap_run(root, true);
}

export fn backend_units_tests(root: u8*): void {
    work_named_tests();
    var bedrock: vector(u8) = default;
    var foundation: vector(u8) = default;
    defer vector_dispose(&bedrock);
    defer vector_dispose(&foundation);
    units_read(root, "/bedrock.tower", &bedrock);
    units_read(root, "/foundation.tower", &foundation);
    for(var width: u32 = 4; width <= 8; width += 4) {
        var frontend = backend_units_frontend(width, root, bedrock.data, foundation.data);
        defer frontend_units_close(frontend);
        var target: u8* = width == 4 ? "wasm32-unknown-unknown" : "x86_64-unknown-linux-gnu";
        backend_units_memory(frontend, target);
        var serial: vector(u8) = default;
        var parallel: vector(u8) = default;
        defer vector_dispose(&serial);
        defer vector_dispose(&parallel);
        backend_units_trial(frontend, 1, target, &serial);
        backend_units_trial(frontend, BackendFixtureUnits, target, &parallel);
        units_check(serial.length == parallel.length, "backend deterministic object lengths");
        for(var i: usize = 0; i < serial.length; i++) {
            units_check(serial.data[i] == parallel.data[i], "backend deterministic object bytes");
        }
        // A held frontend worker cannot finish until an earlier unit enters
        // LLVM on a different worker. A whole-frontend barrier times out here;
        // queued work or timing-dependent sample observations cannot pass it.
        for(var budget: usize = 1; budget <= BackendFixtureUnits; budget *= 2) {
            backend_units_stream_trial(width, budget, root, bedrock.data, foundation.data,
                target, &serial, &parallel, UnitStreamTimeoutNanoseconds);
        }
        for(var budget: usize = 1; budget <= BackendFixtureUnits; budget += BackendFixtureUnits - 1) {
            var failure = backend_units_create(frontend, BackendFixtureUnits, budget,
                "not-a-real-target", true, true);
            units_check(failure != null, "backend invalid-target batch");
            while !backend_units_step(failure, true) {}
            units_check(backend_units_failed(failure) == 1 && backend_units_error(failure)[0] != 0,
                "backend deterministic first diagnostic");
            units_check(backend_units_result(failure, 1) == null, "failed backend never publishes");
            backend_units_close(failure);
        }
        parallel.length = 0;
        backend_units_trial(frontend, BackendFixtureUnits, target, &parallel);
        units_check(serial.length == parallel.length, "backend retry after failed queries");
        for(var i: usize = 0; i < serial.length; i++) {
            units_check(serial.data[i] == parallel.data[i], "backend retry preserves object bytes");
        }
    }
    for(var budget: usize = 1; budget <= BackendFixtureUnits; budget += BackendFixtureUnits - 1) {
        var frontend = backend_units_inputs(8, budget, root, bedrock.data, foundation.data);
        defer frontend_units_close(frontend);
        var first: u8* = "import tower; fn bad():i32{return unknownFirstStream;}";
        var later: u8* = "import tower; fn bad():i32{return unknownLaterStream;}";
        units_check(frontend_units_source(frontend, 2, "first_stream_failure.tower", first, strlen(first))
            && frontend_units_source(frontend, 3, "later_stream_failure.tower", later, strlen(later)), "stream failing sources");
        var batch = backend_units_create(frontend, BackendFixtureUnits, budget, "x86_64-unknown-linux-gnu", true, true);
        units_check(batch != null, "stream failure create");
        while !backend_units_step(batch, true) {}
        units_check(frontend_units_failed(frontend) == 2 && !frontend_units_cancelled(frontend)
            && strstr(frontend_units_error(frontend), "unknownFirstStream") != null, "stream deterministic frontend failure");
        units_check(backend_units_result(batch, 1) == null, "frontend failure hides already compiled objects");
        backend_units_close(batch);
        var invalid = backend_units_inputs(8, budget, root, bedrock.data, foundation.data);
        defer frontend_units_close(invalid);
        batch = backend_units_create(invalid, BackendFixtureUnits, budget, "not-a-real-target", true, true);
        units_check(batch != null, "stream invalid target create");
        while !backend_units_step(batch, true) {}
        units_check(!backend_units_cancelled(batch) && backend_units_failed(batch) == 1
            && backend_units_result(batch, 1) == null, "stream deterministic backend failure");
        backend_units_close(batch);
    }
    for(var active: usize = 0; active < 2; active++) {
        var frontend = backend_units_frontend(8, root, bedrock.data, foundation.data);
        defer frontend_units_close(frontend);
        var batch = backend_units_create(frontend, BackendFixtureUnits, BackendFixtureUnits,
            "x86_64-unknown-linux-gnu", true, true);
        units_check(batch != null, "backend cancellation batch");
        if active != 0 { backend_units_step(batch, false); }
        backend_units_cancel(batch);
        // A polling step may finish tiny objects first. In that case cancellation
        // is correctly a no-op; unfinished work must be drained and hidden.
        units_check(backend_units_step(batch, false), "backend cancellation drained");
        if backend_units_cancelled(batch) {
            units_check(backend_units_result(batch, 1) == null, "cancelled backend output hidden");
        }
        backend_units_close(batch);
        var streaming = backend_units_inputs(8, BackendFixtureUnits, root, bedrock.data, foundation.data);
        defer frontend_units_close(streaming);
        batch = backend_units_create(streaming, BackendFixtureUnits, BackendFixtureUnits,
            "x86_64-unknown-linux-gnu", true, true);
        units_check(batch != null, "stream cancellation batch");
        if active != 0 { backend_units_step(batch, false); }
        backend_units_cancel(batch);
        units_check(backend_units_step(batch, false), "stream cancellation drained");
        if backend_units_cancelled(batch) {
            units_check(backend_units_result(batch, 1) == null && frontend_units_cancelled(streaming), "stream cancellation hides all phases");
        }
        backend_units_close(batch);
    }
    puts("Native backend units: real frontend/LLVM overlap, shared budgets, deterministic objects/errors and cancellation passed.");
}
