var UnitAdmissionWorkers: usize = 2;
var UnitAdmissionBytes: usize = 268435456;
var UnitAdmissionPauseMicroseconds: u32 = 1000;
struct UnitAdmission {
    budget: WorkBudget*; world: void*; nested: WorkPool; grant: WorkReservation;
    entered: void*; outer_thread: usize; nested_thread: usize; next_thread: usize;
    released_ns: u64; entered_ns: u64; cancel: bool;
}

// The real nested grammar kernel waits until the outer coordinator has failed
// lane admission. This predicate is read under the same gate as its writers;
// no timing guess is needed to place the release after the Capacity branch.
fn unit_admission_nested(payload: void*): void {
    var state = bits(UnitAdmission*, payload);
    state.nested_thread = pthread_self();
    var started = unit_stream_clock();
    loop {
        state.budget.enter(state.budget.gate);
        var blocked = state.budget.error == WorkBudgetError.Capacity;
        state.budget.leave(state.budget.gate);
        if blocked { break; }
        units_check(unit_stream_elapsed(started) < UnitStreamTimeoutNanoseconds, "outer admission reaches Capacity");
        usleep(UnitAdmissionPauseMicroseconds);
    }
    units_check(frontend_world_bedrock(state.world) != null, "nested world-owned grammar construction");
}

fn unit_admission_observe(payload: void*, phase: CompilerQuery, ordinal: usize, entering: bool): void {
    if phase != CompilerQuery.Unit || !entering { return; }
    var state = bits(UnitAdmission*, payload);
    if ordinal == 1 {
        state.outer_thread = pthread_self();
        units_check(work_pool_submit(&state.nested, payload), "nested ready grammar dispatch");
        units_check(work_pool_receive(&state.nested, true) == payload, "nested grammar join");
        state.released_ns = unit_stream_clock();
        units_check(work_budget_release_result(state.budget, &state.grant) == WorkBudgetError.None, "nested lane release");
        if state.cancel { return; }
        var started = unit_stream_clock();
        while !work_signal_try(state.entered) {
            units_check(unit_stream_elapsed(started) < UnitStreamTimeoutNanoseconds,
                "released nested lane must start ready unit before its parent completes");
            usleep(UnitAdmissionPauseMicroseconds);
        }
    } else { if ordinal == 2 {
        state.next_thread = pthread_self();
        state.entered_ns = unit_stream_clock();
        work_signal_post(state.entered);
    } }
}

fn unit_admission_trial(root: u8*, bedrock: u8*, foundation: u8*, workers: usize, cancel: bool, output: vector(u8)*): void {
    var sources: u8*[3];
    sources[0] = "import tower; fn answer():i32{return 42;}";
    sources[1] = "import tower; fn answer():i32{var sum:i32=0;for(var i:i32=0;i<43;i++){sum+=1;}return sum;}";
    sources[2] = "import tower; fn id(T:type,x:T):T{return x;} fn answer():i32{return id(comptime(later()));} fn later():i32{return 44;}";
    var count = sizeof(decltype(sources)) / sizeof(u8*);
    var batch = frontend_units_create_bounded(count, workers, UnitAdmissionBytes, 8, 1, 1, bedrock, foundation, root);
    units_check(batch != null, "admission batch");
    var state: UnitAdmission = default;
    // The fixture's nested transport models an existing parser/semantic pool;
    // only one granted slot runs. No pool is added to the production scheduler.
    defer frontend_units_close(batch);
    defer work_pool_close(&state.nested);
    state.budget = frontend_units_work_budget(batch);
    state.world = frontend_modules_world(frontend_units_environment(batch, 1));
    state.cancel = cancel;
    state.entered = work_signal_open();
    units_check(state.entered != null, "admission observer signal");
    defer work_signal_close(state.entered);
    for(var i: usize = 0; i < count; i++) {
        units_check(frontend_units_source(batch, i + 1, "admission.tower", sources[i], strlen(sources[i])), "admission source");
    }
    if workers > 1 {
        units_check(work_pool_open_kernel_budget(&state.nested, UnitAdmissionWorkers, unit_admission_nested, state.budget), "nested grammar transport");
        units_check(work_budget_reserve_result(state.budget, 1, 1, 0, &state.grant) == WorkBudgetError.None, "nested grammar grant");
        units_check(frontend_units_observer(batch, bits(void*, &state), unit_admission_observe), "admission observer");
    }
    if cancel {
        frontend_units_step(batch, false);
        frontend_units_cancel(batch);
        units_check(frontend_units_cancelled(batch), "admission cancellation");
        for(var i: usize = 0; i < count; i++) { units_check(frontend_units_program(batch, i + 1) == null, "cancelled admission hides output"); }
    } else {
        while !frontend_units_step(batch, true) {}
        units_check(!frontend_units_cancelled(batch) && frontend_units_failed(batch) == 0, "admission compilation succeeds");
        for(var i: usize = 0; i < count; i++) {
            var program = frontend_units_program(batch, i + 1);
            units_check(program != null, "admission result");
            var formatted: FormatResult = default;
            format_entity(&formatted, program.root, compiler_node_type(program.root, CompilerSyntax),
                compiler_node_type(program.root, CompilerFoundation), compiler_node_type(program.root, CompilerParserMatch));
            units_check(!formatted.failed, "admission canonical Foundation");
            foreach(var byte in &formatted.text) { units_check(vector_push(output, byte), "admission canonical bytes"); }
            format_dispose(&formatted);
        }
        if workers > 1 {
            units_check(state.outer_thread != state.nested_thread && state.outer_thread != state.next_thread
                && state.entered_ns >= state.released_ns, "nested and ready outer work use distinct live threads");
            var text: FormatResult = default;
            var out: FormatEngine = { result: &text, ..default };
            format_text(&out, "Nested release to ready outer start ns=");
            format_unsigned(&out, state.entered_ns - state.released_ns);
            units_check(!text.failed && vector_push(&text.text, 0), "admission idle report");
            puts(text.text.data); format_dispose(&text);
        }
    }
    var snapshot: WorkBudgetSnapshot = default;
    units_check(work_budget_snapshot(state.budget, &snapshot) && snapshot.used_lanes == 0
        && snapshot.peak_lanes <= workers && snapshot.peak_bytes <= snapshot.bytes && !state.grant.active,
        "outer and nested admission stay within one ledger and drain");
}

export fn backend_units_admission_tests(root: u8*): void {
    var bedrock: vector(u8) = default; var foundation: vector(u8) = default;
    var serial: vector(u8) = default; var parallel: vector(u8) = default;
    defer { vector_dispose(&bedrock); vector_dispose(&foundation); vector_dispose(&serial); vector_dispose(&parallel); }
    units_read(root, "/bedrock.tower", &bedrock); units_read(root, "/foundation.tower", &foundation);
    unit_admission_trial(root, bedrock.data, foundation.data, 1, false, &serial);
    unit_admission_trial(root, bedrock.data, foundation.data, UnitAdmissionWorkers, false, &parallel);
    units_check(serial.length == parallel.length, "admission serial/parallel canonical length");
    for(var i: usize = 0; i < serial.length; i++) { units_check(serial.data[i] == parallel.data[i], "admission serial/parallel canonical bytes"); }
    unit_admission_trial(root, bedrock.data, foundation.data, UnitAdmissionWorkers, true, &parallel);
    puts("Nested lane release refills outer work, preserves canonical output and drains cancellation.");
}

var UnitStreamTimeoutNanoseconds: u64 = 30000000000;
var UnitStreamHeldFrontend: usize = 2;
var UnitStreamFirstBackend: usize = 1;
struct UnitStreamOverlap {
    backend_entered: void*;
    frontend_released: void*;
    frontend_thread: usize;
    backend_thread: usize;
    frontend_wait_ns: u64;
}

fn unit_stream_elapsed(started: u64): u64 {
    var now = unit_stream_clock();
    units_check(now >= started, "stream monotonic clock does not move backwards");
    return now - started;
}

// One private line per event, flushed before an assertion can abort. This uses
// no shared timing state and does not change admission or the overlap deadline.
fn unit_stream_trace(phase: CompilerQuery, ordinal: usize, event: u8*): void {
    var now = unit_stream_clock();
    var text: FormatResult = default;
    defer format_dispose(&text);
    var out: FormatEngine = { result: &text, ..default };
    format_text(&out, "Stream event ns=");
    format_unsigned(&out, now);
    format_text(&out, phase == CompilerQuery.Unit ? " frontend=" : " backend=");
    format_unsigned(&out, convert(u64, ordinal));
    format_text(&out, " ");
    format_text(&out, event);
    format_text(&out, " thread=");
    format_unsigned(&out, convert(u64, pthread_self()));
    units_check(!text.failed && vector_push(&text.text, 0), "stream trace formatting");
    puts(text.text.data);
    fflush(null);
}

fn unit_stream_wait(signal: void*, diagnostic: u8*, phase: CompilerQuery, ordinal: usize, wait_ns: u64): void {
    units_check(wait_ns >= UnitStreamTimeoutNanoseconds && wait_ns < ~convert(u64, 0), "stream finite wait bound");
    var started = unit_stream_clock();
    while !work_signal_try(signal) {
        if unit_stream_elapsed(started) >= wait_ns {
            unit_stream_trace(phase, ordinal, "timeout");
            units_check(false, diagnostic);
        }
        sched_yield();
    }
}

fn unit_stream_observe(payload: void*, phase: CompilerQuery, ordinal: usize, entering: bool): void {
    unit_stream_trace(phase, ordinal, entering ? "enter" : "leave");
    if !entering { return; }
    var overlap = bits(UnitStreamOverlap*, payload);
    if phase == CompilerQuery.Unit && ordinal == UnitStreamHeldFrontend {
        overlap.frontend_thread = pthread_self();
        unit_stream_wait(overlap.backend_entered,
            "frontend/backend overlap deadline: frontend unit 2 awaits backend unit 1", phase, ordinal, overlap.frontend_wait_ns);
        work_signal_post(overlap.frontend_released);
    }
    if phase == CompilerQuery.Backend && ordinal == UnitStreamFirstBackend {
        overlap.backend_thread = pthread_self();
        work_signal_post(overlap.backend_entered);
        unit_stream_wait(overlap.frontend_released,
            "frontend/backend overlap deadline: backend unit 1 awaits frontend unit 2", phase, ordinal, UnitStreamTimeoutNanoseconds);
    }
}

var BackendFixtureUnits: usize = 4;
var BackendFixtureRevision: u64 = 75;
var BackendFixtureProfile: u64 = 19;

export fn backend_units_ir_tests(root: u8*): void {
    var bedrock: vector(u8) = default; var foundation: vector(u8) = default;
    var references: vector(u8) = default;
    defer { vector_dispose(&bedrock); vector_dispose(&foundation); vector_dispose(&references); }
    units_read(root, "/bedrock.tower", &bedrock); units_read(root, "/foundation.tower", &foundation);
    units_read(root, "/tests/backend_execution_roots.tower", &references);
    var sources: u8*[3];
    sources[0] = "import tower; export fn answer():i32{return 42;}";
    sources[1] = references.data;
    sources[2] = "import tower; struct Pair{left:i32;right:i32;} fn use(value:i32):i32{var pair:Pair;pair.left=value;pair.right=2;return pair.left+pair.right;} export fn answer():i32{return use(40);}";
    var count = sizeof(decltype(sources)) / sizeof(u8*);
    var frontend = frontend_units_create(count, 1, 8, BackendFixtureRevision, BackendFixtureProfile, bedrock.data, foundation.data, root);
    units_check(frontend != null, "IR policy frontend");
    defer frontend_units_close(frontend);
    for(var i: usize = 0; i < count; i++) {
        units_check(frontend_units_source(frontend, i + 1, "backend_retention.tower", sources[i], strlen(sources[i])), "IR policy input");
    }
    while !frontend_units_step(frontend, true) {}
    units_check(frontend_units_failed(frontend) == 0 && !frontend_units_cancelled(frontend), "IR policy checked Foundation");
    var policies: bool[2]; policies[0] = true; policies[1] = false;
    var variants = sizeof(decltype(policies)) / sizeof(bool);
    for(var optimize: usize = 0; optimize < variants; optimize++) {
        var reference_bytes: vector(u8) = default;
        defer vector_dispose(&reference_bytes);
        for(var policy: usize = 0; policy < variants; policy++) {
            var retain = policies[policy];
            var batch = backend_units_create(frontend, count, retain ? 1 : count,
                "x86_64-pc-linux-gnu", true, policies[optimize]);
            units_check(batch != null && backend_units_library(batch, 2, false), "IR policy backend/global entry");
            defer backend_units_close(batch);
            // Default is deliberately tested too: existing consumers still own
            // both text snapshots without opting in to the new policy.
            if !retain { units_check(backend_units_retain_ir(batch, false), "IR policy before dispatch"); }
            while !backend_units_step(batch, true) {}
            units_check(!backend_units_cancelled(batch) && backend_units_failed(batch) == 0, "IR policy backend success");
            units_check(!backend_units_retain_ir(batch, true), "IR policy frozen after dispatch");
            var compared: usize = 0;
            for(var ordinal: usize = 1; ordinal <= count; ordinal++) {
                var result = backend_units_result(batch, ordinal);
                units_check(result != null && !backend_retain_ir(result, !retain), "IR policy frozen after lowering");
                var raw = backend_raw(result); var optimized = backend_optimized(result);
                units_check(retain ? (raw != null && raw[0] != 0 && optimized != null && optimized[0] != 0)
                    : (raw == null && optimized == null), "IR views match explicit/default retention policy");
                var bytes = backend_bytes(result);
                for(var i: usize = 0; i < backend_size(result); i++) {
                    if retain { units_check(vector_push(&reference_bytes, bytes[i]), "IR policy reference object"); }
                    else { units_check(compared < reference_bytes.length && reference_bytes.data[compared] == bytes[i], "IR policy exact object bytes"); }
                    compared++;
                }
            }
            units_check(compared == reference_bytes.length, "IR policy exact combined object size");
        }
    }
    var invalid = backend_units_create(frontend, count, count, "not-a-real-target", true, false);
    units_check(invalid != null && backend_units_retain_ir(invalid, false), "IR policy error setup");
    while !backend_units_step(invalid, true) {}
    units_check(backend_units_failed(invalid) == 1 && backend_units_error(invalid)[0] != 0
        && backend_units_result(invalid, 1) == null, "IR policy preserves ordered errors and hidden output");
    backend_units_close(invalid);
    var cancelled = backend_units_create(frontend, count, count, "x86_64-pc-linux-gnu", true, false);
    units_check(cancelled != null && backend_units_retain_ir(cancelled, false)
        && backend_units_library(cancelled, 2, false), "IR policy cancellation setup");
    backend_units_step(cancelled, false);
    backend_units_cancel(cancelled);
    units_check(backend_units_step(cancelled, false), "IR policy cancellation drains");
    if backend_units_cancelled(cancelled) { units_check(backend_units_result(cancelled, 1) == null, "IR policy cancellation hides output"); }
    backend_units_close(cancelled);
    puts("Backend IR retention: exact serial/parallel objects, references/types/globals, optimization, errors and cancellation passed.");
}

fn backend_units_inputs(width: u32, budget: usize, root: u8*, bedrock: u8*, foundation: u8*): void* {
    var frontend = frontend_units_create(BackendFixtureUnits, budget, width,
        BackendFixtureRevision, BackendFixtureProfile, bedrock, foundation, root);
    units_check(frontend != null, "backend frontend create");
    var source: u8* = "import tower; export fn answer():i32 {var x:decltype(later())=comptime(later());return x;} fn later():i32{return 42;}";
    for(var ordinal: usize = 1; ordinal <= BackendFixtureUnits; ordinal++) {
        units_check(frontend_units_source(frontend, ordinal, "backend_unit.tower", source, strlen(source)), "backend source");
    }
    return frontend;
}

fn backend_units_frontend(width: u32, root: u8*, bedrock: u8*, foundation: u8*): void* {
    var frontend = backend_units_inputs(width, 1, root, bedrock, foundation);
    while !frontend_units_step(frontend, true) {}
    units_check(frontend_units_failed(frontend) == 0 && !frontend_units_cancelled(frontend), "backend frontend completed");
    return frontend;
}

// Read only at a joined phase boundary under the existing exclusive lease.
// Backend queries extend this shared graph even when objects have a separate ledger.
fn backend_units_anchor(frontend: void*): Entity* {
    var work = frontend_units_work_acquire(frontend);
    units_check(work != null, "backend component storage inspection lease");
    defer frontend_units_work_release(frontend);
    return bits(Entity*, compiler_work_anchor(work));
}

fn backend_units_count_storage(allocations: vector(u8*)*, result: WorkBudgetSnapshot*,
    buffer: WorkBuffer*, budget: WorkBudget*): void {
    foreach(var allocation in allocations) { if allocation == buffer.data { return; } }
    units_check(vector_push(allocations, buffer.data), "backend storage receipt index");
    units_check(buffer.reservation.active && buffer.reservation.owner == budget,
        "coordinator storage retains its frontend physical grant");
    result.used_bytes += buffer.reservation.bytes;
    result.live++;
}

// The frontend keeps this stable anchor alive. Read component receipts only
// before dispatch or after every job joins, while the caller owns publication.
fn backend_units_component_storage(anchor: Entity*, budget: WorkBudget*): WorkBudgetSnapshot {
    var allocations: vector(u8*) = default;
    defer vector_dispose(&allocations);
    var result: WorkBudgetSnapshot = default;
    for(var row: usize = 0; row <= anchor.child_count; row++) {
        var node = row == 0 ? anchor : anchor.children[row - 1].entity;
        for(var index: usize = 0; index < node.component_count; index++) {
            var component = node.components[index];
            var buffer = component.page == null
                ? &bits(EntityComponentAllocation*, component).allocation
                : &component.page.allocation;
            backend_units_count_storage(&allocations, &result, buffer, budget);
            // Registered kinds own a separately charged instance index. The
            // backend kind and its index die together after the last component;
            // count the actual physical receipt once, just like shared pages.
            if component.type.instances != null {
                var allocation = bits(u8*, component.type.instances) - sizeof(EntityBufferAllocation);
                backend_units_count_storage(&allocations, &result,
                    &bits(EntityBufferAllocation*, allocation).allocation, budget);
            }
        }
        // Removing the backend column restores the original archetype. Its
        // row/column allocation has a different stride; count both actual
        // receipts, not only component payload pages.
        if node.table != null && node.table.rows != null {
            var allocation = bits(u8*, node.table.rows) - sizeof(EntityBufferAllocation);
            backend_units_count_storage(&allocations, &result,
                &bits(EntityBufferAllocation*, allocation).allocation, budget);
        }
    }
    return result;
}

fn backend_units_storage_diagnostic(before: WorkBudgetSnapshot*, retained: WorkBudgetSnapshot*,
    released: WorkBudgetSnapshot*, components: WorkBudgetSnapshot*, remaining: WorkBudgetSnapshot*): void {
    var text: FormatResult = default;
    defer format_dispose(&text);
    var out: FormatEngine = { result: &text, ..default };
    format_text(&out, "Backend ledger bytes before/joined/released, component bytes joined/released: ");
    format_unsigned(&out, convert(u64, before.used_bytes)); format_text(&out, "/");
    format_unsigned(&out, convert(u64, retained.used_bytes)); format_text(&out, "/");
    format_unsigned(&out, convert(u64, released.used_bytes)); format_text(&out, ", ");
    format_unsigned(&out, convert(u64, components.used_bytes)); format_text(&out, "/");
    format_unsigned(&out, convert(u64, remaining.used_bytes));
    units_check(!text.failed && vector_push(&text.text, 0), "backend ledger diagnostic");
    puts(text.text.data); fflush(null);
}

fn backend_units_graph_storage(frontend: void*): WorkBudgetSnapshot {
    var work = frontend_units_work_acquire(frontend);
    units_check(work != null, "backend graph storage inspection lease");
    defer frontend_units_work_release(frontend);
    var graph = bits(WorkGraph*, compiler_work_graph(work));
    units_check(graph != null, "backend graph storage joined boundary");
    var buffers: WorkBuffer*[9];
    buffers[0] = &graph.storage.tasks;
    buffers[1] = &graph.storage.edges;
    buffers[2] = &graph.storage.task_index;
    buffers[3] = &graph.storage.edge_index;
    buffers[4] = &graph.storage.ready;
    buffers[5] = &graph.storage.scratch;
    buffers[6] = &graph.storage.frames;
    buffers[7] = &graph.storage.accesses;
    buffers[8] = &graph.storage.executing;
    var result: WorkBudgetSnapshot = default;
    for(var i: usize = 0; i < sizeof(decltype(buffers)) / sizeof(WorkBuffer*); i++) {
        var receipt = &buffers[i].reservation;
        if receipt.active {
            units_check(receipt.owner == frontend_units_work_budget(frontend), "shared graph owns frontend byte grants");
            result.used_bytes += receipt.bytes;
            result.live++;
        }
    }
    return result;
}

fn backend_units_trial(frontend: void*, budget: usize, target: u8*, output: vector(u8)*): void {
    var streaming = frontend_units_pending(frontend);
    var anchor = backend_units_anchor(frontend);
    var original_components = backend_units_component_storage(anchor, frontend_units_work_budget(frontend));
    var graph_before: WorkBudgetSnapshot = default;
    if !streaming { graph_before = backend_units_graph_storage(frontend); }
    var before: WorkBudgetSnapshot;
    units_check(work_budget_snapshot(frontend_units_work_budget(frontend), &before), "backend input accounting");
    var input_bytes = frontend_units_input_bytes(frontend);
    var output_bytes = units_memory_span_bytes(strlen(target));
    units_check(backend_units_create(frontend, ~convert(usize, 0), budget, target, true, true) == null,
        "backend rejects invalid count before allocating or walking units");
    var batch = backend_units_create(frontend, BackendFixtureUnits, budget, target, true, true);
    units_check(batch != null, "backend batch create");
    defer { if batch != null { backend_units_close(batch); } }
    if streaming { units_check(backend_units_retain_ir(batch, false), "streaming object-only IR policy"); }
    units_check(backend_units_result(batch, 1) == null, "backend unpublished output");
    units_check(backend_units_create(frontend, BackendFixtureUnits, budget, target, true, true) == null,
        "backend rejects competing graph owner");
    while !backend_units_step(batch, true) {}
    if backend_units_failed(batch) != 0 { puts(backend_units_error(batch)); }
    units_check(!backend_units_cancelled(batch) && backend_units_failed(batch) == 0, "backend compilation succeeds");
    for(var ordinal: usize = 1; ordinal <= BackendFixtureUnits; ordinal++) {
        var backend = backend_units_result(batch, ordinal);
        units_check(backend != null && backend_size(backend) != 0, "backend object produced");
        output_bytes += backend_size(backend);
        var bytes = backend_bytes(backend);
        for(var i: usize = 0; i < backend_size(backend); i++) {
            units_check(vector_push(output, bytes[i]), "backend object snapshot");
        }
    }
    units_check(backend_units_result(batch, BackendFixtureUnits + 1) == null, "backend invalid result ordinal");
    var retained: WorkBudgetSnapshot;
    units_check(work_budget_snapshot(frontend_units_work_budget(frontend), &retained)
        && retained.used_lanes == 0 && retained.peak_lanes <= retained.lanes
        && retained.peak_bytes <= retained.bytes && frontend_units_input_bytes(frontend) == input_bytes,
        "backend joins all shared execution grants");
    if streaming {
        units_check(retained.used_bytes >= before.used_bytes + output_bytes,
            "streaming objects retain their byte reservations after join");
    }
    var components = backend_units_component_storage(anchor, frontend_units_work_budget(frontend));
    // Streaming compilation also creates retained frontend tables. Measure the
    // exact backend release against the joined frontend baseline, not its
    // earlier state before parsing. Later targets use a separate backend ledger.
    backend_units_close(batch);
    batch = null;
    var released: WorkBudgetSnapshot;
    units_check(work_budget_snapshot(frontend_units_work_budget(frontend), &released)
        && released.used_lanes == 0 && released.peak_bytes <= released.bytes
        && frontend_units_input_bytes(frontend) == input_bytes, "Backend disposal preserves retained inputs and cap");
    var remaining = backend_units_component_storage(anchor, frontend_units_work_budget(frontend));
    units_check(remaining.used_bytes == original_components.used_bytes && remaining.live == original_components.live
        && components.used_bytes >= remaining.used_bytes && components.live >= remaining.live,
        "Backend disposal restores frontend component pages, kind indexes and archetype columns");
    var component_bytes = components.used_bytes - remaining.used_bytes;
    var component_owners = components.live - remaining.live;
    if streaming {
        var exact = retained.used_bytes == released.used_bytes + output_bytes + component_bytes
            && retained.live == released.live + BackendFixtureUnits + 1 + component_owners
            && released.used_bytes >= before.used_bytes && released.live >= before.live;
        if !exact { backend_units_storage_diagnostic(&before, &retained, &released, &components, &remaining); }
        units_check(exact, "Backend disposal releases exactly target, object and component receipts beside retained frontend owners");
    } else {
        var graph_after = backend_units_graph_storage(frontend);
        var exact = released.used_bytes + component_bytes == retained.used_bytes && released.live + component_owners == retained.live
            && released.used_bytes + graph_before.used_bytes == before.used_bytes + graph_after.used_bytes
            && released.live + graph_before.live == before.live + graph_after.live;
        if !exact { backend_units_storage_diagnostic(&before, &retained, &released, &components, &remaining); }
        units_check(exact, "Separate backend output releases leave exactly shared graph growth on the frontend ledger");
    }
}

fn backend_units_memory(frontend: void*, target: u8*): void {
    units_check(backend_units_create_bounded(frontend, BackendFixtureUnits, 1, 0, target, true, true) == null
        && backend_units_create_bounded(frontend, BackendFixtureUnits, 1, ~convert(usize, 0), target, true, true) == null,
        "bounded backend rejects missing or unbounded policy");
    var bytes = units_memory_span_bytes(strlen(target))
        + sizeof(WorkSlot) + UnitSnapshotHeaderWords * sizeof(usize);
    units_check(backend_units_create_bounded(frontend, BackendFixtureUnits, 1, bytes - 1, target, true, true) == null,
        "target and worker-slot cap rejection leaves frontend graph usable");
    var batch = backend_units_create_bounded(frontend, BackendFixtureUnits, 1, bytes, target, true, true);
    units_check(batch != null, "exact target and one worker-slot storage admitted before allocation");
    defer backend_units_close(batch);
    while !backend_units_step(batch, true) {}
    units_check(!backend_units_cancelled(batch) && backend_units_failed(batch) == 1
        && strcmp(backend_units_error(batch), "Unable to reserve retained backend output") == 0
        && backend_units_result(batch, 1) == null, "denied object output is reclaimed before failed publication");
}

fn backend_units_stream_trial(width: u32, budget: usize, root: u8*, bedrock: u8*, foundation: u8*,
    target: u8*, serial: vector(u8)*, parallel: vector(u8)*, frontend_wait_ns: u64): void {
    var streaming = backend_units_inputs(width, budget, root, bedrock, foundation);
    defer frontend_units_close(streaming);
    var overlap: UnitStreamOverlap = default;
    overlap.frontend_wait_ns = frontend_wait_ns;
    overlap.backend_entered = work_signal_open();
    overlap.frontend_released = work_signal_open();
    units_check(overlap.backend_entered != null && overlap.frontend_released != null, "stream overlap signals");
    defer work_signal_close(overlap.backend_entered);
    defer work_signal_close(overlap.frontend_released);
    if budget > 1 {
        units_check(frontend_units_observer(streaming, bits(void*, &overlap), unit_stream_observe), "stream observer");
    }
    parallel.length = 0;
    backend_units_trial(streaming, budget, target, parallel);
    units_check(frontend_units_failed(streaming) == 0 && !frontend_units_cancelled(streaming), "stream frontend success");
    units_check(frontend_units_peak(streaming) <= budget, "shared frontend/backend budget");
    units_check(serial.length == parallel.length, "stream deterministic object lengths");
    for(var i: usize = 0; i < serial.length; i++) {
        units_check(serial.data[i] == parallel.data[i], "stream deterministic object bytes");
    }
    if budget > 1 {
        units_check(overlap.frontend_thread != 0 && overlap.backend_thread != 0
            && overlap.frontend_thread != overlap.backend_thread
            && overlap.frontend_thread != pthread_self() && overlap.backend_thread != pthread_self(),
            "actual frontend/backend overlap on distinct worker threads");
    }
}

fn unit_stream_calibration(baseline_ns: u64, wait_ns: u64): void {
    var text: FormatResult = default;
    defer format_dispose(&text);
    var out: FormatEngine = { result: &text, ..default };
    format_text(&out, "Backend overlap calibration: serial_frontend_ns=");
    format_unsigned(&out, baseline_ns);
    format_text(&out, " frontend_wait_ns=");
    format_unsigned(&out, wait_ns);
    format_text(&out, " backend_wait_ns=");
    format_unsigned(&out, UnitStreamTimeoutNanoseconds);
    units_check(!text.failed && vector_push(&text.text, 0), "stream calibration formatting");
    puts(text.text.data);
    fflush(null);
}

// Calibration measures the already-required complete serial frontend batch.
// The resulting bound is frozen before dispatch and only covers frontend 2's
// wait for backend 1; the backend acknowledgement always has the original bound.
fn backend_units_overlap_run(root: u8*, calibrated: bool): void {
    var bedrock: vector(u8) = default;
    var foundation: vector(u8) = default;
    var serial: vector(u8) = default;
    var parallel: vector(u8) = default;
    defer vector_dispose(&bedrock);
    defer vector_dispose(&foundation);
    defer vector_dispose(&serial);
    defer vector_dispose(&parallel);
    units_read(root, "/bedrock.tower", &bedrock);
    units_read(root, "/foundation.tower", &foundation);
    puts("Backend overlap: preparing the serial 64-bit object baseline");
    fflush(null);
    var started: u64 = 0;
    if calibrated { started = unit_stream_clock(); }
    var frontend = backend_units_frontend(8, root, bedrock.data, foundation.data);
    defer frontend_units_close(frontend);
    var wait_ns = UnitStreamTimeoutNanoseconds;
    if calibrated {
        var baseline_ns = unit_stream_elapsed(started);
        if baseline_ns > wait_ns { wait_ns = baseline_ns; }
        unit_stream_calibration(baseline_ns, wait_ns);
    }
    var target: u8* = "x86_64-unknown-linux-gnu";
    backend_units_trial(frontend, 1, target, &serial);
    puts("Backend overlap: running the existing two-worker streaming case");
    fflush(null);
    backend_units_stream_trial(8, 2, root, bedrock.data, foundation.data, target, &serial, &parallel, wait_ns);
    puts("Backend overlap: exact objects and distinct worker overlap passed");
}

export fn backend_units_overlap_tests(root: u8*): void {
    backend_units_overlap_run(root, false);
}

export fn backend_units_overlap_calibrated_tests(root: u8*): void {
    backend_units_overlap_run(root, true);
}

struct BackendBaselineBorrow { world: void*; view: void*; }

fn backend_baseline_borrow(context: void*, phase: CompilerQuery, ordinal: usize, entering: bool): void {
    if phase == CompilerQuery.Backend && ordinal == 1 && entering {
        var borrow = bits(BackendBaselineBorrow*, context);
        borrow.view = entity_view_open(frontend_world_bedrock(borrow.world));
        units_check(borrow.view != null, "hold an independent grammar-world view");
    }
}

fn backend_units_one_shot_test(root: u8*, bedrock: u8*, foundation: u8*, link_only: bool): void {
    var frontend = backend_units_inputs(8, 1, root, bedrock, foundation);
    defer frontend_units_close(frontend);
    var borrow: BackendBaselineBorrow = default;
    borrow.world = frontend_modules_world(frontend_units_environment(frontend, 1));
    var other = frontend_modules_world(frontend_units_environment(frontend, 2));
    units_check(frontend_units_observer(frontend, bits(void*, &borrow), backend_baseline_borrow), "install backend view observer");
    var batch = backend_units_create(frontend, BackendFixtureUnits, 1, "x86_64-unknown-linux-gnu", true, false);
    units_check(link_only ? backend_units_link_only(batch) : backend_units_one_shot(batch), "enable one-shot streaming cleanup");
    defer backend_units_close(batch);
    while !backend_units_step(batch, true) {}
    units_check(backend_units_result(batch, 2) != null && (frontend_units_program(frontend, 2) == null) == link_only
        && compiler_world_grammar(other).syntax == null, "object survives and only the exclusive linker consumes the unpinned program");
    units_check(borrow.view != null && frontend_units_program(frontend, 1) != null && compiler_world_grammar(borrow.world).syntax != null, "independently pinned baseline survives join");
    entity_view_close(borrow.view);
    units_memory_answer(frontend_units_program(frontend, 1));
    if !link_only { units_memory_answer(frontend_units_program(frontend, 2)); }
}

export fn backend_units_tests(root: u8*): void {
    work_named_tests();
    var bedrock: vector(u8) = default;
    var foundation: vector(u8) = default;
    defer vector_dispose(&bedrock);
    defer vector_dispose(&foundation);
    units_read(root, "/bedrock.tower", &bedrock);
    units_read(root, "/foundation.tower", &foundation);
    backend_units_one_shot_test(root, bedrock.data, foundation.data, false);
    backend_units_one_shot_test(root, bedrock.data, foundation.data, true);
    for(var width: u32 = 4; width <= 8; width += 4) {
        var frontend = backend_units_frontend(width, root, bedrock.data, foundation.data);
        defer frontend_units_close(frontend);
        var target: u8* = width == 4 ? "wasm32-unknown-unknown" : "x86_64-unknown-linux-gnu";
        backend_units_memory(frontend, target);
        var serial: vector(u8) = default;
        var parallel: vector(u8) = default;
        defer vector_dispose(&serial);
        defer vector_dispose(&parallel);
        backend_units_trial(frontend, 1, target, &serial);
        backend_units_trial(frontend, BackendFixtureUnits, target, &parallel);
        units_check(serial.length == parallel.length, "backend deterministic object lengths");
        for(var i: usize = 0; i < serial.length; i++) {
            units_check(serial.data[i] == parallel.data[i], "backend deterministic object bytes");
        }
        // A held frontend worker cannot finish until an earlier unit enters
        // LLVM on a different worker. A whole-frontend barrier times out here;
        // queued work or timing-dependent sample observations cannot pass it.
        for(var budget: usize = 1; budget <= BackendFixtureUnits; budget *= 2) {
            backend_units_stream_trial(width, budget, root, bedrock.data, foundation.data,
                target, &serial, &parallel, UnitStreamTimeoutNanoseconds);
        }
        for(var budget: usize = 1; budget <= BackendFixtureUnits; budget += BackendFixtureUnits - 1) {
            var failure = backend_units_create(frontend, BackendFixtureUnits, budget,
                "not-a-real-target", true, true);
            units_check(failure != null, "backend invalid-target batch");
            while !backend_units_step(failure, true) {}
            units_check(backend_units_failed(failure) == 1 && backend_units_error(failure)[0] != 0,
                "backend deterministic first diagnostic");
            units_check(backend_units_result(failure, 1) == null, "failed backend never publishes");
            backend_units_close(failure);
        }
        parallel.length = 0;
        backend_units_trial(frontend, BackendFixtureUnits, target, &parallel);
        units_check(serial.length == parallel.length, "backend retry after failed queries");
        for(var i: usize = 0; i < serial.length; i++) {
            units_check(serial.data[i] == parallel.data[i], "backend retry preserves object bytes");
        }
    }
    for(var budget: usize = 1; budget <= BackendFixtureUnits; budget += BackendFixtureUnits - 1) {
        var frontend = backend_units_inputs(8, budget, root, bedrock.data, foundation.data);
        defer frontend_units_close(frontend);
        var first: u8* = "import tower; fn bad():i32{return unknownFirstStream;}";
        var later: u8* = "import tower; fn bad():i32{return unknownLaterStream;}";
        units_check(frontend_units_source(frontend, 2, "first_stream_failure.tower", first, strlen(first))
            && frontend_units_source(frontend, 3, "later_stream_failure.tower", later, strlen(later)), "stream failing sources");
        var batch = backend_units_create(frontend, BackendFixtureUnits, budget, "x86_64-unknown-linux-gnu", true, true);
        units_check(batch != null && (budget == 1 || backend_units_link_only(batch)), "stream failure create");
        while !backend_units_step(batch, true) {}
        units_check(frontend_units_failed(frontend) == 2 && !frontend_units_cancelled(frontend)
            && strstr(frontend_units_error(frontend), "unknownFirstStream") != null, "stream deterministic frontend failure");
        units_check(backend_units_result(batch, 1) == null, "frontend failure hides already compiled objects");
        backend_units_close(batch);
        var invalid = backend_units_inputs(8, budget, root, bedrock.data, foundation.data);
        defer frontend_units_close(invalid);
        batch = backend_units_create(invalid, BackendFixtureUnits, budget, "not-a-real-target", true, true);
        units_check(batch != null, "stream invalid target create");
        while !backend_units_step(batch, true) {}
        units_check(!backend_units_cancelled(batch) && backend_units_failed(batch) == 1
            && backend_units_result(batch, 1) == null, "stream deterministic backend failure");
        backend_units_close(batch);
    }
    for(var active: usize = 0; active < 2; active++) {
        var frontend = backend_units_frontend(8, root, bedrock.data, foundation.data);
        defer frontend_units_close(frontend);
        var batch = backend_units_create(frontend, BackendFixtureUnits, BackendFixtureUnits,
            "x86_64-unknown-linux-gnu", true, true);
        units_check(batch != null, "backend cancellation batch");
        if active != 0 { backend_units_step(batch, false); }
        backend_units_cancel(batch);
        // A polling step may finish tiny objects first. In that case cancellation
        // is correctly a no-op; unfinished work must be drained and hidden.
        units_check(backend_units_step(batch, false), "backend cancellation drained");
        if backend_units_cancelled(batch) {
            units_check(backend_units_result(batch, 1) == null, "cancelled backend output hidden");
        }
        backend_units_close(batch);
        var streaming = backend_units_inputs(8, BackendFixtureUnits, root, bedrock.data, foundation.data);
        defer frontend_units_close(streaming);
        batch = backend_units_create(streaming, BackendFixtureUnits, BackendFixtureUnits,
            "x86_64-unknown-linux-gnu", true, true);
        units_check(batch != null && (active == 0 || backend_units_link_only(batch)), "stream cancellation batch");
        if active != 0 { backend_units_step(batch, false); }
        backend_units_cancel(batch);
        units_check(backend_units_step(batch, false), "stream cancellation drained");
        if backend_units_cancelled(batch) {
            units_check(backend_units_result(batch, 1) == null && frontend_units_cancelled(streaming), "stream cancellation hides all phases");
        }
        backend_units_close(batch);
    }
    puts("Native backend units: real frontend/LLVM overlap, shared budgets, deterministic objects/errors and cancellation passed.");
}
