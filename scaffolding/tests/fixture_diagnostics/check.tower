import library.test_fixtures;

fn diagnostic_bytes(text: u8*): FixtureBytes {
    return {data: text, length: fixture_text_length(text)};
}

fn check_diagnostic(name: u8*, source_suffix: u8*, message: u8*, offset: usize, line: usize, column: usize): void {
    var result = fixture_diagnostic(name);
    defer fixture_diagnostic_dispose(&result);
    var suffix = diagnostic_bytes(source_suffix);
    assert(result.file.length >= suffix.length, "missing diagnostic source");
    var tail: FixtureBytes = {data: result.file.data + (result.file.length - suffix.length), length: suffix.length};
    assert(fixture_equal(tail, suffix), "wrong diagnostic source");
    assert(result.offset == offset && result.line == line && result.column == column, "wrong diagnostic location");
    assert(fixture_equal(result.message, diagnostic_bytes(message)), "wrong diagnostic message or instantiation frame");
}
