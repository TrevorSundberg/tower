import tower;
import .host.memory;
import .library.work_arena;
import .library.work_arena_types;
import .library.work_budget_types;

extern fn tower_test_buffer_count(): usize;
extern fn tower_test_buffer_fail_after(count: usize): void;

struct ArenaFaultFixture {
    budget: WorkBudget;
    arena: WorkArena;
    baseline: usize;
}

// Only the attempted allocation runs with this process's serial fault counter armed.
fn arena_fault_allocate(arena: WorkArena*, bytes: usize, output: u8**): WorkBudgetError {
    tower_test_buffer_fail_after(0);
    defer tower_test_buffer_fail_after(~convert(usize, 0));
    return work_arena_allocate_result(arena, bytes, 8, output);
}
