import library.testing;
import module_body_type_checks;
import frontend_units;
import execution_support;
import world_budget;
import .compiler.execution_session;
import .compiler.format_types;
import .compiler.syntax_version_types;
import .library.vector;
import .library.work_budget;
import .library.work_pool;

extern fn compiler_world_create_result(workers: usize, budget: WorkBudget*, world: void**): WorkBudgetError;
extern fn frontend_world_clear(world: void*): bool;
extern fn frontend_modules_create(): void*;
extern fn frontend_modules_bind_world(environment: void*, world: void*): bool;
extern fn frontend_modules_destroy(environment: void*): void;
extern fn frontend_modules_configure(environment: void*, entry: u8*, library: u8*): void;
extern fn syntax_baseline_install(world: void*, environment: void*, source: u8*, foundation: bool, diagnostic: SyntaxVersionDiagnostic*): bool;
extern fn frontend_modules_location(environment: void*, offset: usize, line: usize*, column: usize*): u8*;
extern fn syntax_version_diagnostic_dispose(value: SyntaxVersionDiagnostic*): void;
extern fn printf(format: u8*, line: usize, column: usize): i32;


fn module_body_type_trial(root: u8*, bedrock: u8*, foundation: u8*, source: u8*, width: u32,
    workers: usize, wanted: u8*, error: ModuleBodyTypeFailure*, canonical: vector(u8)*, error_offset: usize*): bool {
    return module_body_type_trial_steps(root, bedrock, foundation, source, width, workers,
        wanted, error, canonical, error_offset, ModuleBodyTypeFuel);
}

fn module_body_type_trial_steps(root: u8*, bedrock: u8*, foundation: u8*, source: u8*, width: u32,
    workers: usize, wanted: u8*, error: ModuleBodyTypeFailure*, canonical: vector(u8)*, error_offset: usize*, fuel: usize): bool {
    var input = "module_body_type_input.tower";
    var expected_line: usize = 1; var expected_column: usize = 1;
    if error != null {
        var location = strstr(source, error.location);
        units_check(location != null, "Body type independent error token");
        for(var at = source; at != location; at++) {
            if *at == 10 { expected_line++; expected_column = 1; } else { expected_column++; }
        }
    }
    var gate = work_signal_open(); units_check(gate != null, "Body type budget gate");
    defer work_signal_close(gate); work_signal_post(gate);
    var budget: WorkBudget = default;
    units_check(work_budget_init(&budget, workers, ModuleBodyTypeBytes, 1)
        && work_budget_synchronize(&budget, gate, work_signal_wait, work_signal_post), "Body type explicit budget");
    var world: void* = null;
    units_check(compiler_world_create_result(workers, &budget, &world) == WorkBudgetError.None, "Body type world");
    var environment = frontend_modules_create();
    units_check(environment != null && frontend_modules_bind_world(environment, world), "Body type module owner");
    frontend_modules_configure(environment, input, root);
    var diagnostic: SyntaxVersionDiagnostic = default;
    var installed = syntax_baseline_install(world, environment, bedrock, false, &diagnostic)
        && syntax_baseline_install(world, environment, foundation, true, &diagnostic);
    syntax_version_diagnostic_dispose(&diagnostic); units_check(installed, "Body type baselines");
    var ok = true;
    for(var engine: usize = 0; engine < 2; engine++) {
        var session: ExecutionSession = default;
        var compiled = execution_session_compile(&session, source, strlen(source), width, environment);
        if !compiled {
            puts(session.error.data ?? "Missing compilation diagnostic");
            var line: usize = 0; var column: usize = 0;
            frontend_modules_location(environment, session.program.error_offset, &line, &column);
            printf("Body annotation diagnostic line=%zu column=%zu\n", line, column);
        }
        if error != null {
            units_check(!compiled && session.program.resource.error == WorkBudgetError.None
                && execution_text(&session.error, error.message), "Body type exact ordinary failure");
            var line: usize = 0; var column: usize = 0;
            var file = frontend_modules_location(environment, session.program.error_offset, &line, &column);
            printf("Body type expected line=%zu column=%zu\n", expected_line, expected_column);
            units_check(file != null && strcmp(file, input) == 0
                && line == expected_line && column == expected_column, "Body type independent mapped file/line/column");
            if *error_offset == 0 { *error_offset = session.program.error_offset; }
            units_check(session.program.error_offset == *error_offset && !execution_session_start(&session)
                && !execution_session_fast(&session) && session.machine.steps == 0,
                "Failed body annotation preserves offset and exposes no execution");
        } else {
            if !compiled { ok = false; execution_session_close(&session); break; }
            var formatted: FormatResult = default;
            format_entity(&formatted, session.program.root, null, null, null);
            units_check(!formatted.failed, "Body type canonical Foundation");
            if canonical.length == 0 {
                units_check(vector_reserve(canonical, formatted.text.length + 1), "Body type canonical receipt");
                copy(canonical.data, formatted.text.data, formatted.text.length);
                canonical.data[formatted.text.length] = 0; canonical.length = formatted.text.length;
            } else {
                units_check(canonical.length == formatted.text.length
                    && memcmp(canonical.data, formatted.text.data, canonical.length) == 0, "Body type canonical engine/worker equality");
            }
            format_dispose(&formatted);
            if engine != 0 { units_check(execution_session_fast(&session), "Body type Fast admission"); }
            execution_run(&session, 7, fuel);
            units_check(session.machine.done && !session.machine.failed && execution_text(&session.output, wanted),
                "Body type Graph/Fast reference output and exactly-once effects");
        }
        execution_session_close(&session);
    }
    frontend_modules_destroy(environment);
    units_check(frontend_world_clear(world) && compiler_world_dispose(world), "Body type world cleanup");
    var final: WorkBudgetSnapshot = default;
    units_check(work_budget_snapshot(&budget, &final) && final.used_bytes == 0 && final.live == 0
        && final.used_lanes == 0 && work_budget_dispose(&budget), "Body type final zero owners");
    return ok;
}

fn module_body_type_checks(root: u8*, mode: u8*): i32 {
    var bedrock: vector(u8) = default; var foundation: vector(u8) = default;
    var minimal: vector(u8) = default; var source: vector(u8) = default;
    defer vector_dispose(&source); defer vector_dispose(&minimal);
    defer vector_dispose(&foundation); defer vector_dispose(&bedrock);
    units_read(root, "/bedrock.tower", &bedrock); units_read(root, "/foundation.tower", &foundation);
    units_read(root, "/tests/module_body_type_minimal.tower", &minimal);
    if strcmp(mode, "body-type-reproduce") == 0 {
        var canonical: vector(u8) = default; defer vector_dispose(&canonical);
        var offset: usize = 0;
        return module_body_type_trial(root, bedrock.data, foundation.data, minimal.data, 4, 1, "", null, &canonical, &offset) ? 0 : 1;
    }
    units_check(strcmp(mode, "body-type-queries") == 0, "Body type selector");
    units_read(root, "/tests/module_body_type_queries.tower", &source);
    var control = "import tower;fn box(T:type):type{struct Item{value:T;}return Item;}fn forwarded(T:type):type{return box(T);}fn run(seed:usize):usize{var item:box(decltype(seed));item.value=seed;var same:forwarded(decltype(seed))* = &item;{var seed:i16=7;var nested:forwarded(decltype(seed));nested.value=seed;print(nested.value);}same.value++;return item.value;}print(run(41));print(sizeof(usize));";
    var unknown = "import tower;for(var address:usize=0;address<1;address++){var value:unknown(decltype(address));}";
    var recursive = "import tower;fn broken(T:type):type{struct Recursive{value:Recursive;}return Recursive;}fn forwarded(T:type):type{return broken(T);}for(var address:usize=0;address<1;address++){var value:forwarded(decltype(address));}";
    var unknown_failure = init(ModuleBodyTypeFailure) { message: "Unknown type constructor 'unknown'", location: "unknown(decltype(address))" };
    var recursive_failure = init(ModuleBodyTypeFailure) {
        message: "Recursive by-value layout: broken(usize) -> broken(usize); use a pointer\nInstantiated by broken(T) at line 1, column 122.\nInstantiated by  at line 1, column 1.",
        location: "struct Recursive" };
    for(var width: u32 = 4; width <= 8; width *= 2) {
        var exact: vector(u8) = default; var canonical: vector(u8) = default; var nested: vector(u8) = default;
        defer vector_dispose(&nested); defer vector_dispose(&canonical); defer vector_dispose(&exact);
        var offset: usize = 0; var unknown_offset: usize = 0; var recursive_offset: usize = 0;
        var wanted = width == 4 ? "42\n4\n7\n2\ntrue\ntrue\n43\n4\n7\n2\ntrue\ntrue\n2\n2\n2\n" : "42\n8\n7\n2\ntrue\ntrue\n43\n8\n7\n2\ntrue\ntrue\n2\n2\n2\n";
        for(var workers: usize = 1; workers <= 4; workers *= 4) {
            units_check(module_body_type_trial(root, bedrock.data, foundation.data, minimal.data, width, workers, "", null, &exact, &offset), "Exact loop body source");
            units_check(module_body_type_trial(root, bedrock.data, foundation.data, source.data, width, workers, wanted, null, &canonical, &offset), "Module body nominal alias and header frame");
            units_check(module_body_type_trial(root, bedrock.data, foundation.data, control, width, workers,
                width == 4 ? "7\n42\n4\n" : "7\n42\n8\n", null, &nested, &offset), "Function and nested lexical control");
            module_body_type_trial(root, bedrock.data, foundation.data, unknown, width, workers, "", &unknown_failure, &exact, &unknown_offset);
            module_body_type_trial(root, bedrock.data, foundation.data, recursive, width, workers, "", &recursive_failure, &exact, &recursive_offset);
            printf("Body type width=%zu workers=%zu checked\n", convert(usize, width) * 8, workers);
        }
        var roundtrip: vector(u8) = default; defer vector_dispose(&roundtrip);
        units_check(module_body_type_trial(root, bedrock.data, foundation.data, canonical.data, width, 4, wanted, null, &roundtrip, &offset), "Module body canonical Graph/Fast round trip");
    }
    return 0;
}

test() { assert(module_body_type_checks(".", "body-type-reproduce") == 0, "Minimal module body"); }
test() { assert(module_body_type_checks(".", "body-type-queries") == 0, "Module body type queries"); }
