import tower;

// Existing Foundation operand captures remain usable inside Tower loop bodies.
parse Statement |= 'show' $value:CoreOperand ';'
    => replace { print($value); };
for (var n = 0; n < 2; n++) {
    show n == n;
}

var starts = 0;
var checks = 0;
var steps = 0;

fn start(): i32 {
    starts++;
    return 0;
}

fn test(value: i32): bool {
    checks++;
    return value < 4;
}

fn advance(value: i32*): void {
    steps++;
    (*value)++;
}

var sum = 0;
for (var i = start(); test(i); advance(&i)) {
    if i == 1 {
        continue;
    }
    sum += i;
}
print(starts == 1 && checks == 5 && steps == 4 && sum == 5);

checks = 0;
steps = 0;
for (var i = 0; test(i); advance(&i)) {
    break;
}
print(checks == 1 && steps == 0);
for (var i = 4; test(i); advance(&i)) {
    print(false);
}
print(checks == 2 && steps == 0);

var i = 91;
var total = 0;
for (var i = 0; i < 3; i++) {
    // The body's shadow must never change the binding of the header's update.
    var i = 70;
    total += i;
    continue;
}
print(i == 91 && total == 210);

total = 0;
for (var row = 0; row < 3; row++) {
    for (var column = 0; column < 4; column++) {
        if column == 1 {
            continue;
        }
        if column == 3 {
            break;
        }
        total += row + column;
    }
}
print(total == 12);

total = 0;
for (var n = 0; n < 5; n++) {
    match n {
        1 | 3 => {
            continue;
        }
        4 => {
            break;
        }
        _ => {
            total += n;
        }
    }
}
print(total == 2);

// Initializer and update accept comma expressions, with left-to-right effects.
var a = 0;
var b = 0;
for (a = 1, b = a + 1; a < 4; a++, b += a) {}
print(a == 4 && b == 11);
for (; a < 6;) {
    a++;
}
print(a == 6);
for (;;) {
    a++;
    if a == 9 {
        break;
    }
}
print(a == 9);
checks = 0;
for (a = 0; checks++, a < 2; a++) {}
print(checks == 3 && a == 2);

fn early(): i32 {
    for(var i = 0; true; print(false)) {
        return i + 42;
    }
}

fn unconditional(): i32 {
    for(;;) {
        return 17;
    }
}

// Definite-return analysis must retain a trapping initializer's termination.
fn stopped(): i32 {
    for(trap("stopped", 1); false;) {}
}

fn header_jump(): i32 {
    for(jump(done); true;) {}
    label(done);
    return 23;
}

print(header_jump() == 23);

print(early() == 42 && unconditional() == 17);

var data = alloc(i32, 3);
for (var index: usize = 0; index < 3; index++) {
    data[index] = convert(i32, index);
}
total = 0;
for (var at = data; at != data + 3; at++) {
    total += *at;
}
print(total == 3);
free(data);

// Names generated by lowering must not collide with even quoted source names.
var `control value 0` = 5;
for (var n = 0; n < 2; n++) {
    if n == 0 {
        continue;
    }
    `control value 0`++;
}
print(`control value 0` == 6);

// Re-test a changing bound; there is no implicit snapshot of a collection length.
var bound = 5;
total = 0;
for (var n = 0; n < bound; n++) {
    total++;
    bound--;
}
print(total == 3 && bound == 2);
