import tower;
import foreign_names;
import backend_type_construction;
import .backend.bindings;
import .backend.context;
import .backend.disassembly;
import .backend.linker;
import .backend.pipeline;
import .backend.target;
import .backend.text;

// Functional backend API checks, compiled as Tower and linked to the same
// upstream LLVM and shared entity/semantic objects as the production compiler.
fn backend_test_target(triple: u8*, width: u32): bool {
    var b = backend_open(triple);
    if b == null {
        return false;
    }
    var ok = b.error.length == 0;
    ok &&= b.pointer_bytes == width;
    backend_close(b);
    return ok;
}

fn backend_test_codegen(triple: u8*, width: u32, optimize: bool): bool {
    var selected = backend_open_codegen(triple, optimize ? BackendCodegen.Default : BackendCodegen.None);
    var legacy = backend_open(triple);
    defer { backend_close(selected); backend_close(legacy); }
    if selected == null || legacy == null { return false; }
    var backends: Backend*[2]; backends[0] = selected; backends[1] = legacy;
    for(var index: usize = 0; index < sizeof(decltype(backends)) / sizeof(Backend*); index++) {
        var b = backends[index];
        if b.error.length != 0 || b.pointer_bytes != width { return false; }
        var function = LLVMAddFunction(b.module, "answer", LLVMFunctionType(b.i32, null, 0, 0));
        LLVMPositionBuilderAtEnd(b.builder, LLVMAppendBasicBlockInContext(b.context, function, "entry"));
        LLVMBuildRet(b.builder, LLVMConstInt(b.i32, 42, 0));
        if !backend_optimize(b, optimize) || !backend_emit(b) || backend_size(b) == 0 { return false; }
        var decoded = backend_disassemble(backend_bytes(b), backend_size(b), triple);
        var ok = !decoded.failed && backend_contains(backend_disassembly_text(decoded), "answer");
        backend_disassembly_close(decoded);
        if !ok { return false; }
    }
    // Selecting emission policy changes neither layout nor the IR-pass contract.
    if !backend_equal(backend_optimized(selected), backend_optimized(legacy)) { return false; }
    if optimize {
        if backend_size(selected) != backend_size(legacy) { return false; }
        for(var i: usize = 0; i < backend_size(selected); i++) {
            if backend_bytes(selected)[i] != backend_bytes(legacy)[i] { return false; }
        }
    }
    return true;
}

fn backend_test_wasm_plan(): bool {
    var link = backend_link_create();
    if link == null { return false; }
    defer backend_link_close(link);
    var object: u8[2] = default;
    var runtime: u8[2] = default;
    object[0] = 42; runtime[0] = 99;
    if !backend_link_add_input(link, "library.o", &object[0], sizeof(u8[2]))
        || !backend_link_plan(link, "wasm32-unknown-unknown", null, 0, &object[0], sizeof(u8[2]), &runtime[0], sizeof(u8[2])) { return false; }
    var generated_inputs: usize = 3;
    if link.generated.length != generated_inputs || link.inputs.length != 1
        || !backend_equal(link.arguments.data[0], "tower-wasm-ld") { return false; }
    object[0] = 1; runtime[0] = 2;
    if link.generated.data[0].bytes.data[0] != 42 || link.generated.data[1].bytes.data[0] != 99
        || !backend_contains(link.generated.data[2].bytes.data, "tower_trap") { return false; }
    backend_link_reset_plan(link);
    if link.generated.length != 0 || link.arguments.length != 0 || link.inputs.length != 1 { return false; }
    if backend_link_plan(link, "wasm32-unknown-unknown", null, 0, null, 1, &runtime[0], sizeof(u8[2]))
        || link.error.length == 0 || link.output.length != 0 { return false; }
    return backend_link_plan(link, "wasm32-unknown-unknown", null, 0, &object[0], sizeof(u8[2]), &runtime[0], sizeof(u8[2]))
        && link.error.length == 0 && link.generated.length == generated_inputs && link.generated.data[0].bytes.data[0] == 1;
}

fn backend_test_elf_plan(): bool {
    var link = backend_link_create(); if link == null { return false; }
    defer backend_link_close(link);
    var object: u8[2] = default; object[0] = 42;
    if !backend_link_plan(link, "x86_64-unknown-linux-gnu", null, 0, &object[0], sizeof(u8[2]), null, 0) { return false; }
    if link.generated.length != 1 || !backend_equal(link.arguments.data[0], "tower-elf-ld") { return false; }
    object[0] = 7;
    if link.generated.data[0].bytes.data[0] != 42 { return false; }
    backend_link_reset_plan(link);
    return link.generated.length == 0 && link.arguments.length == 0;
}

fn backend_test_pe_plan(): bool {
    var link = backend_link_create(); if link == null { return false; }
    defer backend_link_close(link);
    var object: u8[2] = default; object[0] = 42;
    if !backend_link_plan(link, "x86_64-pc-windows-msvc", null, 0, &object[0], sizeof(u8[2]), null, 0) { return false; }
    var generated_count: usize = 2;
    if link.generated.length != generated_count || !backend_equal(link.arguments.data[0], "tower-pe-link") { return false; }
    object[0] = 7;
    if link.generated.data[0].bytes.data[0] != 42 || !backend_equal(link.generated.data[1].name.data, "tower-stack-probe.lib") { return false; }
    backend_link_reset_plan(link);
    return link.generated.length == 0 && link.arguments.length == 0;
}

fn backend_test_macho_plan(): bool {
    var link = backend_link_create(); if link == null { return false; }
    defer backend_link_close(link);
    var object: u8[2] = default; object[0] = 42;
    if !backend_link_plan(link, "arm64-apple-macos11", null, 0, &object[0], sizeof(u8[2]), null, 0) { return false; }
    var generated_count: usize = 2;
    if link.generated.length != generated_count || !backend_equal(link.arguments.data[0], "tower-macho-link") { return false; }
    object[0] = 7;
    if link.generated.data[0].bytes.data[0] != 42 || !backend_equal(link.generated.data[1].name.data, "tower-platform.tbd") { return false; }
    backend_link_reset_plan(link);
    return link.generated.length == 0 && link.arguments.length == 0;
}

export fn backend_tests(): i32 {
    var policy_failure: i32 = 93;
    if !backend_test_codegen("x86_64-unknown-linux-gnu", 8, false)
        || !backend_test_codegen("x86_64-unknown-linux-gnu", 8, true)
        || !backend_test_codegen("wasm32-unknown-unknown", 4, false)
        || !backend_test_codegen("wasm32-unknown-unknown", 4, true) { return policy_failure; }
    var invalid_policy = backend_open_codegen("x86_64-unknown-linux-gnu", bits(BackendCodegen, ~convert(u32, 0)));
    if invalid_policy == null { return policy_failure; }
    var rejected = backend_contains(backend_error(invalid_policy), "Unsupported backend code-generation policy")
        && !backend_emit(invalid_policy) && backend_bytes(invalid_policy) == null;
    backend_close(invalid_policy);
    if !rejected { return policy_failure; }
    var construction_failure: i32 = 92;
    if !backend_type_construction_tests() { return construction_failure; }
    var plan_failure: i32 = 91;
    if !backend_test_wasm_plan() || !backend_test_elf_plan() || !backend_test_pe_plan() || !backend_test_macho_plan() { return plan_failure; }
    var foreign_failures = foreign_tests();
    if foreign_failures != 0 {
        return 90;
    }
    var ok = backend_test_target("wasm32-unknown-unknown", 4);
    var failed = !ok;
    if failed {
        return 1;
    }
    var b = backend_open("not-a-real-target");
    ok = b.error.length != 0;
    backend_close(b);
    failed = !ok;
    if failed {
        return 2;
    }
    b = backend_open("wasm32-unknown-unknown");
    var type = LLVMFunctionType(b.i32, null, 0, 0);
    var function = LLVMAddFunction(b.module, "answer", type);
    var block = LLVMAppendBasicBlockInContext(b.context, function, "entry");
    LLVMPositionBuilderAtEnd(b.builder, block);
    LLVMBuildRet(b.builder, LLVMConstInt(b.i32, 42, 0));
    ok = backend_verify(b);
    ok &&= backend_optimize(b, false);
    ok &&= backend_contains(b.optimized, "ret i32 42");
    ok &&= backend_emit(b);
    if ok {
        var decoder = backend_disassemble(backend_bytes(b), backend_size(b), "wasm32-unknown-unknown");
        ok = !decoder.failed;
        ok &&= backend_contains(backend_disassembly_text(decoder), "i32.const");
        backend_disassembly_close(decoder);
    }
    backend_close(b);
    failed = !ok;
    if failed {
        return 3;
    }
    b = backend_open("wasm32-unknown-unknown");
    type = LLVMFunctionType(b.i32, null, 0, 0);
    function = LLVMAddFunction(b.module, "bad", type);
    block = LLVMAppendBasicBlockInContext(b.context, function, "entry");
    LLVMPositionBuilderAtEnd(b.builder, block);
    LLVMBuildRetVoid(b.builder);
    ok = backend_verify(b) == false;
    ok &&= b.error.length != 0;
    backend_close(b);
    failed = !ok;
    if failed {
        return 4;
    }
    // A truncated code-section size must fail with a bounded read.
    var malformed: u8[10];
    fill(&malformed[0], 0, 10);
    malformed[1] = 97;
    malformed[2] = 115;
    malformed[3] = 109;
    malformed[4] = 1;
    malformed[8] = 10;
    malformed[9] = 128;
    var decoder = backend_disassemble(&malformed[0], 10, "wasm32-unknown-unknown");
    ok = decoder.failed;
    backend_disassembly_close(decoder);
    failed = !ok;
    if failed {
        return 5;
    }
    var link = backend_link_create();
    ok = backend_link_add_input(link, "../escape.o", &malformed[0], 10) == false;
    ok &&= backend_link_add_input(link, "tower-input.o", &malformed[0], 10) == false;
    ok &&= backend_link_add_input(link, "library.o", &malformed[0], 10);
    ok &&= link.inputs.length == 1;
    ok &&= backend_link_add_input(link, "library.o", &malformed[0], 4);
    ok &&= link.inputs.length == 1;
    ok &&= link.inputs.data[0].bytes.length == 4;
    backend_link_close(link);
    failed = !ok;
    if failed {
        return 6;
    }
    b = backend_open("x86_64-unknown-linux-gnu");
    if b.error.length == 0 {
        type = LLVMFunctionType(b.i32, null, 0, 0);
        function = LLVMAddFunction(b.module, "custom_section", type);
        LLVMSetSection(function, ".tower.code");
        block = LLVMAppendBasicBlockInContext(b.context, function, "entry");
        LLVMPositionBuilderAtEnd(b.builder, block);
        LLVMBuildRet(b.builder, LLVMConstInt(b.i32, 7, 0));
        ok = backend_emit(b);
        if ok {
            decoder = backend_disassemble(backend_bytes(b), backend_size(b), "x86_64-unknown-linux-gnu");
            ok = backend_contains(backend_disassembly_text(decoder), ".tower.code:");
            backend_disassembly_close(decoder);
        }
    }
    backend_close(b);
    failed = !ok;
    if failed {
        return 7;
    }
    puts("Tower backend API checks passed");
    return 0;
}
