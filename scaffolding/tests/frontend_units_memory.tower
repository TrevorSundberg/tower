import tower;
import .compiler.semantic_program_types;
import .compiler.syntax_version_types;
import .compiler.foundation_types;
import .compiler.interpreter_context_types;
import .library.work_budget;
import .library.work_budget_types;
import .library.vector;
import utility_checks;

extern fn frontend_units_create_bounded(count: usize, budget: usize, retained_bytes: usize, width: u32,
    revision: u64, profile: u64, bedrock: u8*, foundation: u8*, library: u8*): void*;
extern fn frontend_units_create(count: usize, budget: usize, width: u32,
    revision: u64, profile: u64, bedrock: u8*, foundation: u8*, library: u8*): void*;
extern fn frontend_units_program(batch: void*, ordinal: usize): SemanticProgram*;
extern fn sem_resource_message(error: WorkBudgetError): u8*;
extern fn frontend_units_source(batch: void*, ordinal: usize, path: u8*, source: u8*, length: usize): bool;
extern fn frontend_units_step(batch: void*, wait: bool): bool;
extern fn frontend_units_failed(batch: void*): usize;
extern fn frontend_units_failure_resource(batch: void*): WorkBudgetError;
extern fn frontend_units_cancelled(batch: void*): bool;
extern fn frontend_units_close(batch: void*): void;
extern fn frontend_units_work_budget(batch: void*): WorkBudget*;
extern fn frontend_units_input_bytes(batch: void*): usize;
extern fn frontend_units_environment(batch: void*, ordinal: usize): void*;
extern fn frontend_modules_world(environment: void*): void*;
extern fn entity_view_open(anchor: void*): void*;
extern fn entity_view_close(view: void*): void;
extern fn syntax_version_diagnostic_dispose(diagnostic: SyntaxVersionDiagnostic*): void;
extern fn frontend_modules_reset_compilation(environment: void*): void;
extern fn strlen(text: u8*): usize;
extern fn puts(text: u8*): i32;
extern fn abort(): void;
extern fn compiler_world_create_workers(workers: usize): void*;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_dispose(world: void*): bool;
extern fn frontend_world_clear(world: void*): bool;
extern fn frontend_modules_create(): void*;
extern fn frontend_modules_bind_world(environment: void*, world: void*): bool;
extern fn frontend_modules_configure(environment: void*, source: u8*, library: u8*): void;
extern fn frontend_modules_destroy(environment: void*): void;
extern fn syntax_baseline_install(world: void*, environment: void*, source: u8*, foundation: bool, error: SyntaxVersionDiagnostic*): bool;
extern fn entity_create(store: void*): void*;
extern fn entity_release(node: void*): usize;
extern fn semantic_initialize(program: SemanticProgram*, root: void*, width: u32): void;
extern fn semantic_program_dispose(program: SemanticProgram*): void;
extern fn frontend_compile_sources(program: SemanticProgram*, sources: FrontendSource*, count: usize, environment: void*): void;
extern fn frontend_units_error(batch: void*): u8*;
extern fn frontend_units_error_offset(batch: void*): usize;
extern fn strcmp(left: u8*, right: u8*): i32;
extern fn sem_get(node: void*): FoundationNode*;
extern fn interpreter_invocation_init(invocation: IMInvocation*, function: void*, width: usize,
    arguments: u64*, count: usize, strict: bool, fuel: u64): bool;
extern fn interpreter_invocation_step(invocation: IMInvocation*, budget: usize): void;
extern fn interpreter_invocation_dispose(invocation: IMInvocation*): void;

fn units_memory_check(ok: bool, message: u8*): void {
    utility_check(ok, message);
}

fn units_memory_compiled(batch: void*, message: u8*): void {
    var ok = !frontend_units_cancelled(batch) && frontend_units_failed(batch) == 0
        && frontend_units_failure_resource(batch) == WorkBudgetError.None;
    if !ok { puts(frontend_units_error(batch)); }
    units_memory_check(ok, message);
}

fn units_memory_snapshot(batch: void*): WorkBudgetSnapshot {
    var snapshot: WorkBudgetSnapshot;
    units_memory_check(work_budget_snapshot(frontend_units_work_budget(batch), &snapshot), "Unit memory snapshot");
    return snapshot;
}

// Independent expected bytes: exact NUL-terminated payload plus the documented
// four-word compiler buffer header. Parser/world storage is additional.
var UnitSnapshotHeaderWords: usize = 4;
var UnitImportRefusalBytes: usize = 67108864;
var UnitSharedSnapshotBuffers: usize = 3;
var UnitSourceSnapshotBuffers: usize = 2;

fn units_memory_span_bytes(length: usize): usize {
    return length + 1 + UnitSnapshotHeaderWords * sizeof(usize);
}

fn units_memory_resource_bytes(bedrock: u8*, foundation: u8*, root: u8*): usize {
    return units_memory_span_bytes(strlen(bedrock)) + units_memory_span_bytes(strlen(foundation))
        + units_memory_span_bytes(strlen(root));
}

fn units_memory_input_bytes(path: u8*, length: usize): usize {
    return units_memory_span_bytes(strlen(path)) + units_memory_span_bytes(length);
}

fn units_memory_answer(program: SemanticProgram*): void {
    var answer: void* = null;
    var name = "answer";
    var length = strlen(name);
    foreach(var function in &program.functions) {
        var node = sem_get(function);
        if node.name.length == length && strcmp(node.name.data, name) == 0 { answer = function; }
    }
    var invocation: IMInvocation = default;
    var fuel: u64 = 10000;
    var quantum: usize = 7;
    units_memory_check(answer != null
        && interpreter_invocation_init(&invocation, answer, convert(usize, program.pointer_bytes), null, 0, true, fuel), "Bounded source answer");
    while !invocation.state.done && !invocation.state.failed { interpreter_invocation_step(&invocation, quantum); }
    units_memory_check(!invocation.state.failed && invocation.context.result == 42, "Bounded source executes expected answer");
    interpreter_invocation_dispose(&invocation);
}

struct UnitMemorySample { constructed: WorkBudgetSnapshot; peak: usize; }

// Calibrate compilation storage with the same checked source and fresh owners.
// Tight input/header expectations below stay independent of this measurement.
fn units_memory_measure(bedrock: u8*, foundation: u8*, root: u8*, path: u8*, source: u8*): UnitMemorySample {
    var batch = frontend_units_create(1, 1, 8, 1, 1, bedrock, foundation, root);
    units_memory_check(batch != null, "Reference constructor baseline");
    defer frontend_units_close(batch);
    var sample: UnitMemorySample = { constructed: units_memory_snapshot(batch), ..default };
    units_memory_check(frontend_units_input_bytes(batch) == units_memory_resource_bytes(bedrock, foundation, root),
        "Reference constructor retains the exact resource input bytes");
    units_memory_check(frontend_units_source(batch, 1, path, source, strlen(source)), "Reference source snapshot");
    while !frontend_units_step(batch, true) {}
    units_memory_compiled(batch, "Reference compilation measures its actual storage requirement");
    var joined = units_memory_snapshot(batch);
    sample.peak = joined.peak_bytes;
    frontend_modules_reset_compilation(frontend_units_environment(batch, 1));
    var retired = units_memory_snapshot(batch);
    units_memory_check(retired.used_bytes == joined.used_bytes && retired.live == joined.live,
        "Completed one-shot unit has already retired its parser and import cache");
    var program = frontend_units_program(batch, 1);
    units_memory_check(program != null, "Reference compilation publishes its checked program");
    units_memory_answer(program);
    return sample;
}

fn units_source_bounds_trial(bedrock: u8*, foundation: u8*, root: u8*, text: u8*, length: usize,
    valid: bool, offset: usize): void {
    var world = compiler_world_create_workers(1);
    var environment = frontend_modules_create();
    units_memory_check(world != null && environment != null && frontend_modules_bind_world(environment, world),
        "Explicit source bounds fixture world");
    frontend_modules_configure(environment, "bounds.tower", root);
    var diagnostic: SyntaxVersionDiagnostic = default;
    units_memory_check(syntax_baseline_install(world, environment, bedrock, false, &diagnostic)
        && syntax_baseline_install(world, environment, foundation, true, &diagnostic), "Source bounds grammar");
    var owner = entity_create(compiler_world_store(world));
    units_memory_check(owner != null, "Source bounds root");
    var program: SemanticProgram = default;
    semantic_initialize(&program, owner, 8);
    var source: FrontendSource = { data: text, length: length };
    frontend_compile_sources(&program, &source, 1, environment);
    if valid {
        if program.error.length != 0 {
            units_memory_check(vector_push(&program.error, 0), "Source bounds diagnostic terminator");
            --program.error.length;
            puts(program.error.data);
        }
        units_memory_check(program.error.length == 0,
            "Explicit source length excludes the invalid suffix");
        units_memory_answer(&program);
    } else {
        units_memory_check(program.error.length != 0 && program.error_offset == offset,
            "Interior NUL is diagnosed at its exact offset before parsing");
    }
    semantic_program_dispose(&program);
    entity_release(owner);
    frontend_modules_destroy(environment);
    units_memory_check(frontend_world_clear(world) && compiler_world_dispose(world), "Source bounds world cleanup");
}

fn units_root_refusal(bedrock: u8*, foundation: u8*, root: u8*): void {
    var batch = frontend_units_create(1, 1, 8, 1, 1, bedrock, foundation, root);
    units_memory_check(batch != null, "Root refusal batch");
    defer frontend_units_close(batch);
    var source = "import tower;";
    units_memory_check(frontend_units_source(batch, 1, "root.tower", source, strlen(source)), "Root refusal input");
    var environment = frontend_units_environment(batch, 1);
    var world = frontend_modules_world(environment);
    var diagnostic: SyntaxVersionDiagnostic = default;
    defer syntax_version_diagnostic_dispose(&diagnostic);
    units_memory_check(syntax_baseline_install(world, environment, bedrock, false, &diagnostic)
        && syntax_baseline_install(world, environment, foundation, true, &diagnostic), "Root refusal baselines");
    // Both baselines can be borrowed unchanged. Creating the program root is
    // the first structural edit in this unit's store and must report Busy.
    var anchor = entity_create(compiler_world_store(world));
    units_memory_check(anchor != null, "Root refusal anchor");
    defer entity_release(anchor);
    var view = entity_view_open(anchor);
    units_memory_check(view != null, "Root refusal view");
    defer entity_view_close(view);
    while !frontend_units_step(batch, true) {}
    units_memory_check(frontend_units_failed(batch) == 1 && frontend_units_program(batch, 1) == null
        && frontend_units_failure_resource(batch) == WorkBudgetError.Busy, "Unit root preserves its structural refusal");
}

export fn frontend_units_memory_tests(bedrock: u8*, foundation: u8*, root: u8*): void {
    units_root_refusal(bedrock, foundation, root);
    var resources = units_memory_resource_bytes(bedrock, foundation, root);
    var path = "memory.tower";
    var source = "import tower; fn answer():i32{return 42;}";
    var input = units_memory_input_bytes(path, strlen(source));
    // Construction has its own physical owners. Measure the completed baseline
    // separately; input payload/header expectations remain independently exact.
    var reference = units_memory_measure(bedrock, foundation, root, path, source);
    var constructed = reference.constructed;
    units_memory_check(constructed.used_bytes > resources
        && constructed.live > UnitSharedSnapshotBuffers, "Constructor owners have physical byte grants");
    var construction = constructed.used_bytes - resources;
    var construction_owners = constructed.live - UnitSharedSnapshotBuffers;
    var base = resources + construction;
    units_memory_check(reference.peak > base + input, "Compilation peak exceeds retained constructor and input bytes");
    var allowance = reference.peak - base - input;
    // Preserve the original finite-budget import failure separately from the
    // later measured peak: these exercise different producer phases.
    var import_cap = base + input + UnitImportRefusalBytes;
    units_memory_check(import_cap < reference.peak, "Import denial policy is below this source's measured requirement");
    // Baseline LR allocation can report a grammar diagnostic even though the
    // byte ledger refused it, before a semantic program exists.
    var baseline_cap: usize = 1048576;
    var denied = frontend_units_create_bounded(1, 1, baseline_cap, 8, 1, 1, bedrock, foundation, root);
    units_memory_check(denied != null && frontend_units_source(denied, 1, path, source, strlen(source))
        && frontend_units_failure_resource(denied) == WorkBudgetError.None, "Baseline denial input");
    while !frontend_units_step(denied, true) {}
    units_memory_check(frontend_units_failed(denied) == 1 && frontend_units_error(denied)[0] != 0
        && frontend_units_failure_resource(denied) == WorkBudgetError.Capacity
        && frontend_units_program(denied, 1) == null, "Baseline denial preserves Capacity after formatting");
    frontend_units_close(denied);
    denied = frontend_units_create_bounded(1, 1, import_cap,
        8, 1, 1, bedrock, foundation, root);
    units_memory_check(denied != null && frontend_units_source(denied, 1, path, source, strlen(source)),
        "Finite import budget owns its input");
    while !frontend_units_step(denied, true) {}
    var resource_ok = strcmp(frontend_units_error(denied), sem_resource_message(WorkBudgetError.Capacity)) == 0;
    if !resource_ok { puts(frontend_units_error(denied)); }
    units_memory_check(!frontend_units_cancelled(denied) && frontend_units_failed(denied) == 1
        && frontend_units_program(denied, 1) == null && resource_ok
        && frontend_units_failure_resource(denied) == WorkBudgetError.Capacity,
        "Imported parser capacity failure retains its typed cause through unit output");
    frontend_units_close(denied);
    denied = frontend_units_create_bounded(1, 1, reference.peak - 1,
        8, 1, 1, bedrock, foundation, root);
    units_memory_check(denied != null && frontend_units_source(denied, 1, path, source, strlen(source)),
        "One-byte-short compilation owns its input before import work");
    while !frontend_units_step(denied, true) {}
    units_memory_check(!frontend_units_cancelled(denied) && frontend_units_failed(denied) == 1
        && frontend_units_program(denied, 1) == null,
        "One-byte-short compilation publishes no program");
    resource_ok = strcmp(frontend_units_error(denied), sem_resource_message(WorkBudgetError.Capacity)) == 0;
    if !resource_ok { puts(frontend_units_error(denied)); }
    units_memory_check(resource_ok && frontend_units_failure_resource(denied) == WorkBudgetError.Capacity,
        "Peak-minus-one compilation retains its Capacity cause through unit output");
    frontend_units_close(denied);
    units_memory_check(frontend_units_create_bounded(1, 1, 0, 8, 1, 1, bedrock, foundation, root) == null
        && frontend_units_create_bounded(1, 1, ~convert(usize, 0), 8, 1, 1, bedrock, foundation, root) == null,
        "Bounded unit API rejects missing or unbounded policy");
    units_memory_check(frontend_units_create_bounded(1, 1, base - 1, 8, 1, 1, bedrock, foundation, root) == null,
        "Constructors and resource snapshots reject a one-byte-short cap");
    var batch = frontend_units_create_bounded(1, 1, base, 8, 1, 1, bedrock, foundation, root);
    units_memory_check(batch != null, "Exact constructor and resource capacity accepted");
    var before = units_memory_snapshot(batch);
    units_memory_check(frontend_units_input_bytes(batch) == resources
        && before.used_bytes == base && before.peak_bytes == base
        && before.live == construction_owners + UnitSharedSnapshotBuffers
        && !frontend_units_source(batch, 1, path, source, strlen(source)), "Source denied before allocation at full resource cap");
    var after = units_memory_snapshot(batch);
    units_memory_check(after.used_bytes == before.used_bytes && after.live == before.live,
        "Denied source preserves resource receipts");
    frontend_units_close(batch);

    var length = strlen(source);
    var bounded = alloc(u8, length + 3);
    units_memory_check(bounded != null, "Explicit source bytes");
    defer free(bounded);
    copy(bounded, source, length);
    bounded[length] = 0;
    bounded[length + 1] = *"@";
    bounded[length + 2] = 0;
    units_source_bounds_trial(bedrock, foundation, root, bounded, length + 2, false, length);
    bounded[length] = *"@";
    units_source_bounds_trial(bedrock, foundation, root, bounded, length, true, 0);

    batch = frontend_units_create_bounded(1, 1, base + input + allowance,
        8, 1, 1, bedrock, foundation, root);
    units_memory_check(batch != null && frontend_units_source(batch, 1, path, source, strlen(source)),
        "Exact source capacity accepted");
    // Hold the finite compilation allowance while testing tight input capacity.
    // Releasing this test grant makes those same bytes available to parser work.
    var compilation: WorkReservation = default;
    units_memory_check(work_budget_reserve(frontend_units_work_budget(batch), 0, 0,
        allowance, &compilation), "Reserve explicit compilation allowance");
    before = units_memory_snapshot(batch);
    bounded[length] = 0;
    units_memory_check(!frontend_units_source(batch, 1, path, bounded, length + 2)
        && strcmp(frontend_units_error(batch), "Compilation source contains an embedded NUL byte") == 0
        && frontend_units_error_offset(batch) == length, "Unit source rejection reports exact NUL offset");
    units_memory_check(frontend_units_input_bytes(batch) == resources + input
        && before.used_bytes == base + input + allowance
        && before.live == construction_owners + UnitSharedSnapshotBuffers + UnitSourceSnapshotBuffers + 1
        && !frontend_units_source(batch, 1, "failed.tower", "@", 1)
        && !frontend_units_source(batch, 1, path, source, ~convert(usize, 0)),
        "Replacement and length overflow reject without losing configured source");
    after = units_memory_snapshot(batch);
    units_memory_check(after.used_bytes == before.used_bytes && after.live == before.live
        && after.peak_bytes <= after.bytes, "Denied replacement retains exact accounting");
    units_memory_check(work_budget_release(frontend_units_work_budget(batch), &compilation),
        "Make bounded allowance available before compiling");
    while !frontend_units_step(batch, true) {}
    units_memory_compiled(batch,
        "Previously configured program still compiles after denied replacement");

    after = units_memory_snapshot(batch);
    units_memory_check(frontend_units_input_bytes(batch) == resources + input
        && after.used_bytes >= base + input && after.peak_bytes <= after.bytes,
        "Compiled tables share the finite ledger without changing input ownership");
    frontend_units_close(batch);
    var old_input = units_memory_input_bytes(path, 1);
    batch = frontend_units_create_bounded(1, 1, base + old_input + input + allowance,
        8, 1, 1, bedrock, foundation, root);
    units_memory_check(batch != null && work_budget_reserve(frontend_units_work_budget(batch), 0, 0,
        allowance, &compilation), "Reserve replacement compilation allowance");
    bounded[length] = *"@";
    units_memory_check(batch != null && frontend_units_source(batch, 1, path, "@", 1)
        && frontend_units_source(batch, 1, path, bounded, length), "Replacement owns the exact span, excluding the suffix");
    after = units_memory_snapshot(batch);
    units_memory_check(frontend_units_input_bytes(batch) == resources + input
        && after.used_bytes == base + input + allowance
        && after.peak_bytes == base + old_input + input + allowance
        && after.live == construction_owners + UnitSharedSnapshotBuffers + UnitSourceSnapshotBuffers + 1,
        "Commit releases only the previous input receipts");
    units_memory_check(work_budget_release(frontend_units_work_budget(batch), &compilation),
        "Release replacement compilation allowance");
    while !frontend_units_step(batch, true) {}
    units_memory_compiled(batch,
        "Successful replacement compiles the new program");
    frontend_units_close(batch);
}
