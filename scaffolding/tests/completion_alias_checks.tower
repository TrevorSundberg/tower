import tower;
import .compiler.completion_types;
import .compiler.syntax_session_types;
import .compiler.syntax_types;
import .library.work_budget_types;

extern fn entity_release(node: void*): usize;
extern fn frontend_modules_source(environment: void*, path: u8*, source: u8*, length: usize): bool;
extern fn syntax_session_open_result(world: void*, environment: void*, source: u8*, module: void*, mode: u32, error: WorkBudgetError*): SyntaxSession*;
extern fn syntax_session_lexemes(session: void*, listing: SyntaxHighlights*): bool;
extern fn syntax_highlights_dispose(listing: SyntaxHighlights*): void;
extern fn syntax_completion_enable(session: void*): void;
extern fn syntax_next(session: void*): void*;
extern fn syntax_destroy(session: void*): void;
extern fn completion_begin_world(world: void*, environment: void*, source: u8*, length: usize, cursor: usize, spans: CompletionSpan*, count: usize): CompletionQuery*;
extern fn completion_analyze_target(query: CompletionQuery*, active: void*, mode: u32, width: u32, files: u8**, lengths: usize*, count: usize): void;
extern fn completion_symbols(query: CompletionQuery*): void;
extern fn completion_end(query: CompletionQuery*): u8*;

fn alias_consume(session: void*): void {
    loop { var root = syntax_next(session); if root == null { return; } entity_release(root); }
}
