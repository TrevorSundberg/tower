export fn tower_entity_finalize(lifecycle: usize, component: EntityComponent*, data: u8*): void { abort(); }

fn wasm_test_leb(): void {
    var buffer: ByteBuffer = default;
    defer bytes_dispose(&buffer);
    var seed: u32 = 1729;
    for (var sample: usize = 0; sample < 1000; sample++) {
        var value = (convert(u64, utility_random(&seed)) << 32) | convert(u64, utility_random(&seed));
        if sample == 0 { value = 0; }
        if sample == 1 { value = ~convert(u64, 0); }
        if sample == 2 { value = convert(u64, 1) << 63; }
        buffer.length = 0;
        utility_check(wasm_write_uleb(&buffer, value), "write unsigned LEB");
        var reader: WasmReader = { bytes: { data: buffer.data, length: buffer.length }, ..default };
        utility_check(wasm_read_uleb(&reader, 64) == value && reader.error == WasmReadError.None && reader.at == buffer.length, "unsigned LEB round trip");
        buffer.length = 0;
        utility_check(wasm_write_sleb(&buffer, bits(i64, value)), "write signed LEB");
        reader = init(WasmReader) { bytes: { data: buffer.data, length: buffer.length }, ..default };
        utility_check(wasm_read_sleb(&reader, 64) == bits(i64, value) && reader.error == WasmReadError.None && reader.at == buffer.length, "signed LEB round trip");
    }
    buffer.length = 0;
    for (var at: usize = 0; at < 5; at++) { utility_check(bytes_push(&buffer, at == 4 ? 15 : 255), "padded LEB fixture"); }
    var reader: WasmReader = { bytes: { data: buffer.data, length: buffer.length }, ..default };
    utility_check(wasm_read_uleb(&reader, 32) == 4294967295 && reader.error == WasmReadError.None, "maximum padded u32");
    reader.at = 0;
    wasm_read_sleb(&reader, 32);
    utility_check(reader.error == WasmReadError.Integer, "signed unused bits checked");
    buffer.data[4] = 127;
    reader = init(WasmReader) { bytes: { data: buffer.data, length: buffer.length }, ..default };
    utility_check(wasm_read_sleb(&reader, 32) == -1 && reader.error == WasmReadError.None, "padded negative i32");
    reader.at = 0;
    wasm_read_uleb(&reader, 32);
    utility_check(reader.error == WasmReadError.Integer, "unsigned unused bits checked");
    buffer.data[4] = 128;
    reader = init(WasmReader) { bytes: { data: buffer.data, length: buffer.length }, ..default };
    wasm_read_uleb(&reader, 32);
    utility_check(reader.error == WasmReadError.Integer, "overlong continuation checked");
    reader = init(WasmReader) { bytes: { data: buffer.data, length: 1 }, ..default };
    wasm_read_uleb(&reader, 64);
    utility_check(reader.error == WasmReadError.Truncated, "truncated continuation checked");
    reader = default;
    wasm_read_bytes(&reader, ~convert(usize, 0));
    utility_check(reader.error == WasmReadError.Truncated, "span overflow rejected before dereference");
    buffer.length = 0;
    utility_check(bytes_push(&buffer, 1) && bytes_push(&buffer, 255), "invalid UTF-8 fixture");
    reader = init(WasmReader) { bytes: { data: buffer.data, length: buffer.length }, ..default };
    wasm_read_name(&reader);
    utility_check(reader.error == WasmReadError.Utf8, "invalid UTF-8 name rejected");
}

fn wasm_test_object(output: ByteBuffer*): void { wasm_test_named_object(output, "answer", convert(u32, WasmSymbolFlag.Exported)); }

fn wasm_test_import_object(output: ByteBuffer*, result: WasmValueType, flags: u32, direct: bool): void {
    var header: u8[8] = default;
    header[1] = 97; header[2] = 115; header[3] = 109; header[4] = 1;
    utility_check(bytes_append(output, &header[0], 8), "import fixture header");
    var section: ByteBuffer = default;
    var symbols: ByteBuffer = default;
    defer bytes_dispose(&section); defer bytes_dispose(&symbols);
    wasm_test_index(&section, 1); wasm_test_byte(&section, WasmFunctionType);
    wasm_test_index(&section, 0); wasm_test_index(&section, 1); wasm_test_byte(&section, convert(u8, result));
    wasm_test_section(output, WasmSection.Type, &section);
    wasm_test_index(&section, 1); wasm_test_name(&section, "env"); wasm_test_name(&section, "answer");
    wasm_test_byte(&section, convert(u8, WasmExternal.Function)); wasm_test_index(&section, 0);
    wasm_test_section(output, WasmSection.Import, &section);
    if direct {
        wasm_test_index(&section, 1); wasm_test_index(&section, 0);
        wasm_test_section(output, WasmSection.Function, &section);
        var call_opcode: u8 = 16;
        var body_bytes: u64 = 8;
        var padded_index: usize = 5;
        wasm_test_index(&section, 1); wasm_test_index(&section, body_bytes); wasm_test_index(&section, 0);
        wasm_test_byte(&section, call_opcode);
        for (var at: usize = 0; at < padded_index; at++) { wasm_test_byte(&section, at + 1 < padded_index ? WasmLebContinuation : 0); }
        wasm_test_byte(&section, convert(u8, WasmOpcode.End));
        wasm_test_section(output, WasmSection.Code, &section);
    }
    wasm_test_index(&symbols, 1); wasm_test_byte(&symbols, convert(u8, WasmSymbolKind.Function));
    wasm_test_index(&symbols, convert(u64, flags | convert(u32, WasmSymbolFlag.Undefined))); wasm_test_index(&symbols, 0);
    if (flags & convert(u32, WasmSymbolFlag.ExplicitName)) != 0 { wasm_test_name(&symbols, "answer"); }
    wasm_test_name(&section, "linking"); wasm_test_index(&section, convert(u64, WasmLinkingVersion));
    wasm_test_byte(&section, convert(u8, WasmLinkingSection.Symbols)); wasm_test_index(&section, convert(u64, symbols.length));
    utility_check(bytes_append(&section, symbols.data, symbols.length), "import fixture symbols");
    wasm_test_section(output, WasmSection.Custom, &section);
    if direct {
        var code_section_index: u64 = 3;
        var call_operand_offset: u64 = 4;
        wasm_test_name(&section, "reloc.CODE"); wasm_test_index(&section, code_section_index);
        wasm_test_index(&section, 1); wasm_test_index(&section, convert(u64, WasmRelocation.FunctionIndexLeb));
        wasm_test_index(&section, call_operand_offset); wasm_test_index(&section, 0);
        wasm_test_section(output, WasmSection.Custom, &section);
    }
}

fn wasm_test_variants(): void {
    var strong: ByteBuffer = default;
    var first: ByteBuffer = default;
    var second: ByteBuffer = default;
    var address: ByteBuffer = default;
    defer bytes_dispose(&strong); defer bytes_dispose(&first); defer bytes_dispose(&second); defer bytes_dispose(&address);
    wasm_test_object(&strong);
    wasm_test_import_object(&first, WasmValueType.I32, 0, true);
    wasm_test_import_object(&second, WasmValueType.I64, 0, true);
    wasm_test_import_object(&address, WasmValueType.I64, 0, false);
    for (var defined: u32 = 0; defined < 3; defined++) {
        var link: WasmLink = default;
        utility_check(wasm_link_init(&link), "variant world");
        var a: WasmBytes = defined != 0 ? init(WasmBytes) { data: strong.data, length: strong.length } : init(WasmBytes) { data: first.data, length: first.length };
        var b: WasmBytes = defined == 2 ? init(WasmBytes) { data: address.data, length: address.length } : init(WasmBytes) { data: second.data, length: second.length };
        utility_check(wasm_link_read_object(&link.world, wasm_text_bytes("definition.o"), a)
            && wasm_link_read_object(&link.world, wasm_text_bytes("declaration.o"), b)
            && wasm_link_prepare(&link) && wasm_link_symbols(&link), "variant inputs");
        var parsed = link.world.objects.data[1].object;
        utility_check(parsed.relocation_chunks.length == parsed.relocations.length, "validated relocations retain one derived owner row");
        if parsed.relocations.length != 0 {
            utility_check(parsed.relocation_chunks.data[0] == parsed.imported_functions, "relocation owner includes imported function prefix");
        }
        var ok = wasm_link_variants(&link);
        if defined == 0 { utility_check(!ok && link.error == WasmLinkError.Signature, "incompatible unresolved imports diagnosed"); }
        else { if defined == 2 {
            utility_check(ok && link.warnings.length == 0 && link.layouts.data[1].symbols.data[0] == link.layouts.data[0].symbols.data[0], "address-only declaration retains the real function and table address");
        } else {
            var variant = link.layouts.data[1].symbols.data[0];
            var symbol = &link.symbols.data[convert(usize, variant)];
            utility_check(ok && link.warnings.length == 1 && variant != link.layouts.data[0].symbols.data[0]
                && symbol.synthetic == WasmSynthetic.SignatureTrap && symbol.table_index == 0, "typed trap variant preserves null function address");
        } }
        utility_check(wasm_link_close(&link), "variant cleanup");
    }
}

fn wasm_test_relocation_patches(): void {
    var bytes: u8[10] = default;
    var link: WasmLink = default;
    var padded32: usize = 5;
    var padded64: usize = 10;
    var rounds: usize = 3;
    for (var round: usize = 0; round < rounds; round++) {
        var wide = round == 2;
        var width = wide ? padded64 : padded32;
        for (var at: usize = 0; at < width; at++) { bytes[at] = at + 1 < width ? WasmLebContinuation : 0; }
        var value: u64 = round == 0 ? 2147483648 : ~convert(u64, 0);
        var kind = wide ? WasmRelocation.MemoryAddressSleb64 : WasmRelocation.MemoryAddressSleb;
        var target: WasmBytes = { data: &bytes[0], length: width };
        utility_check(wasm_link_patch(&link, kind, target, value), "signed relocation patch");
        var reader: WasmReader = { bytes: target, ..default };
        var decoded = wasm_read_sleb(&reader, wide ? 64 : 32);
        utility_check(reader.error == WasmReadError.None && decoded == (round == 0 ? -2147483648 : -1), "signed padded relocation preserves high bits");
    }
    var target: WasmBytes = { data: &bytes[0], length: padded32 };
    utility_check(!wasm_link_patch(&link, WasmRelocation.MemoryAddressLeb, target, WasmMemory32Limit)
        && link.error == WasmLinkError.Layout, "relocation overflow diagnosed");
}

enum WasmImportCase: u32 { Unused = 0, Missing = 1, Explicit = 2, Weak = 3 }

fn wasm_test_import_policy(): void {
    for (var mode: u32 = 0; mode <= convert(u32, WasmImportCase.Weak); mode++) {
        var scenario = convert(WasmImportCase, mode);
        var flags: u32 = scenario == WasmImportCase.Unused ? 0 : convert(u32, WasmSymbolFlag.NoStrip);
        if scenario == WasmImportCase.Explicit { flags |= convert(u32, WasmSymbolFlag.ExplicitName); }
        if scenario == WasmImportCase.Weak { flags |= convert(u32, WasmSymbolFlag.Weak); }
        var input: ByteBuffer = default;
        wasm_test_import_object(&input, WasmValueType.I32, flags, false);
        var link: WasmLink = default;
        utility_check(wasm_link_init(&link) && wasm_link_read_object(&link.world, wasm_text_bytes("import.o"), init(WasmBytes) { data: input.data, length: input.length }), "import policy input");
        utility_check(bytes_append(&link.output, "keep", 4), "previous output fixture");
        var ok = wasm_link_run(&link);
        if scenario == WasmImportCase.Missing {
            utility_check(!ok && link.error == WasmLinkError.Undefined && wasm_bytes_text(init(WasmBytes) { data: link.output.data, length: link.output.length }, "keep"), "undefined reference fails without publishing partial output");
        } else {
            utility_check(ok, "unused, explicit and weak import policies");
            if scenario == WasmImportCase.Unused { utility_check(link.functions.length == 0, "unused undefined declaration is collected"); }
            if scenario == WasmImportCase.Explicit { utility_check(link.imported_functions == 1, "explicit host import retains its signature and name"); }
            if scenario == WasmImportCase.Weak { utility_check(link.imported_functions == 0 && link.functions.length == 1 && link.symbols.data[0].table_index == 0, "weak undefined function gets a typed null-address trap"); }
        }
        utility_check(wasm_link_close(&link), "import policy cleanup"); bytes_dispose(&input);
    }
    var unsupported: WasmLink = default;
    utility_check(wasm_link_init(&unsupported), "unsupported profile world"); unsupported.shared_memory = true;
    utility_check(!wasm_link_run(&unsupported) && unsupported.error == WasmLinkError.Unsupported && unsupported.output.length == 0, "shared memory requires explicit target features");
    utility_check(wasm_link_close(&unsupported), "unsupported profile cleanup");
    var input: ByteBuffer = default;
    var section: ByteBuffer = default;
    defer bytes_dispose(&input); defer bytes_dispose(&section);
    var header: u8[8] = default;
    header[1] = 97; header[2] = 115; header[3] = 109; header[4] = 1;
    utility_check(bytes_append(&input, &header[0], 8), "shared-memory fixture header");
    wasm_test_index(&section, 1);
    wasm_test_index(&section, convert(u64, WasmLimitFlag.Maximum) | convert(u64, WasmLimitFlag.Shared));
    wasm_test_index(&section, 1); wasm_test_index(&section, 1);
    wasm_test_section(&input, WasmSection.Memory, &section);
    wasm_test_name(&section, "linking"); wasm_test_index(&section, convert(u64, WasmLinkingVersion));
    wasm_test_section(&input, WasmSection.Custom, &section);
    utility_check(wasm_link_init(&unsupported) && wasm_link_read_object(&unsupported.world, wasm_text_bytes("shared.o"), init(WasmBytes) { data: input.data, length: input.length }), "shared input metadata parses");
    utility_check(!wasm_link_run(&unsupported) && unsupported.error == WasmLinkError.Unsupported, "static output cannot silently erase shared input memory");
    utility_check(wasm_link_close(&unsupported), "shared input cleanup");
}

fn wasm_test_names(): void {
    var keys: u8[512] = default;
    var map: WasmNameMap = default;
    defer wasm_names_dispose(&map);
    for (var at: usize = 0; at < 256; at++) {
        keys[at * 2] = convert(u8, at);
        keys[at * 2 + 1] = convert(u8, at ^ 123);
        utility_check(wasm_names_set(&map, init(WasmBytes) { data: &keys[at * 2], length: 2 }, convert(u32, at)), "name collision/growth insertion");
    }
    var capacity = map.capacity;
    for (var at: usize = 0; at < 256; at++) {
        var key: WasmBytes = { data: &keys[at * 2], length: 2 };
        utility_check(wasm_names_get(&map, key) == convert(u32, at), "name collision/growth lookup");
        utility_check(wasm_names_set(&map, key, convert(u32, at + 1)), "existing name update");
        utility_check(wasm_names_get(&map, key) == convert(u32, at + 1), "updated name lookup");
    }
    utility_check(map.count == 256 && map.capacity == capacity, "updating names does not grow or duplicate rows");
    utility_check(wasm_names_get(&map, wasm_text_bytes("absent")) == WasmNoIndex, "missing name sentinel");
    var left = wasm_text_bytes("costarring"); var right = wasm_text_bytes("liquid");
    utility_check(wasm_bytes_hash(left) == wasm_bytes_hash(right), "fixture has an actual full FNV collision");
    utility_check(wasm_names_set(&map, left, 42) && wasm_names_set(&map, right, 17)
        && wasm_names_get(&map, left) == 42 && wasm_names_get(&map, right) == 17, "cached hashes still compare colliding names");
    utility_check(wasm_names_set(&map, default(WasmBytes), 0) && wasm_names_get(&map, wasm_text_bytes("")) == 0, "empty name and zero value remain valid");
}

fn wasm_test_name_encoding(): void {
    var bytes: u8[40];
    var ascii: u8 = 116;
    var unicode_width: usize = 4;
    for (var prefix: usize = 0; prefix < 24; prefix++) {
        fill(&bytes[0], ascii, sizeof(u8[40]));
        // U+1F4A9 across all alignments and byte spans; valid ASCII suffixes
        // must not hide invalid/truncated Unicode before the next word boundary.
        bytes[prefix] = 240; bytes[prefix + 1] = 159; bytes[prefix + 2] = 146; bytes[prefix + 3] = 169;
        var name: WasmBytes = { data: &bytes[0], length: sizeof(u8[40]) };
        utility_check(wasm_bytes_utf8(name), "valid UTF-8 among long ASCII names");
        name.length = prefix + unicode_width - 1;
        utility_check(!wasm_bytes_utf8(name), "truncated multibyte name remains invalid");
        name.length = sizeof(u8[40]); bytes[prefix + 1] = ascii;
        utility_check(!wasm_bytes_utf8(name), "invalid continuation among ASCII words rejected");
    }
    fill(&bytes[0], ascii, sizeof(u8[40]));
    for (var length: usize = 0; length <= sizeof(u8[40]) - 1; length++) {
        utility_check(wasm_bytes_utf8(init(WasmBytes) { data: &bytes[1], length: length }), "unaligned ASCII names of every tail length");
    }
}

fn wasm_test_padded_encoding(): void {
    var kinds: WasmRelocation[4];
    kinds[0] = WasmRelocation.MemoryAddressLeb; kinds[1] = WasmRelocation.MemoryAddressSleb;
    kinds[2] = WasmRelocation.MemoryAddressLeb64; kinds[3] = WasmRelocation.MemoryAddressSleb64;
    var storage: u8[10];
    var byte_values: u32 = 256;
    for (var kind_index: usize = 0; kind_index < 4; kind_index++) {
        var kind = kinds[kind_index];
        var width = convert(usize, wasm_relocation_width(kind));
        var signed = wasm_link_relocation_signed(kind);
        var bits: u64 = kind_index < 2 ? 32 : 64;
        for (var last: u32 = 0; last < byte_values; last++) {
            for (var at: usize = 0; at + 1 < width; at++) { storage[at] = WasmLebContinuation; }
            storage[width - 1] = convert(u8, last);
            var target: WasmBytes = { data: &storage[0], length: width };
            var reader: WasmReader = { bytes: target, ..default };
            if signed { wasm_read_sleb(&reader, bits); } else { wasm_read_uleb(&reader, bits); }
            var valid_encoding = reader.error == WasmReadError.None && reader.at == width;
            var link: WasmLink = default;
            utility_check(wasm_link_patch(&link, kind, target, 42) == valid_encoding, "padded operand validation matches ordinary signed/unsigned decoder for every last byte");
        }
        for (var stop: usize = 0; stop + 1 < width; stop++) {
            fill(&storage[0], WasmLebContinuation, width); storage[width - 1] = 0; storage[stop] = 0;
            var link: WasmLink = default;
            utility_check(!wasm_link_patch(&link, kind, init(WasmBytes) { data: &storage[0], length: width }, 42), "early LEB terminators are not padded operands");
        }
    }
}

fn wasm_test_relocation_owner(): void {
    var object: WasmObject = default;
    defer wasm_object_dispose(&object);
    var code_section: u32 = 3;
    var stride: u32 = 16;
    var code_bytes: usize = 8;
    var operand_bytes = convert(usize, wasm_relocation_width(WasmRelocation.FunctionIndexLeb));
    var functions: u32 = 12;
    object.code_section = code_section;
    for (var row: u32 = 0; row < functions; row++) {
        var function: WasmFunctionRecord = { code_offset: row * stride, code: { data: null, length: code_bytes }, ..default };
        utility_check(vector_push(&object.functions, function), "owner fixture functions");
    }
    var hint = WasmNoIndex;
    for (var iteration: u32 = 0; iteration < functions * 2; iteration++) {
        var row = iteration < functions ? iteration : functions * 2 - iteration - 1;
        var relocation: WasmRelocationRecord = { section: code_section, offset: row * stride + 1, ..default };
        hint = wasm_object_relocation_chunk(&object, &relocation, operand_bytes, hint);
        utility_check(hint == row && wasm_object_relocation_chunk(&object, &relocation, operand_bytes, hint) == row, "ordered and reverse relocations resolve the same owner");
        relocation.offset = row * stride + convert(u32, code_bytes) - 1;
        utility_check(wasm_object_relocation_chunk(&object, &relocation, operand_bytes, hint) == WasmNoIndex, "cached owner still rejects an operand crossing its chunk boundary");
    }
}

fn wasm_test_resolution(): void {
    var strong: ByteBuffer = default;
    var weak: ByteBuffer = default;
    var wrapper: ByteBuffer = default;
    defer bytes_dispose(&strong); defer bytes_dispose(&weak); defer bytes_dispose(&wrapper);
    wasm_test_named_object(&strong, "answer", 0);
    wasm_test_named_object(&weak, "answer", convert(u32, WasmSymbolFlag.Weak));
    wasm_test_named_object(&wrapper, "__wrap_answer", 0);
    var first: WasmBytes = { data: strong.data, length: strong.length };
    var second: WasmBytes = { data: weak.data, length: weak.length };
    for (var mode: u32 = 0; mode < 4; mode++) {
        var link: WasmLink = default;
        utility_check(wasm_link_init(&link), "resolution world");
        var a = mode == 1 || mode == 3 ? second : first;
        var b = mode == 0 || mode == 1 ? first : second;
        utility_check(wasm_link_read_object(&link.world, wasm_text_bytes("a.o"), a)
            && wasm_link_read_object(&link.world, wasm_text_bytes("b.o"), b), "resolution input objects");
        utility_check(wasm_link_prepare(&link), "resolution types and layout rows");
        var ok = wasm_link_symbols(&link);
        if mode == 0 { utility_check(!ok && link.error == WasmLinkError.Duplicate, "duplicate strong definition diagnosed"); }
        else {
            utility_check(ok && link.symbols.length == 1 && link.types.length == 1, "coalesced symbol and function type");
            var selected: u32 = mode == 1 ? 1 : 0;
            utility_check(link.symbols.data[0].definition.object == selected, "strong overrides weak; first weak wins deterministically");
        }
        utility_check(wasm_link_close(&link), "resolution cleanup after success or error");
    }
    var link: WasmLink = default;
    utility_check(wasm_link_init(&link), "wrap world");
    utility_check(wasm_link_read_object(&link.world, wasm_text_bytes("a.o"), first)
        && wasm_link_read_object(&link.world, wasm_text_bytes("wrapper.o"), init(WasmBytes) { data: wrapper.data, length: wrapper.length })
        && wasm_link_prepare(&link) && wasm_link_symbols(&link), "wrap inputs");
    var wrap: WasmWrapRequest = { name: wasm_text_bytes("answer"), wrapper: wasm_text_bytes("__wrap_answer"), real: wasm_text_bytes("__real_answer") };
    utility_check(wasm_link_push(&link, &link.wraps, wrap) && wasm_link_apply_wraps(&link), "wrap bindings");
    utility_check(link.layouts.data[0].symbols.data[0] == link.layouts.data[1].symbols.data[0]
        && link.symbols.data[0].definition.object == 0, "reference wrapping preserves actual definition");
    utility_check(wasm_link_close(&link), "wrap cleanup");
}

fn wasm_test_objects(): void {
    var bytes: ByteBuffer = default;
    defer bytes_dispose(&bytes);
    wasm_test_object(&bytes);
    var input: WasmBytes = { data: bytes.data, length: bytes.length };
    var object: WasmObject = default;
    utility_check(wasm_object_read(&object, input), "minimal relocatable function parses");
    utility_check(object.types.length == 1 && object.functions.length == 1 && object.symbols.length == 1
        && wasm_bytes_text(object.symbols.data[0].name, "answer"), "function and symbol metadata preserved");
    var type_index = object.sections.data[1].bytes.data + 1;
    wasm_object_dispose(&object);
    for (var cut: usize = 0; cut < bytes.length; cut++) {
        utility_check(!wasm_object_read(&object, init(WasmBytes) { data: bytes.data, length: cut }), "every truncated fixture rejected");
        utility_check(object.error != WasmReadError.None && object.error_offset <= cut, "bounded original diagnostic offset");
        wasm_object_dispose(&object);
    }
    *type_index = 1;
    utility_check(!wasm_object_read(&object, input) && object.error == WasmReadError.Index, "invalid function type index rejected");
    wasm_object_dispose(&object); *type_index = 0;
    var left: WasmLinkWorld = default;
    var right: WasmLinkWorld = default;
    utility_check(wasm_link_world_open(&left) && wasm_link_world_open(&right), "independent link worlds");
    utility_check(wasm_link_read_object(&left, wasm_text_bytes("left.o"), input)
        && wasm_link_read_object(&right, wasm_text_bytes("right.o"), input), "world-owned object components");
    utility_check(left.object_type != right.object_type && left.objects.data[0].node.store == left.store
        && right.objects.data[0].node.store == right.store, "component identities never cross worlds");
    utility_check(entity_query_count(left.object_type) == 1 && entity_query_count(right.object_type) == 1, "shared ECS query sees inputs");
    var view = entity_view_open(left.object_type);
    utility_check(view != null && !wasm_link_world_close(&left) && left.objects.length == 1, "pinned input prevents disposal");
    entity_view_close(view);
    utility_check(wasm_link_world_close(&left) && wasm_link_world_close(&right), "world and component cleanup");
    var link: WasmLink = default;
    utility_check(wasm_link_init(&link) && wasm_link_read_object(&link.world, wasm_text_bytes("answer.o"), input), "static output input");
    utility_check(wasm_link_run(&link), "static image emission");
    utility_check(link.output.length != 0 && link.functions.length == 1 && link.output_exports.length == 2, "live exported function and memory emitted");
    utility_check(wasm_link_close(&link), "static output cleanup");
}

fn wasm_test_archives(): void {
    var archive: WasmArchive = default;
    var magic = wasm_text_bytes("!<arch>\n");
    utility_check(wasm_archive_read(&archive, magic) && archive.members.length == 0, "empty ar archive");
    wasm_archive_dispose(&archive);
    utility_check(!wasm_archive_read(&archive, wasm_text_bytes("!<thin>\n")) && archive.error == WasmReadError.Unsupported, "thin archive cannot read implicit filesystem inputs");
    wasm_archive_dispose(&archive);
    var data: ByteBuffer = default;
    defer bytes_dispose(&data);
    utility_check(bytes_append(&data, magic.data, magic.length), "archive header");
    var header: u8[60];
    fill(&header[0], 32, WasmArchiveHeaderBytes);
    header[0] = 97; header[1] = 47;
    header[48] = 57; header[49] = 57; header[50] = 57;
    header[58] = 96; header[59] = 10;
    utility_check(bytes_append(&data, &header[0], WasmArchiveHeaderBytes), "truncated member fixture");
    utility_check(!wasm_archive_read(&archive, init(WasmBytes) { data: data.data, length: data.length })
        && archive.error == WasmReadError.Truncated, "archive member range validated");
    wasm_archive_dispose(&archive);
}

fn wasm_test_archive_header(output: ByteBuffer*, name: u8*, size: usize): void {
    var header: u8[60];
    var space: u8 = 32;
    var slash: u8 = 47;
    var zero: u8 = 48;
    var decimal: usize = 10;
    var quote: u8 = 96;
    var newline: u8 = 10;
    fill(&header[0], space, WasmArchiveHeaderBytes);
    var text = wasm_text_bytes(name);
    utility_check(text.length < WasmArchiveNameBytes, "short fixture archive name");
    copy(&header[0], text.data, text.length);
    if text.length != 0 && text.data[text.length - 1] != slash { header[text.length] = slash; }
    var digits: u8[20];
    var count: usize = 0;
    loop { digits[count++] = zero + convert(u8, size % decimal); size /= decimal; if size == 0 { break; } }
    for (var at: usize = 0; at < count; at++) { header[WasmArchiveSizeOffset + at] = digits[count - at - 1]; }
    header[WasmArchiveHeaderBytes - 2] = quote; header[WasmArchiveHeaderBytes - 1] = newline;
    utility_check(bytes_append(output, &header[0], WasmArchiveHeaderBytes), "fixture archive header");
}

fn wasm_test_archive_u32(output: ByteBuffer*, value: u32): void {
    var octet_bits: u32 = 8;
    var octet_mask: u32 = 255;
    for (var shift: u32 = 32; shift != 0;) { shift -= octet_bits; wasm_test_byte(output, convert(u8, (value >> shift) & octet_mask)); }
}

// Each member has one indexed public definition. Additional undefined symbols
// remain inside the object, as in llvm-ar's real GNU archive index.
fn wasm_test_indexed_archive(output: ByteBuffer*, members: ByteBuffer*, names: u8**, count: usize, indexed: bool): void {
    var magic = wasm_text_bytes("!<arch>\n");
    utility_check(bytes_append(output, magic.data, magic.length), "fixture archive magic");
    var word_bytes: usize = 4;
    var newline: u8 = 10;
    if indexed {
        var size = word_bytes * (count + 1);
        for (var at: usize = 0; at < count; at++) { size += wasm_text_bytes(names[at]).length + 1; }
        wasm_test_archive_header(output, "/", size);
        wasm_test_archive_u32(output, convert(u32, count));
        var offset = magic.length + WasmArchiveHeaderBytes + size + (size & 1);
        for (var at: usize = 0; at < count; at++) {
            wasm_test_archive_u32(output, convert(u32, offset));
            offset += WasmArchiveHeaderBytes + members[at].length + (members[at].length & 1);
        }
        for (var at: usize = 0; at < count; at++) {
            var name = wasm_text_bytes(names[at]);
            utility_check(bytes_append(output, name.data, name.length), "fixture archive symbol");
            wasm_test_byte(output, 0);
        }
        if (size & 1) != 0 { wasm_test_byte(output, newline); }
    }
    for (var at: usize = 0; at < count; at++) {
        wasm_test_archive_header(output, names[at], members[at].length);
        utility_check(bytes_append(output, members[at].data, members[at].length), "fixture archive member");
        if (members[at].length & 1) != 0 { wasm_test_byte(output, newline); }
    }
}

fn wasm_test_dependency_object(output: ByteBuffer*, name: u8*, dependency: u8*, group: u8*): void {
    var header: u8[8] = default;
    header[1] = 97; header[2] = 115; header[3] = 109; header[4] = 1;
    utility_check(bytes_append(output, &header[0], 8), "dependency fixture header");
    var section: ByteBuffer = default;
    var symbols: ByteBuffer = default;
    defer bytes_dispose(&section); defer bytes_dispose(&symbols);
    var imported: u64 = dependency != null ? 1 : 0;
    wasm_test_index(&section, 1); wasm_test_byte(&section, WasmFunctionType);
    wasm_test_index(&section, 0); wasm_test_index(&section, 1); wasm_test_byte(&section, convert(u8, WasmValueType.I32));
    wasm_test_section(output, WasmSection.Type, &section);
    if dependency != null {
        wasm_test_index(&section, 1); wasm_test_name(&section, "env"); wasm_test_name(&section, dependency);
        wasm_test_byte(&section, convert(u8, WasmExternal.Function)); wasm_test_index(&section, 0);
        wasm_test_section(output, WasmSection.Import, &section);
    }
    wasm_test_index(&section, 1); wasm_test_index(&section, 0);
    wasm_test_section(output, WasmSection.Function, &section);
    var call_opcode: u8 = 16;
    var body_bytes: u64 = dependency != null ? 8 : 4;
    var padded_index: usize = 5;
    wasm_test_index(&section, 1); wasm_test_index(&section, body_bytes); wasm_test_index(&section, 0);
    if dependency != null {
        wasm_test_byte(&section, call_opcode);
        for (var at: usize = 0; at < padded_index; at++) { wasm_test_byte(&section, at + 1 < padded_index ? WasmLebContinuation : 0); }
    } else { wasm_test_byte(&section, convert(u8, WasmOpcode.I32Const)); wasm_test_byte(&section, 42); }
    wasm_test_byte(&section, convert(u8, WasmOpcode.End));
    wasm_test_section(output, WasmSection.Code, &section);
    wasm_test_index(&symbols, 1 + imported); wasm_test_byte(&symbols, convert(u8, WasmSymbolKind.Function));
    wasm_test_index(&symbols, 0); wasm_test_index(&symbols, imported); wasm_test_name(&symbols, name);
    if dependency != null {
        wasm_test_byte(&symbols, convert(u8, WasmSymbolKind.Function));
        wasm_test_index(&symbols, convert(u64, WasmSymbolFlag.Undefined)); wasm_test_index(&symbols, 0);
    }
    wasm_test_name(&section, "linking"); wasm_test_index(&section, convert(u64, WasmLinkingVersion));
    wasm_test_byte(&section, convert(u8, WasmLinkingSection.Symbols)); wasm_test_index(&section, convert(u64, symbols.length));
    utility_check(bytes_append(&section, symbols.data, symbols.length), "dependency fixture symbols");
    if group != null {
        symbols.length = 0;
        wasm_test_index(&symbols, 1); wasm_test_name(&symbols, group); wasm_test_index(&symbols, 0); wasm_test_index(&symbols, 1);
        wasm_test_byte(&symbols, convert(u8, WasmComdatKind.Function)); wasm_test_index(&symbols, imported);
        wasm_test_byte(&section, convert(u8, WasmLinkingSection.Comdats)); wasm_test_index(&section, convert(u64, symbols.length));
        utility_check(bytes_append(&section, symbols.data, symbols.length), "dependency fixture comdat");
    }
    wasm_test_section(output, WasmSection.Custom, &section);
    if dependency != null {
        var code_section_index: u64 = 3;
        var call_operand_offset: u64 = 4;
        wasm_test_name(&section, "reloc.CODE"); wasm_test_index(&section, code_section_index);
        wasm_test_index(&section, 1); wasm_test_index(&section, convert(u64, WasmRelocation.FunctionIndexLeb));
        wasm_test_index(&section, call_operand_offset); wasm_test_index(&section, 1);
        wasm_test_section(output, WasmSection.Custom, &section);
    }
}

enum WasmArchiveCase: u32 { Forward = 0, Backward = 1, RequiredExport = 2, OptionalExport = 3, ExplicitDefinition = 4, WeakReference = 5, MissingIndex = 6, Cycle = 7, Comdat = 8, Count = 9 }

fn wasm_test_lazy_archives(): void {
    for (var scenario: u32 = 0; scenario < convert(u32, WasmArchiveCase.Count); scenario++) {
        var mode = convert(WasmArchiveCase, scenario);
        var members: ByteBuffer[3] = default;
        var names: u8*[3]; names[0] = "answer"; names[1] = "helper"; names[2] = "unused";
        var first: ByteBuffer = default;
        var second: ByteBuffer = default;
        var archive: ByteBuffer = default;
        defer bytes_dispose(&members[0]); defer bytes_dispose(&members[1]); defer bytes_dispose(&members[2]);
        defer bytes_dispose(&first); defer bytes_dispose(&second); defer bytes_dispose(&archive);
        wasm_test_dependency_object(&members[0], "answer", "helper", null);
        wasm_test_dependency_object(&members[1], "helper", mode == WasmArchiveCase.Cycle ? "answer" : null, null);
        // An unused malformed object must stay unparsed, even when indexed.
        wasm_test_byte(&members[2], 255);
        wasm_test_indexed_archive(&archive, &members[0], &names[0], 3, mode != WasmArchiveCase.MissingIndex);
        var link: WasmLink = default;
        utility_check(wasm_link_init(&link), "lazy archive world");
        defer wasm_link_close(&link);
        var bytes: WasmBytes = { data: archive.data, length: archive.length };
        if mode == WasmArchiveCase.Backward || mode == WasmArchiveCase.ExplicitDefinition {
            utility_check(wasm_link_add_archive(&link.world, wasm_text_bytes("indexed.a"), bytes), "archive before objects");
        }
        if mode == WasmArchiveCase.ExplicitDefinition { wasm_test_named_object(&first, "answer", 0); }
        else {
            if mode == WasmArchiveCase.Comdat {
                wasm_test_dependency_object(&first, "kept", null, "same_group");
                wasm_test_dependency_object(&second, "answer", null, "same_group");
            } else {
                if mode != WasmArchiveCase.RequiredExport && mode != WasmArchiveCase.OptionalExport {
                    wasm_test_import_object(&first, WasmValueType.I32, mode == WasmArchiveCase.WeakReference ? convert(u32, WasmSymbolFlag.Weak) : 0, true);
                }
            }
        }
        if first.length != 0 {
            var input: WasmBytes = { data: first.data, length: first.length };
            utility_check(wasm_link_read_object(&link.world, wasm_text_bytes("first.o"), input), "lazy archive caller");
        }
        if second.length != 0 {
            var input: WasmBytes = { data: second.data, length: second.length };
            utility_check(wasm_link_read_object(&link.world, wasm_text_bytes("discarded.o"), input), "discarded group object");
        }
        if mode != WasmArchiveCase.Backward && mode != WasmArchiveCase.ExplicitDefinition {
            utility_check(wasm_link_add_archive(&link.world, wasm_text_bytes("indexed.a"), bytes), "archive after objects");
        }
        utility_check(link.world.archives.length == 1 && entity_query_count(link.world.archive_type) == 1, "archive metadata is a world-owned component");
        if mode != WasmArchiveCase.WeakReference && mode != WasmArchiveCase.MissingIndex {
            var request: WasmExportRequest = { name: wasm_text_bytes("answer"), required: mode != WasmArchiveCase.OptionalExport };
            utility_check(wasm_link_push(&link, &link.exports, request), "archive export request");
        }
        var ok = wasm_link_run(&link);
        if mode == WasmArchiveCase.MissingIndex {
            utility_check(!ok && link.error == WasmLinkError.Unsupported && link.output.length == 0, "unindexed lazy archive rejected explicitly");
            continue;
        }
        utility_check(ok, "lazy archive static link");
        var extracted: usize = mode == WasmArchiveCase.ExplicitDefinition || mode == WasmArchiveCase.WeakReference ? 0 : 2;
        var direct: usize = (first.length != 0 ? 1 : 0) + (second.length != 0 ? 1 : 0);
        utility_check(link.world.objects.length == direct + extracted, "only demanded members extracted, cycles terminate");
        if extracted != 0 {
            utility_check(wasm_bytes_text(link.world.objects.data[direct].name, "answer")
                && wasm_bytes_text(link.world.objects.data[direct + 1].name, "helper"), "deterministic depth-first publication order");
        }
        utility_check(!wasm_link_run(&link) && link.error == WasmLinkError.Input && link.output.length == 0
            && link.world.objects.length == direct + extracted, "single-use request rejects replay without re-extraction or stale output");
    }
}

fn wasm_test_byte_plans(): void {
    var object: ByteBuffer = default;
    var original: ByteBuffer = default;
    defer bytes_dispose(&object); defer bytes_dispose(&original);
    wasm_test_named_object(&object, "answer", 0);
    var backend: BackendLink = default;
    defer vector_dispose(&backend.arguments); defer vector_dispose(&backend.inputs);
    defer vector_dispose(&backend.error); defer vector_dispose(&backend.output);
    var input: BackendLinkInput = default;
    defer vector_dispose(&input.name); defer vector_dispose(&input.bytes);
    backend_text(&input.name, "virtual/fixture.o");
    utility_check(vector_reserve(&input.bytes, object.length), "byte plan input allocation");
    copy(input.bytes.data, object.data, object.length); input.bytes.length = object.length;
    utility_check(vector_push(&backend.inputs, input), "borrow test input owner");
    var arguments: u8*[6];
    arguments[0] = "wasm-ld"; arguments[1] = "--no-entry"; arguments[2] = "--export=answer";
    arguments[3] = "-o"; arguments[4] = "virtual/result.wasm"; arguments[5] = "virtual/fixture.o";
    for (var at: usize = 0; at < 6; at++) { utility_check(vector_push(&backend.arguments, arguments[at]), "byte plan arguments"); }
    utility_check(backend_link_tower_wasm(&backend) && backend.error.length == 0 && backend.output.length != 0, "BackendLink uses only supplied bytes");
    utility_check(bytes_append(&original, backend.output.data, backend.output.length), "save deterministic image");
    backend.arguments.data[5] = "missing-input.o";
    utility_check(!backend_link_tower_wasm(&backend) && backend.output.length == 0
        && backend_contains(backend.error.data, "missing-input.o"), "missing explicit input diagnoses its name and removes old result");
    backend.arguments.data[5] = arguments[5];
    utility_check(backend_link_tower_wasm(&backend) && backend.error.length == 0
        && wasm_bytes_equal(init(WasmBytes) { data: original.data, length: original.length }, init(WasmBytes) { data: backend.output.data, length: backend.output.length }), "fresh per-request world produces identical retry output");
    // Byte plans borrow length-delimited keys/arguments; no C-string or file
    // assumptions are allowed inside their option decoder or name lookup.
    var argument_bytes: WasmBytes[2];
    argument_bytes[0] = wasm_text_bytes("--export=answer");
    argument_bytes[1] = init(WasmBytes) { data: "unit.o-unrelated-suffix", length: 6 };
    var source: WasmLinkInputBytes = { name: { data: "unit.o-other-suffix", length: 6 }, bytes: { data: object.data, length: object.length } };
    var link: WasmLink = default;
    utility_check(wasm_link_init(&link) && wasm_link_plan(&link, &argument_bytes[0], 2, &source, 1), "unterminated byte-key request links");
    utility_check(wasm_bytes_equal(init(WasmBytes) { data: original.data, length: original.length }, init(WasmBytes) { data: link.output.data, length: link.output.length }), "CLI-shaped BackendLink and byte plan preserve identical image");
    utility_check(!wasm_link_plan(&link, &argument_bytes[0], 2, &source, 1) && link.error == WasmLinkError.Input
        && link.output.length == 0, "byte plan replay cannot expose an old artifact");
    utility_check(wasm_link_close(&link), "byte plan world cleanup");
    var duplicate: WasmLinkInputBytes[2]; duplicate[0] = source; duplicate[1] = source;
    utility_check(wasm_link_init(&link) && !wasm_link_plan(&link, &argument_bytes[0], 2, &duplicate[0], 2)
        && link.error == WasmLinkError.Duplicate && link.output.length == 0, "ambiguous input capability rejected");
    utility_check(wasm_link_close(&link), "duplicate byte plan cleanup");
    argument_bytes[1] = wasm_text_bytes("-z");
    utility_check(wasm_link_init(&link) && !wasm_link_plan(&link, &argument_bytes[0], 2, &source, 1)
        && link.error == WasmLinkError.Input && link.output.length == 0, "missing option value diagnosed");
    utility_check(wasm_link_close(&link), "invalid byte plan cleanup");
}

fn wasm_test_archive_comdat_fallback(): void {
    var kept: ByteBuffer = default;
    var members: ByteBuffer[2] = default;
    var archive: ByteBuffer = default;
    defer bytes_dispose(&kept); defer bytes_dispose(&archive);
    defer bytes_dispose(&members[0]); defer bytes_dispose(&members[1]);
    wasm_test_dependency_object(&kept, "kept", null, "group");
    wasm_test_dependency_object(&members[0], "answer", null, "group");
    wasm_test_named_object(&members[1], "answer", 0);
    var names: u8*[2]; names[0] = "answer"; names[1] = "answer";
    wasm_test_indexed_archive(&archive, &members[0], &names[0], 2, true);
    var images: ByteBuffer[2] = default;
    defer bytes_dispose(&images[0]); defer bytes_dispose(&images[1]);
    for (var whole: usize = 0; whole < 2; whole++) {
        var link: WasmLink = default;
        defer wasm_link_close(&link);
        var input: WasmBytes = { data: kept.data, length: kept.length };
        var library: WasmBytes = { data: archive.data, length: archive.length };
        utility_check(wasm_link_init(&link) && wasm_link_read_object(&link.world, wasm_text_bytes("kept.o"), input), "COMDAT fallback world");
        var ok = whole == 0 ? wasm_link_add_archive(&link.world, wasm_text_bytes("alternatives.a"), library)
            : wasm_link_read_archive(&link.world, wasm_text_bytes("alternatives.a"), library);
        var request: WasmExportRequest = { name: wasm_text_bytes("answer"), required: true };
        utility_check(ok && wasm_link_push(&link, &link.exports, request) && wasm_link_run(&link), "discarded archive definition continues to next indexed candidate");
        var row = wasm_names_get(&link.names, request.name);
        utility_check(link.world.objects.length == 3 && link.symbols.data[convert(usize, row)].definition.object == 2, "COMDAT selection and final definition agree");
        utility_check(bytes_append(&images[whole], link.output.data, link.output.length), "COMDAT fallback artifact");
    }
    utility_check(wasm_bytes_equal(init(WasmBytes) { data: images[0].data, length: images[0].length },
        init(WasmBytes) { data: images[1].data, length: images[1].length }), "lazy and whole COMDAT selection produce identical bytes");
    archive.length = 0;
    wasm_test_indexed_archive(&archive, &members[0], &names[0], 0, true);
    wasm_test_archive_header(&archive, "unused", 0);
    var link: WasmLink = default;
    defer wasm_link_close(&link);
    var input: WasmBytes = { data: archive.data, length: archive.length };
    utility_check(wasm_link_init(&link) && wasm_link_add_archive(&link.world, wasm_text_bytes("no-symbols.a"), input)
        && wasm_link_run(&link) && link.world.objects.length == 0, "empty symbol index is distinct from missing index");
}

enum WasmMemoryCase: u8 { Defined, DefaultImport, NamedImport, UnlimitedImport, EmptyNames, MissingSeparator, ExtraSeparator, InvalidUtf8, TooSmall, Count }

fn wasm_test_memory_imports(): void {
    var object: ByteBuffer = default;
    defer bytes_dispose(&object);
    wasm_test_named_object(&object, "answer", 0);
    var source: WasmLinkInputBytes = { name: wasm_text_bytes("unit.o"), bytes: { data: object.data, length: object.length } };
    for (var mode = WasmMemoryCase.Defined; mode != WasmMemoryCase.Count; mode = convert(WasmMemoryCase, convert(u8, mode) + 1)) {
        var link: WasmLink = default;
        defer wasm_link_close(&link);
        utility_check(wasm_link_init(&link), "memory profile world");
        var argument_count: usize = 3;
        var arguments: WasmBytes[3];
        arguments[0] = wasm_text_bytes("--export=answer"); arguments[1] = source.name;
        arguments[2] = wasm_text_bytes("--import-memory");
        var expected_module = wasm_text_bytes("env"); var expected_name = wasm_text_bytes("memory");
        var invalid_utf8: u8 = 255;
        match mode {
            WasmMemoryCase.Defined => { argument_count--; }
            WasmMemoryCase.NamedImport => {
                arguments[2] = wasm_text_bytes("--import-memory=host,linear");
                expected_module = wasm_text_bytes("host"); expected_name = wasm_text_bytes("linear");
            }
            WasmMemoryCase.UnlimitedImport => { link.maximum_memory = 0; }
            WasmMemoryCase.EmptyNames => {
                arguments[2] = wasm_text_bytes("--import-memory=,");
                expected_module = default; expected_name = default;
            }
            WasmMemoryCase.MissingSeparator => { arguments[2] = wasm_text_bytes("--import-memory=host"); }
            WasmMemoryCase.ExtraSeparator => { arguments[2] = wasm_text_bytes("--import-memory=host,linear,other"); }
            WasmMemoryCase.InvalidUtf8 => {
                // Byte plans can contain arbitrary bytes, unlike ordinary source literals.
                argument_count--; link.import_memory = true;
                link.memory_name = init(WasmBytes) { data: &invalid_utf8, length: 1 };
            }
            WasmMemoryCase.TooSmall => { link.initial_memory = WasmPageBytes; link.stack_size = WasmPageBytes * 2; }
            _ => { }
        }
        var ok = wasm_link_plan(&link, &arguments[0], argument_count, &source, 1);
        if mode == WasmMemoryCase.MissingSeparator || mode == WasmMemoryCase.ExtraSeparator || mode == WasmMemoryCase.InvalidUtf8 || mode == WasmMemoryCase.TooSmall {
            utility_check(!ok && link.output.length == 0 && link.error == (mode == WasmMemoryCase.TooSmall ? WasmLinkError.Layout : WasmLinkError.Input), "invalid memory request publishes no output");
            continue;
        }
        utility_check(ok, "memory profile links");
        var output: WasmObject = default;
        defer wasm_object_dispose(&output);
        var reader: WasmReader = { bytes: { data: link.output.data, length: link.output.length }, ..default };
        wasm_object_sections(&output, &reader);
        utility_check(reader.error == WasmReadError.None && output.memories.length == 1, "one valid output memory");
        var memory = &output.memories.data[0];
        utility_check(memory.imported == (mode != WasmMemoryCase.Defined), "defined and imported memory are distinct");
        utility_check(memory.limits.minimum == link.initial_memory / WasmPageBytes && memory.limits.maximum == link.maximum_memory / WasmPageBytes
            && memory.limits.flags == (link.maximum_memory == 0 ? 0 : convert(u32, WasmLimitFlag.Maximum)), "memory limits retained in either section");
        if memory.imported { utility_check(wasm_bytes_equal(memory.module, expected_module) && wasm_bytes_equal(memory.name, expected_name), "memory import module and field preserved"); }
        var exports: usize = 0;
        foreach (var & item in &output.exports) {
            if item.kind == convert(u8, WasmExternal.Memory) { exports++; utility_check(item.index == 0 && wasm_bytes_text(item.name, "memory"), "memory re-export preserves index zero"); }
        }
        utility_check(exports == 1, "requested memory export retained");
    }
}

export fn main(): i32 {
    wasm_test_leb(); wasm_test_objects(); wasm_test_archives(); wasm_test_names(); wasm_test_name_encoding(); wasm_test_resolution();
