// Functional host tests execute Tower implementations on the test host target.
extern fn tower_test_buffer_count(): usize;

extern fn tower_test_buffer_fail_next(): void;

export fn host_runtime_tests(): i32 {
    var maximum: usize = 0;
    maximum = maximum - 1;
    // Both diagnostic and ordinary compiler allocation are Tower algorithms.
    var node_state: CompilerNodeMemoryState;
    node_state.live_allocations = 0;
    var rejected = compiler_node_allocate(&node_state, maximum, true);
    var bad = rejected != null;
    if bad {
        return 701;
    }
    bad = node_state.live_allocations != 0;
    if bad {
        return 702;
    }
    var size: usize = 0;
    loop {
        var done = size == 65;
        if done {
            break;
        }
        var diagnostic = compiler_node_allocate(&node_state, size, true);
        var ordinary = compiler_node_allocate(&node_state, size, false);
        bad = diagnostic == null;
        if bad {
            return 703;
        }
        bad = ordinary == null;
        if bad {
            return 704;
        }
        bad = node_state.live_allocations != 2;
        if bad {
            return 705;
        }
        var remainder = bits(usize, diagnostic) % sizeof(usize);
        bad = remainder != 0;
        if bad {
            return 706;
        }
        fill(diagnostic, 42, size);
        copy(ordinary, diagnostic, size);
        compiler_node_free(&node_state, diagnostic, true);
        compiler_node_free(&node_state, ordinary, false);
        compiler_node_free(&node_state, null, true);
        bad = node_state.live_allocations != 0;
        if bad {
            return 707;
        }
        size = size + 1;
    }
    var state: CompilerMemoryState;
    state.live_buffers = 0;
    state.allocation_calls = 0;
    state.fail_after = maximum;
    var pointer = compiler_memory_reallocate(&state, null, 4, 2);
    var check_1 = pointer == null;
    if check_1 {
        return 1;
    }
    var check_2 = state.live_buffers != 1;
    if check_2 {
        return 2;
    }
    var bytes = bits(u8*, pointer);
    bytes[0] = 42;
    bytes[7] = 91;
    // Overflow must not consume an injection or touch the original allocation.
    state.fail_after = 0;
    var next = compiler_memory_reallocate(&state, pointer, maximum, 2);
    var check_3 = next != null;
    if check_3 {
        return 3;
    }
    var check_4 = state.allocation_calls != 1;
    if check_4 {
        return 4;
    }
    var check_5 = state.fail_after != 0;
    if check_5 {
        return 5;
    }
    next = compiler_memory_reallocate(&state, pointer, 32, 1);
    var check_6 = next != null;
    if check_6 {
        return 6;
    }
    var check_7 = state.fail_after != maximum;
    if check_7 {
        return 7;
    }
    var check_8 = state.live_buffers != 1;
    if check_8 {
        return 8;
    }
    var check_9 = bytes[0] != 42;
    if check_9 {
        return 9;
    }
    var check_10 = bytes[7] != 91;
    if check_10 {
        return 10;
    }
    next = compiler_memory_reallocate(&state, pointer, 32, 1);
    var check_11 = next == null;
    if check_11 {
        return 11;
    }
    pointer = next;
    bytes = bits(u8*, pointer);
    var check_12 = bytes[0] != 42;
    if check_12 {
        return 12;
    }
    var check_13 = bytes[7] != 91;
    if check_13 {
        return 13;
    }
    var check_14 = state.live_buffers != 1;
    if check_14 {
        return 14;
    }
    // Injected failure precedes the zero-size free, matching the old host.
    state.fail_after = 0;
    next = compiler_memory_reallocate(&state, pointer, 0, 1);
    var check_15 = next != null;
    if check_15 {
        return 15;
    }
    var check_16 = state.live_buffers != 1;
    if check_16 {
        return 16;
    }
    var check_17 = bytes[0] != 42;
    if check_17 {
        return 17;
    }
    next = compiler_memory_reallocate(&state, pointer, maximum, 0);
    var check_18 = next != null;
    if check_18 {
        return 18;
    }
    var check_19 = state.live_buffers != 0;
    if check_19 {
        return 19;
    }
    compiler_memory_deallocate(&state, null);
    var check_20 = state.live_buffers != 0;
    if check_20 {
        return 20;
    }
    state.fail_after = 1;
    pointer = compiler_memory_reallocate(&state, null, 1, 1);
    var check_21 = pointer == null;
    if check_21 {
        return 21;
    }
    next = compiler_memory_reallocate(&state, null, 1, 1);
    var check_22 = next != null;
    if check_22 {
        return 22;
    }
    compiler_memory_deallocate(&state, pointer);
    pointer = compiler_memory_reallocate(null, null, 8, 1);
    var check_23 = pointer == null;
    if check_23 {
        return 23;
    }
    compiler_memory_deallocate(null, pointer);
    var check_24 = state.live_buffers != 0;
    if check_24 {
        return 24;
    }

    var buffers = tower_test_buffer_count();
    var options: DriverOptions;
    var argv: u8*[40];
    argv[0] = "towerc";
    var args = &argv[0];
    var ok = driver_parse(&options, 1, args, "host-target");
    var check_25 = ok == false;
    if check_25 {
        return 25;
    }
    var check_26 = driver_equal(options.target, "host-target") == false;
    if check_26 {
        return 26;
    }
    var check_27 = driver_equal(options.emit, "exe") == false;
    if check_27 {
        return 27;
    }
    var check_28 = driver_equal(options.cc, "clang") == false;
    if check_28 {
        return 28;
    }
    var check_29 = options.optimize == false;
    if check_29 {
        return 29;
    }
    driver_dispose(&options);
    argv[1] = "input.tower";
    argv[2] = "--link";
    argv[3] = "first.o";
    argv[4] = "--link";
    argv[5] = "second.a";
    argv[6] = "--library";
    argv[7] = "--emit";
    argv[8] = "llvm";
    argv[9] = "--no-optimize";
    argv[10] = "--interpret";
    argv[11] = "--timings";
    argv[12] = "--target";
    argv[13] = "explicit-target";
    argv[14] = "-o";
    argv[15] = "first.out";
    argv[16] = "-o";
    argv[17] = "last.out";
    argv[18] = "--cc";
    argv[19] = "cc path";
    argv[20] = "--linker";
    argv[21] = "linker path";
    argv[22] = "--sysroot";
    argv[23] = "root path";
    argv[24] = "--raw-ir";
    argv[25] = "raw.ll";
    argv[26] = "--optimized-ir";
    argv[27] = "optimized.ll";
    argv[28] = "--bedrock";
    argv[29] = "bedrock path";
    argv[30] = "--foundation";
    argv[31] = "foundation path";
    ok = driver_parse(&options, 32, args, "host");
    var check_30 = ok == false;
    if check_30 {
        return 30;
    }
    var check_31 = driver_equal(options.source, "input.tower") == false;
    if check_31 {
        return 31;
    }
    var check_32 = options.link_count != 2;
    if check_32 {
        return 32;
    }
    var check_33 = driver_equal(options.links[0], "first.o") == false;
    if check_33 {
        return 33;
    }
    var check_34 = driver_equal(options.links[1], "second.a") == false;
    if check_34 {
        return 34;
    }
    var check_35 = options.library == false;
    if check_35 {
        return 35;
    }
    var check_36 = driver_equal(options.emit, "llvm") == false;
    if check_36 {
        return 36;
    }
    if options.optimize {
        return 37;
    }
    var check_37 = options.interpret == false;
    if check_37 {
        return 38;
    }
    var check_38 = options.timings == false;
    if check_38 {
        return 39;
    }
    var check_39 = driver_equal(options.target, "explicit-target") == false;
    if check_39 {
        return 40;
    }
    var check_40 = driver_equal(options.output, "last.out") == false;
    if check_40 {
        return 41;
    }
    var check_41 = driver_equal(options.cc, "cc path") == false;
    if check_41 {
        return 42;
    }
    var check_42 = driver_equal(options.linker, "linker path") == false;
    if check_42 {
        return 43;
    }
    var check_43 = driver_equal(options.sysroot, "root path") == false;
    if check_43 {
        return 44;
    }
    var check_44 = driver_equal(options.raw, "raw.ll") == false;
    if check_44 {
        return 45;
    }
    var check_45 = driver_equal(options.optimized, "optimized.ll") == false;
    if check_45 {
        return 46;
    }
    var check_46 = driver_equal(options.bedrock, "bedrock path") == false;
    if check_46 {
        return 47;
    }
    var check_47 = driver_equal(options.foundation, "foundation path") == false;
    if check_47 {
        return 48;
    }
    driver_dispose(&options);
    // Every value option must diagnose a missing final value.
    var flags: u8*[11];
    flags[0] = "-o";
    flags[1] = "--target";
    flags[2] = "--emit";
    flags[3] = "--link";
    flags[4] = "--cc";
    flags[5] = "--linker";
    flags[6] = "--sysroot";
    flags[7] = "--raw-ir";
    flags[8] = "--optimized-ir";
    flags[9] = "--bedrock";
    flags[10] = "--foundation";
    var index: usize = 0;
    loop {
        var check_48 = index == 11;
        if check_48 {
            break;
        }
        argv[1] = flags[index];
        ok = driver_parse(&options, 2, args, "host");
        if ok {
            return 49;
        }
        var check_49 = options.error != 1;
        if check_49 {
            return 50;
        }
        var check_50 = options.argument != flags[index];
        if check_50 {
            return 51;
        }
        driver_dispose(&options);
        index = index + 1;
    }
    argv[1] = "--help";
    argv[2] = "--invalid";
    ok = driver_parse(&options, 3, args, "host");
    var check_51 = ok == false;
    if check_51 {
        return 52;
    }
    var check_52 = options.help == false;
    if check_52 {
        return 53;
    }
    driver_dispose(&options);
    argv[1] = "--invalid";
    argv[2] = "--help";
    ok = driver_parse(&options, 3, args, "host");
    if ok {
        return 54;
    }
    var check_53 = options.error != 2;
    if check_53 {
        return 55;
    }
    driver_dispose(&options);
    argv[1] = "one.tower";
    argv[2] = "two.tower";
    ok = driver_parse(&options, 3, args, "host");
    if ok {
        return 56;
    }
    var check_54 = options.argument != argv[2];
    if check_54 {
        return 57;
    }
    driver_dispose(&options);
    argv[1] = "--emit";
    argv[2] = "exe";
    argv[3] = "--library";
    ok = driver_parse(&options, 4, args, "host");
    var check_55 = ok == false;
    if check_55 {
        return 58;
    }
    var check_56 = driver_equal(options.emit, "object") == false;
    if check_56 {
        return 59;
    }
    driver_dispose(&options);
    // Values beginning with '-' are still values, including --help.
    argv[1] = "-o";
    argv[2] = "--help";
    ok = driver_parse(&options, 3, args, "host");
    var check_57 = ok == false;
    if check_57 {
        return 60;
    }
    if options.help {
        return 61;
    }
    var check_58 = driver_equal(options.output, "--help") == false;
    if check_58 {
        return 62;
    }
    driver_dispose(&options);
    argv[1] = "--link";
    argv[2] = "first.o";
    tower_test_buffer_fail_next();
    ok = driver_parse(&options, 3, args, "host");
    if ok {
        return 63;
    }
    var check_59 = options.error != 3;
    if check_59 {
        return 64;
    }
    driver_dispose(&options);
    // An error after a successful allocation must remain disposable.
    argv[3] = "--invalid";
    ok = driver_parse(&options, 4, args, "host");
    if ok {
        return 65;
    }
    var check_60 = options.link_count != 1;
    if check_60 {
        return 66;
    }
    driver_dispose(&options);
    driver_dispose(&options);
    var check_61 = tower_test_buffer_count() != buffers;
    if check_61 {
        return 67;
    }
    return host_services_tests();
}
