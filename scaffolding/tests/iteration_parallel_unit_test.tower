import tower;
import library.testing;
import .library.vector;
import foreach_inputs.vector_values as copies;
import foreach_inputs.ring_order as ring;
import foreach_inputs.protocol_cleanup as protocol;
import foreach_inputs.loop_targets as control;
import foreach_inputs.worker_checksum as worker;

var observed: vector(i32);

fn record(value: i32): void {
    print(value);
    assert(vector_push(&observed, value));
}

fn matches(T: type, wanted: T*): bool {
    if observed.length != sizeof(T) / sizeof(i32) { return false; }
    for (var index: usize = 0; index < observed.length; index++) {
        if observed.data[index] != (*wanted)[index] { return false; }
    }
    return true;
}

test() {
    vector_init(&observed);
    defer vector_dispose(&observed);
    copies.vector_values(record);
    var wanted: i32[11] = {11, 12, 13, 1, 1, 2, 4, 6, 21, 22, 21};
    assert(matches(&wanted), "Vector copies and borrowed writes");
}

test() {
    vector_init(&observed);
    defer vector_dispose(&observed);
    ring.ring_order(record);
    var wanted: i32[10] = {6, 7, 8, 9, 16, 17, 18, 19, 4, 5};
    assert(matches(&wanted), "Wrapped queue and stack order");
}

test() {
    vector_init(&observed);
    defer vector_dispose(&observed);
    protocol.protocol_cleanup(record);
    var wanted: i32[9] = {4, 1332, 99, 3, 132, 3, 1122, 12, 42};
    assert(matches(&wanted), "Protocol cleanup and shadowed items");
}

test() {
    vector_init(&observed);
    defer vector_dispose(&observed);
    control.loop_targets(record);
    var wanted: i32[4] = {26, 1, 2, 1};
    assert(matches(&wanted), "Nested loop targets and deferred iteration");
}

test() {
    var checksum = worker.worker_checksum();
    print(checksum);
    assert(checksum == 39, "Shared iteration worker checksum");
}
