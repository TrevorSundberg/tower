import tower;
import .compiler.compiler_kernel;
import .library.work_pool;

// The coordinator alone arms and consumes the one-shot signal fault. The
// separately linked Linux transport exports its ordinary open under this name.
extern fn __real_work_signal_open(): void*;
var DispatchFailSignal: bool = false;
var DispatchScratchBytes: usize = 262144;
export fn work_signal_open(): void* {
    if DispatchFailSignal { DispatchFailSignal = false; return null; }
    return __real_work_signal_open();
}

struct DispatchResultJob {
    prefix: usize;
    kernel: CompilerKernel;
    entered: void*;
    release: void*;
    calls: usize;
    input: usize;
    result: usize;
    observed: usize;
}
