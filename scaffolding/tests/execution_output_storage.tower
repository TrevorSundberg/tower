import tower;
import execution_support;
import execution_world;
import execution_fast_storage;
import .compiler.execution_session;
import .compiler.execution_package;
import .compiler.interpreter_context_types;
import .compiler.interpreter_text;
import .library.work_budget;
import .library.work_vector;
import .library.work_vector_types;
import .library.work_text;
import .library.work_buffer;
import .host.driver_request;

extern fn interpreter_invocation_dispose(invocation: IMInvocation*): void;

fn output_storage_fill(budget: WorkBudget*, occupied: WorkReservation*): void {
    var snapshot = fast_storage_snapshot(budget);
    execution_check(work_budget_reserve_result(budget, 0, 0, snapshot.bytes - snapshot.used_bytes, occupied)
        == WorkBudgetError.None, "Occupy the actual remaining output allowance");
}

fn output_storage_invocation(): void {
    var budget: WorkBudget = default;
    execution_check(work_budget_init(&budget, 1, FastStorageBudgetBytes, 1), "Invocation text budget");
    var invocation: IMInvocation = default;
    invocation.state.budget = &budget;
    im_text_append(&invocation.state, &invocation.context.output, &invocation.context.error, "prefix", strlen("prefix"));
    var saved = invocation.context.output;
    var snapshot = fast_storage_snapshot(&budget);
    execution_check(snapshot.used_bytes == saved.reservation.bytes
        && saved.reservation.bytes == compiler_buffer_allocation_size(saved.capacity),
        "Staged output charges payload, terminator and compiler header");
    var occupied: WorkReservation = default;
    output_storage_fill(&budget, &occupied);
    im_text_append(&invocation.state, &invocation.context.output, &invocation.context.error, "replacement cannot fit", strlen("replacement cannot fit"));
    execution_check(invocation.state.failed && invocation.state.done && invocation.state.storage_error == WorkBudgetError.Capacity
        && invocation.context.error.length == 0 && invocation.context.output.data == saved.data
        && execution_text(&invocation.context.output, "prefix") && invocation.state.output_bytes == strlen("prefix"),
        "Staged output denial is terminal and preserves every admitted byte without a diagnostic allocation");
    im_text_fail(&invocation.state, &invocation.context.error, "later", strlen("later"), 99);
    execution_check(invocation.state.error_offset == 0, "Later failure cannot replace the first offset");
    execution_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release staged pressure");
    im_text_append(&invocation.state, &invocation.context.output, &invocation.context.error, "no replay", strlen("no replay"));
    execution_check(execution_text(&invocation.context.output, "prefix"), "Returning capacity does not replay output");
    interpreter_invocation_dispose(&invocation);
    snapshot = fast_storage_snapshot(&budget);
    execution_check(snapshot.used_bytes == 0 && snapshot.live == 0, "Cancelled invocation releases output and diagnostic grants");

    invocation.state.budget = &budget;
    var message = "counted first error";
    execution_check(work_vector_reserve(&invocation.context.error, &budget, strlen(message) + 1), "Pre-admit counted diagnostic owner");
    output_storage_fill(&budget, &occupied);
    var counted: u8[3] = default;
    counted[0] = 65; counted[2] = 66;
    im_text_fail(&invocation.state, &invocation.context.error, &counted[0], sizeof(decltype(counted)), 17);
    im_text_fail(&invocation.state, &invocation.context.error, message, strlen(message), 18);
    execution_check(invocation.state.failed && invocation.state.storage_error == WorkBudgetError.None
        && invocation.state.error_offset == 17 && invocation.context.error.length == sizeof(decltype(counted))
        && memcmp(invocation.context.error.data, &counted[0], sizeof(decltype(counted))) == 0,
        "Counted diagnostics preserve embedded NUL, first offset and pre-admitted ownership");
    execution_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release diagnostic pressure");
    interpreter_invocation_dispose(&invocation);
    execution_check(work_budget_dispose(&budget), "Invocation ledger drains");
}

fn execution_output_storage_tests(request: DriverRequest*): void {
    output_storage_invocation();
    var source = "import tower; print(7); print(123456789); print(9);";
    for(var width: u32 = 4; width <= 8; width *= 2) {
        var budget: WorkBudget = default;
        var world: void* = null;
        execution_check(work_budget_init(&budget, 1, FastStorageBudgetBytes, 1)
            && compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None, "Output fixture world");
        var modules = frontend_modules_create();
        execution_world_prepare(world, modules, request);
        var anchor: ExecutionSession = default;
        execution_compile(&anchor, source, width, modules);
        var baseline = fast_storage_snapshot(&budget);
        var engines: bool[2] = default;
        engines[1] = true;
        for(var engine: usize = 0; engine < sizeof(decltype(engines)) / sizeof(bool); engine++) {
            var fast = engines[engine];
            var trial: ExecutionSession = default;
            fast_storage_open(&trial, anchor.program.root, width);
            execution_check(!fast || execution_session_fast(&trial), "Output fixture starts chosen engine");
            for(var step: usize = 0; step < FastStorageStepLimit && trial.output.length == 0; step++) {
                execution_session_step(&trial, 1);
            }
            execution_check(execution_text(&trial.output, "7\n"), "First output effect precedes pressure");
            var saved = trial.output;
            var occupied: WorkReservation = default;
            output_storage_fill(&budget, &occupied);
            execution_run(&trial, 1, FastStorageStepLimit);
            execution_check(trial.machine.failed && trial.machine.done && trial.machine.storage_error == WorkBudgetError.Capacity
                && trial.error.length == 0 && trial.output.data == saved.data
                && execution_text(&trial.output, "7\n") && !trial.machine.output_truncated,
                "Graph and Fast fail immediately without partial output, truncation or a later assertion");
            var steps = trial.machine.steps;
            execution_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release runtime output pressure");
            execution_session_step(&trial, FastStorageStepLimit);
            execution_check(trial.machine.steps == steps && execution_text(&trial.output, "7\n"), "Failed output never replays effects");
            execution_session_close(&trial);
            var drained = fast_storage_snapshot(&budget);
            execution_check(drained.used_bytes == baseline.used_bytes && drained.live == baseline.live, "Runtime cancellation returns every private grant");
        }
        execution_check(execution_session_fast(&anchor), "Package fixture cache");
        var package: work_vector(u8) = default;
        execution_check(bytecode_encode(anchor.fast, source, strlen(source), convert(usize, width), 0, &package)
            == WorkBudgetError.None, "Checked package owner");
        var saved = package;
        execution_check(bytecode_encode(anchor.fast, source, strlen(source), width == 4 ? 8 : 4, 0, &package)
            == WorkBudgetError.Invalid && package.data == saved.data,
            "Encoder rejects a supported width that disagrees with its actual execution cache");
        var before = fast_storage_snapshot(&budget);
        var occupied: WorkReservation = default;
        output_storage_fill(&budget, &occupied);
        execution_check(bytecode_encode(anchor.fast, source, strlen(source), convert(usize, width), 0, &package)
            == WorkBudgetError.Capacity && package.data == saved.data && package.length == saved.length
            && package.reservation.generation == saved.reservation.generation && bytecode_validate(package.data, package.length) == 0,
            "Denied replacement preserves old package bytes, target, cache and grant transactionally");
        execution_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release package pressure");
        execution_check(bytecode_encode(anchor.fast, source, strlen(source), convert(usize, width), 0, &package)
            == WorkBudgetError.None && package.data != saved.data, "Admitted replacement publishes a complete new owner");
        var after = fast_storage_snapshot(&budget);
        execution_check(after.used_bytes == before.used_bytes && after.live == before.live
            && after.peak_bytes >= before.used_bytes + package.reservation.bytes, "Package replacement counts both coexisting allocations at peak");
        var transferred: work_vector(u8) = default;
        work_vector_move(&transferred, &package);
        execution_session_close(&anchor);
        execution_check(package.data == null && transferred.reservation.owner == &budget
            && bytecode_validate(transferred.data, transferred.length) == 0, "Package snapshot and grant survive producer teardown");
        work_vector_dispose(&transferred);
        frontend_modules_destroy(modules);
        execution_check(frontend_world_clear(world) && compiler_world_dispose(world), "Output world drains after package consumers");
        after = fast_storage_snapshot(&budget);
        execution_check(after.used_bytes == 0 && after.live == 0 && work_budget_dispose(&budget), "Output and package ledger fully retires");
    }
    puts("Counted interpreter output and transactional package ownership passed.");
}
