import tower;
import frontend_units;
import .library.vector;
import .compiler.semantic_program_types;
import .compiler.format_types;
import .compiler.interpreter_context_types;

extern fn ix_init(execution: IMExecution*): void;

fn body_runs_trial(source: u8*, budget: usize, width: u32, bedrock: u8*, foundation: u8*, root: u8*, canonical: vector(u8)*): void {
    var batch = frontend_units_create(1, budget, width, 81, 23, bedrock, foundation, root);
    units_check(batch is not null, "Body continuation batch");
    defer frontend_units_close(batch);
    units_check(frontend_units_source(batch, 1, "continuations.tower", source, strlen(source)), "Body continuation source");
    while !frontend_units_step(batch, true) {}
    if frontend_units_failed(batch) != 0 {
        puts(frontend_units_error(batch));
    }
    units_check(frontend_units_failed(batch) == 0, "Body continuation compilation");
    var program = frontend_units_program(batch, 1);
    var invocation: IMInvocation = default;
    // The ordinary program entry includes module initialization. Function-only
    // invocation intentionally omits it; use the shared interpreter context.
    invocation.state.stack = 16;
    invocation.state.heap = 4194304;
    invocation.context.root = program.root;
    invocation.context.pointer_bytes = convert(usize, width);
    var execution: IMExecution = default;
    execution.state = &invocation.state;
    execution.context = &invocation.context;
    ix_init(&execution);
    while !invocation.state.done && !invocation.state.failed {
        interpreter_invocation_step(&invocation, 7);
    }
    if invocation.state.failed {
        puts(invocation.context.error.data);
    }
    units_check(!invocation.state.failed && invocation.context.output.length == 2 && invocation.context.output.data[0] == 48 && invocation.context.output.data[1] == 10, "Body continuation locals, flow and cleanup");
    interpreter_invocation_dispose(&invocation);
    var formatted: FormatResult = default;
    format_entity(&formatted, program.root, null, null, null);
    units_check(!formatted.failed, "Body continuation canonical output");
    if canonical.length == 0 {
        foreach(var byte in &formatted.text) {
            units_check(vector_push(canonical, byte), "Body continuation baseline");
        }
    } else {
        units_check(canonical.length == formatted.text.length, "Body continuation canonical length");
        for(var i: usize = 0; i < canonical.length; i++) {
            units_check(canonical.data[i] == formatted.text.data[i], "Body continuation canonical bytes");
        }
    }
    format_dispose(&formatted);
}

fn body_runs_diagnostic(budget: usize, bedrock: u8*, foundation: u8*, root: u8*, structural: bool): void {
    var batch = frontend_units_create(1, budget, 8, 82, 23, bedrock, foundation, root);
    units_check(batch is not null, "Body diagnostic batch");
    defer frontend_units_close(batch);
    var source: u8* = "import tower; fn id(T:type,x:T):T{return x;} fn first():i32 {var a:i32=1; a++; var b=id(a); b++; var c=id(b); return unknownFirst;} fn later():i32 {return unknownSecond;}";
    if structural {
        source = "import tower; fn id(T:type,x:T):T{return x;} fn first():i32 {var a:i32=1; a++; var b=id(a); b++; return id(unknownFirst);} fn later():i32 {return unknownSecond;}";
    }
    units_check(frontend_units_source(batch, 1, "diagnostic.tower", source, strlen(source)), "Body diagnostic source");
    while !frontend_units_step(batch, true) {}
    units_check(frontend_units_failed(batch) == 1 && strstr(frontend_units_error(batch), "unknownFirst") is not null && strstr(frontend_units_error(batch), "unknownSecond") is null, "Earlier resumed body diagnostic wins");
}

fn body_runs_cycle(budget: usize, bedrock: u8*, foundation: u8*, root: u8*, earlier_fails: bool): void {
    var batch = frontend_units_create(1, budget, 8, 83, 23, bedrock, foundation, root);
    units_check(batch is not null, "Body layout-cycle batch");
    defer frontend_units_close(batch);
    var source: u8* = "import tower; fn id(T:type,x:T):T{return x;} fn bad(T:type):type{struct Recursive{value:Recursive;}return Recursive;} fn first():i32{var a=id(1);a++;var b=id(a);return b;} fn later():i32{var invalid:bad(i32);return 0;}";
    if earlier_fails {
        source = "import tower; fn id(T:type,x:T):T{return x;} fn bad(T:type):type{struct Recursive{value:Recursive;}return Recursive;} fn first():i32{var a=id(1);a++;var b=id(a);return unknownFirst;} fn later():i32{var invalid:bad(i32);return 0;}";
    }
    units_check(frontend_units_source(batch, 1, "cycle.tower", source, strlen(source)), "Body layout-cycle source");
    while !frontend_units_step(batch, true) {}
    var error = frontend_units_error(batch);
    units_check(frontend_units_failed(batch) == 1, "Body layout-cycle failure");
    if earlier_fails {
        units_check(strstr(error, "unknownFirst") is not null, "Earlier resumed error precedes later construction cycle");
    } else {
        units_check(strstr(error, "Recursive by-value layout") is not null, "Resumed construction retains its layout-cycle diagnostic");
    }
}

fn body_runs_nested_error(budget: usize, bedrock: u8*, foundation: u8*, root: u8*): void {
    var batch = frontend_units_create(1, budget, 8, 84, 23, bedrock, foundation, root);
    units_check(batch is not null, "Nested error batch");
    defer frontend_units_close(batch);
    var source: u8* = "import tower; fn id(T:type,x:T):T{return x;} fn first():i32 {var a:i32=1; {var b=id(a); b++; {var c=id(b); return unknownNested;}}} fn later():i32{return unknownSecond;}";
    units_check(frontend_units_source(batch, 1, "nested_error.tower", source, strlen(source)), "Nested error source");
    while !frontend_units_step(batch, true) {}
    var error = frontend_units_error(batch);
    units_check(frontend_units_failed(batch) == 1 && strstr(error, "unknownNested") is not null && strstr(error, "unknownSecond") is null, "Earlier nested error wins across resumptions");
}

fn body_runs_control_error(budget: usize, bedrock: u8*, foundation: u8*, root: u8*): void {
    var batch = frontend_units_create(1, budget, 8, 85, 23, bedrock, foundation, root);
    units_check(batch is not null, "Control error batch");
    defer frontend_units_close(batch);
    var source: u8* = "import tower; fn id(T:type,x:T):T{return x;} fn first():i32 {loop {var a=id(1); if a>0 {var b=id(a); {var c=id(b); return unknownControl;}} break;} return 0;} fn later():i32{return unknownSecond;}";
    units_check(frontend_units_source(batch, 1, "control_error.tower", source, strlen(source)), "Control error source");
    while !frontend_units_step(batch, true) {}
    var error = frontend_units_error(batch);
    units_check(frontend_units_failed(batch) == 1 && strstr(error, "unknownControl") is not null && strstr(error, "unknownSecond") is null, "Earlier control-body error wins across resumptions");
}

fn body_runs_header_error(budget: usize, bedrock: u8*, foundation: u8*, root: u8*): void {
    var batch = frontend_units_create(1, budget, 8, 86, 23, bedrock, foundation, root);
    units_check(batch is not null, "Header error batch");
    defer frontend_units_close(batch);
    var source: u8* = "import tower; fn id(T:type,x:T):T{return x;} fn first():i32 {var a=id(1); if id(unknownHeader)>0 {return a;} return 0;} fn later():i32{return unknownSecond;}";
    units_check(frontend_units_source(batch, 1, "header_error.tower", source, strlen(source)), "Header error source");
    while !frontend_units_step(batch, true) {}
    var error = frontend_units_error(batch);
    units_check(frontend_units_failed(batch) == 1 && strstr(error, "unknownHeader") is not null && strstr(error, "unknownSecond") is null, "Failed header preparation releases its lexical state and preserves error order");
}

fn body_runs_header_cycle(budget: usize, bedrock: u8*, foundation: u8*, root: u8*, earlier_fails: bool): void {
    var batch = frontend_units_create(1, budget, 8, 87, 23, bedrock, foundation, root);
    units_check(batch is not null, "Header cycle batch");
    defer frontend_units_close(batch);
    var source: u8* = "import tower; fn id(T:type,x:T):T{return x;} fn bad(T:type):type{struct Recursive{value:Recursive;}return Recursive;} fn first():i32{var a=id(1);a++;var b=id(a);return b;} fn later():i32{if sizeof(bad(i32))>0{return 1;}return 0;}";
    if earlier_fails {
        source = "import tower; fn id(T:type,x:T):T{return x;} fn bad(T:type):type{struct Recursive{value:Recursive;}return Recursive;} fn first():i32{var a=id(1);a++;var b=id(a);return unknownFirst;} fn later():i32{if sizeof(bad(i32))>0{return 1;}return 0;}";
    }
    units_check(frontend_units_source(batch, 1, "header_cycle.tower", source, strlen(source)), "Header cycle source");
    while !frontend_units_step(batch, true) {}
    var error = frontend_units_error(batch);
    units_check(frontend_units_failed(batch) == 1, "Header construction cycle fails");
    units_check(strstr(error, earlier_fails ? "unknownFirst": "Recursive by-value layout") is not null, "Header dependency cycles retain deterministic diagnostics");
}

enum BodyLoopFailure: u32 { WhileValue, ForInitializer, ForCondition, ForUpdate, ForInitialExpression, Count }

fn body_runs_surface_error(budget: usize, bedrock: u8*, foundation: u8*, root: u8*, mode: BodyLoopFailure): void {
    var batch = frontend_units_create(1, budget, 8, 88, 23, bedrock, foundation, root);
    units_check(batch is not null, "Loop header error batch");
    defer frontend_units_close(batch);
    var source: u8* = "import tower; fn id(T:type,x:T):T{return x;} fn first():i32 {while id(unknownLoop)>0 {return 1;} return 0;} fn later():i32{return unknownSecond;}";
    if mode == BodyLoopFailure.ForInitializer {
        source = "import tower; fn id(T:type,x:T):T{return x;} fn first():i32 {for(var i=id(unknownLoop); i<1; i++) {return 1;} return 0;} fn later():i32{return unknownSecond;}";
    }
    if mode == BodyLoopFailure.ForCondition {
        source = "import tower; fn bad(T:type):type{struct Recursive{value:Recursive;}return Recursive;} fn first():i32 {for(var i:i32=0; sizeof(bad(i32))>0; i++) {return 1;} return 0;} fn later():i32{return unknownSecond;}";
    }
    if mode == BodyLoopFailure.ForUpdate {
        source = "import tower; fn id(T:type,x:T):T{return x;} fn first():i32 {for(var i:i32=0; i<1; id(unknownLoop)) {return 1;} return 0;} fn later():i32{return unknownSecond;}";
    }
    if mode == BodyLoopFailure.ForInitialExpression {
        source = "import tower; fn id(T:type,x:T):T{return x;} fn first():i32 {for(id(unknownLoop); false;) {return 1;} return 0;} fn later():i32{return unknownSecond;}";
    }
    units_check(frontend_units_source(batch, 1, "loop_error.tower", source, strlen(source)), "Loop header error source");
    while !frontend_units_step(batch, true) {}
    var error = frontend_units_error(batch);
    units_check(frontend_units_failed(batch) == 1 && strstr(error, mode == BodyLoopFailure.ForCondition ? "Recursive by-value layout": "unknownLoop") is not null && strstr(error, "unknownSecond") is null, "Loop header failure preserves scopes, cleanup and error order");
}

fn body_runs_arm_error(budget: usize, bedrock: u8*, foundation: u8*, root: u8*, mode: u32): void {
    var batch = frontend_units_create(1, budget, 8, 89, 23, bedrock, foundation, root);
    units_check(batch is not null, "Match/defer/iteration diagnostic batch");
    defer frontend_units_close(batch);
    var source: u8* = "import tower; fn id(T:type,x:T):T{return x;} fn first():i32 {match id(unknownMatch) {0=>{return id(1);} _=>{return 0;}}} fn later():i32{return unknownSecond;}";
    if mode == 1 {
        source = "import tower; fn id(T:type,x:T):T{return x;} fn first():i32 {match id(0) {0=>{var a=id(1);return unknownMatch;} 0=>{return 1;} _=>{return 0;}}} fn later():i32{return unknownSecond;}";
    }
    if mode == 2 {
        source = "import tower; fn id(T:type,x:T):T{return x;} fn first():i32 {match id(0) {0=>{return id(1);} 0=>{return unknownMatch;} _=>{return 0;}}} fn later():i32{return unknownSecond;}";
    }
    if mode == 3 {
        source = "import tower; fn id(T:type,x:T):T{return x;} fn first():i32 {defer {var a=id(1);var b=id(unknownMatch);} return 0;} fn later():i32{return unknownSecond;}";
    }
    if mode == 4 {
        source = "import tower; import library.vector; fn id(T:type,x:T):T{return x;} fn first(values:vector(i32)*):i32 {foreach(var item in values) {var a=id(item);return unknownMatch;} return 0;} fn later():i32{return unknownSecond;}";
    }
    units_check(frontend_units_source(batch, 1, "arm_error.tower", source, strlen(source)), "Match/defer/iteration diagnostic source");
    while !frontend_units_step(batch, true) {}
    var error = frontend_units_error(batch);
    units_check(frontend_units_failed(batch) == 1 && strstr(error, mode == 2 ? "Duplicate match pattern" : "unknownMatch") is not null && strstr(error, "unknownSecond") is null, "Resumed arm and cleanup failures preserve source diagnostic order");
}

enum BodyDeclarationFailure: u32 { SelfReference, SharedSignature, SharedInitializer, HeaderSelfReference, SharedTypeInitializer, SharedTypeAlias, SharedNestedType, NestedFunctionSignature, IterationSignature, ModuleInitializer, ModuleStatement, ArrayExtent, ArrayCycle, ModuleArrayExtent, ArrayFields, ConstructorCycle }
var BodyDeclarationRevision: u64 = 90;
var BodyDeclarationProfile: u64 = 23;

fn body_runs_declaration_error(budget: usize, bedrock: u8*, foundation: u8*, root: u8*, mode: BodyDeclarationFailure): void {
    var batch = frontend_units_create(1, budget, 8, BodyDeclarationRevision, BodyDeclarationProfile, bedrock, foundation, root);
    units_check(batch != null, "Local declaration dependency batch");
    defer frontend_units_close(batch);
    var source: u8* = "import tower;var x:i32=42;fn id(T:type,x:T):T{return x;}fn first():i32{var x=id(x);return x;}fn later():i32{return unknownLater;}";
    var diagnostic_text: u8* = "initializer dependency cycle";
    if mode == BodyDeclarationFailure.HeaderSelfReference {
        source = "import tower;var x:i32=42;fn id(T:type,x:T):T{return x;}fn first():i32{for(var x=id(x);x<1;x++){return x;}return 0;}fn later():i32{return unknownLater;}";
    }
    if mode == BodyDeclarationFailure.SharedSignature {
        // Later reaches the shared failure first. Earlier resumes through its
        // own dependency and must recover that producer's original diagnostic.
        source = "import tower;fn id(T:type,x:T):T{return x;}fn bad(T:type,x:T):MissingReturn{return x;}fn first():i32{var a=id(1);var b=bad(a);return b;}fn later():i32{var b=bad(2);return b;}";
        diagnostic_text = "MissingReturn";
    }
    if mode == BodyDeclarationFailure.SharedInitializer {
        source = "import tower;fn bad(T:type,x:T):MissingReturn{return x;}fn first():i32{var a:i32=bad(1);return unknownFirst;}fn later():i32{var b=bad(2);return b;}";
        diagnostic_text = "MissingReturn";
    }
    if mode == BodyDeclarationFailure.SharedTypeInitializer {
        source = "import tower;fn broken(T:type):type{struct Item{value:MissingField;}return Item;}fn first():i32{var size:usize=sizeof(broken(i32));return unknownFirst;}fn later():i32{var item:broken(i32);return 0;}";
        diagnostic_text = "MissingField";
    }
    if mode == BodyDeclarationFailure.SharedTypeAlias {
        source = "import tower;fn broken(T:type):type{return MissingAlias;}fn first():i32{var size:usize=sizeof(broken(i32));return unknownFirst;}fn later():i32{var item:broken(i32);return 0;}";
        diagnostic_text = "MissingAlias";
    }
    if mode == BodyDeclarationFailure.SharedNestedType {
        source = "import tower;fn broken(T:type):type{struct Item{value:MissingField;}return Item;}fn wrapper(T:type):type{struct Outer{inner:broken(T);}return Outer;}fn first():i32{var size:usize=sizeof(wrapper(i32));return unknownFirst;}fn second():i32{var outer:wrapper(i32);return 0;}fn third():i32{var inner:broken(i32);return 0;}";
        diagnostic_text = "MissingField";
    }
    if mode == BodyDeclarationFailure.NestedFunctionSignature {
        source = "import tower;fn first():i32{var apply:function(i32,function(i32,void));return 0;}fn later():i32{return unknownLater;}";
        diagnostic_text = "A function parameter cannot have void type";
    }
    if mode == BodyDeclarationFailure.IterationSignature {
        // Two bodies share the failed begin signature. Its parameter failure
        // precedes the missing later protocol roles and a later ordinary error.
        source = "import tower;fn id(T:type,x:T):T{return x;}fn collection(T:type):type{struct Value{value:T;}return Value;}fn collection_iterate_begin(T:type,source:collection(T)*,state:MissingState*):void{}fn first():i32{var x=id(1);var values:collection(i32);foreach(var value in &values){}return 0;}fn second():i32{var values:collection(i32);foreach(var value in &values){}return 0;}fn later():i32{return unknownLater;}";
        diagnostic_text = "MissingState";
    }
    if mode == BodyDeclarationFailure.ModuleInitializer {
        source = "import tower;var first:i32=unknownFirst;var second:i32=unknownSecond;fn later():i32{return unknownLater;}";
        diagnostic_text = "unknownFirst";
    }
    if mode == BodyDeclarationFailure.ModuleStatement {
        source = "import tower;unknownStatement();var later:i32=unknownLater;";
        diagnostic_text = "unknownStatement";
    }
    if mode == BodyDeclarationFailure.ArrayExtent {
        source = "import tower;fn first():i32{var invalid:i32[0];return 0;}fn later():i32{return unknownLater;}";
        diagnostic_text = "Array length must be between";
    }
    if mode == BodyDeclarationFailure.ArrayCycle {
        source = "import tower;fn recursive(T:type):type{struct Record{values:Record[1];}return Record;}fn first():i32{var invalid:recursive(i32);return 0;}fn later():i32{return unknownLater;}";
        diagnostic_text = "Recursive by-value layout";
    }
    if mode == BodyDeclarationFailure.ModuleArrayExtent {
        source = "import tower;var first:i32[0];var later:MissingLater;";
        diagnostic_text = "Array length must be between";
    }
    if mode == BodyDeclarationFailure.ArrayFields {
        source = "import tower;struct Record{first:MissingArrayFirst[2];second:i32[0];}var value:Record;";
        diagnostic_text = "MissingArrayFirst";
    }
    if mode == BodyDeclarationFailure.ConstructorCycle {
        source = "import tower;fn first_type(T:type):type{return second_type(T);}fn second_type(T:type):type{return first_type(T);}fn first():i32{var invalid:first_type(i32);return 0;}fn later():i32{return unknownLater;}";
        diagnostic_text = "dependency cycle";
    }
    units_check(frontend_units_source(batch, 1, "local_dependency.tower", source, strlen(source)), "Local declaration dependency source");
    while !frontend_units_step(batch, true) {}
    var error = frontend_units_error(batch);
    if frontend_units_failed(batch) == 0 || strstr(error, diagnostic_text) == null { puts(error); }
    units_check(frontend_units_failed(batch) == 1 && strstr(error, diagnostic_text) != null
        && strstr(error, "unknownLater") == null, "Local binding and shared signature failure survive suspension");
}

// A short edit/build/run path uses the same fixture and assertions as the full
// matrix. It is intentionally separate from the release coverage below.
fn body_runs_smoke(root: u8*): void {
    body_runs_smoke_select(root, false);
}

// Keep type/dependency edits focused; release coverage still uses bodies.
fn body_runs_type_smoke(root: u8*): void {
    body_runs_smoke_select(root, true);
}

fn body_runs_smoke_select(root: u8*, types_only: bool): void {
    var bedrock: vector(u8) = default;
    var foundation: vector(u8) = default;
    var source: vector(u8) = default;
    var canonical: vector(u8) = default;
    defer vector_dispose(&canonical);
    defer vector_dispose(&source);
    defer vector_dispose(&foundation);
    defer vector_dispose(&bedrock);
    units_read(root, "/bedrock.tower", &bedrock);
    units_read(root, "/foundation.tower", &foundation);
    units_read(root, "/tests/body_continuation.tower", &source);
    body_runs_trial(source.data, 1, 8, bedrock.data, foundation.data, root, &canonical);
    body_runs_trial(source.data, 4, 8, bedrock.data, foundation.data, root, &canonical);
    units_check(vector_reserve(&canonical, canonical.length + 1), "Body Foundation text terminator");
    canonical.data[canonical.length] = 0;
    body_runs_trial(canonical.data, 4, 8, bedrock.data, foundation.data, root, &canonical);
    if types_only {
        for(var budget: usize = 1; budget <= 4; budget *= 4) {
            body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.ArrayExtent);
            body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.ArrayCycle);
            body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.ModuleArrayExtent);
            body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.ArrayFields);
            body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedTypeAlias);
            body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedNestedType);
            body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.ConstructorCycle);
        }
        puts("Type query smoke: serial/worker execution, canonical reparse and focused failures/cycles passed.");
        return;
    }
    body_runs_header_error(4, bedrock.data, foundation.data, root);
    body_runs_header_cycle(4, bedrock.data, foundation.data, root, false);
    body_runs_header_cycle(4, bedrock.data, foundation.data, root, true);
    body_runs_surface_error(4, bedrock.data, foundation.data, root, BodyLoopFailure.ForCondition);
    body_runs_surface_error(4, bedrock.data, foundation.data, root, BodyLoopFailure.ForUpdate);
    body_runs_surface_error(4, bedrock.data, foundation.data, root, BodyLoopFailure.ForInitialExpression);
    body_runs_arm_error(4, bedrock.data, foundation.data, root, 1);
    body_runs_arm_error(4, bedrock.data, foundation.data, root, 2);
    body_runs_declaration_error(1, bedrock.data, foundation.data, root, BodyDeclarationFailure.SelfReference);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.HeaderSelfReference);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedSignature);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.NestedFunctionSignature);
    body_runs_declaration_error(1, bedrock.data, foundation.data, root, BodyDeclarationFailure.IterationSignature);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.IterationSignature);
    body_runs_declaration_error(1, bedrock.data, foundation.data, root, BodyDeclarationFailure.ModuleInitializer);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.ModuleInitializer);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.ModuleStatement);
    body_runs_declaration_error(1, bedrock.data, foundation.data, root, BodyDeclarationFailure.ArrayExtent);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.ArrayExtent);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.ArrayCycle);
    body_runs_declaration_error(1, bedrock.data, foundation.data, root, BodyDeclarationFailure.ModuleArrayExtent);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.ModuleArrayExtent);
    body_runs_declaration_error(1, bedrock.data, foundation.data, root, BodyDeclarationFailure.ArrayFields);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.ArrayFields);
    body_runs_declaration_error(1, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedInitializer);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedInitializer);
    body_runs_declaration_error(1, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedTypeInitializer);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedTypeInitializer);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedTypeAlias);
    body_runs_declaration_error(1, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedNestedType);
    body_runs_declaration_error(4, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedNestedType);
    body_runs_cycle(4, bedrock.data, foundation.data, root, false);
    body_runs_cycle(4, bedrock.data, foundation.data, root, true);
    puts("Body smoke: serial/worker canonical output, execution and ordered diagnostics/cycles passed.");
}

fn body_runs_tests(root: u8*): void {
    var bedrock: vector(u8) = default;
    var foundation: vector(u8) = default;
    var source: vector(u8) = default;
    defer vector_dispose(&source);
    defer vector_dispose(&foundation);
    defer vector_dispose(&bedrock);
    units_read(root, "/bedrock.tower", &bedrock);
    units_read(root, "/foundation.tower", &foundation);
    units_read(root, "/tests/body_continuation.tower", &source);
    for(var width: u32 = 4; width <= 8; width += 4) {
        puts(width == 4 ? "Body continuation matrix: 32-bit target" : "Body continuation matrix: 64-bit target");
        var canonical: vector(u8) = default;
        defer vector_dispose(&canonical);
        for(var budget: usize = 1; budget <= 8; budget *= 2) {
            body_runs_trial(source.data, budget, width, bedrock.data, foundation.data, root, &canonical);
            puts("Body source execution/canonical trial passed.");
        }
        units_check(vector_reserve(&canonical, canonical.length + 1), "Body Foundation text terminator");
        canonical.data[canonical.length] = 0;
        body_runs_trial(canonical.data, 8, width, bedrock.data, foundation.data, root, &canonical);
        puts("Body canonical reparse passed.");
        var root_layout: vector(u8) = default;
        defer vector_dispose(&root_layout);
        // Foundation root operands can create an array after declaration
        // layouts, even when the only function needs no structural preparation.
        var root_source: u8* = "struct Item { value:i32; } var size:usize=sizeof(Item[2]); fn result():i32 { return 0; } print(result());";
        for(var budget: usize = 1; budget <= 8; budget *= 2) {
            body_runs_trial(root_source, budget, width, bedrock.data, foundation.data, root, &root_layout);
        }
    }
    puts("Body continuation matrix: diagnostic ordering and cycles");
    // These small error fixtures need serial versus concurrent admission. The
    // successful/canonical matrix above retains every 1/2/4/8-worker setting;
    // avoid rebuilding each diagnostic's module graph at all four widths too.
    for(var budget: usize = 1; budget <= 4; budget *= 4) {
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.SelfReference);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.HeaderSelfReference);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedSignature);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.NestedFunctionSignature);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.IterationSignature);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.ModuleInitializer);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.ModuleStatement);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.ArrayExtent);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.ArrayCycle);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.ModuleArrayExtent);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.ArrayFields);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.ConstructorCycle);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedInitializer);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedTypeInitializer);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedTypeAlias);
        body_runs_declaration_error(budget, bedrock.data, foundation.data, root, BodyDeclarationFailure.SharedNestedType);
        for(var mode: u32 = 0; mode < 5; mode++) {
            body_runs_arm_error(budget, bedrock.data, foundation.data, root, mode);
        }
        for(var mode: u32 = 0; mode < convert(u32, BodyLoopFailure.Count); mode++) {
            body_runs_surface_error(budget, bedrock.data, foundation.data, root, convert(BodyLoopFailure, mode));
        }
        body_runs_header_error(budget, bedrock.data, foundation.data, root);
        body_runs_header_cycle(budget, bedrock.data, foundation.data, root, false);
        body_runs_header_cycle(budget, bedrock.data, foundation.data, root, true);
        body_runs_control_error(budget, bedrock.data, foundation.data, root);
        body_runs_nested_error(budget, bedrock.data, foundation.data, root);
        body_runs_diagnostic(budget, bedrock.data, foundation.data, root, false);
        body_runs_diagnostic(budget, bedrock.data, foundation.data, root, true);
        body_runs_cycle(budget, bedrock.data, foundation.data, root, false);
        body_runs_cycle(budget, bedrock.data, foundation.data, root, true);
        puts("Body diagnostic worker-width group passed.");
    }
    puts("Resumable bodies: 1/2/4/8-worker canonical/execution and serial/parallel diagnostic order passed.");
}
