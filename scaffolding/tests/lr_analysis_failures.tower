import tower;
import .library.vector;
import .compiler.lr_types;
import utility_checks;
import lr_analysis_oracle_types;
import lr_control_types;
import lr_analysis_api;
import .library.work_budget;
import lr_components;

extern fn tower_test_buffer_count(): usize;
extern fn tower_test_buffer_fail_after(count: usize): void;
extern fn dprintf(fd: i32, format: u8*, value: usize, phase: u32, count: u32): i32;
extern fn compiler_world_create_workers(limit: usize): void*;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_bind_budget(world: void*, budget: WorkBudget*): bool;
extern fn compiler_world_dispose(world: void*): bool;
extern fn entity_create(store: void*): void*;
extern fn entity_release(node: void*): usize;
extern fn lr_analysis_compute_parallel_result(analysis: void*, anchor: void*): WorkBudgetError;
extern fn lr_states_lalr_parallel_result(states: void*, constructs: bool, anchor: void*): WorkBudgetError;

var LRSuffixTestBytes: usize = 1048576;

enum LRMergeNode: usize { Source, Destination, Count }
fn lr_range_insertion_order(): void {
    var baseline = tower_test_buffer_count();
    var reference: SymbolRange[7] = default;
    reference[0] = {first: 0, last: 0}; reference[1] = {first: 1, last: 3};
    reference[2] = {first: 1, last: 4}; reference[3] = {first: 2, last: 2};
    reference[4] = {first: 7, last: 9};
    reference[5] = {first: ~convert(u32, 0) - 1, last: ~convert(u32, 0)};
    reference[6] = {first: ~convert(u32, 0), last: ~convert(u32, 0)};
    var count = sizeof(decltype(reference)) / sizeof(SymbolRange);
    for(var order: usize = 0; order < 3; order++) {
        var graph = lr_propagation_create(1);
        utility_check(graph != null, "Range insertion owner");
        defer lr_propagation_destroy(graph);
        for(var i: usize = 0; i < count; i++) {
            var at = order == 0 ? i : (order == 1 ? count - i - 1 : (i % 2 == 0 ? i / 2 : count - i / 2 - 1));
            utility_check(lr_propagation_seed_result(graph, 0, reference[at].first, reference[at].last) == WorkBudgetError.None,
                "Ascending, descending and interleaved exact-range insertion");
        }
        var ranges = lr_propagation_data(graph, 0);
        tower_test_buffer_fail_after(0);
        for(var i = count; i != 0;) {
            i--;
            utility_check(lr_propagation_seed_result(graph, 0, reference[i].first, reference[i].last) == WorkBudgetError.None,
                "Duplicate exact ranges need no allocation");
        }
        tower_test_buffer_fail_after(oracle_none());
        utility_check(lr_propagation_count(graph, 0) == count && lr_propagation_data(graph, 0) == ranges,
            "Duplicate insertion preserves payload identity and extent");
        for(var i: usize = 0; i < count; i++) {
            utility_check(ranges[i].first == reference[i].first && ranges[i].last == reference[i].last,
                "Literal sorted reference preserves overlapping and extreme endpoints");
        }
    }
    utility_check(tower_test_buffer_count() == baseline, "Range insertion owners released");
}
fn lr_range_merge_failure(): void {
    var baseline = tower_test_buffer_count();
    {
        var source = convert(usize, LRMergeNode.Source);
        var destination = convert(usize, LRMergeNode.Destination);
        var graph = lr_propagation_create(convert(usize, LRMergeNode.Count));
        utility_check(graph != null, "Range merge graph owner");
        defer lr_propagation_destroy(graph);
        var seeds: SymbolRange[33] = default;
        var count = sizeof(decltype(seeds)) / sizeof(SymbolRange);
        for(var i: usize = 0; i < count; i++) {
            seeds[i] = {first: convert(u32, i * 2), last: convert(u32, i * 2 + 3)};
            utility_check(lr_propagation_seed(graph, source, seeds[i].first, seeds[i].last), "Range merge source seed");
        }
        utility_check(lr_propagation_edge(graph, source, destination), "Range merge dependency");
        tower_test_buffer_fail_after(0);
        var error = lr_propagation_solve_result(graph);
        tower_test_buffer_fail_after(oracle_none());
        utility_check(error == WorkBudgetError.Memory && lr_propagation_count(graph, destination) == 0
            && lr_propagation_count(graph, source) == count, "Denied bulk merge preserves exact Memory and original sets");
        // A failed solver has consumed its queue entry. Requeue through the
        // established edge API before retrying the unchanged source owner.
        utility_check(lr_propagation_edge(graph, source, destination) && lr_propagation_solve(graph), "Range merge retry");
        utility_check(lr_propagation_count(graph, destination) == count, "Range merge initial exact count");
        for(var i: usize = 0; i < count; i++) {
            utility_check(lr_propagation_seed(graph, destination, seeds[i].first, seeds[i].last + 1), "Equal starts retain distinct ends");
        }
        utility_check(lr_propagation_edge(graph, source, destination), "Subset merge requeue");
        tower_test_buffer_fail_after(0);
        error = lr_propagation_solve_result(graph);
        tower_test_buffer_fail_after(oracle_none());
        utility_check(error == WorkBudgetError.None, "Subset merge needs no allocation");
        utility_check(lr_propagation_edge(graph, destination, source) && lr_propagation_edge(graph, destination, destination)
            && lr_propagation_solve(graph), "Interleaved merge and aliased self cycle");
        var variants: usize = 2;
        for(var node: usize = 0; node < convert(usize, LRMergeNode.Count); node++) {
            utility_check(lr_propagation_count(graph, node) == count * variants, "Exact overlapping range identities survive union");
            var ranges = lr_propagation_data(graph, node);
            for(var i: usize = 0; i < count; i++) {
                for(var variant: usize = 0; variant < variants; variant++) {
                    var range = &ranges[i * variants + variant];
                    utility_check(range.first == seeds[i].first && range.last == seeds[i].last + convert(u32, variant),
                        "Sorted merge keeps equal-start and overlapping intervals distinct");
                }
            }
        }
    }
    utility_check(tower_test_buffer_count() == baseline, "Range merge denied/retried owners release every buffer");
}

fn lr_suffix_budget_failure(): void {
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    utility_check(work_budget_init(&budget, 1, LRSuffixTestBytes, 1), "Suffix finite budget");
    var world = compiler_world_create_workers(1);
    utility_check(world != null && compiler_world_bind_budget(world, &budget), "Suffix world budget binding");
    var root = entity_create(compiler_world_store(world));
    utility_check(root != null, "Suffix budget anchor");
    var rules: LRProduction[3] = default;
    var symbols: LRSymbol[3] = default;
    rules[0].count = 2;
    rules[1] = {owner: 1, begin: 2, count: 1, precedence: 0, associativity: 0};
    rules[2] = {owner: 1, begin: 2, count: 0, precedence: 0, associativity: 0};
    symbols[0].nonterminal = 1; symbols[1].nonterminal = 1;
    symbols[2] = {nonterminal: oracle_none(), first: 10, last: 20};
    var analysis = lr_analysis_create(&rules[0], sizeof(decltype(rules)) / sizeof(LRProduction),
        &symbols[0], sizeof(decltype(symbols)) / sizeof(LRSymbol), rules[1].owner + 1);
    utility_check(analysis != null, "Suffix budget analysis");
    var before: WorkBudgetSnapshot = default;
    var after: WorkBudgetSnapshot = default;
    utility_check(work_budget_snapshot(&budget, &before) && before.used_bytes < before.bytes, "Suffix budget baseline");
    var held: WorkReservation = default;
    utility_check(work_budget_reserve(&budget, 0, 0, before.bytes - before.used_bytes, &held), "Suffix exhausted byte allowance");
    utility_check(lr_analysis_compute_parallel_result(analysis, root) == WorkBudgetError.Capacity,
        "Suffix publication reports Capacity after FIRST converges");
    utility_check(work_budget_release(&budget, &held) && work_budget_snapshot(&budget, &after)
        && after.used_bytes == before.used_bytes && after.live == before.live, "Denied suffix index publishes no retained buffers");
    utility_check(lr_analysis_compute_parallel_result(analysis, root) == WorkBudgetError.None
        && work_budget_snapshot(&budget, &after) && after.used_bytes > before.used_bytes,
        "Same FIRST analysis retries and charges immutable suffix storage");
    var retained = after.used_bytes;
    var index_bytes = retained - before.used_bytes;
    utility_check(dprintf(2, "suffix index charged_bytes=%zu\n", retained - before.used_bytes, 0, 0) >= 0,
        "Suffix charged byte report");
    utility_check(lr_analysis_compute_parallel_result(analysis, root) == WorkBudgetError.None
        && work_budget_snapshot(&budget, &after) && after.used_bytes == retained,
        "Repeated FIRST completion reuses the published index");
    var states = lr_states_create(analysis);
    utility_check(states != null && work_budget_snapshot(&budget, &before), "Item lookahead budget baseline");
    utility_check(work_budget_reserve(&budget, 0, 0, before.bytes - before.used_bytes, &held), "Item lookahead exhausted allowance");
    utility_check(lr_states_lalr_parallel_result(states, false, root) == WorkBudgetError.Capacity,
        "Item reachability storage preserves explicit Capacity");
    utility_check(work_budget_release(&budget, &held) && work_budget_snapshot(&budget, &after)
        && after.used_bytes == before.used_bytes && after.live == before.live,
        "Failed item graph releases all partial ownership");
    utility_check(lr_states_lalr_parallel_result(states, false, root) == WorkBudgetError.None
        && work_budget_snapshot(&budget, &after) && after.used_bytes == before.used_bytes && after.live == before.live,
        "Same item graph retries without retaining scratch grants");
    utility_check(dprintf(2, "item graph ledger_live=%zu peak=%u\n", after.used_bytes, convert(u32, after.peak_bytes), 0) >= 0,
        "Item graph budget report");
    lr_states_destroy(states);
    lr_analysis_destroy(analysis);
    utility_check(work_budget_snapshot(&budget, &after) && after.used_bytes == before.used_bytes - index_bytes,
        "Analysis destruction retires the complete suffix owner");
    entity_release(root);
    utility_check(compiler_world_dispose(world) && budget.used_bytes == 0 && budget.live == 0
        && work_budget_dispose(&budget) && tower_test_buffer_count() == buffers, "Suffix budget fixture cleanup");
}

fn lr_failure_rule(rule: LRProduction*, owner: usize, begin: usize, count: usize): void {
    fill(rule, 0, sizeof(LRProduction)); rule.owner = owner; rule.begin = begin; rule.count = count;
}
fn lr_failure_symbol(symbol: LRSymbol*, name: usize, first: u32, last: u32): void {
    symbol.nonterminal = name; symbol.first = first; symbol.last = last;
}
fn lr_analysis_allocation_trial(): bool {
    var rules: LRProduction[5]; var symbols: LRSymbol[6];
    lr_failure_rule(&rules[0], 0, 0, 1); lr_failure_rule(&rules[1], 1, 1, 3);
    lr_failure_rule(&rules[2], 1, 4, 0); lr_failure_rule(&rules[3], 2, 4, 1); lr_failure_rule(&rules[4], 2, 5, 1);
    lr_failure_symbol(&symbols[0], 1, 0, 0); lr_failure_symbol(&symbols[1], 2, 0, 0);
    lr_failure_symbol(&symbols[2], 1, 0, 0); lr_failure_symbol(&symbols[3], oracle_none(), 100, 200);
    lr_failure_symbol(&symbols[4], oracle_none(), 2097152, 2097156); lr_failure_symbol(&symbols[5], oracle_none(), 42, 42);
    var error = WorkBudgetError.None;
    var analysis = lr_analysis_create_result(&rules[0], sizeof(decltype(rules)) / sizeof(LRProduction),
        &symbols[0], sizeof(decltype(symbols)) / sizeof(LRSymbol), rules[4].owner + 1, &error);
    utility_check(error == (analysis == null ? WorkBudgetError.Memory : WorkBudgetError.None), "FIRST constructor reports the actual allocation result");
    if analysis is null { return false; }
    var input = lr_items_create(); var output = lr_items_create();
    defer { lr_items_destroy(input); lr_items_destroy(output); lr_analysis_destroy(analysis); }
    var seed: LRItem; seed.rule = 0; seed.position = 0; seed.first = LRTokenEnd; seed.last = LRTokenEnd;
    error = lr_analysis_compute_result(analysis);
    utility_check(error == WorkBudgetError.None || error == WorkBudgetError.Memory, "Valid FIRST analysis fails only at denied storage");
    if error == WorkBudgetError.Memory {
        tower_test_buffer_fail_after(oracle_none());
        utility_check(lr_analysis_compute_result(analysis) == WorkBudgetError.None,
            "FIRST or suffix allocation denial permits retry on the same analysis");
        return false;
    }
    var ok = input is not null && output is not null && error == WorkBudgetError.None && lr_items_insert(input, &seed)
        && lr_items_close(analysis, input, true) && lr_items_goto(analysis, input, &symbols[0], output, true);
    {
        var propagation = lr_propagation_create_result(rules[4].owner + 1, &error); defer lr_propagation_destroy(propagation);
        utility_check(error == (propagation == null ? WorkBudgetError.Memory : WorkBudgetError.None), "Lookahead graph reports the actual allocation result");
        if propagation != null && ok {
            error = lr_propagation_seed_result(propagation, 0, 1, 3);
            if error == WorkBudgetError.None { error = lr_propagation_edge_result(propagation, 0, 1); }
            if error == WorkBudgetError.None { error = lr_propagation_edge_result(propagation, 1, 2); }
            if error == WorkBudgetError.None { error = lr_propagation_edge_result(propagation, 2, 0); }
            if error == WorkBudgetError.None { error = lr_propagation_solve_result(propagation); }
            utility_check(error == WorkBudgetError.None || error == WorkBudgetError.Memory, "Valid lookahead graph preserves Memory");
        }
        ok &&= propagation != null && error == WorkBudgetError.None;
    }
    if ok {
        var states = lr_states_create_result(analysis, &error); defer lr_states_destroy(states);
        utility_check(error == (states == null ? WorkBudgetError.Memory : WorkBudgetError.None), "LR states report the actual allocation result");
        ok = states != null;
        if ok {
            error = lr_states_lalr_result(states, false);
            utility_check(error == WorkBudgetError.None || error == WorkBudgetError.Memory, "Valid LALR phases preserve the actual allocation result");
            ok = error == WorkBudgetError.None;
        }
        if ok {
            var runtime = lr_runtime_create(states); defer lr_runtime_destroy(runtime);
            ok = runtime is not null;
            if ok { var conflict: LRConflict; utility_check(!lr_runtime_conflict(runtime, &conflict), "LR allocation fixture has no conflict"); }
        }
    }
    return ok;
}

fn lr_analysis_invalid_inputs(): void {
    var baseline = tower_test_buffer_count();
    var rule: LRProduction = default;
    var error = WorkBudgetError.None;
    utility_check(lr_analysis_create_result(null, 1, null, 0, 1, &error) == null && error == WorkBudgetError.Invalid,
        "FIRST rejects a missing counted rule array");
    utility_check(lr_analysis_create_result(&rule, 1, null, 1, 1, &error) == null && error == WorkBudgetError.Invalid,
        "FIRST rejects a missing counted symbol array");
    utility_check(lr_analysis_create_result(&rule, 1, null, 0, 0, &error) == null && error == WorkBudgetError.Invalid,
        "FIRST rejects an owner outside the supplied nonterminal count");
    rule.begin = 1;
    utility_check(lr_analysis_create_result(&rule, 1, null, 0, 1, &error) == null && error == WorkBudgetError.Invalid,
        "FIRST rejects a production begin outside its symbols");
    rule.begin = 0; rule.count = 1;
    utility_check(lr_analysis_create_result(&rule, 1, null, 0, 1, &error) == null && error == WorkBudgetError.Invalid,
        "FIRST rejects a production count outside its symbols");
    rule.count = 0;
    utility_check(lr_analysis_create_result(&rule, 1, null, 0, ~convert(usize, 0), &error) == null && error == WorkBudgetError.Invalid,
        "FIRST rejects a nonterminal byte count overflow before allocation");
    utility_check(lr_analysis_create_result(&rule, 1, null, 0, 1, null) == null
        && lr_analysis_compute_result(null) == WorkBudgetError.Invalid, "FIRST requires result storage and a live analysis");
    var value = lr_analysis_create_result(&rule, 1, null, 0, 1, &error);
    utility_check(value != null && error == WorkBudgetError.None && lr_analysis_compute_result(value) == WorkBudgetError.None
        && lr_analysis_nullable(value, rule.owner), "FIRST valid empty production remains nullable after invalid calls");
    lr_analysis_destroy(value);
    var terminal: LRSymbol = { nonterminal: oracle_none(), first: 65, last: 65 };
    rule.count = 1;
    value = lr_analysis_create_result(&rule, 1, &terminal, 1, 1, &error);
    utility_check(value != null && error == WorkBudgetError.None, "FIRST retry fixture allocation");
    tower_test_buffer_fail_after(0);
    error = lr_analysis_compute_result(value);
    tower_test_buffer_fail_after(oracle_none());
    utility_check(error == WorkBudgetError.Memory, "FIRST range allocation reports Memory");
    utility_check(lr_analysis_compute_result(value) == WorkBudgetError.None
        && lr_analysis_first_count(value, rule.owner) == 1
        && lr_analysis_first_data(value, rule.owner)[0].first == terminal.first,
        "FIRST retries the same analysis after allocation denial");
    lr_analysis_destroy(value);
    utility_check(lr_states_create_result(null, &error) == null && error == WorkBudgetError.Invalid
        && lr_states_create_result(null, null) == null, "LR states require an analysis and result storage");
    value = lr_analysis_create_result(null, 0, null, 0, 1, &error);
    utility_check(value != null && lr_analysis_compute_result(value) == WorkBudgetError.None
        && lr_states_create_result(value, &error) == null && error == WorkBudgetError.Invalid,
        "LR states reject an absent start production");
    lr_analysis_destroy(value);
    var tail: LRSymbol[2] = default;
    tail[0] = terminal;
    tail[1].nonterminal = 1;
    rule.count = sizeof(decltype(tail)) / sizeof(LRSymbol);
    value = lr_analysis_create_result(&rule, 1, &tail[0], rule.count, tail[1].nonterminal, &error);
    utility_check(value != null && lr_analysis_compute_result(value) == WorkBudgetError.None,
        "FIRST does not visit the invalid reference following a terminal");
    utility_check(lr_states_create_result(value, &error) == null && error == WorkBudgetError.Invalid,
        "LR closure reports Invalid when it actually reaches that reference");
    lr_analysis_destroy(value);
    var suffix_tail: LRSymbol[3] = default;
    suffix_tail[0] = terminal;
    suffix_tail[1].nonterminal = 0;
    suffix_tail[2].nonterminal = 1;
    rule.count = sizeof(decltype(suffix_tail)) / sizeof(LRSymbol);
    value = lr_analysis_create(&rule, 1, &suffix_tail[0], rule.count, suffix_tail[2].nonterminal);
    utility_check(value != null && lr_analysis_compute_result(value) == WorkBudgetError.None,
        "Suffix index defers an unreachable invalid suffix after a terminal");
    var demanded = lr_items_create();
    var seed: LRItem = {rule: 0, position: 1, first: LRTokenPropagation, last: LRTokenPropagation};
    utility_check(demanded != null && lr_items_insert(demanded, &seed)
        && !lr_items_close(value, demanded, true), "Demanded invalid suffix fails instead of returning a cached empty set");
    lr_items_destroy(demanded);
    lr_analysis_destroy(value);
    rule.count = 1;
    value = lr_analysis_create_result(&rule, 1, &terminal, 1, 1, &error);
    utility_check(value != null && lr_analysis_compute_result(value) == WorkBudgetError.None, "LR state retry analysis");
    tower_test_buffer_fail_after(0);
    var states = lr_states_create_result(value, &error);
    tower_test_buffer_fail_after(oracle_none());
    utility_check(states == null && error == WorkBudgetError.Memory, "LR state descriptor denial retains Memory");
    states = lr_states_create_result(value, &error);
    utility_check(states != null && error == WorkBudgetError.None && lr_states_count(states) == rule.count + 1,
        "LR state construction retries after a denied descriptor");
    utility_check(lr_states_lalr_result(null, false) == WorkBudgetError.Invalid, "LALR rejects an absent state graph");
    tower_test_buffer_fail_after(0);
    error = lr_states_lalr_result(states, false);
    tower_test_buffer_fail_after(oracle_none());
    utility_check(error == WorkBudgetError.Memory && lr_states_lalr_result(states, false) == WorkBudgetError.None,
        "LALR cache denial preserves Memory and retries on the same state graph");
    lr_states_destroy(states);
    lr_analysis_destroy(value);
    utility_check(lr_propagation_create_result(~convert(usize, 0), &error) == null && error == WorkBudgetError.Invalid,
        "Lookahead graph validates node byte count overflow");
    var propagation = lr_propagation_create_result(1, &error);
    utility_check(propagation != null && error == WorkBudgetError.None, "Lookahead result fixture");
    utility_check(lr_propagation_seed_result(propagation, 1, 65, 65) == WorkBudgetError.Invalid
        && lr_propagation_edge_result(propagation, 0, 1) == WorkBudgetError.Invalid
        && lr_propagation_edge_result(propagation, 1, 0) == WorkBudgetError.Invalid,
        "Lookahead rejects out-of-bounds seed and dependency endpoints");
    utility_check(lr_propagation_seed_result(propagation, 0, 65, 65) == WorkBudgetError.None
        && lr_propagation_edge_result(propagation, 0, 0) == WorkBudgetError.None
        && lr_propagation_solve_result(propagation) == WorkBudgetError.None
        && lr_propagation_count(propagation, 0) == 1, "Lookahead invalid calls leave valid retry and self-cycle intact");
    lr_propagation_destroy(propagation);
    utility_check(tower_test_buffer_count() == baseline, "FIRST invalid inputs retain no buffers");
}
fn lr_control_allocation_trial(specialize: bool): bool {
    var symbols: LRSymbol[17]; var rules: LRProduction[2];
    lr_failure_symbol(&symbols[0], 1, 0, 0);
    for (var index: usize = 0; index < 16; ++index) {
        var id = 32 + convert(u32, index); lr_failure_symbol(&symbols[index + 1], oracle_none(), id, id);
    }
    lr_failure_rule(&rules[0], 0, 0, 1); lr_failure_rule(&rules[1], 1, 1, 16);
    var analysis = lr_analysis_create(&rules[0], 2, &symbols[0], 17, 2);
    var states: void* = null; var runtime: void* = null; var parser: void* = null;
    defer { lr_parser_destroy(parser); lr_runtime_destroy(runtime); lr_states_destroy(states); lr_analysis_destroy(analysis); }
    var specialized = false; var ok = analysis is not null && lr_analysis_compute(analysis);
    if ok { states = lr_states_create(analysis); ok = states is not null && lr_states_lalr(states, false); }
    if ok { runtime = lr_runtime_create(states); ok = runtime is not null; }
    if ok {
        if specialize { lr_runtime_specialize(runtime, states); specialized = lr_runtime_sequence(runtime) != oracle_none(); }
        parser = lr_parser_create(runtime, false, specialize); ok = parser is not null;
    }
    if ok {
        for (var position: usize = 0; position < 16; ++position) {
            var step: LRStep; var kind = lr_parser_step(parser, true, 32 + convert(u32, position), false, position, 1, &step);
            utility_check(kind == LRShift || kind == LRSequenceShift, "LR allocation parser shift kind");
            ok = lr_parser_commit(parser, &step, position, position); if !ok { break; }
        }
    }
    if ok {
        var budget: LRProbeBudget = default; budget.remaining = 8192; budget.complete = true;
        var original = lr_probe_create(parser, &budget);
        var clone: void* = null; if original is not null { clone = lr_probe_clone(original); }
        ok = clone is not null;
        if ok { var before: usize; ok = lr_probe_step(clone, 4294967294, &before) != 0 && budget.complete; }
        lr_probe_destroy(clone); lr_probe_destroy(original);
    }
    if ok {
        var step: LRStep; var kind = lr_parser_step(parser, true, 4294967294, false, 16, 0, &step);
        utility_check(kind == LRReduce || kind == LRSequenceReduce, "LR allocation parser reduction kind");
        ok = lr_parser_commit(parser, &step, 16, 16);
    }
    return ok && (!specialize || specialized);
}
fn lr_kernel_resize_trial(): void {
    var symbols: LRSymbol[512];
    for (var index: usize = 0; index < 512; ++index) {
        var id = 2097152 + convert(u32, index); lr_failure_symbol(&symbols[index], oracle_none(), id, id);
    }
    var rule: LRProduction; lr_failure_rule(&rule, 0, 0, 512);
    var analysis = lr_analysis_create(&rule, 1, &symbols[0], 512, 1);
    utility_check(analysis is not null && lr_analysis_compute(analysis), "LR kernel resize analysis");
    defer lr_analysis_destroy(analysis);
    var states = lr_states_create(analysis); defer lr_states_destroy(states);
    utility_check(states is not null && lr_states_count(states) == 513 && lr_states_lalr(states, false), "LR kernel resize state count");
    for (var index: usize = 0; index < 512; ++index) {
        utility_check(lr_states_edge_count(states, index) == 1 && lr_states_edges(states, index)[0].state == index + 1,
            "LR kernel resize transition identity");
    }
    utility_check(lr_states_action_count(states, 512) == 1, "LR kernel resize final action count");
    var final_action = &lr_states_actions(states, 512)[0];
    utility_check(final_action.rule == 0 && final_action.first == 4294967294 && final_action.last == 4294967294,
        "LR kernel resize final EOF reduction");
}
fn lr_shift_index_failures(): void {
    var rules: LRProduction[9] = default;
    var symbols: LRSymbol[9] = default;
    var count = sizeof(decltype(rules)) / sizeof(LRProduction);
    rules[0].count = 1; symbols[0].nonterminal = 1;
    for(var i: usize = 1; i < count; i++) {
        rules[i] = {owner: 1, begin: i, count: 1, ..default};
        symbols[i] = {nonterminal: oracle_none(), first: convert(u32, i), last: convert(u32, i)};
    }
    var baseline = tower_test_buffer_count(); var success = false;
    for(var attempt: usize = 0; attempt < 1024 && !success; attempt++) {
        {
            var analysis = lr_analysis_create(&rules[0], count, &symbols[0], count, 2);
            utility_check(analysis != null && lr_analysis_compute(analysis), "Shift failure frozen analysis");
            defer lr_analysis_destroy(analysis);
            tower_test_buffer_fail_after(attempt);
            var error = WorkBudgetError.None;
            var states = lr_states_create_result(analysis, &error);
            tower_test_buffer_fail_after(oracle_none());
            defer lr_states_destroy(states);
            success = states != null;
            utility_check(error == (success ? WorkBudgetError.None : WorkBudgetError.Memory),
                "Every denied state/index allocation preserves exact Memory");
            if success { utility_check(lr_states_count(states) == count + 1, "Wide shifts retain all distinct terminal states"); }
            for(var i: usize = 1; i < count; i++) {
                utility_check(rules[i].begin == i && rules[i].count == 1 && symbols[i].first == convert(u32, i)
                    && symbols[i].last == convert(u32, i), "Failed shift construction leaves borrowed source intact");
            }
        }
        utility_check(tower_test_buffer_count() == baseline, "Denied shift indexes and partial states release every owner");
    }
    utility_check(success, "Shift allocation sweep reaches successful construction");
}

fn lr_analysis_storage_failures(): void {
    lr_shift_index_failures();
    lr_component_owner_tests();
    lr_range_insertion_order();
    lr_range_merge_failure();
    lr_analysis_invalid_inputs();
    lr_suffix_budget_failure();
    var baseline = tower_test_buffer_count(); var success = false;
    for (var attempt: usize = 0; attempt < 1024 && !success; ++attempt) {
        tower_test_buffer_fail_after(attempt); success = lr_analysis_allocation_trial(); tower_test_buffer_fail_after(oracle_none());
        utility_check(tower_test_buffer_count() == baseline, "LR analysis allocation failure releases every buffer");
    }
    utility_check(success, "LR analysis allocation sweep reaches success");
}
fn lr_analysis_failure_tests(): void {
    lr_analysis_storage_failures();
    var baseline = tower_test_buffer_count(); var success = false;
    for (var mode: u32 = 0; mode < 2; ++mode) {
        success = false;
        for (var attempt: usize = 0; attempt < 4096 && !success; ++attempt) {
            tower_test_buffer_fail_after(attempt); success = lr_control_allocation_trial(mode != 0); tower_test_buffer_fail_after(oracle_none());
            utility_check(tower_test_buffer_count() == baseline, "LR control/probe allocation failure releases every buffer");
        }
        utility_check(success, "LR control/probe allocation sweep reaches success in both modes");
    }
    lr_kernel_resize_trial(); utility_check(tower_test_buffer_count() == baseline, "LR kernel resize releases every buffer");
    puts("LR failures: analysis/control/probe allocation sweeps and 512-symbol kernel resize passed.");
}
