import tower;
import lr_analysis_failures_test;
import utility_checks;
import lr_components;

fn lr_analysis_storage_failures(): void {
    lr_shift_index_failures();
    lr_component_owner_tests();
    lr_range_insertion_order();
    lr_range_merge_failure();
    lr_analysis_invalid_inputs();
    lr_suffix_budget_failure();
    lr_analysis_allocation_sweep();
}

fn lr_analysis_failure_tests(): void {
    lr_analysis_storage_failures();
    lr_control_allocation_sweep();
    lr_kernel_resize_case();
    puts("LR failures: analysis/control/probe allocation sweeps and 512-symbol kernel resize passed.");
}
