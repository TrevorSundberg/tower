extern fn fixture_add(a: i32, b: i32): i32;
extern fn fixture_sum(values: i32*, count: usize): i32;
extern fn fixture_write(values: i32*, count: usize): void;
extern fn fixture_identity(value: i32*): i32*;
extern fn fixture_wide(value: u64): u64;
extern fn fixture_byte(value: u8): u8;
extern fn fixture_bool(value: bool): bool;
extern fn fixture_length(text: u8*): usize;
struct PointerBox { tag: u8; data: i32*; count: usize; }
extern fn fixture_box(box: PointerBox*): usize;
extern fn fixture_callback(value: i32): i32;
export fn tower_twice(value: i32): i32 { var answer: i32 = value * 2; return answer; }
var values: i32* = alloc(i32, 3);
fixture_write(values, 3);
var result: i32 = fixture_sum(values, 3);
print(result);
var same: i32* = fixture_identity(values);
var equal: bool = same == values;
print(equal);
var box: PointerBox;
box.tag = 2;
box.data = values;
box.count = 3;
var ref: PointerBox* = &box;
var size: usize = fixture_box(ref);
var expected_size: usize = sizeof(PointerBox);
equal = size == expected_size;
print(equal);
print(values[1]);
result = fixture_callback(21);
print(result);
var wide: u64 = fixture_wide(18446744073709551614);
print(wide);
var byte: u8 = fixture_byte(255);
print(byte);
equal = fixture_bool(false);
print(equal);
var length: usize = fixture_length("Tower");
print(length);
result = fixture_add(20, 22);
print(result);
free(values);
