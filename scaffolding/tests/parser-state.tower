import tower;
import '../compiler/entity-require';
import 'syntax-emission';
import '../compiler/syntax-emission';
import 'frontend-bedrock';
import '../compiler/parser-state';
import '../compiler/format';
import '../compiler/frontend-table';
import '../compiler/grammar-types';
import '../compiler/lr-analysis';
import '../compiler/lr-parser';
import '../compiler/lr-tree';
import '../compiler/parser-stream';
import '../library/vector';

extern fn parser_stream_destroy(stream: ParserStream*): void;

fn parser_test_streams(): usize {
    var before = tower_test_buffer_count();
    var bytes: u8[7];
    bytes[0] = 97;
    bytes[1] = 195;
    bytes[2] = 169;
    bytes[3] = 240;
    bytes[4] = 159;
    bytes[5] = 143;
    bytes[6] = 176;
    var begin = &bytes[0];
    var end = begin + 7;
    var stream = parser_stream_utf8_create(begin, end);
    fill(begin, 120, 7);
    var id: u32 = 0;
    var start: usize = 0;
    var length: usize = 0;
    parser_stream_read(stream, &id, &start, &length);
    var ok = id == 97;
    if ok {
        ok = start == 0;
    }
    if ok {
        ok = length == 1;
    }
    parser_stream_read(stream, &id, &start, &length);
    if ok {
        ok = id == 233;
    }
    if ok {
        ok = start == 1;
    }
    if ok {
        ok = length == 2;
    }
    parser_stream_read(stream, &id, &start, &length);
    if ok {
        ok = id == 127984;
    }
    if ok {
        ok = start == 3;
    }
    if ok {
        ok = length == 4;
    }
    parser_stream_read(stream, &id, &start, &length);
    if ok {
        ok = id == ParserStreamEnd();
    }
    if ok {
        ok = start == convert(usize, ParserStreamEnd());
    }
    if ok {
        ok = length == 0;
    }
    parser_stream_read(stream, &id, &start, &length);
    if ok {
        ok = id == ParserStreamEnd();
    }
    var data = parser_stream_get_userdata(stream);
    if ok {
        ok = parser_stream_from_userdata(data) == stream;
    }
    parser_stream_destroy(stream);
    if ok {
        ok = parser_stream_from_userdata(null) == null;
    }
    if ok {
        ok = parser_stream_get_userdata(null) == null;
    }
    var maximum = lr_none();
    if ok {
        ok = parser_stream_create(maximum, null, null) == null;
    }
    // Preserve the legacy recoverable source-copy allocation boundary.
    tower_test_buffer_fail_after(0);
    stream = parser_stream_utf8_null_terminated_create("source");
    tower_test_buffer_fail_after(lr_none());
    parser_stream_read(stream, &id, &start, &length);
    if ok {
        ok = id == ParserStreamEnd();
    }
    if ok {
        ok = format_name_is(&stream.error, "Unable to allocate UTF-8 stream source");
    }
    parser_stream_destroy(stream);
    // Invalid/truncated input remains stable EOF, matching the existing decoder.
    bytes[0] = 240;
    end = begin + 1;
    stream = parser_stream_utf8_create(begin, end);
    parser_stream_read(stream, &id, &start, &length);
    if ok {
        ok = id == ParserStreamEnd();
    }
    if ok {
        ok = length == 0;
    }
    parser_stream_destroy(stream);
    if ok {
        ok = tower_test_buffer_count() == before;
    }
    if ok {
        return 0;
    }
    return 800;
}

fn parser_test_request(table: FrontendTable*, kinds: FrontendKinds*): usize {
    var baseline = tower_test_buffer_count();
    var first = parser_stream_utf8_null_terminated_create("ab");
    var second = parser_stream_utf8_null_terminated_create("x");
    var a = parser_request_create(table.runtime, null, first, false, false);
    var b = parser_request_create(table.runtime, null, second, false, false);
    parser_recognizer_capture_completion(a);
    var ok = a != b;
    var step: LRStep;
    // Distinct requests share only immutable runtime tables. A failed input must
    // not consume or change the successful request's stream/control/forest.
    var action = parser_request_next(a, &step);
    if ok {
        ok = action == 1;
    }
    if ok {
        ok = step.id == 97;
    }
    if ok {
        ok = step.start == 0;
    }
    var status = lr_tree_shift(a.control, a.forest, table.grammar, kinds.`match`, &step, &a.read_node_or_null, "a");
    if ok {
        ok = status == 1;
    }
    a.has_lookahead = false;
    action = parser_request_next(b, &step);
    if ok {
        ok = action == 4;
    }
    if ok {
        ok = b.read_id == 120;
    }
    parser_recognizer_destroy(b);
    parser_stream_destroy(second);
    action = parser_request_next(a, &step);
    if ok {
        ok = action == 1;
    }
    if ok {
        ok = step.id == 98;
    }
    if ok {
        ok = step.start == 1;
    }
    status = lr_tree_shift(a.control, a.forest, table.grammar, kinds.`match`, &step, &a.read_node_or_null, "b");
    if ok {
        ok = status == 1;
    }
    a.has_lookahead = false;
    action = parser_request_next(a, &step);
    if ok {
        ok = action == 2;
    }
    if ok {
        ok = a.read_start == 2;
    }
    var root: void* = null;
    var reduced = lr_tree_reduce(a.control, a.forest, table.grammar, &step, &root);
    if ok {
        ok = reduced;
    }
    action = parser_request_next(a, &step);
    if ok {
        ok = action == 3;
    }
    root = lr_tree_accept(a.control, a.forest);
    var span = lr_tree_match(root, kinds.`match`);
    if ok {
        ok = span.start == 0;
    }
    if ok {
        ok = span.length == 2;
    }
    var work: ParserRequestWork;
    parser_request_work(a, &work);
    if ok {
        ok = work.reads == 3;
    }
    if ok {
        ok = work.shifts == 2;
    }
    var completion = parser_recognizer_take_completion(a);
    if ok {
        ok = completion != null;
    }
    if ok {
        ok = parser_recognizer_take_completion(a) == null;
    }
    parser_recognizer_destroy(a);
    parser_stream_destroy(first);
    // Accepted entities and transferred completion state outlive the request.
    if ok {
        ok = span.length == 2;
    }
    if ok {
        ok = lr_completion_runtime(completion) == table.runtime;
    }
    lr_completion_destroy(completion);
    entity_release(root);
    if ok {
        ok = tower_test_buffer_count() == baseline;
    }
    if ok {
        return 0;
    }
    return 801;
}

fn parser_test_buffered(table: FrontendTable*, kinds: FrontendKinds*): usize {
    var baseline = tower_test_buffer_count();
    var stream = parser_stream_utf8_null_terminated_create("");
    var request = parser_request_create(table.runtime, null, stream, true, false);
    var node = entity_create_related(kinds.`match`);
    var span = lr_tree_create_match(node, kinds.`match`);
    span.id = 97;
    span.start = 17;
    span.length = 3;
    var error: vector(u8);
    vector_init(u8, &error);
    parser_state_assign(&error, "injected stream error");
    var borrowed = node;
    parser_stream_return(stream, &node, 97, 17, 3, &error);
    var ok = node == null;
    if ok {
        ok = error.data == null;
    }
    parser_recognizer_read_id(request);
    if ok {
        ok = request.read_node_or_null == borrowed;
    }
    if ok {
        ok = request.read_start == 17;
    }
    if ok {
        ok = format_name_is(&request.lookahead_error, "injected stream error");
    }
    parser_return_lookahead(request);
    if ok {
        ok = request.read_node_or_null == null;
    }
    if ok {
        ok = request.has_lookahead == false;
    }
    parser_recognizer_destroy(request);
    // Destroying unread lookahead releases the node and copied diagnostic.
    parser_stream_destroy(stream);
    if ok {
        ok = tower_test_buffer_count() == baseline;
    }
    if ok {
        return 0;
    }
    return 802;
}

fn parser_state_tests(kinds: FrontendKinds*): usize {
    var result = parser_test_streams();
    var failed = result != 0;
    if failed {
        return result;
    }
    var baseline = tower_test_buffer_count();
    var root = frontend_test_root(kinds);
    var table: FrontendTable;
    var ok = frontend_table_init(&table, root, kinds);
    if ok {
        ok = frontend_table_finish(&table, false, false) == 0;
    }
    if ok {} else {
        abort();
    }
    result = parser_test_request(&table, kinds);
    failed = result != 0;
    if failed {} else {
        result = parser_test_buffered(&table, kinds);
    }
    var stream = parser_stream_utf8_null_terminated_create("ab");
    var buffers = tower_test_buffer_count();
    // Every recoverable request-allocation failure must leave the borrowed
    // table/stream alive and release all partial control/forest allocations.
    var budget: usize = 0;
    loop {
        tower_test_buffer_fail_after(budget);
        var request = parser_request_create(table.runtime, null, stream, false, false);
        tower_test_buffer_fail_after(lr_none());
        var succeeded = request != null;
        parser_recognizer_destroy(request);
        var leaked = tower_test_buffer_count() != buffers;
        if leaked {
            result = 803;
            break;
        }
        if succeeded {
            break;
        }
        budget = budget + 1;
        var limit = budget == 32;
        if limit {
            result = 804;
            break;
        }
    }
    parser_stream_destroy(stream);
    frontend_table_dispose(&table);
    entity_release(root);
    var leaked = tower_test_buffer_count() != baseline;
    if leaked {
        result = 805;
    }
    return result;
}
