import tower;
import backend_import_overflow_test;
import backend_import_storage;
import storage_api;
import utility_checks;
import .library.work_budget;

extern fn backend_import_fixture_overflow(root: void*, target: u8*, width: u32, mode: u8*): void*;

fn overflow_fixture_trial(resource: u8*, width: u32, integer: u32, mode: u8*, prior: bool): bool {
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default; var world: void* = null;
    utility_check(work_budget_init(&budget, 1, BackendAdmissionBytes, 1)
        && compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None, "Overflow import world");
    var store = compiler_world_store(world);
    var root = entity_create(store); var output = entity_create(store);
    var backend = backend_import_fixture_overflow(root, width == 4 ? "wasm32-unknown-unknown" : "wasm64-unknown-unknown", integer, mode);
    utility_check(backend != null, "Overflow LLVM verifier accepts fixture");
    if prior { backend_import_fixture_failure(backend, BackendAdmissionOffset); }
    var nodes = entity_store_count(store); var components = entity_store_component_count(store);
    var rejected = prior || integer > 64 || strcmp(mode, "aggregate") == 0 || strcmp(mode, "vector") == 0;
    var accepted = backend_import_foundation(backend, output);
    var text: FormatResult = {checked: true, budget: &budget, ..default};
    if rejected {
        var wanted = prior ? "Earlier backend diagnostic" : integer > 64 || strcmp(mode, "vector") == 0
            ? "Unsigned multiplication overflow requires a scalar integer up to 64 bits"
            : "Unsigned multiplication overflow requires scalar extractvalue consumers";
        if accepted || strcmp(backend_error(backend), wanted) != 0 { puts(backend_error(backend)); }
        utility_check(!accepted && strcmp(backend_error(backend), wanted) == 0
            && backend_resource_error(backend) == WorkBudgetError.None
            && backend_error_offset(backend) == (prior ? BackendAdmissionOffset : 0), "Overflow exact rejection and first diagnostic");
        utility_check(entity_store_count(store) == nodes && entity_store_component_count(store) == components
            && entity_child_count(output) == 0 && sem_get(output) == null, "Overflow failure publishes no partial stage");
    } else {
        if !accepted { puts(backend_error(backend)); }
        utility_check(accepted && backend_resource_error(backend) == WorkBudgetError.None, "Overflow import succeeds");
        format_entity(&text, output, null, null, null);
        utility_check(!text.failed, "Overflow checked canonical Foundation");
    }
    backend_close(backend); entity_release(output); entity_release(root);
    utility_check(compiler_world_dispose(world), "Overflow LLVM world closes before recheck");
    var ok = rejected || overflow_fixture_execute(resource, &text, width, integer, mode);
    format_dispose(&text);
    utility_check(budget.live == 0 && budget.used_bytes == 0 && budget.used_lanes == 0
        && work_budget_dispose(&budget) && tower_test_buffer_count() == buffers, "Overflow all owners and buffers drained");
    return ok;
}

fn backend_import_overflow_tests(resource: u8*, selection: u8*): i32 {
    var widths: u32[5]; widths[0] = 1; widths[1] = 8; widths[2] = 16; widths[3] = 32; widths[4] = 64;
    var modes: u8*[3]; modes[0] = "both"; modes[1] = "product"; modes[2] = "flag";
    var ok = true;
    for(var width: u32 = 4; width <= 8; width *= 2) {
        for(var at: usize = 0; at < sizeof(decltype(widths)) / sizeof(u32); at++) {
            var integer = widths[at];
            if strcmp(selection, "i1") == 0 && integer != 1 { continue; }
            if strcmp(selection, "wide") == 0 && integer == 1 { continue; }
            for(var mode: usize = 0; mode < sizeof(decltype(modes)) / sizeof(u8*); mode++) {
                if !overflow_fixture_trial(resource, width, integer, modes[mode], false) { ok = false; }
            }
        }
        if strcmp(selection, "i1") != 0 {
            overflow_fixture_trial(resource, width, 8, "aggregate", false);
            overflow_fixture_trial(resource, width, 8, "vector", false);
            overflow_fixture_trial(resource, width, 128, "aggregate", false);
            overflow_fixture_trial(resource, width, 8, "aggregate", true);
        }
    }
    puts(ok ? "Overflow verified LLVM / canonical recheck / Graph+Fast and zero owners passed." : "Overflow reconstruction failed; all owners drained.");
    return ok ? 0 : 1;
}
