import tower;
import .library.work_graph;

// Compile this fixture with LLVM for the allocation/throughput scale trial.
// The functional scheduler fixture also exercises interpreted target widths.
fn work_scale(count: usize): i32 {
    var g: WorkGraph;
    work_init(&g, 1, 8);
    var subjects = alloc(u8, count);
    var missing = subjects == null;
    if missing {
        return 1;
    }
    var root: usize = 0;
    var previous: usize = 0;
    var i: usize = 0;
    for(; i < count; i++) {
        var id = work_request(&g, bits(void*, &subjects[i]), 1, 0);
        missing = id == 0;
        if missing {
            return 2;
        }
        if i == 0 {
            root = id;
        } else {
            if !work_depend(&g, id, previous) {
                return 3;
            }
            if !work_depend(&g, id, root) {
                return 4;
            }
            if !work_depend(&g, id, root) {
                return 5;
            }
        }
        if !work_seal(&g, id) {
            return 6;
        }
        previous = id;
    }
    if !work_demand(&g, previous) {
        return 7;
    }
    var ticket: WorkTicket;
    var completed: usize = 0;
    for(; work_take(&g, &ticket); completed++) {
        if !work_finish(&g, &ticket, true) {
            return 8;
        }
    }
    var correct = completed == count;
    work_dispose(&g);
    free(subjects);
    if correct {
        return 0;
    }
    return 9;
}

print(work_scale(64000));
