import rejection_observation;
import backend.text;

test() {
    var error = rejection_message("decltype_body_comptime.tower");
    defer free(error);
    assert(stage_error_offset() == 53, "Unexpected source byte offset");
    assert(backend_equal(error, "Unknown local 'missing_body_value'\nInstantiated by invalid(1) at line 4, column 16."), error);
}
