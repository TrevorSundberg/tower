import tower;
import semantic_pool_budget_checks_test;

fn semantic_pool_budget_tests(): i32 {
    var failures: u32 = 0;
    for(var width: u32 = 4; width <= 8; width += 4) {
        for(var workers: usize = 1; workers <= 4; workers += 3) {
            failures += pool_budget_cases(width, workers);
        }
    }
    if failures == 0 { puts("Semantic pools retain exact physical budget ownership and terminal failures."); }
    return failures == 0 ? 0 : 1;
}
