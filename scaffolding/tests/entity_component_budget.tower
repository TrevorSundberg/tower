import tower;
import .library.entities;
import .library.entity_types;
import .library.entity_stage;
import .library.work_budget;
import .library.work_budget_types;
import .library.work_pool;
import .host.memory;
import .host.work_linux;
import .host.work_dispatch;

extern fn pthread_self(): usize;
extern fn backtrace(frames: void**, capacity: i32): i32;
extern fn backtrace_symbols_fd(frames: void**, count: i32, descriptor: i32): void;
extern fn puts(text: u8*): i32;
extern fn fflush(stream: void*): i32;
extern fn abort(): void;

enum PageDisposition: u32 { Publish, Cancel, Deny }
var PageBudgetBytes: usize = 1048576;
var PageLargeBytes: usize = 32768;
var PageStressRounds: usize = 8;
struct PagePayload { target: Entity*; ordinal: usize; }
struct PageState { coordinator: usize; finalized: usize; }
struct PageJob {
    stage: EntityStage*;
    parent: Entity*;
    type: Entity*;
    large_type: Entity*;
    target: Entity*;
    first: EntityComponent*;
    last: EntityComponent*;
    large: EntityComponent*;
    entered: void*;
    release: void*;
    thread: usize;
    rows: usize;
    holds: usize;
    error: WorkBudgetError;
    cancelled: bool;
}

fn page_check(ok: bool): void {
    if !ok {
        puts("Component page budget ownership regression");
        fflush(null);
        var frames: void*[32];
        var count = backtrace(&frames[0], convert(i32, sizeof(decltype(frames)) / sizeof(void*)));
        backtrace_symbols_fd(&frames[0], count, 2);
        abort();
    }
}

export fn tower_entity_finalize(lifecycle: usize, component: EntityComponent*, data: u8*): void {
    var state = bits(PageState*, entity_context(component.owner));
    page_check(lifecycle == 1 && state != null && pthread_self() == state.coordinator
        && entity_component_from_data(data) == component);
    var value = bits(PagePayload*, data);
    if value.target != null { entity_release(value.target); }
    state.finalized++;
}

fn page_serial(): void {
    var budget: WorkBudget = default;
    page_check(work_budget_init(&budget, 1, PageBudgetBytes, 1));
    var store: EntityStore* = null;
    page_check(entity_store_create_result(&budget, &store) == WorkBudgetError.None);
    var store_bytes = budget.used_bytes;
    var root = entity_create(store);
    var other = entity_create(store);
    var type = entity_create(store);
    var large_type = entity_create(store);
    page_check(root != null && other != null && type != null && large_type != null
        && entity_register(type, sizeof(u64), 64, 0)
        && entity_register(large_type, PageLargeBytes, 4096, 0));
    var error = WorkBudgetError.None;
    page_check(entity_component_add_result(null, type, &error) == null && error == WorkBudgetError.Invalid);
    page_check(entity_component_add_result(root, null, &error) == null && error == WorkBudgetError.Invalid);
    page_check(entity_component_add_result(root, type, null) == null && root.component_count == 0);
    var view = entity_view_open(root);
    page_check(view != null && entity_component_add_result(root, type, &error) == null
        && error == WorkBudgetError.Busy && root.component_count == 0);
    entity_view_close(view);
    var owner_bytes = budget.used_bytes;
    store.resource_error = WorkBudgetError.Stale;
    var block: WorkReservation = default;
    page_check(work_budget_reserve(&budget, 0, 0, budget.bytes - budget.used_bytes - 1, &block));
    page_check(entity_component_add_result(root, type, &error) == null && error == WorkBudgetError.Capacity
        && root.component_count == 0 && type.instance_count == 0 && store.storage.first == null);
    page_check(work_budget_release(&budget, &block) && budget.used_bytes == owner_bytes);
    var first = entity_component_add_result(root, type, &error);
    page_check(first != null && error == WorkBudgetError.None && first.page != null
        && bits(usize, first.data) % 64 == 0 && entity_component_from_data(first.data) == first);
    *bits(u64*, first.data) = 12345;
    var page_bytes = compiler_buffer_allocation_size(first.page.allocation.capacity);
    var generation = first.page.allocation.reservation.generation;
    // The complete owner census lives in entity_accounting. This fixture checks
    // exact payload grants independently of the newly charged nodes/indexes.
    page_check(first.page.allocation.reservation.bytes == page_bytes
        && budget.used_bytes >= store_bytes + page_bytes
        && work_budget_validate_result(&budget, &first.page.allocation.reservation) == WorkBudgetError.None);
    var second = entity_component_add_result(other, type, &error);
    page_check(second != null && second.page == first.page && error == WorkBudgetError.None
        && first.page.allocation.reservation.generation == generation
        && budget.used_bytes >= store_bytes + page_bytes && *bits(u64*, first.data) == 12345);
    view = entity_view_open(root);
    page_check(view != null && entity_component_add_result(root, type, &error) == first
        && error == WorkBudgetError.None);
    entity_view_close(view);
    page_check(work_budget_reserve(&budget, 0, 0, budget.bytes - budget.used_bytes - 1, &block));
    page_check(entity_component_add_result(root, large_type, &error) == null
        && error == WorkBudgetError.Capacity && root.component_count == 1);
    page_check(work_budget_release(&budget, &block));
    var large = entity_component_add_result(root, large_type, &error);
    page_check(large != null && large.page == null && error == WorkBudgetError.None
        && bits(usize, large.data) % 4096 == 0 && entity_component_from_data(large.data) == large);
    fill(large.data, 73, PageLargeBytes);
    var large_bytes = compiler_buffer_allocation_size(bits(EntityComponentAllocation*, large).allocation.capacity);
    page_check(bits(EntityComponentAllocation*, large).allocation.reservation.bytes == large_bytes
        && budget.used_bytes >= store_bytes + page_bytes + large_bytes);
    page_check(entity_component_remove(root, type) && type.instance_count == 1);
    page_check(entity_component_remove(other, type) && store.storage.owned == null);
    page_check(large.data[PageLargeBytes - 1] == 73 && entity_component_remove(root, large_type)
        && store.storage.owned == null && store.resource_error == WorkBudgetError.Stale);
    entity_release(root); entity_release(other); entity_release(type); entity_release(large_type);
    page_check(store.entity_count == 0 && store.component_count == 0 && entity_store_dispose(store));
    page_check(budget.used_bytes == 0 && budget.live == 0 && work_budget_dispose(&budget));
}

fn page_job_component(job: PageJob*, node: Entity*, type: Entity*, ordinal: usize): EntityComponent* {
    var component = entity_component_add_result(node, type, &job.error);
    if component == null { return null; }
    var value = bits(PagePayload*, component.data);
    *value = default;
    value.ordinal = ordinal;
    page_check(entity_stage_references(job.stage, &job.target, 1));
    value.target = job.target;
    job.holds++;
    return component;
}

export fn work_kernel_execute(payload: void*): void {
    var job = bits(PageJob*, payload);
    job.thread = pthread_self();
    var first_node = entity_stage_create(job.stage, job.parent);
    page_check(first_node != null);
    job.first = page_job_component(job, first_node, job.type, 0);
    page_check(job.first != null && job.error == WorkBudgetError.None);
    job.last = job.first;
    job.rows = 1;
    // Every worker owns a real private page before admission pressure/cancel.
    work_signal_post(job.entered);
    work_signal_wait(job.release);
    if job.cancelled { return; }
    var wanted = job.first.page.capacity + 1;
    for(var i: usize = 1; i < wanted; i++) {
        var node = entity_stage_create_result(job.stage, job.parent, &job.error);
        if node == null { return; }
        var component = page_job_component(job, node, job.type, i);
        if component == null { return; }
        job.last = component;
        job.rows++;
    }
    job.large = page_job_component(job, first_node, job.large_type, wanted);
    page_check(job.large != null && job.large.page == null);
    job.large.data[PageLargeBytes - 1] = 91;
}

fn page_parallel(lanes: usize, disposition: PageDisposition): void {
    var gate = work_signal_open();
    var entered = work_signal_open();
    var release = work_signal_open();
    page_check(gate != null && entered != null && release != null);
    defer work_signal_close(gate);
    defer work_signal_close(entered);
    defer work_signal_close(release);
    work_signal_post(gate);
    var budget: WorkBudget = default;
    page_check(work_budget_init(&budget, lanes + 1, PageBudgetBytes, 1)
        && work_budget_synchronize(&budget, gate, work_signal_wait, work_signal_post));
    var outer: WorkReservation = default;
    var workers: WorkReservation = default;
    page_check(work_budget_reserve(&budget, 1, 1, 0, &outer)
        && work_budget_reserve(&budget, lanes, lanes, 0, &workers));
    var store: EntityStore* = null;
    var state: PageState = { coordinator: pthread_self(), finalized: 0 };
    page_check(entity_store_create_result(&budget, &store) == WorkBudgetError.None
        && entity_store_set_context(store, bits(void*, &state)));
    var store_bytes = compiler_buffer_allocation_size(sizeof(EntityStore));
    var root = entity_create(store);
    var type = entity_create(store);
    var large_type = entity_create(store);
    var target = entity_create(store);
    page_check(root != null && type != null && large_type != null && target != null
        && entity_register_stage_result(type, sizeof(PagePayload), 64, 1, 4) == WorkBudgetError.None
        && entity_register(large_type, PageLargeBytes, 4096, 1));
    store.resource_error = WorkBudgetError.Stale;
    var pool: WorkPool = default;
    page_check(work_pool_open_budget(&pool, lanes, &budget) && pool.threaded && pool.count == lanes);
    var jobs: PageJob[4] = default;
    page_check(lanes <= sizeof(decltype(jobs)) / sizeof(PageJob));
    for(var i: usize = 0; i < lanes; i++) {
        var job = &jobs[i];
        job.parent = entity_create(store);
        page_check(job.parent != null && entity_attach(job.parent, root, null));
        entity_release(job.parent);
        job.stage = entity_stage_open(root);
        page_check(job.stage != null && entity_stage_lease(job.stage, job.parent));
        job.type = type; job.large_type = large_type; job.target = target;
        job.entered = entered; job.release = release;
    }
    var view = entity_view_open(root);
    page_check(view != null && entity_release(target) == 0);
    for(var i: usize = 0; i < lanes; i++) { page_check(work_pool_submit(&pool, bits(void*, &jobs[i]))); }
    for(var i: usize = 0; i < lanes; i++) { work_signal_wait(entered); }
    page_check(work_pool_receive(&pool, false) == null && type.instance_count == 0);
    var snapshot: WorkBudgetSnapshot;
    page_check(work_budget_snapshot(&budget, &snapshot) && snapshot.used_lanes == lanes + 1);
    var block: WorkReservation = default;
    if disposition == PageDisposition.Deny {
        page_check(work_budget_reserve(&budget, 0, 0, snapshot.bytes - snapshot.used_bytes - 1, &block));
    }
    for(var i: usize = 0; i < lanes; i++) {
        page_check(jobs[i].thread != pthread_self() && jobs[i].first.page != null);
        for(var j: usize = 0; j < i; j++) {
            page_check(jobs[i].thread != jobs[j].thread && jobs[i].first.page != jobs[j].first.page);
        }
        jobs[i].cancelled = disposition == PageDisposition.Cancel;
    }
    // A shared semaphore may wake any worker. Publish every cancellation flag
    // before the first post, so no active worker observes a later write.
    for(var i: usize = 0; i < lanes; i++) { work_signal_post(release); }
    while pool.running != 0 { work_pool_receive(&pool, true); }
    work_pool_close(&pool);
    if block.active { page_check(work_budget_release(&budget, &block)); }
    page_check(work_budget_release(&budget, &workers) && work_budget_release(&budget, &outer));
    var retained = store_bytes;
    var holds: usize = 0;
    for(var i: usize = 0; i < lanes; i++) {
        var job = &jobs[i];
        page_check(job.error == (disposition == PageDisposition.Deny ? WorkBudgetError.Capacity : WorkBudgetError.None));
        var wanted = disposition == PageDisposition.Cancel ? 1 : job.first.page.capacity + 1;
        if disposition == PageDisposition.Deny {
            // Any newly physical node/index/queue/page owner can be the first
            // denial. Already charged slots may still be reused without growth.
            page_check(job.rows != 0 && job.rows < wanted);
            wanted = job.rows;
        }
        if job.rows != wanted || bits(PagePayload*, job.first.data).ordinal != 0 {
            print(lanes); print(convert(u32, disposition)); print(i);
            print(job.rows); print(wanted); print(bits(PagePayload*, job.first.data).ordinal);
        }
        page_check(job.rows == wanted && bits(PagePayload*, job.first.data).ordinal == 0);
        retained += compiler_buffer_allocation_size(job.first.page.allocation.capacity);
        if job.last.page != job.first.page { retained += compiler_buffer_allocation_size(job.last.page.allocation.capacity); }
        if job.large != null {
            page_check(job.large.data[PageLargeBytes - 1] == 91);
            retained += compiler_buffer_allocation_size(bits(EntityComponentAllocation*, job.large).allocation.capacity);
        }
        holds += job.holds;
        entity_stage_hold(job.stage);
    }
    page_check(work_budget_snapshot(&budget, &snapshot) && snapshot.used_bytes >= retained
        && snapshot.used_lanes == 0 && snapshot.peak_bytes <= snapshot.bytes);
    entity_view_close(view);
    for(var i: usize = 0; i < lanes; i++) {
        var job = &jobs[i];
        if disposition == PageDisposition.Publish {
            var address = job.first.data;
            page_check(entity_stage_publish(job.stage) && job.first.data == address
                && job.first.page.pool == null && job.last.page.pool == &store.storage);
        } else { entity_stage_discard(job.stage); }
        job.stage = null;
    }
    page_check(work_budget_snapshot(&budget, &snapshot)
        && snapshot.used_bytes >= store_bytes && snapshot.peak_bytes <= snapshot.bytes
        && (disposition == PageDisposition.Publish || store.storage.owned == null)
        && store.resource_error == WorkBudgetError.Stale);
    entity_release(root); entity_release(type); entity_release(large_type);
    page_check(state.finalized == holds && store.entity_count == 0 && store.component_count == 0
        && store.storage.first == null && entity_store_dispose(store));
    page_check(work_budget_snapshot(&budget, &snapshot) && snapshot.live == 0 && snapshot.used_bytes == 0
        && work_budget_dispose(&budget));
}

export fn main(argc: i32, argv: u8**): i32 {
    page_serial();
    var lane_counts: usize[2]; lane_counts[0] = 2; lane_counts[1] = 4;
    for(var round: usize = 0; round < PageStressRounds; round++) {
        for(var index: usize = 0; index < sizeof(decltype(lane_counts)) / sizeof(usize); index++) {
            for(var mode = convert(u32, PageDisposition.Publish); mode <= convert(u32, PageDisposition.Deny); mode++) {
                page_parallel(lane_counts[index], convert(PageDisposition, mode));
            }
        }
    }
    print(0);
    return 0;
}
