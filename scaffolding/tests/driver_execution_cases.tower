import tower;
import driver_differentials;

// Shared cases from the retired CLI Python drivers. Numeric values are fixture
// data. The native and package paths exercise the same source where applicable.
fn driver_execution_cases(context: DriverDifferentials*): void {
    driver_execution_case(context, "print", "print(42);", false, false, false);
    driver_execution_case(context, "sum", "fn sum(n: u32): u32 { var a: u32 = 0; var i: u32 = 0; loop { var done = i == n; if done { break; } a = a + i; i = i + 1; } return a; } print(sum(100));", false, false, false);
    driver_execution_case(context, "swap", "fn swap(n: u32): u32 { var a: u32 = 1; var b: u32 = 2; loop { var stop = n == 0; if stop { break; } var t = a; a = b; b = t; n = n - 1; } return a; } print(swap(9)); print(swap(10));", false, false, false);
    driver_execution_case(context, "factorial", "fn factorial(n: i32): i32 { var stop = n <= 1; if stop { return 1; } var p = n - 1; p = factorial(p); p = p * n; return p; } print(factorial(8));", true, false, false);
    driver_execution_case(context, "sequencing", "var n: i32 = 0; fn next(): i32 { n = n + 1; return n; } fn add(a: i32, b: i32): i32 { var r = a + b; return r; } print(add(next(), add(next(), next()))); print(n);", true, false, false);
    driver_execution_case(context, "loops", "var n: i32 = 0; loop { n = n + 1; var small = n < 3; if small { continue; } loop { print(n); break; } var stop = n == 5; if stop { break; } }", true, false, false);
    driver_execution_case(context, "copy", "var p = alloc(u8, 8); fill(p, 93, 8); p = realloc(u8, p, 128); var q = alloc(u8, 128); copy(q, p, 128); print(q[0]); print(q[7]); free(q); free(p);", true, false, false);
    driver_execution_case(context, "layout", "struct S { x: u8; y: i64; z: void*; } var s: S; s.y = -3; var p = &s.y; print(*p); print(sizeof(S)); print(alignof(S)); print(sizeof(usize));", true, false, false);
    driver_execution_case(context, "pointer", "var a: i32[4]; a[2] = 42; var p = &a[1]; p = p + 1; print(*p);", true, false, false);
    driver_execution_case(context, "wrapping", "var a: i32 = 2147483647; a = a + 1; print(a); var b: u64 = 18446744073709551615; b = b + 1; print(b);", true, false, false);
    driver_execution_case(context, "signed", "var a: i64 = -9223372036854775808; print(a); var b: u64 = 18446744073709551615; print(b); var q: i32 = -7; q = q / 3; print(q);", true, false, false);
    driver_execution_case(context, "selection", "fn f(x: bool): u32 { var n: u32 = 2; if x { n = 4; } return n; } print(f(true)); print(f(false));", false, false, false);
    driver_execution_case(context, "string", "var p = \"Hello\"; print(p[0]); print(p[4]); print(p[5]);", false, false, false);
    driver_execution_case(context, "division_zero", "var a: u32 = 7;\nvar b: u32 = 0;\nvar q = a / b; print(q);", false, true, true);
    driver_execution_case(context, "division_overflow", "var a: i32 = -2147483648; var b: i32 = -1; var q = a / b; print(q);", false, true, true);
    driver_execution_case(context, "conversion_overflow", "var a: u64 = 256; var b = convert(u8, a); print(b);", false, true, true);
    driver_execution_case(context, "u64_i64_max", "var a: u64 = 9223372036854775807; var b = convert(i64, a); print(b);", false, false, false);
    driver_execution_case(context, "u64_i64_overflow", "var a: u64 = 9223372036854775808; var b = convert(i64, a); print(b);", false, true, true);
    driver_execution_case(context, "i64_u64_negative", "var a: i64 = -1; var b = convert(u64, a); print(b);", false, true, true);
    driver_execution_case(context, "i64_u64_max", "var a: i64 = 9223372036854775807; var b = convert(u64, a); print(b);", false, false, false);
    driver_execution_case(context, "i64_i32_low", "var a: i64 = -2147483649; var b = convert(i32, a); print(b);", false, true, true);
    driver_execution_case(context, "i64_i32_min", "var a: i64 = -2147483648; var b = convert(i32, a); print(b);", false, false, false);
    driver_execution_case(context, "i64_i32_max", "var a: i64 = 2147483647; var b = convert(i32, a); print(b);", false, false, false);
    driver_execution_case(context, "i64_i32_high", "var a: i64 = 2147483648; var b = convert(i32, a); print(b);", false, true, true);
    driver_execution_case(context, "u64_u8_max", "var a: u64 = 255; var b = convert(u8, a); print(b);", false, false, false);
    driver_execution_case(context, "u64_u8_high", "var a: u64 = 256; var b = convert(u8, a); print(b);", false, true, true);
    driver_execution_case(context, "i32_u32_negative", "var a: i32 = -1; var b = convert(u32, a); print(b);", false, true, true);
    driver_execution_case(context, "i32_u32_max", "var a: i32 = 2147483647; var b = convert(u32, a); print(b);", false, false, false);
    driver_execution_case(context, "u32_i32_max", "var a: u32 = 2147483647; var b = convert(i32, a); print(b);", false, false, false);
    driver_execution_case(context, "u32_i32_high", "var a: u32 = 2147483648; var b = convert(i32, a); print(b);", false, true, true);
    driver_execution_case(context, "u64_usize_max", "var a: u64 = 4294967295; var b = convert(usize, a); print(b);", false, false, false);
    driver_execution_case(context, "u64_usize_high", "var a: u64 = 4294967296; var b = convert(usize, a); print(b);", false, true, false);
    driver_execution_case(context, "i64_bool_min", "var a: i64 = -9223372036854775808; var b = convert(bool, a); print(b);", false, false, false);
    driver_execution_case(context, "i64_bool_zero", "var a: i64 = 0; var b = convert(bool, a); print(b);", false, false, false);
}
