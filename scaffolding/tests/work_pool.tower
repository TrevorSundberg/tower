import tower;
import work_order_test;
import work_pool_fixture;
import work_pool_fixture_test;

extern fn strcmp(left: u8*, right: u8*): i32;

export fn main(argc: i32, argv: u8**): i32 {
    // Wasm invokes main without arguments. Native profiling can retain exactly
    // the original sixteen-round workload independently of the new failures.
    var normal_only = argc == 2 && strcmp(argv[1], "--normal") == 0;
    if argc > 1 && !normal_only { return PoolTestInvalidArguments; }
    work_order_tests();
    // CTest records one-lane hosts as skipped, not as concurrency evidence.
    var lanes = pool_test_lanes();
    if lanes < 2 { return 77; }
    var drained: usize = 0;
    var status = pool_test_run(lanes, 0, &drained);
    if status != 0 || normal_only { return status; }
    for (var trial: usize = 0; trial < 2; trial++) {
        var admitted = trial == 0 ? convert(usize, 1) : lanes;
        status = pool_test_drain_trial(lanes, admitted);
        if status != 0 { return status; }
    }
    return 0;
}
