import tower;
import library.vector;

fn identity(T: type, value: T): T {
    return value;
}

fn box(T: type): type {
    struct Box {
        value: T;
    }
    return Box;
}

var effects: i32 = 0;

fn split(input: i32): i32 {
    var seen: i32 = 0;
    defer {
        seen += comptime(1);
        effects += seen;
    }
    var record: box(i32);
    record.value = identity(input);
    var next: decltype(record.value) = record.value + 1;
    {
        var record = next + 1;
        next = record;
    }
    seen = next;
    if comptime(true) {
        return next;
    }
}

fn ordinary(input: i32): i32 {
    return input + 1;
}

fn labeled(input: i32): i32 {
    var result = identity(input);
    label(entry);
    result += 1;
    jump(exit);
    label(exit);
    return result;
}

fn early(input: i32): i32 {
    defer {
        effects += 10;
    }
    if input < 0 {
        return 7;
    }
    var value = identity(input);
    for(var i: i32 = 0; i < 4; i++) {
        if i == 1 {
            continue;
        }
        if i == 3 {
            break;
        }
        value += i;
    }
    return value;
}

fn arrays(): i32 {
    var values: i32[2];
    values[0] = 3;
    values[1] = 5;
    var sum = values[0] + values[1];
    defer {
        effects += sum;
    }
    return sum;
}

var failures: i32 = 0;
if split(3) != 5 || effects != 6 {
    failures++;
}
if ordinary(7) != 8 || labeled(11) != 12 {
    failures++;
}
if early(-1) != 7 || early(4) != 6 || effects != 26 {
    failures++;
}
if arrays() != 8 || effects != 34 {
    failures++;
}

fn alternating(input: i32): i32 {
    var prior = input + 1;
    defer {
        effects += identity(prior);
    }
    var first = identity(prior);
    prior += 2;
    var second = identity(first + prior);
    prior += 3;
    var storage: i32[2];
    storage[0] = second;
    storage[1] = prior;
    return storage[0] + storage[1];
}

fn all_structural(): i32 {
    return identity(13);
}

fn tail_structural(input: i32): void {
    var first = input;
    defer {
        effects += first;
    }
    first++;
    var second = identity(first);
    effects += second;
    var late: box(i32);
}

if alternating(4) != 22 || effects != 44 {
    failures++;
}
if all_structural() != 13 {
    failures++;
}
tail_structural(2);
if effects != 50 {
    failures++;
}

fn nested_runs(input: i32): i32 {
    var total = input;
    defer {
        effects += 1;
    }
    {
        var local = total + 1;
        defer {
            effects += local;
        }
        var first = identity(local);
        total += first;
        {
            var local = identity(first + 2);
            defer {
                effects += local;
            }
            var second = identity(local + 3);
            total += second;
            local++;
        }
        total += identity(local);
    }
    return total;
}

fn nested_exit(input: i32): i32 {
    defer {
        effects += 100;
    }
    {
        var local = identity(input);
        defer {
            effects += local;
        }
        {
            var other = identity(local + 1);
            if input > 0 {
                return other;
            }
        }
    }
    return 0;
}

fn nested_stack(): i32 {
    var total: i32 = 0;
    {
        {
            {
                {
                    {
                        {
                            {
                                {
                                    {
                                        {
                                            {
                                                {
                                                    var values: i32[2];
                                                    values[0] = identity(3);
                                                    values[1] = identity(4);
                                                    total += values[0] + values[1];
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return total;
}

if nested_runs(2) != 16 || effects != 60 {
    failures++;
}
if nested_exit(2) != 3 || effects != 162 {
    failures++;
}
if nested_stack() != 7 || comptime(nested_stack()) != 7 {
    failures++;
}

fn branch_runs(input: i32): i32 {
    var result: i32 = 0;
    if input > 0 {
        var first = identity(input);
        {
            var second = identity(first + 1);
            defer {
                effects += second;
            }
            result += second;
        }
        var last = identity(result);
        result += last;
    } else {
        var first = identity(10 -input);
        defer {
            effects += first;
        }
        result = first;
        var last = identity(first + 2);
        result += last;
    }
    return result;
}

fn loop_runs(input: i32): i32 {
    var result: i32 = 0;
    var i: i32 = 0;
    loop {
        i++;
        defer {
            effects += i;
        }
        var value = identity(i);
        {
            var values: i32[2];
            values[0] = value;
            values[1] = identity(2);
            if i == 2 {
                continue;
            }
            result += values[0] + values[1];
        }
        if i == input {
            break;
        }
    }
    return result;
}

fn staged_branch(): i32 {
    if comptime(identity(true)) {
        var first = identity(3);
        return identity(first + 2);
    }
}

fn loop_return(): i32 {
    loop {
        var first = identity(7);
        return identity(first + 2);
    }
}

fn structural_condition(input: i32): i32 {
    if identity(input) > 0 {
        var first = identity(input + 1);
        return identity(first + 2);
    }
    return 0;
}

if loop_runs(4) != 14 || effects != 172 {
