fn while_runs(): i32 {
    var i: i32 = 0;
    var result: i32 = 0;
    while identity(i) < 4 {
        i++;
        defer {
            effects += i;
        }
        var value = identity(i);
        if i == 2 {
            continue;
        }
        if i == 4 {
            break;
        }
        var storage: i32[1];
        storage[0] = value;
        result += storage[0];
    }
    return result;
}

fn for_runs(): i32 {
    var result: i32 = 0;
    for(var i = identity(0); i < identity(4); i = identity(i + 1)) {
        defer {
            effects += i;
        }
        var value = identity(i + 1);
        if i == 1 {
            continue;
        }
        if i == 3 {
            break;
        }
        var storage: i32[1];
        storage[0] = value;
        result += storage[0];
    }
    return result;
}

fn staged_for(): i32 {
    var result: i32 = 0;
    for(var i = identity(0); i < comptime(identity(4)); i = identity(i + 1)) {
        var value = identity(i);
        result += value;
    }
    return result;
}

fn staged_while(): i32 {
    while comptime(identity(true)) {
        var value = identity(8);
        return value;
    }
}

