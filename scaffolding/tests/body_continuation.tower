fn foreach_values(values: vector(i32)*): i32 {
    var result: i32 = 0;
    foreach(var &item in values) {
        var value = identity(*item);
        defer {
            var captured = identity(value);
            result += captured;
        }
        if value == 2 { continue; }
        result += identity(value);
        if value == 3 { break; }
    }
    return result;
}

fn foreach_runs(): i32 {
    var values: vector(i32) = default;
    defer vector_dispose(&values);
    vector_push(&values, 1);
    vector_push(&values, 2);
    vector_push(&values, 3);
    return foreach_values(&values);
}

if foreach_runs() != 10 { failures++; }

fn match_runs(input: i32): i32 {
    var result: i32 = 0;
    match identity(input) {
        1 | 2 => {
            var value = identity(input + 3);
            defer {
                result += identity(value);
            }
            var record: box(i32) = { value: identity(value + 1) };
            result = record.value;
        }
        3 => {
            var first = identity(10);
            match first {
                10 => {
                    var values: i32[1];
                    values[0] = identity(first + 2);
                    return values[0];
                }
                _ => { return identity(0); }
            }
        }
        _ => {
            var value = identity(7);
            var record: box(i32) = { value: identity(value + 1) };
            result = identity(record.value);
        }
    }
    return result;
}

fn match_default(): i32 {
    match identity(0) {
        _ => { return identity(13); }
    }
}

if match_runs(1) != 9 || match_runs(2) != 11 || match_runs(3) != 12 || match_runs(9) != 8 {
    failures++;
}
if comptime(match_runs(2)) != 11 || comptime(match_default()) != 13 {
    failures++;
}
fn declaration_queries(input: i32): i32 {
    var source = input + 1;
    var derived = identity(source);
    var explicit: decltype(identity(derived)) = identity(derived + 1);
    {
        var source = identity(explicit);
        explicit = source + comptime(identity(1));
    }
    return explicit;
}
if declaration_queries(39) != 42 { failures++; }
// Header inference can suspend, but its initializer runs once and the update
// keeps the header binding even when a body-local declaration shadows it.
fn for_initializer_once(): i32 {
    var hits: i32 = 0;
    var total: i32 = 0;
    for(var i = identity(hits++); i < 3; i++) {
        var i = identity(7);
        total += i;
    }
    return total * 10 + hits;
}

if for_initializer_once() != 211 || comptime(for_initializer_once()) != 211 {
    failures++;
}

fn initialize_self(address: i32*, input: i32): i32 {
    *address = input;
    return *address;
}

// Explicit initializers run through their own expression queries. Their slots
// already exist when an initializer takes its own address; effects run once.
fn explicit_initializers(input: i32): i32 {
    var prefix: i32 = input;
    var local: i32 = initialize_self(&local, identity(prefix + 1));
    var before: i32 = identity(local++);
    var record: box(i32) = { value: identity(before + 1) };
    return local * 100 + before * 10 + record.value;
}

fn explicit_peer(input: i32): i32 {
    var result: i32 = identity(input);
    var nested: i32 = identity(identity(result + 1));
    return nested;
}

if explicit_initializers(1) != 323 || explicit_peer(41) != 42
    || comptime(explicit_initializers(1)) != 323 || comptime(explicit_peer(41)) != 42 {
    failures++;
}

fn condition_queries(): i32 {
    var hits: i32 = 0;
    var total: i32 = 0;
    if identity(hits++ == 0) { total += 10; }
    while identity(hits++ < 4) { total++; }
    return hits * 100 + total;
}

if condition_queries() != 513 || comptime(condition_queries()) != 513 { failures++; }

fn tick(value: i32*): void { (*value)++; }

fn for_tail_queries(): i32 {
    var starts: i32 = 0;
    var checks: i32 = 0;
    var steps: i32 = 0;
    var sum: i32 = 0;
    for (var i: i32 = identity(starts++); identity((checks++, i < 4)); tick(&steps), i++) {
        if i == 1 { continue; }
        if i == 3 { break; }
        var i = identity(7);
        sum += i;
    }
    var x: i32 = 0;
    for (x = identity(1); ; tick(&x)) {
        if x == 3 { break; }
        sum += x;
    }
    for (; identity(x < 5); tick(&x)) {
        if x == 3 { continue; }
        sum += x;
    }
    return starts * 10000 + checks * 1000 + steps * 100 + sum * 10 + x;
}

if for_tail_queries() != 14515 || comptime(for_tail_queries()) != 14515 { failures++; }

fn viewed(values: vector(i32)*, visits: i32*): vector(i32)* {
    (*visits)++;
    return values;
}

fn selection_sources(): i32 {
    var visits: i32 = 0;
    var storage: i32[2];
    storage[0] = 4;
    storage[1] = 6;
    // A borrowed stack view also exercises strict staging without heap effects.
    var values: vector(i32) = { data: &storage[0], length: 2, capacity: 2 };
    var sum: i32 = 0;
    foreach (var value in viewed(&values, &visits)) { sum += value; }
    match identity(visits++) {
        1 => { sum += 20; }
        _ => { return 0; }
    }
    return visits * 100 + sum;
}

if selection_sources() != 230 || comptime(selection_sources()) != 230 { failures++; }

fn callback_value(value: i32): i32 { return value + 1; }

fn callback_identity(value: function(i32, i32)): function(i32, i32) { return value; }

struct CallbackFields {
    apply: function(i32, i32);
    select: function(function(i32, i32), function(i32, i32));
}

// Signature constructors publish private staged types, including nested return
// and parameter signatures, before their consumers invoke the checked values.
fn signature_queries(input: i32): i32 {
    var apply: function(i32, i32) = callback_value;
    var select: function(function(i32, i32), function(i32, i32)) = callback_identity;
    var fields: CallbackFields = { apply: apply, select: select };
    return fields.select(fields.apply)(input);
}

fn signature_peer(input: i32): i32 {
    var apply: function(decltype(callback_value(0)), i32) = callback_value;
    return apply(input);
}

if signature_queries(41) != 42 || signature_peer(41) != 42
    || comptime(signature_queries(41)) != 42 || comptime(signature_peer(41)) != 42 { failures++; }

struct InvokeRecord { value: i32; visits: i32; }

fn callback_record(value: InvokeRecord): InvokeRecord { value.value++; return value; }

fn choose_record(visits: i32*): function(InvokeRecord, InvokeRecord) {
    (*visits)++;
    return callback_record;
}

// The nested invocation consumes a published signature/layout and evaluates
// the callee before the contextual aggregate argument, exactly once.
fn signature_invokes(input: i32): i32 {
    var visits = 0;
    var value = choose_record(&visits)({ value: input, visits: visits });
    if visits != 1 || value.visits != 1 { return 0; }
    return value.value;
}

if signature_invokes(41) != 42 || comptime(signature_invokes(41)) != 42 { failures++; }

fn callback_fields(T: type, input: T): CallbackFields {
    return { apply: callback_value, select: callback_identity };
}

fn signature_callee(input: i32): i32 {
    var value: decltype(callback_fields(input).apply(input)) = input;
    return callback_fields(value).apply(value);
}

if signature_callee(41) != 42 || comptime(signature_callee(41)) != 42 { failures++; }

// The module loop checks this specialization before body queries begin. Body
// loops must reuse that completed signature without inventing a missing ticket.
var module_iteration_storage: i32[1];
module_iteration_storage[0] = 42;
var module_iteration_values: vector(i32) = { data: &module_iteration_storage[0], length: 1, capacity: 1 };
var module_iteration_sum = 0;
foreach(var value in &module_iteration_values) { module_iteration_sum += value; }
if module_iteration_sum != 42 { failures++; }

print(failures);
