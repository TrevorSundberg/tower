import tower;
import .library.vector;
import .compiler.syntax_view;
import .compiler.syntax_types;
import .compiler.component_kinds;
import .compiler.grammar_types;
import frontend_world;
import frontend_format;
import frontend_syntax_preview;

extern fn syntax_pending_create(rules: SyntaxRuleView*, count: usize, waiting: void**, kind: void*, out: void**): bool;

extern fn syntax_pending_destroy(value: void*): void;

extern fn syntax_pending_count(value: void*): usize;

extern fn syntax_pending_name(value: void*, index: usize): u8*;

extern fn syntax_pending_contains(value: void*, name: u8*): bool;

extern fn syntax_pending_message(value: void*, offset: usize*): u8*;

fn frontend_pending_tests(): void {
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    var store = compiler_world_store(world);
    var kinds: FrontendKinds;
    frontend_world_check(frontend_world_test_kinds(world, &kinds));
    var source = entity_create(store);
    var alternatives: void*[3];
    var waiting: void*[3];
    var rules: SyntaxRuleView[3];
    // Names and term text are length-delimited, deliberately without a NUL.
    var names: u8[3];
    copy(&names, "ABC", 3);
    var index: usize = 0;
    while index < 3 {
        alternatives[index] = frontend_format_child(store, source, null);
        var sequence = preview_syntax(world, alternatives[index]);
        sequence.kind = convert(u32, SyntaxKind.Alternative);
        rules[index].name = &names[index];
        rules[index].name_length = 1;
        rules[index].alternatives = &alternatives[index];
        rules[index].count = 1;
        waiting[index] = null;
        if index < 2 {
            waiting[index] = frontend_format_child(store, alternatives[index], null);
            var term = preview_syntax(world, waiting[index]);
            term.kind = convert(u32, SyntaxKind.Term);
            term.start = index == 0 ? 11: 29;
            frontend_world_check(bytes_append(&term.text, index == 0 ? "B": "missing", index == 0 ? 1: 7));
            frontend_world_check(vector_push(void*, &sequence.items, waiting[index]));
        }
        ++index;
    }
    var references = entity_references(alternatives[0]);
    var allocations = tower_test_buffer_allocations();
    var revision: void* = null;
    frontend_world_check(syntax_pending_create(&rules[0], 3, &waiting[0], kinds.syntax, &revision));
    var construction = tower_test_buffer_allocations() -allocations;
    frontend_world_check(revision is not null);
    frontend_world_check(entity_references(alternatives[0]) == references + 1);
    frontend_world_check(entity_references(alternatives[2]) == references);
    var buffers = tower_test_buffer_count();
    allocations = tower_test_buffer_allocations();
    index = 0;
    while index < 64 {
        frontend_world_check(syntax_pending_count(revision) == 2);
        frontend_format_text(syntax_pending_name(revision, 0), "A");
        frontend_format_text(syntax_pending_name(revision, 1), "B");
        frontend_world_check(syntax_pending_name(revision, 2) is null);
        frontend_world_check(syntax_pending_contains(revision, "A"));
        frontend_world_check(syntax_pending_contains(revision, "B"));
        frontend_world_check(!syntax_pending_contains(revision, "C"));
        frontend_world_check(!syntax_pending_contains(revision, "absent"));
        var offset = frontend_world_unlimited();
        frontend_format_text(syntax_pending_message(revision, &offset),
        "Unresolved grammar reference at end of module: A -> B -> missing (undefined rule 'missing')");
        frontend_world_check(offset == 29);
        ++index;
    }
    frontend_world_check(tower_test_buffer_allocations() == allocations);
    frontend_world_check(tower_test_buffer_count() == buffers);
    frontend_world_check(entity_references(alternatives[0]) == references + 1);
    syntax_pending_destroy(revision);
    buffers = tower_test_buffer_count();
    // Fail each construction allocation; no partial owner or retain may escape.
    index = 0;
    while index < construction {
        tower_test_buffer_fail_after(index);
        var created = syntax_pending_create(&rules[0], 3, &waiting[0], kinds.syntax, &revision);
        tower_test_buffer_fail_after(frontend_world_unlimited());
        frontend_world_check(!created);
        frontend_world_check(revision is null);
        frontend_world_check(tower_test_buffer_count() == buffers);
        frontend_world_check(entity_references(alternatives[0]) == references);
        ++index;
    }
    frontend_world_check(syntax_pending_create(&rules[0], 3, &waiting[0], kinds.syntax, &revision));
    frontend_world_check(revision is not null);
    fill(&names, 88, 3);
    entity_release(source);
    frontend_format_text(syntax_pending_name(revision, 0), "A");
    frontend_format_text(syntax_pending_name(revision, 1), "B");
    frontend_format_text(syntax_pending_message(revision, null),
    "Unresolved grammar reference at end of module: A -> B -> missing (undefined rule 'missing')");
    syntax_pending_destroy(revision);
    // Empty input succeeds even when every allocation is forbidden.
    tower_test_buffer_fail_after(0);
    var empty = syntax_pending_create(null, 0, null, kinds.syntax, &revision);
    waiting[0] = null;
    waiting[1] = null;
    empty &&= syntax_pending_create(&rules[0], 3, &waiting[0], kinds.syntax, &revision);
    tower_test_buffer_fail_after(frontend_world_unlimited());
    frontend_world_check(empty);
    frontend_world_check(revision is null);
    frontend_world_check(syntax_pending_count(revision) == 0);
    frontend_world_check(syntax_pending_name(revision, 0) is null);
    frontend_world_check(!syntax_pending_contains(revision, "A"));
    var offset: usize = 17;
    frontend_format_text(syntax_pending_message(revision, &offset), "");
    frontend_world_check(offset == 17);
    syntax_pending_destroy(revision);
    syntax_pending_destroy(null);
    frontend_world_check(syntax_pending_count(null) == 0);
    frontend_world_check(compiler_world_dispose(world));
    frontend_world_check(tower_test_buffer_count() == baseline);
}
