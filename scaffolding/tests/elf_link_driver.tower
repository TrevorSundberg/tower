import tower;
import utility_checks;
import elf_link_checks;
import .backend.elf_types;
import .backend.elf_link;
import .backend.elf_link_world;
import .backend.wasm_bytes;
import .library.bytes;
import .library.bytes_types;
import .library.vector;
import .library.entities;
import .library.entity_types;
import .host.work_linux;
import .host.work_dispatch;

extern fn fopen(path: u8*, mode: u8*): void*;
extern fn fclose(file: void*): i32;
extern fn fseek(file: void*, offset: i64, mode: i32): i32;
extern fn ftell(file: void*): i64;
extern fn fread(data: u8*, size: usize, count: usize, file: void*): usize;
extern fn fwrite(data: u8*, size: usize, count: usize, file: void*): usize;
export fn tower_entity_finalize(lifecycle: usize, component: EntityComponent*, data: u8*): void { abort(); }
export fn work_kernel_execute(job: void*): void { abort(); }

fn elf_test_file(path: u8*, data: ByteBuffer*): bool {
    var file = fopen(path, "rb"); if file == null { return false; }
    defer fclose(file);
    var file_end: i32 = 2;
    if fseek(file, 0, file_end) != 0 { return false; }
    var length = ftell(file);
    if length < 0 || convert(u64, length) > convert(u64, ~convert(usize, 0)) || fseek(file, 0, 0) != 0 { return false; }
    if !bytes_reserve(data, convert(usize, length)) { return false; }
    data.length = convert(usize, length);
    return fread(data.data, 1, data.length, file) == data.length;
}

// A functional byte-service runner: output, machine, worker count, object/archive
// inputs. Input storage outlives all jobs and the explicit linker world.
export fn main(argc: i32, argv: u8**): i32 {
    var first_input: i32 = 4;
    if argc <= first_input { puts("usage: elf_link_driver output x64|arm64 workers object-or-archive ..."); return 1; }
    var checks = wasm_bytes_text(wasm_text_bytes(argv[first_input]), "--checks");
    if checks { first_input++; }
    var input: vector(ByteBuffer) = default;
    defer { foreach (var & buffer in &input) { bytes_dispose(buffer); } vector_dispose(&input); }
    var link: ElfLink = default; defer elf_link_close(&link);
    var machine = wasm_bytes_text(wasm_text_bytes(argv[2]), "arm64") ? ElfMachine.Arm64 : ElfMachine.X64;
    utility_check(elf_link_open(&link, machine), "ELF world allocation");
    link.workers = convert(usize, *argv[3] - *"0");
    for (var at = first_input; at < argc; at++) {
        var buffer: ByteBuffer = default;
        utility_check(elf_test_file(argv[at], &buffer), "ELF input read");
        utility_check(vector_push(&input, buffer), "ELF input ownership");
    }
    if checks {
        utility_check(input.length == 3, "checks require program/runtime/library");
        var archive: ByteBuffer = default;
        elf_check_archive(&input.data[input.length - 1], &archive);
        bytes_dispose(&input.data[input.length - 1]); input.data[input.length - 1] = archive;
    }
    // Present the archive first to exercise demand-driven extraction even when
    // its reference arrives later in the input list.
    for (var index = input.length; index != 0;) {
        index--;
        var buffer = &input.data[index];
        var data: WasmBytes = { data: buffer.data, length: buffer.length };
        if !elf_link_input(&link, wasm_text_bytes(argv[first_input + convert(i32, index)]), data) { break; }
    }
    if !elf_link_run(&link) {
        puts(elf_message(link.error.kind));
        var message: ByteBuffer = default; defer bytes_dispose(&message);
        bytes_assign_text(&message, link.error.name.data, link.error.name.length); puts(message.data);
        print(link.error.offset); return 1;
    }
    if checks {
        // Compare the same input ordering used by the reference request.
        var first = input.data[0]; input.data[0] = input.data[1]; input.data[1] = first;
        elf_check_inputs(machine, &input, &link);
        elf_check_symbol_policies(&link);
        elf_check_byte_service(machine, &input, &link);
    }
    var file = fopen(argv[1], "wb"); utility_check(file != null, "ELF output open");
    var written = fwrite(link.output.data, 1, link.output.length, file);
    utility_check(fclose(file) == 0 && written == link.output.length, "ELF output write");
    puts("Tower ELF image linked"); print(link.jobs_run); print(link.jobs_peak);
    return 0;
}
