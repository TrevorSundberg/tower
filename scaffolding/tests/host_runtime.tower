import tower;
import host_services;
import .host.driver_options;
import .host.driver_types;
import .host.memory;
import .host.memory_types;

// Functional host tests execute Tower implementations on the test host target.
extern fn tower_test_buffer_count(): usize;

extern fn tower_test_buffer_fail_next(): void;

export fn host_runtime_tests(): i32 {
    var maximum: usize = 0;
    maximum--;
    // Both diagnostic and ordinary compiler allocation are Tower algorithms.
    var node_state: CompilerNodeMemoryState;
    node_state.live_allocations = 0;
    var rejected = compiler_node_allocate(&node_state, maximum, true);
    var bad = rejected != null;
    if bad {
        return 701;
    }
    bad = node_state.live_allocations != 0;
    if bad {
        return 702;
    }
    var size: usize = 0;
    for(; size != 65; size++) {
        var diagnostic = compiler_node_allocate(&node_state, size, true);
        var ordinary = compiler_node_allocate(&node_state, size, false);
        bad = diagnostic == null;
        if bad {
            return 703;
        }
        bad = ordinary == null;
        if bad {
            return 704;
        }
        bad = node_state.live_allocations != 2;
        if bad {
            return 705;
        }
        var remainder = bits(usize, diagnostic) % sizeof(usize);
        bad = remainder != 0;
        if bad {
            return 706;
        }
        fill(diagnostic, 42, size);
        copy(ordinary, diagnostic, size);
        compiler_node_free(&node_state, diagnostic, true);
        compiler_node_free(&node_state, ordinary, false);
        compiler_node_free(&node_state, null, true);
        bad = node_state.live_allocations != 0;
        if bad {
            return 707;
        }
    }
    var state: CompilerMemoryState;
    state.live_buffers = 0;
    state.allocation_calls = 0;
    state.fail_after = maximum;
    var pointer = compiler_memory_reallocate(&state, null, 4, 2);
    if pointer == null {
        return 1;
    }
    if state.live_buffers != 1 {
        return 2;
    }
    var bytes = bits(u8*, pointer);
    bytes[0] = 42;
    bytes[7] = 91;
    // Overflow must not consume an injection or touch the original allocation.
    state.fail_after = 0;
    var next = compiler_memory_reallocate(&state, pointer, maximum, 2);
    if next != null {
        return 3;
    }
    if state.allocation_calls != 1 {
        return 4;
    }
    if state.fail_after != 0 {
        return 5;
    }
    next = compiler_memory_reallocate(&state, pointer, 32, 1);
    if next != null {
        return 6;
    }
    if state.fail_after != maximum {
        return 7;
    }
    if state.live_buffers != 1 {
        return 8;
    }
    if bytes[0] != 42 {
        return 9;
    }
    if bytes[7] != 91 {
        return 10;
    }
    next = compiler_memory_reallocate(&state, pointer, 32, 1);
    if next == null {
        return 11;
    }
    pointer = next;
    bytes = bits(u8*, pointer);
    if bytes[0] != 42 {
        return 12;
    }
    if bytes[7] != 91 {
        return 13;
    }
    if state.live_buffers != 1 {
        return 14;
    }
    // Injected failure precedes the zero-size free, matching the old host.
    state.fail_after = 0;
    next = compiler_memory_reallocate(&state, pointer, 0, 1);
    if next != null {
        return 15;
    }
    if state.live_buffers != 1 {
        return 16;
    }
    if bytes[0] != 42 {
        return 17;
    }
    next = compiler_memory_reallocate(&state, pointer, maximum, 0);
    if next != null {
        return 18;
    }
    if state.live_buffers != 0 {
        return 19;
    }
    compiler_memory_deallocate(&state, null);
    if state.live_buffers != 0 {
        return 20;
    }
    state.fail_after = 1;
    pointer = compiler_memory_reallocate(&state, null, 1, 1);
    if pointer == null {
        return 21;
    }
    next = compiler_memory_reallocate(&state, null, 1, 1);
    if next != null {
        return 22;
    }
    compiler_memory_deallocate(&state, pointer);
    pointer = compiler_memory_reallocate(null, null, 8, 1);
    if pointer == null {
        return 23;
    }
    compiler_memory_deallocate(null, pointer);
    if state.live_buffers != 0 {
        return 24;
    }

    var buffers = tower_test_buffer_count();
    var options: DriverOptions;
    var argv: u8*[40];
    argv[0] = "towerc";
    var args = &argv[0];
    var ok = driver_parse(&options, 1, args, "host-target");
    if !ok {
        return 25;
    }
    if driver_equal(options.target, "host-target") == false {
        return 26;
    }
    if driver_equal(options.emit, "exe") == false {
        return 27;
    }
    if driver_equal(options.cc, "clang") == false {
        return 28;
    }
    if !options.optimize {
        return 29;
    }
    driver_dispose(&options);
    argv[1] = "input.tower";
    argv[2] = "--link";
    argv[3] = "first.o";
    argv[4] = "--link";
    argv[5] = "second.a";
    argv[6] = "--library";
    argv[7] = "--emit";
    argv[8] = "llvm";
    argv[9] = "--no-optimize";
    argv[10] = "--interpret";
    argv[11] = "--timings";
    argv[12] = "--target";
    argv[13] = "explicit-target";
    argv[14] = "-o";
    argv[15] = "first.out";
    argv[16] = "-o";
    argv[17] = "last.out";
    argv[18] = "--cc";
    argv[19] = "cc path";
    argv[20] = "--linker";
    argv[21] = "linker path";
    argv[22] = "--sysroot";
    argv[23] = "root path";
    argv[24] = "--raw-ir";
    argv[25] = "raw.ll";
    argv[26] = "--optimized-ir";
    argv[27] = "optimized.ll";
    argv[28] = "--bedrock";
    argv[29] = "bedrock path";
    argv[30] = "--foundation";
    argv[31] = "foundation path";
    ok = driver_parse(&options, 32, args, "host");
    if !ok {
        return 30;
    }
    if driver_equal(options.source, "input.tower") == false {
        return 31;
    }
    if options.link_count != 2 {
        return 32;
    }
    if driver_equal(options.links[0], "first.o") == false {
        return 33;
    }
    if driver_equal(options.links[1], "second.a") == false {
        return 34;
    }
    if !options.library {
        return 35;
    }
    if driver_equal(options.emit, "llvm") == false {
        return 36;
    }
    if options.optimize {
        return 37;
    }
    if !options.interpret {
        return 38;
    }
    if !options.timings {
        return 39;
    }
    if driver_equal(options.target, "explicit-target") == false {
        return 40;
    }
    if driver_equal(options.output, "last.out") == false {
        return 41;
    }
    if driver_equal(options.cc, "cc path") == false {
        return 42;
    }
    if driver_equal(options.linker, "linker path") == false {
        return 43;
    }
    if driver_equal(options.sysroot, "root path") == false {
        return 44;
    }
    if driver_equal(options.raw, "raw.ll") == false {
        return 45;
    }
    if driver_equal(options.optimized, "optimized.ll") == false {
        return 46;
    }
    if driver_equal(options.bedrock, "bedrock path") == false {
        return 47;
    }
    if driver_equal(options.foundation, "foundation path") == false {
        return 48;
    }
    driver_dispose(&options);
    // Every value option must diagnose a missing final value.
    var flags: u8*[11];
    flags[0] = "-o";
    flags[1] = "--target";
    flags[2] = "--emit";
    flags[3] = "--link";
    flags[4] = "--cc";
    flags[5] = "--linker";
    flags[6] = "--sysroot";
    flags[7] = "--raw-ir";
    flags[8] = "--optimized-ir";
    flags[9] = "--bedrock";
    flags[10] = "--foundation";
    var index: usize = 0;
    for(; index != 11; index++) {
        argv[1] = flags[index];
        ok = driver_parse(&options, 2, args, "host");
        if ok {
            return 49;
        }
        if options.error != 1 {
            return 50;
        }
        if options.argument != flags[index] {
            return 51;
        }
        driver_dispose(&options);
    }
    argv[1] = "--help";
    argv[2] = "--invalid";
    ok = driver_parse(&options, 3, args, "host");
    if !ok {
        return 52;
    }
    if !options.help {
        return 53;
    }
    driver_dispose(&options);
    argv[1] = "--invalid";
    argv[2] = "--help";
    ok = driver_parse(&options, 3, args, "host");
    if ok {
        return 54;
    }
    if options.error != 2 {
        return 55;
    }
    driver_dispose(&options);
    argv[1] = "one.tower";
    argv[2] = "two.tower";
    ok = driver_parse(&options, 3, args, "host");
    if ok {
        return 56;
    }
    if options.argument != argv[2] {
        return 57;
    }
    driver_dispose(&options);
    argv[1] = "--emit";
    argv[2] = "exe";
    argv[3] = "--library";
    ok = driver_parse(&options, 4, args, "host");
    if !ok {
        return 58;
    }
    if driver_equal(options.emit, "object") == false {
        return 59;
    }
    driver_dispose(&options);
    // Values beginning with '-' are still values, including --help.
    argv[1] = "-o";
    argv[2] = "--help";
    ok = driver_parse(&options, 3, args, "host");
    if !ok {
        return 60;
    }
    if options.help {
        return 61;
    }
    if driver_equal(options.output, "--help") == false {
        return 62;
    }
    driver_dispose(&options);
    argv[1] = "--link";
    argv[2] = "first.o";
    tower_test_buffer_fail_next();
    ok = driver_parse(&options, 3, args, "host");
    if ok {
        return 63;
    }
    if options.error != 3 {
        return 64;
    }
    driver_dispose(&options);
    // An error after a successful allocation must remain disposable.
    argv[3] = "--invalid";
    ok = driver_parse(&options, 4, args, "host");
    if ok {
        return 65;
    }
    if options.link_count != 1 {
        return 66;
    }
    driver_dispose(&options);
    driver_dispose(&options);
    if tower_test_buffer_count() != buffers {
        return 67;
    }
    return host_services_tests();
}
