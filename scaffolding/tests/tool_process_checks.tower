import tower;
import utility_checks;
import .tools.tool_process_linux;
import .tools.tool_capture_linux;
import .tools.tool_streams_posix;
import .host.driver_files;
import .library.vector;
import .library.bytes;
import .library.bytes_types;

extern fn strcmp(left: u8*, right: u8*): i32;
extern fn strlen(text: u8*): usize;
extern fn raise(signal: i32): i32;

fn process_check_run(path: u8*, mode: u8*): ToolProcessResult {
    var args: vector(u8*) = default;
    defer vector_dispose(&args);
    utility_check(tool_process_argument(&args, path) && tool_process_argument(&args, "--child")
        && tool_process_argument(&args, mode) && tool_process_argument(&args, "literal spaces;$(no_command)")
        && tool_process_argument(&args, "") && tool_process_argument(&args, null), "child argument storage");
    return tool_process(path, args.data);
}

export fn main(argc: i32, argv: u8**): i32 {
    var child_count: i32 = 5;
    var fixture_exit: i32 = 37;
    var exec_like_exit: i32 = 127;
    var terminate_signal: i32 = 15;
    var unexpected_return: i32 = 1;
    var binary_chunk: usize = 256; var binary_repeats: usize = 512;
    if argc != 1 {
        utility_check(argc == child_count && strcmp(argv[1], "--child") == 0, "child mode arguments");
        utility_check(strcmp(argv[3], "literal spaces;$(no_command)") == 0 && argv[4][0] == 0,
            "child received exact shell-free arguments including empty string");
        if strcmp(argv[2], "signal") == 0 { raise(terminate_signal); return unexpected_return; }
        if strcmp(argv[2], "exec-like") == 0 { return exec_like_exit; }
        if strcmp(argv[2], "both") == 0 {
            var stdout_stream: i32 = 1; var stderr_stream: i32 = 2;
            var stdout_data: u8[3]; stdout_data[0] = 42; stdout_data[1] = 0; stdout_data[2] = 17;
            var stderr_data: u8[2]; stderr_data[0] = 9; stderr_data[1] = 0;
            var stdout_bytes: usize = 3; var stderr_bytes: usize = 2;
            utility_check(write(stdout_stream, &stdout_data[0], stdout_bytes) == convert(i64, stdout_bytes)
                && write(stderr_stream, &stderr_data[0], stderr_bytes) == convert(i64, stderr_bytes), "separate binary writes");
            return fixture_exit;
        }
        if strcmp(argv[2], "capture") == 0 {
            var data: u8[256]; var stdout_stream: i32 = 1;
            for (var at: usize = 0; at < binary_chunk; at++) { data[at] = convert(u8, at); }
            for (var at: usize = 0; at < binary_repeats; at++) {
                utility_check(write(stdout_stream, &data[0], binary_chunk) == convert(i64, binary_chunk), "child binary output");
            }
            return 0;
        }
        return fixture_exit;
    }
    var ordinary = process_check_run(argv[0], "ordinary");
    utility_check(ordinary.kind == ToolProcessKind.Exited && ordinary.exit_code == fixture_exit
        && tool_process_status(ordinary) == fixture_exit, "exact ordinary exit status");
    var special = process_check_run(argv[0], "exec-like");
    utility_check(special.kind == ToolProcessKind.Exited && special.exit_code == exec_like_exit,
        "real exit 127 distinguished from exec failure");
    var signaled = process_check_run(argv[0], "signal");
    utility_check(signaled.kind == ToolProcessKind.Signaled && signaled.signal == terminate_signal, "signal status preserved");
    var missing: ByteBuffer = default;
    defer bytes_dispose(&missing);
    utility_check(bytes_append(&missing, argv[0], strlen(argv[0]))
        && bytes_append(&missing, ".missing", strlen(".missing")) && bytes_push(&missing, 0), "missing executable path");
    var failed = process_check_run(missing.data, "ordinary");
    var no_entry: i32 = 2;
    utility_check(failed.kind == ToolProcessKind.ExecFailed && failed.error == no_entry, "exec failure errno preserved");
    var args: vector(u8*) = default; var captured: ByteBuffer = default;
    defer vector_dispose(&args); defer bytes_dispose(&captured);
    utility_check(tool_process_argument(&args, argv[0]) && tool_process_argument(&args, "--child")
        && tool_process_argument(&args, "capture") && tool_process_argument(&args, "literal spaces;$(no_command)")
        && tool_process_argument(&args, "") && tool_process_argument(&args, null), "capture arguments");
    var limit = binary_chunk * binary_repeats;
    utility_check(tool_capture(argv[0], args.data, limit, &captured) == 0 && captured.length == limit, "capture exceeds pipe capacity");
    for (var at: usize = 0; at < captured.length; at++) {
        utility_check(captured.data[at] == convert(u8, at % binary_chunk), "exact binary capture including NUL");
    }
    var saved = captured.data;
    utility_check(tool_capture(argv[0], args.data, limit - 1, &captured) != 0
        && captured.data == saved && captured.length == limit, "capture limit preserves output");
    var invalid_descriptor: i32 = 2147483647; var bad_descriptor: i32 = 9;
    var redirected = tool_process_output(argv[0], args.data, invalid_descriptor);
    utility_check(redirected.kind == ToolProcessKind.RedirectFailed && redirected.error == bad_descriptor, "redirect failure distinguished");
    args.data[2] = "ordinary";
    utility_check(tool_capture(argv[0], args.data, limit, &captured) == fixture_exit && captured.data == saved, "capture propagates failed child status");
    var out_file = tmpfile(); var err_file = tmpfile();
    utility_check(out_file != null && err_file != null, "separate capture files");
    defer fclose(out_file); defer fclose(err_file);
    args.data[2] = "both";
    var both = tool_process_streams(argv[0], args.data, fileno(out_file), fileno(err_file));
    utility_check(both.kind == ToolProcessKind.Exited && both.exit_code == fixture_exit, "stderr capture retains nonzero exit");
    var seek_start: i32 = 0;
    utility_check(fseek(out_file, 0, seek_start) == 0 && fseek(err_file, 0, seek_start) == 0, "capture descriptors remain caller owned");
    utility_check(tool_read_stream(out_file, limit, &captured) && captured.length == 3
        && captured.data[0] == 42 && captured.data[1] == 0 && captured.data[2] == 17, "exact binary stdout kept separate");
    utility_check(tool_read_stream(err_file, limit, &captured) && captured.length == 2
        && captured.data[0] == 9 && captured.data[1] == 0, "exact binary stderr kept separate");
    var bad_stderr = tool_process_streams(argv[0], args.data, fileno(out_file), invalid_descriptor);
    utility_check(bad_stderr.kind == ToolProcessKind.RedirectFailed && bad_stderr.error == bad_descriptor, "stderr redirect failure distinguished");
    puts("Tower process checks passed");
    return 0;
}
