import tower;
import .host.memory;
import .library.work_graph;
import .library.work_graph_types;
import .library.vector;

var failures: u32 = 0;

fn check(ok: bool): void {
    if !ok {
        failures++;
    }
}

fn request(g: WorkGraph*, key: u64): usize {
    var id = work_request(g, null, 1, key);
    check(id != 0);
    return id;
}

fn resume_tests(): void {
    var g: WorkGraph;
    work_init(&g, 11, 29);
    var query = request(&g, 1);
    var input = request(&g, 2);
    var unused = request(&g, 3);
    check(work_access(&g, query, 1, 1, 0, 8, WorkAccessMode.Write));
    check(work_access(&g, input, 1, 1, 0, 8, WorkAccessMode.Write));
    check(work_seal(&g, query));
    check(work_seal(&g, input));
    check(work_seal(&g, unused));
    check(work_demand(&g, query));
    var ticket: WorkTicket;
    var old: WorkTicket;
    var spare: WorkTicket;
    check(work_take(&g, &ticket));
    check(ticket.task == query);
    copy(&old, &ticket, sizeof(WorkTicket));
    check(!work_suspend(&g, &ticket, 0));
    check(work_ticket_valid(&g, &ticket));
    check(work_suspend(&g, &ticket, input));
    check(g.running == 0);
    check(g.executing.length == 0);
    check(!work_finish(&g, &old, true));
    check(work_take(&g, &ticket));
    check(ticket.task == input);
    check(!work_take(&g, &spare));
    check(work_finish(&g, &ticket, true));
    check(work_take(&g, &ticket));
    check(ticket.task == query);
    check(ticket.dispatch != old.dispatch);
    check(!work_finish(&g, &old, true));
    check(!work_suspend(&g, &old, unused));
    check(g.running == 1);
    check(g.executing.length == 1);
    // Reobserving a completed input neither duplicates the edge nor its work.
    check(work_suspend(&g, &ticket, input));
    check(g.edges.length == 1);
    check(work_take(&g, &ticket));
    check(ticket.task == query);
    check(work_task(&g, input).dispatch == 1);
    copy(&old, &ticket, sizeof(WorkTicket));
    check(work_yield(&g, &ticket));
    check(!work_ticket_valid(&g, &old));
    check(work_take(&g, &ticket));
    check(ticket.task == query && ticket.dispatch != old.dispatch);
    check(work_finish(&g, &ticket, true));
    check(!work_take(&g, &spare));
    check(!work_task(&g, unused).demanded);
    check(g.running == 0);
    work_dispose(&g);
}

fn diamond_tests(): void {
    var g: WorkGraph;
    work_init(&g, 12, 29);
    var left = request(&g, 1);
    var right = request(&g, 2);
    var shared = request(&g, 3);
    check(work_seal(&g, left));
    check(work_seal(&g, right));
    check(work_seal(&g, shared));
    check(work_demand(&g, left));
    check(work_demand(&g, right));
    var a: WorkTicket;
    var b: WorkTicket;
    var c: WorkTicket;
    check(work_take(&g, &a));
    check(work_take(&g, &b));
    check(work_suspend(&g, &a, shared));
    check(work_suspend(&g, &b, shared));
    check(work_take(&g, &c));
    check(c.task == shared);
    check(!work_take(&g, &a));
    check(work_finish(&g, &c, true));
    check(work_take(&g, &a));
    check(work_take(&g, &b));
    check(a.task != b.task);
    check(work_finish(&g, &b, true));
    check(work_finish(&g, &a, true));
    check(work_task(&g, shared).dispatch == 1);
    check(!work_take(&g, &c));
    work_dispose(&g);
}

fn discovered_access_tests(): void {
    var g: WorkGraph;
    work_init(&g, 18, 29);
    defer work_dispose(&g);
    var query = work_request(&g, null, 1, 0);
    var input = work_request(&g, null, 2, 0);
    var writer = work_request(&g, null, 3, 0);
    var reader = work_request(&g, null, 4, 0);
    var unrelated = work_request(&g, null, 5, 0);
    check(work_access(&g, input, 1, 1, 20, 4, WorkAccessMode.Write));
    check(work_access(&g, writer, 1, 1, 20, 4, WorkAccessMode.Write));
    check(work_access(&g, reader, 1, 1, 20, 4, WorkAccessMode.Read));
    check(work_access(&g, unrelated, 1, 1, 24, 1, WorkAccessMode.Write));
    check(work_seal(&g, query));
    check(work_seal(&g, input));
    check(work_seal(&g, writer));
    check(work_seal(&g, reader));
    check(work_seal(&g, unrelated));
    check(work_demand(&g, query));
    var old: WorkTicket;
    var current: WorkTicket;
    var peer: WorkTicket;
    var spare: WorkTicket;
    check(work_take(&g, &old));
    check(work_suspend_access(&g, &old, input, 1, 1, 20, 4, WorkAccessMode.Read));
    check(g.running == 0);
    // The new read claim must not prevent its own producer from running.
    check(work_take(&g, &current));
    check(current.task == input);
    check(work_finish(&g, &current, true));
    check(work_demand(&g, writer));
    check(work_demand(&g, reader));
    check(work_demand(&g, unrelated));
    check(work_take_query(&g, &current, 1));
    var claims = g.accesses.length;
    check(!work_suspend_access(&g, &old, input, 1, 1, 20, 4, WorkAccessMode.Write));
    check(g.accesses.length == claims);
    check(work_take_query(&g, &peer, 4));
    check(work_take_query(&g, &spare, 5));
    check(work_finish(&g, &spare, true));
    check(!work_take_query(&g, &spare, 3));
    check(work_finish(&g, &current, true));
    check(!work_take_query(&g, &spare, 3));
    check(work_finish(&g, &peer, true));
    check(work_take_query(&g, &spare, 3));
    check(work_finish(&g, &spare, true));
    check(g.running == 0 && work_ok(&g));
}

fn failure_tests(): void {
    var g: WorkGraph;
    work_init(&g, 13, 29);
    var query = request(&g, 1);
    var input = request(&g, 2);
    check(work_seal(&g, query));
    check(work_seal(&g, input));
    check(work_demand(&g, query));
    var ticket: WorkTicket;
    check(work_take(&g, &ticket));
    check(work_suspend(&g, &ticket, input));
    check(work_take(&g, &ticket));
    check(work_finish(&g, &ticket, false));
    check(work_task(&g, query).state == WorkState.Failed);
    check(!work_take(&g, &ticket));
    check(g.running == 0);
    work_dispose(&g);

    work_init(&g, 14, 29);
    query = request(&g, 1);
    input = request(&g, 2);
    check(work_seal(&g, query));
    check(work_seal(&g, input));
    check(work_demand(&g, query));
    check(work_take(&g, &ticket));
    check(work_suspend(&g, &ticket, input));
    check(work_take(&g, &ticket));
    work_cancel(&g);
    check(!work_finish(&g, &ticket, true));
    check(!work_suspend(&g, &ticket, query));
    check(g.running == 0);
    work_dispose(&g);
}

fn cycle_tests(): void {
    var g: WorkGraph;
    work_init(&g, 15, 29);
    var first = request(&g, 1);
    var second = request(&g, 2);
    check(work_seal(&g, first));
    check(work_seal(&g, second));
    check(work_demand(&g, first));
    var ticket: WorkTicket;
    check(work_take(&g, &ticket));
    check(work_suspend(&g, &ticket, second));
    check(work_take(&g, &ticket));
    check(work_suspend(&g, &ticket, first));
    check(!work_take(&g, &ticket));
    check(g.running == 0);
    var cycle: vector(usize);
    vector_init(usize, &cycle);
    check(work_cycle(&g, first, &cycle));
    check(cycle.length == 3);
    check(cycle.data[0] == first);
    check(cycle.data[1] == second);
    check(cycle.data[2] == first);
    vector_dispose(usize, &cycle);
    work_dispose(&g);

    work_init(&g, 16, 29);
    first = request(&g, 1);
    check(work_seal(&g, first));
    check(work_demand(&g, first));
    check(work_take(&g, &ticket));
    check(work_suspend(&g, &ticket, first));
    vector_init(usize, &cycle);
    check(work_cycle(&g, first, &cycle));
    check(cycle.length == 2);
    vector_dispose(usize, &cycle);
    work_dispose(&g);
}

fn filtered_tests(): void {
    var graph: WorkGraph;
    work_init(&graph, 17, 29);
    var zero = work_request(&graph, null, 0, 1);
    var other = work_request(&graph, null, 2, 1);
    check(work_seal(&graph, zero));
    check(work_seal(&graph, other));
    check(work_demand(&graph, other));
    check(work_demand(&graph, zero));
    var ticket: WorkTicket;
    check(work_take_query(&graph, &ticket, 0));
    check(ticket.task == zero);
    check(work_finish(&graph, &ticket, true));
    check(!work_take_query(&graph, &ticket, 0));
    check(work_take(&graph, &ticket));
    check(ticket.task == other);
    check(work_finish(&graph, &ticket, true));
    work_dispose(&graph);
}

fn reset_tests(): void {
    var graph: WorkGraph;
    work_init(&graph, 31, 29);
    check(work_find(&graph, null, 1, 1) == 0);
    var first = request(&graph, 1);
    check(work_find(&graph, null, 1, 1) == first);
    check(!work_reset(&graph, 32, 29));
    check(work_seal(&graph, first));
    check(work_demand(&graph, first));
    var old: WorkTicket;
    check(work_take(&graph, &old));
    check(!work_reset(&graph, 32, 29));
    check(work_finish(&graph, &old, true));
    check(!work_reset(&graph, 31, 29));
    check(work_reset(&graph, 32, 29));
    check(work_find(&graph, null, 1, 1) == 0);
    first = request(&graph, 1);
    check(work_seal(&graph, first));
    check(work_demand(&graph, first));
    var current: WorkTicket;
    check(work_take(&graph, &current));
    check(current.task == old.task);
    check(!work_finish(&graph, &old, true));
    check(work_finish(&graph, &current, true));
    work_dispose(&graph);
}

fn selected_tests(): void {
    var graph: WorkGraph;
    work_init(&graph, 41, 29);
    defer work_dispose(&graph);
    var first=request(&graph, 1);
    var second=request(&graph, 2);
    var blocked=request(&graph, 3);
    check(work_access(&graph, first, 1, 1, 0, 1, WorkAccessMode.Write));
    check(work_access(&graph, second, 1, 1, 0, 1, WorkAccessMode.Read));
    check(work_depend(&graph, blocked, first));
    check(work_seal(&graph, first));
    check(work_seal(&graph, second));
    check(work_seal(&graph, blocked));
    check(work_demand(&graph, first));
    check(work_demand(&graph, second));
    check(work_demand(&graph, blocked));
    var selected: WorkTicket;
    var spare: WorkTicket;
    fill(&spare, 0, sizeof(WorkTicket));
    check(!work_take_task(&graph, &spare, 0));
    check(!work_take_task(&graph, &spare, 999));
    check(!work_take_task(&graph, &spare, blocked));
    check(spare.task==0);
    check(work_take_task(&graph, &selected, second));
    check(selected.task==second);
    check(!work_take_task(&graph, &spare, first));
    check(spare.task==0);
    check(work_finish(&graph, &selected, true));
    check(!work_take_task(&graph, &spare, second));
    check(work_take(&graph, &spare));
    check(spare.task==first);
    check(work_finish(&graph, &spare, true));
    check(work_take_task(&graph, &spare, blocked));
    check(work_finish(&graph, &spare, true));
    check(!work_take(&graph, &spare));
    check(graph.running==0 && work_ok(&graph));
}

resume_tests();
diamond_tests();
discovered_access_tests();
failure_tests();
cycle_tests();
filtered_tests();
reset_tests();
selected_tests();
print(failures);
