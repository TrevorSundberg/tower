import syntax_emission_api;
import .compiler.syntax_view;
import .compiler.syntax_emission_types;
import tower;
import syntax_emission_test;
import .compiler.syntax_types;
import .library.vector;

struct EmissionFixture {
    input: SyntaxEmissionInput;
    owner: void*;
    definitions: vector(void*);
    rules: vector(SyntaxRuleView);
    tokens: vector(void*);
    reserved: vector(u8*);
    literals: vector(SyntaxEmissionLiteral);
    random: u32;
    failed: bool;
}

fn emission_test_node(f: EmissionFixture*, node: void*): SyntaxNode* {
    return bits(SyntaxNode*, entity_component_data(entity_component_get(node, f.input.syntax_kind)));
}

fn emission_test_init(f: EmissionFixture*, context: SyntaxEmissionInput*, bedrock: bool): void {
    fill(f, 0, sizeof(EmissionFixture));
    copy(&f.input, context, sizeof(SyntaxEmissionInput));
    f.owner = entity_create_related(context.root);
    f.random = 1162692948;
    if bedrock {
        var document = emission_test_node(f, context.root);
        var index: usize = 0;
        for(; index != document.items.length; index++) {
            var node = document.items.data[index];
            var data = emission_test_node(f, node);
            var rule = data.kind == 1;
            var ok: bool;
            if rule {
                ok = vector_push(void*, &f.definitions, node);
            } else {
                ok = vector_push(void*, &f.tokens, node);
            }
            if !ok {
                f.failed = true;
            }
        }
    }
}

fn emission_test_dispose(f: EmissionFixture*): void {
    entity_release(f.owner);
    vector_dispose(void*, &f.definitions);
    vector_dispose(SyntaxRuleView, &f.rules);
    vector_dispose(void*, &f.tokens);
    vector_dispose(u8*, &f.reserved);
    vector_dispose(SyntaxEmissionLiteral, &f.literals);
}

fn emission_test_new(f: EmissionFixture*, parent: void*, kind: u32): void* {
    var node = entity_create_related(f.owner);
    var data = bits(SyntaxNode*, entity_component_data(entity_component_add(node, f.input.syntax_kind)));
    syntax_node_init(data);
    data.kind = kind;
    var ok = entity_attach(node, parent, null);
    entity_release(node);
    if !ok {
        f.failed = true;
    }
    return node;
}

fn emission_test_rule(f: EmissionFixture*, name: u8*): void* {
    var node = emission_test_new(f, f.owner, 1);
    var data = emission_test_node(f, node);
    var ok = emission_text_set(&data.name, name);
    var index: usize = 0;
    loop {
        if index == f.definitions.length {
            ok = vector_push(void*, &f.definitions, node);
            break;
        }
        var old = emission_test_node(f, f.definitions.data[index]);
        if emission_name_equal(emission_text(&old.name), name) {
            f.definitions.data[index] = node;
            break;
        }
        index++;
    }
    if !ok {
        f.failed = true;
    }
    return node;
}

fn emission_test_sequence(f: EmissionFixture*, rule: void*): void* {
    var node = emission_test_new(f, rule, 4);
    var data = emission_test_node(f, rule);
    if !vector_push(void*, &data.items, node) {
        f.failed = true;
    }
    return node;
}

fn emission_test_term(f: EmissionFixture*, parent: void*, text: u8*, literal: bool, repetition: u8, capture: u8*): void* {
    var node = emission_test_new(f, parent, 5);
    var data = emission_test_node(f, node);
    var ok = emission_text_set(&data.text, text);
    ok &&= emission_text_set(&data.capture, capture);
    data.literal = literal;
    data.repetition = repetition;
    var owner = emission_test_node(f, parent);
    ok &&= vector_push(void*, &owner.items, node);
    if !ok {
        f.failed = true;
    }
    return node;
}

fn emission_test_token(f: EmissionFixture*, name: u8*, skipped: bool, contextual: bool): void {
    var kind: u32 = 2;
    if skipped {
        kind = 3;
    }
    var node = emission_test_new(f, f.owner, kind);
    var data = emission_test_node(f, node);
    var ok = emission_text_set(&data.name, name);
    data.contextual = contextual;
    ok &&= vector_push(void*, &f.tokens, node);
    if !ok {
        f.failed = true;
    }
}

fn emission_test_reserve(f: EmissionFixture*, name: u8*): void {
    if !vector_push(u8*, &f.reserved, name) {
        f.failed = true;
    }
}

fn emission_test_input(f: EmissionFixture*): void {
    f.rules.length = 0;
    var index: usize = 0;
    for(; index != f.definitions.length; index++) {
        var data = emission_test_node(f, f.definitions.data[index]);
        var rule: SyntaxRuleView;
        rule.name = emission_text(&data.name);
        rule.name_length = data.name.length;
        rule.alternatives = data.items.data;
        rule.count = data.items.length;
        if !emission_push(&f.rules, &rule) {
            f.failed = true;
            return;
        }
        var position = index;
        loop {
            if position == 0 {
                break;
            }
            var previous = position -1;
            var left = &f.rules.data[previous];
            var order = emission_compare(left.name, left.name_length, rule.name, rule.name_length);
            if order <= 0 {
                break;
            }
            copy(&f.rules.data[position], left, sizeof(SyntaxRuleView));
            position = previous;
        }
        copy(&f.rules.data[position], &rule, sizeof(SyntaxRuleView));
    }
    f.input.rules = f.rules.data;
    f.input.count = f.rules.length;
    f.input.tokens = f.tokens.data;
    f.input.token_count = f.tokens.length;
    f.input.reserved = f.reserved.data;
    f.input.reserved_count = f.reserved.length;
    f.input.literals = f.literals.data;
    f.input.literal_count = f.literals.length;
}

fn emission_test_random(f: EmissionFixture*, bound: u32): u32 {
    f.random = f.random * 1664525;
    f.random = f.random + 1013904223;
    if bound == 0 {
        return 0;
    }
    var value = f.random / 65536;
    value = value % bound;
    return value;
}

fn emission_test_repeat(f: EmissionFixture*): u8 {
    var n = emission_test_random(f, 4);
    if n == 1 {
        return 42;
    }
    if n == 2 {
        return 43;
    }
    if n == 3 {
        return 63;
    }
    return 0;
}

fn emission_test_one(f: EmissionFixture*, name: u8*, text: u8*, literal: bool): void {
    var rule = emission_test_rule(f, name);
    var sequence = emission_test_sequence(f, rule);
    emission_test_term(f, sequence, text, literal, 0, "");
}

fn emission_test_excluded(f: EmissionFixture*, parent: void*, repetition: u8, capture: u8*): void* {
    var term = emission_test_term(f, parent, "", false, repetition, capture);
    var data = emission_test_node(f, term);
    data.terminal_set = true;
    emission_test_term(f, term, ";", true, 0, "");
    emission_test_term(f, term, "}", true, 0, "");
    return term;
}

export fn syntax_emission_tests(context: SyntaxEmissionInput*): usize {
    return emission_test_suite(context);
}
