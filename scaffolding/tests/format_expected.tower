import tower;
import .compiler.format_types;
import storage_api;
import utility_checks;
import .library.vector;

extern fn printf(format: u8*, index: usize, begin: usize, end: usize, source: usize,
    actual_begin: usize, actual_end: usize, actual_source: usize): i32;

// Frozen exact text and ordered spans, independently checked against unchanged
// native format-seed.cpp from 3167766 (SHA-256 recorded in the project journal).
// Generated names deliberately contain NUL, represented as bytes rather than a
// terminated string. Expected data does not call formatter implementation code.
fn format_fixture_bytes(actual: FormatResult*, text: u8*, length: usize, count: usize): void {
    if actual.text.length != length || !utility_equal(actual.text.data, text, length) {
        puts("Expected formatter text:"); puts(text);
        utility_check(vector_push(&actual.text, 0), "Formatter diagnostic terminator");
        --actual.text.length;
        puts("Actual formatter text:"); puts(actual.text.data);
    }
    utility_check(!actual.failed && actual.text.length == length && utility_equal(actual.text.data, text, length), "Frozen formatter reference text");
    utility_check(actual.spans.length == count, "Frozen formatter reference span count");
}
fn format_fixture_text(actual: FormatResult*, text: u8*, count: usize): void {
    format_fixture_bytes(actual, text, strlen(text), count);
}
fn format_fixture_span(actual: FormatResult*, index: usize, begin: usize, end: usize, source: usize): void {
    var span = &actual.spans.data[index];
    if span.begin != begin || span.end != end || span.source != source {
        printf("Span %llu: wanted (%llu,%llu,%llu), got (%llu,%llu,%llu)\n", index,
            begin, end, source, span.begin, span.end, span.source);
    }
    utility_check(span.begin == begin && span.end == end && span.source == source, "Frozen formatter reference ordered span triple");
}

// Canonical Foundation spells physical representations independently of names.
// Source-format fixtures below retain their frozen spelling and exact spans.
fn format_fixture_canonical(actual: FormatResult*, body: u8*, count: usize): void {
    var prelude = "import foundation_syntax;\n\n/* Signedness is part of the primitive representation contract, not a host*/\n/* promotion rule. Widths are target bits; supported widths are 8, 16, 32 and 64.*/\nvar i8: type = integer_type(8, 1);\n\nvar u8: type = integer_type(8, 0);\n\nvar i16: type = integer_type(16, 1);\n\nvar u16: type = integer_type(16, 0);\n\nvar i32: type = integer_type(32, 1);\n\nvar u32: type = integer_type(32, 0);\n\nvar i64: type = integer_type(64, 1);\n\nvar u64: type = integer_type(64, 0);\n\nvar f32: type = float_type(32);\n\nvar f64: type = float_type(64);\n\nvar bool: type = boolean_type();\n\nvar void: type = empty_type();\n\n/* This representation takes its width from the explicit target description.*/\nvar usize: type = address_type();\n\n";
    var text: vector(u8) = default;
    defer vector_dispose(&text);
    for(var i: usize = 0; i < strlen(prelude); ++i) { utility_check(vector_push(&text, prelude[i]), "Canonical prelude fixture"); }
    for(var i: usize = 0; i < strlen(body); ++i) { utility_check(vector_push(&text, body[i]), "Canonical body fixture"); }
    utility_check(vector_push(&text, 0), "Canonical fixture terminator");
    var StandardTypeBindingCount: usize = 13;
    format_fixture_text(actual, text.data, count + StandardTypeBindingCount);
}
