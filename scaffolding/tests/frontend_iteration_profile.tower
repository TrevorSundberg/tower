import tower;
import frontend_units;
import frontend_units_memory;
import .compiler.grammar_types;
import .compiler.frontend_revision_types;
import .compiler.format_types;
import .library.vector;
import .library.work_budget;
import lr_analysis_comparisons;
import lr_analysis_api;
import lr_analysis_oracle;
import lr_analysis_oracle_types;
import lr_graph_checks;
import .compiler.lr_types;

extern fn compiler_world_grammar(world: void*): CompilerGrammarCache*;
extern fn syntax_version_diagnostic_dispose(value: SyntaxVersionDiagnostic*): void;
extern fn format_entity(result: FormatResult*, node: void*, syntax: void*, foundation: void*, match_kind: void*): void;
extern fn format_dispose(result: FormatResult*): void;
extern fn dprintf(fd: i32, format: u8*, value: usize, phase: u32, count: u32): i32;
struct IterationTime { seconds: i64; nanoseconds: i64; }
extern fn clock_gettime(clock: i32, time: IterationTime*): i32;
extern fn tower_test_buffer_count(): usize;
extern fn tower_test_buffer_allocations(): usize;
extern fn work_thread_available(): bool;
extern fn compiler_world_bind_budget(world: void*, budget: WorkBudget*): bool;
var IterationNanoseconds: u64 = 1000000000;
var IterationMonotonicClock: i32 = 1;
var IterationHashOffset: u64 = 1469598103934665603;
var IterationHashPrime: u64 = 1099511628211;
var IterationLogInterval: usize = 32;
var IterationBudgetBytes: usize = 268435456;
var IterationPhaseCount: usize = convert(usize, GrammarPhase.Count);
struct IterationProfile {
    started: u64[IterationPhaseCount];
    elapsed: u64[IterationPhaseCount];
    calls: usize[IterationPhaseCount];
}

fn iteration_clock(): u64 {
    var now: IterationTime = default;
    units_check(clock_gettime(IterationMonotonicClock, &now) == 0, "Iteration monotonic clock");
    return convert(u64, now.seconds) * IterationNanoseconds + convert(u64, now.nanoseconds);
}

fn iteration_event(context: void*, phase: GrammarPhase, entering: bool, rules: usize, tokens: usize): void {
    var profile = bits(IterationProfile*, context);
    var index = convert(usize, phase);
    if entering {
        profile.started[index] = iteration_clock();
        profile.calls[index]++;
        if phase == GrammarPhase.Build && (profile.calls[index] == 1 || profile.calls[index] % IterationLogInterval == 0) {
            units_check(dprintf(2, "grammar build begin: call=%zu rules=%u tokens=%u\n",
                profile.calls[index], convert(u32, rules), convert(u32, tokens)) >= 0, "Iteration event output");
        }
    } else { profile.elapsed[index] += iteration_clock() - profile.started[index]; }
}

fn iteration_report(profile: IterationProfile*): void {
    for(var index: usize = 0; index < sizeof(decltype(profile.calls)) / sizeof(usize); index++) {
        units_check(dprintf(2, "grammar wall_ns=%zu phase=%u calls=%u\n", convert(usize, profile.elapsed[index]),
            convert(u32, index), convert(u32, profile.calls[index])) >= 0, "Iteration phase output");
    }
}

// Focused caller measurement, using the independent sorted-insertion oracle.
// Only production closure construction is timed; reference checking is outside.
fn frontend_suffix_profile(): void {
    units_check(!work_thread_available(), "Suffix profile uses serial counters");
    var baseline = tower_test_buffer_count();
    var rules: vector(LRProduction) = default;
    var symbols: vector(LRSymbol) = default;
    defer {
        vector_dispose(&rules); vector_dispose(&symbols);
        units_check(tower_test_buffer_count() == baseline, "Suffix profile cleanup");
    }
    var names = lr_suffix_fixture(&rules, &symbols, true);
    var analysis = lr_analysis_create(rules.data, rules.length, symbols.data, symbols.length, names);
    var oracle = oracle_analysis_create(rules.data, rules.length, symbols.data, symbols.length, names);
    units_check(analysis != null && oracle != null && lr_analysis_compute(analysis)
        && oracle_analysis_compute(oracle), "Suffix profile FIRST");
    defer lr_analysis_destroy(analysis); defer oracle_analysis_destroy(oracle);
    var reference = oracle_items_create(); defer oracle_items_destroy(reference);
    var seeds: LRItem[32] = default;
    var count = sizeof(decltype(seeds)) / sizeof(LRItem);
    for(var i: usize = 0; i < count; i++) {
        var lookahead = i == 0 ? LRTokenPropagation : (i == 1 ? LRTokenEnd : convert(u32, 100 + i));
        seeds[i] = {rule: 0, position: 0, first: lookahead, last: lookahead};
        oracle_item_insert(&reference.values, &seeds[i]);
    }
    oracle_items_close(oracle, reference, true);
    var rounds: usize = 2000;
    var elapsed: u64 = 0;
    var allocations = tower_test_buffer_allocations();
    for(var round: usize = 0; round < rounds; round++) {
        var items = lr_items_create(); units_check(items != null, "Suffix profile items");
        defer lr_items_destroy(items);
        for(var i: usize = 0; i < count; i++) {
            units_check(lr_items_insert(items, &seeds[i]), "Suffix profile seed");
        }
        var started = iteration_clock();
        units_check(lr_items_close(analysis, items, true), "Suffix profile closure");
        elapsed += iteration_clock() - started;
        lr_check_items(items, reference);
    }
    units_check(dprintf(2, "suffix closure_ns=%zu rounds=%u items=%u\n", convert(usize, elapsed),
        convert(u32, rounds), convert(u32, reference.values.length)) >= 0
        && dprintf(2, "suffix allocation_calls=%zu\n", tower_test_buffer_allocations() - allocations, 0, 0) >= 0,
        "Suffix profile report");
}

// Isolate the ordinary frontend_compile_sources path from the full suite's
// allocation-failure matrices. Both modes compile the same checked source;
// cold starts at the immutable seed, installed matches the units startup path.
fn frontend_iteration_profile(root: u8*, installed: bool): void {
    // This entry links the existing serial instrumentation transport. Do not use
    // its single-owner allocation counters to profile real worker overlap.
    units_check(!work_thread_available(), "Iteration counters require serial transport");
    var buffers = tower_test_buffer_count();
    var allocations = tower_test_buffer_allocations();
    var bedrock: vector(u8) = default;
    var foundation: vector(u8) = default;
    defer {
        vector_dispose(&bedrock); vector_dispose(&foundation);
        units_check(tower_test_buffer_count() == buffers, "Iteration releases every owned buffer");
    }
    units_read(root, "/bedrock.tower", &bedrock);
    units_read(root, "/foundation.tower", &foundation);
    var budget: WorkBudget = default;
    units_check(work_budget_init(&budget, 1, IterationBudgetBytes, 1), "Iteration explicit ledger");
    var world = compiler_world_create_workers(1);
    units_check(world != null && compiler_world_bind_budget(world, &budget), "Iteration bind before first entity");
    var environment = frontend_modules_create();
    units_check(world != null && environment != null && frontend_modules_bind_world(environment, world), "Iteration explicit owners");
    frontend_modules_configure(environment, "iteration.tower", root);
    var profile: IterationProfile = default;
    compiler_world_grammar(world).observer = {context: bits(void*, &profile), event: iteration_event};
    if installed {
        var diagnostic: SyntaxVersionDiagnostic = default;
        var ok = syntax_baseline_install(world, environment, bedrock.data, false, &diagnostic)
            && syntax_baseline_install(world, environment, foundation.data, true, &diagnostic);
        syntax_version_diagnostic_dispose(&diagnostic);
        units_check(ok, "Iteration installed baseline");
        iteration_report(&profile);
        profile = default;
    }
    var owner = entity_create(compiler_world_store(world));
    var program: SemanticProgram = default;
    semantic_initialize(&program, owner, convert(u32, sizeof(void*)));
    var input = "import tower; fn answer():i32{return 42;}";
    var source: FrontendSource = {data: input, length: strlen(input)};
    frontend_compile_sources(&program, &source, 1, environment);
    iteration_report(&profile);
    if program.error.length != 0 {
        units_check(vector_push(&program.error, 0), "Iteration error terminator");
        program.error.length--;
        puts(program.error.data);
    }
    units_check(program.error.length == 0 && program.resource.error == WorkBudgetError.None, "Iteration compilation");
    units_memory_answer(&program);
    var canonical: FormatResult = default;
    format_entity(&canonical, program.root, null, null, null);
    units_check(!canonical.failed, "Iteration canonical output");
    var hash = IterationHashOffset;
    foreach(var byte in &canonical.text) { hash = (hash ^ convert(u64, byte)) * IterationHashPrime; }
    units_check(dprintf(2, "grammar canonical=%zu bytes=%u\n", convert(usize, hash), convert(u32, canonical.text.length), 0) >= 0, "Iteration canonical report");
    var memory: WorkBudgetSnapshot;
    units_check(work_budget_snapshot(compiler_world_work_budget(world), &memory), "Iteration world budget snapshot");
    units_check(dprintf(2, "grammar ledger_live=%zu\n", memory.used_bytes, 0, 0) >= 0
        && dprintf(2, "grammar ledger_peak=%zu\n", memory.peak_bytes, 0, 0) >= 0
        && dprintf(2, "grammar ledger_metadata=%zu\n", memory.retained, 0, 0) >= 0,
        "Iteration retained byte report");
    units_check(dprintf(2, "grammar allocation_calls=%zu\n", tower_test_buffer_allocations() - allocations, 0, 0) >= 0
        && dprintf(2, "grammar retained_buffers=%zu\n", tower_test_buffer_count() - buffers, 0, 0) >= 0,
        "Iteration allocation report");
    format_dispose(&canonical);
    semantic_program_dispose(&program);
    entity_release(owner);
    frontend_modules_destroy(environment);
    compiler_world_grammar(world).observer = default;
    units_check(frontend_world_clear(world) && compiler_world_dispose(world), "Iteration world cleanup");
    units_check(budget.used_bytes == 0 && budget.live == 0 && work_budget_dispose(&budget), "Iteration ledger cleanup");
}
