import tower;
import .host.memory;
import .host.work_linux;
import .host.work_dispatch;
import .library.work_pool;

extern fn sched_getaffinity(pid: i32, bytes: usize, mask: usize*): i32;
extern fn sched_setaffinity(pid: i32, bytes: usize, mask: usize*): i32;
extern fn __sched_cpucount(bytes: usize, mask: usize*): i32;
extern fn puts(text: u8*): i32;

// glibc cpu_set_t ABI for this real-host fixture; larger masks are exercised
// independently by work_linux_affinity_faults. A larger real host fails clearly.
var AffinitySetBytes: usize = 128;
var AffinitySetWords: usize = AffinitySetBytes / sizeof(usize);
struct AffinityJob {
    mask: usize[AffinitySetWords];
    entered: void*;
    release: void*;
    valid: bool;
}

export fn work_kernel_execute(payload: void*): void {
    var job = bits(AffinityJob*, payload);
    var saved: usize[AffinitySetWords];
    var bytes = sizeof(decltype(saved));
    var captured = sched_getaffinity(0, bytes, &saved[0]) == 0;
    job.valid = captured && sched_setaffinity(0, sizeof(decltype(job.mask)), &job.mask[0]) == 0;
    for (var i: usize = 0; i < 1000; i++) { job.valid &&= work_thread_capacity() == 1; }
    if job.entered != null {
        work_signal_post(job.entered);
        work_signal_wait(job.release);
    }
    if captured {
        var restored = sched_setaffinity(0, bytes, &saved[0]) == 0;
        job.valid &&= restored;
    }
}

export fn main(argc: i32, argv: u8**): i32 {
    var mask: usize[AffinitySetWords];
    var bytes = sizeof(decltype(mask));
    if sched_getaffinity(0, bytes, &mask[0]) != 0 {
        puts("Real-host affinity fixture requires a kernel mask fitting glibc cpu_set_t"); return 1;
    }
    var count = convert(usize, __sched_cpucount(bytes, &mask[0]));
    if count > WorkPoolMaximumCapacity { count = WorkPoolMaximumCapacity; }
    if count == 0 || work_thread_capacity() != count {
        puts("Capacity does not match the calling thread affinity"); return 1;
    }
    var jobs: AffinityJob[2] = default;
    var lanes = sizeof(decltype(jobs)) / sizeof(AffinityJob);
    if lanes > count { lanes = count; }
    var pool: WorkPool = default;
    if !work_pool_open(&pool, lanes) { return 2; }
    defer work_pool_close(&pool);
    var entered = lanes > 1 ? work_signal_open() : null;
    var release = lanes > 1 ? work_signal_open() : null;
    // Always unblock/drain before stack masks, pool or signals can be released.
    defer {
        if lanes > 1 {
            for (var i: usize = 0; i < pool.running; i++) { work_signal_post(release); }
        }
        while pool.running != 0 { work_pool_receive(&pool, true); }
        work_signal_close(entered); work_signal_close(release);
    }
    if lanes > 1 && (entered == null || release == null) { return 2; }
    var selected: usize = 0;
    for (var word: usize = 0; word < bytes / sizeof(usize) && selected < lanes; word++) {
        var bits_left = mask[word];
        while bits_left != 0 && selected < lanes {
            var bit = bits_left & (~bits_left + 1);
            jobs[selected].mask[word] = bit;
            jobs[selected].entered = entered;
            jobs[selected].release = release;
            selected++;
            bits_left &= bits_left - 1;
        }
    }
    if selected != lanes || pool.count != lanes { return 3; }
    for (var i: usize = 0; i < lanes; i++) {
        if !work_pool_submit(&pool, bits(void*, &jobs[i])) { return 3; }
    }
    if lanes > 1 {
        for (var i: usize = 0; i < lanes; i++) { work_signal_wait(entered); }
    }
    var valid = work_thread_capacity() == count;
    if lanes > 1 {
        for (var i: usize = 0; i < pool.running; i++) { work_signal_post(release); }
    }
    while pool.running != 0 { work_pool_receive(&pool, true); }
    for (var i: usize = 0; i < lanes; i++) { valid &&= jobs[i].valid; }
    valid &&= work_thread_capacity() == count;
    if !valid { puts("Per-thread restriction, parent isolation or restoration failed"); return 1; }
    print(count); print(lanes);
    return 0;
}
