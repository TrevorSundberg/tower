import tower;
import lexicon_oracle;
import mt19937;
import utility_checks;
import .compiler.format_types;
import .compiler.syntax_types;
import .compiler.lr_types;
import .compiler.lr_api;
import .library.vector;

extern fn compiler_world_create(): void*;
extern fn compiler_world_dispose(world: void*): bool;
extern fn compiler_world_store(world: void*): void*;
extern fn entity_store_count(store: void*): usize;
extern fn frontend_world_clear(world: void*): bool;
extern fn frontend_world_pattern(world: void*, source: u8*, length: usize, error: FormatResult*): SyntaxPattern*;
extern fn syntax_pattern_release(pattern: SyntaxPattern*): void;
extern fn format_dispose(result: FormatResult*): void;
extern fn entity_view_open(node: void*): void*;
extern fn entity_view_close(view: void*): void;
extern fn lexicon_create(): void*;
extern fn lexicon_destroy(value: void*): void;
extern fn lexicon_token(value: void*, table: LexerTable*, id: u32, style: u8*, skipped: bool, contextual: bool, identifier: bool): bool;
extern fn lexicon_literal(value: void*, text: u8*, length: usize, id: u32, declaration: bool): bool;
extern fn lexicon_start(value: void*, text: u8*, length: usize): bool;
extern fn lexicon_choose(value: void*, source: u8*, length: usize, start: usize, declaration: bool, runtime: void*, state: usize, choice: TestLexiconChoice*): void;
extern fn lexicon_skip(value: void*, source: u8*, length: usize, start: usize, choice: TestLexiconChoice*): void;
extern fn lexicon_identifier(value: void*, source: u8*, length: usize, start: usize): usize;
extern fn lexicon_declaration(value: void*, source: u8*, length: usize, start: usize): bool;
extern fn tower_test_buffer_count(): usize;
extern fn tower_test_buffer_fail_after(count: usize): void;
extern fn strlen(text: u8*): usize;
extern fn strcmp(left: u8*, right: u8*): i32;

var TestIdentifier: u32 = 10;
var TestContextual: u32 = 11;
var TestContextualTrivia: u32 = 13;
var TestFor: u32 = 20;
var TestFn: u32 = 21;
var TestPlus: u32 = 22;
var TestPlusPlus: u32 = 23;
var TestSnow: u32 = 24;

fn lexicon_test_runtime(accepted: u32*, count: usize): void* {
    utility_check(count <= 3, "Lexicon fixture rule capacity");
    var rules: LRProduction[4];
    var symbols: LRSymbol[4];
    fill(&rules[0], 0, sizeof(LRProduction) * 4);
    fill(&symbols[0], 0, sizeof(LRSymbol) * 4);
    rules[0].count = 1;
    symbols[0].nonterminal = 1;
    for (var index: usize = 0; index < count; ++index) {
        var slot = index + 1;
        rules[slot].owner = 1;
        rules[slot].begin = slot;
        rules[slot].count = 1;
        symbols[slot].nonterminal = ~convert(usize, 0);
        symbols[slot].first = accepted[index];
        symbols[slot].last = accepted[index];
    }
    var analysis = lr_analysis_create(&rules[0], count + 1, &symbols[0], count + 1, 2);
    utility_check(analysis is not null && lr_analysis_compute(analysis), "Lexicon fixture LR analysis");
    defer lr_analysis_destroy(analysis);
    var states = lr_states_create(analysis);
    utility_check(states is not null && lr_states_lalr(states, false), "Lexicon fixture LR states");
    defer lr_states_destroy(states);
    var runtime = lr_runtime_create(states);
    utility_check(runtime is not null, "Lexicon fixture LR runtime");
    return runtime;
}

fn lexicon_test_equal(actual: TestLexiconChoice*, reference: TestLexiconChoice*): void {
    utility_check(actual.length == reference.length && actual.id == reference.id
        && actual.skipped == reference.skipped
        && strcmp(actual.style, reference.style) == 0, "Lexicon reference selection and style agreement");
    // The independent oracle keeps its eager LR queries. Filtering impossible
    // source matches may reduce work, but must not change any selected result.
    utility_check(actual.checks <= reference.checks, "Lexicon selection does not add LR queries");
}

fn lexicon_test_input(actual: void*, reference: OracleLexicon*, contexts: void**, source: u8*, length: usize): void {
    for (var start: usize = 0; start <= length + 1; ++start) {
        var left: TestLexiconChoice;
        var right: TestLexiconChoice;
        lexicon_skip(actual, source, length, start, &left);
        oracle_lexicon_skip(reference, source, length, start, &right);
        lexicon_test_equal(&left, &right);
        utility_check(lexicon_identifier(actual, source, length, start)
            == oracle_lexicon_identifier(reference, source, length, start), "Lexicon identifier agreement");
        utility_check(lexicon_declaration(actual, source, length, start)
            == oracle_lexicon_declaration(reference, source, length, start), "Lexicon declaration-boundary agreement");
        for (var context: usize = 0; context < 6; ++context) {
            for (var mode: usize = 0; mode < 2; ++mode) {
                lexicon_choose(actual, source, length, start, mode != 0, contexts[context], 0, &left);
                oracle_lexicon_choose(reference, source, length, start, mode != 0, contexts[context], 0, &right);
                lexicon_test_equal(&left, &right);
            }
        }
    }
}

fn lexicon_test_release(patterns: SyntaxPattern**, views: void**, count: usize): void {
    for (var index: usize = 0; index < count; ++index) {
        entity_view_close(views[index]);
        syntax_pattern_release(patterns[index]);
    }
}

fn lexicon_test_contexts_release(contexts: void**): void {
    for (var index: usize = 1; index < 6; ++index) { lr_runtime_destroy(contexts[index]); }
}

fn lexicon_test_differential(world: void*): void {
    var pattern_text: u8*[6];
    pattern_text[0] = "[a-z_][a-z0-9_]*"; pattern_text[1] = "[a-z]+";
    pattern_text[2] = "[ \\t]+"; pattern_text[3] = "[ \\t]+";
    pattern_text[4] = "[0-9]+"; pattern_text[5] = "雪+";
    var styles: u8*[6];
    styles[0] = "identifier"; styles[1] = "contextual"; styles[2] = "comment";
    styles[3] = "contextual trivia"; styles[4] = "number"; styles[5] = "unicode";
    var patterns: SyntaxPattern*[6];
    var views: void*[6];
    fill(&patterns[0], 0, sizeof(SyntaxPattern*) * 6);
    fill(&views[0], 0, sizeof(void*) * 6);
    defer lexicon_test_release(&patterns[0], &views[0], 6);
    var actual = lexicon_create();
    utility_check(actual is not null, "Lexicon allocation");
    defer lexicon_destroy(actual);
    var reference: OracleLexicon;
    fill(&reference, 0, sizeof(OracleLexicon));
    defer oracle_lexicon_dispose(&reference);
    for (var index: usize = 0; index < 6; ++index) {
        var error: FormatResult;
        fill(&error, 0, sizeof(FormatResult));
        defer format_dispose(&error);
        patterns[index] = frontend_world_pattern(world, pattern_text[index], strlen(pattern_text[index]), &error);
        utility_check(patterns[index] is not null, "Lexicon fixture regex compiles");
        var skipped = index == 2 || index == 3;
        var contextual = index == 1 || index == 3;
        var id = TestIdentifier + convert(u32, index);
        utility_check(lexicon_token(actual, patterns[index].table, id, styles[index], skipped, contextual, index == 0), "Lexicon token registration");
        oracle_lexicon_token(&reference, patterns[index].table, id, styles[index], skipped, contextual, index == 0);
    }
    // Complete world mutations before entering the pinned read phase.
    for (var index: usize = 0; index < 6; ++index) {
        views[index] = entity_view_open(patterns[index].grammar);
        utility_check(views[index] is not null, "Lexicon fixture pins authoritative grammar input");
    }
    var literals: u8*[5];
    literals[0] = "for"; literals[1] = "fn"; literals[2] = "+";
    literals[3] = "++"; literals[4] = "雪";
    for (var index: usize = 0; index < 5; ++index) {
        var length = strlen(literals[index]);
        var id = TestFor + convert(u32, index);
        utility_check(lexicon_literal(actual, literals[index], length, id, index == 0), "Lexicon literal registration");
        oracle_lexicon_literal(&reference, literals[index], length, id, index == 0);
        if index < 2 {
            utility_check(lexicon_start(actual, literals[index], length), "Lexicon declaration registration");
            oracle_lexicon_start(&reference, literals[index], length);
        }
    }
    var contexts: void*[6];
    fill(&contexts[0], 0, sizeof(void*) * 6);
    defer lexicon_test_contexts_release(&contexts[0]);
    var accepted: u32[3];
    accepted[0] = TestIdentifier; contexts[1] = lexicon_test_runtime(&accepted[0], 1);
    accepted[0] = TestContextual; contexts[2] = lexicon_test_runtime(&accepted[0], 1);
    accepted[0] = TestIdentifier; accepted[1] = TestContextual; contexts[3] = lexicon_test_runtime(&accepted[0], 2);
    accepted[0] = TestContextualTrivia; accepted[1] = TestPlus; contexts[4] = lexicon_test_runtime(&accepted[0], 2);
    accepted[0] = TestFn; accepted[1] = TestPlusPlus; accepted[2] = TestSnow; contexts[5] = lexicon_test_runtime(&accepted[0], 3);
    var inputs: u8*[15];
    inputs[0] = ""; inputs[1] = "for"; inputs[2] = "forage"; inputs[3] = "fn";
    inputs[4] = "fn_name"; inputs[5] = "name"; inputs[6] = "name_"; inputs[7] = "123";
    inputs[8] = " "; inputs[9] = "\t  "; inputs[10] = "+"; inputs[11] = "++";
    inputs[12] = "+++"; inputs[13] = "雪"; inputs[14] = "雪雪";
    var nodes = entity_store_count(compiler_world_store(world));
    var buffers = tower_test_buffer_count();
    for (var index: usize = 0; index < 15; ++index) {
        lexicon_test_input(actual, &reference, &contexts[0], inputs[index], strlen(inputs[index]));
    }
    var random: TestRandom;
    test_random_init(&random, 1279613001);
    var alphabet = "forname_ 012+\t雪";
    var alphabet_length = strlen(alphabet);
    var source: u8[16];
    for (var trial: usize = 0; trial < 150; ++trial) {
        var count = convert(usize, test_random(&random) % 16);
        for (var index: usize = 0; index < count; ++index) { source[index] = alphabet[convert(usize, test_random(&random)) % alphabet_length]; }
        lexicon_test_input(actual, &reference, &contexts[0], &source[0], count);
    }
    var choice: TestLexiconChoice;
    lexicon_choose(actual, "forage", 6, 0, false, null, 0, &choice);
    utility_check(choice.id == TestIdentifier && choice.length == 6, "Lexicon longest identifier wins over keyword prefix");
    lexicon_choose(actual, "name", 4, 0, false, contexts[2], 0, &choice);
    utility_check(choice.id == TestContextual, "Lexicon accepted contextual token wins tie");
    lexicon_choose(actual, "name", 4, 0, false, contexts[3], 0, &choice);
    utility_check(choice.id == TestIdentifier, "Lexicon accepted token retains declaration priority");
    lexicon_choose(actual, "for", 3, 0, true, null, 0, &choice);
    utility_check(choice.id == TestFor && strcmp(choice.style, "keyword") == 0, "Lexicon declaration keyword wins tie");
    lexicon_choose(actual, "fn", 2, 0, true, null, 0, &choice);
    utility_check(choice.id == TestIdentifier, "Lexicon ordinary literal needs declaration context");
    lexicon_choose(actual, "fn", 2, 0, true, contexts[5], 0, &choice);
    utility_check(choice.id == TestFn, "Lexicon accepted declaration literal wins tie");
    utility_check(lexicon_declaration(actual, "for", 3, 0) && !lexicon_declaration(actual, "forage", 6, 0), "Lexicon declaration word boundary");
    utility_check(entity_store_count(compiler_world_store(world)) == nodes, "Lexicon selection preserves pinned grammar entities");
    utility_check(tower_test_buffer_count() == buffers, "Lexicon selection allocates no scratch buffers");
}

fn lexicon_test_failures(table: LexerTable*): void {
    tower_test_buffer_fail_after(0);
    var failed = lexicon_create();
    tower_test_buffer_fail_after(~convert(usize, 0));
    utility_check(failed is null, "Lexicon creation allocation failure");
    var value = lexicon_create();
    utility_check(value is not null, "Lexicon failure fixture creation");
    defer lexicon_destroy(value);
    tower_test_buffer_fail_after(0);
    var entry = lexicon_token(value, table, TestIdentifier, "token", false, false, true);
    tower_test_buffer_fail_after(~convert(usize, 0));
    utility_check(!entry, "Lexicon token allocation failure");
    var choice: TestLexiconChoice;
    lexicon_choose(value, "a", 1, 0, false, null, 0, &choice);
    utility_check(choice.length == 0 && choice.id == LRTokenEnd, "Failed token insertion leaves lexicon empty");
    utility_check(lexicon_token(value, table, TestIdentifier, "token", false, false, true), "Lexicon token insertion retry");
    tower_test_buffer_fail_after(0);
    var literal = lexicon_literal(value, "a", 1, TestFor, true);
    tower_test_buffer_fail_after(~convert(usize, 0));
    utility_check(!literal, "Lexicon literal allocation failure");
    lexicon_choose(value, "a", 1, 0, false, null, 0, &choice);
    utility_check(choice.id == TestIdentifier && choice.length == 1, "Failed literal insertion preserves previous token");
    tower_test_buffer_fail_after(0);
    var start = lexicon_start(value, "a", 1);
    tower_test_buffer_fail_after(~convert(usize, 0));
    utility_check(!start && !lexicon_declaration(value, "a", 1, 0), "Failed declaration insertion leaves no partial state");
}

fn lexicon_test_declaration_prefix(): void {
    var value = lexicon_create();
    utility_check(value is not null, "Declaration punctuation fixture");
    defer lexicon_destroy(value);
    utility_check(lexicon_literal(value, "+", 1, TestPlus, true)
        && lexicon_literal(value, "++", 2, TestPlusPlus, true), "Declaration punctuation literals");
    var accepted = TestPlus;
    var runtime = lexicon_test_runtime(&accepted, 1);
    defer lr_runtime_destroy(runtime);
    var choice: TestLexiconChoice = default;
    lexicon_choose(value, "++", 2, 0, true, runtime, 0, &choice);
    utility_check(choice.id == TestPlus && choice.length == 1, "Declaration accepts the shorter punctuation prefix");
    lexicon_choose(value, "++", 2, 0, false, runtime, 0, &choice);
    utility_check(choice.id == TestPlusPlus && choice.length == 2, "Ordinary code retains longest punctuation");
    lexicon_choose(value, "++", 2, 0, true, null, 0, &choice);
    utility_check(choice.id == TestPlusPlus && choice.length == 2, "Preview without parser context retains longest punctuation");
}

fn lexicon_test_matching_queries(): void {
    var value = lexicon_create();
    utility_check(value is not null, "Literal query fixture");
    defer lexicon_destroy(value);
    utility_check(lexicon_literal(value, "for", 3, TestFor, false)
        && lexicon_literal(value, "fn", 2, TestFn, false)
        && lexicon_literal(value, "+", 1, TestPlus, false)
        && lexicon_literal(value, "++", 2, TestPlusPlus, false), "Literal query registration");
    var accepted: u32[2];
    accepted[0] = TestFn; accepted[1] = TestPlus;
    var runtime = lexicon_test_runtime(&accepted[0], 2);
    defer lr_runtime_destroy(runtime);
    var choice: TestLexiconChoice = default;
    lexicon_choose(value, "x", 1, 0, true, runtime, 0, &choice);
    utility_check(choice.length == 0 && choice.id == LRTokenEnd && choice.checks == 0,
        "Unmatched literals require no LR queries");
    lexicon_choose(value, "fn", 2, 0, true, runtime, 0, &choice);
    utility_check(choice.length == 2 && choice.id == TestFn && choice.checks == 1,
        "Matching literal still requires its contextual acceptance");
    lexicon_choose(value, "for", 3, 0, true, runtime, 0, &choice);
    utility_check(choice.length == 0 && choice.id == LRTokenEnd && choice.checks == 1,
        "Matching but unaccepted literal cannot enter declaration grammar");
    lexicon_choose(value, "++", 2, 0, true, runtime, 0, &choice);
    utility_check(choice.length == 1 && choice.id == TestPlus && choice.checks == 3,
        "Accepted short punctuation survives rejected longer match and final acceptance");
    lexicon_choose(value, "++", 2, 0, false, runtime, 0, &choice);
    utility_check(choice.length == 2 && choice.id == TestPlusPlus && choice.checks == 0,
        "Ordinary longest match does not require declaration acceptance");
}

export fn syntax_lexer_tests(): void {
    test_random_check();
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    utility_check(world is not null, "Lexicon compiler world creation");
    {
        var error: FormatResult;
        fill(&error, 0, sizeof(FormatResult));
        defer format_dispose(&error);
        var warm = frontend_world_pattern(world, "a", 1, &error);
        utility_check(warm is not null, "Lexicon initial regex compilation");
        defer syntax_pattern_release(warm);
        var nodes = entity_store_count(compiler_world_store(world));
        var buffers = tower_test_buffer_count();
        lexicon_test_differential(world);
        lexicon_test_declaration_prefix();
        lexicon_test_matching_queries();
        lexicon_test_failures(warm.table);
        utility_check(entity_store_count(compiler_world_store(world)) == nodes, "Lexicon fixtures release grammar references and pins");
        utility_check(tower_test_buffer_count() == buffers, "Lexicon fixtures release all temporary tables and buffers");
    }
    utility_check(frontend_world_clear(world), "Lexicon world reader cache release");
    utility_check(compiler_world_dispose(world), "Lexicon explicit world disposal");
    utility_check(tower_test_buffer_count() == baseline, "Lexicon world restores allocation baseline");
    puts("Tower contextual lexer: 165 inputs, all byte offsets, six parser contexts, declaration modes and allocation failures passed.");
}
