import tower;
import syntax_lexer_test;
import mt19937;
import utility_checks;

export fn syntax_lexer_tests(): void {
    test_random_check();
    var fixture = lexicon_test_open();
    lexicon_test_differential(fixture.world);
    lexicon_test_declaration_prefix();
    lexicon_test_matching_queries();
    lexicon_test_failures(fixture.warm.table);
    lexicon_test_close(&fixture);
    puts("Tower contextual lexer: 165 inputs, all byte offsets, six parser contexts, declaration modes and allocation failures passed.");
}
