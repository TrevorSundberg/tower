extern fn compiler_world_create_workers(limit: usize): void*;
extern fn compiler_world_create_result(limit: usize, budget: WorkBudget*, world: void**): WorkBudgetError;
extern fn compiler_world_bind_budget(world: void*, budget: WorkBudget*): bool;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_component(world: void*, node: void*, kind: u32): void*;
extern fn entity_store_count(store: void*): usize;
extern fn parser_stream_utf8_null_terminated_create(text: u8*): void*;
extern fn parser_stream_destroy(stream: void*): void;
extern fn parser_recognizer_create(table: ParserHostTable*, stream: void*): void*;
extern fn parser_recognizer_destroy(request: void*): void;
extern fn parser_recognizer_step(request: void*, running: bool*): void*;
extern fn parser_recognizer_resource_error(request: void*): WorkBudgetError;
extern fn compiler_buffer_allocation_size(bytes: usize): usize;
extern fn strcmp(left: u8*, right: u8*): i32;
extern fn lr_completion_create(parser: void*): void*;
extern fn lr_completion_create_result(parser: void*, error: WorkBudgetError*): void*;
extern fn lr_completion_resource_error(completion: void*): WorkBudgetError;
extern fn lr_completion_destroy(completion: void*): void;
extern fn lr_completion_accepts(completion: void*, id: u32): bool;
extern fn syntax_session_resource_error(session: void*): WorkBudgetError;
extern fn syntax_completion_enable(session: void*): void;
extern fn syntax_completion_accepts(session: void*, text: u8*, literal: bool): bool;
extern fn syntax_format_into(session: void*, result: FormatResult*, error: u8**): bool;
extern fn parser_table_open_result(root: void*, kinds: FrontendKinds*, userdata: void*, presentation: ParserPresentation,
    mode: u32, error: WorkBudgetError*): ParserHostTable*;

fn parser_control_occupy(budget: WorkBudget*, available: usize, reservation: WorkReservation*): void {
    var snapshot: WorkBudgetSnapshot = default;
    utility_check(work_budget_snapshot(budget, &snapshot)
        && snapshot.bytes - snapshot.used_bytes >= available,
        "Parser control remaining physical capacity");
    utility_check(work_budget_reserve_result(budget, 0, 0,
        snapshot.bytes - snapshot.used_bytes - available, reservation) == WorkBudgetError.None,
        "Reserve competing parser control bytes");
}

// The table and request already exist. Deny the first real match-component page
// in a shift or empty reduction, then retry after releasing the competing grant.
fn parser_tree_budget_trial(shape: TableOwnerFixture, specialize: bool): void {
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    utility_check(work_budget_init(&budget, 1, ~convert(usize, 0), 1), "Tree page ledger");
    var world: void* = null;
    utility_check(compiler_world_create_result(1, &budget, &world) == WorkBudgetError.None,
        "Tree world binds its ledger before entity storage");
    var kinds: FrontendKinds = default;
    utility_check(frontend_world_test_kinds(world, &kinds), "Tree page component kinds");
    var root = table_owner_grammar(&kinds, shape);
    var table = parser_table_open(root, &kinds, null, ParserPresentation.Numeric, 0);
    utility_check(table != null && parser_table_build(table, specialize), "Tree page frozen table");
    var input: u8* = shape == TableOwnerFixture.Sequence ? "ab" : "x";
    var control = lr_parser_create(table.runtime, false, specialize);
    utility_check(control != null, "Tree page control reference");
    var first: LRStep = default;
    var action = shape == TableOwnerFixture.Sequence ? (specialize ? LRSequenceShift : LRShift) : LRReduce;
    utility_check(lr_parser_step(control, true, convert(u32, input[0]), false, 0, 1, &first) == action,
        "Tree page denial targets the intended shift or empty reduction");
    lr_parser_destroy(control);
    var stream = parser_stream_utf8_null_terminated_create(input);
    var request = parser_recognizer_create(table, stream);
    utility_check(stream != null && request != null, "Tree page request exists before denial");
    var before: WorkBudgetSnapshot = default;
    utility_check(work_budget_snapshot(&budget, &before), "Tree page initial ownership");
    var entities = entity_store_count(compiler_world_store(world));
    var occupied: WorkReservation = default;
    parser_control_occupy(&budget, 0, &occupied);
    var running = false;
    var result = parser_recognizer_step(request, &running);
    utility_check(result == null && !running
        && parser_recognizer_resource_error(request) == WorkBudgetError.Capacity,
        "Tree component-page denial preserves Capacity through the recognizer");
    var failed: WorkBudgetSnapshot = default;
    utility_check(work_budget_snapshot(&budget, &failed)
        && failed.used_bytes == before.used_bytes + occupied.bytes
        && failed.live == before.live + 1 && failed.used_lanes == before.used_lanes
        && entity_store_count(compiler_world_store(world)) == entities,
        "Denied tree page releases its unpublished node and retains prior owners");
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None,
        "Release tree page blocker");
    parser_recognizer_destroy(request);
    parser_stream_destroy(stream);
    stream = parser_stream_utf8_null_terminated_create(input);
    request = parser_recognizer_create(table, stream);
    utility_check(stream != null && request != null, "Tree page request retries");
    running = true;
    while running { result = parser_recognizer_step(request, &running); }
    utility_check(result != null && parser_recognizer_resource_error(request) == WorkBudgetError.None,
        "The unchanged tree input succeeds when capacity returns");
    var data = bits(ParserMatchData*, compiler_world_component(world, result, CompilerParserMatch));
    utility_check(data != null && data.start == 0 && data.length == strlen(input),
        "Tree retry preserves the complete counted source span");
    entity_release(result);
    parser_recognizer_destroy(request);
    parser_stream_destroy(stream);
    parser_table_destroy(table);
    entity_release(root);
    utility_check(compiler_world_dispose(world) && work_budget_dispose(&budget),
        "Tree page ledger outlives all parser and world owners");
    utility_check(tower_test_buffer_count() == buffers, "Tree denial and retry release every buffer");
}

fn parser_control_budget_trial(specialize: bool): void {
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    utility_check(work_budget_init(&budget, 1, ~convert(usize, 0), 1), "Parser control ledger");
    var world = compiler_world_create_workers(1);
    utility_check(world != null && compiler_world_bind_budget(world, &budget), "Parser control budget owner");
    var kinds: FrontendKinds = default;
    utility_check(frontend_world_test_kinds(world, &kinds), "Parser control world kinds");
    var input: u8* = "parser_memory_budget";
    var builder: GrammarBuilder = default;
    grammar_builder_init(&builder, &kinds);
    var rule = grammar_builder_rule(&builder, "Root", false);
    grammar_builder_literal(&builder, rule, input);
    var root = grammar_builder_finish(&builder);
    var table = parser_table_open(root, &kinds, null, ParserPresentation.Numeric, 0);
    utility_check(table != null && parser_table_build(table, specialize), "Parser control frozen table");
    var before: WorkBudgetSnapshot = default;
    utility_check(work_budget_snapshot(&budget, &before), "Parser control initial owners");
    var occupied: WorkReservation = default;
    parser_control_occupy(&budget, 0, &occupied);
    utility_check(lr_parser_create(table.runtime, false, specialize) == null,
        "LR control creation obeys its runtime world's physical capacity");
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release control blocker");
    var parser = lr_parser_create(table.runtime, false, specialize);
    var opened: WorkBudgetSnapshot = default;
    utility_check(parser != null && work_budget_snapshot(&budget, &opened)
        && opened.used_bytes > before.used_bytes, "LR control object and initial frames stay charged");
    var retained = opened.used_bytes - before.used_bytes;
    lr_parser_destroy(parser);
    parser_control_occupy(&budget, retained - 1, &occupied);
    utility_check(lr_parser_create(table.runtime, false, specialize) == null,
        "Partial LR control creation retires its object when initial frames are denied");
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release partial control blocker");
    parser = lr_parser_create(table.runtime, false, specialize);
    utility_check(parser != null && work_budget_snapshot(&budget, &opened)
        && opened.used_bytes == before.used_bytes + retained, "LR control retry has no leaked partial owner");

    var quota: LRProbeBudget = {remaining: ~convert(usize, 0), complete: true, ..default};
    var probe = lr_probe_create(parser, &quota);
    var probed: WorkBudgetSnapshot = default;
    utility_check(probe != null && work_budget_snapshot(&budget, &probed)
        && probed.used_bytes > opened.used_bytes, "Probe snapshot owns charged object and frames");
    parser_control_occupy(&budget, 0, &occupied);
    utility_check(lr_probe_clone(probe) == null && !quota.complete && quota.resource_error == WorkBudgetError.Capacity,
        "Denied probe clone reports incomplete without modifying its source");
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release probe clone blocker");
    quota.complete = true;
    quota.resource_error = WorkBudgetError.None;
    var clone = lr_probe_clone(probe);
    utility_check(clone != null && lr_probe_count(clone) == lr_probe_count(probe), "Probe clone retries after denial");
    lr_probe_destroy(clone);
    var denied = false;
    for(var index: usize = 0; input[index] != 0; index++) {
        parser_control_occupy(&budget, 0, &occupied);
        var count = lr_probe_count(probe);
        var state: usize = 0;
        var status = lr_probe_step(probe, convert(u32, input[index]), &state);
        if status == 0 {
            utility_check(!quota.complete && quota.resource_error == WorkBudgetError.Capacity && lr_probe_count(probe) == count,
                "Denied probe frame growth preserves the prior stack and reports incomplete");
            denied = true;
        }
        utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release probe growth blocker");
        if status == 0 {
            quota.complete = true;
            quota.resource_error = WorkBudgetError.None;
            status = lr_probe_step(probe, convert(u32, input[index]), &state);
        }
        utility_check(status == LRShift && lr_parser_frame_count(parser) == 1 && lr_parser_consumed(parser) == 0,
            "Probe growth retry never changes real parser state");
    }
    utility_check(denied, "Probe fixture reaches a physical growth boundary");
    lr_probe_destroy(probe);

    parser_control_occupy(&budget, 0, &occupied);
    var completion_error = WorkBudgetError.None;
    utility_check(lr_completion_create_result(parser, &completion_error) == null && completion_error == WorkBudgetError.Capacity,
        "Completion owner denies with its typed result before publication");
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release completion blocker");
    var completion = lr_completion_create(parser);
    utility_check(completion != null, "Completion owner retries after denial");
    parser_control_occupy(&budget, 0, &occupied);
    utility_check(!lr_completion_accepts(completion, convert(u32, input[0]))
        && lr_completion_resource_error(completion) == WorkBudgetError.Capacity,
        "Completion preserves a denied probe result separately from an absent offer");
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release completion query blocker");
    utility_check(lr_completion_accepts(completion, convert(u32, input[0]))
        && lr_completion_resource_error(completion) == WorkBudgetError.None,
        "Completion query retries with available memory");
    lr_completion_destroy(completion);

    denied = false;
    var length: usize = 0;
    for(; input[length] != 0; length++) {
        var step: LRStep = default;
        var status = lr_parser_step(parser, true, convert(u32, input[length]), false, length, 1, &step);
        utility_check(status == (specialize ? LRSequenceShift : LRShift), "Control fixture follows its actual LR path");
        parser_control_occupy(&budget, 0, &occupied);
        var count = lr_parser_frame_count(parser);
        var committed = lr_parser_commit(parser, &step, ~convert(usize, 0), ~convert(usize, 0));
        if !committed {
            utility_check(lr_parser_frame_count(parser) == count && lr_parser_consumed(parser) == length,
                "Denied frame or evidence growth preserves real control state");
            denied = true;
        }
        utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release control growth blocker");
        if !committed { committed = lr_parser_commit(parser, &step, ~convert(usize, 0), ~convert(usize, 0)); }
        utility_check(committed, "Real parser retries the same uncommitted shift after capacity returns");
    }
    utility_check(denied && lr_parser_consumed(parser) == length, "Both control paths reach growth and preserve source extent");
    lr_parser_destroy(parser);
    var released: WorkBudgetSnapshot = default;
    utility_check(work_budget_snapshot(&budget, &released) && released.used_bytes == before.used_bytes
        && released.live == before.live, "All control, probe and completion owners retire exactly");
    parser_table_destroy(table);
    entity_release(root);
    utility_check(compiler_world_dispose(world) && work_budget_dispose(&budget), "Control budget outlives runtime and world");
    utility_check(tower_test_buffer_count() == buffers, "Control denial and retry retain no physical buffers");
}

fn parser_completion_ready(session: void*): void {
    loop {
        var root = syntax_next(session);
        if root is null { break; }
        entity_release(root);
    }
    utility_check(syntax_get_error(session)[0] == 0
        && syntax_session_resource_error(session) == WorkBudgetError.None
        && syntax_completion_accepts(session, "hello", true),
        "Completion has a known valid offer after parsing its imported grammar");
}

fn parser_session_diagnostic_failure(session: void*): void {
    var world = compiler_world_create_workers(1);
    var environment = frontend_modules_create();
    utility_check(world is not null && environment is not null, "Diagnostic failure foreign owner");
    var module = frontend_module_root_world(world, "", environment);
    utility_check(module is not null, "Diagnostic failure foreign module");
    tower_test_buffer_fail_after(0);
    syntax_reset(session, "", module);
    tower_test_buffer_fail_after(frontend_world_unlimited());
    utility_check(syntax_session_resource_error(session) == WorkBudgetError.Memory
        && syntax_get_error(session)[0] != 0 && syntax_next(session) is null,
        "Denied diagnostic copy retains a fixed resource failure without aborting");
    var formatted: FormatResult = default;
    var error: u8* = null;
    utility_check(!syntax_format_into(session, &formatted, &error) && error is not null
        && error[0] != 0 && formatted.text.length == 0,
        "Failed session cannot publish canonical source without error text storage");
    format_dispose(&formatted);
    frontend_module_destroy(module);
    frontend_modules_destroy(environment);
    utility_check(frontend_world_clear(world) && compiler_world_dispose(world), "Diagnostic fixture owners retire");
}

fn parser_session_completion_budget_test(): void {
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    utility_check(work_budget_init(&budget, 1, ~convert(usize, 0), 1), "Completion session ledger");
    var world = compiler_world_create_workers(1);
    utility_check(world != null && compiler_world_bind_budget(world, &budget), "Completion session world");
    var environment = frontend_modules_create();
    utility_check(environment != null, "Completion session environment");
    world_session_prepare(world, environment);
    var source: u8* = "import shared; ";
    var module = frontend_module_root_world(world, source, environment);
    utility_check(module != null, "Completion session module");
    var session = frontend_module_session(module);
    utility_check(session != null, "Completion session owner");
    syntax_completion_enable(session);
    parser_completion_ready(session);
    parser_session_diagnostic_failure(session);
    syntax_reset(session, source, module);
    parser_completion_ready(session);
    var occupied: WorkReservation = default;
    parser_control_occupy(&budget, 0, &occupied);
    utility_check(!syntax_completion_accepts(session, "hello", true)
        && syntax_session_resource_error(session) == WorkBudgetError.Capacity,
        "Mid-completion byte denial reaches the typed session channel");
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release completion query denial");
    utility_check(!syntax_completion_accepts(session, "hello", true)
        && syntax_session_resource_error(session) == WorkBudgetError.Capacity,
        "Completion keeps its first resource failure until session reset");
    syntax_reset(session, source, module);
    parser_completion_ready(session);
    utility_check(!syntax_completion_accepts(session, "not_a_declared_literal", true)
        && syntax_session_resource_error(session) == WorkBudgetError.None,
        "A missing completion offer is not a resource failure");
    syntax_reset(session, source, module);
    var root = syntax_next(session);
    utility_check(root != null, "Prepare imported grammar before completion snapshot denial");
    entity_release(root);
    parser_control_occupy(&budget, 0, &occupied);
    utility_check(syntax_next(session) == null
        && syntax_session_resource_error(session) == WorkBudgetError.Capacity,
        "End-of-input completion snapshot denial preserves its typed result");
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release completion snapshot denial");
    syntax_reset(session, source, module);
    parser_completion_ready(session);
    frontend_module_destroy(module);
    frontend_modules_destroy(environment);
    utility_check(frontend_world_clear(world) && compiler_world_dispose(world) && work_budget_dispose(&budget),
        "Completion sessions retire before their ledger");
    utility_check(tower_test_buffer_count() == buffers, "Completion query and snapshot denial retain no owners");
}

fn parser_session_budget_trial(prepare: bool): void {
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    utility_check(work_budget_init(&budget, 1, ~convert(usize, 0), 1), "Syntax control budget");
    var world = compiler_world_create_workers(1);
    utility_check(world != null && compiler_world_bind_budget(world, &budget), "Syntax control world");
    var environment = frontend_modules_create();
    utility_check(environment != null, "Syntax control environment");
    world_session_prepare(world, environment);
    var source: u8* = "import shared; hello";
    var module = frontend_module_root_world(world, source, environment);
    utility_check(module != null, "Syntax control module");
    var session: void* = null;
    if prepare {
        session = frontend_module_session(module);
        utility_check(session != null && syntax_get_error(session)[0] == 0, "Prepare session before denying control bytes");
    }
    var occupied: WorkReservation = default;
    parser_control_occupy(&budget, 0, &occupied);
    if !prepare { session = frontend_module_session(module); }
    utility_check(session != null, "Session keeps its diagnostic owner after grammar denial");
    utility_check(syntax_next(session) == null && syntax_session_resource_error(session) == WorkBudgetError.Capacity
        && syntax_get_error(session)[0] != 0,
        "Syntax session preserves typed grammar or control denial without an absent recognizer access");
    if prepare {
        utility_check(strcmp(syntax_get_error(session), "Unable to allocate parser control within its memory budget") == 0,
            "Control denial retains its concrete diagnostic");
    }
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None, "Release syntax control blocker");
    syntax_reset(session, source, module);
    var node = syntax_next(session);
    if node == null { puts(syntax_get_error(session)); }
    utility_check(node != null && syntax_get_error(session)[0] == 0
        && syntax_session_resource_error(session) == WorkBudgetError.None, "Syntax session retries after memory capacity returns");
    entity_release(node);
    syntax_reset(session, "import ;", module);
    utility_check(syntax_next(session) == null && syntax_get_error(session)[0] != 0
        && syntax_session_resource_error(session) == WorkBudgetError.None,
        "Ordinary incomplete syntax remains distinct from a resource failure");
    frontend_module_destroy(module);
    frontend_modules_destroy(environment);
    utility_check(frontend_world_clear(world) && compiler_world_dispose(world) && work_budget_dispose(&budget),
        "Syntax session and retained tables retire before their ledger");
    utility_check(tower_test_buffer_count() == buffers, "Syntax session control denial releases physical owners");
}

// The direct table/context owners are only part of parser memory. Keep their
// exact receipts separate from any other world/LR buffers sharing this ledger.
fn parser_table_direct_bytes(table: ParserHostTable*): usize {
    var bytes = table.storage.reservation.bytes + table.states.reservation.bytes;
    foreach(var &state in &table.states) { bytes += state.contexts.reservation.bytes; }
    return bytes;
}

fn parser_table_budget_trial(shape: TableOwnerFixture): void {
    var buffers = tower_test_buffer_count();
    var budget: WorkBudget = default;
    utility_check(work_budget_init(&budget, 1, ~convert(usize, 0), 1), "Parser table memory ledger");
    var world = compiler_world_create_workers(1);
    utility_check(world != null && compiler_world_bind_budget(world, &budget), "Parser table explicit world budget");
    var kinds: FrontendKinds = default;
    utility_check(frontend_world_test_kinds(world, &kinds), "Parser table world-owned kinds");
    var root = table_owner_grammar(&kinds, shape);
    var before: WorkBudgetSnapshot = default;
    utility_check(work_budget_snapshot(&budget, &before), "Parser table initial memory snapshot");

    var occupied: WorkReservation = default;
    utility_check(work_budget_reserve_result(&budget, 0, 0, before.bytes - before.used_bytes, &occupied)
        == WorkBudgetError.None, "Occupy remaining parser memory without worker lanes");
    var error = WorkBudgetError.None;
    var table = parser_table_open_result(root, &kinds, null, ParserPresentation.Numeric, 0, &error);
    utility_check(table == null && error == WorkBudgetError.Capacity,
        "Parser table denies allocation with its exact typed capacity result before publishing an owner");
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None,
        "Release competing parser memory reservation");

    var table_bytes = compiler_buffer_allocation_size(sizeof(ParserHostTable));
    utility_check(work_budget_reserve_result(&budget, 0, 0,
        before.bytes - before.used_bytes - table_bytes, &occupied) == WorkBudgetError.None,
        "Permit the table descriptor while denying its grammar storage");
    table = parser_table_open(root, &kinds, null, ParserPresentation.Numeric, 0);
    utility_check(table != null && table.grammar == null && table.error != null && table.resource_error == WorkBudgetError.Capacity,
        "Grammar allocation obeys the table world's remaining byte capacity");
    parser_table_destroy(table);
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None,
        "Denied grammar construction releases its partial table owner");

    table = parser_table_open(root, &kinds, null, ParserPresentation.Numeric, 0);
    utility_check(table != null && table.budget == &budget
        && table.storage.reservation.bytes == compiler_buffer_allocation_size(sizeof(ParserHostTable)),
        "Parser table charges its actual physical object and allocator header");
    var opened: WorkBudgetSnapshot = default;
    utility_check(work_budget_snapshot(&budget, &opened), "Parser table retained object snapshot");
    var open_bytes = opened.used_bytes - before.used_bytes;
    parser_table_destroy(table);
    utility_check(open_bytes > table_bytes && work_budget_reserve_result(&budget, 0, 0,
        before.bytes - before.used_bytes - (open_bytes - 1), &occupied) == WorkBudgetError.None,
        "Deny one byte below the observed retained grammar and table storage");
    table = parser_table_open(root, &kinds, null, ParserPresentation.Numeric, 0);
    utility_check(table != null && table.grammar == null && table.error != null && table.resource_error == WorkBudgetError.Capacity,
        "Partial grammar construction publishes no incomplete grammar");
    parser_table_destroy(table);
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None,
        "Release grammar retention blocker");
    var grammar_failed: WorkBudgetSnapshot = default;
    utility_check(work_budget_snapshot(&budget, &grammar_failed)
        && grammar_failed.used_bytes == before.used_bytes && grammar_failed.live == before.live,
        "Denied grammar object and child buffers retire before retry");
    table = parser_table_open(root, &kinds, null, ParserPresentation.Numeric, 0);
    utility_check(table != null && table.grammar != null && table.error == null
        && work_budget_snapshot(&budget, &opened), "Grammar construction retries after capacity returns");
    utility_check(work_budget_reserve_result(&budget, 0, 0, opened.bytes - opened.used_bytes, &occupied)
        == WorkBudgetError.None, "Deny parser table construction growth");
    utility_check(!parser_table_build(table, false) && table.error != null
        && table.runtime == null && table.states.data == null && table.resource_error == WorkBudgetError.Capacity,
        "Denied parser growth retains grammar and retires partial runtime/context owners");
    var failed: WorkBudgetSnapshot = default;
    utility_check(work_budget_snapshot(&budget, &failed)
        && failed.used_bytes == opened.used_bytes + occupied.bytes,
        "Failed parser construction leaves only original and competing byte owners");
    utility_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None,
        "Release parser growth blocker");

    utility_check(parser_table_build(table, false), "Parser table retries after byte capacity becomes available");
    var retained: WorkBudgetSnapshot = default;
    utility_check(work_budget_snapshot(&budget, &retained)
        && retained.used_bytes > opened.used_bytes && retained.used_lanes == before.used_lanes
        && retained.used_bytes - before.used_bytes >= parser_table_direct_bytes(table),
        "Table and context buffers remain charged after construction returns");
    var states = table.states.data;
    utility_check(parser_table_build(table, false) && table.states.data == states,
        "Already built parser table preserves retained storage");
    var reused: WorkBudgetSnapshot = default;
    utility_check(work_budget_snapshot(&budget, &reused) && reused.used_bytes == retained.used_bytes
        && reused.live == retained.live, "Parser table reuse does not acquire duplicate byte owners");
    parser_table_destroy(table);
    utility_check(work_budget_snapshot(&budget, &reused) && reused.used_bytes == before.used_bytes
        && reused.live == before.live, "Parser table retirement returns every retained byte grant");
    entity_release(root);
    utility_check(compiler_world_dispose(world), "Parser table budget world teardown");
    utility_check(work_budget_snapshot(&budget, &reused) && reused.used_bytes == 0 && reused.live == 0
        && work_budget_dispose(&budget), "Parser table ledger outlives and releases all physical owners");
    utility_check(tower_test_buffer_count() == buffers, "Parser table budget checks retain no allocator buffers");
}

fn parser_table_budget_tests(): void {
    parser_tree_budget_trial(TableOwnerFixture.Sequence, false);
    parser_tree_budget_trial(TableOwnerFixture.Sequence, true);
    parser_tree_budget_trial(TableOwnerFixture.EmptyClosure, false);
    parser_table_budget_trial(TableOwnerFixture.Sequence);
    parser_table_budget_trial(TableOwnerFixture.Closure);
    parser_control_budget_trial(false);
    parser_control_budget_trial(true);
    parser_session_budget_trial(false);
    parser_session_budget_trial(true);
    parser_session_completion_budget_test();
}
