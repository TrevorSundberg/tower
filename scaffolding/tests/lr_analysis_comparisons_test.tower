import library.testing;
import lr_control_checks_test;
import lr_graph_checks_test;
import lr_analysis_fixtures;
import lr_analysis_oracle_types;
import .library.vector;
import .compiler.lr_types;
import mt19937;

extern fn tower_test_buffer_count(): usize;

fn lr_prediction_and_shift_order(current_contract: bool): void {
    var baseline = tower_test_buffer_count();
    lr_shift_equal_order_case();
    // Multiple prediction inputs share alternatives, including a recursive
    // representative and a nullable sibling. The initial start production's
    // independent EOF/construct seed must not leak into its other alternatives.
    // The eager LR(1) oracle has no prediction groups and compares every action.
    for(var nullable: usize = 0; nullable < 2; nullable++) {
        var rules: vector(LRProduction) = default; defer vector_dispose(&rules);
        var symbols: vector(LRSymbol) = default; defer vector_dispose(&symbols);
        lr_fixture_rule(&rules, 0, symbols.length, 1); lr_fixture_symbol(&symbols, 1, 0, 0);
        lr_fixture_rule(&rules, 0, symbols.length, 1); lr_fixture_symbol(&symbols, oracle_none(), 41, 41);
        lr_fixture_rule(&rules, 0, symbols.length, 2);
        lr_fixture_symbol(&symbols, 1, 0, 0); lr_fixture_symbol(&symbols, oracle_none(), 47, 47);
        lr_fixture_rule(&rules, 1, symbols.length, 2);
        lr_fixture_symbol(&symbols, 0, 0, 0); lr_fixture_symbol(&symbols, oracle_none(), 43, 43);
        lr_fixture_rule(&rules, 1, symbols.length, nullable != 0 ? 0 : 1);
        if nullable == 0 { lr_fixture_symbol(&symbols, oracle_none(), 37, 37); }
        lr_check_graph(&rules, &symbols, 2, current_contract);
    }
    assert(tower_test_buffer_count() == baseline, "Prediction groups and independent start seed cleanup");
}

fn lr_shift_grouping(current_contract: bool): void {
    var baseline = tower_test_buffer_count();
    // Small scans, indexed mixed-symbol fan-out, and overlapping-range fallback
    // must match the eager oracle, including reversed nonterminal order.
    for(var mode: usize = 0; mode < 3; mode++) {
        var rules: vector(LRProduction) = default; defer vector_dispose(&rules);
        var symbols: vector(LRSymbol) = default; defer vector_dispose(&symbols);
        var branches: usize = mode == 0 ? 3 : 8;
        lr_fixture_rule(&rules, 0, 0, 1); lr_fixture_symbol(&symbols, 1, 0, 0);
        for(var branch: usize = 0; branch < branches; branch++) {
            lr_fixture_rule(&rules, 1, symbols.length, 2);
            lr_fixture_symbol(&symbols, branch + 2, 0, 0);
            lr_fixture_symbol(&symbols, 1, 0, 0);
            lr_fixture_rule(&rules, branch + 2, symbols.length, 1);
            var first = convert(u32, branch * 4 + 32);
            lr_fixture_symbol(&symbols, oracle_none(), first, mode == 2 && branch == 0 ? 64 : first + 2);
        }
        lr_fixture_rule(&rules, 1, symbols.length, 0);
        lr_fixture_rule(&rules, 1, rules.data[1].begin, rules.data[1].count);
        lr_check_graph(&rules, &symbols, branches + 2, current_contract);
    }
    assert(tower_test_buffer_count() == baseline, "Shift grouping and range fallback release private indexes");
}

fn lr_lookahead_and_suffixes(current_contract: bool): void {
    var baseline = tower_test_buffer_count();
    // B has empty, nonnullable FIRST in the first variant. A's dot-zero item
    // exists in LR(0), but must not introduce C's spontaneous lookahead until
    // a kernel closure actually reaches it. The second variant opens that
    // path; the third makes B nullable. Keep aliases as shared symbol spans.
    for(var mode: usize = 0; mode < 3; mode++) {
        var rules: vector(LRProduction) = default; defer vector_dispose(&rules);
        var symbols: vector(LRSymbol) = default; defer vector_dispose(&symbols);
        lr_fixture_rule(&rules, 0, symbols.length, 2);
        lr_fixture_symbol(&symbols, 1, 0, 0); lr_fixture_symbol(&symbols, 2, 0, 0);
        lr_fixture_rule(&rules, 1, symbols.length, 2);
        lr_fixture_symbol(&symbols, 3, 0, 0); lr_fixture_symbol(&symbols, oracle_none(), 41, 41);
        lr_fixture_rule(&rules, 2, symbols.length, 1); lr_fixture_symbol(&symbols, 2, 0, 0);
        if mode != 0 {
            lr_fixture_rule(&rules, 2, symbols.length, mode == 1 ? 1 : 0);
            if mode == 1 { lr_fixture_symbol(&symbols, oracle_none(), 43, 43); }
        }
        lr_fixture_rule(&rules, 3, symbols.length, 1); lr_fixture_symbol(&symbols, oracle_none(), 37, 37);
        lr_fixture_rule(&rules, 3, symbols.length, 0);
        lr_fixture_rule(&rules, 1, rules.data[1].begin, rules.data[1].count);
        var names: usize = 0;
        foreach(var &rule in &rules) { if rule.owner >= names { names = rule.owner + 1; } }
        lr_check_graph(&rules, &symbols, names, current_contract);
    }
    assert(tower_test_buffer_count() == baseline, "Item lookahead reachability and aliased spans cleanup");
    for(var nullable: usize = 0; nullable < 2; nullable++) {
        var rules: vector(LRProduction) = default; defer vector_dispose(&rules);
        var symbols: vector(LRSymbol) = default; defer vector_dispose(&symbols);
        var names = lr_suffix_fixture(&rules, &symbols, nullable != 0);
        lr_check_graph(&rules, &symbols, names, current_contract);
    }
    assert(tower_test_buffer_count() == baseline, "Nullable suffix fixture cleanup");
    lr_closure_order_cases();
    assert(tower_test_buffer_count() == baseline, "Closure order fixture cleanup");
}

fn lr_repeated_cores(current_contract: bool): void {
    var baseline = tower_test_buffer_count();
    // Every terminal reaches a distinct shifted core, then revisits all of
    // those cores through recursive alternatives. Nullable reductions belong
    // to each closed state but not its pre-closure identity. The unchanged
    // oracle expands every transition and checks exact state/edge/action order.
    for(var recursive_start: usize = 0; recursive_start < 2; recursive_start++) {
        var rules: vector(LRProduction) = default; defer vector_dispose(&rules);
        var symbols: vector(LRSymbol) = default; defer vector_dispose(&symbols);
        var branches: usize = 12;
        lr_fixture_rule(&rules, 0, 0, 1); lr_fixture_symbol(&symbols, 1, 0, 0);
        for(var branch: usize = 0; branch < branches; branch++) {
            lr_fixture_rule(&rules, 1, symbols.length, 2);
            var terminal = convert(u32, branch) + 32;
            lr_fixture_symbol(&symbols, oracle_none(), terminal, terminal);
            lr_fixture_symbol(&symbols, recursive_start != 0 ? 0 : 1, 0, 0);
        }
        lr_fixture_rule(&rules, 1, symbols.length, 0);
        lr_check_graph(&rules, &symbols, 2, current_contract);
    }
    assert(tower_test_buffer_count() == baseline, "Repeated nullable core cleanup");
}

fn lr_random_graphs_and_propagation(current_contract: bool): void {
    var baseline = tower_test_buffer_count();
    var random: TestRandom; test_random_init(&random, 1280463937);
    for (var trial: usize = 0; trial < 150; ++trial) {
        {
            var rules: vector(LRProduction); vector_init(&rules); defer vector_dispose(&rules);
            var symbols: vector(LRSymbol); vector_init(&symbols); defer vector_dispose(&symbols);
            var names = 1 + convert(usize, test_random(&random) % 6);
            for (var index: usize = 0; index < names * 2; ++index) {
                var count = convert(usize, test_random(&random) % 5); lr_fixture_rule(&rules, index % names, symbols.length, count);
                for (var position: usize = 0; position < count; ++position) {
                    if test_random(&random) % 2 != 0 { lr_fixture_symbol(&symbols, convert(usize, test_random(&random)) % names, 0, 0); }
                    else {
                        var first = test_random(&random) % 10 + (trial % 2 != 0 ? convert(u32, 2097152) : convert(u32, 32));
                        lr_fixture_symbol(&symbols, oracle_none(), first, first + test_random(&random) % 4);
                    }
                }
            }
            lr_check_graph(&rules, &symbols, names, current_contract); lr_check_propagation(&random);
        }
        assert(tower_test_buffer_count() == baseline, "LR randomized analysis and oracle release every buffer");
    }
}

test() { lr_prediction_and_shift_order(true); }
test() { lr_shift_grouping(true); }
test() { lr_lookahead_and_suffixes(true); }
test() { lr_repeated_cores(true); }
test() { lr_compare_fixed_graphs(true); }
test() { lr_random_graphs_and_propagation(true); }
