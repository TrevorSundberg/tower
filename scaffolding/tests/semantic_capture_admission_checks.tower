import tower;

extern fn strcmp(a: u8*, b: u8*): i32;
extern fn puts(text: u8*): i32;

enum CaptureAdmissionMode: u32 { Healthy, Cancelled, Capacity, Failed }

fn capture_admission_select(argc: i32, argv: u8**, mode: CaptureAdmissionMode*): bool {
    *mode = CaptureAdmissionMode.Healthy;
    if argc <= 1 || strcmp(argv[1], "healthy") == 0 { return true; }
    if strcmp(argv[1], "cancelled") == 0 { *mode = CaptureAdmissionMode.Cancelled; return true; }
    if strcmp(argv[1], "capacity") == 0 { *mode = CaptureAdmissionMode.Capacity; return true; }
    if strcmp(argv[1], "failed") == 0 { *mode = CaptureAdmissionMode.Failed; return true; }
    puts("Unknown capture admission selector");
    return false;
}
