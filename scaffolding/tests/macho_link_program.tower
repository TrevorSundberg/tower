import tower;
extern fn macho_answer(): i32;
extern fn macho_frame(data: u8*, size: usize): i32;
extern fn macho_trace(): i32;
extern fn write(stream: i32, data: u8*, size: usize): i64;
var MachoTestFrameBytes: usize = 65536;
var MachoTestAnswer: i32 = 42;
fn checked(value: bool): void { if !value { trap("Mach-O execution contract", 0); } }
fn large_frame(): i32 {
    var data: u8[65536]; data[0] = 17; data[MachoTestFrameBytes - 1] = 25;
    return macho_frame(&data[0], MachoTestFrameBytes);
}
var callback: function(i32) = macho_answer;
var host_callback: function(i64, i32, u8*, usize) = write;
var result = callback(); checked(result == MachoTestAnswer);
var allocated = alloc(i32, 1); checked(allocated != null); *allocated = large_frame(); checked(*allocated == result); free(allocated);
var minimum_frames: i32 = 3; checked(macho_trace() >= minimum_frames);
var text = "Tower Mach-O execution passed\n"; var text_length: usize = 29;
checked(host_callback(1, text, text_length) == convert(i64, text_length));
print(result);
