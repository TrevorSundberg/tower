import '../library/entities';
import tower;

// Compose after entities.tower; the host supplies the optional lifecycle bridge.
var world = entity_store_create();
var type = entity_create(world);
print(entity_register(type, sizeof(i32), alignof(i32), 0));
var root = entity_create(world);
var child = entity_create(world);
var component = entity_component_add(child, type);
var value = bits(i32*, entity_component_data(component));
*value = 42;
print(entity_attach(child, root, "answer"));
entity_release(child);
print(entity_child_count(root));
print(entity_query_count(type));
var queried = entity_query_at(type, 0);
var same = queried == component;
print(same);
var owner = entity_component_owner(queried);
same = owner == entity_child_at(root, 0);
print(same);
print(*value);
var attached = entity_component_add(root, type);
var first = entity_component_get(owner, type);
var address = entity_component_data(first);
same = address == bits(u8*, value);
print(same);
print(entity_component_remove(root, type));
print(entity_query_count(type));
entity_release(type);
entity_release(root);
print(entity_store_count(world));
print(entity_store_component_count(world));
print(entity_store_dispose(world));
