import tower;
import .compiler.semantic_context_types;

// The batch owns the world. Only the joined root publication writes this receipt.
struct CaptureCheck {
    inspect: function(void, SemanticContext*, CaptureCheck*);
    entry: u8*;
    provider: u8*;
    observed: bool;
    salt: bool;
    model_demanded: bool;
}

extern fn capture_observe(world: void*, check: CaptureCheck*): void;
