import library.testing;
import utf8_boundary;
import utf8_test;
import utf8;
import utf8_oracle;
import utility_checks;

test() { utf8_boundary_tests(Utf8BoundarySeed); }

fn utf8_boundary_tests(initial_state: u32): void {
    var page = convert(usize, getpagesize());
    var memory = bits(u8*, utf8_test_map(page *2));
    assert(bits(usize, memory) != ~convert(usize, 0), "UTF-8 mmap");
    assert(mprotect(bits(void*, memory + page), page, 0) == 0, "UTF-8 protect boundary");
    var scalars: u32[10];
    scalars[0] = 0;
    scalars[1] = 127;
    scalars[2] = 128;
    scalars[3] = 2047;
    scalars[4] = 2048;
    scalars[5] = 55296;
    scalars[6] = 65535;
    scalars[7] = 65536;
    scalars[8] = 1114111;
    scalars[9] = 1114112;
    var state = initial_state;
    for(var size: usize = 0; size <= 4; ++size) {
        var data = memory + page -size;
        for(var trial: usize = 0; trial < 10000; ++trial) {
            for(var index: usize = 0; index < size; ++index) {
                data[index] = convert(u8, utility_random(&state) &255);
            }
            utf8_check(data, size);
        }
        for(var index: usize = 0; index < 10; ++index) {
            fill(data, 165, size);
            var oracle: u8[4];
            fill(&oracle[0], 165, 4);
            assert(tower_utf8_encode(scalars[index], data, size) == reference_utf8_encode(scalars[index], &oracle[0], size), "UTF-8 boundary encode count");
            assert(utility_equal(data, &oracle[0], size), "UTF-8 boundary encode bytes");
        }
    }
    assert(munmap(bits(void*, memory), page *2) == 0, "UTF-8 unmap");
}
