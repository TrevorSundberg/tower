import tower;
import .host.syntax_baseline_api;
import .compiler.syntax_version_types;
import .host.driver_types;
import .host.driver_support;
import .host.driver_request;
import .host.driver_api;
import .library.bytes_interface;
import .library.bytes_types;

import .compiler.format_types;
import .compiler.foundation_types;
import .compiler.semantic_program_types;
import .compiler.interpreter_types;
import .compiler.execution_package;
import .compiler.execution_session;
import execution_support;
import execution_suite;
import execution_world;
import named_initialization_checks;
import struct_value_checks;
import known_binding_checks;
import floating_checks;
import floating_oracle;
import body_runs;
import editor_observations;

extern fn frontend_modules_configure(environment: void*, entry: u8*, library: u8*): void;



export fn main(argc: i32, argv: u8**): i32 {
    execution_check(argc == 2 || argc == 3, "resource root and optional focused suite argument");
    var suite: u8* = argc == 3 ? argv[2] : "all";
    var all = strcmp(suite, "all") == 0;
    var known = strcmp(suite, "known") == 0;
    var floating = strcmp(suite, "floating") == 0;
    var oracle = strcmp(suite, "floating-oracle") == 0;
    var bodies = strcmp(suite, "body-smoke") == 0;
    var editor = strcmp(suite, "editor") == 0;
    execution_check(all || known || bodies || editor || floating || oracle, "known execution suite");
    if all || editor { editor_observation_tests(argv[1]); }
    if editor { return 0; }
    if bodies {
        body_runs_smoke(argv[1]);
        return 0;
    }
    var path: ByteBuffer;
    fill(&path, 0, sizeof(ByteBuffer));
    defer bytes_dispose(&path);
    execution_check(driver_text(&path, argv[1]) && driver_text(&path, "/foundation.tower") && host_text_terminate(&path), "resource path");
    var options: DriverOptions;
    fill(&options, 0, sizeof(DriverOptions));
    options.source = path.data;
    options.bedrock = "";
    options.foundation = "";
    var request: DriverRequest;
    execution_check(driver_request_open(&request, &options, argv[1]), "bootstrap snapshots");
    defer driver_request_close(&request);
    driver_request_bind(&request, syntax_host_environment(compiler_host_world()));
    var result: SyntaxVersionDiagnostic = default;
    defer syntax_version_diagnostic_dispose(&result);
    execution_check(syntax_host_install(compiler_host_world(), request.text[DriverBedrockText].data, false, &result), "install Bedrock" );
    execution_check(syntax_host_install(compiler_host_world(), request.text[DriverFoundationText].data, true, &result), "install Foundation" );
    frontend_modules_configure(request.modules, "named_initialization_input.tower", argv[1]);
    if oracle { floating_oracle_tests(request.modules); return 0; }
    if all {
        named_initialization_tests(request.modules, argv[1]);
        struct_value_tests(request.modules, argv[1]);
    }
    if all || floating { floating_tests(request.modules, argv[1]); }
    if floating { return 0; }
    known_binding_tests(request.modules, argv[1]);
    if !all { return 0; }
    frontend_modules_configure(request.modules, options.source, argv[1]);
    execution_tests(request.modules);
    execution_world_tests(&request);
    return 0;
}
