import tower;
import syntax_validation_test;

extern fn puts(text: u8*): i32;

export fn syntax_validation_tests(): void {
    validation_check_group(validation_dependency_tests);
    validation_check_group(validation_capture_tests);
    validation_check_group(validation_declaration_tests);
    validation_check_group(validation_large_capture_tests);
    validation_check_group(validation_random_tests);
    puts("Syntax validation: exact independent Tower diagnostics/pending terms, 1500 captures, 600 dependency graphs and allocation failures passed.");
}
