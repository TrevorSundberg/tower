import tower;
import utility_checks;
import .compiler.parser_markers;

extern fn parser_set_debug_trace(enabled: bool): bool;
extern fn parser_match_get_type(): void*;
extern fn entity_member_index(node: void*, name: u8*): usize;
extern fn entity_child_at(node: void*, index: usize): void*;
extern fn entity_child_count(node: void*): usize;
extern fn entity_references(node: void*): usize;
extern fn tower_test_buffer_fail_after(count: usize): void;
extern fn tower_test_buffer_count(): usize;

// Single-owner failure instrumentation belongs only to serial test consumers.
fn parser_trace_failure_tests(): void {
    var owner = parser_match_get_type();
    var enabled = entity_member_index(owner, "parser.trace") != ParserNoIndex();
    utility_check(parser_set_debug_trace(false) && parser_set_debug_trace(true)
        && parser_set_debug_trace(false), "Parser trace configuration warmup");
    var children = entity_child_count(owner);
    var references = entity_references(owner);
    var buffers = tower_test_buffer_count();
    var failures: usize = 0;
    loop {
        tower_test_buffer_fail_after(failures);
        var ok = parser_set_debug_trace(true);
        tower_test_buffer_fail_after(~convert(usize, 0));
        var slot = entity_member_index(owner, "parser.trace");
        var marker = slot == ParserNoIndex() ? null : entity_child_at(owner, slot);
        if ok {
            utility_check(failures != 0 && marker != null && entity_references(marker) == 1,
                "Parser trace fault sweep reaches owned publication after actual failures");
            tower_test_buffer_fail_after(0);
            var repeated = parser_set_debug_trace(true);
            var removed = parser_set_debug_trace(false);
            tower_test_buffer_fail_after(~convert(usize, 0));
            utility_check(repeated && removed, "Existing parser trace toggle needs no allocation");
        } else {
            utility_check(marker == null, "Failed parser trace enable publishes no marker");
        }
        utility_check(entity_child_count(owner) == children && entity_references(owner) == references
            && tower_test_buffer_count() == buffers, "Parser trace failure and removal release ownership");
        if ok { break; }
        failures++;
    }
    utility_check(parser_set_debug_trace(enabled), "Restore caller parser trace configuration");
}
