import tower;
import format_suite;
import format_abi;
import utility_checks;
import .library.bytes_types;
import .library.bytes_interface;
import .host.syntax_baseline_api;
import .compiler.syntax_version_types;

extern fn driver_read_file(path: u8*, out: ByteBuffer*): bool;
extern fn host_text_terminate(out: ByteBuffer*): bool;

fn format_wasi_baseline(path: u8*, bedrock: bool): void {
    var input: ByteBuffer; fill(&input, 0, sizeof(ByteBuffer)); defer bytes_dispose(&input);
    utility_check(driver_read_file(path, &input) && host_text_terminate(&input), "Read WASI formatter grammar");
    var result: SyntaxVersionDiagnostic = default;
    defer syntax_version_diagnostic_dispose(&result);
    var ok = syntax_host_install(compiler_host_world(), input.data, !bedrock, &result);
    if !ok { puts(syntax_version_diagnostic_text(&result)); }
    utility_check(ok, "Install WASI formatter grammar");
}
export fn __main_argc_argv(argc: i32, argv: u8**): i32 {
    format_wasi_baseline("bedrock.tower", true); format_wasi_baseline("foundation.tower", false);
    formatter_tests();
    return 0;
}
