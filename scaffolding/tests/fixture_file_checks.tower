import tower;
import .compiler.execution_session;
import .compiler.test_file_rule;
import .library.vector;
import .host.driver_request;
import .host.driver_support;
import .host.driver_platform;
import execution_support;
import frontend_units;

extern fn frontend_test_selection_open(selection: TestFileSelection*, rule: TestFileRule*, entry: u8*): bool;

extern fn frontend_modules_swap_test_discovery(modules: void*, next: TestFileDiscovery*): TestFileDiscovery*;

extern fn frontend_modules_source(modules: void*, path: u8*, text: u8*, length: usize): bool;

fn fixture_memory_input(modules: void*, path: u8*, text: vector(u8)*): void {
    execution_check(frontend_modules_source(modules, path, text.data, text.length), path);
}

fn fixture_memory_trial(modules: void*, selection: TestFileSelection*, source: u8*, failure_line: usize, wanted: u8*): void {
    var session: ExecutionSession = default;
    defer execution_session_close(&session);
    var discovery: TestFileDiscovery = {
        selection: selection, .. default
    };
    {
        var previous = frontend_modules_swap_test_discovery(modules, &discovery);
        defer frontend_modules_swap_test_discovery(modules, previous);
        var ok = execution_session_compile_tests(&session, source, strlen(source), 8, modules);
        if !ok {
            puts(session.error.data ?? "Fixture compilation failed");
        }
        execution_check(ok && session.program.test_count == 2 && selection.fixtures.length == 2, "both fixture owners selected");
    }
    execution_check(strcmp(selection.fixtures.data[0].oracle.data, "mem/left/function_values.expected") == 0
    && strcmp(selection.fixtures.data[1].source.data, "mem/right/function_values.tower") == 0
    && strcmp(selection.fixtures.data[1].oracle.data, "mem/right/function_values.expected") == 0,
    "dependency paths survive the discovery graph");
    var access: ExecutionFixtureAccess = {
        selection: selection, modules: modules
    };
    session.fixtures = &access;
    execution_run(&session, 1000, 100000);
    execution_check(session.machine.done && session.machine.failed ==(failure_line != 0)
    && execution_text(&session.output, wanted), "registered fixture bytes and completion");
    if failure_line == 0 {
        driver_message(1, "Registered fixture stdout", "", true);
        driver_platform_write(1, session.output.data, session.output.length);
    } else {
        var line: usize = 0;
        var column: usize = 0;
        var path = frontend_modules_location(modules, session.machine.error_offset, &line, &column);
        driver_report(session.error.data, session.machine.error_offset, source, strlen(source), selection.entry, modules);
        execution_check(strcmp(path, "mem/right/function_values_test.tower") == 0
        && line == failure_line && column ==(failure_line == 6 ? 18: 5), "original read or assertion location");
    }
}

fn fixture_file_checks(modules: void*, root: u8*): void {
    var owner: vector(u8) = default;
    var companion: vector(u8) = default;
    var oracle: vector(u8) = default;
    defer vector_dispose(&owner);
    defer vector_dispose(&companion);
    defer vector_dispose(&oracle);
    units_read(root, "/tests/function_values.tower", &owner);
    units_read(root, "/tests/function_values_test.tower", &companion);
    units_read(root, "/tests/function_values.expected", &oracle);
    fixture_memory_input(modules, "mem/left/function_values.tower", &owner);
    fixture_memory_input(modules, "mem/left/function_values_test.tower", &companion);
    fixture_memory_input(modules, "mem/left/function_values.expected", &oracle);
    var condition = "if selected(41) != 4";
    var digit = strstr(owner.data, condition);
    execution_check(digit != null && digit[strlen(condition)] == *"2", "original function check");
    digit[strlen(condition)] = *"1";
    fixture_memory_input(modules, "mem/right/function_values.tower", &owner);
    fixture_memory_input(modules, "mem/right/function_values_test.tower", &companion);

    var entry = "mem/main.tower";
    var source = "import left.function_values as left; import right.function_values as right;";
    frontend_modules_configure(modules, entry, root);
    var selection: TestFileSelection = default;
    defer test_file_selection_dispose(&selection);
    var rule = test_file_default_rule();
    execution_check(frontend_test_selection_open(&selection, &rule, entry), "open memory fixture selection");
    fixture_memory_trial(modules, &selection, source, 6, "0\n");
    execution_check(oracle.length == 2 && oracle.data[1] == *"\n", "raw expected text");
    oracle.data[0] = *"1";
    oracle.data[1] = *"\r";
    fixture_memory_input(modules, "mem/right/function_values.expected", &oracle);
    fixture_memory_trial(modules, &selection, source, 8, "0\n");
    oracle.data[1] = *"\n";
    fixture_memory_input(modules, "mem/right/function_values.expected", &oracle);
    fixture_memory_trial(modules, &selection, source, 0, "0\n1\n");
}

// Exercise the ordinary companion bodies under both guest ABIs. A null file
// probe admits only registered companions and data; each child shares the
// declaration world's budget, whose teardown checks memory and worker leases.
fn fixture_diagnostic_profiles(modules: void*, root: u8*): void {
    var directory = "/tests/semantic_invalid/";
    var files: u8*[3] = {"staged_rejections.tower", "staged_rejections_test.tower", "staged_rejections.fixtures"};
    var data: vector(u8) = default;
    defer vector_dispose(&data);
    var path: vector(u8) = default;
    defer vector_dispose(&path);
    foreach (var name in &files) {
        units_path(directory, name, &path);
        units_read(root, path.data, &data);
        fixture_memory_input(modules, path.data + 1, &data);
    }
    var subjects: usize = 0;
    var at: usize = 0;
    var suffixes: u8*[2] = {".tower", ".expected"};
    while at < data.length {
        var start = at;
        while at < data.length && data.data[at] != 10 { ++at; }
        foreach (var suffix in &suffixes) {
            path.length = 0;
            execution_check(test_file_append(&path, directory, strlen(directory))
                && test_file_append(&path, data.data + start, at - start)
                && test_file_append(&path, suffix, strlen(suffix) + 1), "declared input key");
            var text: vector(u8) = default;
            defer vector_dispose(&text);
            units_read(root, path.data, &text);
            fixture_memory_input(modules, path.data + 1, &text);
        }
        ++subjects;
        ++at;
    }
    var entry = "tests/semantic_invalid/staged_rejections.tower";
    var source: vector(u8) = default;
    defer vector_dispose(&source);
    units_read(root, "/tests/semantic_invalid/staged_rejections.tower", &source);
    frontend_modules_configure(modules, entry, root);
    var rule = test_file_default_rule();
    for (var width: u32 = 4; width <= 8; width *= 2) {
        var selection: TestFileSelection = default;
        defer test_file_selection_dispose(&selection);
        execution_check(frontend_test_selection_open(&selection, &rule, entry), "open diagnostic fixtures");
        var discovery: TestFileDiscovery = {selection: &selection, ..default};
        var session: ExecutionSession = default;
        defer execution_session_close(&session);
        {
            var previous = frontend_modules_swap_test_discovery(modules, &discovery);
            defer frontend_modules_swap_test_discovery(modules, previous);
            execution_check(execution_session_compile_tests(&session, source.data, source.length, width, modules)
                && subjects != 0 && session.program.test_count == subjects, "compile each declared rejection");
        }
        var access: ExecutionFixtureAccess = {selection: &selection, modules: modules};
        session.fixtures = &access;
        execution_run(&session, 1000, subjects * 100000);
        if session.machine.failed { puts(session.error.data ?? "Registered fixture failed without a diagnostic"); }
        execution_check(session.machine.done && !session.machine.failed, "registered diagnostic fields and guest ownership");
    }
}
