import tower;
import .library.vector;
import .compiler.format_types;
import .compiler.syntax_types;
import .compiler.parser_types;
import .compiler.component_kinds;
import .compiler.parser_markers;
import frontend_world;
import frontend_format;

extern fn bytes_append(value: vector(u8)*, source: u8*, length: usize): bool;

extern fn format_syntax_description(result: FormatResult*, node: void*, name: u8*,
name_only: bool, syntax: void*, kind: void*): void;

extern fn format_syntax_origin(result: FormatResult*, node: void*, prefix: u8*, syntax: void*, kind: void*): void;

extern fn format_same_tree(a: void*, b: void*, source_a: u8*, size_a: usize,
source_b: u8*, size_b: usize, syntax: void*, kind: void*): bool;

extern fn syntax_source_create(name: u8*, text: u8*, length: usize): SyntaxSource*;

extern fn syntax_source_release(source: SyntaxSource*): void;

extern fn syntax_node_source(node: SyntaxNode*, source: SyntaxSource*): void;

fn preview_syntax(world: void*, entity: void*): SyntaxNode* {
    return bits(SyntaxNode*, compiler_world_component(world, entity, CompilerSyntax()));
}

fn preview_match(world: void*, entity: void*): ParserMatchData* {
    return bits(ParserMatchData*, compiler_world_component(world, entity, CompilerParserMatch()));
}

fn preview_description_tests(): void {
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    var store = compiler_world_store(world);
    var syntax = compiler_world_type(world, CompilerSyntax());
    var kind = compiler_world_type(world, CompilerParserMatch());
    var root = entity_create(store);
    var sequence = preview_syntax(world, root);
    sequence.kind = convert(u32, SyntaxKind.Alternative);
    var result: FormatResult;
    fill(&result, 0, sizeof(FormatResult));
    format_syntax_description(&result, root, "Empty", false, syntax, kind);
    frontend_world_check(frontend_world_error_is(&result, "Empty = <empty> (native seed)"));
    format_dispose(&result);
    var source = syntax_source_create("unicode.tower", "é\nx", 4);
    syntax_node_source(sequence, source);
    sequence.start = 3;
    syntax_source_release(source);
    var term_entity = frontend_format_child(store, root, null);
    var term = preview_syntax(world, term_entity);
    term.kind = convert(u32, SyntaxKind.Term);
    frontend_world_check(bytes_append(&term.text, "Number", 6));
    frontend_world_check(vector_push(void*, &sequence.items, term_entity));
    format_syntax_description(&result, root, "Value", false, syntax, kind);
    frontend_world_check(frontend_world_error_is(&result, "Value = Number (unicode.tower:2:1)"));
    format_dispose(&result);
    format_syntax_description(&result, root, "Value", true, syntax, kind);
    frontend_world_check(frontend_world_error_is(&result, "Value (unicode.tower:2:1)"));
    format_dispose(&result);
    syntax_node_source(term, sequence.source);
    term.start = 2;
    term.repetition = 43;
    format_syntax_origin(&result, term_entity, "repetition ", syntax, kind);
    frontend_world_check(frontend_world_error_is(&result, "repetition Number+ (unicode.tower:1:2)"));
    format_dispose(&result);
    // The byte limit falls inside a multibyte scalar. Never emit partial UTF-8.
    term.repetition = 0;
    term.literal = true;
    term.text.length = 0;
    var i: usize = 0;
    for(; i < 118; i++) {
        frontend_world_check(vector_push(u8, &term.text, 97));
    }
    frontend_world_check(bytes_append(&term.text, "é", 2));
    format_syntax_description(&result, root, "Utf8", false, syntax, kind);
    var ok = !result.failed;
    frontend_world_check(ok);
    // Prefix 7 + quote 1 + 118 ASCII + suffix; the entire é is excluded.
    var suffix: u8* = " ... (unicode.tower:2:1)";
    i = 0;
    for(; suffix[i] != 0; i++) {
        var at = i + 126;
        ok = result.text.data[at] == suffix[i];
        frontend_world_check(ok);
    }
    var expected_length = i + 126;
    ok = result.text.length == expected_length;
    frontend_world_check(ok);
    format_dispose(&result);
    var buffers = tower_test_buffer_count();
    var allocations = tower_test_buffer_allocations();
    format_syntax_description(&result, root, "Utf8", false, syntax, kind);
    allocations = tower_test_buffer_allocations() - allocations;
    format_dispose(&result);
    var budget: usize = 0;
    for(; budget < allocations; budget++) {
        fill(&result, 0, sizeof(FormatResult));
        tower_test_buffer_fail_after(budget);
        format_syntax_description(&result, root, "Utf8", false, syntax, kind);
        tower_test_buffer_fail_after(frontend_world_unlimited());
        frontend_world_check(result.failed);
        format_dispose(&result);
        ok = tower_test_buffer_count() == buffers;
        frontend_world_check(ok);
    }
    entity_release(root);
    frontend_world_check(compiler_world_dispose(world));
    ok = tower_test_buffer_count() == baseline;
    frontend_world_check(ok);
}

fn preview_tree_tests(): void {
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    var store = compiler_world_store(world);
    var syntax = compiler_world_type(world, CompilerSyntax());
    var kind = compiler_world_type(world, CompilerParserMatch());
    var a = entity_create(store);
    var b = entity_create(store);
    var x = preview_match(world, a);
    var y = preview_match(world, b);
    x.rule = 1;
    y.rule = 1;
    var left = a;
    var right = b;
    for(var depth: usize = 0; depth < 2048; depth++) {
        left = frontend_format_child(store, left, null);
        right = frontend_format_child(store, right, null);
        x = preview_match(world, left);
        y = preview_match(world, right);
        x.rule = 1;
        y.rule = 1;
    }
    x.rule = ParserNoIndex();
    y.rule = ParserNoIndex();
    x.start = 1;
    y.start = 3;
    x.length = 2;
    y.length = 2;
    frontend_world_check(format_same_tree(a, b, " é", 3, "   é", 5, syntax, kind));
    var ok = format_same_tree(a, b, " é", 3, "   xx", 5, syntax, kind) == false;
    frontend_world_check(ok);
    y.start = 6;
    ok = format_same_tree(a, b, " é", 3, "   é", 5, syntax, kind) == false;
    frontend_world_check(ok);
    y.start = 3;
    y.length = 100;
    // Preserve string-view clamping for a leaf that ends beyond EOF.
    frontend_world_check(format_same_tree(a, b, " é", 3, "   é", 5, syntax, kind));
    frontend_world_check(node_match_set_label(y, "different"));
    ok = format_same_tree(a, b, " é", 3, "   é", 5, syntax, kind) == false;
    frontend_world_check(ok);
    frontend_world_check(node_match_set_label(y, ""));
    var buffers = tower_test_buffer_count();
    var allocations = tower_test_buffer_allocations();
    frontend_world_check(format_same_tree(a, b, " é", 3, "   é", 5, syntax, kind));
    allocations = tower_test_buffer_allocations() - allocations;
    for(var budget: usize = 0; budget < allocations; budget++) {
        tower_test_buffer_fail_after(budget);
        var same = format_same_tree(a, b, " é", 3, "   é", 5, syntax, kind);
        tower_test_buffer_fail_after(frontend_world_unlimited());
        ok = !same;
        frontend_world_check(ok);
        ok = tower_test_buffer_count() == buffers;
        frontend_world_check(ok);
    }
    // Grammar components take precedence over parser-match metadata and reuse
    // the existing structural comparison. Source coordinates are metadata.
    var sa = preview_syntax(world, a);
    var sb = preview_syntax(world, b);
    sa.kind = convert(u32, SyntaxKind.Term);
    sb.kind = convert(u32, SyntaxKind.Term);
    sa.start = 1;
    sb.start = 7;
    frontend_world_check(format_same_tree(a, b, "", 0, "", 0, syntax, kind));
    sb.literal = true;
    ok = format_same_tree(a, b, "", 0, "", 0, syntax, kind) == false;
    frontend_world_check(ok);
    entity_release(a);
    entity_release(b);
    frontend_world_check(compiler_world_dispose(world));
    ok = tower_test_buffer_count() == baseline;
    frontend_world_check(ok);
}

fn frontend_syntax_preview_tests(): void {
    preview_description_tests();
    preview_tree_tests();
}
