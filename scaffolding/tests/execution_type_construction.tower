import tower;
import execution_support;
import .compiler.execution_session;
import .compiler.interpreter_context_types;
import .compiler.foundation_tags;
import .compiler.foundation_types;
import .library.vector;
import .library.work_budget;
import .library.work_budget_types;

extern fn sem_create(parent: void*): void*;
extern fn sem_attach(node: void*, kind: u32): FoundationNode*;
extern fn interpreter_invocation_init(invocation: IMInvocation*, function: void*, width: usize, arguments: u64*, count: usize, strict: bool, fuel: u64): bool;
extern fn interpreter_invocation_step(invocation: IMInvocation*, budget: usize): void;
extern fn interpreter_invocation_dispose(invocation: IMInvocation*): void;
extern fn interpreter_type_result(invocation: IMInvocation*, reference: u64, type: FoundationType*, offset: usize): bool;
extern fn compiler_world_create_workers(limit: usize): void*;
extern fn compiler_world_bind_budget(world: void*, budget: WorkBudget*): bool;
extern fn compiler_world_dispose(world: void*): bool;

var ExecutionTypeStorageBytes: usize = 16777216;
var ExecutionTypeStorageOffset: usize = 37;
var ExecutionTypeFinishValuePhase: usize = 4;
var ExecutionTypeResumeBudget: usize = 1000;

fn construction_storage_node(root: void*, width: u32, kind: u32): void* {
    var node = sem_create(root);
    sem_attach(node, kind).type = { scalar: SI32, pointer_bytes: width, ..default };
    return node;
}

fn construction_storage_fill(budget: WorkBudget*, occupied: WorkReservation*): void {
    var snapshot: WorkBudgetSnapshot = default;
    execution_check(work_budget_snapshot(budget, &snapshot)
        && work_budget_reserve_result(budget, 0, 0, snapshot.bytes - snapshot.used_bytes, occupied)
            == WorkBudgetError.None, "reserve exactly the remaining type-storage allowance");
}

// Reach the real interning sites after entry storage succeeds. Shared graph
// entities outlive every request; only the private index consumes the allowance.
fn execution_type_storage_tests(width: u32): void {
    var budget: WorkBudget = default;
    var world = compiler_world_create_workers(1);
    execution_check(work_budget_init(&budget, 1, ExecutionTypeStorageBytes, 1)
        && compiler_world_bind_budget(world, &budget), "type-storage world budget");
    var root = entity_create(compiler_world_store(world));
    var program = sem_attach(root, KProgram);
    program.type.pointer_bytes = width;
    program.frame_size = convert(usize, width);
    var seven = construction_storage_node(root, width, KOperand);
    sem_get(seven).constant = true;
    sem_get(seven).bits = 7;
    var printed = construction_storage_node(root, width, KPrint);
    sem_get(printed).value = seven;
    var reference = construction_storage_node(root, width, KTypeReference);
    sem_get(reference).type.scalar = SType;
    sem_get(reference).element = { scalar: SI32, pointer_bytes: width, ..default };
    sem_get(reference).start = ExecutionTypeStorageOffset;
    var converted = construction_storage_node(root, width, KConvert);
    sem_get(converted).type = sem_get(reference).type;
    sem_get(converted).value = reference;
    var declared = construction_storage_node(root, width, KDeclare);
    sem_get(declared).type = sem_get(reference).type;
    sem_get(declared).value = converted;
    sem_get(declared).start = ExecutionTypeStorageOffset;
    var nine = construction_storage_node(root, width, KOperand);
    sem_get(nine).constant = true;
    sem_get(nine).bits = 9;
    var after = construction_storage_node(root, width, KPrint);
    sem_get(after).value = nine;
    execution_check(vector_push(&program.items, printed) && vector_push(&program.items, declared)
        && vector_push(&program.items, after), "type-storage program statements");
    var baseline: WorkBudgetSnapshot = default;
    execution_check(work_budget_snapshot(&budget, &baseline), "type-storage baseline");
    for(var mode: usize = 0; mode < 4; mode++) {
        var fast = mode >= 2;
        var denied = mode % 2 == 0;
        var session: ExecutionSession = default;
        entity_retain(root);
        semantic_initialize(&session.program, root, width);
        session.machine.stack = 16;
        session.machine.heap = 4194304;
        execution_check(execution_session_start(&session), "type-storage entry succeeds before denial");
        if !fast {
            for(var step: usize = 0; step < 100 && session.output.length == 0; step++) {
                execution_session_step(&session, 1);
            }
            execution_check(execution_text(&session.output, "7\n") && !session.machine.failed
                && session.machine.type_values.values.length == 0, "graph reaches effect before first type value");
        }
        var occupied: WorkReservation = default;
        if denied { construction_storage_fill(&budget, &occupied); }
        if fast {
            execution_check(execution_session_fast(&session) == !denied,
                "fast cache propagates type-storage admission result");
        }
        execution_run(&session, 1, 1000);
        if denied {
            execution_check(session.machine.failed && session.machine.done
                && session.machine.storage_error == WorkBudgetError.Capacity && session.fast == null
                && execution_text(&session.error, "Cannot allocate interpreter type storage")
                && session.machine.error_offset == ExecutionTypeStorageOffset
                && execution_text(&session.output, fast ? "" : "7\n"),
                "type-storage denial preserves exact failure and preceding effects only");
            execution_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None,
                "release type-storage occupancy");
            var steps = session.machine.steps;
            execution_check(!execution_session_fast(&session), "failed cache cannot fall back after allowance returns");
            execution_session_step(&session, 1000);
            execution_check(session.machine.steps == steps
                && execution_text(&session.output, fast ? "" : "7\n"), "failed request never replays effects");
        } else {
            execution_check(session.machine.done && !session.machine.failed
                && execution_text(&session.output, "7\n9\n"), "admitted type value preserves graph/cache behavior");
        }
        execution_session_close(&session);
        var released: WorkBudgetSnapshot = default;
        execution_check(work_budget_snapshot(&budget, &released) && released.used_bytes == baseline.used_bytes
            && released.live == baseline.live, "type-storage requests release all private receipts");
    }

    var function = construction_storage_node(root, width, KFunction);
    sem_get(function).type.scalar = SType;
    var body = construction_storage_node(root, width, KBlock);
    sem_get(function).body = body;
    var construct = construction_storage_node(root, width, KTypeConstruct);
    sem_get(construct).type = sem_get(reference).type;
    sem_get(construct).op = convert(u32, TypeConstructionKind.Integer);
    var integer_width = construction_storage_node(root, width, KOperand);
    sem_get(integer_width).constant = true;
    sem_get(integer_width).bits = 32;
    var signed_integer = construction_storage_node(root, width, KOperand);
    sem_get(signed_integer).constant = true;
    sem_get(signed_integer).bits = 1;
    sem_get(construct).left = integer_width;
    sem_get(construct).right = signed_integer;
    var returned = construction_storage_node(root, width, KReturn);
    sem_get(returned).value = construct;
    execution_check(vector_push(&sem_get(body).items, printed) && vector_push(&sem_get(body).items, returned),
        "constructor type-storage statements");
    var invocation: IMInvocation = default;
    construction_test_begin(&invocation, function, width, true);
    construction_test_until_wait(&invocation);
    var request = &invocation.context.type_construction;
    execution_check(!invocation.state.failed && invocation.context.waiting_type
        && request.sequence == 1 && request.first == 32 && request.second == 1
        && invocation.context.output.length == 2, "constructor operands precede descriptor admission");
    request.result = { scalar: SI32, pointer_bytes: width, ..default };
    request.ready = true;
    var occupied: WorkReservation = default;
    construction_storage_fill(&budget, &occupied);
    interpreter_invocation_step(&invocation, 1000);
    execution_check(invocation.state.failed && invocation.state.storage_error == WorkBudgetError.Capacity
        && !invocation.context.returned && request.ready && request.subject == construct
        && invocation.state.type_values.values.length == 0
        && invocation.context.error.length == strlen("Cannot allocate interpreter type storage")
        && memcmp(invocation.context.error.data, "Cannot allocate interpreter type storage", invocation.context.error.length) == 0,
        "denied constructor result remains unconsumed and unpublished");
    execution_check(work_budget_release_result(&budget, &occupied) == WorkBudgetError.None,
        "release constructor occupancy");
    var steps = invocation.state.steps;
    interpreter_invocation_step(&invocation, 1000);
    execution_check(invocation.state.steps == steps && request.sequence == 1
        && invocation.context.output.length == 2 && memcmp(invocation.context.output.data, "7\n", 2) == 0,
        "constructor failure never replays operands or effects");
    interpreter_invocation_dispose(&invocation);
    entity_release(root);
    execution_check(compiler_world_dispose(world), "type-storage world closes after requests");
    var released: WorkBudgetSnapshot = default;
    execution_check(work_budget_snapshot(&budget, &released) && released.used_bytes == 0 && released.live == 0
        && work_budget_dispose(&budget), "type-storage world and partial caches release every grant");
}

fn construction_test_function(session: ExecutionSession*, name: u8*): void* {
    foreach(var function in &session.program.functions) {
        var node = sem_get(function);
        if node.name.length == strlen(name) && memcmp(node.name.data, name, node.name.length) == 0 { return function; }
    }
    execution_check(false, "constructor fixture function exists");
    return null;
}

fn construction_test_until_wait(invocation: IMInvocation*): void {
    for(var step: usize = 0; step < 1000; step++) {
        interpreter_invocation_step(invocation, 1);
        if invocation.state.done || invocation.context.waiting_type { return; }
    }
    execution_check(false, "constructor invocation makes bounded progress");
}

fn construction_test_begin(invocation: IMInvocation*, function: void*, width: u32, capability: bool): void {
    execution_check(interpreter_invocation_init(invocation, function, convert(usize, width), null, 0, false, 0),
        "constructor invocation starts");
    invocation.context.construct_types = capability;
    invocation.context.type_construction.owner = function;
}

// Mutate owned checked entities only between invocations. This isolates the
// interpreter protocol before frontend/coordinator constructor integration.
fn execution_type_construction_tests(modules: void*): void {
    for(var width: u32 = 4; width <= 8; width += 4) {
        execution_type_storage_tests(width);
        var session: ExecutionSession = default;
        defer execution_session_close(&session);
        execution_compile(&session, "import tower; fn first():i32 { print(1); return 8; } fn second():i32 { print(2); return 1; } fn make():type { var ignored:type=i32; return i32; }", width, modules);
        var function = construction_test_function(&session, "make");
        var body = sem_get(sem_get(function).body);
        var construct = sem_create(function);
        var node = sem_attach(construct, KTypeConstruct);
        node.type = sem_get(function).type;
        node.op = convert(u32, TypeConstructionKind.Integer);
        node.left = sem_create(construct);
        node.right = sem_create(construct);
        var left = sem_attach(node.left, KCall);
        left.binding = construction_test_function(&session, "first");
        left.type = sem_get(left.binding).type;
        var right = sem_attach(node.right, KCall);
        right.binding = construction_test_function(&session, "second");
        right.type = sem_get(right.binding).type;
        execution_check(body.items.length == 2, "constructor fixture statement shape");
        sem_get(body.items.data[0]).value = construct;
        sem_get(body.items.data[1]).value = construct;
        var invocation: IMInvocation = default;
        defer interpreter_invocation_dispose(&invocation);
        construction_test_begin(&invocation, function, width, true);
        for(var visit: usize = 1; visit <= 2; visit++) {
            construction_test_until_wait(&invocation);
            var request = &invocation.context.type_construction;
            execution_check(!invocation.state.failed && invocation.context.waiting_type
                && request.owner == function && request.subject == construct && request.sequence == visit
                && request.first == 8 && request.second == 1 && request.kind == node.op,
                "reached constructor retains evaluated operands and unique visit identity");
            execution_check(invocation.context.output.length == visit * 4
                && memcmp(invocation.context.output.data, "1\n2\n1\n2\n", visit * 4) == 0,
                "constructor effects execute left to right once per visit");
            var steps = invocation.state.steps;
            for(var retry: usize = 0; retry < 4; retry++) {
                interpreter_invocation_step(&invocation, 1);
                execution_check(invocation.state.steps == steps && request.sequence == visit
                    && invocation.context.output.length == visit * 4, "pending retry never replays operands");
            }
            request.result = { scalar: SI8, pointer_bytes: width, ..default };
            request.ready = true;
        }
        construction_test_until_wait(&invocation);
        var result: FoundationType = default;
        execution_check(invocation.state.done && !invocation.state.failed && invocation.context.returned
            && invocation.context.type_construction.subject == null
            && interpreter_type_result(&invocation, invocation.context.result, &result, 0)
            && result.scalar == SI8 && result.pointer_bytes == width,
            "ready descriptor relocates to private type table and consumes request");
        interpreter_invocation_dispose(&invocation);
        construction_test_begin(&invocation, function, width, false);
        construction_test_until_wait(&invocation);
        var diagnostic = "Type construction requires compile-stage capability";
        execution_check(invocation.state.failed && invocation.context.output.length == 4
            && invocation.context.error.length == strlen(diagnostic)
            && memcmp(invocation.context.error.data, diagnostic, strlen(diagnostic)) == 0,
            "missing capability fails after ordered operand effects");
        interpreter_invocation_dispose(&invocation);
        construction_test_begin(&invocation, function, width, true);
        construction_test_until_wait(&invocation);
        invocation.context.type_construction.failed = true;
        construction_test_until_wait(&invocation);
        execution_check(invocation.state.failed && invocation.context.output.length == 4,
            "failed producer terminates even without a ready receipt");
        interpreter_invocation_dispose(&invocation);
        construction_test_begin(&invocation, function, width, true);
        construction_test_until_wait(&invocation);
        var request = &invocation.context.type_construction;
        var message = "Constructor producer rejected the requested type";
        var message_length = strlen(message);
        execution_check(invocation.context.waiting_type && request.subject == construct
            && !invocation.state.failed && vector_reserve(&request.error, message_length),
            "counted constructor failure reaches its real waiting producer");
        execution_check(invocation.state.frame_count != 0, "waiting constructor retains its frame");
        var frame = &invocation.state.frames.data[invocation.state.frame_count - 1];
        execution_check(frame.tasks.length != 0, "waiting constructor retains its continuation");
        var continuation = frame.tasks.data[frame.tasks.length - 1];
        execution_check(continuation.node == construct && continuation.phase == ExecutionTypeFinishValuePhase,
            "waiting constructor retains its actual FinishValue source offset");
        // Every allocated byte belongs to the diagnostic. The consumer must not
        // grow or terminate this producer-owned counted span to report failure.
        var storage = request.error.data;
        var extent = request.error.capacity;
        var suffix: u8 = 33;
        fill(storage, suffix, extent);
        copy(storage, message, message_length);
        request.error.length = extent;
        request.failed = true;
        construction_test_until_wait(&invocation);
        execution_check(invocation.state.failed && !invocation.context.returned
            && invocation.state.error_offset == continuation.offset,
            "counted constructor failure preserves the continuation source offset");
        execution_check(request.error.data == storage && request.error.capacity == extent
            && request.error.length == extent && request.failed && !request.ready,
            "counted constructor failure preserves producer storage");
        execution_check(invocation.context.error.length == extent
            && memcmp(invocation.context.error.data, request.error.data, extent) == 0,
            "counted constructor failure preserves the exact diagnostic");
        execution_check(memcmp(request.error.data, message, message_length) == 0,
            "counted constructor diagnostic retains its prefix");
        for(var i = message_length; i < extent; i++) {
            execution_check(request.error.data[i] == suffix, "counted constructor diagnostic retains its suffix");
        }
        var steps = invocation.state.steps;
        var sequence = request.sequence;
        interpreter_invocation_step(&invocation, ExecutionTypeResumeBudget);
        var effects = "1\n2\n";
        execution_check(invocation.state.steps == steps && request.sequence == sequence
            && invocation.context.output.length == strlen(effects)
            && memcmp(invocation.context.output.data, effects, strlen(effects)) == 0,
            "counted constructor failure never replays its operand effects");
        interpreter_invocation_dispose(&invocation);
        construction_test_begin(&invocation, function, width, true);
        invocation.context.type_construction.sequence = ~convert(usize, 0);
        construction_test_until_wait(&invocation);
        execution_check(invocation.state.failed && invocation.context.type_construction.subject == null,
            "sequence overflow cannot reuse a request identity");
        interpreter_invocation_dispose(&invocation);
        var call = sem_create(session.program.root);
        var called = sem_attach(call, KCall);
        called.binding = function;
        called.type = sem_get(function).type;
        execution_check(vector_push(&sem_get(session.program.root).items, call), "runtime constructor call fixture");
        execution_check(execution_session_fast(&session), "runtime constructor cache builds");
        execution_run(&session, 1, 1000);
        execution_check(session.machine.failed && execution_text(&session.output, "1\n2\n")
            && execution_text(&session.error, diagnostic), "fast runtime preserves reached-op capability failure");
    }
    puts("Constructor operand order, suspension, receipts and runtime capability passed at both widths.");
}
