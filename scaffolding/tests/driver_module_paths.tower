import tower;
import driver;
import driver_module_paths_test;
import driver_platform_api;
import .host.driver_support;
import .host.driver_platform;
import .host.driver_paths;
import .library.bytes_types;
import .library.bytes_interface;

// This suite needs real filesystem lookup, not an in-memory module provider.
// Reuse the driver runner and keep all fixtures inside one newly created root.
struct DriverImportFiles {
    root: ByteBuffer;
    files: DriverArguments;
    directories: DriverArguments;
}

var DriverImportStdout: i32 = 1;

fn driver_import_close(files: DriverImportFiles*): void {
    for(var i = files.files.values.length; i != 0;) {
        driver_platform_remove(files.files.values.data[--i]);
    }
    for(var i = files.directories.values.length; i != 0;) {
        driver_test_remove_directory(files.directories.values.data[--i]);
    }
    driver_test_remove_directory(files.root.data);
    driver_arguments_dispose(&files.files);
    driver_arguments_dispose(&files.directories);
}

// A null source creates a directory. Names are fixed fixture suffixes, not user
// paths; recording before creation also cleans up a partially written file.
fn driver_import_add(files: DriverImportFiles*, name: u8*, source: u8*): bool {
    var paths = source == null ? &files.directories : &files.files;
    driver_argument(paths, files.root.data, name);
    if !paths.ok { return false; }
    var path = paths.values.data[paths.values.length - 1];
    return source == null ? driver_test_directory(path) : driver_write_file(path, source, strlen(source));
}

fn driver_import_grammar(files: DriverImportFiles*, resources: u8*, name: u8*): bool {
    var path: ByteBuffer = default; var source: ByteBuffer = default;
    defer bytes_dispose(&path); defer bytes_dispose(&source);
    if !driver_text(&path, resources) || !driver_text(&path, name) || !host_text_terminate(&path)
        || !driver_read_file(path.data, &source) { return false; }
    path.length = 0;
    return driver_text(&path, "/library") && driver_text(&path, name) && host_text_terminate(&path)
        && driver_import_add(files, path.data, source.data);
}

fn driver_with_imports(compiler: u8*, resources: u8*, check: function(bool, DriverImportFiles*, u8*)): bool {
    var files: DriverImportFiles = default;
    var marker: ByteBuffer = default;
    defer bytes_dispose(&files.root); defer bytes_dispose(&marker);
    if !driver_platform_temporary(&marker) { return false; }
    defer driver_platform_remove(marker.data);
    if !driver_text(&files.root, marker.data) || !driver_text(&files.root, "_imports")
        || !host_text_terminate(&files.root) || !driver_test_directory(files.root.data) { return false; }
    driver_arguments_init(&files.files); driver_arguments_init(&files.directories);
    defer driver_import_close(&files);
    return driver_mount_imports(&files, resources) && check(&files, compiler);
}

fn driver_all_imports(files: DriverImportFiles*, compiler: u8*): bool {
    return driver_import_checks(files, compiler) && driver_import_companions(files, compiler)
        && driver_run_companions(files, compiler);
}

fn driver_test_module_paths(compiler: u8*, resources: u8*): bool {
    driver_import_identity(compiler, resources);
    var ok = driver_with_imports(compiler, resources, driver_all_imports);
    if ok { driver_platform_write(DriverImportStdout, "Native module paths passed\n", strlen("Native module paths passed\n")); }
    return ok;
}
