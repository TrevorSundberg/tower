import tower;
import .library.vector;
import .compiler.syntax_version_types;
import .compiler.frontend_revision_types;
import .compiler.grammar_types;
import .compiler.syntax_view;
import .compiler.syntax_types;
import .compiler.syntax_emission_types;
import .compiler.parser_table_types;
import frontend_world;
import frontend_format;
import frontend_syntax_preview;
import frontend_revision;
import frontend_emission;
import frontend_pending;
import frontend_replacement_owner;
import frontend_table_owner;

extern fn syntax_version_create(world: void*, grammar: FrontendRevision*, bedrock: FrontendRevision*): SyntaxVersion*;
extern fn syntax_version_retain(value: SyntaxVersion*): SyntaxVersion*;
extern fn syntax_version_release(value: SyntaxVersion*): void;
extern fn syntax_emission_lexicon(value: void*): void*;

fn frontend_syntax_version_tests(): void {
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    var kinds: FrontendKinds;
    frontend_world_check(frontend_world_test_kinds(world, &kinds));
    var source = entity_create(compiler_world_store(world));
    var alternative = frontend_format_child(compiler_world_store(world), source, null);
    preview_syntax(world, alternative).kind = convert(u32, SyntaxKind.Alternative);
    var rule: SyntaxRuleView;
    rule.name = "A";
    rule.name_length = 1;
    rule.alternatives = &alternative;
    rule.count = 1;
    var revision = syntax_revision_create(&rule, 1, null, 0);
    frontend_world_check(revision is not null);
    // Warm entity slots before measuring factory failure paths.
    var warm = syntax_version_create(world, revision, revision);
    frontend_world_check(warm is not null);
    syntax_version_release(warm);
    var buffers = tower_test_buffer_count();
    var allocations = tower_test_buffer_allocations();
    var version = syntax_version_create(world, revision, revision);
    allocations = tower_test_buffer_allocations() - allocations;
    frontend_world_check(version is not null && version.references == 1);
    frontend_world_check(version.rules is not null && version.table is null);
    frontend_world_check(version.grammar == revision && version.bedrock == revision);
    frontend_world_check(version.replacement_error_offset == frontend_world_unlimited());
    frontend_world_check(revision.references == 3);
    syntax_version_release(version);
    frontend_world_check(revision.references == 1 && tower_test_buffer_count() == buffers);
    for (var i: usize = 0; i < allocations; ++i) {
        tower_test_buffer_fail_after(i);
        version = syntax_version_create(world, revision, revision);
        tower_test_buffer_fail_after(frontend_world_unlimited());
        frontend_world_check(version is null && revision.references == 1);
        frontend_world_check(tower_test_buffer_count() == buffers);
    }
    var view = entity_view_open(source);
    frontend_world_check(view is not null);
    frontend_world_check(syntax_version_create(world, revision, revision) is null);
    frontend_world_check(revision.references == 1);
    entity_view_close(view);
    version = syntax_version_create(world, revision, revision);
    frontend_world_check(version is not null);
    var input: SyntaxEmissionInput;
    fill(&input, 0, sizeof(SyntaxEmissionInput));
    input.rules = &rule;
    input.count = 1;
    input.category = "A";
    input.root = version.rules;
    input.syntax_kind = kinds.syntax;
    input.rule_kind = kinds.rule;
    input.reference_kind = kinds.reference;
    input.string_kind = kinds.string;
    input.range_kind = kinds.range;
    version.emission = syntax_emit(&input);
    frontend_world_check(version.emission is not null);
    version.lexicon = syntax_emission_lexicon(version.emission);
    frontend_world_check(version.lexicon is not null);
    // A partially constructed table must also be safe to release.
    version.table = bits(void*, parser_table_open(null, &kinds, bits(void*, version), ParserPresentation.Numeric, 0));
    frontend_world_check(version.table is not null);
    version.replacements = syntax_replacement_owner_create(null, version.emission, kinds.syntax, kinds.`match`);
    frontend_world_check(version.replacements is not null && syntax_replacement_freeze(version.replacements));
    var waiting = frontend_format_child(compiler_world_store(world), source, null);
    var term = preview_syntax(world, waiting);
    term.kind = convert(u32, SyntaxKind.Term);
    frontend_world_check(bytes_append(&term.text, "Future", 6));
    frontend_world_check(syntax_pending_create(&rule, 1, &waiting, kinds.syntax, &version.pending));
    frontend_world_check(version.pending is not null);
    frontend_world_check(syntax_version_retain(version) == version);
    syntax_version_release(version);
    frontend_world_check(version.references == 1 && revision.references == 3);
    frontend_revision_release(revision);
    entity_release(source);
    frontend_world_check(frontend_world_clear(world));
    frontend_world_check(!compiler_world_dispose(world));
    frontend_format_text(version.grammar.rules.data[0].name, "A");
    frontend_world_check(syntax_pending_count(version.pending) == 1);
    syntax_version_release(version);
    frontend_world_check(compiler_world_dispose(world));
    frontend_world_check(tower_test_buffer_count() == baseline);
    frontend_world_check(syntax_version_retain(null) is null);
    syntax_version_release(null);
}
