import tower;
import .library.vector;
import .compiler.syntax_version_types;
import .compiler.frontend_revision_types;
import .compiler.grammar_types;
import .compiler.syntax_view;
import .compiler.syntax_types;
import .compiler.syntax_emission_types;
import .compiler.parser_table_types;
import frontend_world;
import frontend_format;
import frontend_syntax_preview;
import frontend_revision;
import frontend_emission;
import frontend_pending;
import frontend_replacement_owner;
import frontend_table_owner;
import frontend_baselines;

extern fn syntax_version_create(world: void*, grammar: FrontendRevision*, bedrock: FrontendRevision*): SyntaxVersion*;
extern fn syntax_version_retain(value: SyntaxVersion*): SyntaxVersion*;
extern fn syntax_version_release(value: SyntaxVersion*): void;
extern fn syntax_emission_lexicon(value: void*): void*;
extern fn syntax_version_build(world: void*, source: FrontendRevision*, bedrock: FrontendRevision*, diagnostic: SyntaxVersionDiagnostic*): SyntaxVersion*;
extern fn syntax_version_bedrock(module: FrontendRevision*, kind: void*, diagnostic: SyntaxVersionDiagnostic*): bool;
extern fn syntax_version_diagnostic_dispose(value: SyntaxVersionDiagnostic*): void;
extern fn syntax_version_diagnostic_text(value: SyntaxVersionDiagnostic*): u8*;
extern fn syntax_version_cache_dispose(value: SyntaxVersionCache*): void;
extern fn syntax_version_cache_copy(target: SyntaxVersionCache*, source: SyntaxVersionCache*): bool;
extern fn syntax_version_cached(value: SyntaxVersionCache*, world: void*, definitions: FrontendRevision*, bedrock: FrontendRevision*, diagnostic: SyntaxVersionDiagnostic*): SyntaxVersion*;

fn frontend_version_cache_tests(world: void*, revision: FrontendRevision*, bedrock: FrontendRevision*): void {
    var buffers = tower_test_buffer_count();
    var cache: SyntaxVersionCache;
    var fork: SyntaxVersionCache;
    var diagnostic: SyntaxVersionDiagnostic;
    fill(&cache, 0, sizeof(SyntaxVersionCache));
    fill(&fork, 0, sizeof(SyntaxVersionCache));
    fill(&diagnostic, 0, sizeof(SyntaxVersionDiagnostic));
    var calls = tower_test_buffer_allocations();
    var version = syntax_version_cached(&cache, world, revision, bedrock, &diagnostic);
    calls = tower_test_buffer_allocations() - calls;
    frontend_world_check(version is not null && version.references == 2);
    frontend_world_check(cache.index.builds == 1 && cache.index.entries.length == 1);
    tower_test_buffer_fail_after(0);
    var hit = syntax_version_cached(&cache, world, revision, bedrock, &diagnostic);
    frontend_world_check(hit == version && cache.index.hits == 1);
    frontend_world_check(syntax_version_cache_copy(&cache, &cache));
    tower_test_buffer_fail_after(frontend_world_unlimited());
    syntax_version_release(hit);
    var copying = tower_test_buffer_allocations();
    frontend_world_check(syntax_version_cache_copy(&fork, &cache));
    copying = tower_test_buffer_allocations() - copying;
    frontend_world_check(version.references == 3);
    var entries = fork.index.entries.data;
    var slots = fork.versions.data;
    var copied_buffers = tower_test_buffer_count();
    for (var i: usize = 0; i < copying; ++i) {
        tower_test_buffer_fail_after(i);
        frontend_world_check(!syntax_version_cache_copy(&fork, &cache));
        tower_test_buffer_fail_after(frontend_world_unlimited());
        frontend_world_check(fork.index.entries.data == entries && fork.versions.data == slots);
        frontend_world_check(version.references == 3 && tower_test_buffer_count() == copied_buffers);
    }
    syntax_version_cache_dispose(&cache);
    frontend_world_check(version.references == 2);
    hit = syntax_version_cached(&fork, world, revision, bedrock, &diagnostic);
    frontend_world_check(hit == version);
    syntax_version_release(hit);
    syntax_version_cache_dispose(&fork);
    frontend_world_check(version.references == 1 && version.table is not null);
    syntax_version_release(version);
    syntax_version_diagnostic_dispose(&diagnostic);
    frontend_world_check(tower_test_buffer_count() == buffers);
    for (var i: usize = 0; i < calls; ++i) {
        tower_test_buffer_fail_after(i);
        version = syntax_version_cached(&cache, world, revision, bedrock, &diagnostic);
        tower_test_buffer_fail_after(frontend_world_unlimited());
        if cache.index.entries.length != 0 {
            frontend_world_check(version is not null && cache.index.entries.length == 1);
            frontend_world_check(cache.versions.data[cache.index.entries.data[0].slot] == version);
        }
        syntax_version_release(version);
        syntax_version_cache_dispose(&cache);
        syntax_version_diagnostic_dispose(&diagnostic);
        frontend_world_check(tower_test_buffer_count() == buffers);
    }
}

fn frontend_syntax_version_tests(): void {
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    var kinds: FrontendKinds;
    frontend_world_check(frontend_world_test_kinds(world, &kinds));
    var source = entity_create(compiler_world_store(world));
    var alternative = frontend_format_child(compiler_world_store(world), source, null);
    preview_syntax(world, alternative).kind = convert(u32, SyntaxKind.Alternative);
    var rule: SyntaxRuleView;
    rule.name = "A";
    rule.name_length = 1;
    rule.alternatives = &alternative;
    rule.count = 1;
    var revision = syntax_revision_create(&rule, 1, null, 0);
    frontend_world_check(revision is not null);
    // Warm entity slots before measuring factory failure paths.
    var warm = syntax_version_create(world, revision, revision);
    frontend_world_check(warm is not null);
    syntax_version_release(warm);
    var buffers = tower_test_buffer_count();
    var allocations = tower_test_buffer_allocations();
    var version = syntax_version_create(world, revision, revision);
    allocations = tower_test_buffer_allocations() - allocations;
    frontend_world_check(version is not null && version.references == 1);
    frontend_world_check(version.rules is not null && version.table is null);
    frontend_world_check(version.grammar == revision && version.bedrock == revision);
    frontend_world_check(version.replacement_error_offset == frontend_world_unlimited());
    frontend_world_check(revision.references == 3);
    syntax_version_release(version);
    frontend_world_check(revision.references == 1 && tower_test_buffer_count() == buffers);
    for (var i: usize = 0; i < allocations; ++i) {
        tower_test_buffer_fail_after(i);
        version = syntax_version_create(world, revision, revision);
        tower_test_buffer_fail_after(frontend_world_unlimited());
        frontend_world_check(version is null && revision.references == 1);
        frontend_world_check(tower_test_buffer_count() == buffers);
    }
    var view = entity_view_open(source);
    frontend_world_check(view is not null);
    frontend_world_check(syntax_version_create(world, revision, revision) is null);
    frontend_world_check(revision.references == 1);
    entity_view_close(view);
    version = syntax_version_create(world, revision, revision);
    frontend_world_check(version is not null);
    var input: SyntaxEmissionInput;
    fill(&input, 0, sizeof(SyntaxEmissionInput));
    input.rules = &rule;
    input.count = 1;
    input.category = "A";
    input.root = version.rules;
    input.syntax_kind = kinds.syntax;
    input.rule_kind = kinds.rule;
    input.reference_kind = kinds.reference;
    input.string_kind = kinds.string;
    input.range_kind = kinds.range;
    version.emission = syntax_emit(&input);
    frontend_world_check(version.emission is not null);
    version.lexicon = syntax_emission_lexicon(version.emission);
    frontend_world_check(version.lexicon is not null);
    // A partially constructed table must also be safe to release.
    version.table = bits(void*, parser_table_open(null, &kinds, bits(void*, version), ParserPresentation.Numeric, 0));
    frontend_world_check(version.table is not null);
    version.replacements = syntax_replacement_owner_create(null, version.emission, kinds.syntax, kinds.`match`);
    frontend_world_check(version.replacements is not null && syntax_replacement_freeze(version.replacements));
    var waiting = frontend_format_child(compiler_world_store(world), source, null);
    var term = preview_syntax(world, waiting);
    term.kind = convert(u32, SyntaxKind.Term);
    frontend_world_check(bytes_append(&term.text, "Future", 6));
    frontend_world_check(syntax_pending_create(&rule, 1, &waiting, kinds.syntax, &version.pending));
    frontend_world_check(version.pending is not null);
    frontend_world_check(syntax_version_retain(version) == version);
    syntax_version_release(version);
    frontend_world_check(version.references == 1 && revision.references == 3);
    frontend_revision_release(revision);
    entity_release(source);
    frontend_world_check(frontend_world_clear(world));
    frontend_world_check(!compiler_world_dispose(world));
    frontend_format_text(version.grammar.rules.data[0].name, "A");
    frontend_world_check(syntax_pending_count(version.pending) == 1);
    syntax_version_release(version);
    frontend_world_check(compiler_world_dispose(world));
    frontend_world_check(tower_test_buffer_count() == baseline);
    frontend_world_check(syntax_version_retain(null) is null);
    syntax_version_release(null);
}

fn frontend_syntax_construction_tests(): void {
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    var store = compiler_world_store(world);
    var kinds: FrontendKinds;
    frontend_world_check(frontend_world_test_kinds(world, &kinds));
    var source = entity_create(store);
    var alternatives: void*[2];
    var rules: SyntaxRuleView[2];
    var terms: SyntaxNode*[2];
    for (var i: usize = 0; i < 2; ++i) {
        alternatives[i] = frontend_format_child(store, source, null);
        var sequence = preview_syntax(world, alternatives[i]);
        sequence.kind = convert(u32, SyntaxKind.Alternative);
        var child = frontend_format_child(store, alternatives[i], null);
        terms[i] = preview_syntax(world, child);
        terms[i].kind = convert(u32, SyntaxKind.Term);
        terms[i].literal = i == 0;
        frontend_world_check(bytes_append(&terms[i].text, i == 0 ? "x" : "Missing", i == 0 ? 1 : 7));
        frontend_world_check(vector_push(void*, &sequence.items, child));
        rules[i].name = i == 0 ? "Statement" : "Future";
        rules[i].name_length = i == 0 ? 9 : 6;
        rules[i].alternatives = &alternatives[i];
        rules[i].count = 1;
    }
    var revision = syntax_revision_create(&rules[0], 2, null, 0);
    var bedrock = syntax_world_revision(world, SyntaxSeedBaseline());
    frontend_world_check(revision is not null && bedrock is not null);
    var diagnostic: SyntaxVersionDiagnostic;
    fill(&diagnostic, 0, sizeof(SyntaxVersionDiagnostic));
    diagnostic.offset = frontend_world_unlimited();
    var version = syntax_version_build(world, revision, bedrock, &diagnostic);
    frontend_world_check(version is not null);
    frontend_world_check(version.table is not null && version.lexicon is not null);
    frontend_world_check(syntax_pending_count(version.pending) == 1);
    frontend_world_check(syntax_revision_rule(version.grammar, "Future", 6) is null);
    frontend_world_check(syntax_revision_rule(revision, "Future", 6) is not null);
    frontend_format_text(syntax_version_diagnostic_text(&diagnostic), "");
    syntax_version_release(version);
    syntax_version_diagnostic_dispose(&diagnostic);
    var buffers = tower_test_buffer_count();
    var allocations = tower_test_buffer_allocations();
    version = syntax_version_build(world, revision, bedrock, &diagnostic);
    frontend_world_check(version is not null);
    allocations = tower_test_buffer_allocations() - allocations;
    syntax_version_release(version);
    syntax_version_diagnostic_dispose(&diagnostic);
    frontend_world_check(tower_test_buffer_count() == buffers);
    for (var i: usize = 0; i < allocations; ++i) {
        tower_test_buffer_fail_after(i);
        version = syntax_version_build(world, revision, bedrock, &diagnostic);
        tower_test_buffer_fail_after(frontend_world_unlimited());
        // Optional analysis/storage may degrade gracefully, but every outcome
        // must own a complete releasable result and leave source pins intact.
        if version is not null { frontend_world_check(version.table is not null && version.lexicon is not null); }
        else { frontend_world_check(syntax_version_diagnostic_text(&diagnostic)[0] != 0); }
        syntax_version_release(version);
        syntax_version_diagnostic_dispose(&diagnostic);
        frontend_world_check(revision.references == 1 && bedrock.references == 2);
        frontend_world_check(tower_test_buffer_count() == buffers);
    }
    frontend_version_cache_tests(world, revision, bedrock);
    // Module completion reports unresolved rules, unlike the execution filter.
    frontend_world_check(!syntax_version_bedrock(revision, kinds.syntax, &diagnostic));
    frontend_world_check(diagnostic.text.length != 0);
    syntax_version_diagnostic_dispose(&diagnostic);
    // Validation errors retain their complete text, including a terminating NUL
    // for the native transport, without replacing the current source revision.
    terms[0].literal = false;
    vector_dispose(u8, &terms[0].text);
    frontend_world_check(bytes_append(&terms[0].text, "Statement", 9));
    version = syntax_version_build(world, revision, bedrock, &diagnostic);
    frontend_world_check(version is null);
    frontend_format_text(syntax_version_diagnostic_text(&diagnostic), "Unproductive grammar rule: Statement");
    syntax_version_diagnostic_dispose(&diagnostic);
    frontend_revision_release(revision);
    frontend_revision_release(bedrock);
    entity_release(source);
    frontend_world_check(frontend_world_clear(world));
    frontend_world_check(compiler_world_dispose(world));
    frontend_world_check(tower_test_buffer_count() == baseline);
}
