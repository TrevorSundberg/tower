import tower;
import declaration_attribute_checks_test;
import execution_support;

fn declaration_attribute_tests(modules: void*, root: u8*): void {
    attribute_import_cycle(modules, root);
    attribute_typed_values(modules, root);
    attribute_reject_scalar(modules, root);
    attribute_reject_duplicate(modules, root);
    attribute_reject_output(modules, root);
    attribute_reject_missing_field(modules, root);
    attribute_reject_unknown_field(modules, root);
    attribute_reject_runtime_capture(modules, root);
    puts("Declaration attributes: typed constructors, callbacks, arrays, diagnostics, Foundation and workers pass.");
}
