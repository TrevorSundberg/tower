import tower;
import .library.work_budget_types;

// The LLVM diagnostic and compiled text are borrowed for the callback only.
struct ConstantOperandResult {
    accepted: bool; diagnostic: u8*; resource: WorkBudgetError; offset: usize;
    nodes_before: usize; nodes_after: usize; components_before: usize; components_after: usize;
    children: usize; has_semantic: bool;
}
struct ConstantAddressChecks {
    verified: function(void, bool);
    operand: function(void, ConstantOperandResult*, bool);
    compiled: function(void, u32, usize, u8*, u8*, u8*);
}
extern fn backend_source_native_run(argc: i32, argv: u8**, checks: ConstantAddressChecks*): i32;
extern fn backend_constant_operand_rejection(world: void*, width: u32, checks: ConstantAddressChecks*): void;
