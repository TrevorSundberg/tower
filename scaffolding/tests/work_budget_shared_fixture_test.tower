import .library.testing;
import work_budget_shared_fixture;
import .library.work_budget;
import .library.work_budget_types;
import .library.work_pool;
import .library.work_gate;

var BudgetSharedRounds: usize = 2048;
var BudgetSharedBytes: usize = 8192;
var BudgetSharedExtraLanes: usize = 8;

fn budget_shared_workers(capacity: usize): usize {
    var available = work_thread_capacity();
    var count = available < capacity ? available : capacity;
    assert(count >= 2, "Shared work budget requires at least two available workers");
    return count;
}

export fn work_kernel_execute(payload: void*): void {
    var job = bits(BudgetJob*, payload);
    job.thread = pthread_self();
    work_signal_post(job.entered);
    work_signal_wait(job.release);
    for(var round: usize = 0; round < BudgetSharedRounds; round++) {
        if work_budget_validate_result(job.budget, &job.parent) != WorkBudgetError.None { return; }
        var extra: WorkReservation = default;
        if work_budget_reserve_result(job.budget, 0, BudgetSharedExtraLanes, BudgetSharedBytes, &extra) != WorkBudgetError.None { return; }
        // This worker's live bytes guarantee denial, independent of peer order.
        var denied: WorkReservation = default;
        if work_budget_reserve_result(job.budget, 0, 0, job.budget.bytes, &denied) != WorkBudgetError.Capacity
            || denied.active || denied.owner != null { return; }
        var memory = alloc(u8, BudgetSharedBytes);
        if memory == null { work_budget_release(job.budget, &extra); return; }
        var value = convert(u8, round % 256);
        fill(memory, value, BudgetSharedBytes);
        var correct = memory[0] == value && memory[BudgetSharedBytes - 1] == value;
        free(memory);
        if work_budget_validate_result(job.budget, &extra) != WorkBudgetError.None { return; }
        var old = extra;
        if work_budget_release_result(job.budget, &extra) != WorkBudgetError.None { return; }
        if work_budget_validate_result(job.budget, &old) != WorkBudgetError.Stale
            || work_budget_release_result(job.budget, &old) != WorkBudgetError.Stale || !correct { return; }
        var snapshot: WorkBudgetSnapshot;
        if !work_budget_snapshot(job.budget, &snapshot) || snapshot.used_lanes > snapshot.lanes
            || snapshot.used_bytes > snapshot.bytes { return; }
        job.completed++;
    }
    job.success = true;
}

fn budget_shared(): void {
    var gate = work_gate_open();
    var entered = work_signal_open();
    var release = work_signal_open();
    assert(gate != null && entered != null && release != null);
    defer work_gate_close(gate);
    defer work_signal_close(entered);
    defer work_signal_close(release);
    var jobs: BudgetJob[4] = default;
    var count = budget_shared_workers(sizeof(decltype(jobs)) / sizeof(BudgetJob));
    var budget: WorkBudget = default;
    assert(work_budget_init(&budget, count + BudgetSharedExtraLanes, count * BudgetSharedBytes, 1));
    assert(work_budget_synchronize(&budget, gate, work_gate_enter, work_gate_leave));
    defer work_budget_dispose(&budget);
    defer {
        for(var i: usize = 0; i < count; i++) {
            if jobs[i].parent.active { assert(work_budget_release(&budget, &jobs[i].parent)); }
        }
    }
    var pool: WorkPool = default;
    assert(work_pool_open(&pool, count) && pool.threaded && pool.count == count);
    defer work_pool_close(&pool);
    // Release blocked workers before pool cleanup even on an early return.
    defer { for(var i: usize = 0; i < count; i++) { work_signal_post(release); } }
    for(var i: usize = 0; i < count; i++) {
        assert(work_budget_reserve(&budget, 1, 1, 0, &jobs[i].parent));
        jobs[i].budget = &budget;
        jobs[i].entered = entered;
        jobs[i].release = release;
        assert(work_pool_submit(&pool, bits(void*, &jobs[i])));
    }
    for(var i: usize = 0; i < count; i++) { work_signal_wait(entered); }
    assert(work_pool_receive(&pool, false) == null);
    for(var i: usize = 0; i < count; i++) { work_signal_post(release); }
    while pool.running != 0 { work_pool_receive(&pool, true); }
    for(var i: usize = 0; i < count; i++) {
        assert(jobs[i].success && jobs[i].completed == BudgetSharedRounds && jobs[i].thread != pthread_self());
        for(var j: usize = 0; j < i; j++) { assert(jobs[i].thread != jobs[j].thread); }
        assert(work_budget_validate_result(&budget, &jobs[i].parent) == WorkBudgetError.None
            && work_budget_release(&budget, &jobs[i].parent));
    }
    var snapshot: WorkBudgetSnapshot;
    assert(work_budget_snapshot(&budget, &snapshot));
    assert(snapshot.used_lanes == 0 && snapshot.used_bytes == 0 && snapshot.live == 0);
    assert(snapshot.peak_lanes == budget.lanes && snapshot.peak_bytes <= budget.bytes);
}

struct BudgetWake { signal: void*; calls: usize; }

fn budget_gate_wake(context: void*): void {
    var wake = bits(BudgetWake*, context);
    // Invoked under the exclusive gate: notify only, never reenter the budget.
    wake.calls++;
    work_signal_post(wake.signal);
}

fn budget_gate_reuse(): void {
    var gate = work_gate_open();
    var signal = work_signal_open();
    assert(gate != null && signal != null);
    defer work_gate_close(gate);
    defer work_signal_close(signal);
    var wake = init(BudgetWake) { signal: signal, calls: 0 };
    var budget: WorkBudget = default;
    assert(work_budget_init(&budget, 1, BudgetSharedBytes, 1)
        && work_budget_synchronize(&budget, gate, work_gate_enter, work_gate_leave)
        && work_budget_set_wake(&budget, bits(void*, &wake), budget_gate_wake));
    var parent: WorkReservation = default;
    var bytes: WorkReservation = default;
    var denied: WorkReservation = default;
    assert(work_budget_reserve(&budget, 1, 1, 0, &parent)
        && work_budget_reserve(&budget, 0, 0, budget.bytes, &bytes));
    assert(work_budget_reserve_result(&budget, 1, 1, 0, &denied) == WorkBudgetError.Capacity
        && !denied.active && !work_signal_try(signal));
    assert(work_budget_reserve_result(&budget, 0, 0, 1, &denied) == WorkBudgetError.Capacity
        && !denied.active && budget.used_lanes == budget.lanes && budget.used_bytes == budget.bytes);
    var old = bytes;
    assert(work_budget_release(&budget, &bytes) && !work_signal_try(signal));
    assert(work_budget_reserve(&budget, 0, 0, budget.bytes, &bytes)
        && bytes.slot == old.slot && bytes.generation != old.generation
        && work_budget_release_result(&budget, &old) == WorkBudgetError.Stale);
    assert(work_budget_release(&budget, &bytes) && work_budget_release(&budget, &parent)
        && work_signal_try(signal) && !work_signal_try(signal) && wake.calls == 1, "Only the armed lane release wakes the coordinator");
    assert(work_budget_reserve(&budget, 1, 1, 0, &parent));
    old = parent;
    assert(work_budget_release(&budget, &parent) && !work_signal_try(signal)
        && work_budget_set_wake(&budget, null, null) && work_budget_dispose(&budget));
    // Reuse the same stable host owner for a new ledger revision only after drain.
    assert(work_budget_init(&budget, 1, BudgetSharedBytes, 2)
        && work_budget_synchronize(&budget, gate, work_gate_enter, work_gate_leave)
        && work_budget_reserve(&budget, 1, 1, 0, &parent)
        && work_budget_validate_result(&budget, &old) == WorkBudgetError.Stale
        && work_budget_release(&budget, &parent));
    var snapshot: WorkBudgetSnapshot = default;
    assert(work_budget_snapshot(&budget, &snapshot) && snapshot.live == 0
        && snapshot.used_bytes == 0 && snapshot.used_lanes == 0 && work_budget_dispose(&budget));
}

struct BudgetGateCounter { gate: void*; entered: void*; value: usize; inverse: usize; }
struct BudgetGateJob {
    counter: BudgetGateCounter*; rounds: usize; completed: usize; thread: usize; cancel: bool;
}

fn budget_gate_increment(payload: void*): void {
    var job = bits(BudgetGateJob*, payload);
    var counter = job.counter;
    job.thread = pthread_self();
    work_signal_post(counter.entered);
    for(var round: usize = 0; round < job.rounds; round++) {
        work_gate_enter(counter.gate);
        // The coordinator publishes cancellation while holding this same gate.
        if job.cancel { work_gate_leave(counter.gate); return; }
        assert(counter.inverse == ~counter.value, "Gate must protect both counter fields");
        counter.value++;
        counter.inverse = ~counter.value;
        work_gate_leave(counter.gate);
        job.completed++;
    }
}

fn budget_gate_contention(): void {
    var counter = init(BudgetGateCounter) {gate: work_gate_open(), entered: work_signal_open(),
        value: 0, inverse: ~convert(usize, 0)};
    assert(counter.gate != null && counter.entered != null);
    defer work_gate_close(counter.gate); defer work_signal_close(counter.entered);
    var jobs: BudgetGateJob[4] = default;
    var count = budget_shared_workers(sizeof(decltype(jobs)) / sizeof(BudgetGateJob));
    var pool: WorkPool = default;
    assert(work_pool_open_kernel(&pool, count, budget_gate_increment) && pool.threaded && pool.count == count);
    defer work_pool_close(&pool);
    for(var cycle: usize = 0; cycle < 2; cycle++) {
        var total = counter.value;
        // Hold across admission: all admitted real workers must wait on the gate,
        // not an assumed short callback. Reuse it after the complete join.
        work_gate_enter(counter.gate);
        for(var i: usize = 0; i < count; i++) {
            jobs[i] = init(BudgetGateJob) {counter: &counter,
                rounds: BudgetSharedRounds * (i + 1) / count, ..default};
            assert(work_pool_submit(&pool, bits(void*, &jobs[i])));
        }
        for(var i: usize = 0; i < count; i++) { work_signal_wait(counter.entered); }
        assert(work_pool_receive(&pool, false) == null);
        jobs[0].cancel = cycle != 0;
        work_gate_leave(counter.gate);
        while pool.running != 0 { work_pool_receive(&pool, true); }
        for(var i: usize = 0; i < count; i++) {
            var completed = jobs[i].cancel ? convert(usize, 0) : jobs[i].rounds;
            assert(jobs[i].completed == completed && jobs[i].thread != pthread_self());
            for(var j: usize = 0; j < i; j++) { assert(jobs[i].thread != jobs[j].thread); }
            total += completed;
        }
        assert(counter.value == total && counter.inverse == ~total && pool.running == 0);
    }
}

test() { budget_shared(); }
test() { budget_gate_reuse(); }
test() { budget_gate_contention(); }
