import tower;
import syntax_live_support;
import .compiler.syntax_session_types;
import .compiler.syntax_types;
import .compiler.format_types;
import .library.bytes_types;
import .library.bytes_interface;
import storage_api;
import utility_checks;

fn live_seed_tests(): void {
    var allocations: LiveAllocations; live_allocations(&allocations); defer live_released(&allocations);
    {
        var case_allocations: LiveAllocations; live_allocations(&case_allocations); defer live_released(&case_allocations);
        var source = "parse __number = Number;parse `document(0)` = __number;parse Statement = 'assignment' GrammarAssignment ';' | `document(0)` ';';assignment =;assignment |=;42;";
        var session = live_open(source); defer syntax_destroy(bits(void*, session)); live_declarations(session, 6); live_end(session);
        var whitespace: usize = 0;
        for (var index: usize = 0; index < session.pins.grammar.tokens.length; ++index) {
            if live_text(&syntax_get(session.pins.grammar.tokens.data[index]).name, "Whitespace") { ++whitespace; }
        }
        utility_check(whitespace == 1, "Bedrock shared token inherited once");
    }
    {
        var case_allocations: LiveAllocations; live_allocations(&case_allocations); defer live_released(&case_allocations);
        var source: FormatResult; fill(&source, 0, sizeof(FormatResult)); defer format_dispose(&source); live_format(&source, syntax_native_bedrock());
        var session = bits(SyntaxSession*, syntax_completion_create(source.text.data, 2)); defer syntax_destroy(bits(void*, session));
        loop {
            var root = syntax_next(bits(void*, session)); if root is null { break; }
            var declaration = tower_node_get_child(root, 0);
            utility_check(syntax_get(declaration) is not null, "Parsed Bedrock declaration has shared syntax component"); live_match(declaration); tower_node_release_ref(root);
        }
        if *syntax_get_error(bits(void*, session)) != 0 { puts(syntax_get_error(bits(void*, session))); }
        utility_check(*syntax_get_error(bits(void*, session)) == 0, "Canonical Bedrock parses");
        var document = session.inputs.document; tower_node_add_ref(document); defer tower_node_release_ref(document);
        utility_check(syntax_equal(document, syntax_native_bedrock(), false), "Parsed Bedrock equals immutable shared seed");
        var actual: FormatResult; fill(&actual, 0, sizeof(FormatResult)); defer format_dispose(&actual); var error: u8* = null;
        utility_check(syntax_format_into(bits(void*, session), &actual, &error), "Canonical Bedrock session formatting"); live_format_equal(&actual, &source);
        var declaration: void* = null; var data = syntax_get(document);
        for (var index: usize = 0; index < data.items.length; ++index) { if live_text(&syntax_get(data.items.data[index]).name, "GrammarDeclaration") { declaration = data.items.data[index]; } }
        utility_check(declaration is not null, "Find declaration semantic entity");
        var literal = syntax_get(syntax_get(declaration).items.data[0]).items.data[0];
        utility_check(live_text(&syntax_get(literal).text, "parse"), "Grammar literal semantic text"); live_match(literal);
        utility_check(storage_assign(&syntax_get(literal).text, "rule", 4), "Edit shared grammar semantic text");
        var changed: FormatResult; fill(&changed, 0, sizeof(FormatResult)); defer format_dispose(&changed); live_format(&changed, document);
        utility_check(strstr(changed.text.data, "= 'rule'") is not null, "Formatter observes semantic edit");
        format_dispose(&actual); live_format(&actual, syntax_native_bedrock()); live_format_equal(&actual, &source);
        syntax_destroy(bits(void*, session)); session = null;
        format_dispose(&actual); live_format(&actual, document); live_format_equal(&actual, &changed);
        utility_check(live_match(literal).start < source.text.length, "Retained document keeps parse provenance after session destruction");
    }
}
fn live_replacement_tests(): void {
    var allocations: LiveAllocations; live_allocations(&allocations); defer live_released(&allocations);
    {
        var case_allocations: LiveAllocations; live_allocations(&case_allocations); defer live_released(&case_allocations);
        var source: ByteBuffer; fill(&source, 0, sizeof(ByteBuffer)); defer bytes_dispose(&source);
        live_join(&source, live_base(), "parse Expression |= 'one' => replace { 1 };parse Expression |= 'alias' => replace { one };parse Expression |= 'keep' '(' $value:Expression ')' => replace { $value };", "keep(alias);");
        var session = live_open(source.data); defer syntax_destroy(bits(void*, session)); live_declarations(session, 6);
        var result = live_next(session); defer tower_node_release_ref(result); var literal = live_find(result, "1");
        utility_check(literal is not null && live_find(result, "one") is null && live_find(result, "alias") is null && live_find(result, "keep") is null, "Replacement chains splice final captured tree");
        utility_check(session.expansion_stats.replacements == 3, "Three replacements executed");
        var origin = syntax_get_origin(literal);
        utility_check(origin is not null && origin.generated && origin.expansion is not null, "Replacement origin records generated tree and expansion");
        utility_check(live_span(source.data, origin.template_start, origin.template_end - origin.template_start, "1"), "Exact replacement template source");
        live_source(literal, source.data, "alias"); utility_check(origin.expansion.previous is not null, "Replacement chain retains previous expansion");
        syntax_destroy(bits(void*, session)); session = null;
        utility_check(live_text(&syntax_get_origin(literal).expansion.rule, "Expression"), "Retained expansion rule after session destruction"); live_dump_contains(result, "1");
    }
    {
        var case_allocations: LiveAllocations; live_allocations(&case_allocations); defer live_released(&case_allocations);
        var source: ByteBuffer; fill(&source, 0, sizeof(ByteBuffer)); defer bytes_dispose(&source);
        live_join(&source, live_base(), "parse Block = '{' $Statement* '}';parse Statement |= Block;parse Statement |= 'twice' '{' $body:Statement* '}' => replace { { $body $body } };", "twice { a; b; }twice {}");
        var session = live_open(source.data); defer syntax_destroy(bits(void*, session)); live_declarations(session, 6);
        var result = live_next(session); defer tower_node_release_ref(result); var block = live_find(result, "Block"); utility_check(block is not null, "Replacement block");
        var body = tower_node_get_child_member(block, "Statement"); utility_check(body is not null && tower_node_get_child_count(body) == 4, "Repeated capture copies entire forest");
        live_source(tower_node_get_child(body, 0), source.data, "a;"); live_source(tower_node_get_child(body, 1), source.data, "b;"); live_source(tower_node_get_child(body, 2), source.data, "a;");
        utility_check(tower_node_get_id(tower_node_get_child(body, 0)) != tower_node_get_id(tower_node_get_child(body, 2)) && session.expansion_stats.copied_nodes > 0, "Repeated capture owns distinct copied nodes");
        var empty = live_next(session); defer tower_node_release_ref(empty);
        utility_check(tower_node_get_child_count(tower_node_get_child_member(live_find(empty, "Block"), "Statement")) == 0, "Empty capture forest");
    }
    {
        var case_allocations: LiveAllocations; live_allocations(&case_allocations); defer live_released(&case_allocations);
        var source: ByteBuffer; fill(&source, 0, sizeof(ByteBuffer)); defer bytes_dispose(&source);
        live_join(&source, live_base(), "parse Alias = 'named' => replace { 9 };parse Expression |= Alias;", "named;");
        var session = live_open(source.data); defer syntax_destroy(bits(void*, session)); live_declarations(session, 5);
        var result = live_next(session); defer tower_node_release_ref(result);
        utility_check(live_find(result, "9") is not null && live_find(result, "Alias") is null, "Named helper replacement acquires destination");
    }
    var bad: u8*[4]; bad[0] = "parse Expression |= 'bad' => replace { $Missing };";
    bad[1] = "parse Expression |= 'bad' '(' $value:Expression ')' => replace { $value; };";
    bad[2] = "parse Expression |= 'bad' => replace { 1 ";
    bad[3] = "parse Expression |= 'bad' '(' $value:Expression ')' => replace { 1 };bad(unknown);";
    for (var index: usize = 0; index < 4; ++index) {
        var source: ByteBuffer; fill(&source, 0, sizeof(ByteBuffer)); defer bytes_dispose(&source); live_join(&source, live_base(), bad[index], "");
        var session = live_open(source.data); defer syntax_destroy(bits(void*, session)); live_declarations(session, 3);
        if index == 3 {
            live_declarations(session, 1); var result = live_next(session); defer tower_node_release_ref(result);
            utility_check(live_find(result, "1") is not null && live_find(result, "unknown") is null, "Unused replacement capture may be discarded");
        } else { live_failure(session); utility_check(session.revision == 3, "Invalid replacement does not publish revision"); }
    }
    {
        var case_allocations: LiveAllocations; live_allocations(&case_allocations); defer live_released(&case_allocations);
        var source: ByteBuffer; fill(&source, 0, sizeof(ByteBuffer)); defer bytes_dispose(&source); live_join(&source, live_base(), "parse Expression |= 'again' => replace { again };again;", "");
        var session = live_open(source.data); defer syntax_destroy(bits(void*, session)); live_declarations(session, 4); live_failure(session);
        utility_check(strstr(syntax_get_error(bits(void*, session)), "limit exceeded") is not null, "Recursive replacement limit diagnosed");
    }
}
