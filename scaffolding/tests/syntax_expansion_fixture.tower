import tower;
import .compiler.syntax_expansion_types;
import .compiler.parser_types;

extern fn entity_create_related(context: void*): void*;
extern fn entity_component_add(node: void*, kind: void*): void*;
extern fn entity_component_data(component: void*): void*;
extern fn node_payload_init(kind: u32, data: void*): void;
extern fn node_match_set_label(data: ParserMatchData*, text: u8*): bool;
extern fn entity_attach(node: void*, parent: void*, name: u8*): bool;
extern fn entity_release(node: void*): usize;
extern fn syntax_expansion_result_dispose(result: SyntaxExpansionResult*): void;
extern fn syntax_expand(input: SyntaxExpansionInput*, result: SyntaxExpansionResult*): bool;
extern fn tower_test_buffer_count(): usize;
extern fn tower_test_buffer_fail_after(count: usize): void;
struct ExpansionFixture {
    input: SyntaxExpansionInput;
    result: SyntaxExpansionResult;
    rule: SyntaxExpansionRule;
    capture: SyntaxExpansionCapture;
    slots: SyntaxExpansionRule*[4];
    context: void*;
}

fn expansion_test_node(f: ExpansionFixture*, label: u8*, rule: usize, id: u32, start: usize, length: usize): void* {
    var node = entity_create_related(f.context);
    var component = entity_component_add(node, f.input.match_kind);
    var data = bits(ParserMatchData*, entity_component_data(component));
    node_payload_init(4, bits(void*, data));
    data.rule = rule;
    data.id = id;
    data.start = start;
    data.length = length;
    node_match_set_label(data, label);
    return node;
}

fn expansion_test_child(f: ExpansionFixture*, parent: void*, role: u8*, label: u8*, rule: usize, id: u32): void* {
    var node = expansion_test_node(f, label, rule, id, 18, 5);
    entity_attach(node, parent, role);
    entity_release(node);
    return node;
}

fn expansion_test_init(f: ExpansionFixture*, input: SyntaxExpansionInput*, context: void*, uses: usize, repeated: bool): void {
    fill(f, 0, sizeof(ExpansionFixture));
    copy(&f.input, input, sizeof(SyntaxExpansionInput));
    f.context = context;
    f.input.rules = &f.slots[0];
    f.input.count = sizeof(decltype(f.slots)) / sizeof(SyntaxExpansionRule*);
    f.slots[1] = &f.rule;
    f.rule.rule = "Test";
    f.rule.category = "Statement";
    f.rule.start = 50;
    f.rule.end = 70;
    f.rule.tree = expansion_test_node(f, "Statement", 0, 0, 50, 20);
    f.result.root = expansion_test_node(f, "Statement", 1, 0, 12, 11);
    if uses != 0 {
        f.rule.captures = &f.capture;
        f.rule.count = 1;
        f.capture.name = "value";
        f.capture.uses = uses;
        f.capture.repeated = repeated;
        var capture = expansion_test_child(f, f.result.root, "value", "Expression", 0, 0);
        expansion_test_child(f, capture, null, "x", ~convert(usize, 0), 7);
        for(var i: usize = 0; i != uses; i++) {
            expansion_test_child(f, f.rule.tree, null, "$value", ~convert(usize, 0), 3145728);
        }
    } else {
        expansion_test_child(f, f.rule.tree, null, "42", ~convert(usize, 0), 7);
    }
}

fn expansion_test_dispose(f: ExpansionFixture*): void {
    entity_release(f.result.root);
    entity_release(f.rule.tree);
    syntax_expansion_result_dispose(&f.result);
}

// Existing prefix-failure oracle, shared unchanged by aggregate and focused tests.
fn expansion_test_failures(input: SyntaxExpansionInput*, context: void*): bool {
    var budget: usize = 0;
    loop {
        if budget == 256 { return false; }
        var buffers = tower_test_buffer_count();
        var f: ExpansionFixture;
        expansion_test_init(&f, input, context, 2, true);
        tower_test_buffer_fail_after(budget);
        var ran = syntax_expand(&f.input, &f.result);
        tower_test_buffer_fail_after(~convert(usize, 0));
        expansion_test_dispose(&f);
        if tower_test_buffer_count() != buffers { return false; }
        if ran { return true; }
        budget++;
    }
}
