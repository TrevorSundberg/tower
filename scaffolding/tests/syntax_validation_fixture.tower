import tower;
import .compiler.syntax_types;
import .compiler.syntax_view;
import .library.vector;
import .library.bytes_types;
import .library.bytes_interface;
import storage_api;
import utility_checks;
import validation_oracle;

extern fn syntax_native_bedrock(): void*;
extern fn syntax_component_type(): void*;
extern fn syntax_component_attach(node: void*, kind: u32): SyntaxNode*;
extern fn tower_node_add_ref(node: void*): usize;
extern fn tower_node_attach(child: void*, parent: void*): void;
extern fn syntax_validate(rules: SyntaxRuleView*, count: usize, tokens: void**, token_count: usize, kind: void*, error: ByteBuffer*, offset: usize*, pending: void**): bool;

struct ValidationRule { name: vector(u8); alternatives: vector(void*); }
struct ValidationFixture { rules: vector(ValidationRule*); tokens: vector(void*); }
struct ValidationView { rules: vector(SyntaxRuleView); pending: vector(void*); }
var ValidationNoOffset: usize = ~convert(usize, 0);

fn validation_bytes_compare(a: u8*, an: usize, b: u8*, bn: usize): i32 {
    for (var index: usize = 0; index < an && index < bn; ++index) {
        if a[index] < b[index] { return -1; } if a[index] > b[index] { return 1; }
    }
    return an < bn ? -1 : (an > bn ? 1 : 0);
}
fn validation_rule_clear(rule: ValidationRule*): void {
    for (var index: usize = 0; index < rule.alternatives.length; ++index) { tower_node_release_ref(rule.alternatives.data[index]); }
    vector_dispose(void*, &rule.alternatives);
}
fn validation_rule_dispose(rule: ValidationRule*): void {
    validation_rule_clear(rule); vector_dispose(u8, &rule.name); free(rule);
}
// Sorted test-owned index over the same shared alternative/term entities. The
// independent oracle receives the public borrowed view, exactly as before.
fn validation_find(f: ValidationFixture*, name: u8*, length: usize, create: bool): ValidationRule* {
    var at: usize = 0;
    while at < f.rules.length {
        var rule = f.rules.data[at]; var order = validation_bytes_compare(rule.name.data, rule.name.length, name, length);
        if order == 0 { return rule; } if order > 0 { break; } ++at;
    }
    if !create { return null; }
    var rule = alloc(ValidationRule, 1); utility_check(rule is not null, "Validation fixture rule allocation"); fill(rule, 0, sizeof(ValidationRule));
    utility_check(storage_assign(&rule.name, name, length) && vector_reserve(ValidationRule*, &f.rules, f.rules.length + 1), "Validation fixture rule name/index");
    for (var index = f.rules.length; index > at; --index) { f.rules.data[index] = f.rules.data[index - 1]; }
    f.rules.data[at] = rule; ++f.rules.length; return rule;
}
fn validation_fixture_init(f: ValidationFixture*): void {
    fill(f, 0, sizeof(ValidationFixture));
    var baseline = syntax_get(syntax_native_bedrock());
    for (var index: usize = 0; index < baseline.items.length; ++index) {
        var entity = baseline.items.data[index]; var data = syntax_get(entity);
        if data.kind == convert(u32, SyntaxKind.Rule) {
            var rule = validation_find(f, data.name.data, data.name.length, true);
            for (var item: usize = 0; item < data.items.length; ++item) {
                tower_node_add_ref(data.items.data[item]); utility_check(vector_push(void*, &rule.alternatives, data.items.data[item]), "Retain baseline alternatives");
            }
        } else { utility_check(vector_push(void*, &f.tokens, entity), "Borrow baseline token/skip entities"); }
    }
}
fn validation_fixture_dispose(f: ValidationFixture*): void {
    for (var index: usize = 0; index < f.rules.length; ++index) { validation_rule_dispose(f.rules.data[index]); }
    vector_dispose(ValidationRule*, &f.rules); vector_dispose(void*, &f.tokens);
}
fn validation_erase(f: ValidationFixture*, name: u8*): void {
    for (var index: usize = 0; index < f.rules.length; ++index) {
        var rule = f.rules.data[index];
        if validation_bytes_compare(rule.name.data, rule.name.length, name, strlen(name)) == 0 {
            validation_rule_dispose(rule);
            for (var at = index + 1; at < f.rules.length; ++at) { f.rules.data[at - 1] = f.rules.data[at]; }
            --f.rules.length; return;
        }
    }
}
fn validation_node(kind: SyntaxKind): void* {
    var node = tower_node_create(); syntax_component_attach(node, convert(u32, kind)); return node;
}
fn validation_term_bytes(text: u8*, length: usize, literal: bool, repetition: u8, capture: u8*, capture_length: usize, offset: usize): void* {
    var node = validation_node(SyntaxKind.Term); var data = syntax_get(node);
    utility_check(storage_assign(&data.text, text, length) && storage_assign(&data.capture, capture, capture_length), "Validation term bytes");
    data.literal = literal; data.repetition = repetition; data.start = offset; return node;
}
fn validation_term(text: u8*, literal: bool, repetition: u8, capture: u8*, offset: usize): void* {
    return validation_term_bytes(text, strlen(text), literal, repetition, capture, strlen(capture), offset);
}
fn validation_plain(text: u8*): void* { return validation_term(text, false, 0, "", ValidationNoOffset); }
// Consumes each supplied term reference after attaching it to the shared sequence.
fn validation_sequence(terms: void**, count: usize, offset: usize): void* {
    var node = validation_node(SyntaxKind.Alternative); var data = syntax_get(node); data.start = offset;
    for (var index: usize = 0; index < count; ++index) {
        tower_node_attach(terms[index], node); utility_check(vector_push(void*, &data.items, terms[index]), "Validation sequence items"); tower_node_release_ref(terms[index]);
    }
    return node;
}
fn validation_replace_bytes(f: ValidationFixture*, name: u8*, length: usize, terms: void**, count: usize, offset: usize): void {
    var rule = validation_find(f, name, length, true); var sequence = validation_sequence(terms, count, offset);
    validation_rule_clear(rule); utility_check(vector_push(void*, &rule.alternatives, sequence), "Replace validation rule");
}
fn validation_replace(f: ValidationFixture*, name: u8*, terms: void**, count: usize, offset: usize): void {
    validation_replace_bytes(f, name, strlen(name), terms, count, offset);
}
fn validation_one(f: ValidationFixture*, name: u8*, term: void*): void { validation_replace(f, name, &term, 1, ValidationNoOffset); }
fn validation_two(f: ValidationFixture*, name: u8*, left: void*, right: void*): void {
    var terms: void*[2]; terms[0] = left; terms[1] = right; validation_replace(f, name, &terms[0], 2, ValidationNoOffset);
}
fn validation_empty(f: ValidationFixture*, name: u8*): void { validation_replace(f, name, null, 0, ValidationNoOffset); }
fn validation_view_init(view: ValidationView*, f: ValidationFixture*): void {
    fill(view, 0, sizeof(ValidationView));
    utility_check(vector_reserve(SyntaxRuleView, &view.rules, f.rules.length) && vector_reserve(void*, &view.pending, f.rules.length), "Validation borrowed view allocation");
    view.rules.length = f.rules.length; view.pending.length = f.rules.length;
    fill(view.pending.data, 0, view.pending.length * sizeof(void*));
    for (var index: usize = 0; index < f.rules.length; ++index) {
        var source = f.rules.data[index]; var destination = &view.rules.data[index];
        destination.name = source.name.data; destination.name_length = source.name.length;
        destination.alternatives = source.alternatives.data; destination.count = source.alternatives.length;
    }
}
fn validation_view_dispose(view: ValidationView*): void { vector_dispose(SyntaxRuleView, &view.rules); vector_dispose(void*, &view.pending); }
fn validation_message(error: ByteBuffer*, message: u8*): bool { return error.length == strlen(message) && utility_equal(error.data, message, error.length); }
fn validation_compare(f: ValidationFixture*, message: u8*, wanted_offset: usize): bool {
    var x: ValidationView; validation_view_init(&x, f); defer validation_view_dispose(&x);
    var y: ValidationView; validation_view_init(&y, f); defer validation_view_dispose(&y);
    var a: ByteBuffer; fill(&a, 0, sizeof(ByteBuffer)); var b: ByteBuffer; fill(&b, 0, sizeof(ByteBuffer));
    var ax: usize = 777777; var bx = ax;
    var buffers = tower_test_buffer_count(); var nodes = tower_node_get_allocated_count();
    var actual = syntax_validate(x.rules.data, x.rules.length, f.tokens.data, f.tokens.length, syntax_component_type(), &a, &ax, x.pending.data);
    var reference = validation_oracle(y.rules.data, y.rules.length, f.tokens.data, f.tokens.length, &b, &bx, y.pending.data);
    utility_check(actual == reference && a.length == b.length && utility_equal(a.data, b.data, a.length) && ax == bx, "Validation exact independent reference result, message and offset");
    for (var index: usize = 0; index < x.pending.length; ++index) { utility_check(x.pending.data[index] == y.pending.data[index], "Validation exact pending term identity/order"); }
    if message is not null { utility_check(validation_message(&a, message) && actual == (a.length == 0), "Validation fixed expected diagnostic/result"); }
    if wanted_offset != ValidationNoOffset { utility_check(ax == wanted_offset, "Validation fixed source offset"); }
    var failed = a.length != 0; bytes_dispose(&a); bytes_dispose(&b);
    utility_check(tower_test_buffer_count() == buffers && tower_node_get_allocated_count() == nodes, "Validation temporary cleanup"); return failed;
}
fn validation_expect(f: ValidationFixture*, message: u8*): void { validation_compare(f, message, ValidationNoOffset); }
fn validation_failures(f: ValidationFixture*): void {
    validation_compare(f, null, ValidationNoOffset);
    var view: ValidationView; validation_view_init(&view, f); defer validation_view_dispose(&view);
    var oracle: ByteBuffer; fill(&oracle, 0, sizeof(ByteBuffer)); defer bytes_dispose(&oracle); var offset: usize = 777777;
    var wanted = syntax_validate(view.rules.data, view.rules.length, f.tokens.data, f.tokens.length, syntax_component_type(), &oracle, &offset, view.pending.data);
    var buffers = tower_test_buffer_count(); var nodes = tower_node_get_allocated_count(); var finished = false;
    for (var failure: usize = 0; failure < 1024 && !finished; ++failure) {
        var error: ByteBuffer; fill(&error, 0, sizeof(ByteBuffer)); offset = 123;
        tower_test_buffer_fail_after(failure);
        var success = syntax_validate(view.rules.data, view.rules.length, f.tokens.data, f.tokens.length, syntax_component_type(), &error, &offset, view.pending.data);
        tower_test_buffer_fail_after(~convert(usize, 0)); finished = success || error.length != 0;
        if finished { utility_check(success == wanted && error.length == oracle.length && utility_equal(error.data, oracle.data, error.length), "Validation allocation sweep reaches exact result"); }
        else { for (var index: usize = 0; index < view.pending.length; ++index) { utility_check(view.pending.data[index] is null, "Validation allocation failure clears pending terms"); } }
        bytes_dispose(&error); utility_check(tower_test_buffer_count() == buffers && tower_node_get_allocated_count() == nodes, "Validation allocation failure cleanup");
    }
    utility_check(finished, "Validation allocation sweep terminates");
}
