import tower;
import backend_response_checks_test;
import .backend.session;
import utility_checks;

extern fn printf(format: u8*, before: usize, after: usize, reserved: usize): i32;

export fn backend_response_checks(healthy: bool, buffers: function(usize), allocations: function(usize),
    deny: function(void, usize)): void {
    var initial = check_backend_response(healthy, buffers, allocations, deny);
    printf("buffers_before=%zu buffers_after=%zu reserved_response_bytes=%zu\n", initial, buffers(), backend_session_failure_capacity());
    puts(healthy ? "Backend healthy response profile passed" : "Backend response denial checks passed");
}
