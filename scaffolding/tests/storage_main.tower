import tower;
import .host.driver_types;
import .host.driver_support;
import .host.driver_request;
import .host.driver_api;
import .host.driver_execution;
import .library.bytes_types;
import .library.bytes_interface;
import compiler_storage;
import entity_registry;
import entity_page_faults;
import entity_table_faults;
import utility_checks;

extern fn work_thread_available(): bool;
extern fn work_thread_capacity(): usize;

export fn main(argc: i32, argv: u8**): i32 {
    utility_check(!work_thread_available() && work_thread_capacity() == 1,
        "Storage fault injection requires the single-owner work host");
    utility_check(argc == 2, "Storage test resource root");
    var path: ByteBuffer; fill(&path, 0, sizeof(ByteBuffer));
    defer bytes_dispose(&path);
    utility_check(driver_text(&path, argv[1]) && driver_text(&path, "/foundation.tower") && host_text_terminate(&path), "Storage resource path");
    var options: DriverOptions; fill(&options, 0, sizeof(DriverOptions));
    options.source = path.data; options.bedrock = ""; options.foundation = "";
    var request: DriverRequest;
    utility_check(driver_request_open(&request, &options, argv[1]), "Storage bootstrap snapshots");
    defer driver_request_close(&request);
    driver_request_bind(&request, driver_syntax_slot());
    var result: usize[4];
    driver_syntax_bedrock(&result[0], request.text[DriverBedrockText()].data);
    utility_check(driver_syntax_data(&result[0])[0] == 0, "Storage install Bedrock");
    if driver_syntax_heap(&result[0]) { driver_syntax_delete(driver_syntax_storage(&result[0])); }
    driver_syntax_foundation(&result[0], request.text[DriverFoundationText()].data);
    utility_check(driver_syntax_data(&result[0])[0] == 0, "Storage install Foundation");
    if driver_syntax_heap(&result[0]) { driver_syntax_delete(driver_syntax_storage(&result[0])); }
    // These session fixtures have no imports, matching the old parser harness.
    // Keep the resource request owned, without lending its module cache.
    *request.slot = null;
    compiler_storage_tests();
    entity_registry_tests();
    entity_page_fault_tests();
    entity_table_fault_tests();
    return 0;
}
