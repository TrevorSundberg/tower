import tower;
import utility_checks;
import .tools.bootstrap_install;
import .tools.tool_files_posix;
import .tools.tool_files_linux;
import .tools.tool_streams_posix;
import .tools.tool_read_beneath_linux;
import .library.bytes;
import .library.bytes_types;
import .host.driver_files;

extern fn symlink(target: u8*, path: u8*): i32;
extern fn rename(source: u8*, destination: u8*): i32;
extern fn mkfifo(path: u8*, mode: u32): i32;

fn install_fixture_copy(source: u8*, destination: u8*): void {
    var data: ByteBuffer = default; defer bytes_dispose(&data);
    utility_check(tool_read_file(source, InstallArchiveLimit, &data) && tool_output_parents(destination)
        && driver_write_file(destination, data.data, data.length), "copy isolated installer input");
}
fn install_fixture_reject(root: u8*, cache: u8*, output: ByteBuffer*): void {
    var saved = output.data; var length = output.length;
    utility_check(!bootstrap_install(root, cache, output) && output.data == saved && output.length == length,
        "installer failure preserves output");
}

export fn main(argc: i32, argv: u8**): i32 {
    var arguments: i32 = 3; var usage: i32 = 2; var directory_mode: u32 = 448;
    if argc != arguments { puts("Usage: bootstrap_install_checks BOOTSTRAP_DIRECTORY NEW_FIXTURE_DIRECTORY"); return usage; }
    var root = argv[2];
    utility_check(mkdir(root, directory_mode) == 0, "new isolated installer fixture");
    var path: ByteBuffer = default; var source: ByteBuffer = default; var fixture: ByteBuffer = default;
    var cache: ByteBuffer = default; var compiler: ByteBuffer = default; var repeated: ByteBuffer = default;
    var data: ByteBuffer = default; var outside: ByteBuffer = default; var member_path: ByteBuffer = default;
    var archive_path: ByteBuffer = default; var manifest_path: ByteBuffer = default;
    defer bytes_dispose(&path); defer bytes_dispose(&source); defer bytes_dispose(&fixture); defer bytes_dispose(&cache);
    defer bytes_dispose(&compiler); defer bytes_dispose(&repeated); defer bytes_dispose(&data); defer bytes_dispose(&outside);
    defer bytes_dispose(&member_path); defer bytes_dispose(&archive_path); defer bytes_dispose(&manifest_path);
    var manifest: InstallManifest = default; defer install_manifest_dispose(&manifest);
    utility_check(tool_join(&path, argv[1], "development.json") && install_manifest_read(path.data, &manifest)
        && tool_join(&fixture, root, "source") && tool_join(&manifest_path, fixture.data, "development.json"), "source manifest");
    install_fixture_copy(path.data, manifest_path.data);
    utility_check(tool_join(&source, argv[1], manifest.archive) && tool_join(&archive_path, fixture.data, manifest.archive), "archive paths");
    install_fixture_copy(source.data, archive_path.data);
    utility_check(tool_join(&cache, root, "cache with spaces") && bootstrap_install(fixture.data, cache.data, &compiler)
        && bootstrap_install(fixture.data, cache.data, &repeated) && strcmp(compiler.data, repeated.data) == 0,
        "fresh and cached install agree");
    utility_check(tool_read_file(compiler.data, InstallArchiveLimit, &data), "retain compiler fixture");
    utility_check(chmod(compiler.data, InstallRegularMode) == 0, "remove executable permission");
    install_fixture_reject(fixture.data, cache.data, &compiler);
    utility_check(chmod(compiler.data, InstallExecutableMode) == 0, "restore executable permission");
    data.data[0] ^= 1;
    utility_check(driver_write_file(compiler.data, data.data, data.length), "corrupt cached bytes");
    install_fixture_reject(fixture.data, cache.data, &compiler);
    data.data[0] ^= 1;
    utility_check(tool_join(&outside, root, "outside_towerc") && driver_write_file(outside.data, data.data, data.length)
        && chmod(outside.data, InstallExecutableMode) == 0 && remove(compiler.data) == 0
        && symlink(outside.data, compiler.data) == 0, "equal-hash file symlink fixture");
    install_fixture_reject(fixture.data, cache.data, &compiler);
    utility_check(remove(compiler.data) == 0 && mkfifo(compiler.data, InstallRegularMode) == 0, "cache FIFO fixture");
    install_fixture_reject(fixture.data, cache.data, &compiler);
    utility_check(remove(compiler.data) == 0 && driver_write_file(compiler.data, data.data, data.length)
        && chmod(compiler.data, InstallExecutableMode) == 0, "restore regular compiler");
    utility_check(tool_join(&path, cache.data, manifest.hash) && tool_join(&member_path, path.data, "share")
        && tool_join(&outside, root, "outside_share") && rename(member_path.data, outside.data) == 0
        && symlink(outside.data, member_path.data) == 0, "equal-hash parent symlink fixture");
    install_fixture_reject(fixture.data, cache.data, &compiler);
    utility_check(remove(member_path.data) == 0 && rename(outside.data, member_path.data) == 0
        && bootstrap_install(fixture.data, cache.data, &repeated), "restore real member directories");
    utility_check(tool_join(&outside, root, "outside_archive.gz") && rename(archive_path.data, outside.data) == 0
        && symlink(outside.data, archive_path.data) == 0, "archive escape symlink fixture");
    install_fixture_reject(fixture.data, cache.data, &compiler);
    utility_check(remove(archive_path.data) == 0 && rename(outside.data, archive_path.data) == 0, "restore contained archive");
    utility_check(tool_read_file(archive_path.data, InstallArchiveLimit, &data), "retain archive");
    data.data[0] ^= 1;
    utility_check(driver_write_file(archive_path.data, data.data, data.length), "corrupt archive");
    install_fixture_reject(fixture.data, cache.data, &compiler);
    data.data[0] ^= 1; utility_check(driver_write_file(archive_path.data, data.data, data.length), "restore archive");
    utility_check(driver_write_file(manifest_path.data, "{}", 2), "invalid manifest fixture");
    install_fixture_reject(fixture.data, cache.data, &compiler);
    utility_check(tool_join(&source, argv[1], "development.json"), "original manifest path");
    install_fixture_copy(source.data, manifest_path.data);
    utility_check(tool_join(&outside, root, "linked_cache") && mkdir(outside.data, directory_mode) == 0
        && tool_join(&member_path, outside.data, manifest.hash) && symlink(path.data, member_path.data) == 0,
        "cache destination symlink fixture");
    install_fixture_reject(fixture.data, outside.data, &compiler);
    utility_check(bootstrap_install(fixture.data, cache.data, &repeated) && strcmp(compiler.data, repeated.data) == 0,
        "valid cache survives rejected attempts");
    puts("Tower bootstrap installer checks passed");
    return 0;
}
