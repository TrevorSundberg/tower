import tower;
import .library.vector;
import .compiler.syntax_session_types;
import .compiler.syntax_emission_types;
import .compiler.frontend_revision_types;
import .compiler.grammar_types;
import frontend_world;
import frontend_format;
import frontend_session_inputs;
import frontend_syntax_version;
import frontend_baselines;

extern fn syntax_session_allocate(world: void*, environment: void*): SyntaxSession*;
extern fn syntax_session_progress(value: SyntaxSession*): void;
extern fn syntax_session_suffix(value: SyntaxSession*, text: u8*): u8*;
extern fn syntax_destroy(value: void*): void;
extern fn syntax_highlights_push(value: SyntaxHighlights*, start: usize, end: usize, revision: usize, style: u8*, id: u32, opaque: bool): bool;
extern fn syntax_highlights_copy(target: SyntaxHighlights*, source: SyntaxHighlights*): bool;
extern fn syntax_highlights_style(value: SyntaxHighlights*, index: usize, style: u8*): void;
extern fn syntax_highlights_clear(value: SyntaxHighlights*): void;
extern fn syntax_highlights_dispose(value: SyntaxHighlights*): void;
extern fn syntax_scan_highlight(host: void*, start: usize, end: usize, revision: usize, style: u8*, id: u32, skipped: bool): void;
extern fn tower_memory_allocate(bytes: usize): void*;

fn frontend_highlight_tests(): void {
    var baseline = tower_test_buffer_count();
    var source: SyntaxHighlights;
    var target: SyntaxHighlights;
    fill(&source, 0, sizeof(SyntaxHighlights));
    fill(&target, 0, sizeof(SyntaxHighlights));
    frontend_world_check(syntax_highlights_push(&source, 2, 5, 3, "identifier", 7, false));
    var name = source.items.data[0].kind;
    for (var i: usize = 0; i < 100; ++i) {
        frontend_world_check(syntax_highlights_push(&source, i, i + 1, 4, "identifier", 7, false));
    }
    frontend_world_check(source.styles.length == 1 && source.items.data[100].kind == name);
    syntax_scan_highlight(bits(void*, &source), 110, 115, 5, "custom", convert(u32, SyntaxTokenId.String), false);
    syntax_scan_highlight(bits(void*, &source), 115, 120, 5, "", 9, true);
    frontend_world_check(source.items.data[101].opaque && source.items.data[102].opaque);
    syntax_highlights_style(&source, 0, "rule");
    frontend_world_check(!source.items.data[0].opaque && source.items.data[1].kind == name);
    frontend_format_text(name, "identifier");
    frontend_world_check(syntax_highlights_push(&target, 1, 2, 1, "old", 0, false));
    var allocations = tower_test_buffer_allocations();
    frontend_world_check(syntax_highlights_copy(&target, &source));
    allocations = tower_test_buffer_allocations() - allocations;
    syntax_highlights_clear(&target);
    frontend_world_check(syntax_highlights_push(&target, 1, 2, 1, "old", 0, false));
    var buffers = tower_test_buffer_count();
    for (var i: usize = 0; i < allocations; ++i) {
        tower_test_buffer_fail_after(i);
        var ready = syntax_highlights_copy(&target, &source);
        tower_test_buffer_fail_after(frontend_world_unlimited());
        frontend_world_check(!ready && target.items.length == 1);
        frontend_format_text(target.items.data[0].kind, "old");
        frontend_world_check(tower_test_buffer_count() == buffers);
    }
    frontend_world_check(syntax_highlights_copy(&target, &source));
    frontend_world_check(syntax_highlights_copy(&target, &target));
    syntax_highlights_dispose(&source);
    frontend_world_check(target.items.length == 103 && target.items.data[0].revision == 3);
    frontend_format_text(target.items.data[0].kind, "rule");
    frontend_format_text(target.items.data[1].kind, "identifier");
    frontend_world_check(target.items.data[101].opaque && target.items.data[102].opaque);
    syntax_highlights_dispose(&target);
    syntax_highlights_dispose(&target);
    frontend_world_check(tower_test_buffer_count() == baseline);
}

fn frontend_session_state_tests(): void {
    var baseline = tower_test_buffer_count();
    var world = compiler_world_create();
    var kinds: FrontendKinds;
    frontend_world_check(frontend_world_test_kinds(world, &kinds));
    tower_test_buffer_fail_after(0);
    var value = syntax_session_allocate(world, null);
    tower_test_buffer_fail_after(frontend_world_unlimited());
    frontend_world_check(value is null);
    syntax_destroy(null);
    value = syntax_session_allocate(world, null);
    frontend_world_check(value is not null && value.inputs.world == world && value.declarations_only);
    frontend_world_check(syntax_session_inputs_reset(&value.inputs, "abc", 3, SyntaxSeedBaseline, null));
    value.pins.baseline = syntax_world_revision(world, SyntaxSeedBaseline);
    frontend_world_check(value.pins.baseline is not null);
    frontend_world_check(vector_push(u8, &value.error, 65));
    frontend_world_check(syntax_highlights_push(&value.highlights, 0, 1, 0, "comment", 3, true));
    var suffix = bits(u8*, tower_memory_allocate(2));
    frontend_world_check(suffix is not null);
    suffix[0] = 41;
    suffix[1] = 0;
    frontend_world_check(syntax_session_suffix(value, suffix) == suffix);
    value.cursor = 2;
    value.revision = 7;
    value.error_offset = 1;
    value.error_insertion = true;
    value.finalized = true;
    value.declarations_only = false;
    value.expansion_stats.replacements = 5;
    tower_test_buffer_fail_after(0);
    syntax_session_progress(value);
    tower_test_buffer_fail_after(frontend_world_unlimited());
    frontend_world_check(value.source_length == 3 && value.cursor == 0 && value.revision == 0);
    frontend_format_text(value.source, "abc");
    frontend_world_check(value.error.length == 0 && value.error.data[0] == 0 && !value.error_insertion);
    frontend_world_check(value.highlights.items.length == 0 && value.highlights.styles.length == 0);
    frontend_world_check(!value.finalized && value.declarations_only && value.expansion_stats.replacements == 0);
    frontend_world_check(value.pins.grammar == value.pins.baseline);
    frontend_world_check(value.completion_suffix == suffix);
    frontend_world_check(!compiler_world_dispose(world));
    syntax_destroy(bits(void*, value));
    frontend_world_check(frontend_world_clear(world));
    frontend_world_check(compiler_world_dispose(world));
    frontend_world_check(tower_test_buffer_count() == baseline);
}
