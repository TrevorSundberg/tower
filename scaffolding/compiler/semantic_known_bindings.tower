export fn sem_known_binding(c: SemanticContext*, declaration: void*): SemanticKnownBinding* {
    if declaration == null || c.known_bindings == null { return null; }
    return bits(SemanticKnownBinding*, entity_component_data(entity_component_get(declaration, c.known_bindings)));
}

// Only owned executable edges; never follow declaration/type back references.
fn sem_known_edges(pending: vector(void*)*, node: FoundationNode*): void {
    if node.kind == KFunction || node.kind == KType || node.kind == KLabel { return; }
    sem_push(pending, node.left);
    sem_push(pending, node.right);
    sem_push(pending, node.value);
    sem_push(pending, node.target);
    sem_push(pending, node.body);
    sem_push(pending, node.otherwise);
    foreach(var item in &node.items) { sem_push(pending, item); }
}


fn sem_known_register(c: SemanticContext*, subject: void*, owner: void*, ordinal: usize): void {
    if !sem_known_candidate(subject) { return; }
    if sem_known_binding(c, subject) != null { return; }
    if c.known_bindings == null {
        c.known_bindings = sem_create(c.program.root);
        sem_require(entity_register(c.known_bindings, sizeof(SemanticKnownBinding), alignof(SemanticKnownBinding), 0));
        if c.value_inputs == null {
            c.value_inputs = sem_create(c.program.root);
            sem_require(entity_register(c.value_inputs, sizeof(IMValueInput), alignof(IMValueInput), 0));
        }
    }
    var binding = bits(SemanticKnownBinding*, entity_component_data(entity_component_add(subject, c.known_bindings)));
    sem_require(binding != null);
    fill(binding, 0, sizeof(SemanticKnownBinding));
    binding.owner = owner;
    binding.ordinal = ordinal;
    binding.immutable = true;
    binding.ordered = true;
}

fn sem_known_stage(c: SemanticContext*, node: void*, binding: SemanticKnownBinding*): void {
    sem_evaluation_begin(c);
    var subject = sem_control_node(c, node, KOperand);
    var literal = sem_get(subject);
    sem_set_type(&literal.type, &sem_get(node).type);
    literal.constant = true;
    var result = bits(SemanticEvaluation*, entity_component_data(entity_component_add(subject, c.evaluation_results)));
    sem_require(result != null);
    *result = default;
    result.subject = subject;
    result.owner = binding.owner == null ? c.program.root : binding.owner;
    result.literal = subject;
    result.requested = true;
    result.inferred = true;
    result.ready = bits(IMDependency*, entity_component_data(entity_component_add(subject, c.evaluation_ready)));
    sem_require(result.ready != null);
    *result.ready = default;
    result.ready.subject = subject;
    result.kernel.kind = CompilerKernelKind.Evaluate;
    result.kernel.payload = bits(void*, &result.invocation);
    sem_push(&c.evaluation_jobs, bits(void*, result));
    sem_evaluation_request(c, result);
    sem_require(work_depend(&c.queries,
        work_find(&c.queries, subject, convert(u32, SemanticQuery.KnownClone), 0), binding.input_query));
    binding.evaluation = subject;
    var input = bits(IMValueInput*, entity_component_data(entity_component_get(node, c.value_inputs)));
    if input == null {
        input = bits(IMValueInput*, entity_component_data(entity_component_add(node, c.value_inputs)));
        sem_require(input != null);
        *input = default;
    }
    // Fresh components initialize every role and projection field above. A
    // preexisting required capture keeps its own producer and borrowed leaves;
    // optional inference must not overwrite that proof or consume its storage.
    input.known_producer = subject;
    result.expression = sem_get(node).value;
    c.surface_expressions = true;
}


// Reuse Foundation's declaration rule. The initializer's existing surface
// expression metadata identifies Tower analysis without another var grammar or
// treating canonical Foundation reconstruction as a fresh surface optimization.
fn sem_known_surface(node: void*): bool {
    while node != null {
        if sem_is(node, "TowerExpression") { return true; }
        if sem_child_count(node) != 1 { return false; }
        node = sem_child(node, 0);
    }
    return false;
}

// Refuse obvious runtime captures before allocating cloned expressions or jobs.
// This is an eligibility check, never an evaluator: calls and arithmetic still
// execute only through ordinary staged interpreter work. Inputs with unresolved
// eligible producers remain dependencies for that work to discover.
fn sem_known_inputs(c: SemanticContext*, expression: void*, pending: vector(void*)*): bool {
    pending.length = 0;
    sem_push(pending, expression);
    for(var index: usize = 0; index < pending.length; index++) {
        var node = pending.data[index];
        if node == null { continue; }
        var value = sem_get(node);
        if value == null { continue; }
        if value.kind == KOperand && value.binding != null && !value.constant {
            var input = sem_known_binding(c, value.binding);
            if input == null || !input.immutable || !input.ordered { return false; }
        }
        // Optional arms are evaluated only if ordinary interpreter control flow
        // selects them. This bounded admission scan checks mandatory inputs;
        // it neither chooses a branch nor computes a constant.
        if value.kind == SurfaceSelect {
            sem_push(pending, value.value);
        } else {
            if value.kind == SurfaceAnd || value.kind == SurfaceOr || value.kind == SurfaceCoalesce {
                sem_push(pending, value.left);
            } else {
                sem_known_edges(pending, value);
            }
        }
    }
    return true;
}

fn sem_known_infer(c: SemanticContext*): void {
    if !sem_ok(c) || c.editor != null || !sem_known_needed(c) { return; }
    // Absence of writes is a whole-program fact. One joined proof query records
    // that prerequisite without a functions-times-bindings dependency cross product.
    var proof = work_request(&c.queries, c.program.root, convert(u32, SemanticQuery.KnownProof), 0);
    sem_require(proof != 0);
    var nodes = sem_list(c);
    var root = sem_get(c.program.root);
    for(var index: usize = 0; index < root.items.length; index++) {
        sem_known_register(c, root.items.data[index], null, index);
    }
    var kind = sem_known_kind(c);
    var count: usize = 0;
    for(var index: usize = 0; index < c.program.functions.length; index++) {
        var function = c.program.functions.data[index];
        var block = index == 0 ? function : sem_get(function).body;
        if block != null { sem_known_job(c, kind, function, block, index == 0 ? null : function, count++, SemanticKnownAction.Scan); }
    }
    foreach(var job in &c.evaluation_jobs) {
        var evaluation = bits(SemanticEvaluation*, job);
        sem_known_job(c, kind, evaluation.subject, evaluation.expression, null, count++, SemanticKnownAction.Scan);
    }
    var scans = sem_known_jobs(c, kind, count, SemanticQuery.KnownScan);
    if !sem_ok(c) { sem_known_jobs_dispose(&scans); return; }
    foreach(var job in &scans) {
        foreach(var &candidate in &job.candidates) {
            if job.owner != null { sem_known_register(c, candidate.subject, job.owner, candidate.ordinal); }
            sem_push(nodes, candidate.subject);
        }
    }
    foreach(var job in &scans) {
        foreach(var declaration in &job.mutations) {
            var binding = sem_known_binding(c, declaration);
            if binding != null { binding.immutable = false; }
        }
    }
    if c.known_bindings == null {
        sem_known_jobs_dispose(&scans);
        return;
    }
    var scan_kind = kind;
    kind = sem_known_kind(c);
    count = 0;
    for(var index: usize = 0; index < root.items.length; index++) {
        var subject = root.items.data[index];
        var value = sem_get(subject);
        if value == null || value.kind == KFunction || value.kind == KType || value.kind == KLabel { continue; }
        var job = sem_known_job(c, kind, subject, subject, null, count++, SemanticKnownAction.Order);
        job.source_ordinal = index;
    }
    var orders = sem_known_jobs(c, kind, count, SemanticQuery.KnownOrder);
    if !sem_ok(c) {
        sem_known_jobs_dispose(&orders);
        sem_known_jobs_dispose(&scans);
        return;
    }
    foreach(var job in &orders) {
        foreach(var declaration in &job.mutations) { sem_known_binding(c, declaration).ordered = false; }
    }
    sem_known_jobs_dispose(&orders);
    sem_require(work_seal(&c.queries, proof) && work_demand(&c.queries, proof));
    var proof_ticket: WorkTicket = default;
    sem_require(work_take_task(&c.queries, &proof_ticket, proof));
    sem_require(work_finish(&c.queries, &proof_ticket, sem_ok(c)));
    // Reuse the per-function candidate components after mutation/order facts
    // publish. Each worker owns its eligibility scratch and candidate output.
    foreach(var job in &scans) { job.action = SemanticKnownAction.Inputs; }
    var inputs = sem_known_jobs(c, scan_kind, scans.length, SemanticQuery.KnownInputs);
    vector_dispose(&scans);
    if !sem_ok(c) { sem_known_jobs_dispose(&inputs); return; }
    foreach(var job in &inputs) {
        var query = work_find(&c.queries, job.subject, convert(u32, SemanticQuery.KnownInputs), 0);
        foreach(var &candidate in &job.candidates) { sem_known_binding(c, candidate.subject).input_query = query; }
    }
    sem_known_jobs_dispose(&inputs);
    foreach(var node in nodes) {
        var binding = sem_known_binding(c, node);
        if binding == null || binding.input_query == 0 { continue; }
        if binding.evaluation == null { sem_known_stage(c, node, binding); }
        else {
            var result = sem_evaluation_get(c, binding.evaluation);
            result.requested = true;
            if !result.started { result.type_argument = false; }
        }
    }
    // Lowering consumes this joined receipt, rather than relying on a hidden
    // phase-order rule while inferred expressions still borrow runtime nodes.
    // One shared edge per function avoids a functions-times-captures graph.
    var snapshot = work_request(&c.queries, c.program.root, convert(u32, SemanticQuery.KnownSnapshot), 0);
    sem_require(work_depend(&c.queries, snapshot, proof));
    foreach(var job in &c.evaluation_jobs) {
        var evaluation = bits(SemanticEvaluation*, job);
        if !evaluation.inferred { continue; }
        var clone = work_find(&c.queries, evaluation.subject, convert(u32, SemanticQuery.KnownClone), 0);
        sem_require(clone != 0 && work_depend(&c.queries, snapshot, clone));
    }
    sem_require(work_seal(&c.queries, snapshot));
    sem_evaluation_clone_all(c);
    if sem_ok(c) {
        // Clone registration seals its producers before this join is demanded.
        sem_require(work_demand(&c.queries, snapshot));
        var ticket: WorkTicket = default;
        sem_require(work_take_task(&c.queries, &ticket, snapshot));
        sem_require(work_finish(&c.queries, &ticket, true));
    }
}

export fn sem_known_publish(c: SemanticContext*): void {
    if !sem_ok(c) || !work_ok(&c.queries) || c.known_bindings == null { return; }
    sem_captures_finalize(c);
    var kind = sem_known_kind(c);
    var count: usize = 0;
    for(var index: usize = 0; index < c.program.functions.length; index++) {
        var function = c.program.functions.data[index];
        var block = index == 0 ? function : sem_get(function).body;
        if block != null { sem_known_job(c, kind, function, block, function, count++, SemanticKnownAction.Publish); }
    }
    var jobs = sem_known_jobs(c, kind, count, SemanticQuery.KnownPublish);
    defer sem_known_jobs_dispose(&jobs);
    if !sem_ok(c) { return; }
    foreach(var job in &jobs) {
        foreach(var &patch in &job.patches) {
            var value = sem_get(patch.subject);
            if patch.declaration { value.value = patch.literal; }
            else {
                var literal = sem_get(patch.literal);
                value.kind = literal.kind;
                value.constant = literal.constant;
                value.bits = literal.bits;
                value.binding = literal.binding;
                value.element = literal.element;
            }
        }
    }
    foreach(var job in &jobs) { sem_known_storage_publish(job); }
}
