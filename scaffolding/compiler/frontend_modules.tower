import syntax_view;
import tower;
import component_kinds;
import frontend_revision_types;
import syntax_session_types;
import syntax_tags;
import foundation_nodes;
import frontend_bedrock;
import frontend_table;
import frontend_world;
import lr_tree;
import parser_nodes;
import regex_lowering;
import syntax_nodes;
import syntax_reader;
import syntax_revision;
import syntax_source;
import syntax_types;
import syntax_validation;
import .library.vector;

// Imports retain source, declaration and ordinary parse entities in one graph.
// Grammar views below are derived indexes over those entities, never another IR.
extern fn compiler_host_world(): void*;
extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_type(world: void*, kind: u32): void*;
extern fn compiler_world_component(world: void*, entity: void*, kind: u32): void*;
extern fn compiler_node_get(node: void*, kind: u32): void*;
extern fn entity_create(store: void*): void*;
extern fn syntax_session_open(world: void*, environment: void*, source: u8*, module: FrontendModule*, mode: u32): SyntaxSession*;

extern fn syntax_destroy(session: void*): void;

extern fn syntax_reset(session: void*, source: u8*, module: FrontendModule*): void;

extern fn syntax_next(session: void*): void*;

extern fn syntax_capture_comments(session: void*, module: FrontendModule*): void;

extern fn semantic_source_comments(root: void*, source: u8*, spans: usize*, count: usize, base: usize, length: usize): void;

extern fn syntax_get_error(session: void*): u8*;

extern fn syntax_get_error_offset(session: void*): usize;

extern fn compiler_clone_tree(source: void*, limit: usize, copied: usize*): void*;

extern fn entity_register(type: void*, size: usize, alignment: usize, lifecycle: usize): bool;

extern fn fopen(path: u8*, mode: u8*): void*;

extern fn module_file_case_matches(path: u8*): bool;

extern fn fread(data: u8*, size: usize, count: usize, file: void*): usize;

extern fn fclose(file: void*): i32;

extern fn ferror(file: void*): i32;

extern fn fwrite(data: u8*, size: usize, count: usize, file: void*): usize;

extern fn abort(): void;

var ModuleLoading: u32 = 1;
var ModuleLoaded: u32 = 2;
var ModuleMaximumDepth: usize = 128;
var ModuleMaximumSourceBytes: usize = 8388608;
var ModuleReadBlockBytes: usize = 16384;
var ModuleCacheEntries: usize = 16;
var ModuleMissing: u32 = 0;
var ModuleReady: u32 = 1;
var ModuleInvalidSource: u32 = 2;
var ModuleReadFailure: u32 = 3;
var ModuleSourceLimit: u32 = 4;
var ModulePathCase: u32 = 5;

struct ModuleInput {
    name: vector(u8);
    text: vector(u8);
}

struct ModuleAlias {
    name: vector(u8);
    path: vector(u8);
}

struct ModuleGrammar {
    rules: vector(SyntaxRuleView);
    tokens: vector(void*);
}

struct ModuleEnvironment {
    // A bound environment and all of its caches belong to exactly one world.
    // The anchor keeps even an idle environment from outliving that world.
    world: void*;
    anchor: void*;
    inputs: vector(ModuleInput);
    aliases: vector(ModuleAlias);
    entry: vector(u8);
    library: vector(u8);
    fallback: vector(u8);
    used: vector(u8*);
    sources: vector(SyntaxSource*);
    bases: vector(usize);
    diagnostic: SyntaxSource*;
    diagnostic_offset: usize;
    cache: vector(FrontendModule*);
    // One idle parser-table cache. Active sessions belong to module leases.
    compilation_session: void*;
    session_generation: usize;
    active_graphs: usize;
    active: FrontendModule*;
}

struct ModuleGraph {
    world: void*;
    environment: ModuleEnvironment*;
    owns_environment: bool;
    kind: void*;
    tracked: bool;
    entities: vector(void*);
    order: vector(FrontendModule*);
    error: vector(u8);
    depth: usize;
    cycles: bool;
    // One idle import reader, scoped to this graph. Recursive imports keep
    // their active readers; siblings reuse only completed grammar tables.
    import_session: void*;
}

struct FrontendModule {
    entity: void*;
    graph: ModuleGraph*;
    source: SyntaxSource*;
    dependencies: vector(FrontendModule*);
    imports: vector(void*);
    declarations: vector(void*);
    roots: vector(void*);
    grammar: ModuleGrammar;
    state: u32;
    body: bool;
    comments: vector(usize); // paired lexer byte spans, captured before session reset
    compilation_session: void*;
    session_generation: usize;
}

fn module_require(ok: bool): void {
    if !ok {
        abort();
    }
}

fn module_equal(a: u8*, b: u8*): bool {
    var i: usize = 0;
    loop {
        if a[i] != b[i] {
            return false;
        }
        if a[i] == 0 {
            return true;
        }
        i++;
    }
}

fn module_text(value: vector(u8)*): u8* {
    if value.data == null {
        return "";
    }
    return value.data;
}

// Canonical lexical identity. Separators and dot segments cannot create a
// second instance of the same module; filesystem symlinks are not followed here.
fn module_path(path: u8*, result: vector(u8)*): bool {
    var parts: vector(usize);
    vector_init(&parts);
    result.length = 0;
    var i: usize = 0;
    var protected_parts: usize = 0;
    var absolute = path[0] == 47;
    absolute ||= path[0] == 92;
    if absolute {
        module_require(vector_push(result, 47));
        i = 1;
        var network = path[1] == 47;
        network ||= path[1] == 92;
        if network {
            module_require(vector_push(result, 47));
            i = 2;
            protected_parts = 2;
        }
    }
    var drive = path[0] != 0;
    drive &&= path[1] == 58;
    if drive {
        var rooted = path[2] == 47;
        rooted ||= path[2] == 92;
        if !rooted {
            vector_dispose(&parts);
            return false;
        }
        var letter = path[0];
        var lower = letter >= 97;
        lower &&= letter <= 122;
        if lower {
            letter = letter - 32;
        }
        var valid = letter >= 65;
        valid &&= letter <= 90;
        if !valid {
            vector_dispose(&parts);
            return false;
        }
        module_require(vector_push(result, letter));
        module_require(bytes_append(result, ":/", 2));
        absolute = true;
        i = 3;
    }
    loop {
        var byte = path[i];
        var done = byte == 0;
        if done {
            break;
        }
        var separator = byte == 47;
        separator ||= byte == 92;
        if separator {
            i++;
            continue;
        }
        var start = i;
        loop {
            byte = path[i];
            done = byte == 0;
            if done {
                break;
            }
            separator = byte == 47;
            separator ||= byte == 92;
            if separator {
                break;
            }
            i++;
        }
        var length = i -start;
        var dot = length == 1;
        dot &&= path[start] == 46;
        if dot {
            continue;
        }
        var parent = length == 2;
        parent &&= path[start] == 46;
        if parent {
            var next = start + 1;
            parent = path[next] == 46;
        }
        var can_pop = parts.length > protected_parts;
        if parent {
            if can_pop {
                var last = parts.length -1;
                var offset = parts.data[last];
                var check = offset;
                var slash = result.data[check] == 47;
                if slash {
                    check++;
                }
                var previous_length = result.length -check;
                var previous_parent = previous_length == 2;
                previous_parent &&= result.data[check] == 46;
                if previous_parent {
                    check++;
                    previous_parent = result.data[check] == 46;
                }
                can_pop = !previous_parent;
                if can_pop {
                    result.length = offset;
                    parts.length = last;
                    continue;
                }
            }
            if absolute {
                vector_dispose(&parts);
                return false;
            }
        }
        module_require(vector_push(&parts, result.length));
        if result.length != 0 {
            var last = result.length -1;
            var slash = result.data[last] == 47;
            if !slash {
                module_require(vector_push(result, 47));
            }
        }
        var segment = path + start;
        module_require(bytes_append(result, segment, length));
    }
    var complete = parts.length >= protected_parts;
    vector_dispose(&parts);
    if !complete {
        return false;
    }
    module_require(vector_push(result, 0));
    result.length--;
    return true;
}

fn module_directory(path: u8*, result: vector(u8)*): void {
    module_require(module_path(path, result));
    // A configured relative root is a search directory, even though its
    // canonical file-path prefix is empty. Empty input means no search root.
    if path[0] != 0 {
        if result.length == 0 {
            module_require(node_text_set(result, "."));
        }
    }
}

export fn frontend_modules_configure(environment: ModuleEnvironment*, entry: u8*, library: u8*): void {
    module_require(module_path(entry, &environment.entry));
    module_directory(library, &environment.library);
}

export fn frontend_modules_fallback(environment: ModuleEnvironment*, directory: u8*): void {
    module_directory(directory, &environment.fallback);
}

export fn frontend_modules_clear(environment: ModuleEnvironment*): void {
    foreach(var & input in &environment.inputs) {
        vector_dispose(&(*input).name);
        vector_dispose(&(*input).text);
    }
    environment.inputs.length = 0;
}

export fn frontend_modules_source(environment: ModuleEnvironment*, name: u8*, text: u8*, length: usize): bool {
    var valid = length <= ModuleMaximumSourceBytes;
    valid &&= tower_utf8_validate(text, length, 1) != 0;
    if !valid {
        return false;
    }
    var input: ModuleInput = default;
    var ok = module_path(name, &input.name);
    ok &&= bytes_assign_text(&input.text, text, length);
    if ok {
        foreach(var & previous in &environment.inputs) {
            if module_equal(previous.name.data, input.name.data) {
                vector_dispose(&previous.name);
                vector_dispose(&previous.text);
                copy(previous, &input, sizeof(ModuleInput));
                return true;
            }
        }
    }
    if ok {
        var count = environment.inputs.length + 1;
        ok = vector_reserve(&environment.inputs, count);
        if ok {
            copy(&environment.inputs.data[environment.inputs.length], &input, sizeof(ModuleInput));
            environment.inputs.length = count;
        }
    }
    if !ok {
        vector_dispose(&input.name);
        vector_dispose(&input.text);
    }
    return ok;
}

fn module_read(environment: ModuleEnvironment*, path: u8*, text: vector(u8)*): u32 {
    foreach(var & input in &environment.inputs) {
        if module_equal(path, input.name.data) {
            module_require(bytes_assign_text(text, input.text.data, input.text.length));
            return ModuleReady;
        }
    }
    var file = fopen(path, "rb");
    if file == null {
        return ModuleMissing;
    }
    if !module_file_case_matches(path) {
        fclose(file);
        return ModulePathCase;
    }
    var buffer = alloc(u8, ModuleReadBlockBytes);
    var allocated1 = buffer != null;
    module_require(allocated1);
    var status = ModuleReady;
    loop {
        var count = fread(buffer, 1, ModuleReadBlockBytes, file);
        if count == 0 {
            break;
        }
        module_require(bytes_append(text, buffer, count));
        if text.length > ModuleMaximumSourceBytes {
            status = ModuleSourceLimit;
            break;
        }
    }
    if ferror(file) != 0 {
        status = ModuleReadFailure;
    }
    fclose(file);
    free(buffer);
    if status == ModuleReady {
        if !(tower_utf8_validate(text.data, text.length, 1) != 0) {
            return ModuleInvalidSource;
        }
        module_require(vector_push(text, 0));
        text.length--;
    }
    return status;
}

fn module_fail(module: FrontendModule*, message: u8*, detail: u8*): void {
    var error = &module.graph.error;
    if error.length == 0 {
        module_require(node_text_set(error, module.source.name.data));
        module_require(bytes_append(error, ": ", 2));
        module_require(bytes_append(error, message, syntax_text_length(message)));
        module_require(bytes_append(error, detail, syntax_text_length(detail)));
        module_require(vector_push(error, 0));
        error.length--;
    }
}

fn module_node(graph: ModuleGraph*, entity: void*): FrontendModule* {
    return bits(FrontendModule*, entity_component_data(entity_component_get(entity, graph.kind)));
}

fn module_new(graph: ModuleGraph*, name: u8*, text: u8*): FrontendModule* {
    if graph.kind == null {
        graph.kind = entity_create(compiler_world_store(graph.world));
        module_require(entity_register(graph.kind, sizeof(FrontendModule), alignof(FrontendModule), 0));
    }
    var entity = entity_create(compiler_world_store(graph.world));
    var allocated2 = entity != null;
    module_require(allocated2);
    var component = entity_component_add(entity, graph.kind);
    var allocated3 = component != null;
    module_require(allocated3);
    var value = bits(FrontendModule*, entity_component_data(component));
    fill(value, 0, sizeof(FrontendModule));
    value.entity = entity;
    value.graph = graph;
    value.source = syntax_source_create(name, text, syntax_text_length(text));
    var allocated4 = value.source != null;
    module_require(allocated4);
    module_require(vector_push(&graph.entities, entity));
    value.state = ModuleLoading;
    return value;
}

// Publish dependencies before their importer, using the same completion order
// as execution. Cached clones take this path too; discovery order is not order.
fn module_complete(module: FrontendModule*): void {
    module.state = ModuleLoaded;
    var graph = module.graph;
    module_require(vector_push(&graph.order, module));
    if graph.tracked {
        var name = module.source.name.data;
        var length = syntax_text_length(name);
        var needed = length + 1;
        var dependency = alloc(u8, needed);
        var present = dependency != null;
        module_require(present);
        copy(dependency, name, needed);
        module_require(vector_push(&graph.environment.used, dependency));
    }
}

// Coordinator-owned binding. A foreign world is rejected before changing any
// source, cache, session or active-graph bookkeeping.
export fn frontend_modules_bind_world(environment: ModuleEnvironment*, world: void*): bool {
    if world is null { return false; }
    if environment is null { return true; }
    if environment.world is not null { return environment.world == world; }
    var anchor = entity_create(compiler_world_store(world));
    if anchor is null { return false; }
    environment.anchor = anchor;
    environment.world = world;
    return true;
}

export fn frontend_module_world(module: FrontendModule*): void* {
    return module.graph.world;
}

export fn frontend_modules_world(environment: ModuleEnvironment*): void* {
    return environment is null ? null : environment.world;
}

// Compatibility entry point; explicit-world callers use root_world.
export fn frontend_module_root(source: u8*, environment: ModuleEnvironment*): FrontendModule* {
    return frontend_module_root_world(compiler_host_world(), source, environment);
}

export fn frontend_module_root_world(world: void*, source: u8*, environment: ModuleEnvironment*): FrontendModule* {
    if !frontend_modules_bind_world(environment, world) { return null; }
    var graph = alloc(ModuleGraph, 1);
    var allocated5 = graph != null;
    module_require(allocated5);
    *graph = default;
    graph.world = world;
    graph.tracked = true;
    graph.environment = environment;
    if environment == null {
        environment = frontend_modules_create();
        module_require(frontend_modules_bind_world(environment, world));
        graph.environment = environment;
        graph.owns_environment = true;
    }
    var next = environment.active_graphs + 1;
    var valid = next != 0;
    module_require(valid);
    environment.active_graphs = next;
    frontend_modules_used_clear(environment);
    frontend_modules_sources_clear(environment);
    var name = module_text(&environment.entry);
    if name[0] == 0 {
        name = "input.tower";
    }
    var result = module_new(graph, name, source);
    environment.active = result;
    return result;
}

export fn frontend_modules_root(environment: ModuleEnvironment*): FrontendModule* {
    if environment == null {
        return null;
    }
    return environment.active;
}

export fn frontend_module_name(module: FrontendModule*): u8* {
    return module.source.name.data;
}

// Shared source lookup for IDE services and native compiler clients.
export fn frontend_module_location(module: FrontendModule*, offset: usize, line: usize*, column: usize*): u8* {
    syntax_source_location(module.source, offset, line, column);
    return module.source.name.data;
}

export fn frontend_module_error(module: FrontendModule*): u8* {
    return module_text(&module.graph.error);
}

fn module_grammar_clear(grammar: ModuleGrammar*): void {
    foreach(var & rule in &grammar.rules) {
        free((*rule).alternatives);
    }
    grammar.rules.length = 0;
    grammar.tokens.length = 0;
}

fn module_grammar_add(grammar: ModuleGrammar*, entity: void*): void {
    var value = bits(SyntaxNode*, compiler_node_get(entity, CompilerSyntax));
    var rule = value.kind == SyntaxRule;
    var i: usize = 0;
    if rule {
        for(; i != grammar.rules.length; i++) {
            var same = module_equal(grammar.rules.data[i].name, value.name.data);
            if same {
                break;
            }
        }
        if i == grammar.rules.length {
            var entry: SyntaxRuleView = default;
            entry.name = value.name.data;
            entry.name_length = value.name.length;
            var needed = grammar.rules.length + 1;
            module_require(vector_reserve(&grammar.rules, needed));
            copy(&grammar.rules.data[grammar.rules.length], &entry, sizeof(SyntaxRuleView));
            grammar.rules.length = needed;
        }
        var target = &grammar.rules.data[i];
        var before: usize = 0;
        if value.append {
            before = target.count;
        }
        var count = before + value.items.length;
        var alternatives = alloc(void*, count);
        var allocated6 = alternatives != null;
        module_require(allocated6);
        i = 0;
        for(; i != before; i++) {
            alternatives[i] = target.alternatives[i];
        }
        i = 0;
        for(; i != value.items.length; i++) {
            var slot = before + i;
            alternatives[slot] = value.items.data[i];
        }
        free(target.alternatives);
        target.alternatives = alternatives;
        target.count = count;
    } else {
        var lexical = value.kind == SyntaxToken;
        lexical ||= value.kind == SyntaxSkip;
        if !lexical {
            return;
        }
        for(; i != grammar.tokens.length; i++) {
            var old = bits(SyntaxNode*, compiler_node_get(grammar.tokens.data[i], CompilerSyntax));
            var same = module_equal(old.name.data, value.name.data);
            if same {
                grammar.tokens.data[i] = entity;
                return;
            }
        }
        module_require(vector_push(&grammar.tokens, entity));
    }
}

fn module_grammar_visit(module: FrontendModule*, grammar: ModuleGrammar*, seen: vector(FrontendModule*)*): void {
    var i: usize = 0;
    for(; i != seen.length; i++) {
        if seen.data[i] == module {
            return;
        }
    }
    module_require(vector_push(seen, module));
    i = 0;
    for(; i != module.dependencies.length; i++) {
        module_grammar_visit(module.dependencies.data[i], grammar, seen);
    }
    i = 0;
    for(; i != module.declarations.length; i++) {
        module_grammar_add(grammar, module.declarations.data[i]);
    }
}

export fn frontend_module_grammar(module: FrontendModule*): ModuleGrammar* {
    module_grammar_clear(&module.grammar);
    var seed = bits(SyntaxNode*, compiler_node_get(frontend_world_bedrock(module.graph.world), CompilerSyntax));
    foreach(var & item in &seed.items) {
        module_grammar_add(&module.grammar, *item);
    }
    var seen: vector(FrontendModule*);
    vector_init(&seen);
    module_grammar_visit(module, &module.grammar, &seen);
    vector_dispose(&seen);
    return &module.grammar;
}

fn module_candidate(base: u8*, name: u8*, literal: bool, result: vector(u8)*): bool {
    var path: vector(u8);
    vector_init(&path);
    var absolute = name[0] == 47;
    absolute ||= name[0] == 92;
    if !absolute {
        if name[0] != 0 {
            absolute = name[1] == 58;
        }
    }
    if !absolute {
        module_require(node_text_set(&path, base));
    }
    module_require(bytes_append(&path, name, syntax_text_length(name)));
    if !literal {
        module_require(bytes_append(&path, ".tower", 6));
    }
    module_require(vector_push(&path, 0));
    var ok = module_path(path.data, result);
    vector_dispose(&path);
    return ok;
}

// Host-selected builtin paths are explicit inputs, and retain their real provenance.
export fn frontend_modules_builtin(environment: ModuleEnvironment*, name: u8*, path: u8*): void {
    var alias: ModuleAlias = default;
    module_require(node_text_set(&alias.name, name));
    module_require(module_path(path, &alias.path));
    var count = environment.aliases.length + 1;
    module_require(vector_reserve(&environment.aliases, count));
    copy(&environment.aliases.data[environment.aliases.length], &alias, sizeof(ModuleAlias));
    environment.aliases.length = count;
}

fn module_alias(environment: ModuleEnvironment*, name: u8*, path: vector(u8)*): bool {
    var i = environment.aliases.length;
    loop {
        if i == 0 {
            return false;
        }
        i--;
        var alias = &environment.aliases.data[i];
        if module_equal(name, alias.name.data) {
            module_require(node_text_set(path, alias.path.data));
            return true;
        }
    }
}

fn module_resolve(parent: FrontendModule*, name: u8*, literal: bool, path: vector(u8)*, text: vector(u8)*): u32 {
    var selected: bool = false;
    if !literal {
        selected = module_alias(parent.graph.environment, name, path);
    }
    if selected {
        return module_read(parent.graph.environment, path.data, text);
    }
    var base: vector(u8);
    vector_init(&base);
    var length = parent.source.name.length;
    loop {
        var done = length == 0;
        if done {
            break;
        }
        var last = length -1;
        if parent.source.name.data[last] == 47 {
            break;
        }
        length = last;
    }
    module_require(bytes_assign_text(&base, parent.source.name.data, length));
    var ok = module_candidate(base.data, name, literal, path);
    var status = ModuleMissing;
    if ok {
        status = module_read(parent.graph.environment, path.data, text);
    }
    // Explicit relative paths stay relative to their importing file. A missing
    // ../ dependency must not silently select an unrelated library file.
    var relative: bool = false;
    if name[0] == 46 {
        relative = name[1] == 47;
        if name[1] == 46 {
            relative = name[2] == 47;
        }
    }
    var search: usize = 0;
    var case_path: vector(u8);
    vector_init(&case_path);
    loop {
        var wrong_case = status == ModulePathCase;
        if wrong_case {
            module_require(node_text_set(&case_path, path.data));
        }
        if relative {
            break;
        }
        var missing = status == ModuleMissing;
        missing ||= wrong_case;
        if !missing {
            break;
        }
        var done = search == 2;
        if done {
            break;
        }
        var directory = module_text(&parent.graph.environment.library);
        var last = search == 1;
        if last {
            directory = module_text(&parent.graph.environment.fallback);
        }
        search++;
        if directory[0] == 0 {
            continue;
        }
        text.length = 0;
        module_require(node_text_set(&base, directory));
        module_require(bytes_append(&base, "/", 1));
        module_require(vector_push(&base, 0));
        base.length--;
        ok = module_candidate(base.data, name, literal, path);
        if ok {
            status = module_read(parent.graph.environment, path.data, text);
        }
    }
    var missing = status == ModuleMissing;
    if missing {
        if case_path.length != 0 {
            status = ModulePathCase;
            module_require(node_text_set(path, case_path.data));
        }
    }
    vector_dispose(&case_path);
    vector_dispose(&base);
    return status;
}

fn module_load(parent: FrontendModule*, name: u8*, literal: bool): FrontendModule* {
    var path: vector(u8);
    var text: vector(u8);
    vector_init(&path);
    vector_init(&text);
    var status = module_resolve(parent, name, literal, &path, &text);
    var result: FrontendModule* = null;
    if status == ModuleReady {
        foreach(var & entitie in &parent.graph.entities) {
            var old = module_node(parent.graph, *entitie);
            if module_equal(path.data, old.source.name.data) {
                result = old;
                break;
            }
        }
        if result != null {
            if result.state == ModuleLoading {
                if result == parent {
                    module_fail(parent, "Import cycle through ", path.data);
                    result = null;
                } else {
                    parent.graph.cycles = true;
                }
            }
        } else {
            var cached = module_cached(parent.graph.environment, path.data, text.data);
            if cached != null {
                result = module_clone(parent.graph, cached);
            }
            else {
                if parent.graph.depth >= ModuleMaximumDepth {
                    module_fail(parent, "Import depth exceeds 128: ", path.data);
                }
                else {
                    result = module_new(parent.graph, path.data, text.data);
                    parent.graph.depth++;
                    var session = parent.graph.import_session;
                    parent.graph.import_session = null;
                    if session == null {
                        session = bits(void*, syntax_session_open(parent.graph.world, bits(void*, parent.graph.environment), result.source.text.data, result, SyntaxFoundationBaseline));
                    }
                    else {
                        syntax_reset(session, result.source.text.data, result);
                    }
                    loop {
                        var root = syntax_next(session);
                        if root == null {
                            break;
                        }
                        entity_release(root);
                    }
                    var error = syntax_get_error(session);
                    if error[0] != 0 {
                        module_fail(result, "", error);
                        frontend_module_diagnostic(result, syntax_get_error_offset(session));
                    }
                    syntax_capture_comments(session, result);
                    if parent.graph.import_session != null {
                        syntax_destroy(parent.graph.import_session);
                    }
                    parent.graph.import_session = session;
                    parent.graph.depth--;
                    module_complete(result);
                    module_validate_cycles(result.graph);
                    if parent.graph.error.length == 0 {
                        module_cache_store(result);
                    }
                }
            }
        }
    } else {
        if status == ModuleInvalidSource {
            module_fail(parent, "Imported source must be UTF-8 without NUL bytes: ", name);
        }
        else {
            if status == ModuleSourceLimit {
                module_fail(parent, "Imported source exceeds 8 MiB: ", name);
            }
            else {
                if status == ModulePathCase {
                    module_fail(parent, "Import path case must match the filesystem exactly: ", path.data);
                } else {
                    module_fail(parent, "Cannot read imported module: ", name);
                }
            }
        }
    }
    vector_dispose(&path);
    vector_dispose(&text);
    return result;
}

// Dotted segments retain components on their actual parse entities. The joined
// slash path is a derived lookup key; formatting uses the preserved segments.
fn module_import_name(reader: SyntaxReader*, node: void*, value: SyntaxNode*): bool {
    var span = syntax_reader_span(reader, node);
    var missing = span == null;
    if missing {
        return false;
    }
    var first = reader.source.text.data[span.start];
    var quoted = first == 34;
    quoted ||= first == 39;
    var ok: bool = true;
    if quoted {
        value.literal = true;
        ok = syntax_reader_quoted(reader, node, &value.name);
    } else {
        // Prefix dots are literal terms on their parse entities. Keep them in
        // source order before the identifier segments, including during clones.
        var parents: vector(void*);
        vector_init(&parents);
        defer vector_dispose(&parents);
        loop {
            var parent = syntax_reader_member(node, "parent");
            var done = parent == null;
            if done {
                break;
            }
            var prefix = syntax_reader_attach(reader, node, SyntaxTerm);
            if prefix == null {
                return false;
            }
            prefix.literal = true;
            module_require(node_text_set(&prefix.text, "."));
            module_require(vector_push(&parents, node));
            node = parent;
        }
        var segments = syntax_reader_member(node, "segments");
        if segments != null {
            node = segments;
        }
        var segment = syntax_reader_member(node, "segment");
        if segment == null {
            // Editable older Bedrock grammars can still capture Identifier directly.
            ok = syntax_reader_name(reader, node, &value.name);
        } else {
            loop {
                var done = node == null;
                if done {
                    break;
                }
                segment = syntax_reader_required(reader, node, "segment");
                missing = segment == null;
                if missing {
                    return false;
                }
                var part = syntax_reader_attach(reader, segment, SyntaxTerm);
                missing = part == null;
                if missing {
                    return false;
                }
                ok = syntax_reader_name(reader, segment, &part.text);
                ok &&= part.text.length != 0;
                ok &&= vector_push(&value.items, segment);
                if !ok {
                    return false;
                }
                node = syntax_reader_member(node, "previous");
            }
            syntax_reader_reverse(&value.items);
            var identifiers: vector(void*);
            copy(&identifiers, &value.items, sizeof(vector(void*)));
            copy(&value.items, &parents, sizeof(vector(void*)));
            vector_init(&parents);
            foreach(var & identifier in &identifiers) {
                module_require(vector_push(&value.items, *identifier));
            }
            vector_dispose(&identifiers);
            var i: usize = 0;
            var separator: bool = false;
            loop {
                var done = i == value.items.length;
                if done {
                    break;
                }
                var part = frontend_syntax(value.items.data[i], reader.syntax_kind);
                if part.literal {
                    module_require(bytes_append(&value.name, "../", 3));
                    i++;
                    continue;
                }
                if separator {
                    module_require(foundation_name_append(&value.name, 47));
                }
                module_require(bytes_append(&value.name, part.text.data, part.text.length));
                separator = true;
                i++;
            }
            module_require(foundation_name_append(&value.name, 0));
            value.name.length--;
        }
    }
    if ok {
        ok = value.name.length != 0;
        foreach(var & name_item in &value.name) {
            if *name_item == 92 {
                *name_item = 47;
            }
        }
    }
    return ok;
}

fn module_read_import(reader: SyntaxReader*, node: void*): bool {
    var value = syntax_reader_attach(reader, node, SyntaxImport);
    var name = syntax_reader_required(reader, node, "name");
    var ok = reader.error == null;
    ok &&= module_import_name(reader, name, value);
    var alias = syntax_reader_member(node, "alias");
    if alias != null {
        var part = syntax_reader_attach(reader, alias, SyntaxTerm);
        ok = part != null;
        ok &&= syntax_reader_name(reader, alias, &value.capture);
        if ok {
            ok = value.capture.length != 0;
            module_require(node_text_set(&part.text, value.capture.data));
        }
    }
    return ok;
}

export fn frontend_module_import(module: FrontendModule*, node: void*, source: SyntaxSource*): bool {
    var reader: SyntaxReader = {
        source: source, match_kind: compiler_world_type(module.graph.world, CompilerParserMatch),
        syntax_kind: compiler_world_type(module.graph.world, CompilerSyntax), ..default
    };
    var ok = module_read_import(&reader, node);
    var value = frontend_syntax(node, reader.syntax_kind);
    var aliased = syntax_reader_member(node, "alias") != null;
    if module.body {
        module_fail(module, "Imports must precede this file's declarations and statements", "");
        return false;
    }
    if !ok {
        module_fail(module, "Invalid import declaration", "");
        return false;
    }
    if aliased {
        foreach(var & element in &module.imports) {
            var previous = frontend_syntax(*element, reader.syntax_kind);
            if module_equal(module_text(&previous.capture), value.capture.data) {
                module_fail(module, "Duplicate import alias: ", value.capture.data);
                return false;
            }
        }
    }
    var dependency = module_load(module, value.name.data, value.literal);
    if dependency != null {
        module_require(vector_push(&module.dependencies, dependency));
        entity_retain(node);
        module_require(vector_push(&module.imports, node));
    }
    var clean = module.graph.error.length == 0;
    return clean;
}

export fn frontend_module_record(module: FrontendModule*, root: void*, declaration: bool): void {
    var node = entity_child_at(root, 0);
    if declaration {
        var value = bits(SyntaxNode*, compiler_node_get(node, CompilerSyntax));
        if value.kind == SyntaxImport {
            return;
        }
        entity_retain(node);
        module_require(vector_push(&module.declarations, node));
    } else {
        entity_retain(root);
        module_require(vector_push(&module.roots, root));
    }
    module.body = true;
}

export fn frontend_module_seed_only(module: FrontendModule*): bool {
    return module.dependencies.length == 0 && module.declarations.length == 0 && module.roots.length == 0;
}

export fn frontend_module_finish(module: FrontendModule*): void {
    module_complete(module);
    module_validate_cycles(module.graph);
}

// Semantic declarations may depend on one another across files. A cyclic
// component may not publish grammar updates or ordered initialization effects:
// there is no dependency-first order for those operations inside a cycle.
fn module_reaches(start: FrontendModule*, target: FrontendModule*): bool {
    var pending: vector(FrontendModule*);
    var seen: vector(FrontendModule*);
    vector_init(&pending);
    vector_init(&seen);
    module_require(vector_push(&pending, start));
    var found = false;
    while pending.length != 0 {
        pending.length--;
        var current = pending.data[pending.length];
        var duplicate = false;
        var i: usize = 0;
        for(; i < seen.length; i++) {
            var same = seen.data[i] == current;
            if same {
                duplicate = true;
            }
        }
        if duplicate {
            continue;
        }
        module_require(vector_push(&seen, current));
        i = 0;
        for(; i < current.dependencies.length; i++) {
            var dependency = current.dependencies.data[i];
            var same = dependency == target;
            if same {
                found = true;
                break;
            }
            module_require(vector_push(&pending, dependency));
        }
        if found {
            break;
        }
    }
    vector_dispose(&pending);
    vector_dispose(&seen);
    return found;
}

fn module_validate_cycles(graph: ModuleGraph*): void {
    if !graph.cycles {
        return;
    }
    var i: usize = 0;
    for(; i < graph.entities.length; i++) {
        var current = module_node(graph, graph.entities.data[i]);
        if current.state == ModuleLoaded {
            if module_reaches(current, current) {
                var invalid = current.declarations.length != 0;
                invalid ||= current.roots.length == 0;
                foreach(var & root in &current.roots) {
                    var node = entity_child_at(*root, 0);
                    var reader: SyntaxReader = default;
                    reader.match_kind = compiler_world_type(graph.world, CompilerParserMatch);
                    var span = syntax_reader_span(&reader, node);
                    if module_equal(span.label.data, "Statement") {
                        node = entity_child_at(node, 0);
                        span = syntax_reader_span(&reader, node);
                    }
                    if module_equal(span.label.data, "CoreAttributed") {
                        node = entity_child_at(syntax_reader_member(node, "declaration"), 0);
                        span = syntax_reader_span(&reader, node);
                    }
                    var declaration = module_equal(span.label.data, "CoreFunction");
                    declaration ||= module_equal(span.label.data, "CoreExternal");
                    declaration ||= module_equal(span.label.data, "CoreExport");
                    declaration ||= module_equal(span.label.data, "CoreStruct");
                    declaration ||= module_equal(span.label.data, "CoreEnum");
                    // Ordinary variables may be proved fixed compile-time values
                    // by semantics. Defer only that proof; grammar and executable
                    // statements still cannot take part in an import cycle.
                    declaration ||= module_equal(span.label.data, "CoreDeclare");
                    if !declaration {
                        invalid = true;
                    }
                }
                if invalid {
                    module_fail(current, "Import cycle requires declarations only (no grammar updates or initialization effects): ", current.source.name.data);
                    return;
                }
            }
        }
    }
}

export fn frontend_module_cyclic(module: FrontendModule*): bool {
    return module.graph.cycles && module_reaches(module, module);
}

export fn frontend_module_comment(module: FrontendModule*, first: usize, last: usize): void {
    module_require(vector_push(&module.comments, first));
    module_require(vector_push(&module.comments, last));
}

// Borrowed paired lexer offsets, retained for the module's lifetime.
export fn frontend_module_comments(module: FrontendModule*, count: usize*): usize* {
    *count = module.comments.length;
    return module.comments.data;
}

export fn frontend_module_attach_comments(module: FrontendModule*, root: void*, base: usize): void {
    semantic_source_comments(root, module.source.text.data, module.comments.data, module.comments.length, base, module.source.text.length);
}

export fn frontend_module_count(module: FrontendModule*): usize {
    return module.graph.order.length;
}

export fn frontend_module_at(module: FrontendModule*, index: usize): FrontendModule* {
    return module.graph.order.data[index];
}

export fn frontend_module_source(module: FrontendModule*): u8* {
    return module.source.text.data;
}

export fn frontend_module_size(module: FrontendModule*): usize {
    return module.source.text.length;
}

export fn frontend_module_roots(module: FrontendModule*): usize {
    return module.roots.length;
}

// Import bindings refer to the actual declaration and canonical dependency.
// Alias text is source metadata, independent of foreign symbol export names.
export fn frontend_module_import_count(module: FrontendModule*): usize {
    return module.imports.length;
}

export fn frontend_module_import_at(module: FrontendModule*, index: usize): void* {
    return module.imports.data[index];
}

export fn frontend_module_dependency_at(module: FrontendModule*, index: usize): FrontendModule* {
    return module.dependencies.data[index];
}

export fn frontend_module_alias(module: FrontendModule*, index: usize): u8* {
    var value = bits(SyntaxNode*, compiler_node_get(module.imports.data[index], CompilerSyntax));
    return module_text(&value.capture);
}

export fn frontend_module_tree(module: FrontendModule*, index: usize): void* {
    return module.roots.data[index];
}

export fn frontend_module_destroy(module: FrontendModule*): void {
    var graph = module.graph;
    if graph.import_session != null {
        syntax_destroy(graph.import_session);
        graph.import_session = null;
    }
    var active = graph.environment.active == module;
    if active {
        graph.environment.active = null;
    }
    var i: usize = 0;
    loop {
        var done = i == graph.entities.length;
        if done {
            break;
        }
        var current = module_node(graph, graph.entities.data[i]);
        module_session_release(current);
        var n: usize = 0;
        loop {
            done = n == current.declarations.length;
            if done {
                break;
            }
            entity_release(current.declarations.data[n]);
            n++;
        }
        n = 0;
        loop {
            done = n == current.roots.length;
            if done {
                break;
            }
            entity_release(current.roots.data[n]);
            n++;
        }
        n = 0;
        loop {
            done = n == current.imports.length;
            if done {
                break;
            }
            entity_release(current.imports.data[n]);
            n++;
        }
        vector_dispose(&current.imports);
        module_grammar_clear(&current.grammar);
        vector_dispose(&current.grammar.rules);
        vector_dispose(&current.grammar.tokens);
        vector_dispose(&current.declarations);
        vector_dispose(&current.roots);
        vector_dispose(&current.comments);
        vector_dispose(&current.dependencies);
        syntax_source_release(current.source);
        entity_release(current.entity);
        i++;
    }
    vector_dispose(&graph.entities);
    vector_dispose(&graph.order);
    vector_dispose(&graph.error);
    var kind = graph.kind != null;
    if kind {
        entity_release(graph.kind);
    }
    if graph.tracked {
        graph.environment.active_graphs--;
    }
    if graph.owns_environment {
        frontend_modules_destroy(graph.environment);
    }
    free(graph);
}

export fn frontend_modules_create(): ModuleEnvironment* {
    var environment = alloc(ModuleEnvironment, 1);
    var ok = environment != null;
    module_require(ok);
    *environment = default;
    return environment;
}

export fn frontend_modules_reset_compilation(environment: ModuleEnvironment*): void {
    if environment == null {
        return;
    }
    if environment.compilation_session != null {
        syntax_destroy(environment.compilation_session);
    }
    environment.compilation_session = null;
    // Parsed imports depend on the world's grammar baseline as well as source
    // bytes. Live graphs own their cloned roots and retained declarations, so
    // retiring these snapshots cannot invalidate an outstanding request.
    foreach(var cached in &environment.cache) { frontend_module_destroy(cached); }
    environment.cache.length = 0;
    // Live leases keep their parser and inputs. Retired caches are discarded
    // only after the owning request drains and returns its session.
    var next = environment.session_generation + 1;
    var valid = next != 0;
    module_require(valid);
    environment.session_generation = next;
}

// Reuse parser tables, never program-specific parse trees or semantic components.
export fn frontend_module_session(module: FrontendModule*): void* {
    if module.compilation_session != null {
        return module.compilation_session;
    }
    var environment = module.graph.environment;
    var session = environment.compilation_session;
    environment.compilation_session = null;
    if session == null {
        session = bits(void*, syntax_session_open(module.graph.world, bits(void*, environment), module.source.text.data, module, SyntaxFoundationBaseline));
    }
    else {
        syntax_reset(session, module.source.text.data, module);
    }
    module.compilation_session = session;
    module.session_generation = environment.session_generation;
    return session;
}

fn module_session_release(module: FrontendModule*): void {
    var session = module.compilation_session;
    if session == null {
        return;
    }
    module.compilation_session = null;
    var environment = module.graph.environment;
    var reusable = module.session_generation == environment.session_generation;
    reusable &&= environment.compilation_session == null;
    if reusable {
        environment.compilation_session = session;
    } else {
        syntax_destroy(session);
    }
}

// The caller owns the environment and must drain requests before disposing it.
// This check is coordinator-owned, not a concurrent reference count.
export fn frontend_modules_try_destroy(environment: ModuleEnvironment*): bool {
    if environment.active_graphs != 0 {
        return false;
    }
    frontend_modules_destroy(environment);
    return true;
}

export fn frontend_modules_destroy(environment: ModuleEnvironment*): void {
    var drained = environment.active_graphs == 0;
    module_require(drained);
    frontend_modules_reset_compilation(environment);
    var i: usize = 0;
    for(; i != environment.cache.length; i++) {
        frontend_module_destroy(environment.cache.data[i]);
    }
    vector_dispose(&environment.cache);
    frontend_modules_clear(environment);
    frontend_modules_used_clear(environment);
    vector_dispose(&environment.inputs);
    i = 0;
    for(; i != environment.aliases.length; i++) {
        vector_dispose(&environment.aliases.data[i].name);
        vector_dispose(&environment.aliases.data[i].path);
    }
    vector_dispose(&environment.aliases);
    vector_dispose(&environment.entry);
    vector_dispose(&environment.library);
    vector_dispose(&environment.fallback);
    vector_dispose(&environment.used);
    frontend_modules_sources_clear(environment);
    vector_dispose(&environment.sources);
    vector_dispose(&environment.bases);
    if environment.anchor is not null { entity_release(environment.anchor); }
    free(environment);
}

// Snapshots are captured during import parsing, before semantic attachment.
// Grammar declarations remain immutable; ordinary roots are copied both into
// snapshots and into each requesting graph. Cache identity includes the exact
// source and resolution of every dependency, plus baseline invalidation above.
fn module_cacheable(module: FrontendModule*): bool {
    // A back-edge may still point at an unfinished module. Never cache that
    // partial snapshot, even if cycle validation will reject the request later.
    if module.graph.cycles {
        return false;
    }
    if module.state != ModuleLoaded {
        return false;
    }
    var i: usize = 0;
    loop {
        if i == module.dependencies.length {
            return true;
        }
        if !module_cacheable(module.dependencies.data[i]) {
            return false;
        }
        i++;
    }
}

fn module_cache_valid(environment: ModuleEnvironment*, module: FrontendModule*): bool {
    var text: vector(u8);
    vector_init(&text);
    var status = module_read(environment, module.source.name.data, &text);
    var ok = status == ModuleReady;
    ok &&= module_equal(text.data, module.source.text.data);
    vector_dispose(&text);
    if !ok {
        return false;
    }
    var i: usize = 0;
    loop {
        if i == module.dependencies.length {
            return true;
        }
        var path: vector(u8);
        vector_init(&path);
        vector_init(&text);
        var declaration = bits(SyntaxNode*, compiler_node_get(module.imports.data[i], CompilerSyntax));
        status = module_resolve(module, declaration.name.data, declaration.literal, &path, &text);
        ok = status == ModuleReady;
        ok &&= module_equal(path.data, module.dependencies.data[i].source.name.data);
        vector_dispose(&path);
        vector_dispose(&text);
        ok &&= module_cache_valid(environment, module.dependencies.data[i]);
        if !ok {
            return false;
        }
        i++;
    }
}

fn module_cached(environment: ModuleEnvironment*, path: u8*, text: u8*): FrontendModule* {
    var i: usize = 0;
    loop {
        if i == environment.cache.length {
            return null;
        }
        var candidate = environment.cache.data[i];
        var same = module_equal(candidate.source.name.data, path);
        same &&= module_equal(candidate.source.text.data, text);
        same &&= module_cache_valid(environment, candidate);
        if same {
            return candidate;
        }
        i++;
    }
}

fn module_clone(graph: ModuleGraph*, source: FrontendModule*): FrontendModule* {
    var i: usize = 0;
    for(; i != graph.entities.length; i++) {
        var old = module_node(graph, graph.entities.data[i]);
        if module_equal(old.source.name.data, source.source.name.data) {
            if old.state == ModuleLoading {
                module_fail(old, "Import cycle through ", old.source.name.data);
                return null;
            }
            return old;
        }
    }
    var result = module_new(graph, source.source.name.data, source.source.text.data);
    i = 0;
    for(; i != source.dependencies.length; i++) {
        var dependency = module_clone(graph, source.dependencies.data[i]);
        if dependency == null {
            return null;
        }
        module_require(vector_push(&result.dependencies, dependency));
    }
    i = 0;
    for(; i != source.declarations.length; i++) {
        var declaration = source.declarations.data[i];
        entity_retain(declaration);
        module_require(vector_push(&result.declarations, declaration));
    }
    foreach(var root in &source.roots) {
        var copied: usize = 0;
        var tree = compiler_clone_tree(root, ModuleMaximumSourceBytes, &copied);
        module_require(tree != null);
        module_require(vector_push(&result.roots, tree));
    }
    foreach(var span in &source.comments) { module_require(vector_push(&result.comments, span)); }
    i = 0;
    loop {
        if i == source.imports.length {
            break;
        }
        // Cached grammar is immutable. Each request gets fresh import syntax
        // entities before attaching compilation-specific ownership/bindings.
        var copied: usize = 0;
        var declaration = compiler_clone_tree(source.imports.data[i], ModuleMaximumSourceBytes, &copied);
        var present = declaration != null;
        module_require(present);
        var reader: SyntaxReader = {
            source: result.source, match_kind: compiler_world_type(graph.world, CompilerParserMatch),
            syntax_kind: compiler_world_type(graph.world, CompilerSyntax), ..default
        };
        module_require(module_read_import(&reader, declaration));
        module_require(vector_push(&result.imports, declaration));
        i++;
    }
    result.body = true;
    module_complete(result);
    return result;
}

fn module_cache_store(module: FrontendModule*): void {
    // Cache grammar-bearing modules and import wrappers. Their ordinary
    // dependencies must not disable grammar reuse (Foundation's type prelude
    // is one such dependency). Pure code modules need no separate snapshot.
    if module.roots.length != 0 && module.declarations.length == 0 { return; }
    if !module_cacheable(module) {
        return;
    }
    var environment = module.graph.environment;
    var graph = alloc(ModuleGraph, 1);
    var present = graph != null;
    module_require(present);
    *graph = default;
    graph.world = module.graph.world;
    graph.environment = environment;
    var snapshot = module_clone(graph, module);
    if environment.cache.length == ModuleCacheEntries {
        frontend_module_destroy(environment.cache.data[0]);
        for(var i: usize = 1; i != environment.cache.length; i++) {
            var previous = i -1;
            environment.cache.data[previous] = environment.cache.data[i];
        }
        environment.cache.length--;
    }
    module_require(vector_push(&environment.cache, snapshot));
}

export fn frontend_modules_used_clear(environment: ModuleEnvironment*): void {
    foreach(var & used_item in &environment.used) {
        free(*used_item);
    }
    environment.used.length = 0;
}

export fn frontend_modules_used_count(environment: ModuleEnvironment*): usize {
    return environment.used.length;
}

export fn frontend_modules_used_name(environment: ModuleEnvironment*, index: usize): u8* {
    return environment.used.data[index];
}

export fn frontend_modules_implicit(environment: ModuleEnvironment*): bool {
    // Retain the host ABI; ordinary files no longer acquire implicit imports.
    return false;
}

export fn frontend_modules_sources_clear(environment: ModuleEnvironment*): void {
    foreach(var & source in &environment.sources) {
        syntax_source_release(*source);
    }
    environment.sources.length = 0;
    environment.bases.length = 0;
    syntax_source_release(environment.diagnostic);
    environment.diagnostic = null;
    environment.diagnostic_offset = 0;
}

export fn frontend_module_position(module: FrontendModule*, base: usize): void {
    var environment = module.graph.environment;
    syntax_source_retain(module.source);
    module_require(vector_push(&environment.sources, module.source));
    module_require(vector_push(&environment.bases, base));
}

export fn frontend_module_diagnostic(module: FrontendModule*, offset: usize): void {
    var environment = module.graph.environment;
    if environment.diagnostic == null {
        environment.diagnostic = module.source;
        syntax_source_retain(module.source);
        environment.diagnostic_offset = offset;
    }
}

export fn frontend_modules_source_count(environment: ModuleEnvironment*): usize {
    return environment.sources.length;
}

export fn frontend_modules_source_name(environment: ModuleEnvironment*, index: usize): u8* {
    return environment.sources.data[index].name.data;
}

export fn frontend_modules_source_base(environment: ModuleEnvironment*, index: usize): usize {
    return environment.bases.data[index];
}

export fn frontend_modules_source_length(environment: ModuleEnvironment*, index: usize): usize {
    return environment.sources.data[index].text.length;
}

export fn frontend_modules_error_file(environment: ModuleEnvironment*): u8* {
    if environment.diagnostic == null {
        return "";
    }
    return environment.diagnostic.name.data;
}

export fn frontend_modules_error_offset(environment: ModuleEnvironment*): usize {
    return environment.diagnostic_offset;
}

// Native transport asks the same source map used by browser execution handles.
export fn frontend_modules_location(environment: ModuleEnvironment*, offset: usize, line: usize*, column: usize*): u8* {
    var source = environment.diagnostic;
    var found = source != null;
    if found {
        offset = environment.diagnostic_offset;
    }
    else {
        for(var i: usize = 0; i != environment.sources.length; i++) {
            var candidate = environment.sources.data[i];
            var base = environment.bases.data[i];
            var end = base + candidate.text.length;
            var selected = offset >= base;
            selected &&= offset <= end;
            if selected {
                source = candidate;
                offset = offset - base;
                break;
            }
        }
    }
    found = source != null;
    if found {
        syntax_source_location(source, offset, line, column);
        return source.name.data;
    }
    return "";
}

fn module_make_path(text: vector(u8)*, path: u8*): void {
    var i: usize = 0;
    loop {
        var byte = path[i];
        if byte == 0 {
            return;
        }
        var escape = byte == 32;
        escape ||= byte == 35;
        escape ||= byte == 58;
        escape ||= byte == 92;
        if escape {
            module_require(vector_push(text, 92));
        }
        if byte == 36 {
            module_require(vector_push(text, 36));
        }
        module_require(vector_push(text, byte));
        i++;
    }
}

export fn frontend_modules_depfile(environment: ModuleEnvironment*, output: u8*, path: u8*): bool {
    return frontend_modules_depfile_append(environment, output, path, false);
}

// Separate unit prerequisites combine as ordinary make rules for one output.
// The coordinator writes them in unit order after all frontend workers join.
export fn frontend_modules_depfile_append(environment: ModuleEnvironment*, output: u8*, path: u8*, append: bool): bool {
    if path[0] == 0 {
        return true;
    }
    var text: vector(u8);
    vector_init(&text);
    module_make_path(&text, output);
    module_require(bytes_append(&text, ":", 1));
    foreach(var & used_item in &environment.used) {
        module_require(bytes_append(&text, " ", 1));
        module_make_path(&text, *used_item);
    }
    module_require(bytes_append(&text, "\n", 1));
    var file = fopen(path, append ? "ab" : "wb");
    var ok = file != null;
    if ok {
        var written = fwrite(text.data, 1, text.length, file);
        ok = written == text.length;
        if !(fclose(file) == 0) {
            ok = false;
        }
    }
    vector_dispose(&text);
    return ok;
}

// Borrowed environment; the caller retains the module lease for this access.
export fn frontend_module_environment(module: FrontendModule*): ModuleEnvironment* {
    return module.graph.environment;
}
