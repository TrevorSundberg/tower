import tower;
import semantic_context_types;
import foundation_tags;
import foundation_types;
import frontend_compilation;
import parser_types;
import semantic_context;
import semantic_definitions;
import semantic_lifecycle;
import semantic_modules;
import .library.stack;
import .library.vector;
import .library.float_text;
import .library.work_arena_api;
import .library.work_arena_types;
import .library.work_budget_types;
import .library.work_buffer;

extern fn compiler_buffer_allocate(bytes: usize): void*;
extern fn compiler_buffer_free(pointer: void*): void;
extern fn compiler_buffer_alignment(): usize;

// Private declaration continuations often retain only a few table entries.
// Keep their stable arena chunks small; larger slices still request their exact
// required capacity through WorkArena, without changing the world byte limit.
var SemanticScratchChunkBytes: usize = 1024;
var SemanticTableInitialCapacity: usize = 16;

// This path is also used under denied allocation. Recording the first typed
// cause and source position requires no diagnostic buffer or shared mutation.
fn sem_scratch_error(c: SemanticContext*, subject: void*, error: WorkBudgetError): void {
    if c.program.resource.error != WorkBudgetError.None { return; }
    if subject == null { subject = c.current; }
    var node = sem_get(subject);
    var offset = node == null ? sem_offset(c, subject) : node.start;
    sem_resource_record(c.program, error, offset);
    c.program.error_offset = offset;
}

export fn sem_scratch_dispose(scratch: SemanticScratch*): void {
    var list = scratch.first;
    while list != null {
        work_buffer_dispose(&list.storage);
        list = list.next;
    }
    work_arena_dispose(&scratch.arena);
    *scratch = default;
}

// Exact identity lookup without reading through an unregistered vector pointer.
// Each level consumes one address bit, so even adversarial allocation order is
// bounded by pointer width plus the root. Lookup never mutates a borrowed owner;
// optional probe output belongs to the caller, not the shared lexical parent.
export fn sem_scratch_find(scratch: SemanticScratch*, value: vector(void*)*, probes: usize*): SemanticScratchList* {
    var key = bits(usize, value);
    var list = scratch.index;
    var visited: usize = 0;
    while list != null {
        visited++;
        if &list.value == value { break; }
        list = (key & 1) == 0 ? list.index_zero : list.index_one;
        key >>= 1;
    }
    if probes != null { *probes = visited; }
    return list;
}

// Only newly allocated or joined descriptors enter this private derived index.
// Registration cannot fail or allocate; the separate next chain owns disposal.
fn sem_scratch_register(scratch: SemanticScratch*, list: SemanticScratchList*): void {
    var key = bits(usize, &list.value);
    var slot = &scratch.index;
    list.index_zero = null;
    list.index_one = null;
    while *slot != null {
        var at = *slot;
        slot = (key & 1) == 0 ? &at.index_zero : &at.index_one;
        key >>= 1;
    }
    *slot = list;
}

export fn sem_scratch_private(c: SemanticContext*, parent: SemanticContext*): void {
    c.scratch = default;
    c.scratch_parent = parent;
    c.scan = default;
    c.token_text = default;
    c.scan_storage = default;
    c.token_storage = default;
}

fn sem_scan_dispose(c: SemanticContext*): void {
    work_buffer_dispose(&c.scan_storage);
    work_buffer_dispose(&c.token_storage);
    c.scan = default;
    c.token_text = default;
}

// Joined owners only. Splicing existing receipts cannot need another grant.
export fn sem_scratch_append(c: SemanticContext*, source: SemanticScratch*): void {
    if source == &c.scratch { return; }
    if source.arena.chunk_bytes == 0 { return; }
    if c.scratch.arena.chunk_bytes == 0 {
        c.scratch = *source;
        *source = default;
        return;
    }
    if !work_arena_append(&c.scratch.arena, &source.arena) {
        sem_scratch_error(c, c.current, WorkBudgetError.Invalid);
        return;
    }
    // All borrowers have joined. Relink only transferred descriptors; failure
    // above leaves both indexes intact. No grant is needed under memory pressure.
    var list = source.first;
    while list != null {
        sem_scratch_register(&c.scratch, list);
        list = list.next;
    }
    if c.scratch.last == null { c.scratch.first = source.first; }
    else { c.scratch.last.next = source.first; }
    if source.last != null { c.scratch.last = source.last; }
    *source = default;
}

fn sem_scratch_prepare(c: SemanticContext*): bool {
    if c.program.resource.error != WorkBudgetError.None { return false; }
    if c.scratch.arena.chunk_bytes != 0 { return true; }
    if work_arena_init(&c.scratch.arena, compiler_world_work_budget(compiler_node_world(c.program.root)), SemanticScratchChunkBytes) { return true; }
    sem_scratch_error(c, c.current, WorkBudgetError.Invalid);
    return false;
}

// Semantic compiler over shared Foundation components.
// Temporary indexes and scratch allocations are scoped to one compilation.

export fn semantic_type_equal(a: FoundationType*, b: FoundationType*): bool {
    if a.scalar != b.scalar || a.pointers != b.pointers {
        return false;
    }
    if a.record != b.record {
        if a.scalar != SFunction || a.record == null || b.record == null { return false; }
        var left = sem_get(a.record);
        var right = sem_get(b.record);
        if !semantic_type_equal(&left.element, &right.element) || left.parameters.length != right.parameters.length { return false; }
        for(var i: usize = 0; i < left.parameters.length; i++) {
            if !semantic_type_equal(&sem_get(left.parameters.data[i]).type, &sem_get(right.parameters.data[i]).type) { return false; }
        }
    }
    if a.pointers != 0 || a.scalar == SUSize || a.scalar == SFunction {
        return a.pointer_bytes == b.pointer_bytes;
    }
    return true;
}

// Scalar representation plus nominal entity identity; pointers retain that
// identity too. Built-in scalars have no record, aggregates have their own tags.
export fn semantic_enum(t: FoundationType*): bool {
    var nominal = t.record != null;
    nominal &&= t.scalar != SStruct;
    nominal &&= t.scalar != SArray;
    nominal &&= t.scalar != SFunction;
    return nominal;
}

export fn semantic_aggregate(t: FoundationType*): bool {
    return t.pointers == 0 &&(t.scalar == SStruct || t.scalar == SArray);
}

export fn semantic_integer(t: FoundationType*): bool {
    var step2 = t.pointers == 0 &&(t.scalar == SI32 || t.scalar == SU32 || t.scalar == SU8 || t.scalar == SI64 || t.scalar == SU64 || t.scalar == SUSize || t.scalar == SI8 || t.scalar == SI16 || t.scalar == SU16);
    return step2;
}

export fn semantic_float(t: FoundationType*): bool {
    return t.pointers == 0 && (t.scalar == SF32 || t.scalar == SF64);
}

fn semantic_numeric_binary(t: FoundationType*, operation: u32): bool {
    if semantic_integer(t) { return true; }
    return semantic_float(t) && (operation <= ODiv || operation >= OEq && operation <= OGe);
}

fn sem_float_literal(c: SemanticContext*, node: void*): bool {
    if !sem_literal(c, node) { return false; }
    var text = sem_token_text(c, node);
    if text == null { return false; }
    var start: usize = text[0] == FloatDecimalMinus ? 1 : 0;
    if !float_decimal_digit(text[start]) { return false; }
    for (var i: usize = 0; text[i] != 0; i++) {
        if text[i] == FloatDecimalPoint || text[i] == FloatDecimalExponent || text[i] == FloatDecimalUpperExponent { return true; }
    }
    return false;
}

export fn semantic_signed(t: FoundationType*): bool {
    return t.pointers == 0 &&(t.scalar == SI32 || t.scalar == SI64 || t.scalar == SI8 || t.scalar == SI16);
}

export fn semantic_unsigned_scalar(scalar: u32): u32 {
    if scalar == SI8 { return SU8; }
    if scalar == SI16 { return SU16; }
    if scalar == SI32 { return SU32; }
    if scalar == SI64 { return SU64; }
    return scalar;
}

export fn semantic_size(t: FoundationType*): usize {
    if t.pointers != 0 || t.scalar == SUSize || t.scalar == SFunction {
        return convert(usize, t.pointer_bytes);
    }
    if semantic_aggregate(t) {
        var step7 = sem_get(t.record);
        return step7.size;
    }
    if t.scalar == SType {
        // Opaque execution-local references have one explicit storage width.
        // Their numeric indexes are never a portable type identity or ABI.
        return convert(usize, IntegerWordWidth / IntegerByteWidth);
    }
    if t.scalar == SVoid {
        return 0;
    }
    if t.scalar == SBool || t.scalar == SU8 || t.scalar == SI8 {
        return 1;
    }
    if t.scalar == SI16 || t.scalar == SU16 {
        return convert(usize, IntegerShortWidth / IntegerByteWidth);
    }
    if t.scalar == SI64 || t.scalar == SU64 || t.scalar == SF64 {
        return 8;
    }
    return 4;
}

export fn semantic_alignment(t: FoundationType*): usize {
    if t.pointers != 0 || t.scalar == SUSize || t.scalar == SFunction {
        return convert(usize, t.pointer_bytes);
    }
    if semantic_aggregate(t) {
        var step7 = sem_get(t.record);
        return step7.alignment;
    }
    var result: usize = semantic_size(t);
    if result == 0 {
        return 1;
    }
    return result;
}

export fn semantic_width(t: FoundationType*): u32 {
    var step2 = semantic_size(t) *8;
    return convert(u32, step2);
}

export fn semantic_mask(t: FoundationType*): u64 {
    var width: u32 = semantic_width(t);
    var result: u64 = 1;
    for(var i: u32 = 0; i < width; i++) {
        result = result * 2;
    }
    return result -1;
}

fn sem_length(s: u8*): usize {
    var i: usize = 0;
    if s != null {
        for(; s[i] != 0; i++) {}
    }
    return i;
}

export fn sem_equal(a: u8*, b: u8*): bool {
    if a == null || b == null { return false; }
    for(var i: usize = 0; a[i] == b[i]; i++) {
        if a[i] == 0 {
            return true;
        }
    }
    return false;
}

export fn sem_allocate(c: SemanticContext*, count: usize): u8* {
    if !sem_scratch_prepare(c) { return null; }
    var result: u8* = null;
    var error = work_arena_allocate_result(&c.scratch.arena, count, compiler_buffer_alignment(), &result);
    if error != WorkBudgetError.None { sem_scratch_error(c, c.current, error); }
    return result;
}

fn sem_text(c: SemanticContext*, s: u8*, count: usize): u8* {
    if count == ~convert(usize, 0) || (count != 0 && s == null) {
        sem_scratch_error(c, c.current, WorkBudgetError.Invalid);
        return null;
    }
    var result: u8* = sem_allocate(c, count + 1);
    if result == null { return null; }
    if count != 0 {
        copy(result, s, count);
    }
    result[count] = 0;
    return result;
}

fn sem_cat(c: SemanticContext*, a: u8*, b: u8*): u8* {
    var x: usize = sem_length(a);
    var y: usize = sem_length(b);
    if y >= ~convert(usize, 0) - x {
        sem_scratch_error(c, c.current, WorkBudgetError.Invalid);
        return null;
    }
    var result: u8* = sem_allocate(c, x + y + 1);
    if result == null { return null; }
    copy(result, a, x);
    copy(&result[x], b, y);
    var step6 = x + y;
    result[step6] = 0;
    return result;
}

fn sem_decimal(c: SemanticContext*, value: u64): u8* {
    var buffer: u8[21];
    var i: usize = 20;
    buffer[i] = 0;
    loop {
        if !true {
            break;
        }
        i--;
        var digit: u64 = value % 10;
        var step3 = digit + 48;
        var step4 = convert(u8, step3);
        buffer[i] = step4;
        value = value / 10;
        if value == 0 {
            break;
        }
    }
    var step7 = 20 -i;
    return sem_text(c, &buffer[i], step7);
}

fn sem_type_new(c: SemanticContext*, scalar: u32, pointers: u32, record: void*): FoundationType* {
    var step2 = sem_allocate(c, sizeof(FoundationType));
    if step2 == null { return null; }
    var t: FoundationType* = bits(FoundationType*, step2);
    var step4 = sizeof(FoundationType);
    fill(t, 0, step4);
    t.scalar = scalar;
    t.pointers = pointers;
    t.record = record;
    t.pointer_bytes = c.program.pointer_bytes;
    return t;
}

fn sem_type_value(c: SemanticContext*, scalar: u32, pointers: u32, record: void*): FoundationType {
    return init(FoundationType) {scalar: scalar, pointers: pointers, record: record,
        pointer_bytes: c.program.pointer_bytes, ..default};
}

fn sem_type_copy(c: SemanticContext*, t: FoundationType*): FoundationType* {
    var result: FoundationType* = sem_type_new(c, SI32, 0, null);
    if result == null { return null; }
    *result = *t;
    return result;
}

fn sem_set_type(out: FoundationType*, t: FoundationType*): void {
    if t == null { return; }
    *out = *t;
}

fn sem_type_name(c: SemanticContext*, t: FoundationType*): u8* {
    if !sem_ok(c) || t == null { return null; }
    var name: u8* = "";
    if t.scalar == SFunction {
        var signature = sem_get(t.record);
        name = sem_cat(c, "function(", sem_type_name(c, &signature.element));
        foreach(var parameter in &signature.parameters) {
            name = sem_cat(c, name, sem_cat(c, ", ", sem_type_name(c, &sem_get(parameter).type)));
        }
        name = sem_cat(c, name, ")");
    } else { if t.scalar == SArray {
        var a: FoundationNode* = sem_get(t.record);
        var step4 = sem_cat(c, sem_type_name(c, &a.element), "[");
        var step6 = sem_decimal(c, convert(u64, a.length));
        name = sem_cat(c, sem_cat(c, step4, step6), "]");
    } else {
        var step9 = t.scalar == SStruct;
        if semantic_enum(t) {
            step9 = true;
        }
        if step9 {
            name = sem_name(sem_get(t.record));
        } else {
            name = semantic_scalar_name(t.scalar);
        }
    }
    }
    for(var i: u32 = 0; i < t.pointers; i++) {
        name = sem_cat(c, name, "*");
    }
    return name;
}

fn sem_number(c: SemanticContext*, value: u64, t: FoundationType*): u8* {
    var mask: u64 = semantic_mask(t);
    value = value & mask;
    var sign: u64 = mask / 2;
    sign++;
    if semantic_signed(t) &&(value &sign) != 0 {
        var negative: u64 = 0;
        negative = negative - value;
        var step9 = sem_decimal(c, negative &mask);
        return sem_cat(c, "-", step9);
    }
    return sem_decimal(c, value);
}

export fn sem_name(n: FoundationNode*): u8* {
    if n.name.data == null {
        return "";
    }
    return n.name.data;
}

fn sem_set_name(c: SemanticContext*, n: FoundationNode*, name: u8*): bool {
    if !sem_ok(c) || name == null { return false; }
    var count: usize = sem_length(name);
    var step2 = count + 1;
    if !vector_reserve(&n.name, step2) {
        sem_scratch_error(c, c.current, WorkBudgetError.Memory); return false;
    }
    var step4 = count + 1;
    copy(n.name.data, name, step4);
    n.name.length = count;
    return true;
}

export fn sem_push_checked(c: SemanticContext*, v: vector(void*)*, n: void*): bool {
    if !sem_ok(c) { return false; }
    if v == null || v.length == ~convert(usize, 0) {
        sem_scratch_error(c, c.current, WorkBudgetError.Invalid);
        return false;
    }
    var storage: WorkBuffer* = null;
    var budget: WorkBudget* = null;
    if v == &c.scan {
        storage = &c.scan_storage;
        budget = compiler_world_work_budget(compiler_node_world(c.program.root));
    } else {
        var owner = c;
        while owner != null {
            var list = sem_scratch_find(&owner.scratch, v, null);
            if list != null {
                storage = &list.storage;
                budget = owner.scratch.arena.budget;
                break;
            }
            owner = owner.scratch_parent;
        }
    }
    if storage != null {
        if v.length == v.capacity {
            var error = work_buffer_grow_elements(storage, budget,
                v.length, v.capacity, v.length + 1, sizeof(void*), alignof(void*));
            if error != WorkBudgetError.None {
                sem_scratch_error(c, c.current, error);
                return false;
            }
            v.data = bits(void**, storage.data);
            v.capacity = storage.capacity / sizeof(void*);
        }
        v.data[v.length++] = n;
        return true;
    }
    if vector_push(v, n) { return true; }
    sem_scratch_error(c, c.current, WorkBudgetError.Memory);
    return false;
}

// Compatibility for non-semantic API clients. Scratch owners use the checked
// context-taking operation above so a denial has a durable failure receipt.
export fn sem_push(v: vector(void*)*, n: void*): void {
    sem_require(vector_push(v, n));
}

export fn sem_list(c: SemanticContext*): vector(void*)* {
    var list = bits(SemanticScratchList*, sem_allocate(c, sizeof(SemanticScratchList)));
    if list == null { return null; }
    *list = default;
    sem_scratch_register(&c.scratch, list);
    if c.scratch.last == null { c.scratch.first = list; }
    else { c.scratch.last.next = list; }
    c.scratch.last = list;
    return &list.value;
}

fn sem_has(v: vector(void*)*, n: void*): bool {
    if v == null { return false; }
    foreach(var & v_item in v) {
        if *v_item == n {
            return true;
        }
    }
    return false;
}

// Push in reverse so popping visits source children in their original order.
// Neither scan calls semantic resolution or another scan while scratch is live.
fn sem_scan_children(c: SemanticContext*, n: void*): void {
    var i = sem_child_count(n);
    while i != 0 {
        i--;
        if !sem_push_checked(c, &c.scan, sem_child(n, i)) { return; }
    }
}

fn sem_collect(c: SemanticContext*, n: void*, wanted: u8*): vector(void*)* {
    defer { c.scan.length = 0; }
    var result = sem_list(c);
    if result == null { return null; }
    if n != null {
        if !sem_push_checked(c, &c.scan, n) { return null; }
    }
    var at: void* = null;
    while sem_ok(c) && stack_pop(&c.scan, &at) {
        if sem_is(at, wanted) {
            sem_push_checked(c, result, at);
        } else {
            sem_scan_children(c, at);
        }
    }
    return sem_ok(c) ? result : null;
}

// Borrow until the next token query on this private context. Callers that retain
// or decode text must use sem_tokens instead.
fn sem_token_text(c: SemanticContext*, n: void*): u8* {
    if !sem_ok(c) { return null; }
    defer { c.scan.length = 0; }
    c.token_text.length = 0;
    if n != null {
        if !sem_push_checked(c, &c.scan, n) { return null; }
    }
    var at: void* = null;
    while sem_ok(c) && stack_pop(&c.scan, &at) {
        var parsed = sem_match(at);
        var is_token = parsed != null;
        is_token &&= parsed.rule == sem_maximum();
        if is_token {
            if parsed.label.length >= ~convert(usize, 0) - c.token_text.length {
                sem_scratch_error(c, n, WorkBudgetError.Invalid); return null;
            }
            if !sem_token_reserve(c, n, c.token_text.length + parsed.label.length + 1) { return null; }
            copy(c.token_text.data + c.token_text.length, parsed.label.data, parsed.label.length);
            c.token_text.length += parsed.label.length;
        } else {
            sem_scan_children(c, at);
        }
    }
    if !sem_ok(c) { return null; }
    if !sem_token_reserve(c, n, c.token_text.length + 1) { return null; }
    c.token_text.data[c.token_text.length] = 0;
    return c.token_text.data;
}

fn sem_token_reserve(c: SemanticContext*, subject: void*, needed: usize): bool {
    if needed <= c.token_text.capacity { return true; }
    var error = work_buffer_grow_elements(&c.token_storage,
        compiler_world_work_budget(compiler_node_world(c.program.root)), c.token_text.length,
        c.token_text.capacity, needed, sizeof(u8), alignof(u8));
    if error != WorkBudgetError.None { sem_scratch_error(c, subject, error); return false; }
    c.token_text.data = c.token_storage.data;
    c.token_text.capacity = c.token_storage.capacity;
    return true;
}

fn sem_tokens(c: SemanticContext*, n: void*): u8* {
    var text = sem_token_text(c, n);
    if text == null { return null; }
    // Identifier decoding mutates this owned copy, never the parsed token or
    // scratch storage subsequently reused by another query.
    return sem_text(c, text, c.token_text.length);
}

fn sem_identifier(c: SemanticContext*, n: void*): u8* {
    var text: u8* = sem_tokens(c, n);
    if text == null { return null; }
    sem_decode_identifier(text);
    return text;
}

fn sem_literal(c: SemanticContext*, n: void*): bool {
    // Rich expressions can start with digits or '-'; that does not make the
    // whole expression an untyped literal. Only unwrap transparent/group nodes.
    loop {
        var wrapper = sem_is(n, "TowerExpression") || sem_is(n, "TowerComma")
        || sem_is(n, "CoreOperand") || sem_is(n, "CoreValue") || sem_is(n, "CoreCallArgument");
        if !wrapper {
            break;
        }
        if sem_child_count(n) == 1 {
            n = sem_child(n, 0);
        }
        else {
            var group = sem_member(n, "value");
            if group != null {
                n = group;
            }
            else {
                break;
            }
        }
    }
    if sem_is(n, "TowerDefault") { return sem_member(n, "type") == null; }
    if sem_is(n, "TowerInitializer") { return sem_member(n, "type") == null; }
    if sem_is(n, "TowerExpression") || sem_is(n, "TowerComma") {
        var right = sem_member(n, "right");
        if right == null || sem_member(n, "left") != null {
            return false;
        }
        if !sem_equal(sem_token_text(c, sem_child(n, 0)), "-") {
            return false;
        }
        return sem_literal(c, right);
    }
    var text = sem_token_text(c, n);
    if text == null { return false; }
    var step3 = sem_equal(text, "true") || sem_equal(text, "false") || sem_equal(text, "null") || text[0] == 39 || text[0] == 34 || text[0] == 45 || text[0] >= 48 && text[0] <= 57;
    return step3;
}

fn sem_unwrap(n: void*): void* {
    if sem_is(n, "Statement") && sem_child_count(n) == 1 {
        return sem_child(n, 0);
    }
    return n;
}

fn sem_maximum(): usize {
    var n: usize = 0;
    return n -1;
}

fn sem_hash(key: u8*): usize {
    var h: usize = 2166136261;
    for(var i: usize = 0; key[i] != 0; i++) {
        var step3 = convert(usize, key[i]);
        h = h ^ step3;
        h = h * 16777619;
    }
    return h;
}

export fn sem_table(c: SemanticContext*): SemanticTable* {
    var step2 = sem_allocate(c, sizeof(SemanticTable));
    if step2 == null { return null; }
    var t: SemanticTable* = bits(SemanticTable*, step2);
    var step4 = sizeof(SemanticTable);
    fill(t, 0, step4);
    return t;
}

export fn sem_find(t: SemanticTable*, text: u8*, entity: void*): SemanticEntry* {
    if t == null || t.capacity == 0 {
        return null;
    }
    var h: usize = bits(usize, entity);
    if text != null {
        h = sem_hash(text) ^ h;
    } else {
        h = h / 8;
    }
    var i: usize = h % t.capacity;
    loop {
        if t.entries[i] == null {
            break;
        }
        var entry: SemanticEntry* = t.entries[i];
        if text != null {
            var step11 = entry.text != null;
            if step11 {
                step11 = sem_equal(entry.text, text);
                step11 &&= entry.entity == entity;
            }
            if step11 {
                return entry;
            }
        } else {
            if entry.text == null && entry.entity == entity {
                return entry;
            }
        }
        i =(i + 1) % t.capacity;
    }
    return null;
}

fn sem_insert(t: SemanticTable*, entry: SemanticEntry*): void {
    var h: usize = bits(usize, entry.entity);
    if entry.text != null {
        h = sem_hash(entry.text) ^ h;
    } else {
        h = h / 8;
    }
    var i: usize = h % t.capacity;
    loop {
        if t.entries[i] == null {
            break;
        }
        i =(i + 1) % t.capacity;
    }
    t.entries[i] = entry;
}

fn sem_entry(c: SemanticContext*, t: SemanticTable*, text: u8*, entity: void*): SemanticEntry* {
    if !sem_scratch_prepare(c) { return null; }
    var result: SemanticEntry* = null;
    var error = sem_entry_arena(&c.scratch.arena, t, text, entity, &result);
    if error != WorkBudgetError.None { sem_scratch_error(c, entity == null ? c.current : entity, error); }
    return result;
}
// Fallible common-lifetime storage uses the same semantic index and identity
// rules as ordinary scratch. Existing entries remain stable through growth;
// a failed insertion never publishes a partial entry or replaces the output.
export fn sem_entry_arena(arena: WorkArena*, table: SemanticTable*, text: u8*, entity: void*,
    output: SemanticEntry**): WorkBudgetError {
    if table == null || output == null { return WorkBudgetError.Invalid; }
    var found = sem_find(table, text, entity);
    if found != null { *output = found; return WorkBudgetError.None; }
    var maximum = ~convert(usize, 0);
    if table.count >= maximum / 2 { return WorkBudgetError.Invalid; }
    var next = *table;
    if (table.count + 1) * 2 >= table.capacity {
        if table.capacity > maximum / 2 { return WorkBudgetError.Invalid; }
        next.capacity = table.capacity < SemanticTableInitialCapacity / 2 ? SemanticTableInitialCapacity : table.capacity * 2;
        if next.capacity > maximum / sizeof(SemanticEntry*) { return WorkBudgetError.Invalid; }
        var memory: u8* = null;
        var error = work_arena_allocate_result(arena, next.capacity * sizeof(SemanticEntry*), alignof(SemanticEntry*), &memory);
        if error != WorkBudgetError.None { return error; }
        next.entries = bits(SemanticEntry**, memory);
        fill(next.entries, 0, next.capacity * sizeof(SemanticEntry*));
        for(var i: usize = 0; i < table.capacity; i++) {
            if table.entries[i] != null { sem_insert(&next, table.entries[i]); }
        }
    }
    var memory: u8* = null;
    var error = work_arena_allocate_result(arena, sizeof(SemanticEntry), alignof(SemanticEntry), &memory);
    if error != WorkBudgetError.None { return error; }
    var entry = bits(SemanticEntry*, memory);
    *entry = init(SemanticEntry) {text: text, entity: entity, ..default};
    sem_insert(&next, entry);
    next.count++;
    *table = next;
    *output = entry;
    return WorkBudgetError.None;
}

fn sem_lookup_table(t: SemanticTable*, text: u8*): void* {
    var found: SemanticEntry* = sem_find(t, text, null);
    if found == null {
        return null;
    }
    return found.value;
}

fn sem_put(c: SemanticContext*, t: SemanticTable*, text: u8*, value: void*): bool {
    var found: SemanticEntry* = sem_entry(c, t, text, null);
    if found == null || found.value != null {
        return false;
    }
    found.value = value;
    return true;
}

export fn sem_state(c: SemanticContext*, t: SemanticTable*, n: void*): SemanticEntry* {
    return sem_entry(c, t, null, n);
}

fn sem_source_base(c: SemanticContext*, n: void*): usize {
    loop {
        if n == null {
            break;
        }
        var found: SemanticEntry* = sem_find(c.source_bases, null, n);
        if found != null {
            return found.number;
        }
        if c.program.modules != null {
            var component = entity_component_get(n, c.program.modules.owner_kind);
            var link = bits(SemanticModuleLink*, entity_component_data(component));
            if link != null {
                if link.module == n {
                    return link.base;
                }
            }
        }
        n = sem_parent(n);
    }
    return 0;
}

fn sem_offset(c: SemanticContext*, n: void*): usize {
    var m: ParserMatchData* = sem_match(n);
    var at: usize = sem_source_base(c, n);
    if m != null {
        at = at + m.start;
    }
    return at;
}

fn sem_ok(c: SemanticContext*): bool {
    return c.program.resource.error == WorkBudgetError.None && c.program.error.length == 0;
}

// Called in source order after joins, or on a worker's private program. Keep
// the chosen receipt and its text together without allocating on denial. An
// empty diagnostic still leaves a fatal typed receipt for output consumers.
// Message vectors own distinct buffers, or are the exact program error vector;
// borrowed interior ranges are not valid vector owners.
export fn sem_restore_resource(c: SemanticContext*, error: WorkBudgetError, message: vector(u8)*, offset: usize): bool {
    if error == WorkBudgetError.None { return false; }
    if c.program.resource.error != WorkBudgetError.None { return true; }
    var length = message.length;
    var text = message.data;
    c.program.error.length = 0;
    c.program.error_offset = offset;
    if length != 0 && length < c.program.error.capacity {
        if c.program.error.data != text { copy(c.program.error.data, text, length + 1); }
        c.program.error.length = length;
    }
    sem_resource_record(c.program, error, offset);
    return true;
}

// A producer receipt already contains its complete provenance. Restore that
// diagnostic once after the join, without appending another instantiation trace
// or replacing a previously selected message/offset.
fn sem_restore_error(c: SemanticContext*, error: vector(u8)*, offset: usize): bool {
    if error.length == 0 { return false; }
    if sem_ok(c) {
        if !vector_reserve(&c.program.error, error.length + 1) {
            sem_resource_record(c.program, WorkBudgetError.Memory, offset);
            return true;
        }
        copy(c.program.error.data, error.data, error.length + 1);
        c.program.error.length = error.length;
        c.program.error_offset = offset;
    }
    return true;
}

fn sem_instantiation_use(c: SemanticContext*, n: void*): void* {
    var use = generic_origin(c.generics, n);
    if use == null || c.body_demands == null { return use; }
    var function = n;
    while function != null && !sem_is(function, "CoreFunction") { function = sem_parent(function); }
    if function != null {
        var demand = bits(SemanticBodyDemand*, entity_component_data(entity_component_get(function, c.body_demands)));
        if demand != null { return demand.source; }
    }
    return use;
}

export fn sem_fail(c: SemanticContext*, n: void*, text: u8*): void {
    if !sem_ok(c) {
        return;
    }
    var step3 = sem_offset(c, n);
    c.program.error_offset = step3;
    // Every allocation below constructs this diagnostic, including its trace.
    // Bind private scratch to its source, then restore the lexical owner even
    // on denial. Generated Foundation spans need not equal this source span.
    var current = c.current;
    c.current = n;
    defer {
        c.current = current;
        if c.program.resource.error != WorkBudgetError.None {
            c.program.resource.offset = step3;
            c.program.error_offset = step3;
        }
    }
    var use: void* = sem_instantiation_use(c, n);
    var seen: vector(void*)* = null;
    if use != null {
        seen = sem_list(c);
        if seen == null { return; }
    }
    loop {
        if !(sem_ok(c) && use != null && seen.length < 8 && !sem_has(seen, use)) {
            break;
        }
        sem_push_checked(c, seen, use);
        var at: usize = sem_offset(c, use);
        var line: u64 = 1;
        var column: u64 = 1;
        var i = sem_source_base(c, use);
        loop {
            if !(i < at && c.source[i] != 0) {
                break;
            }
            if c.source[i] == 10 {
                line++;
                column = 1;
            } else {
                column++;
            }
            i++;
        }
        var step18 = sem_tokens(c, use);
        var step19 = sem_cat(c, "\nInstantiated by ", step18);
        text = sem_cat(c, text, step19);
        var step21 = sem_decimal(c, line);
        var step22 = sem_cat(c, " at line ", step21);
        text = sem_cat(c, text, step22);
        var step24 = sem_decimal(c, column);
        var step25 = sem_cat(c, step24, ".");
        var step26 = sem_cat(c, ", column ", step25);
        text = sem_cat(c, text, step26);
        use = sem_instantiation_use(c, use);
    }
    if !sem_ok(c) { return; }
    var count: usize = sem_length(text);
    var step30 = count + 1;
    if !vector_reserve(&c.program.error, step30) {
        sem_scratch_error(c, n, WorkBudgetError.Memory);
        return;
    }
    var step32 = count + 1;
    copy(c.program.error.data, text, step32);
    c.program.error.length = count;
}

fn sem_generic_ok(c: SemanticContext*, n: void*): bool {
    var error: u8* = generic_error(c.generics);
    if error != null {
        sem_fail(c, n, error);
    }
    return sem_ok(c);
}

fn sem_shape(c: SemanticContext*, n: void*, capture: u8*): bool {
    if n == null {
        sem_fail(c, n, "Missing foundation tree");
        return false;
    }
    if sem_member(n, capture) == null {
        var step4 = sem_label(n);
        var step6 = sem_cat(c, sem_cat(c, "Malformed ", step4), " tree: missing capture '");
        var step7 = sem_cat(c, capture, "'");
        sem_fail(c, n, sem_cat(c, step6, step7));
        return false;
    }
    return true;
}

fn sem_node_offset(c: SemanticContext*, n: void*): usize {
    n ??= c.current;
    while n != null {
        if sem_match(n) != null { return sem_offset(c, n); }
        var value = sem_get(n);
        if value != null { return value.start; }
        n = sem_parent(n);
    }
    return 0;
}

export fn sem_node_result(c: SemanticContext*, n: void*, kind: u32): FoundationNode* {
    if !sem_ok(c) { return null; }
    var position = sem_node_offset(c, n);
    var fresh: bool = sem_get(n) == null;
    // Retain the existing logical component-limit diagnostic. No payload is
    // attached and no result is published when this semantic limit is reached.
    if n != null && fresh && c.count >= c.node_limit {
        sem_fail(c, n, "Foundation component memory budget exceeded");
        c.program.error_offset = position;
        if c.program.resource.error != WorkBudgetError.None { c.program.resource.offset = position; }
        return null;
    }
    var error: WorkBudgetError;
    var result = sem_attach_result(n, kind, &error);
    if result == null {
        sem_resource_record(c.program, error, position);
        c.program.error_offset = position;
        return null;
    }
    result.start = position;
    result.end = result.start;
    var m: ParserMatchData* = sem_match(n);
    if m != null {
        result.end = result.end + m.length;
    }
    if fresh { c.count++; }
    return result;
}
