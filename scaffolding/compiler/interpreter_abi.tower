import tower;
import foundation_types;
import foundation_tags;
import interpreter_storage;
import .library.vector;

import interpreter_types;

// Remaining host callbacks and existing shared type queries only.
// FoundationNode and FoundationType are composed from foundation_nodes.tower.

extern fn sem_get(node: void*): FoundationNode*;

extern fn semantic_size(type: FoundationType*): usize;

extern fn semantic_alignment(type: FoundationType*): usize;

extern fn semantic_mask(type: FoundationType*): u64;

extern fn semantic_signed(type: FoundationType*): bool;
extern fn semantic_float(type: FoundationType*): bool;
extern fn semantic_width(type: FoundationType*): u32;
extern fn semantic_type_equal(a: FoundationType*, b: FoundationType*): bool;

// Code references are opaque, deterministic values in the interpreter's target
// address space. Only this derived table contains entity handles, never memory.
fn im_function_reference(m: IMState*, function: void*): u64 {
    var index = im_node(function).index;
    if m.function_values.length <= index {
        var previous = m.function_values.length;
        im_storage_require(vector_reserve(&m.function_values, index + 1));
        m.function_values.length = index + 1;
        for(var i = previous; i <= index; i++) { m.function_values.data[i] = null; }
    }
    im_storage_require(m.function_values.data[index] == null || m.function_values.data[index] == function);
    m.function_values.data[index] = function;
    return convert(u64, index) + 1;
}

fn im_function_matches(function: void*, type: FoundationType*): bool {
    var definition = im_node(function);
    var signature = im_node(type.record);
    if !im_call_type_equal(&definition.type, &signature.element) || definition.parameters.length != signature.parameters.length { return false; }
    for(var i: usize = 0; i < signature.parameters.length; i++) {
        if !im_call_type_equal(&im_node(definition.parameters.data[i]).type, &im_node(signature.parameters.data[i]).type) { return false; }
    }
    return true;
}

// Ordinary assignment/calls require exact source signatures. Explicit bits
// reinterpretation and reconstructed LLVM pointers may erase signedness, while
// the target ABI still passes identical bits. Never conflate float/int registers.
fn im_call_type_equal(a: FoundationType*, b: FoundationType*): bool {
    if semantic_type_equal(a, b) { return true; }
    var pointer_a = a.pointers != 0 || a.scalar == SFunction;
    var pointer_b = b.pointers != 0 || b.scalar == SFunction;
    if pointer_a || pointer_b { return pointer_a && pointer_b && a.pointer_bytes == b.pointer_bytes; }
    if a.scalar == SVoid || b.scalar == SVoid || semantic_float(a) || semantic_float(b) { return false; }
    return semantic_width(a) == semantic_width(b);
}

fn im_node(node: void*): FoundationNode* {
    return sem_get(node);
}

// Direct-mapped memoization of component lookup, scoped to an immutable checked
// program. Collisions are checked with the full entity key, never trusted hashes.
fn im_cached_node(m: IMState*, node: void*): FoundationNode* {
    var key = convert(u64, bits(usize, node));
    var hash = key / 16;
    var high = key / 4096;
    hash = hash ^ high;
    hash = hash & 255;
    var index = convert(usize, hash);
    if m.node_cache.length == 0 {
        im_storage_require(vector_reserve(&m.node_cache, 256));
        var bytes = sizeof(IMEntry) *256;
        fill(m.node_cache.data, 0, bytes);
        m.node_cache.length = 256;
    }
    var entry = &m.node_cache.data[index];
    if entry.key == key {
        return bits(FoundationNode*, convert(usize, entry.value));
    }
    var value = sem_get(node);
    entry.key = key;
    entry.value = convert(u64, bits(usize, value));
    return value;
}

fn im_binding(node: void*): void* {
    var value = sem_get(node);
    if value.binding != null {
        return value.binding;
    }
    return node;
}

fn im_type_size(type: FoundationType*): usize {
    return semantic_size(type);
}

fn im_type_alignment(type: FoundationType*): usize {
    return semantic_alignment(type);
}

fn im_type_mask(type: FoundationType*): u64 {
    return semantic_mask(type);
}

fn im_type_signed(type: FoundationType*): bool {
    return semantic_signed(type);
}

extern fn im_pointer_bytes(host: IMState*): usize;

extern fn im_root(host: IMState*): void*;

extern fn im_has_foreign(host: IMState*): bool;

extern fn im_fail(host: IMState*, text: u8*, offset: usize): void;

extern fn im_missing_foreign(host: IMState*, node: void*, offset: usize): void;

extern fn im_append(host: IMState*, text: u8*, count: usize): void;

extern fn im_foreign(host: IMState*, node: void*, args: u64*, count: usize): u64;

fn im_pointee_size(type: FoundationType*): usize {
    var element: FoundationType = {
        scalar: type.scalar, pointers: type.pointers - 1, record: type.record, pointer_bytes: type.pointer_bytes
    };
    return semantic_size(&element);
}

struct IMNeighbors {
    next: u64;
    next_count: u64;
    previous: u64;
    previous_count: u64;
}
