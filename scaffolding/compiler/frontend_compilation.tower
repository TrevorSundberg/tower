import tower;
import semantic_program_types;
import semantic_context;
import grammar_observer;
import grammar_types;
import semantic_lifecycle;
import semantic_modules;
import semantic_support;
import .library.vector;
import .library.work_budget_types;

// Source/module orchestration over the same semantic program and parse entities.
// Composed with the semantic declarations; no copied Foundation operation model.
extern fn frontend_module_session(module: void*): void*;

extern fn syntax_next(session: void*): void*;

extern fn syntax_get_error(session: void*): u8*;

extern fn syntax_get_revision(session: void*): usize;

extern fn syntax_get_error_offset(session: void*): usize;
extern fn syntax_session_resource_error(session: void*): WorkBudgetError;
extern fn frontend_module_resource_error(module: void*): WorkBudgetError;

extern fn bytes_append(target: vector(u8)*, data: u8*, count: usize): bool;

export fn frontend_source_length(source: u8*): usize {
    var length: usize = 0;
    loop {
        if source[length] == 0 {
            return length;
        }
        length++;
    }
}

// The caller supplies a readable span. Returning length means every byte is
// source text; the terminator, if present, belongs outside that span.
export fn frontend_source_nul(source: u8*, length: usize): usize {
    for(var i: usize = 0; i < length; i++) { if source[i] == 0 { return i; } }
    return length;
}

fn frontend_compile_error(program: SemanticProgram*, message: u8*): void {
    var length = frontend_source_length(message);
    sem_require(bytes_append(&program.error, message, length));
}

extern fn frontend_module_root_world_size_result(world: void*, source: u8*, length: usize,
    environment: void*, error: WorkBudgetError*): void*;
extern fn compiler_node_world(node: void*): void*;

extern fn frontend_module_finish(module: void*): void;

extern fn frontend_module_count(module: void*): usize;

extern fn frontend_module_at(module: void*, index: usize): void*;

extern fn frontend_module_source(module: void*): u8*;

extern fn frontend_module_comments(module: void*, count: usize*): usize*;

extern fn frontend_module_size(module: void*): usize;

extern fn frontend_module_roots(module: void*): usize;

extern fn frontend_module_tree(module: void*, index: usize): void*;

extern fn frontend_module_destroy(module: void*): void;

extern fn frontend_module_position(module: void*, base: usize): void;

extern fn frontend_module_diagnostic(module: void*, offset: usize): void;

extern fn frontend_module_error(module: void*): u8*;

extern fn syntax_capture_comments(session: void*, module: void*): void;

extern fn frontend_module_attach_comments(module: void*, root: void*, base: usize): void;

export fn frontend_compile_sources(program: SemanticProgram*, sources: FrontendSource*, count: usize, environment: void*): void {
    if program.resource.error != WorkBudgetError.None { return; }
    if count != 0 && sources == null {
        frontend_compile_error(program, "Compilation source array is missing");
        return;
    }
    var world = compiler_node_world(program.root);
    if world != null { grammar_observe(world, GrammarPhase.FrontendParse, true, count, 0); }
    var source: vector(u8);
    var roots: vector(void*);
    var bases: vector(usize);
    var modules: vector(void*);
    var published: vector(void*) = default;
    var published_bases: vector(usize) = default;
    defer vector_dispose(&published);
    defer vector_dispose(&published_bases);
    vector_init(&source);
    vector_init(&roots);
    vector_init(&bases);
    vector_init(&modules);
    var index: usize = 0;
    loop {
        var done = index == count;
        if done || !sem_module_ok(program) {
            break;
        }
        var input = &sources[index];
        if input.data == null || input.length == ~convert(usize, 0) {
            frontend_compile_error(program, "Compilation source span is invalid");
            break;
        }
        var nul = frontend_source_nul(input.data, input.length);
        if nul != input.length {
            frontend_compile_error(program, "Compilation source contains an embedded NUL byte");
            program.error_offset = nul;
            break;
        }
        var startup_error = WorkBudgetError.None;
        var module = frontend_module_root_world_size_result(compiler_node_world(program.root), input.data, input.length,
            environment, &startup_error);
        if module is null {
            sem_resource_record(program, startup_error, 0);
            break;
        }
        if !vector_push(&modules, module) {
            frontend_module_destroy(module);
            sem_resource_record(program, WorkBudgetError.Memory, 0);
            break;
        }
        var session = frontend_module_session(module);
        if session == null {
            sem_resource_record(program, frontend_module_resource_error(module), 0);
            break;
        }
        loop {
            var root = syntax_next(session);
            if root == null {
                break;
            }
            entity_release(root);
        }
        var resource_error = syntax_session_resource_error(session);
        if resource_error == WorkBudgetError.None { resource_error = frontend_module_resource_error(module); }
        if resource_error != WorkBudgetError.None {
            var offset = syntax_get_error_offset(session);
            sem_resource_record(program, resource_error, offset);
            frontend_module_diagnostic(module, offset);
            break;
        }
        var error = syntax_get_error(session);
        var failed = error[0] != 0;
        if failed {
            frontend_compile_error(program, error);
            program.error_offset = syntax_get_error_offset(session);
            frontend_module_diagnostic(module, program.error_offset);
        }
        if failed {
            break;
        }
        syntax_capture_comments(session, module);
        frontend_module_finish(module);
        resource_error = frontend_module_resource_error(module);
        if resource_error != WorkBudgetError.None {
            sem_resource_record(program, resource_error, syntax_get_error_offset(session));
            break;
        }
        error = frontend_module_error(module);
        failed = error[0] != 0;
        if failed {
            frontend_compile_error(program, error);
            break;
        }
        var dependency: usize = 0;
        var dependencies = frontend_module_count(module);
        loop {
            done = dependency == dependencies;
            if done {
                break;
            }
            var current = frontend_module_at(module, dependency);
            // Source fragments share imported lexical modules. Their own roots
            // still contribute in order, even when they use the same entry name.
            var duplicate = false;
            if current != module {
                foreach(var previous in &published) {
                    if sem_equal(frontend_module_name(previous), frontend_module_name(current)) { duplicate = true; break; }
                }
            }
            if duplicate { dependency++; continue; }
            var base = source.length;
            if !sem_module_record(program, current, base) || !sem_module_position(program, current, base) { break; }
            sem_require(vector_push(&published, current));
            sem_require(vector_push(&published_bases, base));
            frontend_module_position(current, base);
            var data = frontend_module_source(current);
            var length = frontend_module_size(current);
            sem_require(bytes_append(&source, data, length));
            sem_require(vector_push(&source, 10));
            var n: usize = 0;
            var trees = frontend_module_roots(current);
            loop {
                done = n == trees;
                if done {
                    break;
                }
                var root = frontend_module_tree(current, n);
                var node = sem_child(root, 0);
                var statement = sem_is(node, "Statement");
                if statement {
                    statement = sem_child_count(node) == 1;
                    if statement {
                        node = sem_child(node, 0);
                    }
                }
                var attached = entity_attach_result(root, program.root, "");
                if attached != WorkBudgetError.None {
                    sem_module_error(program, attached, sem_module_offset(root, base));
                    break;
                }
                var target = sem_get(program.root);
                sem_require(vector_push(&target.items, node));
                sem_require(vector_push(&roots, root));
                sem_require(vector_push(&bases, base));
                n++;
            }
            if !sem_module_ok(program) { break; }
            dependency++;
        }
        index++;
    }
    if world != null { grammar_observe(world, GrammarPhase.FrontendParse, false, count, 0); }
    if program.resource.error == WorkBudgetError.None && program.error.length == 0 {
        sem_require(vector_push(&source, 0));
        semantic_compile(program, roots.data, bases.data, roots.length, source.data);
    }
    if program.resource.error == WorkBudgetError.None && program.error.length == 0 {
        for(var i: usize = 0; i < published.length; ++i) {
            var current = published.data[i];
            // Grammar-only files retain trivia on their grammar/source nodes.
            if frontend_module_roots(current) != 0 {
                frontend_module_attach_comments(current, program.root, published_bases.data[i]);
            }
        }
    }
    index = 0;
    for(; index != modules.length; index++) {
        frontend_module_destroy(modules.data[index]);
    }
    vector_dispose(&modules);
    vector_dispose(&source);
    vector_dispose(&roots);
    vector_dispose(&bases);
}
