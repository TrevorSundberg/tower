var DeclarationQuery: u32 = convert(u32, SemanticQuery.Declaration);
var DeclarationDiscoveryQuery: u32 = convert(u32, SemanticQuery.DeclarationDiscovery);
var ExpressionQuery: u32 = convert(u32, SemanticQuery.Expression);
var ArrayTypeQuery: u32 = convert(u32, SemanticQuery.ArrayType);

enum SemanticExpressionMode: u32 { Value, Operand, Initializer, Discard }

struct SemanticDeclaration {
    number: usize;
    query: usize;
    discovery: usize;
    kernel: CompilerKernel;
    ticket: WorkTicket;
    context: SemanticContext*;
    editor: SemanticEditor;
    type_observations: vector(SemanticTypeObservation);
    allocations: vector(void*);
    lists: vector(void*);
    scope: SemanticScope*;
    current: void*;
    lexical: SemanticBodyScope;
    constructed: vector(void*);
    subject: void*;
    expression: bool;
    module_initializer: bool;
    array_type: bool;
    array_ready: bool;
    array_element: FoundationType;
    array_length: usize;
    array_result: FoundationType;
    construction_owner: SemanticDeclaration*;
    expression_mode: SemanticExpressionMode;
    expected_type: FoundationType*;
    value: void*;
    discover: bool;
    worker_check: bool;
    checked: bool;
    storage_ready: bool;
    stage: void*;
    nodes: vector(void*);
    count: usize;
    surface: bool;
    calls_scanned: bool;
    call_index: usize;
    type_frontier: usize;
    calls: vector(DeclarationCall);
    evaluations: vector(void*);
    inference_pending: bool;
    inference_ready: bool;
    inference_definition: void*;
    inference_values: vector(void*)*;
    inference_types: vector(FoundationType);
    inference_order: vector(FoundationType);
    waiting: usize;
    layout: void*;
    dependencies: vector(usize);
    query_reads: vector(usize);
    error: vector(u8);
    error_offset: usize;
}

struct DeclarationScan {
    node: void*;
    type: bool;
}

struct DeclarationCall {
    node: void*;
    type: bool;
    unevaluated: bool;
    evaluation_depth: usize;
}

struct DeclarationCallScan {
    node: void*;
    type: bool;
    unevaluated: bool;
    complete: bool;
    evaluation_depth: usize;
}

fn sem_declaration_state(c: SemanticContext*, node: void*): SemanticDeclaration* {
    if c.declaration_state == null {
        c.declaration_state = sem_create(c.program.root);
        sem_require(entity_register(c.declaration_state, sizeof(SemanticDeclaration), alignof(SemanticDeclaration), 0));
    }
    var component = entity_component_get(node, c.declaration_state);
    if component != null { return bits(SemanticDeclaration*, entity_component_data(component)); }
    component = entity_component_add(node, c.declaration_state);
    var state = bits(SemanticDeclaration*, entity_component_data(component));
    sem_require(state != null);
    fill(state, 0, sizeof(SemanticDeclaration));
    return state;
}

// Worker lookup is read-only. A generated type with no declaration query was
// already constructed by its coordinator-owned producer; never attach metadata
// to it from a pinned worker scan.
fn sem_declaration_query(c: SemanticContext*, node: void*): usize {
    if node == null || c.declaration_state == null { return 0; }
    var data = entity_component_data(entity_component_get(node, c.declaration_state));
    if data == null { return 0; }
    return bits(SemanticDeclaration*, data).query;
}

fn sem_array_type_prepared(c: SemanticContext*, node: void*): FoundationType* {
    node = sem_surface_unwrap(node);
    while (sem_is(node, "CoreTypeArgument") || sem_is(node, "CoreCallArgument") || sem_is(node, "CoreOperand"))
        && sem_child_count(node) == 1 { node = sem_surface_unwrap(sem_child(node, 0)); }
    if c.declaration_state == null { return null; }
    var result = bits(SemanticDeclaration*, entity_component_data(entity_component_get(node, c.declaration_state)));
    if result == null || !result.array_ready { return null; }
    sem_query_input(c, node, ArrayTypeQuery);
    return &result.array_result;
}

fn sem_array_type_add(c: SemanticContext*, node: void*, parent: SemanticDeclaration*): SemanticDeclaration* {
    var result = sem_declaration_state(c, node);
    if result.query != 0 { sem_require(result.array_type); return result; }
    result.array_type = true;
    result.construction_owner = parent.construction_owner ?? parent;
    sem_require(result.construction_owner != null);
    result.scope = parent.scope;
    result.current = parent.current;
    result.lexical = parent.lexical;
    sem_declaration_add(c, node);
    return result;
}

fn sem_array_type_check(c: SemanticContext*, result: SemanticDeclaration*): void {
    result.array_element = *sem_type(c, sem_member(result.subject, "base"));
    if sem_ok(c) { result.array_length = sem_array_length(c, result.subject, &result.array_element); }
}

fn sem_declaration_scan_push(scan: vector(DeclarationScan)*, node: void*, type: bool): void {
    if node == null { return; }
    sem_require(vector_reserve(DeclarationScan, scan, scan.length + 1));
    scan.data[scan.length].node = node;
    scan.data[scan.length].type = type;
    scan.length++;
}

fn sem_declaration_roots(c: SemanticContext*, result: SemanticDeclaration*, scan: vector(DeclarationScan)*): void {
    var subject = result.subject;
    if result.array_type {
        sem_declaration_scan_push(scan, sem_member(subject, "base"), true);
        sem_declaration_scan_push(scan, sem_array_count(subject), false);
        return;
    }
    if result.expression {
        sem_declaration_scan_push(scan, subject, false);
        return;
    }
    if sem_is(subject, "CoreStruct") {
        var fields = sem_collect(c, sem_member(subject, "fields"), "CoreField");
        var index: usize = 0;
        while index < fields.length {
            sem_declaration_scan_push(scan, sem_member(fields.data[index], "type"), true);
            index++;
        }
    }
    var annotation = sem_member(subject, "type");
    if annotation != null { sem_declaration_scan_push(scan, annotation, true); }
    else { sem_declaration_scan_push(scan, sem_member(subject, "value"), false); }
}

// A member lookup needs the selected record's fields, but a mere reference or
// pointer to that record needs only its nominal identity. Discover these edges
// after the value's declaration type is ready, without mutating expression nodes.
fn sem_declaration_layout_waiting(c: SemanticContext*, record: void*): usize {
    return sem_declaration_layout_waiting_except(c, record, 0);
}

fn sem_declaration_layout_waiting_except(c: SemanticContext*, record: void*, producer: usize): usize {
    var pending = sem_list(c);
    sem_push(pending, record);
    for(var i: usize = 0; i < pending.length; i++) {
        var node = pending.data[i];
        var query = sem_declaration_query(c, node);
        if query != 0 && query != producer && work_task(&c.queries, query).state != WorkState.Succeeded { return query; }
        var value = sem_get(node);
        if value.type.scalar == SArray {
            if semantic_aggregate(&value.element) && !sem_has(pending, value.element.record) {
                sem_push(pending, value.element.record);
            }
        } else {
            foreach(var item in &value.items) {
                var field = sem_get(item);
                if semantic_aggregate(&field.type) && !sem_has(pending, field.type.record) {
                    sem_push(pending, field.type.record);
                }
            }
        }
    }
    // Repeated by-value records are left to the ordinary LayoutQuery cycle
    // diagnostic, once every participating declaration has published its fields.
    return 0;
}

fn sem_declaration_location(c: SemanticContext*, node: void*, waiting: usize*, layout: void**, depth: usize): FoundationType* {
    if node == null || depth > 128 { return null; }
    node = sem_surface_unwrap(node);
    var operand: void* = null;
    var address = false;
    if sem_is(node, "CoreLoad") || sem_is(node, "CoreAddress") {
        operand = sem_member(node, "name");
        address = sem_is(node, "CoreAddress");
    }
    if sem_is(node, "TowerExpression") && sem_member(node, "left") == null {
        var operation = sem_surface_operator(c, node, null);
        if sem_equal(operation, "*") || sem_equal(operation, "&") {
            operand = sem_member(node, "right");
            address = sem_equal(operation, "&");
        }
    }
    if operand != null {
        var parent = sem_declaration_location(c, operand, waiting, layout, depth + 1);
        if parent == null || !address && parent.pointers == 0 { return null; }
        var type = sem_type_copy(c, parent);
        if address { type.pointers++; } else { type.pointers--; }
        return type;
    }
    if sem_is(node, "CoreCall") || sem_is(node, "TowerInvoke") {
        var name = sem_member(node, "name");
        if name == null { name = sem_member(node, "callee"); }
        var target: FoundationType* = null;
        if sem_is(node, "TowerInvoke") || sem_call_uses_value(c, name) {
            target = sem_declaration_location(c, name, waiting, layout, depth + 1);
        }
        if target != null {
            if target.pointers == 0 && target.scalar == SFunction { return &sem_get(target.record).element; }
            return null;
        }
        if *waiting != 0 || *layout != null { return null; }
        if sem_is(node, "TowerInvoke") { return null; }
        var function = sem_resolve(c, c.functions, name, sem_identifier(c, name));
        var prepared = sem_prepared_call(c, node);
        if prepared != null { function = prepared.instance; }
        if function == null { return null; }
        var query = sem_declaration_query(c, function);
        if query != 0 && work_task(&c.queries, query).state != WorkState.Succeeded {
            *waiting = query;
            return null;
        }
        return &sem_get(function).type;
    }
    if !sem_is(node, "CoreLocation") && !sem_is(node, "TowerNullAccess") { return null; }
    var module = sem_namespace(c, node);
    var base = sem_member(node, "base");
    if module != null || base == null {
        var name = sem_member(node, module != null ? "field" : "name");
        var declaration: void* = null;
        if module != null { declaration = sem_owned(c.globals, module, sem_identifier(c, name)); }
        else {
            declaration = sem_local(c, sem_identifier(c, name));
            if declaration == null { declaration = sem_resolve(c, c.globals, name, sem_identifier(c, name)); }
        }
        if declaration == null { return null; }
        var query = sem_declaration_query(c, declaration);
        if query != 0 && work_task(&c.queries, query).state != WorkState.Succeeded {
            *waiting = query;
            return null;
        }
        return &sem_get(declaration).type;
    }
    var type = sem_declaration_location(c, base, waiting, layout, depth + 1);
    if type == null { return null; }
    if sem_member(node, "index") != null {
        if type.pointers != 0 {
            var element = sem_type_copy(c, type);
            element.pointers--;
            return element;
        }
        if type.scalar == SArray { return &sem_get(type.record).element; }
        return null;
    }
    if type.scalar != SStruct || type.record == null { return null; }
    // Field offsets consume the entire containing layout, including by-value
    // records beyond the selected field. Never cache their unfinished headers.
    var query = sem_declaration_layout_waiting(c, type.record);
    if query != 0 {
        *waiting = query;
        return null;
    }
    var ready = work_find(&c.queries, type.record, convert(u32, SemanticQuery.Layout), 0);
    if ready == 0 || work_task(&c.queries, ready).state != WorkState.Succeeded {
        *layout = type.record;
        return null;
    }
    var name = sem_identifier(c, sem_member(node, "field"));
    var record = sem_get(type.record);
    var index: usize = 0;
    while index < record.items.length {
        var field = sem_get(record.items.data[index]);
        if sem_equal(name, sem_name(field)) { return &field.type; }
        index++;
    }
    return null;
}

fn sem_declaration_waiting(c: SemanticContext*, result: SemanticDeclaration*, layout: void**): usize {
    var subject = result.subject;
    *layout = null;
    // A contextual aggregate initializer can inspect its destination fields
    // even without a type spelling in the expression itself.
    if result.expression && result.expected_type != null && semantic_aggregate(result.expected_type) {
        var record = result.expected_type.record;
        var waiting = sem_declaration_layout_waiting(c, record);
        if waiting != 0 { return waiting; }
        var query = work_find(&c.queries, record, convert(u32, SemanticQuery.Layout), 0);
        if query == 0 || work_task(&c.queries, query).state != WorkState.Succeeded {
            *layout = record;
            return 0;
        }
    }
    if sem_function_syntax(subject) {
        // Value parameters need frame storage while their header is checked.
        // Record this layout dependency before dispatching a pinned worker.
        foreach(var parameter in &sem_get(subject).parameters) {
            var type = &sem_get(parameter).type;
            if semantic_aggregate(type) {
                var waiting = sem_declaration_layout_waiting(c, type.record);
                if waiting != 0 { return waiting; }
                var query = work_find(&c.queries, type.record, convert(u32, SemanticQuery.Layout), 0);
                if query == 0 || work_task(&c.queries, query).state != WorkState.Succeeded {
                    *layout = type.record;
                    return 0;
                }
            }
        }
    }
    var scan: vector(DeclarationScan);
    vector_init(DeclarationScan, &scan);
    sem_declaration_roots(c, result, &scan);
    var waiting: usize = 0;
    while scan.length != 0 && waiting == 0 && *layout == null {
        scan.length--;
        var node = scan.data[scan.length].node;
        var type = scan.data[scan.length].type;
        if type && sem_array_syntax(node) {
            var query = sem_declaration_query(c, node);
            if query != 0 && query != result.query {
                // The call continuation consumes these receipts in source
                // order. This reverse dependency scan must not choose a later
                // array's failure while an earlier extent is still pending.
                continue;
            }
        }
        if !type && sem_is(node, "TowerExpression")
            && sem_is(sem_surface_unwrap(sem_member(node, "right")), "TowerInitializer")
            && sem_equal(sem_surface_operator(c, node, sem_member(node, "left")), "=") {
            // Inferred declarations may contain a reset expression. Its target
            // supplies the initializer type, so discover the field/layout read
            // before admitting that declaration to a pinned worker.
            var destination = sem_declaration_location(c, sem_member(node, "left"), &waiting, layout, 0);
            if waiting == 0 && *layout == null && destination != null && semantic_aggregate(destination) {
                waiting = sem_declaration_layout_waiting(c, destination.record);
                var query = work_find(&c.queries, destination.record, convert(u32, SemanticQuery.Layout), 0);
                if waiting == 0 && (query == 0 || work_task(&c.queries, query).state != WorkState.Succeeded) { *layout = destination.record; }
            }
        }
        if sem_is(node, "TowerDefault") || sem_is(node, "TowerInitializer") {
            if sem_is(node, "TowerInitializer") {
                var annotation = sem_member(node, "type");
                var nominal = annotation == null ? null : sem_resolve(c, c.types, annotation, sem_identifier(c, annotation));
                if nominal != null {
                    waiting = sem_declaration_layout_waiting(c, nominal);
                    var query = work_find(&c.queries, nominal, convert(u32, SemanticQuery.Layout), 0);
                    if waiting == 0 && (query == 0 || work_task(&c.queries, query).state != WorkState.Succeeded) { *layout = nominal; }
                }
                sem_declaration_scan_push(&scan, sem_member(node, "fields"), false);
            }
            sem_declaration_scan_push(&scan, sem_member(node, "type"), true);
            continue;
        }
        if sem_is(node, "TowerDecltype") {
            sem_declaration_scan_push(&scan, sem_member(node, "value"), false);
            continue;
        }
        if !type && sem_is(node, "TowerInvoke") {
            sem_declaration_location(c, node, &waiting, layout, 0);
        }
        if !type && sem_is(node, "CoreCall") {
            sem_declaration_location(c, node, &waiting, layout, 0);
            var name_node = sem_member(node, "name");
            var name = sem_identifier(c, name_node);
            var builtin = semantic_builtin_kind(name);
            var definition = sem_resolve(c, c.templates, name_node, name);
            if sem_call_uses_value(c, name_node) { sem_declaration_scan_push(&scan, name_node, false); }
            var args = sem_collect(c, sem_member(node, "args"), "CoreCallArgument");
            var argument: usize = 0;
            while argument < args.length {
                var type_argument = semantic_builtin_type_argument(builtin, argument);
                // Omitted generic type arguments leave only value arguments.
                // Match ordinary call admission before classifying their nodes.
                if definition != null && args.length == generic_parameter_count(c.generics, definition) {
                    type_argument = generic_type_parameter(c.generics, definition, argument);
                }
                sem_declaration_scan_push(&scan, args.data[argument], type_argument);
                argument++;
            }
            continue;
        }
        if !type && (sem_is(node, "CoreLocation") || sem_is(node, "TowerNullAccess")) {
            sem_declaration_location(c, node, &waiting, layout, 0);
        }
        var index: usize = 0;
        while index < sem_child_count(node) {
            sem_declaration_scan_push(&scan, sem_child(node, index), type);
            index++;
        }
    }
    vector_dispose(DeclarationScan, &scan);
    return waiting;
}

// Binding discovery reads syntax and module scopes without recursively asking
// for a declaration's type. Typed annotations depend only on their type spelling;
// an initializer's runtime reads do not make explicit types cyclic.
fn sem_declaration_dependencies(c: SemanticContext*, subject: void*, result: SemanticDeclaration*): void {
    var scan: vector(DeclarationScan);
    vector_init(DeclarationScan, &scan);
    sem_declaration_roots(c, result, &scan);
    if sem_function_syntax(subject) {
        var parameters = &sem_get(subject).parameters;
        for(var i: usize = 0; i < parameters.length; ++i) {
            sem_declaration_input(result, sem_declaration_query(c, parameters.data[i]));
        }
    }
    while scan.length != 0 && sem_ok(c) {
        scan.length--;
        var node = scan.data[scan.length].node;
        var type = scan.data[scan.length].type;
        if type && sem_array_syntax(node) {
            var query = sem_declaration_query(c, node);
            if query != 0 && query != result.query {
                sem_declaration_input(result, query);
                continue;
            }
        }
        if sem_is(node, "TowerDefault") || sem_is(node, "TowerInitializer") {
            var annotation = sem_member(node, "type");
            if sem_is(node, "TowerInitializer") {
                var nominal = annotation == null ? null : sem_resolve(c, c.types, annotation, sem_identifier(c, annotation));
                if nominal != null {
                    var dependency = sem_declaration_query(c, nominal);
                    if dependency != 0 { sem_declaration_input(result, dependency); }
                }
                sem_declaration_scan_push(&scan, sem_member(node, "fields"), false);
            }
            sem_declaration_scan_push(&scan, annotation, true);
            continue;
        }
        if sem_is(node, "TowerDecltype") {
            sem_declaration_scan_push(&scan, sem_member(node, "value"), false);
            continue;
        }
        if !type && sem_is(node, "CoreCall") {
            var name_node = sem_member(node, "name");
            var name = sem_identifier(c, name_node);
            var builtin = semantic_builtin_kind(name);
            var definition = sem_resolve(c, c.templates, name_node, name);
            if sem_call_uses_value(c, name_node) { sem_declaration_scan_push(&scan, name_node, false); }
            var function = sem_resolve(c, c.functions, name_node, name);
            var prepared = sem_prepared_call(c, node);
            if prepared != null { function = prepared.instance; }
            if function != null {
                var input = sem_declaration_query(c, function);
                if input != 0 { sem_declaration_input(result, input); }
            }
            var args = sem_collect(c, sem_member(node, "args"), "CoreCallArgument");
            if args.length != 0 && (builtin == KSizeOf || builtin == KAlignOf) {
                var argument = sem_surface_unwrap(args.data[0]);
                var nominal = sem_resolve(c, c.types, argument, sem_identifier(c, argument));
                if nominal != null {
                    var input = sem_declaration_query(c, nominal);
                    if input != 0 { sem_declaration_input(result, input); }
                }
            }
            var index: usize = 0;
            while index < args.length {
                var type_argument = semantic_builtin_type_argument(builtin, index);
                if definition != null && args.length == generic_parameter_count(c.generics, definition) {
                    type_argument = generic_type_parameter(c.generics, definition, index);
                }
                sem_declaration_scan_push(&scan, args.data[index], type_argument);
                index++;
            }
            continue;
        }
        if !type && sem_is(node, "CoreLocation") {
            var base = sem_member(node, "base");
            var module = sem_namespace(c, node);
            var dependency: void* = null;
            if module != null {
                dependency = sem_owned(c.globals, module, sem_identifier(c, sem_member(node, "field")));
            } else {
                if base == null {
                    var name = sem_member(node, "name");
                    if name != null {
                        dependency = sem_local(c, sem_identifier(c, name));
                        if dependency == null { dependency = sem_resolve(c, c.globals, name, sem_identifier(c, name)); }
                    }
                } else {
                    var nominal = sem_owned(c.types, sem_owner(c, base), sem_identifier(c, base));
                    if nominal != null && semantic_enum(&sem_get(nominal).type) {
                        var input = sem_declaration_query(c, nominal);
                        if input != 0 { sem_declaration_input(result, input); }
                        continue;
                    }
                }
            }
            if dependency != null {
                var input = sem_declaration_query(c, dependency);
                if input != 0 { sem_declaration_input(result, input); }
                else {
                    // Earlier lexical locals may have completed in their body
                    // query. Their immutable types do not need invented jobs.
                    sem_require(sem_declaration_state(c, dependency).number == 2);
                }
            }
            if dependency == null {
                var function = sem_resolve(c, c.functions, node, sem_identifier(c, node));
                if function != null {
                    var input = sem_declaration_query(c, function);
                    if input != 0 { sem_declaration_input(result, input); }
                }
            }
            if module != null { continue; }
        }
        var child: usize = 0;
        while child < sem_child_count(node) {
            sem_declaration_scan_push(&scan, sem_child(node, child), type);
            child++;
        }
    }
    vector_dispose(DeclarationScan, &scan);
}

fn sem_declaration_input(result: SemanticDeclaration*, input: usize): bool {
    var index: usize = 0;
    while index < result.dependencies.length {
        if result.dependencies.data[index] == input { return false; }
        index++;
    }
    sem_require(vector_push(usize, &result.dependencies, input));
    return true;
}

// These places consume existing declarations and layouts. They never intern
// types or prepare calls; readiness requests their receipts before checking.
fn sem_declaration_place(c: SemanticContext*, node: void*, depth: usize): bool {
    if node == null || depth > 128 { return false; }
    node = sem_surface_unwrap(node);
    if sem_is(node, "CoreLocation") {
        if sem_member(node, "index") != null { return false; }
        var base = sem_member(node, "base");
        return base == null || sem_namespace(c, node) != null || sem_declaration_place(c, base, depth + 1);
    }
    if sem_is(node, "CoreLoad") || sem_is(node, "CoreAddress") {
        return sem_declaration_place(c, sem_member(node, "name"), depth + 1);
    }
    if sem_is(node, "TowerExpression") && sem_member(node, "left") == null {
        var operation = sem_surface_operator(c, node, null);
        if sem_equal(operation, "*") || sem_equal(operation, "&") {
            return sem_declaration_place(c, sem_member(node, "right"), depth + 1);
        }
    }
    return false;
}

// Literal and place queries attach ordinary canonical components under leases.
fn sem_declaration_leaf(c: SemanticContext*, node: void*): bool {
    node = sem_surface_unwrap(node);
    if sem_is(node, "TowerDefault") { return true; }
    if sem_declaration_place(c, node, 0) { return true; }
    var parsed = sem_match(node);
    var literal_shape = sem_is(node, "Number") || sem_is(node, "String")
        || sem_is(node, "CoreOperand") || sem_is(node, "TowerExpression");
    literal_shape ||= parsed != null && parsed.rule == sem_maximum();
    return literal_shape && sem_literal(c, node);
}

// Ordinary and prepared generic calls consume published signatures. Preparation
// publishes the instance and records its dependency before worker readmission.
fn sem_declaration_function(c: SemanticContext*, node: void*): bool {
    if sem_is(node, "TowerInvoke") { return true; }
    var name_node = sem_member(node, "name");
    if name_node == null { return false; }
    var name = sem_identifier(c, name_node);
    if sem_call_uses_value(c, name_node) { return true; }
    if semantic_builtin_kind(name) != 0
        || sem_resolve(c, c.type_functions, name_node, name) != null { return false; }
    if sem_resolve(c, c.templates, name_node, name) != null {
        return sem_prepared_call(c, node) != null;
    }
    return sem_resolve(c, c.functions, name_node, name) != null;
}

// Readiness can project these place/call types without checking expressions.
// A computed base whose type is not yet known needs a structural continuation
// before field access can safely consume its record layout on a worker.
fn sem_declaration_projectable(c: SemanticContext*, node: void*, depth: usize): bool {
    if node == null || depth > 128 { return false; }
    node = sem_surface_unwrap(node);
    if sem_is(node, "CoreLocation") || sem_is(node, "TowerNullAccess") {
        var base = sem_member(node, "base");
        return base == null || sem_namespace(c, node) != null || sem_declaration_projectable(c, base, depth + 1);
    }
    if sem_is(node, "CoreCall") || sem_is(node, "TowerInvoke") { return sem_declaration_function(c, node); }
    if sem_is(node, "CoreLoad") || sem_is(node, "CoreAddress") {
        return sem_declaration_projectable(c, sem_member(node, "name"), depth + 1);
    }
    if sem_is(node, "TowerExpression") && sem_member(node, "left") == null {
        var operation = sem_surface_operator(c, node, null);
        if sem_equal(operation, "*") || sem_equal(operation, "&") {
            return sem_declaration_projectable(c, sem_member(node, "right"), depth + 1);
        }
    }
    return false;
}

// Expressions enrich leased syntax and private children. Type arguments are
// checked separately by role: value indexing does not construct an array type.
fn sem_declaration_expression(c: SemanticContext*, root: void*): bool {
    var pending = sem_list(c);
    sem_push(pending, root);
    for(var i: usize = 0; i < pending.length; i++) {
        var node = sem_surface_unwrap(pending.data[i]);
        if sem_declaration_leaf(c, node) { continue; }
        if sem_is(node, "TowerInitializer") {
            var fields = sem_collect(c, sem_member(node, "fields"), "TowerInitializerField");
            foreach(var field in fields) { sem_push(pending, sem_member(field, "value")); }
            continue;
        }
        if sem_is(node, "TowerComptime") {
            sem_push(pending, sem_member(node, "value"));
            continue;
        }
        if sem_is(node, "TowerInvoke") {
            sem_push(pending, sem_member(node, "callee"));
            var arguments = sem_collect(c, sem_member(node, "args"), "CoreCallArgument");
            foreach(var argument in arguments) { sem_push(pending, argument); }
            continue;
        }
        if sem_is(node, "CoreCall") {
            var name = sem_member(node, "name");
            var builtin = semantic_builtin_kind(sem_identifier(c, name));
            if builtin == 0 && !sem_declaration_function(c, node) { return false; }
            if sem_call_uses_value(c, name) { sem_push(pending, name); }
            var prepared = sem_prepared_call(c, node);
            var args = prepared != null ? prepared.values
                : sem_collect(c, sem_member(node, "args"), "CoreCallArgument");
            for(var argument: usize = 0; argument < args.length; argument++) {
                if !semantic_builtin_type_argument(builtin, argument) { sem_push(pending, args.data[argument]); }
            }
            continue;
        }
        if sem_is(node, "CoreLocation") || sem_is(node, "TowerNullAccess") {
            var base = sem_member(node, "base");
            if base == null { return false; }
            if sem_member(node, "field") != null && !sem_declaration_projectable(c, base, 0) { return false; }
            sem_push(pending, base);
            var index = sem_member(node, "index");
            if index != null { sem_push(pending, index); }
            continue;
        }
        if sem_is(node, "CoreLoad") || sem_is(node, "CoreAddress") {
            sem_push(pending, sem_member(node, "name"));
            continue;
        }
        if !sem_is(node, "TowerExpression") && !sem_is(node, "TowerComma")
            && !sem_is(node, "CoreBinary") { return false; }
        var condition = sem_member(node, "condition");
        if condition != null {
            sem_push(pending, condition);
            sem_push(pending, sem_member(node, "body"));
            sem_push(pending, sem_member(node, "otherwise"));
            continue;
        }
        var left = sem_member(node, "left");
        var right = sem_member(node, "right");
        if left == null && right == null { return false; }
        if left != null { sem_push(pending, left); }
        if right != null { sem_push(pending, right); }
    }
    return true;
}

// Keep type/value roles through ordinary builtin arguments, defaults and
// decltype. Only value indexing is read-only; array/type construction still
// requires structural preparation. Admission leases the original syntax nodes.
fn sem_declaration_syntax(c: SemanticContext*, annotation: void*, nodes: vector(void*)*, staged: bool, type: bool): bool {
    var evaluates = false;
    var pending: vector(DeclarationScan) = default;
    defer vector_dispose(&pending);
    sem_declaration_scan_push(&pending, annotation, type);
    for(var i: usize = 0; i < pending.length; i++) {
        var node = pending.data[i].node;
        var type = pending.data[i].type;
        if type && sem_array_type_prepared(c, node) != null { continue; }
        evaluates ||= sem_is(node, "TowerComptime");
        if !type && sem_is(node, "CoreArrayCount") {
            for(var j: usize = 0; j < sem_child_count(node); j++) {
                sem_declaration_scan_push(&pending, sem_child(node, j), false);
            }
            continue;
        }
        if sem_is(node, "TowerDefault") || sem_is(node, "TowerInitializer") {
            if sem_is(node, "TowerInitializer") {
                staged = true;
                sem_declaration_scan_push(&pending, sem_member(node, "fields"), false);
            }
            sem_declaration_scan_push(&pending, sem_member(node, "type"), true);
            continue;
        }
        if sem_is(node, "TowerDecltype") {
            var value = sem_member(node, "value");
            if !sem_declaration_expression(c, value) { return false; }
            sem_declaration_scan_push(&pending, value, false);
            staged = true;
            continue;
        }
        if type && (sem_is(node, "CoreType") || sem_is(node, "CoreCall")) && sem_member(node, "args") != null {
            var name_node = sem_member(node, "name");
            var name = sem_identifier(c, name_node);
            if sem_equal(name, "function") && sem_resolve(c, c.type_functions, name_node, name) == null {
                // Function signatures already use private staged entities and
                // publish type observations after join. Recurse by type role;
                // a user constructor with this name still needs preparation.
                staged = true;
                var arguments = sem_collect(c, sem_member(node, "args"),
                    sem_is(node, "CoreCall") ? "CoreCallArgument" : "CoreTypeArgument");
                foreach(var argument in arguments) { sem_declaration_scan_push(&pending, argument, true); }
                continue;
            }
        }
        if !type && sem_is(node, "TowerInvoke") {
            staged = true;
            sem_declaration_scan_push(&pending, sem_member(node, "callee"), false);
            var arguments = sem_collect(c, sem_member(node, "args"), "CoreCallArgument");
            foreach(var argument in arguments) { sem_declaration_scan_push(&pending, argument, false); }
            continue;
        }
        if !type && sem_is(node, "CoreCall") {
            var name = sem_member(node, "name");
            var builtin = semantic_builtin_kind(sem_identifier(c, name));
            if builtin == 0 && !sem_declaration_function(c, node) { return false; }
            staged = true;
            // Indirect calls check and enrich the callee before arguments.
            // Its original location tree needs the same stage lease as args.
            if sem_call_uses_value(c, name) { sem_declaration_scan_push(&pending, name, false); }
            var prepared = sem_prepared_call(c, node);
            var args = prepared != null ? prepared.values
                : sem_collect(c, sem_member(node, "args"), "CoreCallArgument");
            for(var argument: usize = 0; argument < args.length; argument++) {
                sem_declaration_scan_push(&pending, args.data[argument], semantic_builtin_type_argument(builtin, argument));
            }
            continue;
        }
        if sem_is(node, "CoreArrayCount") || sem_member(node, "args") != null
            || sem_member(node, "count") != null { return false; }
        if type && sem_member(node, "index") != null { return false; }
        for(var j: usize = 0; j < sem_child_count(node); j++) {
            sem_declaration_scan_push(&pending, sem_child(node, j), type);
        }
    }
    if evaluates { sem_evaluation_begin(c); }
    if staged { foreach(var &entry in &pending) { sem_push(nodes, entry.node); } }
    return true;
}

fn sem_declaration_worker(c: SemanticContext*, result: SemanticDeclaration*): bool {
    var subject = result.subject;
    var record = sem_is(subject, "CoreStruct");
    if !result.array_type && !result.expression && !record && !sem_is(subject, "CoreDeclare") && !sem_is(subject, "CoreParameter") && !sem_function_syntax(subject) { return false; }
    var previous_scope = c.scope;
    c.scope = result.scope;
    defer { c.scope = previous_scope; }
    if result.array_type {
        return sem_declaration_syntax(c, sem_member(subject, "base"), &result.nodes, true, true)
            && sem_declaration_syntax(c, sem_array_count(subject), &result.nodes, true, false);
    }
    if result.expression {
        return sem_declaration_expression(c, subject)
            && sem_declaration_syntax(c, subject, &result.nodes, true, false);
    }
    var annotation = sem_member(subject, record ? "fields" : "type");
    var type = annotation != null;
    var staged = record || !type;
    if annotation == null {
        annotation = sem_member(subject, "value");
        if annotation == null || !sem_declaration_expression(c, annotation) { return false; }
    }
    if !sem_declaration_syntax(c, annotation, &result.nodes, staged, type) { return false; }
    // A worker may update its existing field state, never grow the shared index.
    if record { sem_state(c, c.fields_done, subject); }
    return true;
}

// The current declaration receipt yields before this bounded operand query.
// Nested generic calls have already prepared their signatures in operand order.
fn sem_declaration_inference_begin(c: SemanticContext*, result: SemanticDeclaration*, call: void*): bool {
    if sem_prepared_call(c, call) != null { return false; }
    var name = sem_member(call, "name");
    var definition = sem_resolve(c, c.templates, name, sem_identifier(c, name));
    var count = generic_parameter_count(c.generics, definition);
    var args = sem_collect(c, sem_member(call, "args"), "CoreCallArgument");
    if args.length == count { return false; }
    var runtime: usize = 0;
    for(var i: usize = 0; i < count; i++) {
        if !generic_type_parameter(c.generics, definition, i) { runtime++; }
    }
    if args.length != runtime { return false; }
    sem_require(result.nodes.length == 0);
    foreach(var argument in args) {
        if !sem_declaration_expression(c, argument)
            || !sem_declaration_syntax(c, argument, &result.nodes, true, false) {
            result.nodes.length = 0;
            return false;
        }
    }
    result.inference_pending = true;
    result.inference_definition = definition;
    result.inference_values = args;
    return true;
}

fn sem_declaration_infer(c: SemanticContext*, result: SemanticDeclaration*): void {
    var call = &result.calls.data[result.call_index];
    c.unevaluated = call.unevaluated;
    c.evaluation_depth = call.evaluation_depth;
    var order = sem_list(c);
    var types = sem_infer_types(c, result.inference_definition, call.node, result.inference_values, false, order);
    if sem_ok(c) {
        sem_require(vector_reserve(&result.inference_types, types.length));
        foreach(var type in types) {
            copy(&result.inference_types.data[result.inference_types.length], type, sizeof(FoundationType));
            result.inference_types.length++;
        }
        sem_require(vector_reserve(&result.inference_order, order.length));
        foreach(var type in order) {
            copy(&result.inference_order.data[result.inference_order.length], type, sizeof(FoundationType));
            result.inference_order.length++;
        }
        result.inference_ready = true;
    }
    result.inference_pending = false;
}

fn sem_expression_check(c: SemanticContext*, result: SemanticDeclaration*): void {
    match result.expression_mode {
        SemanticExpressionMode.Operand => { result.value = sem_operand(c, result.subject, result.expected_type); }
        SemanticExpressionMode.Initializer => { result.value = sem_initial_value(c, result.subject, result.expected_type); }
        SemanticExpressionMode.Discard => { result.value = sem_surface_discard(c, result.subject); }
        _ => { result.value = sem_expression(c, result.subject, result.expected_type); }
    }
}

// Workers borrow immutable scope/graph indexes and own scratch/diagnostics.
// Ready type queries may write their declared subject payload and leased syntax.
// Headers wait for parameter types before assigning their frame slots. Stages
// publish new components after joins; type/name/query indexes remain immutable.
fn semantic_declaration_kernel(result: SemanticDeclaration*): void {
    var context: SemanticContext;
    var program: SemanticProgram;
    copy(&context, result.context, sizeof(SemanticContext));
    copy(&program, context.program, sizeof(SemanticProgram));
    context.program = &program;
    sem_editor_private(&context, &result.editor);
    context.type_observations = &result.type_observations;
    context.scope = result.scope;
    context.current = result.current;
    if result.current != null { sem_body_restore(&context, &result.lexical); }
    context.entity_stage = result.stage;
    context.query_reads = &result.query_reads;
    context.count = 0;
    context.node_limit -= result.context.count;
    vector_init(void*, &context.allocations);
    vector_init(void*, &context.lists);
    vector_init(&context.inferring);
    vector_init(&context.type_arguments);
    vector_init(&context.evaluation_jobs);
    vector_init(u8, &context.token_text);
    fill(&context.scan, 0, sizeof(stack(void*)));
    vector_init(u8, &program.error);
    if result.discover { sem_declaration_dependencies(&context, result.subject, result); }
    else {
        result.waiting = sem_declaration_waiting(&context, result, &result.layout);
        if !result.checked && result.waiting == 0 && result.layout == null && sem_ok(&context) {
            if result.inference_pending { sem_declaration_infer(&context, result); }
            else {
                if result.worker_check {
                    result.checked = true;
                    if result.array_type { sem_array_type_check(&context, result); }
                    else {
                        if result.expression { sem_expression_check(&context, result); }
                        else {
                            if sem_function_syntax(result.subject) { sem_header(&context, result.subject, "", null); }
                            else {
                                if sem_is(result.subject, "CoreStruct") { sem_type_fields(&context, result.subject); }
                                else { sem_declaration_type(&context, result.subject); }
                            }
                        }
                    }
                }
            }
        }
    }
    result.count = context.count;
    if result.current != null { sem_body_save(&context, &result.lexical); }
    result.surface = context.surface_expressions;
    copy(&result.evaluations, &context.evaluation_jobs, sizeof(vector(void*)));
    copy(&result.error, &program.error, sizeof(vector(u8)));
    result.error_offset = program.error_offset;
    // Body continuations and completion may retain newly created lexical data.
    // Transfer that ownership at publication; ordinary jobs reclaim scratch.
    if result.current != null || context.editor != null && context.editor.found {
        result.allocations = context.allocations;
        result.lists = context.lists;
        context.allocations = default;
        context.lists = default;
    }
    stack_dispose(void*, &context.scan);
    vector_dispose(u8, &context.token_text);
    vector_dispose(&context.inferring);
    vector_dispose(&context.type_arguments);
    var index: usize = 0;
    while index < context.lists.length {
        vector_dispose(void*, bits(vector(void*)*, context.lists.data[index]));
        index++;
    }
    vector_dispose(void*, &context.lists);
    index = 0;
    while index < context.allocations.length {
        free(context.allocations.data[index]);
        index++;
    }
    vector_dispose(void*, &context.allocations);
}

// Copy an owned producer diagnostic without publishing its scratch or changing
// the scheduler. Structural cache consumers use this same failure receipt.
fn sem_declaration_restore_error(c: SemanticContext*, result: SemanticDeclaration*): bool {
    if result == null || result.error.length == 0 { return false; }
    if sem_ok(c) {
        sem_require(vector_reserve(&c.program.error, result.error.length + 1));
        copy(c.program.error.data, result.error.data, result.error.length + 1);
        c.program.error.length = result.error.length;
        c.program.error_offset = result.error_offset;
    }
    return true;
}

fn sem_declaration_error(c: SemanticContext*, result: SemanticDeclaration*): bool {
    sem_type_observations_publish(c, &result.type_observations);
    sem_editor_publish(c, &result.editor);
    foreach(var allocation in &result.allocations) { sem_push(&c.allocations, allocation); }
    foreach(var list in &result.lists) { sem_push(&c.lists, list); }
    vector_dispose(&result.allocations);
    vector_dispose(&result.lists);
    if result.error.length == 0 { return false; }
    if !c.declaration_isolated { sem_declaration_restore_error(c, result); }
    // Retain the producer diagnostic for later dependent body continuations.
    // The compilation owns it until declaration disposal.
    return true;
}

fn sem_declaration_capture_error(c: SemanticContext*, result: SemanticDeclaration*): void {
    if result.error.length != 0 || sem_ok(c) { return; }
    sem_require(vector_reserve(&result.error, c.program.error.length + 1));
    copy(result.error.data, c.program.error.data, c.program.error.length + 1);
    result.error.length = c.program.error.length;
    result.error_offset = c.program.error_offset;
}

// A failed shared signature retains its diagnostic even after its first body
// consumer has yielded it for source-order selection. Follow only failed edges;
// an unfinished cycle is diagnosed separately by the ordinary graph walker.
fn sem_declaration_failure(c: SemanticContext*, id: usize): bool {
    var pending: vector(usize) = default;
    defer vector_dispose(&pending);
    sem_require(vector_push(&pending, id));
    for(var i: usize = 0; i < pending.length; i++) {
        var task = work_task(&c.queries, pending.data[i]);
        if task.state != WorkState.Failed { continue; }
        var result = bits(SemanticDeclaration*, entity_component_data(entity_component_get(task.subject, c.declaration_state)));
        // The component identifies its producer and discovery tickets. New
        // declaration query kinds must retain failures through this same path.
        if result != null && (result.query == pending.data[i] || result.discovery == pending.data[i]) {
            if sem_declaration_restore_error(c, result) { return true; }
        }
        if task.query == convert(u32, SemanticQuery.GenericBody) && sem_generic_body_failure(c, task.subject) { return true; }
        if task.query == convert(u32, SemanticQuery.Layout) {
            var layout = bits(SemanticLayoutWork*, entity_component_data(entity_component_get(task.subject, c.layout_results)));
            if layout != null && layout.error != null {
                sem_fail(c, layout.error_node, layout.error);
                return true;
            }
        }
        var edge = task.dependencies;
        while edge != 0 {
            var dependency = c.queries.edges.data[edge - 1].dependency;
            var seen = false;
            foreach(var prior in &pending) { seen ||= prior == dependency; }
            if !seen { sem_require(vector_push(&pending, dependency)); }
            edge = c.queries.edges.data[edge - 1].next_dependency;
        }
    }
    return false;
}

extern fn entity_query_count(type: void*): usize;
extern fn entity_query_at(type: void*, index: usize): void*;

fn sem_declaration_dispose(c: SemanticContext*): void {
    if c.prepared_calls != null {
        for(var i: usize = 0; i < entity_query_count(c.prepared_calls); i++) {
            var prepared = bits(SemanticPreparedCall*, entity_component_data(entity_query_at(c.prepared_calls, i)));
            prepared.values = null;
            prepared.instance = null;
        }
    }
    if c.declaration_state != null {
        for(var i: usize = 0; i < entity_query_count(c.declaration_state); ++i) {
            var result = bits(SemanticDeclaration*, entity_component_data(entity_query_at(c.declaration_state, i)));
            vector_dispose(usize, &result.dependencies);
            vector_dispose(&result.query_reads);
            vector_dispose(&result.type_observations);
            vector_dispose(&result.allocations);
            vector_dispose(&result.lists);
            result.editor = default;
            vector_dispose(&result.nodes);
            vector_dispose(&result.calls);
            vector_dispose(&result.evaluations);
            vector_dispose(&result.inference_types);
            vector_dispose(&result.inference_order);
            vector_dispose(&result.constructed);
            result.inference_definition = null;
            result.inference_values = null;
            vector_dispose(u8, &result.error);
            // These scratch scopes/context are owned only for this compilation.
            result.context = null;
            result.scope = null;
            result.current = null;
            result.construction_owner = null;
            result.expected_type = null;
            result.value = null;
            result.lexical = default;
        }
    }
    vector_dispose(void*, &c.declaration_jobs);
}

fn sem_declaration_subject(node: void*): bool {
    return sem_is(node, "CoreDeclare") || sem_is(node, "CoreParameter") || sem_function_syntax(node)
        || sem_is(node, "CoreStruct") || sem_is(node, "CoreEnum");
}

fn sem_declaration_call_push(scan: vector(DeclarationCallScan)*, node: void*, type: bool, unevaluated: bool, complete: bool, evaluation_depth: usize): void {
    if node == null { return; }
    sem_require(vector_reserve(scan, scan.length + 1));
    var entry = &scan.data[scan.length];
    entry.node = node;
    entry.type = type;
    entry.unevaluated = unevaluated;
    entry.complete = complete;
    entry.evaluation_depth = evaluation_depth;
    scan.length++;
}

// Record call continuations in operand order, with children before their call.
// Type arguments retain their role and decltype remains unevaluated. Preparing
// an inner signature never speculatively checks its containing expression.
fn sem_declaration_calls(c: SemanticContext*, result: SemanticDeclaration*): void {
    if result.calls_scanned { return; }
    result.calls_scanned = true;
    var roots: vector(DeclarationScan);
    vector_init(&roots);
    defer vector_dispose(&roots);
    sem_declaration_roots(c, result, &roots);
    var scan: vector(DeclarationCallScan);
    vector_init(&scan);
    defer vector_dispose(&scan);
    for(var i: usize = roots.length; i != 0; i--) {
        sem_declaration_call_push(&scan, roots.data[i - 1].node, roots.data[i - 1].type, c.unevaluated, false, c.evaluation_depth);
    }
    while scan.length != 0 {
        scan.length--;
        var entry: DeclarationCallScan;
        copy(&entry, &scan.data[scan.length], sizeof(DeclarationCallScan));
        var node = entry.node;
        if sem_is(node, "TowerDefault") || sem_is(node, "TowerInitializer") {
            if sem_is(node, "TowerInitializer") {
                sem_declaration_call_push(&scan, sem_member(node, "fields"), false, entry.unevaluated, false, entry.evaluation_depth);
            }
            sem_declaration_call_push(&scan, sem_member(node, "type"), true, entry.unevaluated, false, entry.evaluation_depth);
            continue;
        }
        if entry.complete {
            sem_require(vector_reserve(&result.calls, result.calls.length + 1));
            var call = &result.calls.data[result.calls.length];
            call.node = node;
            call.type = entry.type;
            call.unevaluated = entry.unevaluated;
            call.evaluation_depth = entry.evaluation_depth;
            result.calls.length++;
            continue;
        }
        if entry.type && sem_array_syntax(node) {
            // The child query owns its element/count dependencies. The parent
            // resumes with its canonical identity, without checking it twice.
            sem_declaration_call_push(&scan, node, true, entry.unevaluated, true, entry.evaluation_depth);
            continue;
        }
        if sem_is(node, "TowerDecltype") {
            sem_declaration_call_push(&scan, sem_member(node, "value"), false, true, false, entry.evaluation_depth);
            continue;
        }
        if sem_is(node, "TowerComptime") {
            sem_declaration_call_push(&scan, sem_member(node, "value"), false,
                entry.unevaluated, false, entry.evaluation_depth + 1);
            continue;
        }
        if !entry.type && sem_is(node, "CoreCall") {
            var name_node = sem_member(node, "name");
            var name = sem_identifier(c, name_node);
            var builtin = semantic_builtin_kind(name);
            var definition = sem_resolve(c, c.templates, name_node, name);
            if definition != null { sem_declaration_call_push(&scan, node, false, entry.unevaluated, true, entry.evaluation_depth); }
            var args = sem_collect(c, sem_member(node, "args"), "CoreCallArgument");
            for(var i: usize = args.length; i != 0; i--) {
                var index = i - 1;
                var type = semantic_builtin_type_argument(builtin, index);
                if definition != null && args.length == generic_parameter_count(c.generics, definition) {
                    type = generic_type_parameter(c.generics, definition, index);
                }
                sem_declaration_call_push(&scan, args.data[index], type, entry.unevaluated, false, entry.evaluation_depth);
            }
            // The stack visits this last push first: callable locations may
            // themselves contain generic calls, prepared before their args.
            if sem_call_uses_value(c, name_node) {
                sem_declaration_call_push(&scan, name_node, false, entry.unevaluated, false, entry.evaluation_depth);
            }
            continue;
        }
        for(var i: usize = sem_child_count(node); i != 0; i--) {
            sem_declaration_call_push(&scan, sem_child(node, i - 1), entry.type, entry.unevaluated, false, entry.evaluation_depth);
        }
    }
}

fn sem_declaration_prepare(c: SemanticContext*, result: SemanticDeclaration*): usize {
    sem_declaration_calls(c, result);
    var previous = c.unevaluated;
    var previous_depth = c.evaluation_depth;
    defer { c.unevaluated = previous; c.evaluation_depth = previous_depth; }
    while result.call_index < result.calls.length && sem_ok(c) {
        // A ready inner call can expose another field/layout dependency needed
        // for deduction of the enclosing call. Observe it before typing operands.
        var waiting = sem_declaration_waiting(c, result, &result.layout);
        if waiting != 0 || result.layout != null { return waiting; }
        var call = &result.calls.data[result.call_index];
        c.unevaluated = call.unevaluated;
        c.evaluation_depth = call.evaluation_depth;
        if call.type {
            if result.call_index >= result.type_frontier {
                // Independent array spellings in one record/signature also
                // share a ready frontier. Bound registration and dispatch by
                // the ordinary window, without one wait per array field.
                var end = result.call_index;
                while end < result.calls.length && end - result.call_index < SemanticPreparationWindow
                    && result.calls.data[end].type {
                    sem_array_type_add(c, result.calls.data[end].node, result);
                    end++;
                }
                sem_declaration_discover(c);
                for(var i = result.call_index; i < end; i++) {
                    sem_require(work_demand(&c.queries, sem_declaration_query(c, result.calls.data[i].node)));
                }
                result.type_frontier = end;
            }
            var array = sem_array_type_add(c, call.node, result);
            if sem_declaration_input(result, array.query)
                || work_task(&c.queries, array.query).state != WorkState.Succeeded { return array.query; }
            result.call_index++;
            continue;
        }
        var arguments: vector(void*)* = null;
        if result.inference_ready {
            // Preserve first-binding interning order before assembling the
            // signature's ordinary parameter-ordered type arguments.
            foreach(var &type in &result.inference_order) { sem_type_entity(c, type); }
            arguments = sem_list(c);
            foreach(var &type in &result.inference_types) { sem_push(arguments, sem_type_entity(c, type)); }
            vector_dispose(&result.inference_types);
            vector_dispose(&result.inference_order);
            result.inference_ready = false;
            result.inference_definition = null;
            result.inference_values = null;
        } else {
            if sem_declaration_inference_begin(c, result, call.node) { return 0; }
        }
        var prepared = sem_prepare_call(c, call.node, arguments);
        if !sem_ok(c) { return 0; }
        var query = sem_declaration_query(c, prepared.instance);
        // Even a signature completed for another consumer needs an explicit
        // dependency/read claim. Suspension installs it before readmission.
        if query != 0 && sem_declaration_input(result, query) { return query; }
        if query != 0 && work_task(&c.queries, query).state != WorkState.Succeeded { return query; }
        result.call_index++;
    }
    return sem_ok(c) ? sem_declaration_waiting(c, result, &result.layout) : 0;
}

// Registration and discovery are shared by source declarations and newly
// instantiated signatures. All nodes are registered before discovery dispatch;
// every dependency is sealed before the caller may suspend/demand it.
fn sem_expression_add(c: SemanticContext*, node: void*, expected_type: FoundationType*, lexical: SemanticBodyScope*, mode: SemanticExpressionMode): SemanticDeclaration* {
    var result = sem_declaration_state(c, node);
    sem_require(result.query == 0);
    result.expression = true;
    result.expression_mode = mode;
    result.expected_type = expected_type;
    result.scope = lexical.scope;
    result.current = lexical.current;
    result.lexical = *lexical;
    sem_declaration_add(c, node);
    return result;
}

fn sem_declaration_add(c: SemanticContext*, node: void*): void {
    var result = sem_declaration_state(c, node);
    if result.query != 0 { return; }
    sem_push(c.declaration_subjects, node);
    var kind = result.array_type ? ArrayTypeQuery : result.expression ? ExpressionQuery : DeclarationQuery;
    var id = work_request(&c.queries, node, kind, 0);
    sem_require(id != 0);
    result.query = id;
    result.context = c;
    result.subject = node;
    result.kernel.kind = CompilerKernelKind.Declaration;
    result.kernel.payload = bits(void*, result);
    result.discover = true;
    result.worker_check = sem_declaration_worker(c, result);
    sem_require(vector_push(&c.declaration_jobs, bits(void*, result)));
    var domain = convert(u64, SemanticWorkDomain.Compiler);
    sem_require(work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Declaration), id, 1, WorkAccessMode.Write));
    if result.array_type {
        sem_require(work_access(&c.queries, id, domain, convert(u64, SemanticAccess.TypeIndex),
            0, ~convert(usize, 0), WorkAccessMode.Read));
    }
    if result.current != null {
        // Module initializer expressions read the already allocated root frame;
        // their own leased syntax holds all writes. Statement publication and
        // runtime effects still follow source order on the coordinator.
        sem_require(work_access(&c.queries, id, domain,
            convert(u64, SemanticAccess.Body), sem_get(result.current).index, 1,
            result.module_initializer || result.array_type ? WorkAccessMode.Read : WorkAccessMode.Write));
    }
    result.discovery = work_request(&c.queries, node, DeclarationDiscoveryQuery, 0);
    sem_require(work_access(&c.queries, result.discovery, domain, convert(u64, SemanticAccess.Discovery), id, 1, WorkAccessMode.Write));
    sem_require(work_access(&c.queries, result.discovery, domain, convert(u64, SemanticAccess.Expression), 0, ~convert(usize, 0), WorkAccessMode.Read));
    sem_require(work_seal(&c.queries, result.discovery));
    sem_require(work_demand(&c.queries, result.discovery));
}

// Tickets and stages are reserved before this call, so type/readiness workers
// see one immutable graph. Pool width changes execution, never the query wave.
fn sem_declaration_dispatch(c: SemanticContext*, batch: SemanticDeclaration**, count: usize): void {
    var context = *c;
    // A lone ready query cannot overlap another job here. Run its same frozen
    // kernel inline, keeping the ticket, stage and joined publication contract
    // while avoiding a semaphore round trip along a narrow dependency chain.
    if count == 1 && c.workers.running == 0 {
        var result = batch[0];
        result.context = &context;
        c.workers.execute(bits(void*, &result.kernel));
        result.context = null;
        return;
    }
    var next: usize = 0;
    while next < count || c.workers.running != 0 {
        while next < count && c.workers.running < c.workers.count {
            var result = batch[next++];
            result.context = &context;
            sem_require(work_pool_submit(&c.workers, bits(void*, &result.kernel)));
        }
        sem_require(work_pool_receive(&c.workers, true) != null);
    }
    for(var i: usize = 0; i < count; i++) { batch[i].context = null; }
}

fn sem_declaration_discover(c: SemanticContext*): void {
    if c.workers.count == 0 { sem_require(sem_workers_open(c)); }
    var batch: vector(SemanticDeclaration*) = default;
    sem_require(vector_reserve(&batch, SemanticPreparationWindow));
    defer vector_dispose(&batch);
    var index: usize = 0;
    loop {
        var view = entity_view_open(c.program.root);
        sem_require(view != null);
        var count: usize = 0;
        var ticket: WorkTicket;
        while count < SemanticPreparationWindow && work_take_query(&c.queries, &ticket, DeclarationDiscoveryQuery) {
            var result = sem_declaration_state(c, work_task(&c.queries, ticket.task).subject);
            copy(&result.ticket, &ticket, sizeof(WorkTicket));
            batch.data[count] = result;
            count++;
        }
        sem_declaration_dispatch(c, batch.data, count);
        entity_view_close(view);
        if count == 0 { break; }
        index = 0;
        while index < count {
            var result = batch.data[index];
            var success = !sem_declaration_error(c, result);
            sem_query_observe(c, &result.ticket, &result.query_reads);
            sem_require(work_finish(&c.queries, &result.ticket, success));
            var edge: usize = 0;
            while edge < result.dependencies.length {
                var input = result.dependencies.data[edge];
                sem_require(work_depend(&c.queries, result.query, input));
                var access = WorkAccessMode.Read;
                // Header checking assigns each parameter's frame slot after
                // its type receipt. Claim those payload writes as well.
                if sem_function_syntax(result.subject) && sem_is(work_task(&c.queries, input).subject, "CoreParameter") {
                    access = WorkAccessMode.Write;
                }
                sem_require(work_access(&c.queries, result.query, 1, 4, input, 1, access));
                edge++;
            }
            sem_require(work_depend(&c.queries, result.query, result.discovery));
            sem_require(work_seal(&c.queries, result.query));
            result.discover = false;
            index++;
        }
        if !sem_ok(c) { break; }
    }
}

fn sem_declarations(c: SemanticContext*, statements: vector(void*)*): void {
    if !sem_ok(c) { return; }
    c.declaration_subjects = sem_list(c);
    defer { c.declaration_subjects = null; }
    for(var i: usize = 0; i < statements.length && sem_ok(c); ++i) {
        var node = statements.data[i];
        if !sem_declaration_subject(node) { continue; }
        if sem_function_syntax(node) { sem_parameters(c, node, null); }
        sem_declaration_add(c, node);
        if sem_function_syntax(node) {
            var parameters = &sem_get(node).parameters;
            for(var j: usize = 0; j < parameters.length; ++j) { sem_declaration_add(c, parameters.data[j]); }
        }
    }
    if !sem_ok(c) { return; }
    // Even primitive identities have a preallocated state so lookups in a
    // worker can never enter entity_component_add while structure is pinned.
    var index: usize = 0;
    while index < c.program.types.length {
        sem_declaration_state(c, c.program.types.data[index]);
        index++;
    }
    sem_declaration_discover(c);
    // A later ready declaration must not choose its diagnostic while an earlier
    // declaration is suspended on an array/signature/type dependency.
    var previous_isolated = c.declaration_isolated;
    c.declaration_isolated = true;
    sem_declarations_execute(c, c.declaration_subjects);
    c.declaration_isolated = previous_isolated;
    foreach(var node in c.declaration_subjects) {
        if !sem_ok(c) { break; }
        if sem_declaration_query(c, node) != 0 { sem_declaration_report(c, node); }
    }
}

extern fn generic_error_clear(context: void*): void;

// Check one source-ordered run of module declarations. A following executable
// statement ends the run, preserving diagnostic/effect order across boundaries.
// Inferred initializers already have their type producer's checked value.
fn sem_module_initializer_range(c: SemanticContext*, statements: vector(void*)*, first: usize): usize {
    var previous_subjects = c.declaration_subjects;
    var previous_isolated = c.declaration_isolated;
    c.declaration_subjects = sem_list(c);
    c.declaration_isolated = true;
    defer {
        generic_error_clear(c.generics);
        c.declaration_subjects = previous_subjects;
        c.declaration_isolated = previous_isolated;
    }
    var lexical: SemanticBodyScope;
    sem_body_save(c, &lexical);
    var end = first;
    while end < statements.length {
        var node = statements.data[end];
        if !sem_is(node, "CoreDeclare") {
            if sem_function_syntax(node) || sem_is(node, "CoreStruct") || sem_is(node, "CoreEnum") { end++; continue; }
            break;
        }
        end++;
        var value = sem_get(node);
        var source = sem_member(node, "value");
        if source == null || value.value != null { continue; }
        sem_declaration_state(c, source).module_initializer = true;
        var result = sem_expression_add(c, source, &value.type, &lexical, SemanticExpressionMode.Initializer);
        sem_require(work_depend(&c.queries, result.query, sem_declaration_query(c, node)));
    }
    if c.declaration_subjects.length != 0 {
        sem_declaration_discover(c);
        sem_require(sem_ok(c));
        sem_declarations_execute(c, c.declaration_subjects);
        sem_require(sem_ok(c));
    }
    return end;
}

// Select a stored producer diagnostic only when its declaration is reached.
// Completion never repeats an initializer or changes module statement order.
fn sem_module_initializer_finish(c: SemanticContext*, node: void*): void {
    var value = sem_get(node);
    var source = sem_member(node, "value");
    if source == null || value.value != null { return; }
    var query = sem_declaration_query(c, source);
    if query == 0 { return; }
    sem_declaration_report(c, source);
    if sem_ok(c) { value.value = sem_declaration_state(c, source).value; }
}

// Types created by a producer belong to that producer's dependency frontier.
// Checking every new type globally would let an unrelated later body choose
// an earlier body's failure. Field receipts precede layout admission.
fn sem_declaration_constructed(c: SemanticContext*, result: SemanticDeclaration*): usize {
    if result.current != null && sem_is(result.subject, "CoreDeclare") {
        var type = &sem_get(result.subject).type;
        if semantic_aggregate(type) && !sem_has(&result.constructed, type.record) {
            sem_push(&result.constructed, type.record);
        }
    }
    foreach(var node in &result.constructed) {
        var waiting = sem_declaration_layout_waiting_except(c, node, result.query);
        if waiting != 0 { return waiting; }
        var query = work_find(&c.queries, node, convert(u32, SemanticQuery.Layout), 0);
        if query == 0 || work_task(&c.queries, query).state != WorkState.Succeeded {
            result.layout = node;
            return 0;
        }
    }
    return 0;
}

fn sem_declarations_execute(c: SemanticContext*, statements: vector(void*)*): void {
    var batch: vector(SemanticDeclaration*) = default;
    sem_require(vector_reserve(&batch, SemanticPreparationWindow));
    defer vector_dispose(&batch);
    if !sem_ok(c) { return; }
    var index: usize = 0;
    while index < statements.length {
        var node = statements.data[index];
        var query = sem_declaration_query(c, node);
        if query != 0 { sem_require(work_demand(&c.queries, query)); }
        index++;
    }
    loop {
        if !sem_ok(c) { break; }
        var count: usize = 0;
        var ticket: WorkTicket;
        while count < SemanticPreparationWindow && (work_take_query(&c.queries, &ticket, DeclarationQuery)
            || work_take_query(&c.queries, &ticket, ExpressionQuery)
            || work_take_query(&c.queries, &ticket, ArrayTypeQuery)) {
            var result = sem_declaration_state(c, work_task(&c.queries, ticket.task).subject);
            copy(&result.ticket, &ticket, sizeof(WorkTicket));
            result.kernel.kind = result.worker_check ? CompilerKernelKind.DeclarationType : CompilerKernelKind.Declaration;
            if result.nodes.length != 0 {
                result.stage = entity_stage_open(c.program.root);
                sem_require(result.stage != null);
                foreach(var node in &result.nodes) { sem_require(entity_stage_lease(result.stage, node)); }
            }
            batch.data[count] = result;
            count++;
        }
        var view = entity_view_open(c.program.root);
        sem_require(view != null);
        // Readiness checks inspect graph states, including newly discovered
        // field dependencies. Finish every Ready -> Running transition before
        // dispatch so workers read an immutable graph throughout this wave.
        sem_declaration_dispatch(c, batch.data, count);
        entity_view_close(view);
        if count == 0 {
            if sem_generic_copies_execute(c) { continue; }
            break;
        }
        var layouts: vector(usize);
        vector_init(&layouts);
        defer vector_dispose(&layouts);
        // Release every lease before a structural continuation can discover
        // declarations or prepare syntax owned by another completed job.
        for(var i: usize = 0; i < count; i++) {
            var result = batch.data[i];
            if result.stage != null {
                sem_require(entity_stage_publish(result.stage));
                result.stage = null;
            }
        }
        index = 0;
        while index < count {
            var result = batch.data[index];
            var node = result.subject;
            // Keep this producer's diagnostic separate from an earlier job's
            // selected error. Independent successful receipts remain reusable.
            var selected_error = c.program.error;
            var selected_offset = c.program.error_offset;
            c.program.error = default;
            var type_first = c.program.types.length;
            foreach(var job in &result.evaluations) {
                var evaluation = bits(SemanticEvaluation*, job);
                sem_push(&c.evaluation_jobs, job);
                sem_evaluation_request(c, evaluation);
            }
            vector_dispose(&result.evaluations);
            if result.inference_ready { result.nodes.length = 0; }
            c.count += result.count;
            c.surface_expressions ||= result.surface;
            if c.count > c.node_limit { sem_fail(c, node, "Foundation component memory budget exceeded"); }
            var success = !sem_declaration_error(c, result) && sem_ok(c);
            var readmit = false;
            var saved_reads = c.query_reads;
            c.query_reads = &result.query_reads;
            if success && !result.checked && result.waiting == 0 && result.layout == null {
                var saved_lexical: SemanticBodyScope;
                sem_body_save(c, &saved_lexical);
                c.scope = result.scope;
                c.current = result.current;
                if result.current != null { sem_body_restore(c, &result.lexical); }
                if c.declaration_isolated { generic_error_clear(c.generics); }
                result.waiting = sem_declaration_prepare(c, result);
                if result.waiting == 0 && result.layout == null && sem_ok(c) {
                    if result.inference_pending { readmit = true; }
                    else {
                        if sem_declaration_worker(c, result) {
                            result.worker_check = true;
                            readmit = true;
                        } else {
                            if result.array_type { sem_array_type_check(c, result); }
                            else {
                                if result.expression { sem_expression_check(c, result); }
                                else {
                                    if sem_is(node, "CoreDeclare") || sem_is(node, "CoreParameter") { sem_declaration_type(c, node); }
                                    else {
                                        if sem_function_syntax(node) { sem_header(c, node, "", null); }
                                        else {
                                            if sem_is(node, "CoreStruct") { sem_type_fields(c, node); }
                                            else { sem_enum_fields(c, node); }
                                        }
                                    }
                                }
                            }
                            result.checked = sem_ok(c);
                        }
                    }
                }
                success = sem_ok(c);
                if result.current != null { sem_body_save(c, &result.lexical); }
                sem_body_restore(c, &saved_lexical);
            }
            if success && result.array_type && result.checked && !result.array_ready {
                result.array_result = *sem_array_intern(c, &result.array_element, result.array_length);
                result.array_ready = true;
                sem_type_use(c, result.subject, &result.array_result);
            }
            // The originating declaration owns layouts created by child type
            // queries, including arrays used only by sizeof/alignof/alloc.
            // Its value type may be scalar and cannot reveal these operands.
            if c.declaration_isolated && result.array_type {
                for(var i = type_first; i < c.program.types.length; i++) {
                    sem_push(&result.construction_owner.constructed, c.program.types.data[i]);
                }
            }
            // Array identity does not require element layout. Making its
            // producer wait for the containing record's fields would create
            // a false declaration cycle before the layout graph can diagnose
            // an actual by-value cycle. Storage consumers demand that layout.
            if c.declaration_isolated && !result.array_type {
                for(var i = type_first; i < c.program.types.length; i++) {
                    var node = c.program.types.data[i];
                    if sem_get(node).type.record != null { sem_push(&result.constructed, node); }
                }
                if success && result.checked && result.waiting == 0 && result.layout == null {
                    result.waiting = sem_declaration_constructed(c, result);
                }
            }
            if !success { sem_declaration_capture_error(c, result); }
            c.query_reads = saved_reads;
            sem_query_observe(c, &result.ticket, &result.query_reads);
            if success && result.layout != null {
                result.waiting = sem_layout_discover(c, result.layout);
                sem_require(vector_push(&layouts, result.waiting));
                sem_require(work_suspend_access(&c.queries, &result.ticket, result.waiting,
                    1, 1, result.waiting, 1, WorkAccessMode.Read));
            } else {
                if success && result.waiting != 0 {
                    sem_declaration_input(result, result.waiting);
                    sem_require(work_suspend_access(&c.queries, &result.ticket, result.waiting,
                        1, 4, result.waiting, 1, WorkAccessMode.Read));
                } else {
                    if success && readmit { sem_require(work_yield(&c.queries, &result.ticket)); }
                    else { sem_require(work_finish(&c.queries, &result.ticket, success)); }
                }
            }
            if c.declaration_isolated {
                vector_dispose(&c.program.error);
                vector_dispose(&selected_error);
            } else {
                if selected_error.length != 0 {
                    vector_dispose(&c.program.error);
                    c.program.error = selected_error;
                    c.program.error_offset = selected_offset;
                } else { vector_dispose(&selected_error); }
            }
            index++;
        }
        // Every declaration relinquishes its claims before this wave. Layout
        // workers publish once, releasing all waiting consumers through the
        // same graph; no worker recursively forces layout completion.
        if layouts.length != 0 && sem_ok(c) {
            sem_layout_execute(c);
            // Layouts refill workers as they finish. Structural continuations
            // must publish types/signatures in stable request order afterwards.
            sem_require(work_order_ready(&c.queries));
            if c.declaration_isolated { vector_dispose(&c.program.error); }
            else {
                foreach(var query in &layouts) {
                    if sem_ok(c) { sem_layout_cycle(c, query); }
                }
            }
        }
    }
    if c.declaration_isolated { return; }
    index = 0;
    while index < statements.length && sem_ok(c) {
        var node = statements.data[index];
        if sem_declaration_query(c, node) != 0 { sem_declaration_report(c, node); }
        index++;
    }
}

fn sem_declaration_report(c: SemanticContext*, node: void*): void {
    var id = sem_declaration_query(c, node);
    if work_task(&c.queries, id).state == WorkState.Succeeded || sem_declaration_failure(c, id) { return; }
    var cycle: vector(usize) = default;
    defer vector_dispose(&cycle);
    sem_require(work_cycle(&c.queries, id, &cycle));
    foreach(var query in &cycle) {
        if work_task(&c.queries, query).query == convert(u32, SemanticQuery.Layout) {
            sem_layout_cycle(c, query);
            return;
        }
    }
    var chain: u8* = "";
    for(var i: usize = 0; i < cycle.length; i++) {
        if i != 0 { chain = sem_cat(c, chain, " -> "); }
        chain = sem_cat(c, chain, sem_name(sem_get(work_task(&c.queries, cycle.data[i]).subject)));
    }
    if sem_is(node, "CoreDeclare") && sem_member(node, "type") == null {
        sem_fail(c, node, sem_cat(c, "Cannot infer the type of '",
            sem_cat(c, sem_name(sem_get(node)), sem_cat(c, "': initializer dependency cycle ",
                sem_cat(c, chain, "; add an explicit type annotation")))));
    } else {
        sem_fail(c, node, sem_cat(c, "Cannot resolve declaration type: initializer dependency cycle ", chain));
    }
}
