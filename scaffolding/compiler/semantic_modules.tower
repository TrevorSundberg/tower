import tower;
import .library.work_budget_types;
import semantic_context_types;
import .library.vector;
import foundation_tags;
import frontend_compilation;
import semantic_context;
import semantic_definitions;
import semantic_support;
import semantic_known_bindings;
import semantic_evaluation;

// Ownership/import components live on the same retained parse entities. The
// registry and lookup tables are compilation-local indexes, not another IR.
// Text is owned by ordinary entity relationship names; no context allocation
// escapes into a retained component. Foundation output encodes resolved bindings.
import semantic_program_types;

struct SemanticModuleLink {
    module: void*;
    base: usize;
    cyclic: bool;
}

extern fn frontend_module_name(module: void*): u8*;
extern fn frontend_module_cyclic_result(module: void*, error: WorkBudgetError*): bool;

extern fn frontend_module_import_count(module: void*): usize;

extern fn frontend_module_import_at(module: void*, index: usize): void*;

extern fn frontend_module_dependency_at(module: void*, index: usize): void*;

extern fn frontend_module_alias(module: void*, index: usize): u8*;

extern fn entity_child_name(node: void*, index: usize): u8*;

fn sem_module_ok(program: SemanticProgram*): bool {
    return program.resource.error == WorkBudgetError.None && program.error.length == 0;
}

fn sem_module_error(program: SemanticProgram*, error: WorkBudgetError, offset: usize): bool {
    if sem_module_ok(program) {
        sem_resource_record(program, error, offset);
        program.error_offset = offset;
    }
    return false;
}

fn sem_module_offset(node: void*, base: usize): usize {
    var span = sem_match(node);
    return span == null ? base : base + span.start;
}

export fn sem_modules_begin(program: SemanticProgram*, base: usize): SemanticModules* {
    if !sem_module_ok(program) { return null; }
    if program.modules != null { return program.modules; }
    var error: WorkBudgetError;
    var registry = entity_create_related_result(program.root, &error);
    if registry == null { sem_module_error(program, error, base); return null; }
    // No root component retains this registry until all its children exist.
    // Releasing the local owner therefore also retires every partial child.
    defer entity_release(registry);
    error = entity_register_stage_result(registry, sizeof(SemanticModules), alignof(SemanticModules), 0, 0);
    if error != WorkBudgetError.None {
        sem_module_error(program, error, base); return null;
    }
    var owner = sem_kind_result(registry, sizeof(SemanticModuleLink), alignof(SemanticModuleLink), &error);
    var imports = owner == null ? null : sem_kind_result(registry, sizeof(SemanticModuleLink), alignof(SemanticModuleLink), &error);
    var scopes = imports == null ? null : sem_create_result(registry, &error);
    if scopes == null { sem_module_error(program, error, base); return null; }
    var modules = bits(SemanticModules*, entity_component_data(entity_component_add_result(program.root, registry, &error)));
    if modules == null { sem_module_error(program, error, base); return null; }
    *modules = { root: registry, owner_kind: owner, import_kind: imports, scopes: scopes };
    program.modules = modules;
    return modules;
}

export fn sem_module_scope(program: SemanticProgram*, module: void*, base: usize): void* {
    if !sem_module_ok(program) { return null; }
    var registry = sem_modules_begin(program, base);
    if registry == null { return null; }
    var path = frontend_module_name(module);
    var scope = sem_member(registry.scopes, path);
    if scope != null { return scope; }
    var error: WorkBudgetError;
    var cyclic = frontend_module_cyclic_result(module, &error);
    if error != WorkBudgetError.None { sem_module_error(program, error, base); return null; }
    scope = entity_create_related_result(registry.scopes, &error);
    if scope == null { sem_module_error(program, error, base); return null; }
    defer entity_release(scope);
    var link = bits(SemanticModuleLink*, entity_component_data(entity_component_add_result(scope, registry.owner_kind, &error)));
    if link == null { sem_module_error(program, error, base); return null; }
    *link = { module: scope, base: base, cyclic: cyclic };
    error = entity_attach_result(scope, registry.scopes, path);
    if error != WorkBudgetError.None { sem_module_error(program, error, base); return null; }
    return scope;
}

fn sem_module_link(program: SemanticProgram*, node: void*, kind: void*, scope: void*, base: usize): bool {
    if !sem_module_ok(program) { return false; }
    var error: WorkBudgetError;
    var link = bits(SemanticModuleLink*, entity_component_data(entity_component_add_result(node, kind, &error)));
    if link == null { return sem_module_error(program, error, sem_module_offset(node, base)); }
    *link = { module: scope, ..default };
    return true;
}

export fn sem_module_position(program: SemanticProgram*, module: void*, base: usize): bool {
    var scope = sem_module_scope(program, module, base);
    if scope == null { return false; }
    var link = bits(SemanticModuleLink*, entity_component_data(entity_component_get(scope, program.modules.owner_kind)));
    link.base = base;
    return true;
}
// Parsing defers ordinary variable initialization in cycles to the same semantic
// proof used everywhere else. Metadata-bearing fixed bindings retain their
// declarations; their proved values have no initialization-order dependency.
fn sem_module_initializers(c: SemanticContext*): void {
    if !sem_ok(c) || c.program.modules == null { return; }
    foreach(var node in &sem_get(c.program.root).items) {
        if sem_get(node).kind != KDeclare { continue; }
        var owner = sem_owner(c, node);
        if owner == null { continue; }
        var link = bits(SemanticModuleLink*, entity_component_data(entity_component_get(owner, c.program.modules.owner_kind)));
        if link != null && link.cyclic {
            var binding = sem_known_binding(c, node);
            if binding != null && binding.immutable && binding.ordered && binding.evaluation != null {
                var evaluation = sem_evaluation_get(c, binding.evaluation);
                if evaluation.ready.ready && !evaluation.ready.failed { continue; }
            }
            sem_fail(c, node, "Import cycle requires fixed compile-time variable initializers; runtime initialization has no dependency-first order");
            return;
        }
    }
}

export fn sem_module_record(program: SemanticProgram*, module: void*, base: usize): bool {
    var scope = sem_module_scope(program, module, base);
    if scope == null { return false; }
    var registry = program.modules;
    var count = frontend_module_roots(module);
    for(var i: usize = 0; i < count; i++) {
        if !sem_module_link(program, frontend_module_tree(module, i), registry.owner_kind, scope, base) { return false; }
    }
    count = frontend_module_import_count(module);
    for(var i: usize = 0; i < count; i++) {
        var declaration = frontend_module_import_at(module, i);
        // Recovered snapshots retain their actual source entities and spans.
        if entity_component_get(declaration, registry.import_kind) != null { continue; }
        var dependency = frontend_module_dependency_at(module, i);
        var target = sem_module_scope(program, dependency, 0);
        if target == null { return false; }
        var alias = frontend_module_alias(module, i);
        var tree = sem_parent(declaration) ?? declaration;
        // All metadata must exist before moving the ordered/named source tree.
        // A denial keeps the previous containment and the fatal program receipt.
        if !sem_module_link(program, tree, registry.import_kind, target, base)
            || !sem_module_link(program, declaration, registry.import_kind, target, base)
            || !sem_module_link(program, declaration, registry.owner_kind, scope, base) { return false; }
        var error = entity_attach_result(tree, scope, alias);
        if error != WorkBudgetError.None { return sem_module_error(program, error, sem_module_offset(declaration, base)); }
    }
    return true;
}

fn sem_module_graph(program: SemanticProgram*, module: void*, base: usize): bool {
    if !sem_module_record(program, module, base) { return false; }
    var count = frontend_module_count(module);
    for(var i: usize = 0; i < count; i++) {
        var dependency = frontend_module_at(module, i);
        if !sem_module_record(program, dependency, dependency == module ? base : 0) { return false; }
    }
    return true;
}
fn sem_owner(c: SemanticContext*, node: void*): void* {
    var registry = c.program.modules;
    if registry == null {
        return null;
    }
    while node != null {
        var component = entity_component_get(node, registry.owner_kind);
        var link = bits(SemanticModuleLink*, entity_component_data(component));
        if link != null {
            return link.module;
        }
        if c.generics != null {
            var original = generic_definition(c.generics, node);
            if original != node {
                node = original;
                continue;
            }
        }
        node = sem_parent(node);
    }
    return null;
}

fn sem_module_path(c: SemanticContext*, module: void*): u8* {
    var scopes = c.program.modules.scopes;
    var count = sem_child_count(scopes);
    for(var i: usize = 0; i < count; i++) {
        if sem_child(scopes, i) == module {
            return entity_child_name(scopes, i);
        }
    }
    return "";
}

fn sem_owned(table: SemanticTable*, module: void*, name: u8*): void* {
    var entry = sem_find(table, name, module);
    if entry != null {
        return entry.value;
    }
    return null;
}

fn sem_define(c: SemanticContext*, table: SemanticTable*, node: void*, name: u8*): bool {
    var owner = sem_owner(c, node);
    var entry = sem_entry(c, table, name, owner);
    if !sem_ok(c) { return default; }
    if entry.value != null {
        return false;
    }
    entry.value = node;
    return true;
}

fn sem_local(c: SemanticContext*, name: u8*): void* {
    var scope = c.scope;
    while scope != null {
        var found = sem_lookup_table(scope.names, name);
        if found != null {
            return found;
        }
        scope = scope.parent;
    }
    return null;
}

fn sem_import_target(c: SemanticContext*, edge: void*): void* {
    var component = entity_component_get(edge, c.program.modules.import_kind);
    var link = bits(SemanticModuleLink*, entity_component_data(component));
    if link != null {
        return link.module;
    }
    return null;
}

fn sem_import_alias(owner: void*, index: usize): u8* {
    var name = entity_child_name(owner, index);
    if name == null {
        return "";
    }
    return name;
}

fn sem_alias(c: SemanticContext*, owner: void*, name: u8*): void* {
    var i: usize = 0;
    var count = sem_child_count(owner);
    for(; i < count; i++) {
        var alias = sem_import_alias(owner, i);
        if sem_equal(alias, name) {
            return sem_import_target(c, sem_child(owner, i));
        }
    }
    return null;
}

fn sem_visible(c: SemanticContext*, table: SemanticTable*, node: void*, owner: void*, name: u8*): void* {
    var found = sem_owned(table, owner, name);
    if found != null {
        return found;
    }
    if owner == null {
        return null;
    }
    var count = sem_child_count(owner);
    for(var i: usize = 0; i < count; i++) {
        var alias = sem_import_alias(owner, i);
        if alias[0] == 0 {
            var target = sem_import_target(c, sem_child(owner, i));
            var candidate = sem_owned(table, target, name);
            if candidate != null {
                var different = found != null;
                different &&= found != candidate;
                if different {
                    sem_fail(c, node, sem_cat(c, "Ambiguous imported name '", sem_cat(c, name, "'; use an import alias")));
                    return null;
                }
                found = candidate;
            }
        }
    }
    if found == null && table == c.types {
        // Type-only prelude modules compose through ordinary unaliased imports.
        // Each scope's own binding wins; visited scopes bound cyclic imports.
        var pending_values: vector(void*) = default;
        var seen_values: vector(void*) = default;
        defer vector_dispose(&pending_values);
        defer vector_dispose(&seen_values);
        var pending = &pending_values;
        var seen = &seen_values;
        for(var i: usize = 0; i < count; i++) {
            if sem_import_alias(owner, i)[0] == 0 {
                var target = sem_import_target(c, sem_child(owner, i));
                if target != null { sem_push_checked(c, pending, target); }
            }
        }
        while pending.length != 0 {
            pending.length--;
            var scope = pending.data[pending.length];
            if sem_has(seen, scope) { continue; }
            if !sem_push_checked(c, seen, scope) { return default; }
            var candidate = sem_owned(table, scope, name);
            if candidate != null {
                if found != null && found != candidate {
                    sem_fail(c, node, sem_cat(c, "Ambiguous imported type '", sem_cat(c, name, "'; use an import alias")));
                    return null;
                }
                found = candidate;
                continue;
            }
            for(var i: usize = 0; i < sem_child_count(scope); i++) {
                if sem_import_alias(scope, i)[0] == 0 {
                    var target = sem_import_target(c, sem_child(scope, i));
                    if target != null { sem_push_checked(c, pending, target); }
                }
            }
        }
    }
    if found == null {
        // Only the reflected Foundation primitive types are ownerless.
        var types = table == c.types;
        if types {
            found = sem_owned(table, null, name);
        }
    }
    return found;
}

fn sem_name_node(node: void*): void* {
    loop {
        var base = sem_member(node, "base");
        if base != null {
            return node;
        }
        var name = sem_member(node, "name");
        if name != null {
            node = name;
        } else {
            return node;
        }
    }
}

fn sem_callable_owned(c: SemanticContext*, owner: void*, name: u8*): void* {
    var found = sem_owned(c.functions, owner, name);
    var missing = found == null;
    if missing {
        found = sem_owned(c.templates, owner, name);
    }
    missing = found == null;
    if missing {
        found = sem_owned(c.type_functions, owner, name);
    }
    return found;
}

fn sem_foreign_same_name(left: void*, right: void*): bool {
    var a = sem_get(left);
    var b = sem_get(right);
    if a == null || b == null { return false; }
    return a.kind == KFunction && b.kind == KFunction
        && (a.external || a.exported) && (b.external || b.exported)
        && sem_equal(sem_name(a), sem_name(b));
}

fn sem_callable_visible(c: SemanticContext*, table: SemanticTable*, node: void*, owner: void*, name: u8*): void* {
    var local = sem_callable_owned(c, owner, name);
    var present = local != null;
    if present {
        return sem_owned(table, owner, name);
    }
    var selected: void* = null;
    var found: void* = null;
    var i: usize = 0;
    var count = sem_child_count(owner);
    for(; i < count; i++) {
        var alias = sem_import_alias(owner, i);
        if alias[0] == 0 {
            var dependency = sem_import_target(c, sem_child(owner, i));
            var candidate = sem_callable_owned(c, dependency, name);
            present = candidate != null;
            if present {
                var different = found != null;
                different &&= found != candidate;
                // Foreign declarations of one link symbol are validated and
                // coalesced after signature queries finish. They must remain
                // name-resolvable while those queries are still pending.
                if different && sem_foreign_same_name(found, candidate) { different = false; }
                if different {
                    sem_fail(c, node, sem_cat(c, "Ambiguous imported name '", sem_cat(c, name, "'; use an import alias")));
                    return null;
                }
                found = candidate;
                selected = dependency;
            }
        }
    }
    return sem_owned(table, selected, name);
}

fn sem_resolve(c: SemanticContext*, table: SemanticTable*, node: void*, spelling: u8*): void* {
    return sem_resolve_from(c, table, node, spelling, sem_owner(c, node));
}

fn sem_resolve_from(c: SemanticContext*, table: SemanticTable*, node: void*, spelling: u8*, owner: void*): void* {
    var name = sem_name_node(node);
    if sem_member(name, "index") != null {
        return null;
    }
    var base = sem_member(name, "base");
    var field = sem_member(name, "field");
    var qualified = base != null;
    qualified &&= field != null;
    if qualified {
        var target = sem_namespace_from(c, name, owner);
        if target != null {
            return sem_owned(table, target, sem_identifier(c, field));
        }
        return null;
    }
    var callable = table == c.functions;
    callable ||= table == c.templates;
    callable ||= table == c.type_functions;
    if callable {
        return sem_callable_visible(c, table, node, owner, spelling);
    }
    return sem_visible(c, table, node, owner, spelling);
}

fn sem_namespace(c: SemanticContext*, node: void*): void* {
    return sem_namespace_from(c, node, sem_owner(c, node));
}

fn sem_namespace_from(c: SemanticContext*, node: void*, owner: void*): void* {
    node = sem_name_node(node);
    var base = sem_member(node, "base");
    var field = sem_member(node, "field");
    var possible = base != null;
    possible &&= field != null;
    if !possible {
        return null;
    }
    base = sem_name_node(base);
    if sem_member(base, "base") != null {
        return null;
    }
    var name = sem_identifier(c, base);
    if !sem_ok(c) { return default; }
    var shadowed = sem_local(c, name) != null;
    if c.generics != null {
        var parameter = generic_lookup(c.generics, base, base);
        if parameter != null {
            shadowed = true;
        }
    }
    if shadowed {
        return null;
    }
    return sem_alias(c, owner, name);
}

fn sem_editor_symbol(c: SemanticContext*, node: void*, kind: u32): bool {
    var name = sem_name_node(node);
    var field = sem_member(name, "field");
    var qualified = field != null;
    var target = name;
    if qualified {
        target = field;
    }
    // Resolve the owning module before capture installs its intentional editor
    // boundary diagnostic. Ordinary namespace resolution must keep rejecting
    // real semantic/resource failures, including denied identifier storage.
    if !sem_editor_contains(c, target) { return false; }
    var span = sem_match(target);
    if span.start != c.editor.offset || span.length != c.editor.length { return false; }
    if c.editor.found { return true; }
    if !sem_ok(c) { return false; }
    var module = sem_namespace(c, name);
    if !sem_ok(c) { return false; }
    var captured = sem_editor_capture(c, target, kind, null);
    if captured {
        c.editor.node = node;
        c.editor.module = module;
    }
    return captured;
}

fn sem_completion_visible(c: SemanticContext*, editor: SemanticEditor*, table: SemanticTable*, node: void*): bool {
    if c.program.resource.error != WorkBudgetError.None { return false; }
    var name = sem_identifier(c, sem_member(node, "name"));
    if !sem_ok(c) { return default; }
    var value = sem_get(node);
    if name[0] == 0 {
        if value != null {
            name = sem_name(value);
        }
    }
    var found: void* = null;
    if editor.module != null {
        found = sem_owned(table, editor.module, name);
    } else {
        var callable = table == c.functions;
        callable ||= table == c.templates;
        callable ||= table == c.type_functions;
        if callable {
            found = sem_callable_visible(c, table, editor.node, sem_owner(c, editor.node), name);
        } else {
            found = sem_visible(c, table, editor.node, sem_owner(c, editor.node), name);
        }
    }
    var clean = sem_ok(c);
    if c.program.resource.error == WorkBudgetError.None { c.program.error.length = 0; }
    if clean {
        var same = found == node;
        return same;
    }
    return false;
}

// Keep familiar names when unique. Colliding module-local declarations get a
// deterministic, escaped Foundation spelling; bindings still point to entities.
fn sem_output_name(c: SemanticContext*, node: void*, name: u8*): u8* {
    var saved = sem_find(c.output_names, null, node);
    if saved != null {
        return bits(u8*, saved.value);
    }
    var spelling = name;
    var original = sem_find(c.source_names, name, null);
    var collision = original != null;
    collision &&= original.number != 0;
    if collision {
        var owner = sem_owner(c, node);
        if owner != null {
            spelling = sem_cat(c, name, sem_cat(c, "@", sem_module_path(c, owner)));
            if !sem_ok(c) { return default; }
        }
    }
    var candidate = spelling;
    var suffix: u64 = 1;
    loop {
        var taken = sem_lookup_table(c.output_names, candidate);
        var available = taken == null;
        if sem_equal(candidate, name) == false {
            if sem_find(c.source_names, candidate, null) != null {
                available = false;
            }
        }
        if available {
            break;
        }
        suffix++;
        candidate = sem_cat(c, spelling, sem_cat(c, "_", sem_decimal(c, suffix)));
        if !sem_ok(c) { return default; }
    }
    sem_put(c, c.output_names, candidate, node);
    saved = sem_state(c, c.output_names, node);
    if !sem_ok(c) { return default; }
    saved.value = bits(void*, candidate);
    return candidate;
}

fn sem_validate_aliases(c: SemanticContext*): void {
    var registry = c.program.modules;
    if registry == null {
        return;
    }
    var root = sem_get(c.program.root);
    var count = sem_child_count(registry.scopes);
    for(var i: usize = 0; i < count; i++) {
        var scope = sem_child(registry.scopes, i);
        var imports = sem_child_count(scope);
        for(var edge: usize = 0; edge < imports; edge++) {
            var alias = sem_import_alias(scope, edge);
            if alias[0] != 0 {
                var conflict = semantic_builtin_kind(alias) != 0;
                conflict ||= sem_owned(c.types, null, alias) != null;
                foreach(var declaration in &root.items) {
                    if sem_owner(c, declaration) == scope {
                        var name = sem_member(declaration, "name");
                        if name != null {
                            if sem_equal(alias, sem_identifier(c, name)) {
                                conflict = true;
                            }
                        }
                    }
                }
                if conflict {
                    sem_fail(c, sem_child(scope, edge), sem_cat(c, "Import alias conflicts with declaration: ", alias));
                    return;
                }
            }
        }
    }
}

// Foreign declarations still denote explicit link symbols. Merge identical
// declarations (and their Tower export, if supplied) after checked signatures
// exist. Local Tower names never acquire foreign visibility from this step.
fn sem_link_functions(c: SemanticContext*): void {
    if !sem_ok(c) {
        return;
    }
    var symbols = sem_table(c);
    if !sem_ok(c) { return; }
    var i: usize = 1;
    for(; i < c.program.functions.length; i++) {
        var node = c.program.functions.data[i];
        var function = sem_get(node);
        var foreign = function.external;
        if function.exported {
            foreign = true;
        }
        if foreign {
            var name = sem_name(function);
            var entry = sem_entry(c, symbols, name, null);
            if !sem_ok(c) { return; }
            var previous = entry.value;
            var duplicate = previous != null;
            if duplicate {
                var old = sem_get(previous);
                var compatible = semantic_type_equal(&function.type, &old.type);
                compatible &&= function.parameters.length == old.parameters.length;
                var p: usize = 0;
                for(; p < function.parameters.length; p++) {
                    if compatible {
                        var left = sem_get(function.parameters.data[p]);
                        var right = sem_get(old.parameters.data[p]);
                        compatible = semantic_type_equal(&left.type, &right.type);
                    }
                }
                if !compatible {
                    sem_fail(c, node, sem_cat(c, "Incompatible declarations of foreign symbol '", sem_cat(c, name, "'")));
                    return;
                }
                var definitions = old.exported;
                definitions &&= function.exported;
                if definitions {
                    sem_fail(c, node, sem_cat(c, "Duplicate foreign export '", sem_cat(c, name, "'")));
                    return;
                }
                if function.exported {
                    old.binding = node;
                    entry.value = node;
                } else {
                    function.binding = previous;
                }
            } else {
                entry.value = node;
            }
        }
    }
    i = 0;
    for(; i < c.functions.capacity; i++) {
        var entry = c.functions.entries[i];
        if entry != null {
            var node = sem_get(entry.value);
            while node.binding != null {
                entry.value = node.binding;
                node = sem_get(entry.value);
            }
        }
    }
    var count: usize = 0;
    i = 0;
    for(; i < c.program.functions.length; i++) {
        var node = c.program.functions.data[i];
        var value = sem_get(node);
        if value.binding == null {
            value.index = count;
            c.program.functions.data[count] = node;
            count++;
        }
    }
    c.program.functions.length = count;
    var root = sem_get(c.program.root);
    count = 0;
    i = 0;
    for(; i < root.items.length; i++) {
        var node = root.items.data[i];
        var value = sem_get(node);
        var duplicate = value != null;
        duplicate &&= value.kind == KFunction;
        duplicate &&= value.binding != null;
        if !duplicate {
            root.items.data[count] = node;
            count++;
        }
    }
    root.items.length = count;
    // Inference/decltype can check a call before all foreign signatures have
    // resolved. Retarget those existing shared call components after merging.
    var pending = sem_list(c);
    if !sem_ok(c) { return; }
    if !sem_push_checked(c, pending, c.program.root) { return; }
    while pending.length != 0 {
        pending.length--;
        var node = pending.data[pending.length];
        var value = sem_get(node);
        if value != null && value.kind == KCall && value.binding != null {
            var function = sem_get(value.binding);
            while function.binding != null {
                value.binding = function.binding;
                function = sem_get(value.binding);
            }
        }
        var child: usize = 0;
        while child < sem_child_count(node) { sem_push_checked(c, pending, sem_child(node, child)); child++; }
    }
}
