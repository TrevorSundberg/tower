import tower;
import semantic_context;
import semantic_support;
import semantic_statements;
import semantic_types;
import semantic_expressions;
import semantic_known_bindings;
import semantic_control;
import compiler_kernel;
import semantic_work_ids;
import foundation_tags;
import .library.work_graph;
import .library.stack;
import .library.vector;

extern fn entity_view_open(anchor: void*): void*;
extern fn entity_view_close(view: void*): void;

// Discovery owns these derived facts until its joined query publishes them on
// the original declaration entities. No values or types are evaluated here.
struct SemanticBindingProof {
    subject: void*;
    owner: void*;
    query: usize;
    immutable: bool;
}

struct SemanticBindingScan {
    proofs: vector(SemanticBindingProof);
    writes: vector(void*);
    complete: bool;
}

struct SemanticBindingWork {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    context: SemanticContext*;
    subject: void*;
    scan: SemanticBindingScan;
}

// Most bodies never use local values in their types. Admit a lexical proof only
// when a required staged expression refers to local storage, rather than adding
// another traversal and per-local metadata to every compilation.
fn sem_binding_needed(c: SemanticContext*, expression: void*): bool {
    var pending: vector(void*) = default;
    defer vector_dispose(&pending);
    var seen = sem_table(c);
    sem_push(&pending, expression);
    while pending.length != 0 {
        var subject = pending.data[--pending.length];
        var entry = sem_state(c, seen, subject);
        if entry.number != 0 { continue; }
        entry.number = 1;
        var node = sem_get(subject);
        if node == null { continue; }
        if node.kind == KOperand && !node.constant && node.binding != null {
            var binding = sem_get(node.binding);
            if binding.kind == KDeclare && !binding.global { return true; }
        }
        sem_known_capture_edges(c, &pending, subject, node);
    }
    return false;
}

fn sem_binding_request(c: SemanticContext*, function: void*): usize {
    var query = work_find(&c.queries, function, convert(u32, SemanticQuery.BindingProof), 0);
    if query != 0 { return query; }
    if c.binding_work == null {
        c.binding_work = sem_create(c.program.root);
        sem_require(entity_register(c.binding_work, sizeof(SemanticBindingWork), alignof(SemanticBindingWork), 0));
    }
    var job = bits(SemanticBindingWork*, entity_component_data(entity_component_add(function, c.binding_work)));
    sem_require(job != null);
    *job = default;
    job.subject = function;
    job.kernel.kind = CompilerKernelKind.BindingProof;
    job.kernel.payload = bits(void*, job);
    query = work_request(&c.queries, function, convert(u32, SemanticQuery.BindingProof), 0);
    var domain = convert(u64, SemanticWorkDomain.Compiler);
    sem_require(work_access(&c.queries, query, domain, convert(u64, SemanticAccess.Discovery), 0, ~convert(usize, 0), WorkAccessMode.Read));
    sem_require(work_access(&c.queries, query, domain, convert(u64, SemanticAccess.KnownBinding), query, 1, WorkAccessMode.Write));
    sem_require(work_seal(&c.queries, query));
    return query;
}

fn semantic_binding_kernel(job: SemanticBindingWork*): void {
    var context = *job.context;
    var program = *context.program;
    context.program = &program;
    program.error = default;
    context.query_reads = null;
    context.allocations = default;
    context.lists = default;
    context.token_text = default;
    context.scan = default;
    context.editor = null;
    sem_binding_scan(&context, job.subject, &job.scan);
    if !sem_ok(&context) {
        foreach(var &proof in &job.scan.proofs) { proof.immutable = false; }
    }
    vector_dispose(&program.error);
    stack_dispose(&context.scan);
    vector_dispose(&context.token_text);
    foreach(var list in &context.lists) { vector_dispose(bits(vector(void*)*, list)); }
    vector_dispose(&context.lists);
    foreach(var allocation in &context.allocations) { free(allocation); }
    vector_dispose(&context.allocations);
}

fn sem_binding_pump(c: SemanticContext*): usize {
    if !sem_ok(c) || c.binding_work == null { return 0; }
    if c.workers.count == 0 { sem_require(sem_workers_open(c)); }
    var ready: vector(SemanticBindingWork*) = default;
    defer vector_dispose(&ready);
    var ticket: WorkTicket = default;
    while ready.length < SemanticPreparationWindow
        && work_take_query(&c.queries, &ticket, convert(u32, SemanticQuery.BindingProof)) {
        var subject = work_task(&c.queries, ticket.task).subject;
        var job = bits(SemanticBindingWork*, entity_component_data(entity_component_get(subject, c.binding_work)));
        job.ticket = ticket;
        sem_require(vector_push(&ready, job));
    }
    if ready.length == 0 { return 0; }
    var context = *c;
    var view = entity_view_open(c.program.root);
    sem_require(view != null);
    foreach(var job in &ready) { job.context = &context; }
    sem_require(compiler_kernel_dispatch(&c.workers, ready.data, ready.length));
    entity_view_close(view);
    foreach(var job in &ready) {
        sem_binding_publish(c, &job.scan, job.ticket.task);
        sem_require(work_finish(&c.queries, &job.ticket, true));
        job.context = null;
    }
    return ready.length;
}

fn sem_binding_write(c: SemanticContext*, scan: SemanticBindingScan*, place: void*): void {
    place = sem_surface_unwrap(place);
    if sem_is(place, "CoreTarget") {
        // Writing through a pointer does not write the pointer binding itself.
        if sem_child_count(place) != 1 { return; }
        place = sem_member(place, "name");
    }
    while place != null {
        var base = sem_member(place, "base");
        if base == null { break; }
        place = sem_surface_unwrap(base);
    }
    if !sem_is(place, "CoreLocation") && !sem_is(place, "Identifier") { return; }
    var binding = sem_value_binding(c, place);
    if binding != null { sem_push(&scan.writes, binding); }
}

fn sem_binding_expression(c: SemanticContext*, scan: SemanticBindingScan*, root: void*): void {
    var pending: vector(void*) = default;
    defer vector_dispose(&pending);
    sem_push(&pending, root);
    while pending.length != 0 {
        var node = pending.data[--pending.length];
        if sem_is(node, "CoreAddress") { sem_binding_write(c, scan, sem_member(node, "name")); }
        if sem_is(node, "CoreAssign") { sem_binding_write(c, scan, sem_member(node, "target")); }
        if sem_is(node, "TowerExpression") && sem_child_count(node) > 1 {
            var left = sem_member(node, "left");
            var right = sem_member(node, "right");
            if left != null || right != null {
                var operation = sem_surface_operator(c, node, left);
                if sem_equal(operation, "++") || sem_equal(operation, "--") {
                    sem_binding_write(c, scan, left ?? right);
                } else {
                    if left != null && (sem_equal(operation, "=") || sem_surface_compound(operation)) {
                        sem_binding_write(c, scan, left);
                    }
                    if left == null && sem_equal(operation, "&") { sem_binding_write(c, scan, right); }
                }
            }
        }
        // All written arms count for immutability, even when execution is lazy.
        // Only the interpreter decides which value dependencies actually run.
        for(var i: usize = 0; i < sem_child_count(node); i++) { sem_push(&pending, sem_child(node, i)); }
    }
}

fn sem_binding_declare(c: SemanticContext*, scan: SemanticBindingScan*, node: void*): void {
    var name = sem_identifier(c, sem_member(node, "name"));
    if name[0] == 0 || sem_lookup_table(c.scope.names, name) != null {
        scan.complete = false;
        return;
    }
    sem_put(c, c.scope.names, name, node);
    var initial = sem_member(node, "value");
    if initial != null && sem_known_surface(initial) {
        var proof: SemanticBindingProof = default;
        proof.subject = node;
        proof.owner = c.current;
        proof.immutable = true;
        sem_require(vector_push(&scan.proofs, proof));
    }
    // A declaration binds before its own initializer, matching ordinary checking.
    sem_binding_expression(c, scan, initial);
    sem_binding_expression(c, scan, sem_member(node, "type"));
}

fn sem_binding_statement(c: SemanticContext*, scan: SemanticBindingScan*, source: void*, depth: u32): void {
    if source == null { return; }
    if depth >= ControlBlockNestingLimit { scan.complete = false; return; }
    var node = sem_is(source, "Statement") ? sem_unwrap(source) : source;
    if sem_is(node, "CoreBlock") {
        var previous = c.scope;
        c.scope = sem_scope(c, previous);
        defer { c.scope = previous; }
        for(var i: usize = 0; i < sem_child_count(node); i++) {
            var child = sem_child(node, i);
            if sem_is(child, "Statement") { sem_binding_statement(c, scan, child, depth + 1); }
        }
        return;
    }
    if sem_is(node, "CoreDeclare") { sem_binding_declare(c, scan, node); return; }
    if sem_is(node, "CoreIf") || sem_is(node, "TowerWhile") || sem_is(node, "CoreLoop") {
        sem_binding_expression(c, scan, sem_member(node, "condition"));
        sem_binding_statement(c, scan, sem_member(node, "body"), depth + 1);
        sem_binding_statement(c, scan, sem_member(node, "otherwise"), depth + 1);
        return;
    }
    if sem_is(node, "TowerDefer") {
        sem_binding_statement(c, scan, sem_member(node, "body"), depth + 1);
        return;
    }
    if sem_is(node, "TowerFor") {
        var previous = c.scope;
        c.scope = sem_scope(c, previous);
        defer { c.scope = previous; }
        var initial = sem_member(node, "initial");
        if sem_child_count(initial) == 1 {
            initial = sem_child(initial, 0);
            if sem_is(initial, "CoreDeclare") { sem_binding_declare(c, scan, initial); }
            else { sem_binding_expression(c, scan, initial); }
        } else { scan.complete = false; }
        sem_binding_expression(c, scan, sem_member(node, "condition"));
        sem_binding_expression(c, scan, sem_member(node, "step"));
        sem_binding_statement(c, scan, sem_member(node, "body"), depth + 1);
        return;
    }
    if sem_is(node, "TowerForeach") {
        sem_binding_expression(c, scan, sem_member(node, "source"));
        var previous = c.scope;
        c.scope = sem_scope(c, previous);
        defer { c.scope = previous; }
        // The generated iteration local does not exist yet. This syntax entity
        // is only a shadow marker, never a candidate or a published binding.
        sem_put(c, c.scope.names, sem_identifier(c, sem_member(node, "name")), node);
        sem_binding_statement(c, scan, sem_member(node, "body"), depth + 1);
        return;
    }
    if sem_is(node, "TowerMatch") {
        sem_binding_expression(c, scan, sem_member(node, "value"));
        var arms = sem_collect(c, sem_member(node, "arms"), "TowerMatchArm");
        foreach(var arm in arms) {
            sem_binding_expression(c, scan, sem_member(arm, "patterns"));
            sem_binding_statement(c, scan, sem_member(arm, "body"), depth + 1);
        }
        sem_binding_statement(c, scan, sem_member(sem_member(node, "fallback"), "body"), depth + 1);
        return;
    }
    if sem_is(node, "CoreAssign") || sem_is(node, "TowerExpressionStatement")
        || sem_is(node, "CoreCallStatement") || sem_is(node, "CoreReturn")
        || sem_is(node, "CoreBreak") || sem_is(node, "CoreContinue") {
        sem_binding_expression(c, scan, node);
        return;
    }
    // Extensions with additional binding/effect rules need an explicit contract.
    scan.complete = false;
}

fn sem_binding_scan(c: SemanticContext*, function: void*, scan: SemanticBindingScan*): void {
    scan.complete = true;
    var previous_scope = c.scope;
    var previous_current = c.current;
    c.scope = sem_scope(c, null);
    c.current = function;
    defer { c.scope = previous_scope; c.current = previous_current; }
    var parameters = sem_collect(c, sem_member(function, "params"), "CoreParameter");
    foreach(var parameter in parameters) {
        sem_put(c, c.scope.names, sem_identifier(c, sem_member(parameter, "name")), parameter);
    }
    sem_binding_statement(c, scan, sem_member(function, "body"), 0);
    var writes = sem_table(c);
    foreach(var subject in &scan.writes) { sem_state(c, writes, subject).number = 1; }
    foreach(var &proof in &scan.proofs) {
        proof.immutable = scan.complete && sem_state(c, writes, proof.subject).number == 0;
    }
    vector_dispose(&scan.writes);
}

fn sem_binding_publish(c: SemanticContext*, scan: SemanticBindingScan*, query: usize): void {
    if scan.proofs.length == 0 { return; }
    if c.binding_proofs == null {
        c.binding_proofs = sem_create(c.program.root);
        sem_require(entity_register(c.binding_proofs, sizeof(SemanticBindingProof), alignof(SemanticBindingProof), 0));
    }
    foreach(var &proof in &scan.proofs) {
        var target = bits(SemanticBindingProof*, entity_component_data(entity_component_add(proof.subject, c.binding_proofs)));
        sem_require(target != null);
        *target = *proof;
        target.query = query;
    }
    vector_dispose(&scan.proofs);
}
