import tower;
import format_storage;
import type_primitives;
import format_grammar;
import format_types;
import format;
import foundation_tags;
import foundation_types;
import syntax_reader;
import regex_lowering;
import .library.vector;

// Native bridges only query existing operation/type definitions.
// Query the shared semantic definitions directly; no native formatting policy.
extern fn semantic_builtin_name(kind: u32): u8*;

extern fn semantic_operator(op: u32): u8*;

extern fn semantic_scalar_name(scalar: u32): u8*;

extern fn semantic_enum(t: FoundationType*): bool;

extern fn semantic_integer(t: FoundationType*): bool;

extern fn semantic_signed(t: FoundationType*): bool;

extern fn semantic_mask(t: FoundationType*): u64;

fn format_is_Program(n: FoundationNode*): bool {
    var selected = n.kind == KProgram;
    return selected;
}

fn format_is_Function(n: FoundationNode*): bool {
    var selected = n.kind == KFunction;
    return selected;
}

fn format_is_Parameter(n: FoundationNode*): bool {
    var selected = n.kind == KParameter;
    return selected;
}

fn format_is_Declare(n: FoundationNode*): bool {
    var selected = n.kind == KDeclare;
    return selected;
}

fn format_is_Assign(n: FoundationNode*): bool {
    var selected = n.kind == KAssign;
    return selected;
}

fn format_is_Operand(n: FoundationNode*): bool {
    var selected = n.kind == KOperand;
    return selected;
}

fn format_is_Binary(n: FoundationNode*): bool {
    var selected = n.kind == KBinary;
    return selected;
}

fn format_is_Address(n: FoundationNode*): bool {
    var selected = n.kind == KAddress;
    return selected;
}

fn format_is_Load(n: FoundationNode*): bool {
    var selected = n.kind == KLoad;
    return selected;
}

fn format_is_Convert(n: FoundationNode*): bool {
    var selected = n.kind == KConvert;
    return selected;
}

fn format_is_Bits(n: FoundationNode*): bool {
    var selected = n.kind == KBits;
    return selected;
}

fn format_is_Call(n: FoundationNode*): bool {
    var selected = n.kind == KCall;
    return selected;
}

fn format_is_Block(n: FoundationNode*): bool {
    var selected = n.kind == KBlock;
    return selected;
}

fn format_is_If(n: FoundationNode*): bool {
    var selected = n.kind == KIf;
    return selected;
}

fn format_is_Loop(n: FoundationNode*): bool {
    var selected = n.kind == KLoop;
    return selected;
}

fn format_is_Break(n: FoundationNode*): bool {
    var selected = n.kind == KBreak;
    return selected;
}

fn format_is_Continue(n: FoundationNode*): bool {
    var selected = n.kind == KContinue;
    return selected;
}

fn format_is_Print(n: FoundationNode*): bool {
    var selected = n.kind == KPrint;
    return selected;
}

fn format_is_Return(n: FoundationNode*): bool {
    var selected = n.kind == KReturn;
    return selected;
}

fn format_is_Type(n: FoundationNode*): bool {
    var selected = n.kind == KType;
    return selected;
}

fn format_is_FieldDeclaration(n: FoundationNode*): bool {
    var selected = n.kind == KFieldDeclaration;
    return selected;
}

fn format_is_Field(n: FoundationNode*): bool {
    var selected = n.kind == KField;
    return selected;
}

fn format_is_Index(n: FoundationNode*): bool {
    var selected = n.kind == KIndex;
    return selected;
}

fn format_is_String(n: FoundationNode*): bool {
    var selected = n.kind == KString;
    return selected;
}

fn format_is_SizeOf(n: FoundationNode*): bool {
    var selected = n.kind == KSizeOf;
    return selected;
}

fn format_is_AlignOf(n: FoundationNode*): bool {
    var selected = n.kind == KAlignOf;
    return selected;
}

fn format_is_Allocate(n: FoundationNode*): bool {
    var selected = n.kind == KAllocate;
    return selected;
}

fn format_is_Reallocate(n: FoundationNode*): bool {
    var selected = n.kind == KReallocate;
    return selected;
}

fn format_is_Free(n: FoundationNode*): bool {
    var selected = n.kind == KFree;
    return selected;
