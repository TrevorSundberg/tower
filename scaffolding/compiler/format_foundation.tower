fn format_is_Copy(n: FoundationNode*): bool {
    var selected = n.kind == KCopy;
    return selected;
}

fn format_is_Fill(n: FoundationNode*): bool {
    var selected = n.kind == KFill;
    return selected;
}

fn format_builtin(n: FoundationNode*): u8* {
    return semantic_builtin_name(n.kind);
}

fn format_operator(n: FoundationNode*): u8* {
    return semantic_operator(n.op);
}

fn format_array(t: FoundationType*): bool {
    var selected = t.scalar == SArray;
    return selected;
}

fn format_record(t: FoundationType*): bool {
    var selected = t.scalar == SStruct;
    if semantic_enum(t) {
        selected = true;
    }
    return selected;
}

fn format_boolean(t: FoundationType*): bool {
    var selected = t.scalar == SBool;
    return selected;
}

fn format_signed(t: FoundationType*): bool {
    return semantic_signed(t);
}

fn format_mask(t: FoundationType*): u64 {
    return semantic_mask(t);
}

fn format_sign(t: FoundationType*): u64 {
    var sign = semantic_mask(t) / 2;
    sign++;
    return sign;
}

fn format_semantic_name(f: FormatEngine*, entity: void*, fallback: vector(u8)*): void {
    // Display summaries may use a declaration's original spelling. Canonical
    // Foundation always retains its unique resolved name, with the same
    // identifier escaping engine in both modes. Specializations retain their
    // concrete generated names rather than displaying an unbound template name.
    if f.source_names {
        var node = entity_child_at(entity, entity_member_index(entity, "name"));
        while node != null {
            var parsed = format_match(f, node);
            var terminal = parsed != null;
            if terminal {
                var invalid: usize = 0;
                invalid--;
                terminal = parsed.rule == invalid;
            }
            if terminal {
                var original: FormatResult = default;
                format_storage_child(&original, f.result);
                format_storage_append(&original, parsed.label.data, parsed.label.length);
                format_storage_fail(f.result, format_storage_error(&original));
                if !original.failed {
                    original.text.length = syntax_identifier_decode_in_place(original.text.data, original.text.length);
                    var same = original.text.length < fallback.length;
                    for(var i: usize = 0; i < original.text.length; i++) {
                        same &&= original.text.data[i] == fallback.data[i];
                    }
                    same &&= fallback.data[original.text.length] == 64;
                    if same {
                        format_identifier(f, &original.text);
                        format_dispose(&original);
                        return;
                    }
                }
                format_dispose(&original);
                break;
            }
            if entity_child_count(node) == 1 {
                node = entity_child_at(node, 0);
            } else {
                break;
            }
        }
    }
    format_identifier(f, fallback);
}

fn format_type_binding(f: FormatEngine*, t: FoundationType*): FoundationNode* {
    if f.source_names || f.type_scope == null || t.record != null { return null; }
    var program = format_foundation(f, f.type_scope);
    for(var i: usize = 0; i < f.type_prefix; i++) {
        var declaration = format_foundation(f, program.items.data[i]);
        if declaration.kind == KType && declaration.global && declaration.type.record == null
            && declaration.type.pointers == 0 && declaration.type.scalar == t.scalar {
            return declaration;
        }
    }
    return null;
}

fn format_type(f: FormatEngine*, t: FoundationType*): void {
    // CoreType's postfix pointer form preserves the exact type without a
    // constructor call/query for every pointer layer in reconstructed code.
    // The ordinary formatter below emits its base followed by t.pointers stars.
    var binding = format_type_binding(f, t);
    if binding != null {
        format_identifier(f, &binding.name);
        format_repeat(f, 42, convert(usize, t.pointers));
        return;
    }
    if t.scalar == SFunction {
        var signature = format_foundation(f, t.record);
        format_text(f, "function(");
        format_type(f, &signature.element);
        foreach(var parameter in &signature.parameters) {
            format_text(f, ", ");
            format_type(f, &format_foundation(f, parameter).type);
        }
        format_text(f, ")");
        format_repeat(f, 42, convert(usize, t.pointers));
        return;
    }
    if format_array(t) {
        var a = format_foundation(f, t.record);
        if !f.source_names { format_text(f, "array_type("); }
        format_type(f, &a.element);
        format_text(f, f.source_names ? "[" : ", ");
        format_unsigned(f, convert(u64, a.length));
        format_text(f, f.source_names ? "]" : ")");
    } else {
        if format_record(t) {
            var record = format_foundation(f, t.record);
            format_semantic_name(f, t.record, &record.name);
        } else {
            format_text(f, f.source_names ? semantic_scalar_name(t.scalar) : type_primitive_spelling(t.scalar));
        }
    }
    format_repeat(f, 42, convert(usize, t.pointers));
}

fn format_number(f: FormatEngine*, n: FoundationNode*): void {
    if n.type.pointers == 0 && (n.type.scalar == SF32 || n.type.scalar == SF64) {
        // Preserve every bit, including signed zero and NaN payloads, without
        // depending on decimal conversion or a host floating environment.
        format_text(f, "bits(");
        format_type(f, &n.type);
        format_text(f, ", ");
        var raw = *n;
        raw.type.scalar = n.type.scalar == SF32 ? SI32 : SI64;
        format_number(f, &raw);
        format_text(f, ")");
        return;
    }
    var mask = format_mask(&n.type);
    var value = n.bits &mask;
    if format_signed(&n.type) {
        var sign = format_sign(&n.type);
        sign = value & sign;
        if sign != 0 {
            format_text(f, "-");
            var zero: u64 = 0;
            value = zero - value;
            value = value & mask;
        }
    }
    format_unsigned(f, value);
}

// In these operand positions the checker gives a bare numeral a default
// scalar. A declaration, parameter or typed peer already supplies its type.
fn format_integer_argument(f: FormatEngine*, entity: void*, literal_scalar: u32): void {
    var n = format_foundation(f, entity);
    if n.kind != KOperand || !n.constant || n.type.scalar == literal_scalar
        || n.type.record != null || !semantic_integer(&n.type) {
        format_expression(f, entity);
        return;
    }
    // convert checks its input as i32. For a full-width word use its signed
    // bit spelling. Foundation's floating bit literal accepts all 64 bits.
    var raw = *n;
    raw.type.scalar = SI32;
    var word_mask = format_mask(&raw.type);
    var mask = format_mask(&n.type);
    var representation = mask >= word_mask && (n.bits & mask) > word_mask / 2;
    format_text(f, representation ? "bits(" : "convert(");
    format_type(f, &n.type);
    format_text(f, ", ");
    if representation {
        if mask > word_mask { raw.type.scalar = SF64; }
        format_number(f, &raw);
    } else {
        format_number(f, n);
    }
    format_text(f, ")");
}

fn format_expression(f: FormatEngine*, entity: void*): void {
    var n = format_foundation(f, entity);
    if n.kind == KTypeConstruct {
        var name: u8* = null;
        var binary = false;
        match convert(TypeConstructionKind, n.op) {
            TypeConstructionKind.Integer => { name = "integer_type"; binary = true; }
            TypeConstructionKind.Floating => { name = "float_type"; }
            TypeConstructionKind.Pointer => { name = "pointer_type"; }
            TypeConstructionKind.Array => { name = "array_type"; binary = true; }
            _ => { f.result.failed = true; return; }
        }
        if n.left == null || (n.right != null) != binary {
            f.result.failed = true;
            return;
        }
        format_text(f, name);
        format_text(f, "(");
        format_integer_argument(f, n.left, SI32);
        if binary {
            format_text(f, ", ");
            format_integer_argument(f, n.right, SI32);
        }
        format_text(f, ")");
        return;
    }
    if n.kind == KMetadataValue {
        format_text(f, "init(");
        format_type(f, &n.type);
        format_text(f, ", { ");
        for(var index: usize = 0; index < n.items.length; index++) {
            if index != 0 { format_text(f, ", "); }
            var field = format_foundation(f, n.items.data[index]);
            if n.type.scalar == SArray { format_unsigned(f, convert(u64, field.index)); }
            else { format_identifier(f, &field.name); }
            format_text(f, ": ");
            format_expression(f, field.value);
        }
        format_text(f, " })");
        return;
    }
    var builtin = format_builtin(n);
    if builtin != null {
        format_text(f, builtin);
        format_text(f, "(");
        if n.kind == 33 {
            format_expression(f, n.left);
            format_text(f, ", ");
            format_expression(f, n.right);
        }
        if format_is_Print(n) {
            format_integer_argument(f, n.value, SI32);
        }
        var size = format_is_SizeOf(n);
        var align = format_is_AlignOf(n);
        if format_or(size, align) || n.kind == KTypeReference {
            format_type(f, &n.element);
        }
        var allocate = format_is_Allocate(n);
        var reallocate = format_is_Reallocate(n);
        if format_or(allocate, reallocate) {
            format_type(f, &n.element);
            format_text(f, ", ");
            if n.left != null {
                format_expression(f, n.left);
                format_text(f, ", ");
            }
            format_expression(f, n.right);
        }
        var conversion = format_is_Convert(n);
        var reinterpret = format_is_Bits(n);
        conversion = format_or(conversion, reinterpret);
        if conversion {
            format_type(f, &n.type);
            format_text(f, ", ");
            format_integer_argument(f, n.value, SI32);
        }
        if format_is_Free(n) {
            format_expression(f, n.left);
        }
        var copy = format_is_Copy(n);
        var fill = format_is_Fill(n);
        if format_or(copy, fill) {
            format_expression(f, n.left);
            format_text(f, ", ");
            format_expression(f, n.right);
            format_text(f, ", ");
            format_expression(f, n.value);
        }
        format_text(f, ")");
        return;
    }
    if format_is_Operand(n) {
        if n.constant {
            var nominal = n.type.pointers == 0;
            nominal &&= semantic_enum(&n.type);
            if nominal {
                var member = format_foundation(f, n.binding);
                var definition = format_foundation(f, n.type.record);
                format_identifier(f, &definition.name);
                format_text(f, ".");
                format_identifier(f, &member.name);
                return;
            }
            if n.type.pointers != 0 || n.type.scalar == SFunction {
                format_text(f, "null");
            }
            else {
                if format_boolean(&n.type) {
                    if n.bits != 0 {
                        format_text(f, "true");
                    }
                    else {
                        format_text(f, "false");
                    }
                } else {
                    format_number(f, n);
                }
            }
        } else {
            var binding = format_foundation(f, n.binding);
            format_identifier(f, &binding.name);
        }
        return;
    }
    if format_is_String(n) {
        format_quote(f, &n.name);
        return;
    }
    if format_is_Binary(n) {
        var left = format_foundation(f, n.left);
        var right = format_foundation(f, n.right);
        if n.op >= OEq && right.kind == KOperand && right.constant && right.type.record == null {
            format_integer_argument(f, n.left, SI32);
        } else {
            format_expression(f, n.left);
        }
        format_text(f, " ");
        format_text(f, format_operator(n));
        format_text(f, " ");
        if left.type.pointers != 0 && (n.op == OAdd || n.op == OSub) {
            format_integer_argument(f, n.right, SUSize);
        } else {
            format_expression(f, n.right);
        }
        return;
    }
    if format_is_Field(n) {
        format_expression(f, n.left);
        format_text(f, ".");
        format_identifier(f, &n.name);
        return;
    }
    if format_is_Index(n) {
        format_expression(f, n.left);
        format_text(f, "[");
        format_integer_argument(f, n.right, SUSize);
        format_text(f, "]");
        return;
    }
    if format_is_Address(n) {
        format_text(f, "&");
        format_expression(f, n.value);
        return;
    }
    if n.kind == KFunctionReference {
        format_text(f, "&");
        format_identifier(f, &format_foundation(f, n.binding).name);
        return;
    }
    if format_is_Load(n) {
        format_text(f, "*");
        format_expression(f, n.value);
        return;
    }
    if format_is_Call(n) {
        if n.value != null { format_expression(f, n.value); }
        else { format_identifier(f, &format_foundation(f, n.binding).name); }
        format_text(f, "(");
        var i: usize = 0;
        loop {
            if i == n.items.length {
                break;
            }
            if i != 0 {
                format_text(f, ", ");
            }
            format_expression(f, n.items.data[i]);
            i++;
        }
        format_text(f, ")");
        return;
    }
    f.result.failed = true;
}

fn format_block(f: FormatEngine*, entity: void*): void {
    var n = format_foundation(f, entity);
    var prefix = f.type_prefix;
    defer { f.type_prefix = prefix; }
    // Local type declarations can shadow an outer spelling. Their block keeps
    // explicit constructors; ordinary value names do not change type bindings.
    foreach(var item in &n.items) {
        var declaration = format_foundation(f, item);
        if declaration.kind == KType || declaration.kind == KDeclare && declaration.type.scalar == SType {
            f.type_prefix = 0; break;
        }
    }
    if n.items.length == 0 {
        format_text(f, "{}");
        return;
    }
    format_text(f, "{\n");
    f.result.depth++;
    var i: usize = 0;
    loop {
        if i == n.items.length {
            break;
        }
        format_statement(f, n.items.data[i]);
        i++;
    }
    f.result.depth--;
    format_indent(f);
    format_text(f, "}");
}

fn format_function_header(f: FormatEngine*, entity: void*, n: FoundationNode*): void {
    if n.external {
        format_text(f, "extern ");
    } else {
        if n.exported {
            format_text(f, "export ");
        }
    }
    format_text(f, "fn ");
    format_semantic_name(f, entity, &n.name);
    format_text(f, "(");
    var i: usize = 0;
    for(; i != n.parameters.length; i++) {
        if i != 0 {
            format_text(f, ", ");
        }
        var p = format_foundation(f, n.parameters.data[i]);
        format_identifier(f, &p.name);
        format_text(f, ": ");
        format_type(f, &p.type);
    }
    format_text(f, "): ");
    format_type(f, &n.type);
}

// A display fragment, not an alternative program serializer. All identifiers,
// types and function signatures use the canonical formatter's own rules.
export fn format_summary(result: FormatResult*, entity: void*, syntax: void*, foundation: void*, `match`: void*): void {
    var f: FormatEngine = default;
    f.source_names = true;
    f.result = result;
    f.syntax_kind = syntax;
    f.foundation_kind = foundation;
    f.match_kind = `match`;
    if format_syntax(&f, entity) != null {
        format_grammar(&f, entity);
        return;
    }
    var n = format_foundation(&f, entity);
    if n == null {
        return;
    }
    if format_is_Function(n) {
        format_function_header(&f, entity, n);
        return;
    }
    if format_is_Type(n) {
        format_type(&f, &n.type);
        return;
    }
    // A declared enum member has no access-site binding of its own. Its
    // nominal type and declaration name still have a canonical spelling.
    var member = format_is_Operand(n);
    member &&= n.constant;
    member &&= semantic_enum(&n.type);
    member &&= n.name.length != 0;
    if member {
        format_type(&f, &n.type);
        format_text(&f, ".");
        format_identifier(&f, &n.name);
        return;
    }
    var named = format_is_Declare(n);
    if named {
        format_text(&f, "var ");
    }
    if format_is_Parameter(n) {
        named = true;
    }
    if n.kind == KFieldDeclaration {
        named = true;
    }
    if named {
        format_semantic_name(&f, entity, &n.name);
        format_text(&f, ": ");
        format_type(&f, &n.type);
        return;
    }
    format_expression(&f, entity);
}

fn format_statement_body(f: FormatEngine*, entity: void*): void {
    var n = format_foundation(f, entity);
    var label = n.kind == 31;
    var jump = n.kind == 32;
    if format_or(label, jump) {
        if label {
            format_text(f, "label(");
        } else {
            format_text(f, "jump(");
        }
        format_identifier(f, &n.name);
        format_text(f, ");");
        return;
    }
    if format_is_Declare(n) {
        format_text(f, "var ");
        format_identifier(f, &n.name);
        format_text(f, ": ");
        format_type(f, &n.type);
        if n.value != null {
            format_text(f, " = ");
            format_expression(f, n.value);
        }
        format_text(f, ";");
        return;
    }
    if format_is_Assign(n) {
        format_expression(f, n.target);
        format_text(f, " = ");
        format_expression(f, n.value);
        format_text(f, ";");
        return;
    }
    if format_is_Return(n) {
        format_text(f, "return");
        if n.value != null {
            format_text(f, " ");
            format_expression(f, n.value);
        }
        format_text(f, ";");
        return;
    }
    var builtin = format_builtin(n);
    var expression = builtin != null;
    var call = format_is_Call(n);
    expression = format_or(expression, call);
    expression ||= n.kind == KTypeConstruct;
    if expression {
        format_expression(f, entity);
        format_text(f, ";");
        return;
    }
    if format_is_Break(n) {
        format_text(f, "break;");
        return;
    }
    if format_is_Continue(n) {
        format_text(f, "continue;");
        return;
    }
    if format_is_Block(n) {
        format_block(f, entity);
        return;
    }
    if format_is_Loop(n) {
        format_text(f, "loop ");
        format_block(f, n.body);
        return;
    }
    if format_is_If(n) {
        format_text(f, "if ");
        format_expression(f, n.value);
        format_text(f, " ");
        format_block(f, n.body);
        if n.otherwise != null {
            format_text(f, " else ");
            format_block(f, n.otherwise);
        }
        return;
    }
    if format_is_Function(n) {
        var prefix = f.type_prefix;
        defer { f.type_prefix = prefix; }
        foreach(var parameter in &n.parameters) {
            if format_foundation(f, parameter).type.scalar == SType { f.type_prefix = 0; break; }
        }
        format_function_header(f, entity, n);
        if n.external {
            format_text(f, ";");
        }
        else {
            format_text(f, " ");
            format_block(f, n.body);
        }
        return;
    }
    if format_is_Type(n) {
        if n.global {
            format_text(f, "var ");
            format_identifier(f, &n.name);
            format_text(f, ": type = ");
            if n.type.pointers != 0 {
                // The initializer is a value. A postfix star is legal inside
                // the constructor's type argument, including for deeper pointers.
                var pointee = n.type;
                pointee.pointers--;
                format_text(f, "pointer_type(");
                format_type(f, &pointee);
                format_text(f, ")");
            } else {
                format_type(f, &n.type);
            }
            format_text(f, ";");
            return;
        }
        if semantic_enum(&n.type) {
            format_text(f, "enum ");
            format_identifier(f, &n.name);
            format_text(f, ": ");
            format_type(f, &n.element);
            format_text(f, " {\n");
            f.result.depth++;
            foreach(var & item in &n.items) {
                var member = format_foundation(f, *item);
                format_indent(f);
                format_identifier(f, &member.name);
                format_text(f, " = ");
                format_number(f, member);
                format_text(f, ",\n");
            }
            f.result.depth--;
            format_indent(f);
            format_text(f, "}");
            return;
        }
        format_text(f, "struct ");
        format_identifier(f, &n.name);
        format_text(f, " {\n");
        f.result.depth++;
        var i: usize = 0;
        loop {
            if i == n.items.length {
                break;
            }
            var field = format_foundation(f, n.items.data[i]);
            format_indent(f);
            format_identifier(f, &field.name);
            format_text(f, ": ");
            format_type(f, &field.type);
            format_text(f, ";\n");
            i++;
        }
        f.result.depth--;
        format_indent(f);
        format_text(f, "}");
        return;
    }
    f.result.failed = true;
}

fn format_statement(f: FormatEngine*, entity: void*): void {
    var n = format_foundation(f, entity);
    format_node_comments(f, n);
    foreach(var attribute in &n.attributes) {
        format_indent(f);
        format_text(f, "[");
        format_expression(f, attribute);
        format_text(f, "]\n");
    }
    format_indent(f);
    var begin = f.result.text.length;
    format_statement_body(f, entity);
    format_span(f, begin, n.start);
    format_text(f, "\n");
}

fn format_node_comments(f: FormatEngine*, n: FoundationNode*): void {
    var i: usize = 0;
    var line = true;
    for(; i != n.comments.length; i++) {
        if line {
            format_indent(f);
        }
        var byte = n.comments.data[i];
        format_char(f, byte);
        line = byte == 10;
    }
}

fn format_node(f: FormatEngine*, entity: void*): void {
    var syntax = format_syntax(f, entity);
    if syntax != null {
        format_grammar(f, entity);
        return;
    }
    var n = format_foundation(f, entity);
    if format_is_Program(n) {
        var previous_scope = f.type_scope;
        var previous_prefix = f.type_prefix;
        f.type_scope = entity; f.type_prefix = 0;
        defer { f.type_scope = previous_scope; f.type_prefix = previous_prefix; }
        if !f.source_names { format_text(f, "import foundation_syntax;\n\n"); }
        format_node_comments(f, n);
        var previous = false;
        var i: usize = 0;
        loop {
            if i == n.items.length {
                break;
            }
            var item = n.items.data[i];
            var child = format_foundation(f, item);
            var function = format_is_Function(child);
            var type = format_is_Type(child);
            var declaration = format_or(function, type);
            var separate = format_or(previous, declaration);
            if i == 0 {
                separate = false;
            }
            if separate {
                format_newline(f, true);
            }
            format_node(f, item);
            // A declaration cannot name itself; later uses may refer to the
            // exact ordinary type binding that was just emitted.
            f.type_prefix = i + 1;
            previous = declaration;
            i++;
        }
    } else {
        format_statement(f, entity);
    }
}
