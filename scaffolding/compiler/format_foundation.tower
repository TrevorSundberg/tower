import tower;
import format_grammar;
import format_types;
import format;
import foundation_tags;
import foundation_types;
import syntax_reader;
import regex_lowering;
import .library.vector;

// Native bridges only query existing operation/type definitions.
// Query the shared semantic definitions directly; no native formatting policy.
extern fn semantic_builtin_name(kind: u32): u8*;

extern fn semantic_operator(op: u32): u8*;

extern fn semantic_scalar_name(scalar: u32): u8*;

extern fn semantic_enum(t: FoundationType*): bool;

extern fn semantic_signed(t: FoundationType*): bool;

extern fn semantic_mask(t: FoundationType*): u64;

fn format_is_Program(n: FoundationNode*): bool {
    var selected = n.kind == KProgram;
    return selected;
}

fn format_is_Function(n: FoundationNode*): bool {
    var selected = n.kind == KFunction;
    return selected;
}

fn format_is_Parameter(n: FoundationNode*): bool {
    var selected = n.kind == KParameter;
    return selected;
}

fn format_is_Declare(n: FoundationNode*): bool {
    var selected = n.kind == KDeclare;
    return selected;
}

fn format_is_Assign(n: FoundationNode*): bool {
    var selected = n.kind == KAssign;
    return selected;
}

fn format_is_Operand(n: FoundationNode*): bool {
    var selected = n.kind == KOperand;
    return selected;
}

fn format_is_Binary(n: FoundationNode*): bool {
    var selected = n.kind == KBinary;
    return selected;
}

fn format_is_Address(n: FoundationNode*): bool {
    var selected = n.kind == KAddress;
    return selected;
}

fn format_is_Load(n: FoundationNode*): bool {
    var selected = n.kind == KLoad;
    return selected;
}

fn format_is_Convert(n: FoundationNode*): bool {
    var selected = n.kind == KConvert;
    return selected;
}

