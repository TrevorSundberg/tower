import .library.testing;
import .backend.text;
import syntax_source;
import syntax_source_cases.input;

test() {
    var text = location_fixture();
    var source = syntax_source_create(".tower/foundation.tower", text, backend_length(text));
    assert(source is not null, "Create immutable source snapshot");
    defer syntax_source_release(source);

    var question_byte: usize = 20;
    assert(source.text.data[question_byte] == *"?", "Diagnostic byte selects the question mark");
    var line: usize = 0;
    var column: usize = 0;
    syntax_source_location(source, question_byte, &line, &column);
    assert(line == 2 && column == 6, "The question mark is on line 2 at scalar column 6");
}
