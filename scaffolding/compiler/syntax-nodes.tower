import tower;

// Grammar declarations augment the same entities used by syntax and foundation.
// Source entities are authoritative; lexer tables and comparison work lists are derived.
extern fn entity_retain(node: void*): usize;

struct SyntaxPattern {
    references: usize;
    table: LexerTable*;
    grammar: void*;
}

struct SyntaxNode {
    kind: u32;
    name: vector(u8);
    text: vector(u8);
    capture: vector(u8);
    style: vector(u8);
    source: SyntaxSource*;
    literal: bool;
    append: bool;
    contextual: bool;
    terminal_set: bool;
    repetition: u8;
    items: vector(void*);
    replacement: void*;
    comments: vector(vector(u8));
    start: usize;
    end: usize;
    compiled: SyntaxPattern*;
}

export fn syntax_pattern_size(): usize {
    return sizeof(SyntaxPattern);
}

export fn syntax_pattern_retain(value: SyntaxPattern*): void {
    var present = value != null;
    if present {
        value.references = value.references + 1;
    }
}

export fn syntax_pattern_release(value: SyntaxPattern*): void {
    var missing = value == null;
    if missing {
        return;
    }
    value.references = value.references - 1;
    var unused = value.references == 0;
    if unused {
        lex_table_destroy(value.table);
        var tree = value.grammar != null;
        if tree {
            entity_release(value.grammar);
        }
        free(value);
    }
}

export fn syntax_pattern_create(grammar: void*): SyntaxPattern* {
    var value = alloc(SyntaxPattern, 1);
    var failed = value == null;
    if failed {
        return null;
    }
    fill(value, 0, sizeof(SyntaxPattern));
    value.references = 1;
    value.table = lex_table_create();
    failed = value.table == null;
    if failed {
        syntax_pattern_release(value);
        return null;
    }
    var tree = grammar != null;
    if tree {
        entity_retain(grammar);
    }
    value.grammar = grammar;
    return value;
}

export fn syntax_node_size(): usize {
    return sizeof(SyntaxNode);
}

export fn syntax_node_init(value: SyntaxNode*): void {
    fill(value, 0, sizeof(SyntaxNode));
    value.start = 0;
    value.start = value.start - 1;
    value.end = value.start;
}

export fn syntax_node_source(value: SyntaxNode*, source: SyntaxSource*): void {
    syntax_source_retain(source);
    syntax_source_release(value.source);
    value.source = source;
}

export fn syntax_node_pattern(value: SyntaxNode*, pattern: SyntaxPattern*): void {
    syntax_pattern_retain(pattern);
    syntax_pattern_release(value.compiled);
    value.compiled = pattern;
}

export fn syntax_node_replacement(value: SyntaxNode*, replacement: void*): void {
    var present = replacement != null;
    if present {
        entity_retain(replacement);
    }
    present = value.replacement != null;
    if present {
        entity_release(value.replacement);
    }
    value.replacement = replacement;
}

// Copy before growing the list: text may refer to an existing comment.
// On failure retain all existing entries and dispose the temporary copy.
export fn syntax_comments_push(comments: vector(vector(u8))*, text: u8*, length: usize): bool {
    var needed = length + 1;
    var overflow = needed == 0;
    if overflow {
        return false;
    }
    var count = comments.length + 1;
    overflow = count == 0;
    if overflow {
        return false;
    }
    var snapshot: vector(u8);
    vector_init(u8, &snapshot);
    var ok = vector_reserve(u8, &snapshot, needed);
    if ok {
        var nonempty = length != 0;
        if nonempty {
            copy(snapshot.data, text, length);
        }
        snapshot.data[length] = 0;
        snapshot.length = length;
        ok = vector_reserve(vector(u8), comments, count);
    }
    if ok {
        var target = &comments.data[comments.length];
        target.data = snapshot.data;
        target.length = snapshot.length;
        target.capacity = snapshot.capacity;
        comments.length = count;
    } else {
        vector_dispose(u8, &snapshot);
    }
    return ok;
}

export fn syntax_node_dispose(value: SyntaxNode*): void {
    vector_dispose(u8, &value.name);
    vector_dispose(u8, &value.text);
    vector_dispose(u8, &value.capture);
    vector_dispose(u8, &value.style);
    vector_dispose(void*, &value.items);
    var index: usize = 0;
    loop {
        var done = index == value.comments.length;
        if done {
            break;
        }
        vector_dispose(u8, &value.comments.data[index]);
        index = index + 1;
    }
    vector_dispose(vector(u8), &value.comments);
    syntax_node_source(value, null);
    syntax_node_pattern(value, null);
    syntax_node_replacement(value, null);
}

fn syntax_text_equal(left: vector(u8)*, right: vector(u8)*): bool {
    var different = left.length != right.length;
    if different {
        return false;
    }
    var index: usize = 0;
    loop {
        var done = index == left.length;
        if done {
            return true;
        }
        different = left.data[index] != right.data[index];
        if different {
            return false;
        }
        index = index + 1;
    }
}

struct SyntaxComparison {
    left: void*;
    right: void*;
}

fn syntax_comparison_push(pending: vector(SyntaxComparison)*, left: void*, right: void*): bool {
    var count = pending.length + 1;
    var overflow = count == 0;
    if overflow {
        return false;
    }
    var ok = vector_reserve(SyntaxComparison, pending, count);
    if ok {
        pending.data[pending.length].left = left;
        pending.data[pending.length].right = right;
        pending.length = count;
    }
    return ok;
}

// 1 equal, 0 different, -1 allocation failure. Metadata and cache addresses do
// not affect parser identity. Template coordinates matter only when requested.
export fn syntax_nodes_equal(left: void*, right: void*, kind: void*, locations: bool): i32 {
    var identical = left == right;
    if identical {
        return 1;
    }
    var pending: vector(SyntaxComparison);
    vector_init(SyntaxComparison, &pending);
    var ok = syntax_comparison_push(&pending, left, right);
    var result: i32 = 1;
    loop {
        var failed = ok == false;
        if failed {
            result = -1;
            break;
        }
        var done = pending.length == 0;
        if done {
            break;
        }
        pending.length = pending.length - 1;
        left = pending.data[pending.length].left;
        right = pending.data[pending.length].right;
        var same = left == right;
        if same {
            continue;
        }
        var missing = left == null;
        if missing {
            result = 0;
            break;
        }
        missing = right == null;
        if missing {
            result = 0;
            break;
        }
        var component = entity_component_get(left, kind);
        var x = bits(SyntaxNode*, entity_component_data(component));
        component = entity_component_get(right, kind);
        var y = bits(SyntaxNode*, entity_component_data(component));
        missing = x == null;
        if missing {
            result = 0;
            break;
        }
        missing = y == null;
        if missing {
            result = 0;
            break;
        }
        same = x.kind == y.kind;
        if same {
            same = syntax_text_equal(&x.name, &y.name);
        }
        if same {
            same = syntax_text_equal(&x.text, &y.text);
        }
        if same {
            same = syntax_text_equal(&x.capture, &y.capture);
        }
        if same {
            same = syntax_text_equal(&x.style, &y.style);
        }
        if same {
            same = x.literal == y.literal;
        }
        if same {
            same = x.append == y.append;
        }
        if same {
            same = x.contextual == y.contextual;
        }
        if same {
            same = x.terminal_set == y.terminal_set;
        }
        if same {
            same = x.repetition == y.repetition;
        }
        if same {
            same = x.items.length == y.items.length;
        }
        if locations {
            var template_node = x.kind == 6;
            if template_node {
                if same {
                    same = x.start == y.start;
                }
                if same {
                    same = x.end == y.end;
                }
            }
        }
        var different = same == false;
        if different {
            result = 0;
            break;
        }
        var index: usize = 0;
        loop {
            var done_items = index == x.items.length;
            if done_items {
                break;
            }
            ok = syntax_comparison_push(&pending, x.items.data[index], y.items.data[index]);
            var failed_item = ok == false;
            if failed_item {
                break;
            }
            index = index + 1;
        }
        if ok {
            ok = syntax_comparison_push(&pending, x.replacement, y.replacement);
        }
    }
    vector_dispose(SyntaxComparison, &pending);
    return result;
}

// Temporary native ABI verification under each explicit target layout.
export fn syntax_node_offset(field: usize): usize {
    var value: SyntaxNode;
    var base = bits(usize, &value);
    var address = base;
    var selected: bool;
    selected = field == 0;
    if selected {
        address = bits(usize, &value.kind);
    }
    selected = field == 1;
    if selected {
        address = bits(usize, &value.name);
    }
    selected = field == 2;
    if selected {
        address = bits(usize, &value.text);
    }
    selected = field == 3;
    if selected {
        address = bits(usize, &value.capture);
    }
    selected = field == 4;
    if selected {
        address = bits(usize, &value.style);
    }
    selected = field == 5;
    if selected {
        address = bits(usize, &value.source);
    }
    selected = field == 6;
    if selected {
        address = bits(usize, &value.literal);
    }
    selected = field == 7;
    if selected {
        address = bits(usize, &value.append);
    }
    selected = field == 8;
    if selected {
        address = bits(usize, &value.contextual);
    }
    selected = field == 9;
    if selected {
        address = bits(usize, &value.terminal_set);
    }
    selected = field == 10;
    if selected {
        address = bits(usize, &value.repetition);
    }
    selected = field == 11;
    if selected {
        address = bits(usize, &value.items);
    }
    selected = field == 12;
    if selected {
        address = bits(usize, &value.replacement);
    }
    selected = field == 13;
    if selected {
        address = bits(usize, &value.comments);
    }
    selected = field == 14;
    if selected {
        address = bits(usize, &value.start);
    }
    selected = field == 15;
    if selected {
        address = bits(usize, &value.end);
    }
    selected = field == 16;
    if selected {
        address = bits(usize, &value.compiled);
    }
    var offset = address - base;
    return offset;
}
