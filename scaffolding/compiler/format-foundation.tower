fn format_is_Break(n: FoundationNode*): bool {
    var selected = n.kind == KBreak();
    return selected;
}

fn format_is_Continue(n: FoundationNode*): bool {
    var selected = n.kind == KContinue();
    return selected;
}

fn format_is_Print(n: FoundationNode*): bool {
    var selected = n.kind == KPrint();
    return selected;
}

fn format_is_Return(n: FoundationNode*): bool {
    var selected = n.kind == KReturn();
    return selected;
}

fn format_is_Type(n: FoundationNode*): bool {
    var selected = n.kind == KType();
    return selected;
}

