import tower;
import worker_policy;
import compiler_kernel;
import lexer_table;
import lr_analysis;
import lr_types;
import lr_work;
import parser_workers;
import .library.vector;
import .library.work_graph;
import .library.work_pool;

struct LRFirstResult {
    ranges: vector(SymbolRange);
    nullable: bool;
    changed: bool;
}

struct LRFirstTask {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    analysis: LRAnalysis*;
    frontier: usize*;
    results: LRFirstResult*;
    begin: usize;
    count: usize;
    resource_error: WorkBudgetError;
}

// Scheduling grain, not a grammar limit. Narrow waves retain the serial solver.
var LRFirstGrain: usize = 64;

// Each nonterminal owns its output. References always read the preceding
// joined snapshot, including self references and nullable cycles.
export fn compiler_lr_first_kernel(payload: void*): void {
    var task = bits(LRFirstTask*, payload);
    var value = task.analysis;
    task.resource_error = WorkBudgetError.None;
    for(var i = task.begin; i < task.begin + task.count; i++) {
        var index = task.frontier[i];
        var source = &value.nonterminals[index];
        var result = &task.results[index];
        result.ranges.length = 0;
        result.nullable = source.nullable;
        result.changed = false;
        task.resource_error = lr_reserve_result(&result.ranges, source.first.length);
        if task.resource_error != WorkBudgetError.None { return; }
        if source.first.length != 0 { copy(result.ranges.data, source.first.data, source.first.length * sizeof(SymbolRange)); }
        result.ranges.length = source.first.length;
        foreach(var production in &source.productions) {
            var rule = &value.rules[production];
            var nullable = true;
            for(var position: usize = 0; position < rule.count && nullable; position++) {
                var symbol = &value.symbols[rule.begin + position];
                if symbol.nonterminal == lr_none() {
                    task.resource_error = lr_range_insert_result(&result.ranges, symbol.first, symbol.last, &result.changed);
                    if task.resource_error != WorkBudgetError.None { return; }
                    nullable = false;
                } else {
                    if symbol.nonterminal >= value.nonterminal_count { task.resource_error = WorkBudgetError.Invalid; return; }
                    var referenced = &value.nonterminals[symbol.nonterminal];
                    task.resource_error = lr_range_merge_result(&result.ranges, &referenced.first, &result.changed);
                    if task.resource_error != WorkBudgetError.None { return; }
                    nullable = referenced.nullable;
                }
            }
            if nullable && !result.nullable { result.nullable = true; result.changed = true; }
        }
    }
}

fn lr_analysis_work_result(value: LRAnalysis*, anchor: void*, capacity: usize): WorkBudgetError {
    var nodes: void*[WorkPoolMaximumCapacity];
    var jobs: LRFirstTask*[WorkPoolMaximumCapacity];
    if value == null || anchor == null || capacity == 0
        || capacity > sizeof(decltype(jobs)) / sizeof(LRFirstTask*)
        || value.nonterminal_count > ~convert(usize, 0) / sizeof(LRFirstResult)
        || value.nonterminal_count > ~convert(usize, 0) / sizeof(vector(usize)) { return WorkBudgetError.Invalid; }
    var error = WorkBudgetError.None;
    var owner = entity_create_related_result(anchor, &error);
    if owner == null { return error; }
    defer entity_release(owner);
    var results = alloc(LRFirstResult, value.nonterminal_count);
    var dependents = alloc(vector(usize), value.nonterminal_count);
    var queued = alloc(bool, value.nonterminal_count);
    if results == null || dependents == null || queued == null {
        free(results); free(dependents); free(queued); return WorkBudgetError.Memory;
    }
    fill(results, 0, value.nonterminal_count * sizeof(LRFirstResult));
    fill(dependents, 0, value.nonterminal_count * sizeof(vector(usize)));
    defer {
        for(var i: usize = 0; i < value.nonterminal_count; i++) {
            vector_dispose(&results[i].ranges);
            vector_dispose(&dependents[i]);
        }
        free(results); free(dependents); free(queued);
    }
    // Any reference can become relevant when an earlier prefix becomes nullable.
    // Invalid references are diagnosed only if reached, just as in the serial
    // algorithm; an unreachable tail must not change analysis behavior.
    for(var i: usize = 0; i < value.rule_count; i++) {
        var rule = &value.rules[i];
        for(var j: usize = 0; j < rule.count; j++) {
            var referenced = value.symbols[rule.begin + j].nonterminal;
            if referenced < value.nonterminal_count {
                error = lr_push_result(&dependents[referenced], rule.owner);
                if error != WorkBudgetError.None { return error; }
            }
        }
    }
    var frontier: vector(usize);
    var next: vector(usize);
    vector_init(&frontier);
    vector_init(&next);
    defer { vector_dispose(&frontier); vector_dispose(&next); }
    for(var i: usize = 0; i < value.nonterminal_count; i++) {
        error = lr_push_result(&frontier, i);
        if error != WorkBudgetError.None { return error; }
    }
    var kind = lr_work_node_result(owner, &error);
    if kind == null { return error; }
    var registered = entity_register_stage_result(kind, sizeof(LRFirstTask), alignof(LRFirstTask), 0, 0);
    if registered != WorkBudgetError.None { return registered; }
    for(var i: usize = 0; i < capacity; i++) {
        nodes[i] = lr_work_node_result(owner, &error);
        if nodes[i] == null { return error; }
        var job = bits(LRFirstTask*, entity_component_data(entity_component_add_result(nodes[i], kind, &error)));
        if job == null { return error; }
        fill(job, 0, sizeof(LRFirstTask));
        job.kernel.kind = CompilerKernelKind.LRFirst;
        job.kernel.payload = bits(void*, job);
        job.analysis = value;
        job.results = results;
        jobs[i] = job;
    }
    var graph: WorkGraph;
    if !work_init_budget(&graph, 1, 0, compiler_world_work_budget(compiler_node_world(anchor))) { return lr_work_error(&graph); }
    defer work_dispose(&graph);
    var workers: ParserWorkers = default;
    defer parser_workers_close(&workers);
    while frontier.length != 0 {
        var count = frontier.length / LRFirstGrain;
        // A retained world pool may be wider than this analysis's job array.
        if count > capacity { count = capacity; }
        if count < 2 { return lr_analysis_first_result(value); }
        var admission: ParserAdmission = default;
        error = parser_admission_open_result(&admission, anchor, count);
        if error != WorkBudgetError.None { return error; }
        defer parser_admission_close(&admission, &graph);
        if admission.extra == 0 { return lr_analysis_first_result(value); }
        if workers.pool == null {
            error = parser_workers_open_result(&workers, anchor, capacity);
            if error != WorkBudgetError.None { return error; }
        }
        var pool = workers.pool;
        if count > pool.count { count = pool.count; }
        if !work_reset(&graph, graph.revision + 1, graph.profile) { return lr_work_error(&graph); }
        var position: usize = 0;
        for(var i: usize = 0; i < count; i++) {
            var job = jobs[i];
            job.frontier = frontier.data;
            job.begin = position;
            job.count = frontier.length / count + (i < frontier.length % count ? 1 : 0);
            position += job.count;
            var id = work_request(&graph, nodes[i], 1, convert(u64, job.begin));
            var ok = id != 0;
            ok &&= work_access(&graph, id, 1, 1, job.begin, job.count, WorkAccessMode.Write);
            ok &&= work_access(&graph, id, 1, 2, 0, 1, WorkAccessMode.Read);
            ok &&= work_seal(&graph, id);
            ok &&= work_demand(&graph, id);
            ok &&= work_take(&graph, &job.ticket);
            if !ok { return lr_work_error(&graph); }
        }
        var view = entity_view_open_result(owner, &error);
        if view == null { return error; }
        error = compiler_kernel_dispatch_admitted_result(pool, &jobs[0], count, admission.extra);
        entity_view_close(view);
        if error != WorkBudgetError.None { return error; }
        var ok = true;
        for(var i: usize = 0; i < count; i++) {
            if !work_finish(&graph, &jobs[i].ticket, jobs[i].resource_error == WorkBudgetError.None) { ok = false; }
        }
        if !ok { return lr_work_error(&graph); }
        // Every worker has drained. Select the first cause in frontier order,
        // never by completion order or a shared allocator diagnostic.
        for(var i: usize = 0; i < count; i++) {
            if jobs[i].resource_error != WorkBudgetError.None { return jobs[i].resource_error; }
        }
        next.length = 0;
        fill(queued, 0, value.nonterminal_count * sizeof(bool));
        foreach(var index in &frontier) {
            var result = &results[index];
            if !result.changed { continue; }
            var target = &value.nonterminals[index];
            var previous: vector(SymbolRange);
            copy(&previous, &target.first, sizeof(vector(SymbolRange)));
            copy(&target.first, &result.ranges, sizeof(vector(SymbolRange)));
            copy(&result.ranges, &previous, sizeof(vector(SymbolRange)));
            target.nullable = result.nullable;
            foreach(var dependent in &dependents[index]) {
                if !queued[dependent] {
                    error = lr_push_result(&next, dependent);
                    if error != WorkBudgetError.None { return error; }
                    queued[dependent] = true;
                }
            }
        }
        var previous: vector(usize);
        copy(&previous, &frontier, sizeof(vector(usize)));
        copy(&frontier, &next, sizeof(vector(usize)));
        copy(&next, &previous, sizeof(vector(usize)));
    }
    return WorkBudgetError.None;
}

export fn lr_analysis_compute_parallel(value: LRAnalysis*, anchor: void*): bool {
    return lr_analysis_compute_parallel_result(value, anchor) == WorkBudgetError.None;
}

export fn lr_analysis_compute_parallel_result(value: LRAnalysis*, anchor: void*): WorkBudgetError {
    if value == null { return WorkBudgetError.Invalid; }
    var capacity = compiler_worker_capacity(anchor);
    var error = WorkBudgetError.None;
    if capacity < 2 || anchor == null || value.nonterminal_count < 2 * LRFirstGrain {
        error = lr_analysis_first_result(value);
    } else {
        var useful = value.nonterminal_count / LRFirstGrain;
        if capacity > useful { capacity = useful; }
        error = lr_analysis_work_result(value, anchor, capacity);
    }
    if error == WorkBudgetError.None {
        var budget = anchor == null ? null : compiler_world_work_budget(compiler_node_world(anchor));
        error = lr_suffix_index_result(value, budget);
    }
    value.failed = error != WorkBudgetError.None;
    return error;
}
