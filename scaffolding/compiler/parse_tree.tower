import tower;
import .library.entities;
import .library.entity_types;
import .library.work_buffer;
import .library.work_buffer_types;
import .library.work_budget_types;
import .library.work_vector;
import .library.work_vector_types;

// Built with entities.tower until language imports replace build-time composition.
// A parser work arena, not an alternative AST: leaves own the shared entities.
struct ParseChild {
    entity: Entity*;
    capture: u8*;
    first: usize;
    next: usize;
}

struct ParseVisit {
    index: usize;
    capture: u8*;
}

struct ParseForest {
    first: usize;
    last: usize;
}

struct ParseForestStore {
    storage: WorkBuffer;
    budget: WorkBudget*;
    resource_error: WorkBudgetError;
    children: work_vector(ParseChild);
    pending: work_vector(ParseVisit);
    visits: usize;
}

fn parse_missing(): usize {
    var none: usize = 0;
    none--;
    return none;
}

export fn parse_forest_create(): ParseForestStore* {
    var error = WorkBudgetError.None;
    return parse_forest_create_result(null, &error);
}

// The borrowed ledger outlives this request and all of its retained indexes.
export fn parse_forest_create_result(budget: WorkBudget*, error: WorkBudgetError*): ParseForestStore* {
    var storage: WorkBuffer = default;
    *error = work_buffer_resize(&storage, budget, sizeof(ParseForestStore), 0);
    if *error != WorkBudgetError.None { return null; }
    var forest = bits(ParseForestStore*, storage.data);
    *forest = {storage: storage, budget: budget, ..default};
    return forest;
}

export fn parse_forest_resource_error(forest: ParseForestStore*): WorkBudgetError {
    return forest.resource_error;
}

export fn parse_forest_destroy(forest: ParseForestStore*): void {
    if forest == null { return; }
    foreach(var &child in &forest.children) {
        var entity = child.entity;
        if entity != null {
            entity_release(entity);
        }
    }
    work_vector_dispose(&forest.children);
    work_vector_dispose(&forest.pending);
    var storage = forest.storage;
    work_buffer_dispose(&storage);
}

export fn parse_forest_leaf(forest: ParseForestStore*, entity: Entity*, result: ParseForest*): bool {
    var index = forest.children.length;
    var child = init(ParseChild) {entity: entity, first: parse_missing(), next: parse_missing(), ..default};
    forest.resource_error = work_vector_push_result(&forest.children, forest.budget, child);
    var ok = forest.resource_error == WorkBudgetError.None;
    if ok {
        result.first = index;
        result.last = index;
    }
    return ok;
}

// Concatenate generated reductions in O(1); captures are applied lazily.
// Capture strings borrow the immutable parser table, which outlives this arena.
export fn parse_forest_join(forest: ParseForestStore*, result: ParseForest*, first: usize, last: usize, capture: u8*): bool {
    forest.resource_error = WorkBudgetError.None;
    var empty = first == parse_missing();
    if empty {
        return true;
    }
    var captured = capture != null;
    captured &&= *capture != 0;
    if captured {
        var index = forest.children.length;
        var child = init(ParseChild) {capture: capture, first: first, next: parse_missing(), ..default};
        forest.resource_error = work_vector_push_result(&forest.children, forest.budget, child);
        if forest.resource_error != WorkBudgetError.None { return false; }
        first = index;
        last = index;
    }
    empty = result.first == parse_missing();
    if empty {
        result.first = first;
    } else {
        forest.children.data[result.last].next = first;
    }
    result.last = last;
    return true;
}

fn parse_forest_visit(forest: ParseForestStore*, index: usize, capture: u8*): bool {
    if index == parse_missing() {
        return true;
    }
    var visit = init(ParseVisit) {index: index, capture: capture};
    forest.resource_error = work_vector_push_result(&forest.pending, forest.budget, visit);
    return forest.resource_error == WorkBudgetError.None;
}

// Flatten each fragment once into a real shared node; outer captures win.
export fn parse_forest_attach(forest: ParseForestStore*, parent: Entity*, first: usize): bool {
    forest.resource_error = WorkBudgetError.None;
    forest.pending.length = 0;
    var ok = parse_forest_visit(forest, first, null);
    loop {
        var failed = !ok;
        if failed {
            return false;
        }
        if forest.pending.length == 0 {
            return true;
        }
        forest.pending.length--;
        var index = forest.pending.data[forest.pending.length].index;
        var capture = forest.pending.data[forest.pending.length].capture;
        var child = &forest.children.data[index];
        forest.visits++;
        ok = parse_forest_visit(forest, child.next, capture);
        failed = !ok;
        if failed {
            return false;
        }
        if capture == null {
            capture = child.capture;
        }
        if child.entity != null {
            ok = entity_attach(child.entity, parent, capture);
            if ok {
                entity_release(child.entity);
                child.entity = null;
            }
        } else {
            ok = parse_forest_visit(forest, child.first, capture);
        }
    }
}

export fn parse_forest_take(forest: ParseForestStore*, index: usize): Entity* {
    var node = forest.children.data[index].entity;
    forest.children.data[index].entity = null;
    return node;
}

export fn parse_forest_visits(forest: ParseForestStore*): usize {
    return forest.visits;
}
