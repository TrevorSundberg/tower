import tower;
import semantic_context_types;
import compiler_kernel;
import semantic_generic_body_types;
import semantic_context;
import semantic_program_types;
import semantic_declarations;
import semantic_support;
import semantic_body_work;
import semantic_work_ids;
import .library.vector;
import .library.work_graph;
import .library.work_pool;
import .library.work_vector;
import .library.work_vector_types;
import .library.work_budget_types;

extern fn generic_body_pending(context: void*, node: void*): bool;
extern fn generic_body_limit(context: void*): usize;
extern fn generic_body_cost(context: void*, node: void*): usize;
extern fn generic_body_complete(context: void*, node: void*, copied: usize): void;
extern fn compiler_generic_body_kernel(payload: void*): void;
extern fn compiler_node_world(node: void*): void*;
extern fn entity_stage_hold(stage: void*): void;
extern fn entity_stage_discard(stage: void*): void;
extern fn entity_stage_open_result(anchor: void*, error: WorkBudgetError*): void*;
extern fn entity_view_open_result(anchor: void*, error: WorkBudgetError*): void*;
extern fn entity_stage_publish_result(stage: void*): WorkBudgetError;

fn sem_generic_body_resource(c: SemanticContext*, subject: void*, error: WorkBudgetError): void {
    var message: vector(u8) = default;
    sem_restore_resource(c, error, &message, sem_offset(c, subject));
}

// Clone work belongs to the instance, independently of function-only lexical
// state. Type constructors can use this same component and staged copy kernel.
fn sem_generic_body_work(c: SemanticContext*, subject: void*): SemanticGenericBodyWork* {
    sem_require(c.entity_stage == null);
    if c.generic_copies == null {
        c.generic_copies = sem_create(c.program.root);
        sem_require(entity_register(c.generic_copies, sizeof(SemanticGenericBodyWork), alignof(SemanticGenericBodyWork), 0));
    }
    var component = entity_component_get(subject, c.generic_copies);
    if component != null { return bits(SemanticGenericBodyWork*, entity_component_data(component)); }
    var result = bits(SemanticGenericBodyWork*, entity_component_data(entity_component_add(subject, c.generic_copies)));
    sem_require(result != null);
    *result = default;
    result.kernel.kind = CompilerKernelKind.GenericBody;
    result.kernel.payload = bits(void*, &result.request);
    result.request.context = c.generics;
    result.request.node = subject;
    result.request.budget = compiler_world_work_budget(compiler_node_world(c.program.root));
    return result;
}

fn sem_generic_body_dispose(c: SemanticContext*): void {
    if c.generic_copies == null { return; }
    for(var i: usize = 0; i < entity_query_count(c.generic_copies); i++) {
        var result = bits(SemanticGenericBodyWork*, entity_component_data(entity_query_at(c.generic_copies, i)));
        sem_require(result.request.stage == null);
        *result = default;
    }
}

export fn sem_generic_body_request(c: SemanticContext*, subject: void*, predecessor: usize): SemanticGenericBodyWork* {
    if !sem_ok(c) { return null; }
    var result = sem_generic_body_work(c, subject);
    if result.query != 0 { return result; }
    var id = work_request(&c.queries, subject, convert(u32, SemanticQuery.GenericBody), 0);
    if id == 0 || (predecessor != 0 && !work_depend(&c.queries, id, predecessor)) {
        sem_generic_body_resource(c, subject, sem_query_error(c));
        return null;
    }
    // Immutable inputs and one private output per instance. Query identity
    // keeps function and type-instance write ranges in the same namespace.
    var domain = convert(u64, SemanticWorkDomain.Compiler);
    if !work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Layout), 0, ~convert(usize, 0), WorkAccessMode.Read)
        || !work_access(&c.queries, id, domain, convert(u64, SemanticAccess.TypeIndex), 0, ~convert(usize, 0), WorkAccessMode.Read)
        || !work_access(&c.queries, id, domain, convert(u64, SemanticAccess.GenericBody), id, 1, WorkAccessMode.Write)
        || !work_seal(&c.queries, id) || !work_demand(&c.queries, id) {
        sem_generic_body_resource(c, subject, sem_query_error(c));
        return null;
    }
    result.query = id;
    return result;
}

fn sem_generic_body_dependency(c: SemanticContext*, subject: void*, id: usize): void {
    if !sem_ok(c) { return; }
    var cloned = work_find(&c.queries, subject, convert(u32, SemanticQuery.GenericBody), 0);
    if cloned != 0 && !work_depend(&c.queries, id, cloned) {
        sem_generic_body_resource(c, subject, sem_query_error(c));
    }
}

fn sem_generic_body_failure(c: SemanticContext*, subject: void*): bool {
    if c.generic_copies == null { return false; }
    var result = bits(SemanticGenericBodyWork*, entity_component_data(entity_component_get(subject, c.generic_copies)));
    if result == null { return false; }
    if result.request.storage_error != WorkBudgetError.None {
        sem_generic_body_resource(c, subject, result.request.storage_error);
        return true;
    }
    if result.error == null { return false; }
    sem_fail(c, subject, result.error);
    return true;
}

// Demand only bodies that ordinary checked calls require. Signature-only
// decltype use leaves the body descendants unmaterialized. A source window
// bounds retained work independently of the host's worker capacity.
fn sem_generic_bodies(c: SemanticContext*, next: usize): void {
    var requested = false;
    var end = next + BodyPreparationWindow;
    if end > c.program.functions.length { end = c.program.functions.length; }
    for(var i = next; i < end; i++) {
        var subject = c.program.functions.data[i];
        if !sem_body_needed(c, subject) || !generic_body_pending(c.generics, subject) { continue; }
        var signature = sem_declaration_query(c, subject);
        sem_generic_body_request(c, subject, signature);
        if !sem_ok(c) { return; }
        requested = true;
    }
    while sem_generic_copies_execute(c) {}
    if !requested { return; }
    // Cloning publishes descendants, never function entries or body demands.
    // Revisit the same stable source window for ordered failure selection.
    for(var i = next; i < end; i++) {
        if !sem_ok(c) { break; }
        var subject = c.program.functions.data[i];
        if sem_body_needed(c, subject) && generic_body_pending(c.generics, subject) {
            sem_generic_body_failure(c, subject);
        }
    }
}

// One graph-driven executor serves function and type-instance consumers. Clone
// errors stay on their receipts so the consumer selects its source diagnostic.
export fn sem_generic_copies_execute(c: SemanticContext*): bool {
    if !sem_ok(c) { return false; }
    // A busy entry owns none of the other caller's jobs, stages or graph leases.
    if c.workers.running != 0 {
        sem_generic_body_resource(c, c.program.root, WorkBudgetError.Busy);
        return false;
    }
    var budget = compiler_world_work_budget(compiler_node_world(c.program.root));
    var batch: work_vector(SemanticGenericBodyWork*) = default;
    defer {
        // Wave defers have already discarded unpublished stages and returned
        // worker grants. Only now may graph cancellation release their leases.
        if !sem_ok(c) { work_cancel(&c.queries); }
        work_vector_dispose(&batch);
    }
    var ticket: WorkTicket;
    while batch.length < SemanticPreparationWindow
        && work_take_query(&c.queries, &ticket, convert(u32, SemanticQuery.GenericBody)) {
        var result = sem_generic_body_work(c, work_task(&c.queries, ticket.task).subject);
        result.ticket = ticket;
        var admitted = work_vector_push_result(&batch, budget, result);
        if admitted != WorkBudgetError.None {
            sem_generic_body_resource(c, result.request.node, admitted);
            return false;
        }
    }
    if !work_ok(&c.queries) {
        sem_generic_body_resource(c, c.program.root, sem_query_error(c));
        return false;
    }
    for(var first: usize = 0; first < batch.length;) {
        // Retained stages share the existing clone budget. This lets idle slots
        // take the next ready body without waiting for a worker-sized group,
        // while bounding private syntax storage even with a large source window.
        var available = generic_body_limit(c.generics);
        var stop = first;
        while stop < batch.length {
            var request = &batch.data[stop].request;
            var cost = generic_body_cost(c.generics, request.node);
            if stop != first && cost > available { break; }
            request.limit = cost < available ? cost : available;
            available -= request.limit;
            stop++;
            if cost > request.limit { break; }
        }
        var reservation: WorkReservation;
        var extra: usize = 0;
        var admission = sem_workers_admit_result(c, stop - first, &reservation, &extra);
        if admission != WorkBudgetError.None {
            sem_generic_body_resource(c, batch.data[first].request.node, admission);
            return false;
        }
        // The borrowed grant survives every stage hold, publication and ticket
        // completion in this wave. Clone node limits remain independent.
        var wave_first = first;
        var wave_stop = stop;
        defer {
            for(var i = wave_first; i < wave_stop; i++) {
                var request = &batch.data[i].request;
                if request.stage != null {
                    entity_stage_discard(request.stage);
                    request.stage = null;
                }
            }
            sem_workers_release(c, &reservation);
        }
        for(var i = first; i < stop; i++) {
            var result = batch.data[i];
            var error: WorkBudgetError;
            result.request.stage = entity_stage_open_result(c.program.root, &error);
            if result.request.stage == null {
                sem_generic_body_resource(c, result.request.node, error);
                return false;
            }
        }
        var view_error: WorkBudgetError;
        var view = entity_view_open_result(c.program.root, &view_error);
        if view == null {
            sem_generic_body_resource(c, batch.data[first].request.node, view_error);
            return false;
        }
        var dispatched = compiler_kernel_dispatch_admitted_result(&c.workers, &batch.data[first], stop - first, extra);
        // Histories can have zero references pending reclamation under this pin.
        // Acquire their queued payload ownership before releasing the last view.
        for(var i = first; i < stop; i++) { entity_stage_hold(batch.data[i].request.stage); }
        entity_view_close(view);
        if dispatched != WorkBudgetError.None {
            sem_generic_body_resource(c, batch.data[first].request.node, dispatched);
            return false;
        }
        for(var i = first; i < stop; i++) {
            var result = batch.data[i];
            var request = &result.request;
            var accepted = request.success && request.copied <= generic_body_limit(c.generics);
            if accepted {
                var published = entity_stage_publish_result(request.stage);
                if published != WorkBudgetError.None {
                    sem_generic_body_resource(c, request.node, published);
                    return false;
                }
                request.stage = null;
                generic_body_complete(c.generics, request.node, request.copied);
            } else {
                entity_stage_discard(request.stage);
                result.error = "Template expansion exceeds 65536 nodes or could not allocate its work stack";
            }
            request.stage = null;
            if !work_finish(&c.queries, &result.ticket, accepted) {
                sem_generic_body_resource(c, request.node, request.storage_error != WorkBudgetError.None
                    ? request.storage_error : sem_query_error(c));
                return false;
            }
        }
        first = stop;
    }
    return batch.length != 0;
}
