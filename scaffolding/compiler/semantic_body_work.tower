var BodyQuery: u32 = convert(u32, SemanticQuery.Body);
var BodyPrepareQuery: u32 = convert(u32, SemanticQuery.BodyPrepare);
var BodyPreparationWindow: usize = 256;

// A signature can exist for an unevaluated query without demanding its body.
fn sem_body_needed(c: SemanticContext*, subject: void*): bool {
    return generic_origin(c.generics, subject) == null
    || entity_component_get(subject, c.body_demands) != null;
}

// Collect only canonical call references. Workers own the traversal scratch;
// attaching cross-function demand components belongs to publication after joins.
fn sem_body_collect(c: SemanticContext*, root: void*, calls: vector(void*)*): void {
    var pending: vector(void*);
    vector_init(&pending);
    defer vector_dispose(&pending);
    sem_push(&pending, root);
    while pending.length != 0 {
        pending.length--;
        var node = pending.data[pending.length];
        if node == null {
            continue;
        }
        var value = sem_get(node);
        if value == null || value.kind == KFunction || value.kind == KType
        || value.kind == KLabel {
            continue;
        }
        var seen = sem_state(c, c.body_seen, node);
        if seen.number != 0 {
            continue;
        }
        seen.number = 1;
        if (value.kind == KCall || value.kind == KFunctionReference) && value.binding != null {
            sem_push(calls, node);
        }
        // Traverse owned canonical operation edges, never syntax children or
        // binding/type back-references. Unevaluated decltype calls are absent.
        sem_push(&pending, value.left);
        sem_push(&pending, value.right);
        sem_push(&pending, value.value);
        sem_push(&pending, value.target);
        sem_push(&pending, value.body);
        sem_push(&pending, value.otherwise);
        foreach(var item in &value.items) {
            sem_push(&pending, item);
        }
    }
}

fn sem_body_demand(c: SemanticContext*, calls: vector(void*)*): void {
    foreach(var node in calls) {
        var callee = sem_get(node).binding;
        if entity_component_get(callee, c.body_demands) != null {
            continue;
        }
        var demand = bits(SemanticBodyDemand*, entity_component_data(entity_component_add(callee, c.body_demands)));
        sem_require(demand != null);
        demand.source = node;
    }
}

fn sem_body_calls(c: SemanticContext*, root: void*): void {
    var calls: vector(void*);
    vector_init(&calls);
    defer vector_dispose(&calls);
    sem_body_collect(c, root, &calls);
    sem_body_demand(c, &calls);
}

fn sem_body_pending(c: SemanticContext*, subject: void*): bool {
    if sem_get(subject).external || !sem_body_needed(c, subject) {
        return false;
    }
    // Completion checks only the function containing its source hole. Other
    // declarations still resolve normally, without inventing empty body work.
    if c.editor != null && !sem_editor_contains(c, subject) { return false; }
    var query = work_find(&c.queries, subject, BodyQuery, 0);
    return query == 0;
}

fn sem_body_prune(c: SemanticContext*): void {
    if !sem_ok(c) {
        return;
    }
    var count: usize = 1;
    for(var i: usize = 1; i < c.program.functions.length; i++) {
        var subject = c.program.functions.data[i];
        if !sem_body_needed(c, subject) {
            continue;
        }
        sem_get(subject).index = count;
        c.program.functions.data[count] = subject;
        count++;
    }
    c.program.functions.length = count;
    count = 0;
    foreach(var subject in &c.generated) {
        if sem_get(subject).kind == KFunction && !sem_body_needed(c, subject) {
            continue;
        }
        c.generated.data[count] = subject;
        count++;
    }
    c.generated.length = count;
}

enum SemanticBodyBlockKind: u32 {
    Lexical, IfThen, IfElse, Loop, While, For, Foreach, Defer, Match
}

struct SemanticBodyBlock {
    cursor: SemanticBlockCursor;
    subject: void*;
    kind: SemanticBodyBlockKind;
    flow: u32;
    loop_state: SemanticLoopCursor;
    iteration_state: SemanticIterationCursor;
    defer_state: SemanticDeferCursor;
    match_state: SemanticMatchCursor;
}

struct SemanticBodyBoundary {
    subject: void*;
    header: bool;
}

struct SemanticBodyWork {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    context: SemanticContext*;
    editor: SemanticEditor;
    type_observations: vector(SemanticTypeObservation);
    subject: void*;
    stage: void*;
    ordinal: usize;
    count: usize;
    surface: bool;
    has_defer: bool;
    nodes: vector(void*);
    calls: vector(void*);
    evaluations: vector(void*);
    evaluation_aliases: vector(SemanticEvaluationAlias);
    captures: vector(void*);
    flow_dependencies: vector(void*);
    error: vector(u8);
    query_reads: vector(usize);
    error_offset: usize;
    resumed: bool;
    done: bool;
    stop: void*;
    boundary: usize;
    preparation: usize;
    declaration: SemanticDeclaration*;
    initialization: SemanticDeclaration*;
    expression_header: void*;
    expression_statement: void*;
    prepared_value: void*;
    prepared_header: void*;
    prepared_statement: void*;
    iteration_plan: SemanticIterationPlan;
    iteration_resolution: SemanticIterationResolution;
    declaration_header: void*;
    declaration_loop: SemanticLoopCursor;
    for_tail: bool;
    for_initial: void*;
    boundaries: vector(SemanticBodyBoundary);
    blocks: vector(SemanticBodyBlock);
    allocations: vector(void*);
    lists: vector(void*);
    cursor: SemanticBlockCursor;
    lexical: SemanticBodyScope;
}

extern fn entity_view_open(anchor: void*): void*;

extern fn entity_view_close(view: void*): void;

// Type operands of builtins use the ordinary expression grammar. An index in
// that position constructs an array type; ordinary value indexing does not.
fn sem_body_type_structure(c: SemanticContext*, n: void*): bool {
    if n == null {
        return false;
    }
    var pending = sem_list(c);
    sem_push(pending, n);
    for(var i: usize = 0; i < pending.length; i++) {
        var node = pending.data[i];
        if sem_member(node, "index") != null || sem_member(node, "count") != null {
            return true;
        }
        for(var j: usize = 0; j < sem_child_count(node); j++) {
            sem_push(pending, sem_child(node, j));
        }
    }
    return false;
}

// Unprepared types/protocols require coordinator admission. This scan only
// admits immutable inputs; it does not check/retry operands to discover effects.
fn sem_body_tree(c: SemanticContext*, source: void*, nodes: vector(void*)*): bool {
    var first = nodes.length;
    sem_push(nodes, source);
    for(var i = first; i < nodes.length; i++) {
        var node = nodes.data[i];
        if node == null {
            return false;
        }
        // Protocol lookup can instantiate generic functions even when the loop
        // source is typed. Its preparation publishes signatures/state layout
        // before the body worker constructs the loop.
        if sem_is(node, "TowerForeach") {
            return false;
        }
        if sem_is(node, "CoreArrayCount") {
            return false;
        }
        if sem_is(node, "CoreType") &&(sem_member(node, "args") != null
        || sem_member(node, "count") != null || sem_member(node, "index") != null) {
            return false;
        }
        if sem_is(node, "CoreCall") {
            var name = sem_member(node, "name");
            var text = sem_identifier(c, name);
            var builtin = semantic_builtin_kind(text);
            if builtin == 0 {
                if sem_resolve(c, c.templates, name, text) != null
                || sem_resolve(c, c.type_functions, name, text) != null {
                    return false;
                }
            } else {
                if semantic_builtin_type_argument(builtin, 0) {
                    var args = sem_collect(c, sem_member(node, "args"), "CoreCallArgument");
                    if args.length != 0 && sem_body_type_structure(c, args.data[0]) {
                        return false;
                    }
                }
            }
        }
        for(var j: usize = 0; j < sem_child_count(node); j++) {
            sem_require(vector_push(void*, nodes, sem_child(node, j)));
        }
    }
    return true;
}

fn sem_body_boundary(result: SemanticBodyWork*, subject: void*, header: bool): void {
    sem_require(vector_reserve(&result.boundaries, result.boundaries.length + 1));
    var entry = &result.boundaries.data[result.boundaries.length++];
    entry.subject = subject;
    entry.header = header;
}

// Admission is decided from original syntax before any checking mutates nodes.
// Structural statements suspend their containing lexical/control frame, not
// its whole enclosing function. Expression-only defer remains a single leaf.
fn sem_body_sources(c: SemanticContext*, result: SemanticBodyWork*): void {
    var scope = c.scope;
    c.scope = null;
    defer {
        c.scope = scope;
    }
    var body = sem_member(result.subject, "body");
    var scan: vector(void*);
    vector_init(&scan);
    defer vector_dispose(&scan);
    var pending: vector(void*) = default;
    defer vector_dispose(&pending);
    sem_push(&pending, body);
    while pending.length != 0 {
        var source = pending.data[--pending.length];
        var node = sem_is(source, "Statement") ? sem_unwrap(source): source;
        if sem_is(node, "CoreBlock") {
            // Enter lexical blocks in their existing source/checking order.
            for(var i = sem_child_count(node); i != 0;) {
                var child = sem_child(node, --i);
                if sem_is(child, "Statement") {
                    sem_push(&pending, child);
                }
            }
        } else {
            scan.length = 0;
            if sem_is(node, "TowerMatch") {
                var arms = sem_collect(c, sem_member(node, "arms"), "TowerMatchArm");
                var fallback = sem_member(sem_member(node, "fallback"), "body");
                var resumable = sem_is(fallback, "CoreBlock");
                foreach(var arm in arms) {
                    scan.length = 0;
                    resumable &&= sem_is(sem_member(arm, "body"), "CoreBlock")
                    && sem_body_tree(c, sem_member(arm, "patterns"), &scan);
                }
                if !resumable {
                    // Unusual grammar extensions can construct types in a
                    // pattern. Keep those ordered with the preceding bodies.
                    sem_body_boundary(result, source, false);
                    continue;
                }
                scan.length = 0;
                if !sem_body_tree(c, sem_member(node, "value"), &scan) {
                    sem_body_boundary(result, source, true);
                }
                sem_push(&pending, fallback);
                for(var i = arms.length; i != 0;) {
                    sem_push(&pending, sem_member(arms.data[--i], "body"));
                }
                continue;
            }
            if sem_is(node, "TowerDefer") && sem_is(sem_member(node, "body"), "CoreBlock") {
                sem_push(&pending, sem_member(node, "body"));
                continue;
            }
            if sem_is(node, "TowerForeach") && sem_is(sem_member(node, "body"), "CoreBlock") {
                // The implicit protocol may construct generic signatures even
                // when its written source is an ordinary typed local.
                sem_body_boundary(result, source, true);
                sem_push(&pending, sem_member(node, "body"));
                continue;
            }
            // Header construction precedes either branch, but does not check
            // their statements. Resume those bodies through the same frames.
            if sem_is(node, "CoreIf") && sem_member(node, "condition") != null && sem_is(sem_member(node, "body"), "CoreBlock")
            &&(sem_member(node, "otherwise") == null || sem_is(sem_member(node, "otherwise"), "CoreBlock")) {
                if !sem_body_tree(c, sem_member(node, "condition"), &scan) {
                    sem_body_boundary(result, source, true);
                }
                var other = sem_member(node, "otherwise");
                if other != null {
                    sem_push(&pending, other);
                }
                sem_push(&pending, sem_member(node, "body"));
                continue;
            }
            var while_loop = sem_is(node, "TowerWhile");
            var for_loop = sem_is(node, "TowerFor");
            if(while_loop || for_loop) && sem_is(sem_member(node, "body"), "CoreBlock") {
                scan.length = 0;
                var ready = sem_body_tree(c, sem_member(node, "condition"), &scan);
                if for_loop {
                    scan.length = 0;
                    ready &&= sem_body_tree(c, sem_member(node, "initial"), &scan);
                    scan.length = 0;
                    ready &&= sem_body_tree(c, sem_member(node, "step"), &scan);
                }
                if !ready {
                    sem_body_boundary(result, source, true);
                }
                sem_push(&pending, sem_member(node, "body"));
                continue;
            }
            if sem_is(node, "CoreLoop") && sem_is(sem_member(node, "body"), "CoreBlock") {
                sem_push(&pending, sem_member(node, "body"));
                continue;
            }
            scan.length = 0;
            if !sem_body_tree(c, source, &scan) {
                sem_body_boundary(result, source, false);
            }
        }
    }
    sem_push(&result.nodes, result.subject);
    sem_push(&result.nodes, body);
    for(var i: usize = 1; i < result.nodes.length; i++) {
        var node = result.nodes.data[i];
        for(var j: usize = 0; j < sem_child_count(node); j++) {
            sem_push(&result.nodes, sem_child(node, j));
        }
    }
}

// Admission inspects immutable syntax and published names. Its node/boundary
// indexes belong to the existing body component; no semantic nodes are created.
fn semantic_body_sources_kernel(result: SemanticBodyWork*): void {
    var context = *result.context;
    var program = *context.program;
    context.program = &program;
    context.editor = null;
    context.allocations = default;
    context.lists = default;
    context.token_text = default;
    context.scan = default;
    context.query_reads = &result.query_reads;
    program.error = default;
    sem_body_sources(&context, result);
    result.error = program.error;
    result.error_offset = program.error_offset;
    stack_dispose(&context.scan);
    vector_dispose(&context.token_text);
    foreach(var list in &context.lists) { vector_dispose(bits(vector(void*)*, list)); }
    vector_dispose(&context.lists);
    foreach(var allocation in &context.allocations) { free(allocation); }
    vector_dispose(&context.allocations);
}

fn sem_body_sources_request(c: SemanticContext*, result: SemanticBodyWork*): usize {
    var id = work_request(&c.queries, result.subject, convert(u32, SemanticQuery.BodyDiscovery), 0);
    sem_require(id != 0);
    sem_generic_body_dependency(c, result.subject, id);
    var declaration = work_find(&c.queries, result.subject, convert(u32, SemanticQuery.Declaration), 0);
    if declaration != 0 { sem_require(work_depend(&c.queries, id, declaration)); }
    var domain = convert(u64, SemanticWorkDomain.Compiler);
    sem_require(work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Body), result.ordinal, 1, WorkAccessMode.Write));
    sem_require(work_access(&c.queries, id, domain, convert(u64, SemanticAccess.TypeIndex), 0, ~convert(usize, 0), WorkAccessMode.Read));
    sem_require(work_seal(&c.queries, id));
    return id;
}

fn sem_body_sources_execute(c: SemanticContext*, batch: SemanticBodyWork**, count: usize): void {
    if count == 0 { return; }
    var context = *c;
    var view = entity_view_open(c.program.root);
    sem_require(view != null);
    var next: usize = 0;
    while next < count || c.workers.running != 0 {
        while next < count && c.workers.running < c.workers.count {
            var result = batch[next++];
            result.context = &context;
            result.kernel.kind = CompilerKernelKind.BodyDiscovery;
            var id = work_find(&c.queries, result.subject, convert(u32, SemanticQuery.BodyDiscovery), 0);
            sem_require(work_take_task(&c.queries, &result.ticket, id));
            sem_require(work_pool_submit(&c.workers, bits(void*, &result.kernel)));
        }
        sem_require(work_pool_receive(&c.workers, true) != null);
    }
    entity_view_close(view);
    for(var i: usize = 0; i < count; i++) {
        var result = batch[i];
        sem_query_observe(c, &result.ticket, &result.query_reads);
        result.done = result.error.length != 0;
        sem_require(work_finish(&c.queries, &result.ticket, !result.done));
        result.ticket = default;
        result.context = null;
        result.kernel.kind = CompilerKernelKind.Body;
    }
}

fn sem_body_stop(result: SemanticBodyWork*): void* {
    return result.boundary < result.boundaries.length ? result.boundaries.data[result.boundary].subject: null;
}

fn sem_body_cursor(result: SemanticBodyWork*): SemanticBlockCursor* {
    return result.blocks.length == 0 ? &result.cursor: &result.blocks.data[result.blocks.length -1].cursor;
}

fn sem_body_close_block(c: SemanticContext*, result: SemanticBodyWork*): void {
    var frame = &result.blocks.data[result.blocks.length -1];
    var subject = frame.subject;
    var flow = sem_block_finish(c, &frame.cursor);
    if frame.kind == SemanticBodyBlockKind.Match {
        if sem_control_match_advance(c, &frame.match_state, flow) {
            var state = &frame.match_state;
            sem_require(sem_block_begin(c, state.body, state.depth + convert(u32, state.index) + 1, &frame.cursor));
            return;
        }
        flow = frame.match_state.flow;
    }
    if frame.kind == SemanticBodyBlockKind.Defer {
        flow = sem_defer_finish(c, subject, &frame.defer_state, flow);
    }
    if frame.kind == SemanticBodyBlockKind.Foreach {
        c.loops--;
        flow = sem_iteration_finish(c, subject, &frame.iteration_state, flow);
    }
    if frame.kind == SemanticBodyBlockKind.IfThen {
        var other = sem_get(subject).otherwise;
        if other != null && sem_ok(c) {
            frame.kind = SemanticBodyBlockKind.IfElse;
            frame.flow = flow;
            var depth = frame.cursor.depth;
            sem_require(sem_block_begin(c, other, depth, &frame.cursor));
            return;
        }
        flow = sem_if_finish(c, subject, flow, FlowNext);
    } else {
        if frame.kind == SemanticBodyBlockKind.IfElse {
            flow = sem_if_finish(c, subject, frame.flow, flow);
        } else {
            if frame.kind == SemanticBodyBlockKind.Loop {
                c.loops--;
                flow = sem_loop_finish(flow);
            } else {
                if frame.kind == SemanticBodyBlockKind.While {
                    c.loops--;
                    flow = sem_control_while_finish(c, subject, &frame.loop_state, flow);
                } else {
                    if frame.kind == SemanticBodyBlockKind.For {
                        c.loops--;
                        flow = sem_control_for_finish(c, subject, &frame.loop_state, flow);
                    }
                }
            }
        }
    }
    result.blocks.length--;
    sem_block_accept(c, sem_body_cursor(result), subject, sem_statement_complete(c, subject, flow));
}

fn sem_body_enter(c: SemanticContext*, result: SemanticBodyWork*, node: void*, prepared: SemanticLoopCursor*): bool {
    var cursor = sem_body_cursor(result);
    var lexical = node != null && sem_is(node, "CoreBlock");
    var branch = node != null && sem_is(node, "CoreIf") && sem_member(node, "condition") != null && sem_is(sem_member(node, "body"), "CoreBlock")
    &&(sem_member(node, "otherwise") == null || sem_is(sem_member(node, "otherwise"), "CoreBlock"));
    var looping = node != null && sem_is(node, "CoreLoop") && sem_is(sem_member(node, "body"), "CoreBlock");
    var while_loop = node != null && sem_is(node, "TowerWhile") && sem_is(sem_member(node, "body"), "CoreBlock");
    var for_loop = node != null && sem_is(node, "TowerFor") && sem_is(sem_member(node, "body"), "CoreBlock");
    var iteration = node != null && sem_is(node, "TowerForeach") && sem_is(sem_member(node, "body"), "CoreBlock");
    var deferred_block = node != null && sem_is(node, "TowerDefer") && sem_is(sem_member(node, "body"), "CoreBlock");
    var matching = node != null && sem_is(node, "TowerMatch");
    if !(lexical || branch || looping || while_loop || for_loop || iteration || deferred_block || matching) || cursor.depth >= ControlBlockNestingLimit {
        return false;
    }

    var depth = cursor.depth + 1;
    cursor.next++;
    // Growing the stack can move frames. Save the parent before reserve
    // and reacquire it only after finishing/popping the child.
    sem_require(vector_reserve(&result.blocks, result.blocks.length + 1));
    var frame = &result.blocks.data[result.blocks.length++];
    *frame = default;
    frame.subject = node;
    var body = node;
    if matching {
        frame.kind = SemanticBodyBlockKind.Match;
        if !sem_control_match_value(c, node, depth, &frame.match_state, result.prepared_value) {
            result.blocks.length--;
            sem_block_accept(c, sem_body_cursor(result), node, FlowNext);
            return true;
        }
        body = frame.match_state.body;
        depth++;
    }
    if branch {
        frame.kind = SemanticBodyBlockKind.IfThen;
        sem_require(sem_if_begin_value(c, node, result.prepared_value));
        body = sem_get(node).body;
    } else {
        if looping {
            frame.kind = SemanticBodyBlockKind.Loop;
            var value = sem_node(c, node, KLoop);
            value.body = sem_member(node, "body");
            body = value.body;
            c.loops++;
        }
    }
    if while_loop || for_loop || iteration || deferred_block {
        var begun = false;
        if while_loop {
            frame.kind = SemanticBodyBlockKind.While;
            begun = sem_control_while_value(c, node, &frame.loop_state, result.prepared_value);
            depth++;
        } else {
            if for_loop {
                frame.kind = SemanticBodyBlockKind.For;
                if prepared != null {
                    frame.loop_state = *prepared;
                    begun = true;
                } else { begun = sem_control_for_begin(c, node, depth, &frame.loop_state); }
                depth += 2;
            } else {
                if iteration {
                    frame.kind = SemanticBodyBlockKind.Foreach;
                    begun = sem_iteration_prepared(c, node, depth, &frame.iteration_state, result.prepared_value, &result.iteration_plan);
                    depth += 3;
                } else {
                    frame.kind = SemanticBodyBlockKind.Defer;
                    begun = sem_defer_begin(c, node, depth, &frame.defer_state);
                    depth++;
                }
            }
        }
        if !begun {
            result.blocks.length--;
            sem_block_accept(c, sem_body_cursor(result), node, FlowNext);
            return true;
        }
        body = sem_member(node, "body");
        if !deferred_block { c.loops++; }
    }
    sem_require(sem_block_begin(c, body, depth, &frame.cursor));
    return true;
}

// The work component retains lexical/control cursors across worker/preparation
// boundaries. No previously checked statement or condition is retried.
fn sem_body_run(c: SemanticContext*, result: SemanticBodyWork*): void {
    while sem_ok(c) {
        var cursor = sem_body_cursor(result);
        if cursor.next == sem_child_count(cursor.subject) {
            if result.blocks.length == 0 {
                return;
            }
            sem_body_close_block(c, result);
            continue;
        }
        var source = sem_child(cursor.subject, cursor.next);
        if source == result.stop {
            var header = sem_unwrap(source);
            if sem_is(header, "TowerFor") && result.boundaries.data[result.boundary].header {
                // Open this body's private loop scope before suspending. Its
                // initializer/type queries borrow that retained lexical state.
                sem_require(result.declaration_header == null);
                result.declaration_header = header;
                sem_control_for_scope(c, header, cursor.depth + 1, &result.declaration_loop);
            }
            return;
        }
        var node = sem_is(source, "Statement") ? sem_unwrap(source): null;
        if node == result.prepared_statement && node != null {
            // The operand query owns type construction. This worker owns the
            // statement, lexical flow and any deferred exits around that value.
            var value = result.prepared_value;
            var flow = sem_is(node, "CoreReturn") ? sem_return_statement(c, node, value)
                : sem_is(node, "TowerExpressionStatement") ? sem_expression_statement(c, node, value)
                : sem_is(node, "CoreAssign") ? sem_assignment_value(c, node, value)
                : sem_call_statement(c, node, value);
            flow = sem_statement_complete(c, node, flow);
            cursor.next++;
            sem_block_accept(c, cursor, node, flow);
            result.prepared_statement = null;
            result.prepared_value = null;
            continue;
        }
        if node == result.prepared_header && node != null {
            var prepared_loop = sem_is(node, "TowerFor") ? &result.declaration_loop : null;
            sem_require(sem_body_enter(c, result, node, prepared_loop));
            result.prepared_header = null;
            result.prepared_value = null;
            result.iteration_plan = default;
            result.declaration_header = null;
            result.declaration_loop = default;
        } else {
            if !sem_body_enter(c, result, node, null) { sem_block_step(c, cursor); }
        }
    }
}

fn sem_body_save(c: SemanticContext*, local: SemanticBodyScope*): void {
    local.current = c.current;
    local.scope = c.scope;
    local.labels = c.labels;
    local.loops = c.loops;
    local.deferred = c.deferred;
    local.deferring = c.deferring;
    local.defer_bindings = c.defer_bindings;
    local.defer_order = c.defer_order;
    local.has_defer = c.has_defer;
    local.control_names = c.control_names;
    local.control_reserved = c.control_reserved;
    local.control_prefix = c.control_prefix;
    copy(&local.flow_dependencies, &c.flow_dependencies, sizeof(vector(void*)));
}

fn sem_body_restore(c: SemanticContext*, local: SemanticBodyScope*): void {
    c.current = local.current;
    c.scope = local.scope;
    c.labels = local.labels;
    c.loops = local.loops;
    c.deferred = local.deferred;
    c.deferring = local.deferring;
    c.defer_bindings = local.defer_bindings;
    c.defer_order = local.defer_order;
    c.has_defer = local.has_defer;
    c.control_names = local.control_names;
    c.control_reserved = local.control_reserved;
    c.control_prefix = local.control_prefix;
    copy(&c.flow_dependencies, &local.flow_dependencies, sizeof(vector(void*)));
}

fn sem_body_scope_begin(c: SemanticContext*, ordinal: usize): void {
    c.control_reserved = c.control_names;
    c.control_names = null;
    c.control_prefix = sem_cat(c, "control check ", sem_cat(c, sem_decimal(c, convert(u64, ordinal)), "."));
    c.deferred = null;
    c.deferring = 0;
    c.defer_bindings = null;
    c.defer_order = null;
    c.has_defer = false;
    vector_init(&c.flow_dependencies);
}

// Structural bodies use the same query/access protocol. Ordinary body workers
// return private editor observations for publication at their stage barrier.
fn sem_body_structural_take(c: SemanticContext*, subject: void*, ordinal: usize,
query: u32, ticket: WorkTicket*): usize {
    var id = work_request(&c.queries, subject, query, 0);
    sem_require(id != 0);
    sem_generic_body_dependency(c, subject, id);
    var declaration = work_find(&c.queries, subject, convert(u32, SemanticQuery.Declaration), 0);
    if declaration != 0 { sem_require(work_depend(&c.queries, id, declaration)); }
    sem_require(work_access(&c.queries, id, 1, 7, ordinal, 1, WorkAccessMode.Write));
    sem_require(work_access(&c.queries, id, 1, 9, 0, ~convert(usize, 0), WorkAccessMode.Write));
    sem_require(work_seal(&c.queries, id) && work_demand(&c.queries, id));
    sem_require(work_take_task(&c.queries, ticket, id));
    sem_require(ticket.task == id);
    return id;
}

// Every running body has released its stage before it suspends. Suspend all
// consumers before taking any preparation: their immutable type-index claims
// would otherwise conflict with structural publication by an earlier function.
fn sem_body_suspend(c: SemanticContext*, result: SemanticBodyWork*): void {
    var id = work_request(&c.queries, result.subject, BodyPrepareQuery, convert(u64, result.boundary + 1));
    sem_require(id != 0);
    sem_require(work_access(&c.queries, id, 1, 7, result.ordinal, 1, WorkAccessMode.Write));
    sem_require(work_access(&c.queries, id, 1, 9, 0, ~convert(usize, 0), WorkAccessMode.Write));
    sem_require(work_seal(&c.queries, id));
    sem_require(work_suspend(&c.queries, &result.ticket, id));
    result.preparation = id;
}

fn sem_body_prepare(c: SemanticContext*, result: SemanticBodyWork*): void {
    var ticket: WorkTicket;
    sem_require(work_take_task(&c.queries, &ticket, result.preparation));
    var saved_reads = c.query_reads;
    c.query_reads = &result.query_reads;
    var saved: SemanticBodyScope;
    sem_body_save(c, &saved);
    sem_body_restore(c, &result.lexical);
    var cursor = sem_body_cursor(result);
    var node = sem_unwrap(sem_child(cursor.subject, cursor.next));
    // Standalone local declarations were admitted together before this loop.
    sem_require(!sem_is(node, "CoreDeclare"));
    if result.boundaries.data[result.boundary].header {
        if !sem_body_enter(c, result, node, null) {
            sem_block_step(c, cursor);
        }
    } else {
        sem_block_step(c, cursor);
    }
    result.boundary++;
    sem_body_save(c, &result.lexical);
    sem_body_restore(c, &saved);
    sem_layout_all(c);
    c.query_reads = saved_reads;
    var ok = sem_ok(c);
    if work_ticket_valid(&c.queries, &ticket) {
        sem_query_observe(c, &ticket, &result.query_reads);
        sem_require(work_finish(&c.queries, &ticket, ok));
    } else {
        sem_require(!ok && work_task(&c.queries, result.preparation).state == WorkState.Failed);
        result.query_reads.length = 0;
    }
    if !ok {
        // This failed continuation owns its newly constructed types. Continue
        // earlier bodies for diagnostic ordering without admitting those types
        // again as unrelated global work. An actual use still calls sem_layout.
        c.layout_checked = c.program.types.length;
        sem_body_hold_error(c, result);
        result.done = true;
    }
    result.preparation = 0;
}

// A for header owns its loop scope until all three parts have checked. The
// condition and discarded update use separate expression receipts; publishing
// each wave transfers lexical scratch before the next one can consume it.
enum SemanticForPart: u32 { Initial, Condition, Update }

fn sem_body_for_values(c: SemanticContext*, batch: SemanticBodyWork**, count: usize, failed: usize, part: SemanticForPart): void {
    var saved_subjects = c.declaration_subjects;
    var saved_isolated = c.declaration_isolated;
    c.declaration_subjects = sem_list(c);
    c.declaration_isolated = true;
    var update = part == SemanticForPart.Update;
    var initial = part == SemanticForPart.Initial;
    defer {
        c.declaration_subjects = saved_subjects;
        c.declaration_isolated = saved_isolated;
    }
    for (var i: usize = 0; i < count && i <= failed; i++) {
        var result = batch[i];
        if !result.for_tail || result.done { continue; }
        var header = result.declaration_header;
        var source: void* = null;
        if initial {
            if result.for_initial == null { continue; }
            source = sem_member(result.for_initial, "value");
        } else {
            var syntax = sem_member(header, update ? "step" : "condition");
            if sem_child_count(syntax) == 0 {
                if !update { result.declaration_loop.condition = sem_control_literal(c, header, 1); }
                continue;
            }
            source = sem_child(syntax, 0);
        }
        var discarded = initial || update;
        var expected_type = discarded ? null : sem_type_new(c, SBool, 0, null);
        var mode = discarded ? SemanticExpressionMode.Discard : SemanticExpressionMode.Operand;
        result.initialization = sem_expression_add(c, source, expected_type, &result.lexical, mode);
        if !initial {
            var preceding = sem_member(header, update ? "condition" : "initial");
            var predecessor = sem_child_count(preceding) == 0 ? null : sem_child(preceding, 0);
            var query = update || predecessor == null ? 0 : sem_declaration_query(c, sem_member(predecessor, "value"));
            if query == 0 { query = sem_declaration_query(c, predecessor); }
            if query != 0 { sem_require(work_depend(&c.queries, result.initialization.query, query)); }
        }
    }
    if c.declaration_subjects.length == 0 { return; }
    sem_declaration_discover(c);
    sem_require(sem_ok(c));
    for (var i: usize = 0; i < count && i <= failed; i++) {
        var result = batch[i];
        if !result.for_tail || result.done || result.initialization == null { continue; }
        var ticket: WorkTicket;
        sem_require(work_take_task(&c.queries, &ticket, result.preparation));
        sem_require(work_suspend(&c.queries, &ticket, result.initialization.query));
    }
    sem_declarations_execute(c, c.declaration_subjects);
    sem_require(sem_ok(c));
    c.layout_checked = c.program.types.length;
    for (var i: usize = 0; i < count && i <= failed; i++) {
        var result = batch[i];
        var expression = result.initialization;
        if !result.for_tail || result.done || expression == null { continue; }
        sem_declaration_report(c, expression.subject);
        if !sem_ok(c) {
            sem_body_hold_error(c, result);
            result.done = true;
            result.preparation = 0;
            result.initialization = null;
            continue;
        }
        var ticket: WorkTicket;
        sem_require(work_take_task(&c.queries, &ticket, result.preparation));
        var saved: SemanticBodyScope;
        sem_body_save(c, &saved);
        sem_body_restore(c, &expression.lexical);
        var saved_reads = c.query_reads;
        c.query_reads = &result.query_reads;
        if initial {
            var statement = result.for_initial;
            var flow = sem_expression_statement(c, statement, expression.value);
            flow = sem_statement_complete(c, statement, flow);
            sem_control_for_accept(c, result.declaration_header, statement, flow, &result.declaration_loop);
            result.for_initial = null;
        } else {
            if update {
                c.surface_expressions = true;
                result.declaration_loop.update = sem_control_node(c, result.declaration_header, SurfaceDiscard);
                sem_get(result.declaration_loop.update).value = expression.value;
            } else { result.declaration_loop.condition = expression.value; }
        }
        sem_body_save(c, &result.lexical);
        sem_body_restore(c, &saved);
        c.query_reads = saved_reads;
        sem_query_observe(c, &ticket, &result.query_reads);
        if sem_ok(c) { sem_require(work_yield(&c.queries, &ticket)); }
        else {
            sem_require(work_finish(&c.queries, &ticket, false));
            sem_body_hold_error(c, result);
            result.done = true;
            result.preparation = 0;
        }
        result.initialization = null;
    }
}

fn sem_body_for_tails(c: SemanticContext*, batch: SemanticBodyWork**, count: usize, failed: usize): void {
    sem_body_for_values(c, batch, count, failed, SemanticForPart.Initial);
    sem_body_for_values(c, batch, count, failed, SemanticForPart.Condition);
    sem_body_for_values(c, batch, count, failed, SemanticForPart.Update);
    for (var i: usize = 0; i < count && i <= failed; i++) {
        var result = batch[i];
        if !result.for_tail { continue; }
        if !result.done {
            var ticket: WorkTicket;
            sem_require(work_take_task(&c.queries, &ticket, result.preparation));
            result.prepared_header = result.declaration_header;
            result.boundary++;
            sem_query_observe(c, &ticket, &result.query_reads);
            sem_require(work_finish(&c.queries, &ticket, sem_ok(c)));
            if !sem_ok(c) { sem_body_hold_error(c, result); result.done = true; }
        }
        result.preparation = 0;
        if result.prepared_header == null {
            result.declaration_header = null;
            result.declaration_loop = default;
        }
        result.for_tail = false;
        result.for_initial = null;
    }
}

// Called only with no active preparation ticket. Retain the producer error and
// let earlier body continuations settle before choosing the visible diagnostic.
fn sem_body_preparation_failed(c: SemanticContext*, result: SemanticBodyWork*): void {
    sem_require(work_fail(&c.queries, result.preparation));
    sem_body_hold_error(c, result);
    result.done = true;
    result.preparation = 0;
    result.initialization = null;
    result.expression_header = null;
    result.expression_statement = null;
    result.iteration_plan = default;
}

// Protocol roles retain their diagnostic order. Lookup/deduction and signature
// checking admit independent bodies together; only canonical identity publication
// requires structural ownership. Preparation suspends on the same query graph.
fn sem_body_iteration_signatures(c: SemanticContext*, batch: SemanticBodyWork**, count: usize, failed: usize): void {
    for(var role_id = convert(u32, IterationRole.Begin); role_id <= convert(u32, IterationRole.End); role_id++) {
        var role = convert(IterationRole, role_id);
        var registrations = c.declaration_jobs.length;
        var active = sem_iteration_resolutions(c, batch, count, failed, role);
        if active == 0 { return; }
        if c.declaration_jobs.length != registrations { sem_declaration_discover(c); }
        sem_require(sem_ok(c));
        var pending = false;
        for(var i: usize = 0; i < count && i <= failed; i++) {
            var result = batch[i];
            if result.done || result.iteration_plan.initial == null { continue; }
            var function = *sem_iteration_slot(&result.iteration_plan, role);
            var query = sem_declaration_query(c, function);
            if query == 0 { continue; }
            var state = work_task(&c.queries, query).state;
            pending ||= state != WorkState.Succeeded && state != WorkState.Failed;
            var ticket: WorkTicket;
            sem_require(work_take_task(&c.queries, &ticket, result.preparation));
            sem_require(work_suspend_access(&c.queries, &ticket, query,
                convert(u64, SemanticWorkDomain.Compiler), convert(u64, SemanticAccess.Declaration), query, 1, WorkAccessMode.Read));
        }
        if pending { sem_declarations_execute(c, c.declaration_subjects); }
        sem_require(sem_ok(c));
        for(var i: usize = 0; i < count && i <= failed; i++) {
            var result = batch[i];
            if result.done || result.iteration_plan.initial == null { continue; }
            var function = *sem_iteration_slot(&result.iteration_plan, role);
            // Root-level or other synchronous consumers may already have
            // checked this signature before body query registration begins.
            if sem_declaration_query(c, function) != 0 { sem_declaration_report(c, function); }
            if sem_ok(c) && sem_get(function).parameters.length != IterationParameterCount {
                sem_fail(c, result.expression_header, "An iteration protocol function requires source and state pointer parameters");
            }
            if !sem_ok(c) { sem_body_preparation_failed(c, result); }
            else { result.iteration_plan.ready = role == IterationRole.End; }
        }
    }
}

// Return and discarded operands use the same expression graph as initializers.
// After the operand and type/layout dependencies complete, a body worker resumes
// statement construction and lexical flow without checking that operand again.
fn sem_body_statement_query(c: SemanticContext*, result: SemanticBodyWork*, node: void*, depth: u32): bool {
    var returned = sem_is(node, "CoreReturn");
    var discarded = sem_is(node, "TowerExpressionStatement");
    var called = sem_is(node, "CoreCallStatement");
    var assigned = sem_is(node, "CoreAssign");
    if depth >= ControlBlockNestingLimit || !returned && !discarded && !called && !assigned { return false; }
    if sem_control_call(c, node, "label") != null || sem_control_call(c, node, "jump") != null { return false; }
    var saved: SemanticBodyScope;
    sem_body_save(c, &saved);
    sem_body_restore(c, &result.lexical);
    if assigned {
        sem_shape(c, node, "target");
        if sem_ok(c) { sem_shape(c, node, "value"); }
        if sem_ok(c) { sem_shape(c, sem_member(node, "target"), "name"); }
    }
    var source = assigned ? node : returned ? sem_return_source(c, node) : sem_member(node, discarded ? "value" : "call");
    var expected_type = returned ? &sem_get(c.current).type : null;
    sem_body_restore(c, &saved);
    if !sem_ok(c) { sem_body_preparation_failed(c, result); return false; }
    if source == null { return false; }
    var mode = assigned ? SemanticExpressionMode.AssignmentTarget : returned ? SemanticExpressionMode.Initializer : discarded ? SemanticExpressionMode.Discard : SemanticExpressionMode.Value;
    result.expression_statement = node;
    result.initialization = sem_expression_add(c, source, expected_type, &result.lexical, mode);
    return true;
}

// An assignment's destination is checked before even preparing RHS signatures.
// Publish that lexical state once, then demand the value with its target type.
// Independent bodies share each frontier; no target or operand is replayed.
fn sem_body_assignment_values(c: SemanticContext*, batch: SemanticBodyWork**, count: usize, failed: usize): void {
    var values: usize = 0;
    for(var i: usize = 0; i < count && i <= failed; i++) {
        var result = batch[i];
        var target = result.initialization;
        if result.done || target == null || target.expression_mode != SemanticExpressionMode.AssignmentTarget
            || work_task(&c.queries, target.query).state != WorkState.Succeeded { continue; }
        var source = sem_member(result.expression_statement, "value");
        result.initialization = sem_expression_add(c, source, &sem_get(target.value).type, &target.lexical, SemanticExpressionMode.Value);
        sem_require(work_depend(&c.queries, result.initialization.query, target.query));
        values++;
    }
    if values == 0 { return; }
    sem_declaration_discover(c);
    sem_require(sem_ok(c));
    for(var i: usize = 0; i < count && i <= failed; i++) {
        var result = batch[i];
        if result.done || !sem_is(result.expression_statement, "CoreAssign") || result.initialization == null
            || result.initialization.expression_mode != SemanticExpressionMode.Value { continue; }
        var ticket: WorkTicket;
        sem_require(work_take_task(&c.queries, &ticket, result.preparation));
        sem_require(work_suspend(&c.queries, &ticket, result.initialization.query));
    }
    sem_declarations_execute(c, c.declaration_subjects);
    sem_require(sem_ok(c));
}

// Bind independent local roots in source order, then release every preparation
// claim before discovery/checking. Each declaration exclusively borrows its
// body's lexical descriptor until that producer and its dependencies settle.
fn sem_body_declarations(c: SemanticContext*, batch: SemanticBodyWork**, count: usize, failed: usize): void {
    var saved_subjects = c.declaration_subjects;
    var saved_isolated = c.declaration_isolated;
    c.declaration_subjects = sem_list(c);
    c.declaration_isolated = true;
    defer {
        generic_error_clear(c.generics);
        c.declaration_subjects = saved_subjects;
        c.declaration_isolated = saved_isolated;
    }
    for(var i: usize = 0; i < count && i <= failed; i++) {
        var result = batch[i];
        if result.done { continue; }
        var cursor = sem_body_cursor(result);
        var node = sem_unwrap(sem_child(cursor.subject, cursor.next));
        var header: void* = null;
        if sem_is(node, "TowerFor") && result.boundaries.data[result.boundary].header {
            header = node;
            node = sem_child(sem_member(node, "initial"), 0);
        }
        if !sem_is(node, "CoreDeclare") && header == null { continue; }
        var ticket: WorkTicket;
        sem_require(work_take_task(&c.queries, &ticket, result.preparation));
        var saved: SemanticBodyScope;
        sem_body_save(c, &saved);
        sem_body_restore(c, &result.lexical);
        sem_require(result.declaration_header == header);
        if header != null && !sem_is(node, "CoreDeclare") {
            generic_error_clear(c.generics);
            var saved_reads = c.query_reads;
            c.query_reads = &result.query_reads;
            if sem_ok(c) && !sem_is(node, ";") {
                // Explicit control calls retain statement diagnostics. Ordinary
                // expression initializers join before conditions are admitted.
                if sem_is(node, "TowerExpressionStatement") && sem_control_call(c, node, "label") == null
                    && sem_control_call(c, node, "jump") == null {
                    result.for_initial = node;
                } else {
                    var flow = sem_statement(c, node, cursor.depth + 2);
                    if sem_ok(c) { sem_control_for_accept(c, header, node, flow, &result.declaration_loop); }
                }
            }
            sem_body_save(c, &result.lexical);
            sem_layout_all(c);
            c.query_reads = saved_reads;
            sem_query_observe(c, &ticket, &result.query_reads);
            if sem_ok(c) {
                result.for_tail = true;
                sem_require(work_yield(&c.queries, &ticket));
            } else {
                sem_require(work_finish(&c.queries, &ticket, false));
                c.layout_checked = c.program.types.length;
                sem_body_hold_error(c, result);
                result.done = true;
                result.preparation = 0;
            }
            sem_body_restore(c, &saved);
            continue;
        }
        if sem_ok(c) && sem_declaration_bind(c, node) {
            var declaration = sem_declaration_state(c, node);
            declaration.scope = c.scope;
            declaration.current = c.current;
            sem_body_save(c, &declaration.lexical);
            sem_declaration_add(c, node);
            result.declaration = declaration;
            // Discovery must seal the dependency before suspension can demand
            // it. Yield now so another body's registration can take ownership.
            sem_require(work_yield(&c.queries, &ticket));
        } else {
            sem_require(work_finish(&c.queries, &ticket, false));
            sem_body_hold_error(c, result);
            result.done = true;
        }
        sem_body_restore(c, &saved);
    }
    sem_declaration_discover(c);
    sem_require(sem_ok(c));
    for(var i: usize = 0; i < count && i <= failed; i++) {
        var result = batch[i];
        if result.declaration == null { continue; }
        var ticket: WorkTicket;
        sem_require(work_take_task(&c.queries, &ticket, result.preparation));
        sem_require(work_suspend(&c.queries, &ticket, result.declaration.query));
    }
    sem_declarations_execute(c, c.declaration_subjects);
    sem_require(sem_ok(c));
    // Explicit initializer expressions are independent of their completed type
    // queries. Admit the whole body window before running their shared executor;
    // an initializer failure must not invalidate a valid declared type.
    var initializers: usize = 0;
    for(var i: usize = 0; i < count && i <= failed; i++) {
        var result = batch[i];
        var declaration = result.declaration;
        if result.done { continue; }
        if declaration == null {
            var cursor = sem_body_cursor(result);
            var header = sem_unwrap(sem_child(cursor.subject, cursor.next));
            if !result.boundaries.data[result.boundary].header {
                if sem_body_statement_query(c, result, header, cursor.depth) { initializers++; }
                continue;
            }
            if cursor.depth >= ControlBlockNestingLimit { continue; }
            var branch = sem_is(header, "CoreIf");
            var condition = branch || sem_is(header, "TowerWhile");
            var matching = sem_is(header, "TowerMatch");
            var iteration = sem_is(header, "TowerForeach");
            if !condition && !matching && !iteration { continue; }
            // Preserve the iteration checker's structural rejection order.
            if iteration && (cursor.depth + 1 > IterationSourceDepthLimit
                || result.lexical.labels != null && result.lexical.labels.count != 0) { continue; }
            result.expression_header = header;
            var source = sem_member(header, condition ? "condition" : (matching ? "value" : "source"));
            var expected_type = condition ? sem_type_new(c, SBool, 0, null) : null;
            var mode = branch || iteration ? SemanticExpressionMode.Operand : SemanticExpressionMode.Value;
            result.initialization = sem_expression_add(c, source, expected_type, &result.lexical, mode);
            initializers++;
            continue;
        }
        if work_task(&c.queries, declaration.query).state != WorkState.Succeeded { continue; }
        var node = declaration.subject;
        var value = sem_get(node);
        var source = sem_member(node, "value");
        if source == null || value.value != null { continue; }
        var saved: SemanticBodyScope;
        sem_body_save(c, &saved);
        sem_body_restore(c, &declaration.lexical);
        sem_declaration_storage(c, node);
        sem_body_restore(c, &saved);
        if !sem_ok(c) {
            sem_require(work_fail(&c.queries, result.preparation));
            sem_body_hold_error(c, result);
            result.done = true;
            result.preparation = 0;
            result.declaration = null;
            continue;
        }
        result.initialization = sem_expression_add(c, source, &value.type, &declaration.lexical, SemanticExpressionMode.Initializer);
        sem_require(work_depend(&c.queries, result.initialization.query, declaration.query));
        initializers++;
    }
    if initializers != 0 {
        sem_declaration_discover(c);
        sem_require(sem_ok(c));
        for(var i: usize = 0; i < count && i <= failed; i++) {
            var result = batch[i];
            if result.initialization == null { continue; }
            var ticket: WorkTicket;
            sem_require(work_take_task(&c.queries, &ticket, result.preparation));
            sem_require(work_suspend(&c.queries, &ticket, result.initialization.query));
        }
        sem_declarations_execute(c, c.declaration_subjects);
        sem_require(sem_ok(c));
    }
    sem_body_assignment_values(c, batch, count, failed);
    sem_body_iteration_signatures(c, batch, count, failed);
    if c.declaration_subjects.length == 0 {
        sem_body_for_tails(c, batch, count, failed);
        return;
    }
    // Every newly constructed type is now accounted for by its producer's
    // field/layout queries, including failures retained for its own consumers.
    c.layout_checked = c.program.types.length;
    c.declaration_isolated = false;
    for(var i: usize = 0; i < count && i <= failed; i++) {
        var result = batch[i];
        var declaration = result.declaration;
        if declaration == null && result.initialization == null { continue; }
        var node = declaration == null ? (result.expression_header ?? result.expression_statement) : declaration.subject;
        var ticket: WorkTicket = default;
        var producer = declaration ?? result.initialization;
        sem_declaration_report(c, producer.subject);
        if sem_ok(c) && declaration != null && result.initialization != null {
            producer = result.initialization;
            sem_declaration_report(c, producer.subject);
        }
        if sem_ok(c) { sem_require(work_take_task(&c.queries, &ticket, result.preparation)); }
        else {
            sem_declaration_capture_error(c, producer);
            sem_require(work_fail(&c.queries, producer.query));
        }
        var saved: SemanticBodyScope;
        sem_body_save(c, &saved);
        sem_body_restore(c, &producer.lexical);
        var saved_reads = c.query_reads;
        c.query_reads = &result.query_reads;
        if declaration != null && sem_ok(c) {
            generic_error_clear(c.generics);
            if result.initialization != null { sem_get(node).value = result.initialization.value; }
            sem_declaration_finish(c, node);
        }
        if result.expression_statement != null {
            if sem_ok(c) {
                result.prepared_statement = node;
                result.prepared_value = producer.value;
            }
        } else {
            if result.expression_header != null {
                if sem_ok(c) {
                    result.prepared_value = producer.value;
                    if sem_is(node, "TowerForeach") && result.iteration_plan.ready {
                        // All implicit signatures are published. Resolve state
                        // layout before handing control construction back to
                        // this body's staged worker; never replay its source.
                        if sem_iteration_storage(c, node, &result.iteration_plan) {
                            result.prepared_header = node;
                        }
                    } else {
                        if sem_is(node, "TowerForeach") {
                            // Unprepared extension paths retain structural
                            // ownership. Standard protocols always arrive ready.
                            sem_require(sem_body_enter(c, result, node, null));
                            result.prepared_value = null;
                        } else {
                            // If/while/match already run in body workers when
                            // their operands need no preparation. A completed
                            // expression receipt grants the same ownership.
                            result.prepared_header = node;
                        }
                    }
                }
            } else {
                if result.declaration_header != null {
                    var header = result.declaration_header;
                    if sem_ok(c) {
                        sem_control_for_accept(c, header, node, sem_statement_complete(c, node, FlowNext), &result.declaration_loop);
                        result.for_tail = sem_ok(c);
                    }
                } else {
                    var cursor = sem_body_cursor(result);
                    cursor.next++;
                    sem_block_accept(c, cursor, node, FlowNext);
                }
            }
        }
        if !result.for_tail { result.boundary++; }
        sem_body_save(c, &result.lexical);
        sem_body_restore(c, &saved);
        // Explicit initialization can still need structural preparation. Only
        // types created during this finalizer are new to the layout frontier.
        sem_layout_all(c);
        c.query_reads = saved_reads;
        var ok = sem_ok(c);
        if ticket.task != 0 {
            sem_query_observe(c, &ticket, &result.query_reads);
            if ok && result.for_tail { sem_require(work_yield(&c.queries, &ticket)); }
            else { sem_require(work_finish(&c.queries, &ticket, ok)); }
        } else { result.query_reads.length = 0; }
        if !ok {
            c.layout_checked = c.program.types.length;
            sem_body_hold_error(c, result);
            result.done = true;
        }
        if !result.for_tail || !ok { result.preparation = 0; }
        result.declaration = null;
        result.initialization = null;
        result.expression_header = null;
        result.expression_statement = null;
        if result.prepared_header == null { result.iteration_plan = default; }
        if !result.for_tail {
            result.declaration_header = null;
            result.declaration_loop = default;
        }
    }
    sem_body_for_tails(c, batch, count, failed);
}

fn semantic_body_kernel(result: SemanticBodyWork*): void {
    var context: SemanticContext;
    var program: SemanticProgram;
    copy(&context, result.context, sizeof(SemanticContext));
    copy(&program, context.program, sizeof(SemanticProgram));
    context.program = &program;
    sem_editor_private(&context, &result.editor);
    context.type_observations = &result.type_observations;
    context.current = result.subject;
    context.entity_stage = result.stage;
    context.query_reads = &result.query_reads;
    context.evaluation_aliases = &result.evaluation_aliases;
    context.count = 0;
    context.node_limit = result.context.count < context.node_limit
    ? context.node_limit - result.context.count: 0;
    vector_init(void*, &context.allocations);
    vector_init(void*, &context.lists);
    vector_init(void*, &context.inferring);
    vector_init(void*, &context.type_arguments);
    vector_init(void*, &context.constant_arguments);
    vector_init(void*, &context.generated);
    vector_init(void*, &context.evaluation_jobs);
    vector_init(void*, &context.flow_dependencies);
    vector_init(u8, &context.token_text);
    fill(&context.scan, 0, sizeof(stack(void*)));
    vector_init(u8, &program.error);
    // Never mutate the coordinator's derived traversal index through this copy.
    context.body_seen = null;
    if result.resumed {
        sem_body_restore(&context, &result.lexical);
    } else {
        sem_body_scope_begin(&context, result.ordinal);
        sem_require(sem_function_begin(&context, result.subject, &result.cursor));
        result.resumed = true;
    }
    sem_body_run(&context, result);
    result.done = !sem_ok(&context) ||(result.blocks.length == 0 && result.cursor.next == sem_child_count(result.cursor.subject));
    if result.done {
        // Error unwinding restores lexical scope ownership without emitting
        // deferred effects. sem_block_finish already checks sem_ok for emission.
        while result.blocks.length != 0 {
            sem_body_close_block(&context, result);
        }
        sem_function_finish(&context, result.subject, &result.cursor);
        fill(&result.lexical, 0, sizeof(SemanticBodyScope));
    } else {
        sem_body_save(&context, &result.lexical);
    }
    if result.done && sem_ok(&context) {
        context.body_seen = sem_table(&context);
        sem_body_collect(&context, sem_get(result.subject).body, &result.calls);
    }
    result.count = context.count;
    result.surface = context.surface_expressions;
    result.has_defer = context.has_defer;
    if result.done && context.defer_order != null {
        for(var i: usize = 0; i < context.defer_order.length; i++) {
            sem_push(&result.captures, context.defer_order.data[i]);
        }
    }
    copy(&result.error, &program.error, sizeof(vector(u8)));
    result.error_offset = program.error_offset;
    copy(&result.evaluations, &context.evaluation_jobs, sizeof(vector(void*)));
    if result.done {
        copy(&result.flow_dependencies, &context.flow_dependencies, sizeof(vector(void*)));
    }
    // Partial results retain lexical tables/scopes until their next dispatch.
    // Transfer ownership to the coordinator; never free scratch still borrowed
    // by the continuation, and never append to shared allocation lists here.
    if !result.done || (context.editor != null && context.editor.found) {
        copy(&result.allocations, &context.allocations, sizeof(vector(void*)));
        copy(&result.lists, &context.lists, sizeof(vector(void*)));
        vector_init(&context.allocations);
        vector_init(&context.lists);
    }
    stack_dispose(void*, &context.scan);
    vector_dispose(u8, &context.token_text);
    vector_dispose(void*, &context.inferring);
    vector_dispose(void*, &context.type_arguments);
    vector_dispose(void*, &context.constant_arguments);
    vector_dispose(void*, &context.generated);
    for(var i: usize = 0; i < context.lists.length; i++) {
        vector_dispose(void*, bits(vector(void*)*, context.lists.data[i]));
    }
    vector_dispose(void*, &context.lists);
    for(var i: usize = 0; i < context.allocations.length; i++) {
        free(context.allocations.data[i]);
    }
    vector_dispose(void*, &context.allocations);
}

fn sem_body_clear(result: SemanticBodyWork*): void {
    result.declaration = null;
    result.initialization = null;
    result.expression_header = null;
    result.expression_statement = null;
    result.prepared_value = null;
    result.prepared_header = null;
    result.prepared_statement = null;
    result.iteration_plan = default;
    result.declaration_header = null;
    result.declaration_loop = default;
    result.for_tail = false;
    result.for_initial = null;
    vector_dispose(&result.type_observations);
    result.editor = default;
    vector_dispose(&result.evaluation_aliases);
    result.context = null;
    vector_dispose(&result.nodes);
    vector_dispose(&result.boundaries);
    vector_dispose(&result.blocks);
    vector_dispose(&result.allocations);
    vector_dispose(&result.lists);
    vector_dispose(&result.calls);
    vector_dispose(&result.evaluations);
    vector_dispose(&result.captures);
    vector_dispose(&result.flow_dependencies);
    vector_dispose(&result.query_reads);
    vector_dispose(&result.error);
    vector_dispose(&result.lexical.flow_dependencies);
    fill(&result.lexical, 0, sizeof(SemanticBodyScope));
}

fn sem_body_hold_error(c: SemanticContext*, result: SemanticBodyWork*): void {
    // Preparation is source ordered, but an earlier continuation may still
    // diagnose an error. Transfer this diagnostic and drain those jobs first.
    copy(&result.error, &c.program.error, sizeof(vector(u8)));
    result.error_offset = c.program.error_offset;
    fill(&c.program.error, 0, sizeof(vector(u8)));
    c.program.error_offset = 0;
}

fn sem_body_publish(c: SemanticContext*, result: SemanticBodyWork*): void {
    // All stages in this worker batch have already published. Continuations
    // exclusively own their lexical payloads between dispatches; the compilation
    // owns their storage and reclaims it once checking completes.
    sem_query_observe(c, &result.ticket, &result.query_reads);
    sem_evaluation_aliases(c, &result.evaluation_aliases);
    sem_type_observations_publish(c, &result.type_observations);
    sem_editor_publish(c, &result.editor);
    foreach(var allocation in &result.allocations) {
        sem_push(&c.allocations, allocation);
    }
    foreach(var list in &result.lists) {
        sem_push(&c.lists, list);
    }
    vector_dispose(&result.allocations);
    vector_dispose(&result.lists);
    c.count += result.count;
    c.surface_expressions ||= result.surface;
    c.has_defer ||= result.has_defer;
    for(var j: usize = 0; j < result.captures.length; j++) {
        if c.defer_bindings == null {
            c.defer_bindings = sem_table(c);
            c.defer_order = sem_list(c);
        }
        var captured = result.captures.data[j];
        var entry = sem_state(c, c.defer_bindings, captured);
        if entry.value == null {
            entry.value = captured;
            sem_push(c.defer_order, captured);
        }
    }
    for(var j: usize = 0; j < result.evaluations.length; j++) {
        var evaluation = bits(SemanticEvaluation*, result.evaluations.data[j]);
        sem_push(&c.evaluation_jobs, bits(void*, evaluation));
        sem_evaluation_request(c, evaluation);
    }
    if result.flow_dependencies.length != 0 {
        sem_flow_request(c, result.subject, &result.flow_dependencies);
    }
    vector_dispose(&result.evaluations);
    if c.count > c.node_limit && result.error.length == 0 {
        sem_fail(c, result.subject, "Foundation component memory budget exceeded");
        sem_body_hold_error(c, result);
        result.done = true;
    }
    if result.done {
        sem_require(work_finish(&c.queries, &result.ticket, result.error.length == 0));
    }
}

// Reserve the complete independent continuation frontier before dispatch.
// Structural publication still needs a barrier, but worker-sized sub-batches
// need not idle behind one slow body. Freeze the descriptor as well as the graph:
// a worker must never copy c while the coordinator changes c.workers counters.
fn sem_body_wave(c: SemanticContext*, batch: SemanticBodyWork**, count: usize, failed: usize): void {
    var running: vector(SemanticBodyWork*) = default;
    sem_require(vector_reserve(&running, count));
    defer vector_dispose(&running);
    var active: usize = 0;
    for(var i: usize = 0; i < count && i <= failed; i++) {
        var result = batch[i];
        if result.done { continue; }
        sem_require(work_take_task(&c.queries, &result.ticket,
            work_find(&c.queries, result.subject, BodyQuery, 0)));
        result.stop = sem_body_stop(result);
        result.stage = entity_stage_open(c.program.root);
        sem_require(result.stage != null);
        foreach(var node in &result.nodes) {
            sem_require(entity_stage_lease(result.stage, node));
        }
        // Generated control blocks survive across dispatches and are not in
        // the original syntax list. They require leases too, not just pins.
        foreach(var &frame in &result.blocks) {
            if frame.loop_state.block != null {
                sem_require(entity_stage_lease(result.stage, frame.loop_state.block));
            }
            if frame.iteration_state.iteration != null {
                sem_require(entity_stage_lease(result.stage, frame.iteration_state.iteration));
            }
            if frame.match_state.block != null {
                sem_require(entity_stage_lease(result.stage, frame.match_state.block));
            }
        }
        running.data[active++] = result;
    }
    if active == 0 { return; }
    var context = *c;
    var view = entity_view_open(c.program.root);
    sem_require(view != null);
    var next: usize = 0;
    while next < active || c.workers.running != 0 {
        while next < active && c.workers.running < c.workers.count {
            var result = running.data[next++];
            result.context = &context;
            sem_require(work_pool_submit(&c.workers, bits(void*, &result.kernel)));
        }
        sem_require(work_pool_receive(&c.workers, true) != null);
    }
    entity_view_close(view);
    // Publish every stage before any cross-body bookkeeping. Completion order
    // must not change diagnostics, nominal type identity or observation order.
    for(var i: usize = 0; i < active; i++) {
        sem_require(entity_stage_publish(running.data[i].stage));
        running.data[i].stage = null;
        running.data[i].context = null;
    }
    for(var i: usize = 0; i < active; i++) { sem_body_publish(c, running.data[i]); }
}

fn sem_bodies(c: SemanticContext*): void {
    if !sem_ok(c) {
        return;
    }
    // Root operations can introduce array/type operands after declaration
    // layouts. Resolve their ordinary queries before immutable body admission,
    // even when every body has no structural continuation of its own.
    sem_layout_all(c);
    if !sem_ok(c) {
        return;
    }
    sem_control_names(c);
    sem_evaluation_begin(c);
    c.body_demands = sem_create(c.program.root);
    sem_require(entity_register(c.body_demands, sizeof(SemanticBodyDemand), alignof(SemanticBodyDemand), 0));
    c.body_seen = sem_table(c);
    sem_body_calls(c, c.program.root);
    var evaluation: usize = 0;
    while evaluation < c.evaluation_jobs.length {
        sem_body_calls(c, bits(SemanticEvaluation*, c.evaluation_jobs.data[evaluation]).expression);
        evaluation++;
    }
    var kind = sem_create(c.program.root);
    sem_require(entity_register(kind, sizeof(SemanticBodyWork), alignof(SemanticBodyWork), 0));
    var next: usize = 1;
    while next < c.program.functions.length && sem_ok(c) {
        if c.workers.count == 0 {
            sem_require(sem_workers_open(c));
        }
        sem_generic_bodies(c, next);
        if !sem_ok(c) {
            break;
        }
        var batch: SemanticBodyWork*[256];
        var count: usize = 0;
        var prepared: usize = 0;
        // Source windows and continuation rounds do not depend on pool width.
        // Hold diagnostics until every earlier body finishes, including errors
        // found in a later structural boundary after a later body has failed.
        while next < c.program.functions.length && prepared < BodyPreparationWindow {
            prepared++;
            var subject = c.program.functions.data[next];
            if !sem_body_pending(c, subject) {
                next++;
                continue;
            }
            if generic_body_pending(c.generics, subject) {
                break;
            }
            var result = sem_body_work(c, subject, kind);
            result.context = c;
            result.subject = subject;
            result.ordinal = next;
            result.kernel.kind = CompilerKernelKind.Body;
            result.kernel.payload = bits(void*, result);
            if !sem_is(sem_member(subject, "body"), "CoreBlock") {
                var ticket: WorkTicket;
                sem_body_structural_take(c, subject, next, BodyQuery, &ticket);
                var saved_reads = c.query_reads;
                c.query_reads = &result.query_reads;
                sem_function_body(c, subject);
                sem_layout_all(c);
                c.query_reads = saved_reads;
                sem_query_observe(c, &ticket, &result.query_reads);
                sem_require(work_finish(&c.queries, &ticket, sem_ok(c)));
                next++;
                if !sem_ok(c) {
                    sem_body_clear(result);
                    break;
                }
                sem_body_calls(c, sem_get(subject).body);
                sem_body_clear(result);
                continue;
            }
            var discovery = sem_body_sources_request(c, result);
            var id = work_request(&c.queries, subject, BodyQuery, 0);
            sem_require(id != 0 && work_depend(&c.queries, id, discovery));
            sem_generic_body_dependency(c, subject, id);
            var declaration = work_find(&c.queries, subject, convert(u32, SemanticQuery.Declaration), 0);
            if declaration != 0 { sem_require(work_depend(&c.queries, id, declaration)); }
            var domain = convert(u64, SemanticWorkDomain.Compiler);
            sem_require(work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Body), next, 1, WorkAccessMode.Write));
            sem_require(work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Layout), 0, ~convert(usize, 0), WorkAccessMode.Read));
            sem_require(work_access(&c.queries, id, domain, convert(u64, SemanticAccess.TypeIndex), 0, ~convert(usize, 0), WorkAccessMode.Read));
            sem_require(work_seal(&c.queries, id) && work_demand(&c.queries, id));
            batch[count++] = result;
            next++;
        }
        sem_body_sources_execute(c, &batch[0], count);
        var failed = count;
        for(var i: usize = 0; i < count; i++) {
            if batch[i].error.length != 0 { failed = i; break; }
        }
        var pending = count != 0;
        while pending {
            pending = false;
            sem_body_wave(c, &batch[0], count, failed);
            // Release all read claims before coordinator construction writes.
            for(var i: usize = 0; i < count; i++) {
                var result = batch[i];
                if result.error.length != 0 && i < failed {
                    failed = i;
                }
                if !result.done && result.ticket.task != 0 {
                    sem_body_suspend(c, result);
                    result.ticket.task = 0;
                }
            }
            sem_body_declarations(c, &batch[0], count, failed);
            for(var i: usize = 0; i < count && i <= failed; i++) {
                var result = batch[i];
                if result.error.length != 0 { failed = i; }
                if result.done {
                    continue;
                }
                if result.preparation != 0 { sem_body_prepare(c, result); }
                if result.error.length != 0 {
                    failed = i;
                }
                if !result.done {
                    pending = true;
                }
            }
        }
        if failed < count {
            var result = batch[failed];
            copy(&c.program.error, &result.error, sizeof(vector(u8)));
            vector_init(&result.error);
            c.program.error_offset = result.error_offset;
        } else {
            for(var i: usize = 0; i < count; i++) {
                sem_body_demand(c, &batch[i].calls);
            }
        }
        for(var i: usize = 0; i < count; i++) {
            sem_body_clear(batch[i]);
        }
        if sem_ok(c) {
            // Stage expressions are ordinary checked code hidden behind their
            // result placeholders. Their calls also require executable bodies.
            while evaluation < c.evaluation_jobs.length {
                sem_body_calls(c, bits(SemanticEvaluation*, c.evaluation_jobs.data[evaluation]).expression);
                evaluation++;
            }
            if next == c.program.functions.length {
                // A later checked body may demand an earlier signature-only
                // instance. Existing body query receipts prevent rechecking.
                next = 1;
                while next < c.program.functions.length && !sem_body_pending(c, c.program.functions.data[next]) {
                    next++;
                }
            }
        }
    }
    sem_body_prune(c);
}

// Checking and clone components share the same subject. Clone receipts remain
// reusable independently of the function's lexical checking continuation.
fn sem_body_work(c: SemanticContext*, subject: void*, kind: void*): SemanticBodyWork* {
    var existing = entity_component_get(subject, kind);
    if existing != null {
        return bits(SemanticBodyWork*, entity_component_data(existing));
    }
    var result = bits(SemanticBodyWork*, entity_component_data(entity_component_add(subject, kind)));
    sem_require(result != null);
    *result = default;
    result.context = c;
    result.subject = subject;
    return result;
}
