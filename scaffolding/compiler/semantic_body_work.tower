import tower;
import compiler_kernel;
import semantic_context;
import semantic_program_types;
import semantic_modules;
import semantic_definitions;
import foundation_tags;
import semantic_support;
import semantic_types;
import semantic_layout;
import semantic_statements;
import semantic_control;
import semantic_evaluation;
import semantic_flow;
import .library.vector;
import .library.stack;
import .library.work_graph;
import .library.work_pool;

const BodyQuery: u32 = 6;
const BodyPrepareQuery: u32 = 9;
const BodyPreparationWindow: usize = 256;

struct SemanticBodyScope {
    current: void*;
    scope: SemanticScope*;
    labels: SemanticTable*;
    loops: usize;
    deferred: void*;
    deferring: usize;
    defer_bindings: SemanticTable*;
    defer_order: vector(void*)*;
    has_defer: bool;
    control_names: SemanticTable*;
    control_reserved: SemanticTable*;
    control_prefix: u8*;
    flow_dependencies: vector(void*);
}

struct SemanticBodyWork {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    context: SemanticContext*;
    subject: void*;
    stage: void*;
    ordinal: usize;
    count: usize;
    surface: bool;
    has_defer: bool;
    nodes: vector(void*);
    evaluations: vector(void*);
    captures: vector(void*);
    flow_dependencies: vector(void*);
    error: vector(u8);
    error_offset: usize;
    resumed: bool;
    cursor: SemanticBlockCursor;
    lexical: SemanticBodyScope;
}

extern fn entity_view_open(anchor: void*): void*;
extern fn entity_view_close(view: void*): void;

// Type operands of builtins use the ordinary expression grammar. An index in
// that position constructs an array type; ordinary value indexing does not.
fn sem_body_type_structure(c: SemanticContext*, n: void*): bool {
    if n == null { return false; }
    var pending = sem_list(c);
    sem_push(pending, n);
    for(var i: usize = 0; i < pending.length; i++) {
        var node = pending.data[i];
        if sem_member(node, "index") != null || sem_member(node, "count") != null { return true; }
        for(var j: usize = 0; j < sem_child_count(node); j++) {
            sem_push(pending, sem_child(node, j));
        }
    }
    return false;
}

fn sem_body_layouts(c: SemanticContext*, consumer: usize): bool {
    // Root initializers and earlier structural bodies can introduce types after
    // the initial layout barrier. Keep their first consumers on the coordinator
    // until every existing nominal/array layout is ready. This is conservative
    // admission, not eager evaluation of otherwise unused types. A worker must
    // never discover/mutate a layout query through its shallow context copy.
    foreach(var type in &c.program.types) {
        if sem_get(type).type.record == null { continue; }
        var query = work_find(&c.queries, type, LayoutQuery(), 0);
        if query == 0 || work_task(&c.queries, query).state != WorkState.Succeeded { return false; }
        if consumer != 0 && !work_depend(&c.queries, consumer, query) { return false; }
    }
    return true;
}

// Structural construction still belongs to the coordinator. This scan only
// admits immutable inputs; it does not check/retry operands to discover effects.
fn sem_body_tree(c: SemanticContext*, source: void*, nodes: vector(void*)*): bool {
    var first = nodes.length;
    sem_push(nodes, source);
    for(var i = first; i < nodes.length; i++) {
        var node = nodes.data[i];
        if node == null { return false; }
        // Protocol lookup can instantiate generic functions even when the loop
        // source is an already typed parameter. It needs structural ownership.
        if sem_is(node, "TowerForeach") { return false; }
        if sem_is(node, "CoreArrayCount") { return false; }
        if sem_is(node, "CoreType") && (sem_member(node, "args") != null
            || sem_member(node, "count") != null || sem_member(node, "index") != null) { return false; }
        if sem_is(node, "CoreCall") {
            var name = sem_member(node, "name");
            var text = sem_identifier(c, name);
            var builtin = semantic_builtin_kind(text);
            if builtin == 0 {
                if sem_resolve(c, c.templates, name, text) != null
                    || sem_resolve(c, c.type_functions, name, text) != null { return false; }
            } else {
                if semantic_builtin_type_argument(builtin, 0) {
                    var args = sem_collect(c, sem_member(node, "args"), "CoreCallArgument");
                    if args.length != 0 && sem_body_type_structure(c, args.data[0]) { return false; }
                }
            }
        }
        for(var j: usize = 0; j < sem_child_count(node); j++) {
            sem_require(vector_push(void*, nodes, sem_child(node, j)));
        }
    }
    return true;
}

fn sem_body_sources(c: SemanticContext*, subject: void*, nodes: vector(void*)*): bool {
    if c.editor != null || c.type_uses != null || !sem_body_layouts(c, 0) { return false; }
    // The preceding body's lexical scope must not hide a qualified template.
    var scope = c.scope;
    c.scope = null;
    defer { c.scope = scope; }
    sem_push(nodes, subject);
    return sem_body_tree(c, sem_member(subject, "body"), nodes);
}

fn sem_body_suffix(c: SemanticContext*, subject: void*): usize {
    if c.editor != null || c.type_uses != null { return 0; }
    var scope = c.scope;
    c.scope = null;
    defer { c.scope = scope; }
    var scan: vector(void*);
    vector_init(&scan);
    defer vector_dispose(&scan);
    var body = sem_member(subject, "body");
    var cutoff: usize = 0;
    var suffix = false;
    for(var i: usize = 0; i < sem_child_count(body); i++) {
        var statement = sem_child(body, i);
        if !sem_is(statement, "Statement") { continue; }
        scan.length = 0;
        if !sem_body_tree(c, statement, &scan) {
            cutoff = i + 1;
            suffix = false;
        } else { suffix = true; }
    }
    return suffix ? cutoff : 0;
}

fn sem_body_save(c: SemanticContext*, local: SemanticBodyScope*): void {
    local.current = c.current;
    local.scope = c.scope;
    local.labels = c.labels;
    local.loops = c.loops;
    local.deferred = c.deferred;
    local.deferring = c.deferring;
    local.defer_bindings = c.defer_bindings;
    local.defer_order = c.defer_order;
    local.has_defer = c.has_defer;
    local.control_names = c.control_names;
    local.control_reserved = c.control_reserved;
    local.control_prefix = c.control_prefix;
    copy(&local.flow_dependencies, &c.flow_dependencies, sizeof(vector(void*)));
}

fn sem_body_restore(c: SemanticContext*, local: SemanticBodyScope*): void {
    c.current = local.current;
    c.scope = local.scope;
    c.labels = local.labels;
    c.loops = local.loops;
    c.deferred = local.deferred;
    c.deferring = local.deferring;
    c.defer_bindings = local.defer_bindings;
    c.defer_order = local.defer_order;
    c.has_defer = local.has_defer;
    c.control_names = local.control_names;
    c.control_reserved = local.control_reserved;
    c.control_prefix = local.control_prefix;
    copy(&c.flow_dependencies, &local.flow_dependencies, sizeof(vector(void*)));
}

fn sem_body_scope_begin(c: SemanticContext*, ordinal: usize): void {
    c.control_reserved = c.control_names;
    c.control_names = null;
    c.control_prefix = sem_cat(c, "control check ", sem_cat(c, sem_decimal(c, convert(u64, ordinal)), "."));
    c.deferred = null;
    c.deferring = 0;
    c.defer_bindings = null;
    c.defer_order = null;
    c.has_defer = false;
    vector_init(&c.flow_dependencies);
}

// Structural bodies/prefixes participate in the same query/access protocol.
// They run at a join boundary while interning and index publication still need
// coordinator ownership. Their completion is an explicit suffix dependency.
fn sem_body_structural_take(c: SemanticContext*, subject: void*, ordinal: usize,
    query: u32, ticket: WorkTicket*): usize {
    var id = work_request(&c.queries, subject, query, 0);
    sem_require(id != 0);
    sem_require(work_access(&c.queries, id, 1, 7, ordinal, 1, WorkAccessMode.Write));
    sem_require(work_access(&c.queries, id, 1, 9, 0, ~convert(usize, 0), WorkAccessMode.Write));
    sem_require(work_seal(&c.queries, id) && work_demand(&c.queries, id));
    sem_require(work_take_task(&c.queries, ticket, id));
    sem_require(ticket.task == id);
    return id;
}

fn sem_body_prefix(c: SemanticContext*, result: SemanticBodyWork*, cutoff: usize): void {
    var ticket: WorkTicket;
    sem_body_structural_take(c, result.subject, result.ordinal, BodyPrepareQuery(), &ticket);
    var saved: SemanticBodyScope;
    sem_body_save(c, &saved);
    sem_body_scope_begin(c, result.ordinal);
    if sem_function_begin(c, result.subject, &result.cursor) {
        while result.cursor.next < cutoff && sem_ok(c) { sem_block_step(c, &result.cursor); }
    }
    sem_body_save(c, &result.lexical);
    sem_body_restore(c, &saved);
    result.resumed = true;
    // Scope allocations remain compilation-owned. The worker has exclusive
    // ownership of this lexical state until join; it allocates its own scratch.
    // Collect every original node, including checked prefix declarations that
    // deferred cleanup and the closing block can still reference.
    result.nodes.length = 0;
    sem_push(&result.nodes, result.subject);
    sem_push(&result.nodes, sem_member(result.subject, "body"));
    for(var i: usize = 1; i < result.nodes.length; i++) {
        var node = result.nodes.data[i];
        for(var j: usize = 0; j < sem_child_count(node); j++) {
            sem_push(&result.nodes, sem_child(node, j));
        }
    }
    sem_layout_all(c);
    sem_require(work_finish(&c.queries, &ticket, sem_ok(c)));
}

fn semantic_body_kernel(result: SemanticBodyWork*): void {
    var context: SemanticContext;
    var program: SemanticProgram;
    copy(&context, result.context, sizeof(SemanticContext));
    copy(&program, context.program, sizeof(SemanticProgram));
    context.program = &program;
    context.current = result.subject;
    context.entity_stage = result.stage;
    context.count = 0;
    context.node_limit = result.context.count < context.node_limit
        ? context.node_limit - result.context.count : 0;
    vector_init(void*, &context.allocations);
    vector_init(void*, &context.lists);
    vector_init(void*, &context.inferring);
    vector_init(void*, &context.type_arguments);
    vector_init(void*, &context.constant_arguments);
    vector_init(void*, &context.generated);
    vector_init(void*, &context.evaluation_jobs);
    vector_init(void*, &context.flow_dependencies);
    vector_init(u8, &context.token_text);
    fill(&context.scan, 0, sizeof(stack(void*)));
    vector_init(u8, &program.error);
    if result.resumed {
        sem_body_restore(&context, &result.lexical);
        while result.cursor.next < sem_child_count(result.cursor.subject) && sem_ok(&context) {
            sem_block_step(&context, &result.cursor);
        }
        sem_function_finish(&context, result.subject, &result.cursor);
        fill(&result.lexical, 0, sizeof(SemanticBodyScope));
    } else {
        sem_body_scope_begin(&context, result.ordinal);
        sem_function_body(&context, result.subject);
    }
    result.count = context.count;
    result.surface = context.surface_expressions;
    result.has_defer = context.has_defer;
    if context.defer_order != null {
        for(var i: usize = 0; i < context.defer_order.length; i++) {
            sem_push(&result.captures, context.defer_order.data[i]);
        }
    }
    copy(&result.error, &program.error, sizeof(vector(u8)));
    result.error_offset = program.error_offset;
    copy(&result.evaluations, &context.evaluation_jobs, sizeof(vector(void*)));
    copy(&result.flow_dependencies, &context.flow_dependencies, sizeof(vector(void*)));
    // All persistent results above are canonical payloads, not pointers into
    // this worker's lexical scopes, token scratch or temporary semantic tables.
    stack_dispose(void*, &context.scan);
    vector_dispose(u8, &context.token_text);
    vector_dispose(void*, &context.inferring);
    vector_dispose(void*, &context.type_arguments);
    vector_dispose(void*, &context.constant_arguments);
    vector_dispose(void*, &context.generated);
    for(var i: usize = 0; i < context.lists.length; i++) {
        vector_dispose(void*, bits(vector(void*)*, context.lists.data[i]));
    }
    vector_dispose(void*, &context.lists);
    for(var i: usize = 0; i < context.allocations.length; i++) { free(context.allocations.data[i]); }
    vector_dispose(void*, &context.allocations);
}

fn sem_body_clear(result: SemanticBodyWork*): void {
    result.context = null;
    vector_dispose(&result.nodes);
    vector_dispose(&result.evaluations);
    vector_dispose(&result.captures);
    vector_dispose(&result.flow_dependencies);
    vector_dispose(&result.error);
    vector_dispose(&result.lexical.flow_dependencies);
    fill(&result.lexical, 0, sizeof(SemanticBodyScope));
}

fn sem_body_hold_error(c: SemanticContext*, result: SemanticBodyWork*): void {
    // Preparation is source ordered, but an earlier continuation may still
    // diagnose an error. Transfer this diagnostic and drain those jobs first.
    copy(&result.error, &c.program.error, sizeof(vector(u8)));
    result.error_offset = c.program.error_offset;
    fill(&c.program.error, 0, sizeof(vector(u8)));
    c.program.error_offset = 0;
}

fn sem_body_publish(c: SemanticContext*, result: SemanticBodyWork*): void {
    sem_require(entity_stage_publish(result.stage));
    result.stage = null;
    result.context = null;
    c.count += result.count;
    c.surface_expressions ||= result.surface;
    c.has_defer ||= result.has_defer;
    for(var j: usize = 0; j < result.captures.length; j++) {
        if c.defer_bindings == null {
            c.defer_bindings = sem_table(c);
            c.defer_order = sem_list(c);
        }
        var captured = result.captures.data[j];
        var entry = sem_state(c, c.defer_bindings, captured);
        if entry.value == null {
            entry.value = captured;
            sem_push(c.defer_order, captured);
        }
    }
    for(var j: usize = 0; j < result.evaluations.length; j++) {
        var evaluation = bits(SemanticEvaluation*, result.evaluations.data[j]);
        sem_push(&c.evaluation_jobs, bits(void*, evaluation));
        sem_evaluation_request(c, evaluation);
    }
    if result.flow_dependencies.length != 0 {
        sem_flow_request(c, result.subject, &result.flow_dependencies);
    }
    if result.error.length != 0 && sem_ok(c) {
        sem_require(vector_reserve(u8, &c.program.error, result.error.length + 1));
        copy(c.program.error.data, result.error.data, result.error.length + 1);
        c.program.error.length = result.error.length;
        c.program.error_offset = result.error_offset;
    }
    if c.count > c.node_limit { sem_fail(c, result.subject, "Foundation component memory budget exceeded"); }
    sem_require(work_finish(&c.queries, &result.ticket, result.error.length == 0 && c.count <= c.node_limit));
    sem_body_clear(result);
}

fn sem_bodies(c: SemanticContext*): void {
    if !sem_ok(c) { return; }
    sem_control_names(c);
    sem_evaluation_begin(c);
    var kind = sem_create(c.program.root);
    sem_require(entity_register(kind, sizeof(SemanticBodyWork), alignof(SemanticBodyWork), 0));
    var next: usize = 1;
    while next < c.program.functions.length && sem_ok(c) {
        if c.workers.count == 0 { sem_require(work_pool_open(&c.workers, work_thread_capacity())); }
        var batch: SemanticBodyWork*[256];
        var count: usize = 0;
        var prepared: usize = 0;
        var failed: SemanticBodyWork* = null;
        // Bound retained scopes/leases by a source window, independently of
        // worker capacity. Construction and diagnostic order cannot depend on
        // how many threads this host provides. No worker runs during preparation.
        while next < c.program.functions.length && prepared < BodyPreparationWindow() {
            prepared++;
            var subject = c.program.functions.data[next];
            if sem_get(subject).external { next++; continue; }
            var result = bits(SemanticBodyWork*, entity_component_data(entity_component_add(subject, kind)));
            sem_require(result != null);
            fill(result, 0, sizeof(SemanticBodyWork));
            result.context = c;
            result.subject = subject;
            result.ordinal = next;
            result.kernel.kind = CompilerKernelKind.Body;
            result.kernel.payload = bits(void*, result);
            if !sem_body_sources(c, subject, &result.nodes) {
                var cutoff = sem_body_suffix(c, subject);
                if cutoff == 0 {
                    var ticket: WorkTicket;
                    sem_body_structural_take(c, subject, next, BodyQuery(), &ticket);
                    sem_function_body(c, subject);
                    sem_layout_all(c);
                    sem_require(work_finish(&c.queries, &ticket, sem_ok(c)));
                    next++;
                    if !sem_ok(c) {
                        failed = result;
                        sem_body_hold_error(c, failed);
                        break;
                    }
                    sem_body_clear(result);
                    continue;
                }
                sem_body_prefix(c, result, cutoff);
                if !sem_ok(c) {
                    failed = result;
                    sem_body_hold_error(c, failed);
                    break;
                }
            }
            var id = work_request(&c.queries, subject, BodyQuery(), 0);
            sem_require(id != 0);
            if result.resumed {
                sem_require(work_depend(&c.queries, id, work_find(&c.queries, subject, BodyPrepareQuery(), 0)));
            }
            sem_require(sem_body_layouts(c, id));
            sem_require(work_access(&c.queries, id, 1, 7, next, 1, WorkAccessMode.Write));
            sem_require(work_access(&c.queries, id, 1, 1, 0, ~convert(usize, 0), WorkAccessMode.Read));
            sem_require(work_access(&c.queries, id, 1, 9, 0, ~convert(usize, 0), WorkAccessMode.Read));
            sem_require(work_seal(&c.queries, id));
            sem_require(work_demand(&c.queries, id));
            batch[count] = result;
            count++;
            next++;
        }
        var first: usize = 0;
        while first < count {
            var end = first + c.workers.count;
            if end > count { end = count; }
            for(var i = first; i < end; i++) {
                var result = batch[i];
                sem_require(work_take_query(&c.queries, &result.ticket, BodyQuery()));
                sem_require(work_task(&c.queries, result.ticket.task).subject == result.subject);
                result.stage = entity_stage_open(c.program.root);
                sem_require(result.stage != null);
                foreach(var node in &result.nodes) { sem_require(entity_stage_lease(result.stage, node)); }
            }
            var view = entity_view_open(c.program.root);
            sem_require(view != null);
            for(var i = first; i < end; i++) {
                sem_require(work_pool_submit(&c.workers, bits(void*, &batch[i].kernel)));
            }
            for(var i = first; i < end; i++) { sem_require(work_pool_receive(&c.workers, true) != null); }
            entity_view_close(view);
            // Drain every prepared continuation even if an earlier one failed.
            // Each owns canonical nodes and private scope state until publication.
            for(var i = first; i < end; i++) { sem_body_publish(c, batch[i]); }
            first = end;
        }
        if failed != null {
            if sem_ok(c) {
                copy(&c.program.error, &failed.error, sizeof(vector(u8)));
                fill(&failed.error, 0, sizeof(vector(u8)));
                c.program.error_offset = failed.error_offset;
            }
            sem_body_clear(failed);
        }
    }
}
