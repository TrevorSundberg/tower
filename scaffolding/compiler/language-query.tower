// Language-service inspection shares completion's source/module ownership,
// ordinary semantic checking, and the real syntax/Foundation ECS components.
// The returned ranges are a disposable presentation index, not another AST.
extern fn syntax_component_type(): void*;

extern fn parser_match_get_type(): void*;

extern fn entity_id(node: void*): usize;

extern fn entity_component_count(node: void*): usize;

extern fn format_summary(result: FormatResult*, entity: void*, syntax: void*, foundation: void*, `match`: void*): void;

extern fn format_dispose(result: FormatResult*): void;

extern fn host_source_error(source: u8*, count: usize): u8*;

extern fn frontend_module_location(module: void*, offset: usize, line: usize*, column: usize*): u8*;

extern fn syntax_source_location(source: SyntaxSource*, offset: usize, line: usize*, column: usize*): void;

struct LanguageCandidate {
    node: void*;
    subject: void*;
    from: usize;
    to: usize;
    grammar: bool;
    generic: GenericInfo*;
    template: LanguageGrammar*;
    matched: LanguageGrammar*;
    capture: void*;
    capture_node: void*;
    description: u8*;
    structural: bool;
}

fn language_quote(q: CompletionQuery*, text: u8*, size: usize): void {
    var hover_condition1 = size > HoverPreviewByteLimit();
    if hover_condition1 {
        size = HoverPreviewByteLimit();
        loop {
            var byte = text[size] & 192;
            var hover_condition2 = byte != 128;
            if hover_condition2 {
                break;
            }
            size--;
        }
    }
    sem_require(host_json_quote(&q.output, text, size));
}

fn language_string(q: CompletionQuery*, key: u8*, text: u8*): void {
    completion_text(&q.output, ",\"");
    completion_text(&q.output, key);
    completion_text(&q.output, "\":");
    language_quote(q, text, sem_length(text));
}

fn language_number(q: CompletionQuery*, key: u8*, value: usize): void {
    completion_text(&q.output, ",\"");
    completion_text(&q.output, key);
    completion_text(&q.output, "\":");
    sem_require(host_json_unsigned(&q.output, convert(u64, value)));
}

fn language_documentation(q: CompletionQuery*, value: FoundationNode*): void {
    // Consume the same attached metadata as Foundation/C formatting. Its
    // normalized block delimiters are presentation trivia, not documentation.
    var text: vector(u8);
    vector_init(u8, &text);
    var i: usize = 0;
    loop {
        var done = i >= value.comments.length;
        if done {
            break;
        }
        i = i + 2;
        var first = i;
        loop {
            var next = i + 1;
            done = next >= value.comments.length;
            if done {
                break;
            }
            var end = value.comments.data[i] == 42;
            end &&= value.comments.data[next] == 47;
            if end {
                break;
            }
            i = next;
        }
        var last = i;
        loop {
            var spaces = first < last;
            spaces &&= value.comments.data[first] == 32;
            if spaces {
                first++;
            } else {
                break;
            }
        }
        loop {
            var spaces = first < last;
            if spaces {
                var before = last - 1;
                spaces = value.comments.data[before] == 32;
            }
            if spaces {
                last--;
            } else {
                break;
            }
        }
        var content = last > first;
        if content {
            var newline = text.length != 0;
            if newline {
                sem_require(vector_push(u8, &text, 10));
            }
            var count = last - first;
            sem_require(bytes_append(&text, &value.comments.data[first], count));
        }
        i = i + 3;
    }
    var present = text.length != 0;
    if present {
        completion_text(&q.output, ",\"documentation\":");
        sem_require(host_json_quote(&q.output, text.data, text.length));
    }
    vector_dispose(u8, &text);
}

fn language_declaration_location(q: CompletionQuery*, subject: void*): void {
    var span = sem_match(subject);
    var context_condition30 = span == null;
    if context_condition30 {
        return;
    }
    var base = sem_source_base(&q.context, subject);
    var i: usize = 0;
    loop {
        var context_condition31 = i == q.comment_modules.length;
        if context_condition31 {
            return;
        }
        var context_condition32 = base == q.comment_bases.data[i];
        if context_condition32 {
            var module = q.comment_modules.data[i];
            var line: usize = 1;
            var column: usize = 1;
            var file = frontend_module_location(module, span.start, &line, &column);
            language_string(q, "declarationFile", file);
            language_number(q, "declarationLine", line);
            language_number(q, "declarationColumn", column);
            return;
        }
        i++;
    }
}

// The same walk handles every source leaf. The nearest entity with supported
// components owns its entire source span; no keyword or punctuation allow-list.
fn language_candidate(q: CompletionQuery*, node: void*, candidate: LanguageCandidate*, checked: bool): void {
    var span = sem_match(node);
    var absent = span == null;
    if absent {
        return;
    }
    var empty = span.length == 0;
    if empty {
        return;
    }
    var outside = span.start >= q.length;
    if outside {
        return;
    }
    var priority = LanguagePresentation.None;
    var i: usize = 0;
    var count = entity_component_count(node);
    loop {
        var done = i == count;
        if done {
            break;
        }
        var component = entity_component_at(node, i);
        var presented: LanguageCandidate;
        copy(&presented, candidate, sizeof(LanguageCandidate));
        presented.from = span.start;
        presented.to = span.start + span.length;
        var rank = language_component_present(q, node, component, checked, &presented);
        var preferred = convert(u32, rank) > convert(u32, priority);
        if preferred {
            priority = rank;
            copy(candidate, &presented, sizeof(LanguageCandidate));
        }
        i++;
    }
}

fn language_leaf(q: CompletionQuery*, leaf: void*, candidate: LanguageCandidate*): void {
    var span = sem_match(leaf);
    var hover_condition29 = span == null;
    if hover_condition29 {
        return;
    }
    var hover_condition30 = span.length == 0;
    if hover_condition30 {
        return;
    }
    var end = span.start + span.length;
    var hover_condition31 = end > q.length;
    if hover_condition31 {
        return;
    }
    var selected = candidate.subject != null;
    selected &&= span.start >= candidate.from;
    selected &&= end <= candidate.to;
    var subject = leaf;
    var node = leaf;
    var formatted: FormatResult;
    fill(&formatted, 0, sizeof(FormatResult));
    var value: FoundationNode* = null;
    if selected {
        subject = candidate.subject;
        node = candidate.node;
        value = sem_get(subject);
        var generic_check1 = candidate.generic != null;
        if generic_check1 {
            value = null;
            language_generic_format(q, candidate.generic, &formatted, true);
        } else {
            if candidate.structural {
                value = null;
            } else {
                if candidate.grammar {
                    format_grammar_preview(&formatted, subject, syntax_component_type());
                } else {
                    if sem_is(subject, "TowerExpression") || sem_is(subject, "TowerComma") || sem_is(subject, "TowerNullAccess") {
                        format_dependent_summary(&formatted, subject, parser_match_get_type());
                    } else {
                        format_summary(&formatted, subject, syntax_component_type(), core_component_type(), parser_match_get_type());
                    }
                }
            }
        }
    }
    var hover_condition32 = q.count != 0;
    if hover_condition32 {
        completion_text(&q.output, ",");
    }
    completion_text(&q.output, "{\"from\":");
    sem_require(host_json_unsigned(&q.output, convert(u64, span.start)));
    language_number(q, "to", end);
    completion_text(&q.output, ",\"signature\":");
    var preview = formatted.text.length != 0;
    if formatted.failed {
        preview = false;
    }
    if preview {
        language_quote(q, formatted.text.data, formatted.text.length);
    } else {
        language_quote(q, &q.source[span.start], span.length);
    }
    format_dispose(&formatted);
    var kind = language_kind(value);
    var context_condition33 = candidate.description != null;
    if context_condition33 {
        language_string(q, "description", candidate.description);
    }
    if selected {
        if candidate.grammar {
            kind = "grammar";
        }
        var generic_check2 = candidate.generic != null;
        if generic_check2 {
            kind = language_generic_kind(candidate.generic);
        }
    }
    var grammar_details = selected;
    grammar_details &&= candidate.grammar;
    if grammar_details {
        language_grammar_details(q, leaf, node);
    } else {
        var template_details = candidate.template != null;
        var matched = candidate.matched != null;
        if selected {
            matched = false;
        }
        if matched {
            template_details = true;
        }
        if !template_details {
            language_string(q, "kind", kind);
        }
    }
    var matched_details = candidate.matched != null;
    if selected {
        matched_details = false;
    }
    if matched_details {
        language_match_details(q, candidate);
    }
    var grammar_condition1 = candidate.template != null;
    if grammar_condition1 {
        language_template_details(q, leaf, candidate);
    }
    var syntax = sem_label(node);
    var hover_condition33 = node == leaf;
    if hover_condition33 {
        var parent = sem_parent(leaf);
        var hover_condition34 = parent != null;
        if hover_condition34 {
            syntax = sem_label(parent);
        }
    }
    language_string(q, "syntax", syntax);
    language_number(q, "entity", entity_id(node));
    language_number(q, "components", entity_component_count(node));
    var parent = sem_parent(node);
    var hover_condition35 = parent != null;
    if hover_condition35 {
        language_number(q, "parent", entity_id(parent));
    }
    var hover_condition36 = value != null;
    if selected {
        var generic_check3 = candidate.generic != null;
        if generic_check3 {
            language_generic_details(q, candidate.generic);
        }
    }
    if hover_condition36 {
        language_documentation(q, value);
        language_string(q, "type", sem_type_name(&q.context, &value.type));
        language_number(q, "binding", entity_id(subject));
        language_number(q, "size", semantic_size(&value.type));
        language_number(q, "alignment", semantic_alignment(&value.type));
        var hover_condition37 = value.kind == KFieldDeclaration();
        if hover_condition37 {
            language_number(q, "offset", value.byte_offset);
        }
        var hover_condition38 = sem_source_base(&q.context, subject) == 0;
        if hover_condition38 {
            var declaration = sem_match(subject);
            var hover_condition39 = declaration != null;
            if hover_condition39 {
                language_number(q, "declaration", declaration.start);
            }
        }
        language_declaration_location(q, subject);
    }
    completion_text(&q.output, "}");
    q.count++;
}

fn language_walk(q: CompletionQuery*, node: void*, inherited: LanguageCandidate*, checked: bool, depth: usize, budget: usize*): void {
    var hover_condition40 = depth == InspectionDepthLimit();
    if hover_condition40 {
        q.truncated = true;
        return;
    }
    var hover_condition41 = *budget == 0;
    if hover_condition41 {
        q.truncated = true;
        return;
    }
    *budget = *budget - 1;
    var current: LanguageCandidate;
    copy(&current, inherited, sizeof(LanguageCandidate));
    language_candidate(q, node, &current, checked);
    // Keep syntax available for nodes that have no concrete specialization yet.
    // A selected semantic subject takes precedence when rendering the leaf.
    language_match_candidate(q, node, &current);
    var count = sem_child_count(node);
    var syntax = language_syntax(node);
    var grammar_condition2 = syntax != null;
    if grammar_condition2 {
        var grammar_condition3 = syntax.kind == SyntaxTemplate();
        if grammar_condition3 {
            var template = language_grammar_find(q, node);
            var grammar_condition4 = template != null;
            grammar_condition4 &&= template.targets.length != 0;
            if grammar_condition4 {
                language_leaf(q, sem_child(node, 0), &current);
                language_template_walk(q, template.targets.data[0], template, null, checked, depth, budget);
                var last = count - 1;
                language_leaf(q, sem_child(node, last), &current);
                return;
            }
        }
    }
    var hover_condition42 = count == 0;
    if hover_condition42 {
        language_leaf(q, node, &current);
        return;
    }
    var i: usize = 0;
    loop {
        var hover_condition43 = i == count;
        if hover_condition43 {
            break;
        }
        var child_depth = depth + 1;
        language_walk(q, sem_child(node, i), &current, checked, child_depth, budget);
        i++;
    }
}

// Direct native/Wasm entry point. The handle owns its output and all temporary
// shared entities until completion_dispose; no server protocol or guest JIT.
export fn language_document(source: u8*, length: usize, mode: u32, pointer_bytes: u32): CompletionQuery* {
    var source_error = host_source_error(source, length);
    var invalid_source = source_error[0] != 0;
    if invalid_source {
        return null;
    }
    var valid_width = pointer_bytes == 4;
    var wide = pointer_bytes == 8;
    if wide {
        valid_width = true;
    }
    if !valid_width {
        return null;
    }
    var hover_condition44 = length > InspectionSourceByteLimit();
    if hover_condition44 {
        return null;
    }
    var hover_condition45 = mode > 2;
    if hover_condition45 {
        return null;
    }
    var q = completion_begin(source, length, 0, null, 0);
    var hover_condition46 = q == null;
    if hover_condition46 {
        return null;
    }
    q.inspection = true;
    q.recovered.length = 0;
    sem_require(bytes_append(&q.recovered, source, length));
    sem_require(host_text_terminate(&q.recovered));
    q.source = q.recovered.data;
    var root = tower_node_create();
    semantic_initialize(&q.program, root, pointer_bytes);
    q.semantic = true;
    var complete = completion_parse(q, q.source, mode, false);
    sem_require(host_text_terminate(&q.input));
    var c = &q.context;
    sem_context_init(c, &q.program);
    sem_type_uses_begin(c);
    q.analyzed = true;
    language_grammar_index(q);
    c.source = q.input.data;
    c.generics = generic_begin(root);
    var i: usize = 0;
    loop {
        var hover_condition47 = i == q.roots.length;
        if hover_condition47 {
            break;
        }
        var entry = sem_state(c, c.source_bases, q.roots.data[i]);
        entry.number = q.bases.data[i];
        i++;
    }
    var checked = mode == 0;
    if checked {
        sem_run(c);
        checked = sem_ok(c);
        // A document diagnostic does not invalidate the declared parameters and
        // symbolic annotations of its registered templates. Inspect those even
        // when executable checking failed; keep Foundation presentation gated
        // by the original result so partially checked values are never exposed.
        q.program.error.length = 0;
        q.generic_info = sem_generic_inspect(c, checked, &q.truncated);
    }
    if checked {
        i = 0;
        loop {
            var done = i == q.comment_modules.length;
            if done {
                break;
            }
            var module = q.comment_modules.data[i];
            var ordinary = frontend_module_roots(module) != 0;
            if ordinary {
                frontend_module_attach_comments(module, q.program.root, q.comment_bases.data[i]);
            }
            i++;
        }
    }
    q.program.error.length = 0;
    q.output.length = 0;
    q.count = 0;
    completion_text(&q.output, "{\"entries\":[");
    var empty: LanguageCandidate;
    fill(&empty, 0, sizeof(LanguageCandidate));
    var budget = InspectionNodeLimit();
    i = 0;
    loop {
        var hover_condition48 = i == q.roots.length;
        if hover_condition48 {
            break;
        }
        var hover_condition49 = q.bases.data[i] == 0;
        if hover_condition49 {
            language_walk(q, q.roots.data[i], &empty, checked, 0, &budget);
        }
        i++;
    }
    completion_text(&q.output, "],\"complete\":");
    if q.truncated {
        complete = false;
    }
    if complete {
        completion_text(&q.output, "true");
    }
    else {
        completion_text(&q.output, "false");
    }
    completion_text(&q.output, "}");
    sem_require(host_text_terminate(&q.output));
    return q;
}

export fn language_document_result(q: CompletionQuery*): u8* {
    return q.output.data;
}
