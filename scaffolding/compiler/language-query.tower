import 'format-types';
import tower;

// Language-service inspection shares completion's source/module ownership,
// ordinary semantic checking, and the real syntax/Foundation ECS components.
// The returned ranges are a disposable presentation index, not another AST.
extern fn syntax_component_type(): void*;

extern fn parser_match_get_type(): void*;

extern fn entity_id(node: void*): usize;

extern fn entity_component_count(node: void*): usize;

extern fn format_summary(result: FormatResult*, entity: void*, syntax: void*, foundation: void*, `match`: void*): void;

extern fn format_dispose(result: FormatResult*): void;

extern fn host_source_error(source: u8*, count: usize): u8*;

extern fn generic_definition(context: void*, node: void*): void*;

extern fn frontend_module_location(module: void*, offset: usize, line: usize*, column: usize*): u8*;

extern fn syntax_source_location(source: SyntaxSource*, offset: usize, line: usize*, column: usize*): void;

struct LanguageCandidate {
    node: void*;
    subject: void*;
    from: usize;
    to: usize;
    grammar: bool;
    specialization: bool;
    template: LanguageGrammar*;
    matched: LanguageGrammar*;
    capture: void*;
    capture_node: void*;
    description: u8*;
    structural: bool;
}

fn language_quote(q: CompletionQuery*, text: u8*, size: usize): void {
    var hover_condition1 = size > 512;
    if hover_condition1 {
        size = 512;
        loop {
            var byte = text[size] & 192;
            var hover_condition2 = byte != 128;
            if hover_condition2 {
                break;
            }
            size = size - 1;
        }
    }
    sem_require(host_json_quote(&q.output, text, size));
}

fn language_string(q: CompletionQuery*, key: u8*, text: u8*): void {
    completion_text(&q.output, ",\"");
    completion_text(&q.output, key);
    completion_text(&q.output, "\":");
    language_quote(q, text, sem_length(text));
}

fn language_number(q: CompletionQuery*, key: u8*, value: usize): void {
    completion_text(&q.output, ",\"");
    completion_text(&q.output, key);
    completion_text(&q.output, "\":");
    sem_require(host_json_unsigned(&q.output, convert(u64, value)));
}

fn language_documentation(q: CompletionQuery*, value: FoundationNode*): void {
    // Consume the same attached metadata as Foundation/C formatting. Its
    // normalized block delimiters are presentation trivia, not documentation.
    var text: vector(u8);
    vector_init(u8, &text);
    var i: usize = 0;
    loop {
        var done = i >= value.comments.length;
        if done {
            break;
        }
        i = i + 2;
        var first = i;
        loop {
            var next = i + 1;
            done = next >= value.comments.length;
            if done {
                break;
            }
            var end = value.comments.data[i] == 42;
            if end {
                end = value.comments.data[next] == 47;
            }
            if end {
                break;
            }
            i = next;
        }
        var last = i;
        loop {
            var spaces = first < last;
            if spaces {
                spaces = value.comments.data[first] == 32;
            }
            if spaces {
                first = first + 1;
            } else {
                break;
            }
        }
        loop {
            var spaces = first < last;
            if spaces {
                var before = last - 1;
                spaces = value.comments.data[before] == 32;
            }
            if spaces {
                last = last - 1;
            } else {
                break;
            }
        }
        var content = last > first;
        if content {
            var newline = text.length != 0;
            if newline {
                sem_require(vector_push(u8, &text, 10));
            }
            var count = last - first;
            sem_require(bytes_append(&text, &value.comments.data[first], count));
        }
        i = i + 3;
    }
    var present = text.length != 0;
    if present {
        completion_text(&q.output, ",\"documentation\":");
        sem_require(host_json_quote(&q.output, text.data, text.length));
    }
    vector_dispose(u8, &text);
}

fn language_kind(value: FoundationNode*): u8* {
    var hover_condition3 = value == null;
    if hover_condition3 {
        return "syntax";
    }
    var hover_condition4 = value.kind == KFunction();
    if hover_condition4 {
        return "function";
    }
    var hover_condition5 = value.kind == KParameter();
    if hover_condition5 {
        return "parameter";
    }
    var hover_condition6 = value.kind == KDeclare();
    if hover_condition6 {
        if value.global {
            return "global variable";
        }
        return "local variable";
    }
    var hover_condition7 = value.kind == KFieldDeclaration();
    if hover_condition7 {
        return "field";
    }
    var hover_condition8 = value.kind == KType();
    if hover_condition8 {
        return "type";
    }
    var hover_condition9 = value.kind == KCall();
    if hover_condition9 {
        return "call";
    }
    var hover_condition10 = value.kind == KOperand();
    if hover_condition10 {
        var member = value.constant;
        if member {
            member = value.type.pointers == 0;
        }
        if member {
            member = semantic_enum(&value.type);
        }
        if member {
            return "enum member";
        }
        return "value";
    }
    var hover_condition11 = value.kind == KField();
    if hover_condition11 {
        return "field access";
    }
    var hover_condition12 = value.kind == KIndex();
    if hover_condition12 {
        return "index";
    }
    var context_condition1 = value.kind == KLoad();
    if context_condition1 {
        return "pointer dereference";
    }
    var context_condition2 = value.kind == KAddress();
    if context_condition2 {
        return "address of";
    }
    return "foundation operation";
}

// Keywords and punctuation use the nearest checked operation on the same tree.
// A token's spelling only refines that operation's role; it never resolves a
// name, invents a type, or parses a second representation of the program.
fn language_context_candidate(q: CompletionQuery*, leaf: void*, candidate: LanguageCandidate*): void {
    var span = sem_match(leaf);
    var context_condition3 = span == null;
    if context_condition3 {
        return;
    }
    var end = span.start + span.length;
    var selected = candidate.subject != null;
    if selected {
        selected = span.start >= candidate.from;
    }
    if selected {
        selected = end <= candidate.to;
    }
    if selected {
        return;
    }
    var node = sem_parent(leaf);
    var value: FoundationNode* = null;
    loop {
        var context_condition4 = node == null;
        if context_condition4 {
            return;
        }
        value = sem_get(node);
        var context_condition5 = value == null;
        if context_condition5 {
            if sem_is(node, "CoreCallStatement") {
                var call = sem_member(node, "call");
                value = sem_get(call);
                var present = value != null;
                if present {
                    node = call;
                }
            }
        }
        var context_condition6 = value != null;
        if context_condition6 {
            break;
        }
        node = sem_parent(node);
    }
    var context_condition7 = value.kind == KProgram();
    if context_condition7 {
        return;
    }
    var subject = node;
    var spelling = sem_tokens(&q.context, leaf);
    var description: u8* = null;
    var structural = false;
    var context_condition8 = value.kind == KDeclare();
    if context_condition8 {
        description = "Declares a mutable variable.";
        if sem_equal(spelling, "=") {
            description = "Sets this variable's starting value.";
        }
        if sem_equal(spelling, ":") {
            description = "Specifies the type of this variable.";
        }
        if sem_equal(spelling, ";") {
            description = "Ends this variable declaration.";
        }
    }
    var context_condition9 = value.kind == KAssign();
    if context_condition9 {
        subject = value.target;
        description = "Stores the value on the right in this location.";
        var target = sem_get(subject);
        var context_condition10 = target != null;
        if context_condition10 {
            var context_condition11 = target.binding != null;
            if context_condition11 {
                subject = target.binding;
            }
        }
    }
    var context_condition12 = value.kind == KLoad();
    if context_condition12 {
        description = "Reads the value stored at this pointer.";
        if sem_is(node, "CoreTarget") {
            description = "Selects the pointed-to value to write.";
        }
    }
    var context_condition13 = value.kind == KAddress();
    if context_condition13 {
        description = "Takes the address of this value, producing a pointer to it.";
    }
    var context_condition14 = value.kind == KReturn();
    if context_condition14 {
        subject = language_ancestor(node, "CoreFunction");
        description = "Returns from this function to its caller.";
        var context_condition15 = value.value != null;
        if context_condition15 {
            description = "Returns this value from the function to its caller.";
        }
    }
    var context_condition16 = value.kind == KBlock();
    if context_condition16 {
        var function = sem_parent(node);
        var function_value = sem_get(function);
        var body = function_value != null;
        if body {
            body = function_value.kind == KFunction();
        }
        if body {
            body = function_value.body == node;
        }
        if body {
            subject = function;
            description = "Starts the body of this function.";
            if sem_equal(spelling, "}") {
                description = "Ends the body of this function.";
            }
        } else {
            structural = true;
            description = "Starts a block of statements with its own local variables.";
            if sem_equal(spelling, "}") {
                description = "Ends this block and the scope of its local variables.";
            }
        }
    }
    var context_condition17 = value.kind == KFunction();
    if context_condition17 {
        description = "Defines this function.";
        if sem_equal(spelling, ":") {
            description = "Specifies the type of value this function returns.";
        }
        if sem_equal(spelling, "(") {
            description = "Starts this function's parameter list.";
        }
        if sem_equal(spelling, ")") {
            description = "Ends this function's parameter list.";
        }
    }
    var context_condition18 = value.kind == KParameter();
    if context_condition18 {
        description = "Declares an input passed to this function.";
    }
    var context_condition19 = value.kind == KFieldDeclaration();
    if context_condition19 {
        description = "Declares a field with this type and position in its containing value.";
    }
    var context_condition20 = value.kind == KCall();
    if context_condition20 {
        var context_condition21 = value.binding != null;
        if context_condition21 {
            subject = value.binding;
        }
        description = "Calls this function with the supplied arguments.";
    }
    var context_condition22 = value.kind == KIf();
    if context_condition22 {
        structural = true;
        description = "Runs the first block when the condition is true, or the else block when it is false.";
    }
    var context_condition23 = value.kind == KLoop();
    if context_condition23 {
        structural = true;
        description = "Repeats this block until control leaves the loop.";
    }
    var context_condition24 = value.kind == KBreak();
    if context_condition24 {
        structural = true;
        description = "Leaves the nearest enclosing loop.";
    }
    var context_condition25 = value.kind == KContinue();
    if context_condition25 {
        structural = true;
        description = "Starts the next iteration of the nearest enclosing loop.";
    }
    var context_condition26 = value.kind == KLabel();
    if context_condition26 {
        structural = true;
        description = "Names a destination for a jump in this function.";
    }
    var context_condition27 = value.kind == KJump();
    if context_condition27 {
        structural = true;
        description = "Continues execution at the named label.";
    }
    if sem_equal(spelling, ";") {
        var context_condition28 = description == null;
        if context_condition28 {
            description = "Ends this statement.";
        }
    }
    var context_condition29 = subject == null;
    if context_condition29 {
        return;
    }
    candidate.node = node;
    candidate.subject = subject;
    candidate.from = span.start;
    candidate.to = end;
    candidate.grammar = false;
    candidate.description = description;
    candidate.structural = structural;
}

fn language_declaration_location(q: CompletionQuery*, subject: void*): void {
    var span = sem_match(subject);
    var context_condition30 = span == null;
    if context_condition30 {
        return;
    }
    var base = sem_source_base(&q.context, subject);
    var i: usize = 0;
    loop {
        var context_condition31 = i == q.comment_modules.length;
        if context_condition31 {
            return;
        }
        var context_condition32 = base == q.comment_bases.data[i];
        if context_condition32 {
            var module = q.comment_modules.data[i];
            var line: usize = 1;
            var column: usize = 1;
            var file = frontend_module_location(module, span.start, &line, &column);
            language_string(q, "declarationFile", file);
            language_number(q, "declarationLine", line);
            language_number(q, "declarationColumn", column);
            return;
        }
        i = i + 1;
    }
}

fn language_candidate(q: CompletionQuery*, node: void*, candidate: LanguageCandidate*, checked: bool): void {
    var span = sem_match(node);
    var hover_condition13 = span == null;
    if hover_condition13 {
        return;
    }
    var hover_condition14 = span.length == 0;
    if hover_condition14 {
        return;
    }
    var hover_condition15 = span.start >= q.length;
    if hover_condition15 {
        return;
    }
    var subject = node;
    var range = node;
    var grammar = entity_component_get(node, syntax_component_type()) != null;
    var value = sem_get(node);
    var usable = grammar;
    var specialization = false;
    if checked {
        var generic = value == null;
        if generic {
            generic = sem_is(node, "CoreFunction");
        }
        if generic {
            // A generic declaration has no single concrete type. Show a real
            // checked instantiation when available, explicitly labelled as such.
            var i: usize = 0;
            loop {
                var done = i == q.program.functions.length;
                if done {
                    break;
                }
                var function = q.program.functions.data[i];
                var definition = generic_definition(q.context.generics, function);
                var same = definition == node;
                if same {
                    subject = function;
                    value = sem_get(function);
                    specialization = true;
                    break;
                }
                i = i + 1;
            }
        }
        if sem_is(node, "CoreType") {
            var type = sem_type(&q.context, node);
            if sem_ok(&q.context) {
                subject = sem_type_entity(&q.context, type);
                usable = true;
            }
            q.program.error.length = 0;
        } else {
            var hover_condition16 = value != null;
            if hover_condition16 {
                // Blocks/control statements have no value/signature to preview.
                usable = value.kind == KFunction();
                var hover_condition17 = value.kind == KParameter();
                if hover_condition17 {
                    usable = true;
                }
                var hover_condition18 = value.kind == KDeclare();
                if hover_condition18 {
                    usable = true;
                }
                var hover_condition19 = value.kind == KType();
                if hover_condition19 {
                    usable = true;
                }
                var hover_condition20 = value.kind == KFieldDeclaration();
                if hover_condition20 {
                    usable = true;
                }
                var expression = value.kind >= KOperand();
                if expression {
                    expression = value.kind <= KCall();
                }
                if expression {
                    usable = true;
                }
                var hover_condition21 = value.kind == KField();
                if hover_condition21 {
                    usable = true;
                }
                var hover_condition22 = value.kind == KIndex();
                if hover_condition22 {
                    usable = true;
                }
                var hover_condition23 = value.kind == KString();
                if hover_condition23 {
                    usable = true;
                }
                var hover_condition24 = semantic_builtin_name(value.kind) != null;
                if hover_condition24 {
                    usable = true;
                }
                if usable {
                    var hover_condition25 = value.binding != null;
                    if hover_condition25 {
                        subject = value.binding;
                    }
                    var named = sem_member(node, "name");
                    var hover_condition26 = value.kind == KField();
                    if hover_condition26 {
                        named = sem_member(node, "field");
                    }
                    var hover_condition27 = named != null;
                    if hover_condition27 {
                        range = named;
                    }
                }
            }
        }
    }
    if usable {
        span = sem_match(range);
        var hover_condition28 = span == null;
        if hover_condition28 {
            return;
        }
        candidate.node = node;
        candidate.subject = subject;
        candidate.from = span.start;
        candidate.to = span.start + span.length;
        candidate.grammar = grammar;
        candidate.specialization = specialization;
    }
}

fn language_leaf(q: CompletionQuery*, leaf: void*, candidate: LanguageCandidate*): void {
    var span = sem_match(leaf);
    var hover_condition29 = span == null;
    if hover_condition29 {
        return;
    }
    var hover_condition30 = span.length == 0;
    if hover_condition30 {
        return;
    }
    var end = span.start + span.length;
    var hover_condition31 = end > q.length;
    if hover_condition31 {
        return;
    }
    var selected = candidate.subject != null;
    if selected {
        selected = span.start >= candidate.from;
    }
    if selected {
        selected = end <= candidate.to;
    }
    var subject = leaf;
    var node = leaf;
    var formatted: FormatResult;
    fill(&formatted, 0, sizeof(FormatResult));
    var value: FoundationNode* = null;
    if selected {
        subject = candidate.subject;
        node = candidate.node;
        value = sem_get(subject);
        if candidate.structural {
            value = null;
        } else {
            if candidate.grammar {
                format_grammar_preview(&formatted, subject, syntax_component_type());
            } else {
                format_summary(&formatted, subject, syntax_component_type(), core_component_type(), parser_match_get_type());
            }
        }
    }
    var hover_condition32 = q.count != 0;
    if hover_condition32 {
        completion_text(&q.output, ",");
    }
    completion_text(&q.output, "{\"from\":");
    sem_require(host_json_unsigned(&q.output, convert(u64, span.start)));
    language_number(q, "to", end);
    completion_text(&q.output, ",\"signature\":");
    var preview = formatted.text.length != 0;
    if formatted.failed {
        preview = false;
    }
    if preview {
        language_quote(q, formatted.text.data, formatted.text.length);
    } else {
        language_quote(q, &q.source[span.start], span.length);
    }
    format_dispose(&formatted);
    var kind = language_kind(value);
    var context_condition33 = candidate.description != null;
    if context_condition33 {
        language_string(q, "description", candidate.description);
    }
    if selected {
        if candidate.grammar {
            kind = "grammar";
        }
        if candidate.specialization {
            kind = "function specialization";
        }
    }
    var grammar_details = selected;
    if grammar_details {
        grammar_details = candidate.grammar;
    }
    if grammar_details {
        language_grammar_details(q, leaf, node);
    } else {
        var template_details = candidate.template != null;
        var matched = candidate.matched != null;
        if selected {
            matched = false;
        }
        if matched {
            template_details = true;
        }
        if template_details {} else {
            language_string(q, "kind", kind);
        }
    }
    var matched_details = candidate.matched != null;
    if selected {
        matched_details = false;
    }
    if matched_details {
        language_match_details(q, candidate);
    }
    var grammar_condition1 = candidate.template != null;
    if grammar_condition1 {
        language_template_details(q, leaf, candidate);
    }
    var syntax = sem_label(node);
    var hover_condition33 = node == leaf;
    if hover_condition33 {
        var parent = sem_parent(leaf);
        var hover_condition34 = parent != null;
        if hover_condition34 {
            syntax = sem_label(parent);
        }
    }
    language_string(q, "syntax", syntax);
    language_number(q, "entity", entity_id(node));
    language_number(q, "components", entity_component_count(node));
    var parent = sem_parent(node);
    var hover_condition35 = parent != null;
    if hover_condition35 {
        language_number(q, "parent", entity_id(parent));
    }
    var hover_condition36 = value != null;
    if hover_condition36 {
        language_documentation(q, value);
        language_string(q, "type", sem_type_name(&q.context, &value.type));
        language_number(q, "binding", entity_id(subject));
        language_number(q, "size", semantic_size(&value.type));
        language_number(q, "alignment", semantic_alignment(&value.type));
        var hover_condition37 = value.kind == KFieldDeclaration();
        if hover_condition37 {
            language_number(q, "offset", value.byte_offset);
        }
        var hover_condition38 = sem_source_base(&q.context, subject) == 0;
        if hover_condition38 {
            var declaration = sem_match(subject);
            var hover_condition39 = declaration != null;
            if hover_condition39 {
                language_number(q, "declaration", declaration.start);
            }
        }
        language_declaration_location(q, subject);
    }
    completion_text(&q.output, "}");
    q.count = q.count + 1;
}

fn language_walk(q: CompletionQuery*, node: void*, inherited: LanguageCandidate*, checked: bool, depth: usize, budget: usize*): void {
    var hover_condition40 = depth == 256;
    if hover_condition40 {
        q.truncated = true;
        return;
    }
    var hover_condition41 = *budget == 0;
    if hover_condition41 {
        q.truncated = true;
        return;
    }
    *budget = *budget - 1;
    var current: LanguageCandidate;
    copy(&current, inherited, sizeof(LanguageCandidate));
    language_candidate(q, node, &current, checked);
    // Keep syntax available for nodes that have no concrete specialization yet.
    // A selected semantic subject takes precedence when rendering the leaf.
    language_match_candidate(q, node, &current);
    var count = sem_child_count(node);
    var syntax = language_syntax(node);
    var grammar_condition2 = syntax != null;
    if grammar_condition2 {
        var grammar_condition3 = syntax.kind == SyntaxTemplate();
        if grammar_condition3 {
            var template = language_grammar_find(q, node);
            var grammar_condition4 = template != null;
            if grammar_condition4 {
                grammar_condition4 = template.targets.length != 0;
            }
            if grammar_condition4 {
                language_leaf(q, sem_child(node, 0), &current);
                language_template_walk(q, template.targets.data[0], template, null, checked, depth, budget);
                var last = count - 1;
                language_leaf(q, sem_child(node, last), &current);
                return;
            }
        }
    }
    var hover_condition42 = count == 0;
    if hover_condition42 {
        if checked {
            language_context_candidate(q, node, &current);
        }
        language_leaf(q, node, &current);
        return;
    }
    var i: usize = 0;
    loop {
        var hover_condition43 = i == count;
        if hover_condition43 {
            break;
        }
        var child_depth = depth + 1;
        language_walk(q, sem_child(node, i), &current, checked, child_depth, budget);
        i = i + 1;
    }
}

// Direct native/Wasm entry point. The handle owns its output and all temporary
// shared entities until completion_dispose; no server protocol or guest JIT.
export fn language_document(source: u8*, length: usize, mode: u32, pointer_bytes: u32): CompletionQuery* {
    var source_error = host_source_error(source, length);
    var invalid_source = source_error[0] != 0;
    if invalid_source {
        return null;
    }
    var valid_width = pointer_bytes == 4;
    var wide = pointer_bytes == 8;
    if wide {
        valid_width = true;
    }
    if valid_width {} else {
        return null;
    }
    var hover_condition44 = length > 8388608;
    if hover_condition44 {
        return null;
    }
    var hover_condition45 = mode > 2;
    if hover_condition45 {
        return null;
    }
    var q = completion_begin(source, length, 0, null, 0);
    var hover_condition46 = q == null;
    if hover_condition46 {
        return null;
    }
    q.inspection = true;
    q.recovered.length = 0;
    sem_require(bytes_append(&q.recovered, source, length));
    sem_require(host_text_terminate(&q.recovered));
    q.source = q.recovered.data;
    var root = tower_node_create();
    semantic_initialize(&q.program, root, pointer_bytes);
    q.semantic = true;
    var complete = completion_parse(q, q.source, mode, false);
    sem_require(host_text_terminate(&q.input));
    var c = &q.context;
    sem_context_init(c, &q.program);
    q.analyzed = true;
    language_grammar_index(q);
    c.source = q.input.data;
    c.generics = generic_begin(root);
    var i: usize = 0;
    loop {
        var hover_condition47 = i == q.roots.length;
        if hover_condition47 {
            break;
        }
        var entry = sem_state(c, c.source_bases, q.roots.data[i]);
        entry.number = q.bases.data[i];
        i = i + 1;
    }
    var checked = mode == 0;
    if checked {
        sem_run(c);
        checked = sem_ok(c);
    }
    if checked {
        i = 0;
        loop {
            var done = i == q.comment_modules.length;
            if done {
                break;
            }
            var module = q.comment_modules.data[i];
            var ordinary = frontend_module_roots(module) != 0;
            if ordinary {
                frontend_module_attach_comments(module, q.program.root, q.comment_bases.data[i]);
            }
            i = i + 1;
        }
    }
    q.program.error.length = 0;
    q.output.length = 0;
    q.count = 0;
    completion_text(&q.output, "{\"entries\":[");
    var empty: LanguageCandidate;
    fill(&empty, 0, sizeof(LanguageCandidate));
    var budget: usize = 100000;
    i = 0;
    loop {
        var hover_condition48 = i == q.roots.length;
        if hover_condition48 {
            break;
        }
        var hover_condition49 = q.bases.data[i] == 0;
        if hover_condition49 {
            language_walk(q, q.roots.data[i], &empty, checked, 0, &budget);
        }
        i = i + 1;
    }
    completion_text(&q.output, "],\"complete\":");
    if q.truncated {
        complete = false;
    }
    if complete {
        completion_text(&q.output, "true");
    }
    else {
        completion_text(&q.output, "false");
    }
    completion_text(&q.output, "}");
    sem_require(host_text_terminate(&q.output));
    return q;
}

export fn language_document_result(q: CompletionQuery*): u8* {
    return q.output.data;
}
