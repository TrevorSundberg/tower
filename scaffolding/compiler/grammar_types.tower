import tower;
import .library.work_pool;

// Borrowed component identities from one world, shared by every grammar reader.
struct FrontendKinds {
    rule: void*;
    reference: void*;
    string: void*;
    range: void*;
    `match`: void*;
    syntax: void*;
}

enum GrammarPhase: u32 {
    Lookup, Build, Table, Reuse, PoolOpen, PoolClose, Lookahead,
    LookaheadGraph, LookaheadSolve, LookaheadActions, PropagationWave, ActionWave,
    LookaheadKernel, Count
}
struct GrammarObserver {
    // Borrowed until the world's synchronous work drains. Coordinator phases
    // are serial. LookaheadKernel events may overlap: their first argument is
    // a private ordinal within the enclosing PropagationWave/ActionWave, whose
    // exit runs only after every started kernel has joined. Second is work size.
    context: void*;
    event: function(void, void*, GrammarPhase, bool, usize, usize);
}

// World-owned caches, populated/reset by the coordinator. Tables are derived;
// Bedrock remains an ordinary shared-entity document with foundation text.
struct CompilerGrammarCache {
    bedrock: void*;
    patterns: void*;
    syntax: void*; // SyntaxBaselines, owned/reset by the world's coordinator
    workers: WorkPool;
    workers_busy: bool;
    observer: GrammarObserver;
}

struct GrammarBuilder {
    kinds: FrontendKinds*;
    root: void*;
    failed: bool;
    resource_error: WorkBudgetError;
}
