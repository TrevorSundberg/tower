import tower;
import test_file_rule;
import frontend_modules;
import .library.vector;
import .library.work_budget_types;

extern fn compiler_world_create_workers(workers: usize): void*;
extern fn compiler_world_dispose(world: void*): bool;
extern fn frontend_world_clear(world: void*): bool;
extern fn memcmp(left: u8*, right: u8*, length: usize): i32;

fn test_file_input(environment: ModuleEnvironment*, path: u8*, text: u8*): bool {
    return frontend_modules_source(environment, path, text, strlen(text));
}

fn test_file_memory_check(world: void*, environment: ModuleEnvironment*, selection: TestFileSelection*, wanted: u8*,
    ordinary_count: usize, selected_count: usize): bool {
    var error = WorkBudgetError.None;
    var root = frontend_modules_test_input_root(world, environment, selection, &error);
    if root == null { return false; }
    defer frontend_module_destroy(root);
    var session = frontend_module_session(root);
    if session == null { return false; }
    syntax_read_import(session);
    if syntax_get_error(session)[0] != 0 { return false; }
    frontend_module_finish(root);
    if frontend_module_count(root) != ordinary_count || frontend_module_error(root)[0] != 0 { return false; }
    var pairs: vector(TestFileCompanion) = default;
    defer vector_dispose(&pairs);
    if !frontend_module_discover_tests(root, selection, null, null, &pairs) || pairs.length != selected_count { return false; }
    var matches = pairs.length == 0 || (strcmp(frontend_module_name(bits(FrontendModule*, pairs.data[0].module)), wanted) == 0
        && strcmp(frontend_module_name(bits(FrontendModule*, pairs.data[0].owner)), "a_test.tower/n.v2.tower") == 0);
    // A completed graph includes test-only imports. Never reuse that expanded
    // graph as the ordinary closure of another discovery.
    return matches && !frontend_module_discover_tests(root, selection, null, null, &pairs)
        && pairs.length == selected_count && frontend_module_error(root)[0] != 0;
}

fn test_file_key_equal(left: TestFileSelection*, right: TestFileSelection*): bool {
    return left.key.length == right.key.length && memcmp(left.key.data, right.key.data, left.key.length) == 0;
}

export fn test_file_rule_checks(): bool {
    var world = compiler_world_create_workers(1);
    if world == null { return false; }
    defer { if !frontend_world_clear(world) || !compiler_world_dispose(world) { trap("Test profile world cleanup", 0); } }
    var environment = frontend_modules_create();
    if environment == null { return false; }
    defer frontend_modules_destroy(environment);
    var entry = "mem.tower";
    frontend_modules_configure(environment, entry, "");
    var owner = "a_test.tower/n.v2.tower";
    var ordinary = "a_test.tower/n.v2_test.tower";
    var alternate = "a_test.tower/n.v2_spec.tower";
    if !test_file_input(environment, entry, "import './a_test.tower/n.v2.tower';")
        || !test_file_input(environment, owner, "")
        || !test_file_input(environment, ordinary, "")
        || !test_file_input(environment, alternate, "import './helper.tower';")
        || !test_file_input(environment, "a_test.tower/helper.tower", "")
        || !test_file_input(environment, "a_test.tower/n.v2_SPEC.tower", "missing")
        || !test_file_input(environment, "a_test.tower/n.v2_spec_spec.tower", "missing")
        || !test_file_input(environment, "a_test.tower/n.v2_test_test.tower", "missing") { return false; }
    var normal = frontend_module_root_world(world, "import './a_test.tower/n.v2.tower';", environment);
    if normal == null { return false; }
    var ordinary_ok = false;
    {
        defer frontend_module_destroy(normal);
        var session = frontend_module_session(normal);
        if session == null { return false; }
        syntax_read_import(session);
        frontend_module_finish(normal);
        ordinary_ok = syntax_get_error(session)[0] == 0 && frontend_module_error(normal)[0] == 0 && frontend_module_count(normal) == 2;
    }
    if !ordinary_ok { return false; }
    var rule = test_file_default_rule();
    var first: TestFileSelection = default;
    var second: TestFileSelection = default;
    defer test_file_selection_dispose(&first);
    defer test_file_selection_dispose(&second);
    if !frontend_test_selection_open(&first, &rule, entry)
        || !frontend_test_selection_open(&second, &rule, "dir/../mem.tower")
        || !test_file_key_equal(&first, &second)
        || !test_file_memory_check(world, environment, &first, ordinary, 2, 1) { return false; }
    var suffix = "_spec.tower";
    var storage = alloc(u8, strlen(suffix) + 1);
    if storage == null { return false; }
    defer free(storage);
    copy(storage, suffix, strlen(suffix) + 1);
    rule.companion_suffix = storage;
    if !frontend_test_selection_open(&second, &rule, entry) || test_file_key_equal(&first, &second) { return false; }
    storage[1] = *"X"; // mutate the caller's profile after freezing
    if !test_file_memory_check(world, environment, &second, alternate, 2, 1) { return false; }
    rule.companion_suffix = suffix;
    if !test_file_input(environment, "mem_spec.tower", "") || !test_file_memory_check(world, environment, &second, alternate, 2, 2)
        || !frontend_test_selection_open(&first, &rule, alternate) || test_file_key_equal(&first, &second)
        || strcmp(test_file_selection_root(&first), owner) != 0
        || !test_file_memory_check(world, environment, &first, alternate, 1, 1) { return false; }
    // Refused selection replacement preserves the live explicit selection.
    return !frontend_test_selection_open(&first, &rule, "a_test.tower/n.v2_spec_spec.tower")
        && strcmp(test_file_selection_root(&first), owner) == 0;
}
