import tower;
import .library.entities;
import .library.entity_types;
import .library.vector;
import entity_require;

fn compiler_component_get(node: Entity*, type: Entity*): void* {
    if node == null {
        return null;
    }
    var component = entity_component_get(node, type);
    var data = entity_component_data(component);
    return bits(void*, data);
}

fn generic_component_add(node: Entity*, type: Entity*): void* {
    var component = entity_component_add(node, type);
    var present = component != null;
    compiler_entity_require(present);
    return bits(void*, entity_component_data(component));
}

// A program's context component retains its registry type. The registry owns
// its other type entities through ordinary containment; attached components
// retain their own types as usual. No process-lifetime type cache is required.
fn generic_registry_type(registry: Entity*, size: usize, alignment: usize): Entity* {
    var type = entity_create(registry.store);
    var present = type != null;
    compiler_entity_require(present);
    compiler_entity_require(entity_register(type, size, alignment, 0));
    compiler_entity_require(entity_attach(type, registry, null));
    entity_release(type);
    return type;
}

// These are semantic components attached to real definition/instance nodes.
// Fixed bounds match the current foundation parameter and function limits.
enum GenericKind: u32 {
    Ordinary, Function, TypeConstructor
}

var GenericInstanceLimit: usize = 512;
var GenericNodeLimit: usize = 65536;

struct GenericTemplate {
    parameters: Entity*[64];
    type_parameters: bool[64];
    count: usize;
    type_count: usize;
    kind: GenericKind;
    // Derived from immutable body syntax, measured only after a body is demanded.
    body_nodes: usize;
    body_measured: bool;
}

struct GenericInstance {
    definition: Entity*;
    use: Entity*;
    node: Entity*;
    body_source: Entity*;
    body_ready: bool;
    arguments: Entity*[64];
    count: usize;
    next: GenericInstance*;
}

struct GenericOrigin {
    definition: Entity*;
    use: Entity*;
}

// This linked index is derived from instance components, scoped to one program
// and its explicit target. It is not a second representation of the program.
struct GenericContext {
    root: Entity*;
    template_type: Entity*;
    instance_type: Entity*;
    origin_type: Entity*;
    first: GenericInstance*;
    count: usize;
    copied: usize;
    error: u8*;
}

export fn generic_begin(root: Entity*): GenericContext* {
    var registry = entity_create(root.store);
    var present = registry != null;
    compiler_entity_require(present);
    compiler_entity_require(entity_register(registry, sizeof(GenericContext), alignof(GenericContext), 0));
    var data = generic_component_add(root, registry);
    var context = bits(GenericContext*, data);
    fill(context, 0, sizeof(GenericContext));
    context.root = root;
    context.template_type = generic_registry_type(registry, sizeof(GenericTemplate), alignof(GenericTemplate));
    context.instance_type = generic_registry_type(registry, sizeof(GenericInstance), alignof(GenericInstance));
    context.origin_type = generic_registry_type(registry, sizeof(GenericOrigin), alignof(GenericOrigin));
    entity_release(registry);
    return context;
}

export fn generic_error(context: GenericContext*): u8* {
    return context.error;
}

// After a coordinator has retained a failed producer's diagnostic, independent
// structural queries start with a fresh diagnostic slot. Never call on workers.
export fn generic_error_clear(context: GenericContext*): void {
    context.error = null;
}

export fn generic_origin(context: GenericContext*, node: Entity*): Entity* {
    var data = compiler_component_get(node, context.origin_type);
    if data != null {
        var origin = bits(GenericOrigin*, data);
        return origin.use;
    }
    return null;
}

export fn generic_definition(context: GenericContext*, node: Entity*): Entity* {
    var data = compiler_component_get(node, context.origin_type);
    if data != null {
        var origin = bits(GenericOrigin*, data);
        return origin.definition;
    }
    return node;
}

// Query the existing specialization components, including a returned nominal
// struct nested inside its constructor instance. Display names are not identity.
export fn generic_specialization(context: GenericContext*, node: Entity*): Entity* {
    while node != null {
        if compiler_component_get(node, context.instance_type) != null {
            return node;
        }
        node = entity_parent(node);
    }
    return null;
}

export fn generic_argument_count(context: GenericContext*, node: Entity*): usize {
    var instance = bits(GenericInstance*, compiler_component_get(node, context.instance_type));
    if instance == null {
        return 0;
    }
    return instance.count;
}

export fn generic_argument(context: GenericContext*, node: Entity*, index: usize): Entity* {
    var instance = bits(GenericInstance*, compiler_component_get(node, context.instance_type));
    if instance == null || index >= instance.count {
        return null;
    }
    return instance.arguments[index];
}

// Count precisely the descendants copied by the body kernel, excluding its
// destination root. An over-budget or unmeasurable body gets a conservative
// reservation; only the ordinary clone kernel decides whether it can compile.
fn generic_body_measure(body: Entity*, limit: usize): usize {
    compiler_entity_require(limit <= GenericNodeLimit);
    var pending: vector(Entity*);
    vector_init(&pending);
    defer vector_dispose(&pending);
    var count: usize = 0;
    var current = body;
    while current != null {
        var children = entity_child_count(current);
        if children > limit - count - pending.length { return limit + 1; }
        if !vector_reserve(&pending, pending.length + children) { return limit + 1; }
        for(var i: usize = 0; i < children; i++) {
            pending.data[pending.length++] = entity_child_at(current, i);
        }
        if pending.length == 0 { break; }
        current = pending.data[--pending.length];
        count++;
    }
    return count;
}

// Coordinator-only preparation before pinning worker inputs. All instances of
// the same definition share this estimate, never a second semantic body graph.
export fn generic_body_cost(context: GenericContext*, node: Entity*): usize {
    var instance = bits(GenericInstance*, compiler_component_get(node, context.instance_type));
    compiler_entity_require(instance != null && instance.body_source != null);
    var template = bits(GenericTemplate*, compiler_component_get(instance.definition, context.template_type));
    compiler_entity_require(template != null);
    if !template.body_measured {
        template.body_nodes = generic_body_measure(instance.body_source, GenericNodeLimit);
        template.body_measured = true;
    }
    return template.body_nodes;
}
