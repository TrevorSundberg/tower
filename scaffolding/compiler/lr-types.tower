import tower;

// Transitional parser token sentinels shared by table construction and runtime.
// These are table indexes, not Foundation program instructions.
const LRTokenEnd: u32 = 4294967294;
const LRTokenPropagation: u32 = 4294967293;

// Shared disposable LR index records, never a separate semantic graph.
struct LRProduction {
    owner: usize;
    begin: usize;
    count: usize;
    precedence: u32;
    associativity: u32;
}

struct LRSymbol {
    nonterminal: usize;
    first: u32;
    last: u32;
}

struct LRItem {
    rule: usize;
    position: usize;
    first: u32;
    last: u32;
}

struct LRTransition {
    symbol: usize;
    state: usize;
}

struct LRAction {
    first: u32;
    last: u32;
    rule: usize;
    state: usize;
}

struct LRGoto {
    nonterminal: usize;
    state: usize;
}

struct LRConflict {
    state: usize;
    left: LRAction;
    right: LRAction;
}
