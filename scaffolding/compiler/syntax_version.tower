import tower;
import lr_analysis;
import frontend_cache;
import lr_tree;
import syntax_emission;
import syntax_lexer;
import syntax_nodes;
import syntax_pending;
import syntax_replacement_owner;
import syntax_version_types;
import frontend_revision_types;
import component_kinds;
import .library.work_budget_types;

extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_type(world: void*, kind: u32): void*;
extern fn entity_create(store: void*): void*;
extern fn compiler_world_type_result(world: void*, kind: u32, error: WorkBudgetError*): void*;
extern fn entity_create_result(store: void*, error: WorkBudgetError*): void*;
extern fn parser_table_destroy(table: void*): void;

export fn syntax_version_create(world: void*, grammar: FrontendRevision*, bedrock: FrontendRevision*): SyntaxVersion* {
    var error = WorkBudgetError.None;
    return syntax_version_create_result(world, grammar, bedrock, &error);
}

export fn syntax_version_create_result(world: void*, grammar: FrontendRevision*, bedrock: FrontendRevision*, error: WorkBudgetError*): SyntaxVersion* {
    *error = WorkBudgetError.Invalid;
    if world is null { return null; }
    *error = WorkBudgetError.Memory;
    var value = alloc(SyntaxVersion, 1);
    if value is null { return null; }
    *value = default;
    value.rules = entity_create_result(compiler_world_store(world), error);
    if value.rules is null { free(value); return null; }
    value.references = 1;
    var completed = false;
    defer { if !completed { syntax_version_release(value); } }
    value.kinds.rule = compiler_world_type_result(world, CompilerParserRule, error);
    if value.kinds.rule is null { return null; }
    value.kinds.reference = compiler_world_type_result(world, CompilerParserReference, error);
    if value.kinds.reference is null { return null; }
    value.kinds.string = compiler_world_type_result(world, CompilerParserString, error);
    if value.kinds.string is null { return null; }
    value.kinds.range = compiler_world_type_result(world, CompilerParserRange, error);
    if value.kinds.range is null { return null; }
    value.kinds.`match` = compiler_world_type_result(world, CompilerParserMatch, error);
    if value.kinds.`match` is null { return null; }
    value.kinds.syntax = compiler_world_type_result(world, CompilerSyntax, error);
    if value.kinds.syntax is null { return null; }
    value.grammar = frontend_revision_retain(grammar);
    value.bedrock = frontend_revision_retain(bedrock);
    value.replacement_error_offset = lr_none();
    completed = true;
    return value;
}

export fn syntax_version_retain(value: SyntaxVersion*): SyntaxVersion* {
    if value is not null { value.references++; }
    return value;
}

export fn syntax_version_release(value: SyntaxVersion*): void {
    if value is null { return; }
    value.references--;
    if value.references != 0 { return; }
    // Readers and parser userdata are already gone. Release consumers before
    // the source pins and lookup allocations they borrow, even on partial build.
    lexicon_destroy(bits(SyntaxLexicon*, value.lexicon));
    parser_table_destroy(value.table);
    syntax_replacement_owner_destroy(bits(SyntaxReplacementOwner*, value.replacements));
    frontend_revision_release(value.bedrock);
    syntax_pending_destroy(bits(SyntaxPendingRevision*, value.pending));
    syntax_emission_destroy(bits(SyntaxEmission*, value.emission));
    entity_release(value.rules);
    frontend_revision_release(value.grammar);
    free(value);
}
