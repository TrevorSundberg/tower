import tower;

// IDE ABI handles identify host sessions, never foundation pointer values.
// Payload ownership transfers only after a successful insert/take. The table
// does not call native destructors; hosts dispose the returned payload once.
import host_handle_types;

export fn host_handles_count(table: HostHandles*, kind: u32): usize {
    var count: usize = 0;
    var i: usize = 0;
    loop {
        if i == table.count {
            return count;
        }
        if table.slots[i].kind == kind {
            count++;
        }
        i++;
    }
}

export fn host_handles_get(table: HostHandles*, kind: u32, handle: u32): void* {
    var i: usize = 0;
    loop {
        if i == table.count {
            return null;
        }
        var same = table.slots[i].handle == handle;
        if same {
            same = table.slots[i].kind == kind;
            if same {
                return table.slots[i].payload;
            }
            return null;
        }
        i++;
    }
}

export fn host_handles_insert(table: HostHandles*, kind: u32, payload: void*): u32 {
    if payload == null {
        return 0;
    }
    var maximum: usize = 4294967295;
    var full = table.count == maximum;
    if full {
        return 0;
    }
    full = table.count == table.capacity;
    if full {
        var capacity = table.capacity *2;
        if capacity < table.capacity {
            return 0;
        }
        if capacity == 0 {
            capacity = 8;
        }
        var slots = realloc(HostHandleSlot, table.slots, capacity);
        if slots == null {
            return 0;
        }
        table.slots = slots;
        table.capacity = capacity;
    }
    var handle = table.next;
    loop {
        handle++;
        if handle == 0 {
            continue;
        }
        var occupied = false;
        for(var i: usize = 0; i != table.count; i++) {
            if table.slots[i].handle == handle {
                occupied = true;
                break;
            }
        }
        if !occupied {
            break;
        }
    }
    var slot = &table.slots[table.count];
    slot.handle = handle;
    slot.kind = kind;
    slot.payload = payload;
    table.count++;
    table.next = handle;
    return handle;
}

export fn host_handles_take(table: HostHandles*, kind: u32, handle: u32): void* {
    var i: usize = 0;
    loop {
        if i == table.count {
            return null;
        }
        var same = table.slots[i].handle == handle;
        if same {
            same = table.slots[i].kind == kind;
            if !same {
                return null;
            }
            var result = table.slots[i].payload;
            table.count--;
            var last = &table.slots[table.count];
            // No aggregate assignment is needed, and the slots own no payload.
            table.slots[i].handle = last.handle;
            table.slots[i].kind = last.kind;
            table.slots[i].payload = last.payload;
            return result;
        }
        i++;
    }
}

// Call only once every payload has been taken and disposed by its owner.
export fn host_handles_dispose(table: HostHandles*): bool {
    var empty = table.count == 0;
    if empty {
        free(table.slots);
        *table = default;
    }
    return empty;
}
