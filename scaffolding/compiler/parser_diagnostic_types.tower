import tower;
import format_diagnostic_types;
import .library.vector;

enum ParserDiagnosticReader: u32 {
    None, Utf8, Syntax
}

// Owns formatted labels and the bounded probe's context storage. Consumers
// borrow these views until destroy; no C++ containers or copied context graph.
struct ParserDiagnostic {
    offset: usize;
    insertion_offset: usize;
    complete: bool;
    at_start: bool;
    options: vector(SyntaxDiagnosticOption);
    probe: void*;
}
