import tower;
import generic_registry;
import host_metadata;
import .library.entities;
import .library.entity_types;
import .library.entity_stage;
import generic_body_types;
import entity_require;

// Compiler transformations and metadata over the shared entity store.

fn compiler_node_count(node: Entity*): usize {
    if node == null {
        return 0;
    }
    return entity_child_count(node);
}

fn compiler_node_member(node: Entity*, role: u8*): Entity* {
    if node == null {
        return null;
    }
    var index = entity_member_index(node, role);
    return entity_child_at(node, index);
}

fn generic_parameters(context: GenericContext*, template: GenericTemplate*, node: Entity*, depth: usize): void {
    if depth > 128 {
        context.error = "Template parameter nesting exceeds 128";
        return;
    }
    if compiler_node_label(node, "CoreParameter") {
        if template.count == 64 {
            context.error = "A template supports at most 64 parameters";
            return;
        }
        var annotation = compiler_node_member(node, "type");
        var type = compiler_name_is(annotation, "type");
        template.parameters[template.count] = node;
        template.type_parameters[template.count] = type;
        template.count++;
        if type {
            template.type_count++;
        }
        return;
    }
    var i: usize = 0;
    var count = compiler_node_count(node);
    for(; i != count; i++) {
        var child = entity_child_at(node, i);
        var next = depth + 1;
        generic_parameters(context, template, child, next);
    }
}

export fn generic_register(context: GenericContext*, definition: Entity*): u32 {
    var temporary: GenericTemplate;
    var template = &temporary;
    fill(template, 0, sizeof(GenericTemplate));
    var params = compiler_node_member(definition, "params");
    generic_parameters(context, template, params, 0);
    var result = compiler_node_member(definition, "type");
    var produces_type = compiler_name_is(result, "type");
    if template.type_count != 0 {
        template.kind = GenericKind.Function;
    }
    if produces_type {
        var error: u8* = null;
        var result = generic_type_result_read(definition, &error);
        // Nominal recursive declarations retain early identity publication.
        // General type-producing bodies use ordinary callable specialization
        // and execution, including mutable value parameters and control flow.
        if result != null && !compiler_node_label(result, "TowerExpression")
            && !compiler_name_is(compiler_node_member(result, "name"), "type_value") {
            template.kind = GenericKind.TypeConstructor;
        }
    }
    if template.kind != GenericKind.Ordinary {
        var data = generic_component_add(definition, context.template_type);
        copy(data, template, sizeof(GenericTemplate));
    }
    return convert(u32, template.kind);
}

export fn generic_parameter_count(context: GenericContext*, definition: Entity*): usize {
    var data = compiler_component_get(definition, context.template_type);
    var template = bits(GenericTemplate*, data);
    return template.count;
}

export fn generic_type_parameter(context: GenericContext*, definition: Entity*, index: usize): bool {
    var data = compiler_component_get(definition, context.template_type);
    var template = bits(GenericTemplate*, data);
    if index < template.count {
        return template.type_parameters[index];
    }
    return false;
}

struct CloneFrame {
    source: Entity*;
    destination: Entity*;
    next: usize;
}

fn compiler_clone_node(source: Entity*, context: GenericContext*, use: Entity*, stage: EntityStage*, parent: Entity*, name: u8*): Entity* {
    var result = stage == null ? entity_create(source.store) : entity_stage_create_named(stage, parent, name);
    if result == null {
        return null;
    }
    if stage == null {
        compiler_node_copy_metadata(source, result);
    } else {
        if !compiler_node_copy_metadata_staged(source, result, stage) { return null; }
    }
    if context != null {
        var component = entity_component_add(result, context.origin_type);
        if component == null {
            if stage == null { entity_release(result); }
            return null;
        }
        var origin = bits(GenericOrigin*, entity_component_data(component));
        origin.definition = source;
        origin.use = use;
    }
    return result;
}

// An explicit work stack preserves deep-tree support without host recursion.
fn compiler_clone_branch(source: Entity*, remaining: usize*, context: GenericContext*, use: Entity*, stage: EntityStage*, parent: Entity*, name: u8*, skip_children: Entity*): Entity* {
    var exhausted = *remaining == 0;
    if exhausted {
        return null;
    }
    var capacity: usize = 16;
    var frames = alloc(CloneFrame, capacity);
    var failed = frames == null;
    if failed {
        return null;
    }
    var result = compiler_clone_node(source, context, use, stage, parent, name);
    failed = result == null;
    if failed {
        free(frames);
        return null;
    }
    *remaining = *remaining - 1;
    frames[0].source = source;
    frames[0].destination = result;
    frames[0].next = 0;
    var length: usize = 1;
    loop {
        if length == 0 {
            break;
        }
        var top = length -1;
        var frame = &frames[top];
        var count = frame.source == skip_children ? 0 : compiler_node_count(frame.source);
        if frame.next == count {
            length = top;
            continue;
        }
        exhausted = *remaining == 0;
        if exhausted {
            failed = true;
            break;
        }
        if length == capacity {
            capacity = capacity * 2;
            var next = realloc(CloneFrame, frames, capacity);
            failed = next == null;
            if failed {
                break;
            }
            frames = next;
            frame = &frames[top];
        }
        var child = entity_child_at(frame.source, frame.next);
        var role = entity_child_name(frame.source, frame.next);
        var copy = compiler_clone_node(child, context, use, stage, frame.destination, role);
        failed = copy == null;
        if failed {
            break;
        }
        *remaining = *remaining - 1;
        if stage == null {
            var attached = entity_attach(copy, frame.destination, role);
            entity_release(copy);
            if !attached { failed = true; break; }
        }
        frame.next++;
        frames[length].source = child;
        frames[length].destination = copy;
        frames[length].next = 0;
        length++;
    }
    free(frames);
    if failed {
        if stage == null { entity_release(result); }
        return null;
    }
    return result;
}

export fn compiler_clone_tree(source: Entity*, limit: usize, copied: usize*): Entity* {
    var remaining = limit;
    var result = compiler_clone_branch(source, &remaining, null, null, null, null, null, null);
    *copied = limit - remaining;
    return result;
}

export fn generic_instantiate(context: GenericContext*, definition: Entity*, use: Entity*, arguments: Entity**, count: usize): Entity* {
    return generic_instantiate_body(context, definition, use, arguments, count, false);
}

// Query preparation reserves canonical instance identity and its header only.
// The shared body-copy receipt must publish before a type-result consumer reads
// the constructor body. Existing eager adapters keep their ordinary behavior.
export fn generic_instantiate_deferred(context: GenericContext*, definition: Entity*, use: Entity*, arguments: Entity**, count: usize): Entity* {
    return generic_instantiate_body(context, definition, use, arguments, count, true);
}

fn generic_instantiate_body(context: GenericContext*, definition: Entity*, use: Entity*, arguments: Entity**, count: usize, defer_type_body: bool): Entity* {
    var data = compiler_component_get(definition, context.template_type);
    var template = bits(GenericTemplate*, data);
    var needed = template.type_count;
    if template.kind == GenericKind.TypeConstructor {
        needed = template.count;
    }
    if count != needed {
        context.error = "Wrong number of compile-time arguments";
        return null;
    }
    var current = context.first;
    while current != null {
        var same = current.definition == definition;
        // Only compare arguments for this definition; stop at the first
        // mismatch. Other templates may have a different argument count.
        same &&= current.count == count;
        if same {
            for(var i: usize = 0; i < count; i++) {
                if current.arguments[i] != arguments[i] {
                    same = false;
                    break;
                }
            }
        }
        if same {
            return current.node;
        }
        current = current.next;
    }
    if context.count == GenericInstanceLimit {
        context.error = "Template specialization limit exceeded (512 instances); check recursive type arguments";
        return null;
    }
    var remaining = GenericNodeLimit -context.copied;
    var before = remaining;
    // Preserve the body root's shape/provenance for the signature. Descendants
    // are copied only when execution demands this function's body.
    var body_source: Entity* = null;
    if template.kind == GenericKind.Function || defer_type_body && template.kind == GenericKind.TypeConstructor {
        body_source = compiler_node_member(definition, "body");
    }
    var node = compiler_clone_branch(definition, &remaining, context, use, null, null, null, body_source);
    var copied = before -remaining;
    context.copied = context.copied + copied;
    if node == null {
        context.error = "Template expansion exceeds 65536 nodes or could not allocate its work stack";
        return null;
    }
    data = generic_component_add(node, context.instance_type);
    var instance = bits(GenericInstance*, data);
    fill(instance, 0, sizeof(GenericInstance));
    instance.definition = definition;
    instance.use = use;
    instance.node = node;
    instance.body_source = body_source;
    instance.count = count;
    for(var i: usize = 0; i < count; i++) {
        instance.arguments[i] = arguments[i];
    }
    if !entity_attach(node, context.root, null) {
        entity_release(node);
        context.error = "Unable to attach template instance";
        return null;
    }
    // Publish before semantic resolution, so recursive references reuse this node.
    instance.next = context.first;
    context.first = instance;
    context.count++;
    entity_release(node);
    return node;
}

export fn generic_lookup(context: GenericContext*, node: Entity*, name: Entity*): Entity* {
    if context.first == null {
        return null;
    }
    var origin = compiler_component_get(node, context.origin_type);
    if origin == null {
        return null;
    }
    loop {
        if node == null {
            return null;
        }
        var data = compiler_component_get(node, context.instance_type);
        if data != null {
            var instance = bits(GenericInstance*, data);
            data = compiler_component_get(instance.definition, context.template_type);
            var template = bits(GenericTemplate*, data);
            var i: usize = 0;
            var argument: usize = 0;
            loop {
                if i == template.count {
                    return null;
                }
                var compile_time = template.type_parameters[i];
                if template.kind == GenericKind.TypeConstructor {
                    compile_time = true;
                }
                if compile_time {
                    var parameter = compiler_node_member(template.parameters[i], "name");
                    if compiler_name_equal(parameter, name) {
                        return instance.arguments[argument];
                    }
                    argument++;
                }
                i++;
            }
        }
        node = entity_parent(node);
    }
}

// Initial type-function evaluator: one optional struct declaration, then return
// that struct or an existing type/type-producing call. General staged execution
// will extend this instead of introducing a second template expression language.
// Read-only inspection reports errors to caller-owned scratch. Worker deduction
// never writes a shared GenericContext, including invalid alias diagnostics.
export fn generic_type_result_read(instance: Entity*, error: u8**): Entity* {
    *error = null;
    var body = compiler_node_member(instance, "body");
    var structure: Entity* = null;
    var returned: Entity* = null;
    var count = compiler_node_count(body);
    for(var i: usize = 0; i != count; i++) {
        var statement = entity_child_at(body, i);
        if compiler_node_label(statement, "Statement") {
            statement = entity_child_at(statement, 0);
            var already_returned = returned != null;
            var is_struct = compiler_node_label(statement, "CoreStruct");
            var is_return = compiler_node_label(statement, "CoreReturn");
            if already_returned {
                *error = "A type constructor must end with its return";
                return null;
            }
            if is_struct {
                if structure != null {
                    *error = "A type constructor currently supports one local struct";
                    return null;
                }
                structure = statement;
            } else {
                if is_return {
                    returned = compiler_node_member(statement, "value");
                } else {
                    *error = "Type constructors currently support a struct and return; general compile-time execution is not implemented";
                    return null;
                }
            }
        }
    }
    if returned == null {
        *error = "A type constructor must return a type";
        return null;
    }
    if structure != null {
        var name = compiler_node_member(structure, "name");
        if compiler_name_equal(name, returned) {
            return structure;
        }
        *error = "A type constructor with a local struct must return that struct";
        return null;
    }
    loop {
        var children = compiler_node_count(returned);
        if children == 1 {
            returned = entity_child_at(returned, 0);
        } else {
            return returned;
        }
    }
}

export fn generic_type_result(context: GenericContext*, instance: Entity*): Entity* {
    var error: u8* = null;
    var result = generic_type_result_read(instance, &error);
    if error != null { context.error = error; }
    return result;
}


export fn generic_body_pending(context: GenericContext*, node: Entity*): bool {
    var instance = bits(GenericInstance*, compiler_component_get(node, context.instance_type));
    return instance != null && instance.body_source != null && !instance.body_ready;
}

export fn generic_body_limit(context: GenericContext*): usize {
    return GenericNodeLimit - context.copied;
}

// The coordinator calls this only after successful structural publication.
export fn generic_body_complete(context: GenericContext*, node: Entity*, copied: usize): void {
    compiler_entity_require(generic_body_pending(context, node) && copied <= generic_body_limit(context));
    var instance = bits(GenericInstance*, compiler_component_get(node, context.instance_type));
    context.copied += copied;
    instance.body_ready = true;
}

// One job owns only its stage and result. Templates, signatures, type identities
// and provenance are immutable during dispatch; no shared retain/attach occurs.
export fn compiler_generic_body_kernel(payload: void*): void {
    var result = bits(GenericBodyCopy*, payload);
    var context = bits(GenericContext*, result.context);
    var node = bits(Entity*, result.node);
    var stage = bits(EntityStage*, result.stage);
    var instance = bits(GenericInstance*, compiler_component_get(node, context.instance_type));
    var destination = compiler_node_member(node, "body");
    var remaining = result.limit;
    result.success = generic_body_pending(context, node) && destination != null;
    if !result.success { return; }
    for(var i: usize = 0; i < entity_child_count(instance.body_source); i++) {
        var source = entity_child_at(instance.body_source, i);
        var role = entity_child_name(instance.body_source, i);
        if compiler_clone_branch(source, &remaining, context, instance.use, stage, destination, role, null) == null {
            result.success = false;
            break;
        }
    }
    result.copied = result.limit - remaining;
}
