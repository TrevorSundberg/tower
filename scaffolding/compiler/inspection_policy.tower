import tower;

// Resource limits for compiler inspection/display, not limits on Tower types.
var InspectionDepthLimit: usize = 256;
var InspectionNodeLimit: usize = 100000;
var HoverPreviewByteLimit: usize = 512;
var InspectionSourceByteLimit: usize = 8388608;

// Component ordering must not influence which semantic presentation wins.
enum LanguagePresentation: u32 {
    None = 0, TypeUse = 10, Grammar = 20, Generic = 25, Foundation = 30
}

var TriviaTab: u8 = 9;
var TriviaNewline: u8 = 10;
var TriviaCarriageReturn: u8 = 13;
var TriviaSpace: u8 = 32;
