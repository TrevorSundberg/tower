import tower;
import component_kinds;
import frontend_cache;
import frontend_revision_types;
import frontend_world;
import grammar_types;
import lr_tree;
import syntax_reader;
import syntax_nodes;
import syntax_revision;
import syntax_validation;
import .library.vector;
import .library.work_buffer;
import parser_table_types;

extern fn parser_structure_cache_dispose(cache: ParserStructureCache*): void;
extern fn compiler_world_work_budget(world: void*): WorkBudget*;

// Only derived numeric LR data survives a session. Versions retain their own
// entities, emission, replacements and provenance. One world's coordinator
// mutates this bounded index; parser workers only borrow completed tables.
struct SyntaxStructureOwner {
    storage: WorkBuffer;
    bedrock: FrontendRevision*;
    cache: ParserStructureCache;
}

// A world's coordinator publishes complete validated baselines. Sessions retain
// revision views, so replacement/reset can retire the registry's document while
// readers keep their source entities alive. Installed baselines belong to worlds.
struct SyntaxBaseline {
    source: vector(u8);
    document: void*;
    revision: FrontendRevision*;
}

struct SyntaxBaselines {
    seed: FrontendRevision*;
    bedrock: SyntaxBaseline;
    foundation: SyntaxBaseline;
    structures: SyntaxStructureOwner*;
}

extern fn compiler_world_get(world: void*, entity: void*, kind: u32): void*;

fn syntax_baseline_dispose(value: SyntaxBaseline*): void {
    frontend_revision_release(value.revision);
    if value.document is not null {
        entity_release(value.document);
    }
    vector_dispose(&value.source);
    *value = default;
}

fn syntax_baselines_owner(world: void*, create: bool): SyntaxBaselines* {
    var cache = compiler_world_grammar(world);
    if cache.syntax is not null {
        return bits(SyntaxBaselines*, cache.syntax);
    }
    if !create || compiler_world_pinned(world) {
        return null;
    }
    var owner = alloc(SyntaxBaselines, 1);
    if owner is null {
        return null;
    }
    *owner = default;
    cache.syntax = bits(void*, owner);
    return owner;
}

// Optional reuse has the same exact structural/profile key as session caches.
// Never carry entries across worlds, budget owners or immutable seed revisions.
// Failure to reserve cache metadata leaves the caller's private cache usable.
export fn syntax_world_structures(world: void*, bedrock: FrontendRevision*): ParserStructureCache* {
    if compiler_world_pinned(world) { return null; }
    var owner = syntax_baselines_owner(world, false);
    if owner == null { return null; }
    var budget = compiler_world_work_budget(world);
    var shared = owner.structures;
    if shared == null {
        var storage: WorkBuffer = default;
        if work_buffer_resize(&storage, budget, sizeof(SyntaxStructureOwner), 0) != WorkBudgetError.None { return null; }
        shared = bits(SyntaxStructureOwner*, storage.data);
        *shared = {storage: storage, ..default};
        owner.structures = shared;
    }
    if shared.bedrock != bedrock || shared.cache.budget != budget {
        parser_structure_cache_dispose(&shared.cache);
        frontend_revision_release(shared.bedrock);
        shared.bedrock = frontend_revision_retain(bedrock);
        shared.cache = {world: world, budget: budget, limit: FrontendCacheLimit, ..default};
    }
    return &shared.cache;
}

// Requests have joined before this coordinator boundary. Tables keep their own
// pins; surplus intermediate grammar plans need not survive semantic checking.
export fn syntax_world_structures_clear(world: void*): void {
    var owner = syntax_baselines_owner(world, false);
    if owner == null || owner.structures == null { return; }
    var shared = owner.structures;
    owner.structures = null;
    parser_structure_cache_dispose(&shared.cache);
    frontend_revision_release(shared.bedrock);
    var storage = shared.storage;
    work_buffer_dispose(&storage);
}

// Returns an owned revision pin. Existing snapshots can be read under an ECS
// view, but first construction/publication/reset requires the coordinator.
export fn syntax_world_revision(world: void*, mode: u32): FrontendRevision* {
    if mode > SyntaxSeedBaseline {
        return null;
    }
    var owner = syntax_baselines_owner(world, mode != SyntaxFoundationBaseline);
    if owner is null {
        return null;
    }
    if mode == SyntaxFoundationBaseline {
        return frontend_revision_retain(owner.foundation.revision);
    }
    if mode == SyntaxBedrockBaseline && owner.bedrock.revision is not null {
        return frontend_revision_retain(owner.bedrock.revision);
    }
    if owner.seed is null {
        if compiler_world_pinned(world) {
            return null;
        }
        var document = frontend_world_bedrock(world);
        if document is null {
            return null;
        }
        owner.seed = syntax_revision_document(document, compiler_world_type(world, CompilerSyntax));
    }
    return frontend_revision_retain(owner.seed);
}

export fn syntax_world_matches(world: void*, source: u8*, length: usize, foundation: bool): bool {
    var owner = syntax_baselines_owner(world, false);
    if owner is null {
        return false;
    }
    var baseline = foundation ? &owner.foundation: &owner.bedrock;
    return baseline.revision is not null && syntax_bytes_compare(baseline.source.data, baseline.source.length, source, length) == 0;
}

// Caller has validated grammar semantics. Enforce ownership at this publication
// boundary; an explicit world must never accept another world's declaration nodes.
export fn syntax_world_publish(world: void*, source: u8*, length: usize, document: void*, revision: FrontendRevision*, foundation: bool): bool {
    if revision is null || document is null || compiler_world_pinned(world) {
        return false;
    }
    if compiler_world_get(world, document, CompilerSyntax) is null {
        return false;
    }
    foreach(var & alternative in &revision.alternatives) {
        if compiler_world_get(world, *alternative, CompilerSyntax) is null {
            return false;
        }
    }
    foreach(var & lexeme in &revision.tokens) {
        if compiler_world_get(world, *lexeme, CompilerSyntax) is null {
            return false;
        }
    }
    // Prepare the only fallible publication data before changing either baseline.
    var prepared: SyntaxBaseline = default;
    if !bytes_append(&prepared.source, source, length) {
        return false;
    }
    var owner = syntax_baselines_owner(world, true);
    if owner is null {
        vector_dispose(&prepared.source);
        return false;
    }
    prepared.document = document;
    entity_retain(document);
    prepared.revision = frontend_revision_retain(revision);
    var target = foundation ? &owner.foundation: &owner.bedrock;
    syntax_baseline_dispose(target);
    copy(target, &prepared, sizeof(SyntaxBaseline));
    // A new Bedrock invalidates future Foundation sessions. Existing pins survive.
    if !foundation {
        syntax_baseline_dispose(&owner.foundation);
    }
    return true;
}

fn syntax_baselines_clear(world: void*): void {
    var cache = compiler_world_grammar(world);
    var owner = bits(SyntaxBaselines*, cache.syntax);
    if owner is null {
        return;
    }
    syntax_world_structures_clear(world);
    frontend_revision_release(owner.seed);
    syntax_baseline_dispose(&owner.bedrock);
    syntax_baseline_dispose(&owner.foundation);
    free(owner);
    cache.syntax = null;
}
