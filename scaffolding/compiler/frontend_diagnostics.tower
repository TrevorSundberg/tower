import tower;
import lr_types;
import frontend_diagnostic_types;
import lr_analysis;
import lr_parser;
import lr_runtime;
import .library.vector;
import .library.work_vector;
import .library.work_vector_types;
import .library.work_buffer_types;
import .library.work_budget_types;
import .library.work_buffer;
import parser_markers;

var FrontendDiagnosticCandidates: usize = 64;
var FrontendDiagnosticSteps: usize = 8192;
var FrontendDiagnosticFrames: usize = 4096;
var FrontendDiagnosticLookahead: usize = 3;

// Error-only bounded lookahead correction. This pull protocol borrows numeric
// LR frames; it never copies parse trees or rewinds the real source stream.
struct FrontendDiagnostic {
    storage: WorkBuffer;
    owner: WorkBudget*;
    runtime: LRRuntime*;
    budget: LRProbeBudget;
    original: LRProbe*;
    stack: LRProbe*;
    continuation: LRProbe*;
    candidates: u32[FrontendDiagnosticCandidates];
    count: usize;
    index: usize;
    current: FrontendExpectation;
    options: work_vector(FrontendExpectation);
    phase: u32;
    accepted: u32;
    state: usize;
    offset: usize;
    position: usize;
    ahead: usize;
    lookahead: u32;
    prefix: bool;
    reader: bool;
    bad_input: bool;
    complete: bool;
    done: bool;
}

export fn frontend_diagnostic_destroy(d: FrontendDiagnostic*): void {
    if d == null {
        return;
    }
    lr_probe_destroy(d.original);
    lr_probe_destroy(d.stack);
    lr_probe_destroy(d.continuation);
    work_vector_dispose(&d.current.contexts);
    foreach(var & option in &d.options) {
        work_vector_dispose(&(*option).contexts);
    }
    work_vector_dispose(&d.options);
    var storage = d.storage;
    work_buffer_dispose(&storage);
}

export fn frontend_diagnostic_create(parser: LRParser*, prefix: bool,
reader: bool, bad_input: bool, lookahead: u32, offset: usize): FrontendDiagnostic* {
    var error = WorkBudgetError.None;
    return frontend_diagnostic_create_result(parser, prefix, reader, bad_input, lookahead, offset, &error);
}

export fn frontend_diagnostic_create_result(parser: LRParser*, prefix: bool,
    reader: bool, bad_input: bool, lookahead: u32, offset: usize, error: WorkBudgetError*): FrontendDiagnostic* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if parser == null || parser.runtime == null { return null; }
    var storage: WorkBuffer = default;
    *error = work_buffer_resize(&storage, parser.runtime.budget, sizeof(FrontendDiagnostic), 0);
    if *error != WorkBudgetError.None { return null; }
    var d = bits(FrontendDiagnostic*, storage.data);
    *d = {storage: storage, owner: parser.runtime.budget, ..default};
    d.runtime = parser.runtime;
    d.prefix = prefix;
    d.reader = reader;
    d.bad_input = bad_input;
    d.lookahead = lookahead;
    d.offset = offset;
    d.complete = true;
    d.budget.remaining = FrontendDiagnosticSteps;
    d.budget.complete = true;
    var count = lr_parser_frame_count(parser);
    var invalid = count == 0;
    if count > FrontendDiagnosticFrames {
        invalid = true;
    }
    if invalid {
        d.done = true;
        return d;
    }
    d.original = lr_probe_create(parser, &d.budget);
    if d.original == null {
        *error = d.budget.resource_error;
        frontend_diagnostic_destroy(d);
        return null;
    }
    var frames = lr_probe_frames(d.original);
    var last = count -1;
    var state = frames[last].state;
    var actions = lr_runtime_actions(d.runtime, state);
    d.count = lr_runtime_action_count(d.runtime, state);
    var capacity = sizeof(decltype(d.candidates)) / sizeof(u32);
    if d.count > capacity {
        d.count = capacity;
        d.complete = false;
    }
    // Runtime rows are already sorted by first terminal ID. No extra sort or
    // unbounded candidate allocation is necessary on an error path.
    for(var i: usize = 0; i != d.count; i++) {
        d.candidates[i] = actions[i].first;
    }
    return d;
}

fn frontend_diagnostic_consume(d: FrontendDiagnostic*, id: u32): u32 {
    var previous = lr_probe_clone(d.continuation);
    if previous == null {
        return 0;
    }
    var before: usize;
    var status = lr_probe_step(d.continuation, id, &before);
    var boundary = d.prefix;
    if !(id != 4294967294) {
        boundary = false;
    }
    if boundary {
        var accepted = status == 2;
        if status == 0 {
            var ending = lr_probe_step(previous, 4294967294, &before);
            accepted = ending == 2;
        }
        if accepted {
            lr_probe_reset(d.continuation);
            status = lr_probe_step(d.continuation, id, &before);
        }
    }
    lr_probe_destroy(previous);
    return status;
}

// Called only for the state preceding a hypothetical expected terminal. The
// positions are the table's ordered derived LR items, never user intent guesses.
export fn frontend_diagnostic_contexts(d: FrontendDiagnostic*, items: FrontendContextPosition*, count: usize): void {
    var frames = lr_probe_frames(d.stack);
    var frame_count = lr_probe_count(d.stack);
    var i: usize = 0;
    loop {
        var done = i == count;
        if done {
            break;
        }
        var item = &items[i];
        var active = item.term != 0;
        var last = frame_count -1;
        var within = item.term < last;
        if !within {
            active = false;
        }
        if active {
            var begin = last -item.term;
            var position = begin;
            var consumed: bool = false;
            loop {
                done = position == last;
                if done {
                    break;
                }
                if frames[position].consumed {
                    consumed = true;
                    break;
                }
                position++;
            }
            var rule = &d.runtime.rules.data[item.production];
            active = consumed;
            within = item.term < rule.count;
            if !within {
                active = false;
            }
            if active {
                active = item.terminal;
                within = d.current.id >= item.first;
                if !within {
                    active = false;
                }
                within = d.current.id <= item.last;
                if !within {
                    active = false;
                }
                if active {
                    var context: FrontendRulePosition;
                    context.production = item.production;
                    context.term = item.term;
                    var error = work_vector_push_result(&d.current.contexts, d.owner, context);
                    if error != WorkBudgetError.None {
                        lr_probe_failure(&d.budget, error);
                        d.complete = false;
                        d.done = true;
                        return;
                    }
                }
            }
        }
        i++;
    }
    d.phase = 2;
}

export fn frontend_diagnostic_feed(d: FrontendDiagnostic*, valid: bool, position: usize, id: u32): void {
    d.position = position;
    if !valid {
        d.current.insertion = false;
        d.complete = false;
        d.phase = 4;
        return;
    }
    var status = frontend_diagnostic_consume(d, id);
    d.current.insertion = status != 0;
    d.ahead++;
    if id == 4294967294 {
        d.phase = 4;
    }
}

// 0 finished; 1 requests table item positions; 2 requests a contextual lexer
// lookahead. Hosts only supply borrowed data and input, not repair decisions.
export fn frontend_diagnostic_next(d: FrontendDiagnostic*): u32 {
    loop {
        if d.budget.resource_error != WorkBudgetError.None { d.done = true; }
        if d.done {
            return 0;
        }
        var begin = d.phase == 0;
        if begin {
            if d.index == d.count {
                d.done = true;
                return 0;
            }
            d.stack = lr_probe_clone(d.original);
            if d.stack == null {
                d.complete = false;
                d.done = true;
                return 0;
            }
            d.current.id = d.candidates[d.index];
            d.index++;
            d.state = lr_none();
            d.accepted = lr_probe_step(d.stack, d.current.id, &d.state);
            if d.accepted == 0 {
                lr_probe_destroy(d.stack);
                d.stack = null;
                continue;
            }
            d.phase = 2;
            if d.state != lr_none() {
                d.phase = 1;
                return 1;
            }
        }
        if d.phase == 1 {
            return 1;
        }
        begin = d.phase == 2;
        if begin {
            d.phase = 4;
            var can_insert = d.accepted == 1;
            if !(d.current.id != 4294967294) {
                can_insert = false;
            }
            if !d.reader {
                if d.bad_input {
                    can_insert = false;
                }
            }
            if can_insert {
                d.continuation = lr_probe_clone(d.stack);
                d.current.insertion = d.continuation != null;
                d.position = d.offset;
                d.ahead = 0;
                if d.current.insertion {
                    if d.reader {
                        d.phase = 3;
                    } else {
                        var status = frontend_diagnostic_consume(d, d.lookahead);
                        d.current.insertion = status != 0;
                    }
                }
            }
        }
        if d.phase == 3 {
            var more = d.ahead < FrontendDiagnosticLookahead;
            if !d.current.insertion {
                more = false;
            }
            if more {
                var frames = lr_probe_frames(d.continuation);
                var last = lr_probe_count(d.continuation);
                last--;
                d.state = frames[last].state;
                return 2;
            }
            d.phase = 4;
        }
        if d.phase == 4 {
            var boundary = d.current.insertion;
            if !d.prefix {
                boundary = false;
            }
            if boundary {
                var end = lr_probe_clone(d.stack);
                if end != null {
                    var before: usize;
                    var status = lr_probe_step(end, 4294967294, &before);
                    d.current.completes = status == 2;
                }
                lr_probe_destroy(end);
            }
            if d.budget.resource_error != WorkBudgetError.None { d.done = true; return 0; }
            var error = work_vector_push_result(&d.options, d.owner, d.current);
            if error != WorkBudgetError.None {
                lr_probe_failure(&d.budget, error);
                d.complete = false;
                d.done = true;
                return 0;
            }
            d.current = default;
            lr_probe_destroy(d.stack);
            lr_probe_destroy(d.continuation);
            d.stack = null;
            d.continuation = null;
            d.phase = 0;
        }
    }
}

export fn frontend_diagnostic_state(d: FrontendDiagnostic*): usize {
    return d.state;
}

export fn frontend_diagnostic_position(d: FrontendDiagnostic*): usize {
    return d.position;
}

export fn frontend_diagnostic_count(d: FrontendDiagnostic*): usize {
    return d.options.length;
}

export fn frontend_diagnostic_expected(d: FrontendDiagnostic*, index: usize): FrontendExpectation* {
    return &d.options.data[index];
}

export fn frontend_diagnostic_complete(d: FrontendDiagnostic*): bool {
    if d.complete {
        return d.budget.complete;
    }
    return false;
}

export fn frontend_diagnostic_resource_error(d: FrontendDiagnostic*): WorkBudgetError {
    return d.budget.resource_error;
}
