import tower;
import frontend_compilation;
import foundation_types;
import foundation_tags;
import semantic_context;
import semantic_definitions;
import semantic_support;
import .library.vector;
import c_emitter;
import roku_runtime;

// Reuse the source emitters' disposable entity/owner index and text writer.
// Foundation nodes remain authoritative; no bytecode or alternate IR is read.
struct RokuEmitter {
    common: CEmitter;
    loop_id: usize;
    labels: usize;
    conditions: usize;
}

fn re_text(r: RokuEmitter*, text: u8*): void {
    ce_text(&r.common, text);
}

fn re_number(r: RokuEmitter*, n: usize): void {
    ce_number(&r.common, convert(u64, n));
}

fn re_fail(r: RokuEmitter*, message: u8*): void {
    ce_fail(&r.common, message);
}

fn re_id(r: RokuEmitter*, entity: void*): usize {
    return ce_id(&r.common, entity);
}

fn re_temp(r: RokuEmitter*, entity: void*): void {
    re_text(r, "t[");
    re_number(r, re_id(r, entity));
    re_text(r, "]");
}

fn re_slot(r: RokuEmitter*, entity: void*): void {
    var n = sem_get(entity);
    if n.global {
        re_text(r, "s.g[");
    }
    else {
        re_text(r, "v[");
    }
    re_number(r, re_id(r, entity));
    re_text(r, "]");
}

fn re_width(r: RokuEmitter*, t: FoundationType*): void {
    var boolean = t.scalar == SBool();
    if t.pointers != 0 {
        boolean = false;
    }
    if boolean {
        re_text(r, "1");
        return;
    }
    re_number(r, convert(usize, semantic_width(t)));
}

fn re_signed(r: RokuEmitter*, t: FoundationType*): void {
    if semantic_signed(t) {
        re_text(r, "true");
    }
    else {
        re_text(r, "false");
    }
}

fn re_hex(r: RokuEmitter*, bits: u64): void {
    var digits: u8[16];
    var at: usize = 16;
    var alphabet = "0123456789abcdef";
    loop {
        at--;
        var c_step1 = bits % 16;
        var digit = convert(usize, c_step1);
        digits[at] = alphabet[digit];
        bits = bits / 16;
        if at == 0 {
            break;
        }
    }
    re_text(r, "&h");
    sem_require(bytes_append(r.common.text, &digits[0], 16));
    re_text(r, "&");
}

fn re_comments(r: RokuEmitter*, n: FoundationNode*): void {
    if !r.common.comments {
        return;
    }
    if n.comments.length == 0 {
        return;
    }
    re_text(r, "' ");
    var i: usize = 0;
    loop {
        if i == n.comments.length {
            break;
        }
        var b = n.comments.data[i];
        // Every physical line is a comment, including CR-only metadata.
        if b == 13 {
            b = 10;
        }
        sem_require(vector_push(r.common.text, b));
        if b == 10 {
            re_text(r, "' ");
        }
        i++;
    }
    re_text(r, "\n");
}

fn re_prepare_address(r: RokuEmitter*, entity: void*): void {
    var n = sem_get(entity);
    if n.kind == KLoad() {
        re_prepare(r, n.value);
        return;
    }
    var place = n.kind == KField();
    if n.kind == KIndex() {
        place = true;
    }
    if place {
        if n.indirect {
            re_prepare(r, n.left);
        }
        else {
            re_prepare_address(r, n.left);
        }
        if n.kind == KIndex() {
            re_prepare(r, n.right);
        }
    }
}

fn re_address(r: RokuEmitter*, entity: void*): void {
    var n = sem_get(entity);
    if n.kind == KLoad() {
        re_temp(r, n.value);
        return;
    }
    var place = n.kind == KField();
    if n.kind == KIndex() {
        place = true;
    }
    if place {
        re_text(r, "tr_offset(");
        if n.indirect {
            re_temp(r, n.left);
        }
        else {
            re_address(r, n.left);
        }
        re_text(r, ", ");
        if n.kind == KIndex() {
            re_temp(r, n.right);
            re_text(r, ", ");
            re_number(r, semantic_size(&n.type));
        }
        else {
            re_number(r, n.byte_offset);
            re_text(r, ", 1");
        }
        re_text(r, ")");
        return;
    }
    var binding = n.binding;
    if binding == null {
        binding = entity;
    }
    re_slot(r, binding);
}

fn re_function(r: RokuEmitter*, entity: void*): void {
    var n = sem_get(entity);
    if n.external {
        if sem_equal(sem_name(n), "platform_write") {
            var valid = n.parameters.length == 3;
            if valid {
                var stream = sem_get(n.parameters.data[0]);
                var data = sem_get(n.parameters.data[1]);
                var length = sem_get(n.parameters.data[2]);
                var wrong = stream.type.scalar != SU32();
                if wrong {
                    valid = false;
                }
                wrong = stream.type.pointers != 0;
                if wrong {
                    valid = false;
                }
                wrong = data.type.scalar != SU8();
                if wrong {
                    valid = false;
                }
                wrong = data.type.pointers != 1;
                if wrong {
                    valid = false;
                }
                wrong = length.type.scalar != SUSize();
                if wrong {
                    valid = false;
                }
                wrong = length.type.pointers != 0;
                if wrong {
                    valid = false;
                }
                wrong = n.type.scalar != SI64();
                if wrong {
                    valid = false;
                }
                wrong = n.type.pointers != 0;
                if wrong {
                    valid = false;
                }
            }
            if !valid {
                re_fail(r, "Roku platform_write requires (u32, u8*, usize): i64");
            }
            re_text(r, "tr_write");
            return;
        }
        re_fail(r, "Roku target supports only the platform_write foreign function; provide a Tower implementation");
    }
    re_text(r, "tr_fn_");
    re_number(r, re_id(r, entity));
}

fn re_expression(r: RokuEmitter*, entity: void*): void {
    var n = sem_get(entity);
    if n.kind == KOperand() {
        if n.constant {
            var c_step15 = n.bits &semantic_mask(&n.type);
            re_hex(r, c_step15);
        }
        else {
            re_text(r, "tr_load(s, ");
            re_slot(r, n.binding);
            re_text(r, ", ");
            re_number(r, semantic_size(&n.type));
            re_text(r, ")");
        }
        return;
    }
    if n.kind == KString() {
        re_text(r, "s.g[");
        re_number(r, re_id(r, entity));
        re_text(r, "]");
        return;
    }
    if n.kind == KAddress() {
        re_address(r, n.value);
        return;
    }
    var load = n.kind == KLoad();
    if n.kind == KField() {
        load = true;
    }
    if n.kind == KIndex() {
        load = true;
    }
    if load {
        re_text(r, "tr_load(s, ");
        re_address(r, entity);
        re_text(r, ", ");
        re_number(r, semantic_size(&n.type));
        re_text(r, ")");
        return;
    }
    if n.kind == KCall() {
        re_function(r, n.binding);
        re_text(r, "(s, [");
        var i: usize = 0;
        loop {
            if i == n.items.length {
                break;
            }
            if i != 0 {
                re_text(r, ", ");
            }
            re_temp(r, n.items.data[i]);
            i++;
        }
        re_text(r, "])");
        return;
    }
    if n.kind == KSizeOf() {
        re_number(r, semantic_size(&n.element));
        re_text(r, "&");
        return;
    }
    if n.kind == KAlignOf() {
        re_number(r, semantic_alignment(&n.element));
        re_text(r, "&");
        return;
    }
    if n.kind == KAllocate() {
        re_text(r, "tr_alloc(s, tr_count(");
        re_temp(r, n.right);
        re_text(r, ", ");
        re_number(r, semantic_size(&n.element));
        re_text(r, "))");
        return;
    }
    if n.kind == KReallocate() {
        re_text(r, "tr_realloc(s, ");
        re_temp(r, n.left);
        re_text(r, ", tr_count(");
        re_temp(r, n.right);
        re_text(r, ", ");
        re_number(r, semantic_size(&n.element));
        re_text(r, "))");
        return;
    }
    var conversion = n.kind == KConvert();
    if n.kind == KBits() {
        conversion = true;
    }
    if conversion {
        var from = sem_get(n.value);
        re_text(r, "tr_convert(");
        re_temp(r, n.value);
        re_text(r, ", ");
        re_width(r, &from.type);
        re_text(r, ", ");
        re_signed(r, &from.type);
        re_text(r, ", ");
        re_width(r, &n.type);
        re_text(r, ", ");
        re_signed(r, &n.type);
        re_text(r, ", ");
        if n.kind == KConvert() {
            re_text(r, "true");
        }
        else {
            re_text(r, "false");
        }
        re_text(r, ")");
        return;
    }
    if n.kind == KBinary() {
        var from = sem_get(n.left);
        var pointer_math = from.type.pointers != 0;
        if n.op > OSub() {
            pointer_math = false;
        }
        if pointer_math {
            var element: FoundationType;
            copy(&element, &from.type, sizeof(FoundationType));
            element.pointers--;
            re_text(r, "tr_offset(");
            re_temp(r, n.left);
            re_text(r, ", ");
            if n.op == OSub() {
                re_text(r, "tr_neg(");
            }
            re_temp(r, n.right);
            if n.op == OSub() {
                re_text(r, ")");
            }
            re_text(r, ", ");
            re_number(r, semantic_size(&element));
            re_text(r, ")");
            return;
        }
        // The emitter selects a helper from the shared operation definition.
        // There is no serialized instruction dispatch table or public opcode ABI.
        if n.op == OAdd() {
            re_text(r, "tr_add(");
        }
        if n.op == OSub() {
            re_text(r, "tr_sub(");
        }
        if n.op == OMul() {
            re_text(r, "tr_mul(");
        }
        if n.op == ODiv() {
            re_text(r, "tr_div(");
        }
        if n.op == ORem() {
            re_text(r, "tr_rem(");
        }
        if n.op == OAnd() {
            re_text(r, "tr_and(");
        }
        if n.op == OOr() {
            re_text(r, "tr_or(");
        }
        if n.op == OXor() {
            re_text(r, "tr_xor(");
        }
        if n.op >= OEq() {
            re_text(r, "tr_bool(tr_compare(");
        }
        re_temp(r, n.left);
        re_text(r, ", ");
        re_temp(r, n.right);
        re_text(r, ", ");
        re_width(r, &from.type);
        re_text(r, ", ");
        re_signed(r, &from.type);
        re_text(r, ")");
        if n.op >= OEq() {
            if n.op == OEq() {
                re_text(r, " = 0)");
            }
            if n.op == ONe() {
                re_text(r, " <> 0)");
            }
            if n.op == OLt() {
                re_text(r, " < 0)");
            }
            if n.op == OLe() {
                re_text(r, " <= 0)");
            }
            if n.op == OGt() {
                re_text(r, " > 0)");
            }
            if n.op == OGe() {
                re_text(r, " >= 0)");
            }
        }
        return;
    }
    re_fail(r, "Unsupported Foundation value in Roku emitter");
}

fn re_prepare(r: RokuEmitter*, entity: void*): void {
    if entity == null {
        return;
    }
    var n = sem_get(entity);
    if n.kind == KAddress() {
        re_prepare_address(r, n.value);
    }
    else {
        var place = n.kind == KField();
        if n.kind == KIndex() {
            place = true;
        }
        if n.kind == KLoad() {
            place = true;
        }
        if place {
            re_prepare_address(r, entity);
        }
        else {
            re_prepare(r, n.left);
            re_prepare(r, n.right);
            re_prepare(r, n.value);
            var i: usize = 0;
            loop {
                if i == n.items.length {
                    break;
                }
                re_prepare(r, n.items.data[i]);
                i++;
            }
        }
    }
    re_text(r, "    ");
    if ce_value_kind(n) {
        re_temp(r, entity);
        re_text(r, " = ");
    }
    re_expression(r, entity);
    re_text(r, "\n");
}

fn re_store(r: RokuEmitter*, target: void*, value: void*): void {
    var n = sem_get(target);
    re_text(r, "    tr_store(s, ");
    re_address(r, target);
    re_text(r, ", ");
    re_temp(r, value);
    re_text(r, ", ");
    re_number(r, semantic_size(&n.type));
    re_text(r, ")\n");
}

fn re_statement(r: RokuEmitter*, entity: void*): void {
    if entity == null {
        return;
    }
    var n = sem_get(entity);
    if n.kind == KFunction() {
        return;
    }
    re_comments(r, n);
    if n.kind == KType() {
        return;
    }
    var list = n.kind == KProgram();
    if n.kind == KBlock() {
        list = true;
    }
    if list {
        var i: usize = 0;
        loop {
            if i == n.items.length {
                break;
            }
            re_statement(r, n.items.data[i]);
            i++;
        }
        return;
    }
    if n.kind == KDeclare() {
        if n.value != null {
            re_prepare(r, n.value);
            re_store(r, entity, n.value);
        }
        else {
            re_text(r, "    tr_fill(s, ");
            re_slot(r, entity);
            re_text(r, ", 0, ");
            re_number(r, semantic_size(&n.type));
            re_text(r, ")\n");
        }
        return;
    }
    if n.kind == KAssign() {
        re_prepare_address(r, n.target);
        re_prepare(r, n.value);
        re_store(r, n.target, n.value);
        return;
    }
    if n.kind == KIf() {
        r.conditions++;
        re_prepare(r, n.value);
        re_text(r, "    if ");
        re_temp(r, n.value);
        re_text(r, " <> 0 then\n");
        re_statement(r, n.body);
        if n.otherwise != null {
            re_text(r, "    else\n");
            re_statement(r, n.otherwise);
        }
        re_text(r, "    end if\n");
        return;
    }
    if n.kind == KLoop() {
        var parent = r.loop_id;
        r.loop_id = re_id(r, entity);
        r.labels = r.labels + 2;
        re_text(r, "tr_loop_");
        re_number(r, r.loop_id);
        re_text(r, ":\n");
        re_statement(r, n.body);
        re_text(r, "    goto tr_loop_");
        re_number(r, r.loop_id);
        re_text(r, "\ntr_break_");
        re_number(r, r.loop_id);
        re_text(r, ":\n");
        r.loop_id = parent;
        return;
    }
    if n.kind == KBreak() {
        re_text(r, "    goto tr_break_");
        re_number(r, r.loop_id);
        re_text(r, "\n");
        return;
    }
    if n.kind == KContinue() {
        re_text(r, "    goto tr_loop_");
        re_number(r, r.loop_id);
        re_text(r, "\n");
        return;
    }
    if n.kind == KReturn() {
        re_prepare(r, n.value);
        re_text(r, "    tr_free(s, frame)\n    return ");
        if n.value != null {
            re_temp(r, n.value);
        }
        else {
            re_text(r, "invalid");
        }
        re_text(r, "\n");
        return;
    }
    if n.kind == KLabel() {
        r.labels++;
        re_text(r, "tr_label_");
        re_number(r, re_id(r, entity));
        re_text(r, ":\n");
        return;
    }
    if n.kind == KJump() {
        re_text(r, "    goto tr_label_");
        re_number(r, re_id(r, n.binding));
        re_text(r, "\n");
        return;
    }
    if n.kind == KPrint() {
        re_prepare(r, n.value);
        var value = sem_get(n.value);
        re_text(r, "    tr_print(s, ");
        re_temp(r, n.value);
        re_text(r, ", ");
        re_width(r, &value.type);
        re_text(r, ", ");
        re_signed(r, &value.type);
        re_text(r, ", ");
        if value.type.pointers != 0 {
            re_text(r, "true");
        }
        else {
            re_text(r, "false");
        }
        re_text(r, ")\n");
        return;
    }
    if n.kind == KFree() {
        re_prepare(r, n.left);
        re_text(r, "    tr_free(s, ");
        re_temp(r, n.left);
        re_text(r, ")\n");
        return;
    }
    var memory = n.kind == KCopy();
    if n.kind == KFill() {
        memory = true;
    }
    if memory {
        re_prepare(r, n.left);
        re_prepare(r, n.right);
        re_prepare(r, n.value);
        if n.kind == KCopy() {
            re_text(r, "    tr_copy(s, ");
        }
        else {
            re_text(r, "    tr_fill(s, ");
        }
        re_temp(r, n.left);
        re_text(r, ", ");
        re_temp(r, n.right);
        re_text(r, ", ");
        re_temp(r, n.value);
        re_text(r, ")\n");
        return;
    }
    if n.kind == KTrap() {
        re_prepare(r, n.left);
        re_prepare(r, n.right);
        re_text(r, "    tr_trap(tr_string(s, ");
        re_temp(r, n.left);
        re_text(r, ", ");
        re_temp(r, n.right);
        re_text(r, "))\n");
        return;
    }
    if n.kind == KCall() {
        re_prepare(r, entity);
        return;
    }
    re_fail(r, "Unsupported Foundation statement in Roku emitter");
}

fn re_storage(r: RokuEmitter*, entity: void*, owner: void*, globals: bool): bool {
    var n = sem_get(entity);
    var variable = n.kind == KDeclare();
    if n.kind == KParameter() {
        variable = true;
    }
    if globals {
        if variable {
            return n.global;
        }
        return false;
    }
    if n.global {
        return false;
    }
    var id = re_id(r, entity);
    var same = r.common.owners.data[id] == owner;
    if variable {
        return same;
    }
    return false;
}

fn re_body(r: RokuEmitter*, entity: void*, program: bool): void {
    r.labels = 0;
    r.conditions = 0;
    var i: usize = 0;
    var size: usize = 0;
    loop {
        if i == r.common.nodes.length {
            break;
        }
        var item = r.common.nodes.data[i];
        var n = sem_get(item);
        if re_storage(r, item, entity, false) {
            var c_step82 = size + semantic_size(&n.type);
            size = c_step82 + 7;
            var c_step83 = size / 8;
            size = c_step83 * 8;
        }
        i++;
    }
    re_text(r, "    t = []\n    v = []\n    frame = tr_alloc(s, ");
    re_number(r, size);
    re_text(r, ")\n");
    i = 0;
    size = 0;
    loop {
        if i == r.common.nodes.length {
            break;
        }
        var item = r.common.nodes.data[i];
        var n = sem_get(item);
        if re_storage(r, item, entity, false) {
            re_text(r, "    ");
            re_slot(r, item);
            re_text(r, " = frame + ");
            re_number(r, size);
            re_text(r, "&\n");
            var c_step85 = size + semantic_size(&n.type);
            size = c_step85 + 7;
            var c_step86 = size / 8;
            size = c_step86 * 8;
        }
        i++;
    }
    var n = sem_get(entity);
    i = 0;
    loop {
        if i == n.parameters.length {
            break;
        }
        var item = n.parameters.data[i];
        var param = sem_get(item);
        re_text(r, "    tr_store(s, ");
        re_slot(r, item);
        re_text(r, ", args[");
        re_number(r, i);
        re_text(r, "], ");
        re_number(r, semantic_size(&param.type));
        re_text(r, ")\n");
        i++;
    }
    if program {
        re_statement(r, entity);
    }
    else {
        re_statement(r, n.body);
    }
    re_text(r, "    tr_free(s, frame)\n    return invalid\nend function\n\n");
    // Conservative limits from wasm2brs device findings. Arrays avoid local and
    // parameter limits; diagnose large control flow instead of emitting bad BRS.
    if r.labels > 240 {
        re_fail(r, "Roku function exceeds the 240-label profile limit; split the function or enable optimization");
    }
    if r.conditions > 200 {
        re_fail(r, "Roku function exceeds the 200-conditional profile limit; split the function or enable optimization");
    }
}

export fn roku_emit(text: vector(u8)*, error: vector(u8)*, root: void*, pointer_bytes: u32, comments: bool): void {
    var r: RokuEmitter = default;
    r.common.text = text;
    r.common.error = error;
    r.common.comments = comments;
    if pointer_bytes != 4 {
        re_fail(&r, "Roku source requires the explicit 32-bit little endian profile");
        return;
    }
    ce_collect(&r.common, root, root);
    re_text(&r, "' Tower Roku profile 1: 32-bit byte addresses, exact integer arithmetic.\n' Generated platform source; canonical Foundation remains the program format.\n' Call TowerRun() from Main or a SceneGraph Task. Physical-device validation pending.\n\n");
    re_runtime(&r);
    re_text(&r, "function TowerRun(output = invalid as dynamic, memoryLimit = 67108864 as integer) as object\n    s = tr_state(output, memoryLimit)\n");
    var i: usize = 0;
    loop {
        if i == r.common.nodes.length {
            break;
        }
        var item = r.common.nodes.data[i];
        var n = sem_get(item);
        if re_storage(&r, item, root, true) {
            re_text(&r, "    ");
            re_slot(&r, item);
            re_text(&r, " = tr_alloc(s, ");
            re_number(&r, semantic_size(&n.type));
            re_text(&r, ")\n");
        }
        if n.kind == KString() {
            re_text(&r, "    s.g[");
            re_number(&r, i);
            re_text(&r, "] = tr_alloc(s, ");
            var c_step93 = n.name.length + 1;
            re_number(&r, c_step93);
            re_text(&r, ")\n");
            var at: usize = 0;
            loop {
                if at == n.name.length {
                    break;
                }
                re_text(&r, "    tr_store(s, s.g[");
                re_number(&r, i);
                re_text(&r, "] + ");
                re_number(&r, at);
                re_text(&r, ", ");
                re_number(&r, convert(usize, n.name.data[at]));
                re_text(&r, ", 1)\n");
                at++;
            }
        }
        i++;
    }
    re_text(&r, "    tr_entry(s, [])\n    return s\nend function\n\n");
    i = 0;
    loop {
        if i == r.common.nodes.length {
            break;
        }
        var item = r.common.nodes.data[i];
        var n = sem_get(item);
        if n.kind == KFunction() {
            if !n.external {
                re_comments(&r, n);
                re_text(&r, "function ");
                re_function(&r, item);
                re_text(&r, "(s as object, args as object) as dynamic\n");
                re_body(&r, item, false);
            }
        }
        i++;
    }
    re_text(&r, "function tr_entry(s as object, args as object) as dynamic\n");
    re_body(&r, root, true);
    if text.length > 1900000 {
        re_fail(&r, "Roku source exceeds the single-file profile limit (1.9 MB); split the program");
    }
    var lines: usize = 0;
    i = 0;
    loop {
        if i == text.length {
            break;
        }
        if text.data[i] == 10 {
            lines++;
        }
        i++;
    }
    if lines > 60000 {
        re_fail(&r, "Roku source exceeds the 60000-line profile limit; split the program");
    }
    vector_dispose(&r.common.nodes);
    vector_dispose(&r.common.owners);
    vector_dispose(&r.common.active);
    vector_dispose(&r.common.returning);
    if error.length != 0 {
        text.length = 0;
    }
}
