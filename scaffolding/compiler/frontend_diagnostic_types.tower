import tower;
import .library.vector;
import .library.work_vector_types;

struct FrontendRulePosition {
    production: usize;
    term: usize;
}

struct FrontendContextPosition {
    production: usize;
    term: usize;
    first: u32;
    last: u32;
    terminal: bool;
}

struct FrontendExpectation {
    id: u32;
    insertion: bool;
    completes: bool;
    contexts: work_vector(FrontendRulePosition);
}
