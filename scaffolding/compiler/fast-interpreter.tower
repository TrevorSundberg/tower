import tower;

// Private, disposable execution cache of checked foundation nodes. This is not
// an interchange format or a second semantic IR. No graph pointers or compiler
// metadata occur in the instruction words. Cold provenance/type/binding tables
// retain references to the owning program. The entire compiler and runner here
// use ordinary Foundation operations, with no computed goto, JIT or native ABI.
struct FMFunction {
    node: void*;
    entry: usize;
    registers: usize;
    frame_size: usize;
    parameters: usize;
    parameter_count: usize;
    external: bool;
    pinned: usize;
}

struct FMParameter {
    offset: usize;
    size: usize;
    register_slot: usize;
}

struct FMConversion {
    from: FoundationType*;
    to: FoundationType*;
}

struct FMSource {
    pc: usize;
    offset: usize;
}

struct FMFrame {
    pc: usize;
    base: usize;
    registers: usize;
    result: usize;
    count: usize;
}

struct FMState {
    words: vector(u32);
    constants: vector(u64);
    functions: vector(FMFunction);
    parameters: vector(FMParameter);
    types: vector(FoundationType*);
    conversions: vector(FMConversion);
    strings: vector(void*);
    sources: vector(FMSource);
    registers: vector(u64);
    frames: vector(FMFrame);
    labels: vector(IMEntry);
    jumps: vector(IMEntry);
    locals: vector(IMEntry);
    escaped: vector(u64);
    pinned: usize;
    next_register: usize;
    max_register: usize;
    pc: usize;
    base: usize;
    register_base: usize;
    register_count: usize;
    current_offset: usize;
    instructions: usize;
    wide_instructions: usize;
    preserve_error_offset: bool;
}

fn fm_push(T: type, values: vector(T)*, value: T*): void {
    var needed = values.length + 1;
    im_storage_require(vector_reserve(T, values, needed));
    copy(&values.data[values.length], value, sizeof(T));
    values.length = needed;
}

fn fm_trim(T: type, values: vector(T)*): void {
    var empty = values.length == 0;
    if empty {
        vector_dispose(T, values);
        return;
    }
    var exact = values.length == values.capacity;
    if exact {
        return;
    }
    var data = realloc(T, values.data, values.length);
    var ok = data != null;
    im_storage_require(ok);
    values.data = data;
    values.capacity = values.length;
}

fn fm_register(f: FMState*): usize {
    var result = f.next_register;
    f.next_register = result + 1;
    var larger = f.next_register > f.max_register;
    if larger {
        f.max_register = f.next_register;
    }
    return result;
}

fn fm_word(f: FMState*, value: usize): void {
    im_storage_require(vector_push(u32, &f.words, convert(u32, value)));
}

fn fm_emit(f: FMState*, op: usize, a: usize, b: usize, c: usize): usize {
    var at = f.words.length;
    var mark = true;
    var nonempty = f.sources.length != 0;
    if nonempty {
        var last = f.sources.length - 1;
        mark = f.sources.data[last].offset != f.current_offset;
    }
    if mark {
        var source: FMSource;
        source.pc = at;
        source.offset = f.current_offset;
        fm_push(FMSource, &f.sources, &source);
    }
    f.instructions = f.instructions + 1;
    // Branch target extensions are one full word; common branch registers still
    // fit in the header. Patching never changes instruction boundaries.
    var jump = op == 13;
    if jump {
        fm_word(f, 13);
        fm_word(f, a);
        return at;
    }
    var branch = op == 14;
    var small_register = a <= 255;
    branch = im_and(branch, small_register);
    if branch {
        var header = a * 256;
        header = header + 14;
        fm_word(f, header);
        fm_word(f, b);
        return at;
    }
    var wide = a > 255;
    var fm_condition_1 = b > 255;

    wide = im_or(wide, fm_condition_1);
    var fm_condition_2 = c > 255;

    wide = im_or(wide, fm_condition_2);
    var fm_condition_3 = op == 13;

    // Branch patches always occupy five words so relocation never shifts code.
    wide = im_or(wide, fm_condition_3);
    var fm_condition_4 = op == 14;

    wide = im_or(wide, fm_condition_4);
    if wide {
        f.wide_instructions = f.wide_instructions + 1;
        fm_word(f, 255);
        fm_word(f, op);
        fm_word(f, a);
        fm_word(f, b);
        fm_word(f, c);
    } else {
        var word = c * 256;
        word = word + b;
        word = word * 256;
        word = word + a;
        word = word * 256;
        word = word + op;
        fm_word(f, word);
    }
    return at;
}

fn fm_patch(f: FMState*, at: usize, operand: usize, target: usize): void {
    var index = at + operand;
    var header = f.words.data[at] & 255;
    var compact = header != 255;
    if compact {
        index = at + 1;
    }
    f.words.data[index] = convert(u32, target);
}

fn fm_constant(f: FMState*, value: u64): usize {
    var index: usize = 0;
    loop {
        var end = index == f.constants.length;
        if end {
            break;
        }
        var same = f.constants.data[index] == value;
        if same {
            break;
        }
        index = index + 1;
    }
    var append = index == f.constants.length;
    if append {
        im_storage_require(vector_push(u64, &f.constants, value));
    }
    var result = fm_register(f);
    fm_emit(f, 0, result, index, 0);
    return result;
}

fn fm_type(f: FMState*, type: FoundationType*): usize {
    var index: usize = 0;
    loop {
        var end = index == f.types.length;
        if end {
            break;
        }
        var other = f.types.data[index];
        var same = type.scalar == other.scalar;
        var fm_condition_5 = type.pointers == other.pointers;

        same = im_and(same, fm_condition_5);
        var fm_condition_6 = type.record == other.record;

        same = im_and(same, fm_condition_6);
        var fm_condition_7 = type.pointer_bytes == other.pointer_bytes;

        same = im_and(same, fm_condition_7);
        if same {
            return index;
        }
        index = index + 1;
    }
    im_storage_require(vector_push(FoundationType*, &f.types, type));
    return index;
}

fn fm_tag(type: FoundationType*): usize {
    var size = im_type_size(type);
    var signed = im_type_signed(type);
    var small = size == 1;
    if small {
        return 0;
    }
    small = size == 4;
    if small {
        if signed {
            return 2;
        }
        return 1;
    }
    if signed {
        return 4;
    }
    return 3;
}

fn fm_function(f: FMState*, node: void*): usize {
    var index: usize = 0;
    loop {
        var end = index == f.functions.length;
        if end {
            break;
        }
        var same = f.functions.data[index].node == node;
        if same {
            return index;
        }
        index = index + 1;
    }
    var n = im_node(node);
    var function: FMFunction;
    fill(&function, 0, sizeof(FMFunction));
    function.node = node;
    function.external = n.external;
    function.frame_size = im_align(n.frame_size);
    function.parameters = f.parameters.length;
    function.parameter_count = n.parameters.length;
    var i: usize = 0;
    loop {
        var end = i == n.parameters.length;
        if end {
            break;
        }
        var param = im_node(n.parameters.data[i]);
        var value: FMParameter;
        value.offset = param.byte_offset;
        value.size = im_type_size(&param.type);
        value.register_slot = 0;
        fm_push(FMParameter, &f.parameters, &value);
        i = i + 1;
    }
    fm_push(FMFunction, &f.functions, &function);
    return index;
}

fn fm_local(f: FMState*, node: void*): usize {
    var n = im_node(node);
    var bound = n.binding != null;
    if bound {
        node = n.binding;
    }
    var key = im_key(node);
    var i: usize = 0;
    loop {
        var done = i == f.locals.length;
        if done {
            return 0;
        }
        var found = f.locals.data[i].key == key;
        if found {
            return convert(usize, f.locals.data[i].value);
        }
        i = i + 1;
    }
}

fn fm_collect_addresses(f: FMState*, node: void*): void {
    var absent = node == null;
    if absent {
        return;
    }
    var n = im_node(node);
    var address = n.kind == KAddress();
    if address {
        var place = n.value;
        loop {
            var target = im_node(place);
            var compound = target.kind == KField();
            var indexed = target.kind == KIndex();
            compound = im_or(compound, indexed);
            if compound {
                // Addressing through a pointer does not expose the local that
                // holds the pointer. Direct aggregate fields do expose storage.
                if target.indirect {
                    break;
                }
                place = target.left;
                continue;
            }
            var bound = target.binding != null;
            if bound {
                place = target.binding;
            }
            im_storage_require(vector_push(u64, &f.escaped, im_key(place)));
            break;
        }
    }
    var leaf = n.kind == KLabel();
    if leaf {
        return;
    }
    leaf = n.kind == KJump();
    if leaf {
        return;
    }
    leaf = n.kind == KFunction();
    if leaf {
        return;
    }
    leaf = n.kind == KType();
    if leaf {
        return;
    }
    fm_collect_addresses(f, n.value);
    fm_collect_addresses(f, n.target);
    fm_collect_addresses(f, n.left);
    fm_collect_addresses(f, n.right);
    fm_collect_addresses(f, n.body);
    fm_collect_addresses(f, n.otherwise);
    var i: usize = 0;
    loop {
        var done = i == n.items.length;
        if done {
            return;
        }
        fm_collect_addresses(f, n.items.data[i]);
        i = i + 1;
    }
}

fn fm_pin_locals(f: FMState*, index: usize, body: void*): void {
    // Register placement for scalar CFG functions. This is code generation,
    // not an optimizer: no operation, effect or control-flow edge is removed.
    // Address-bearing locals retain the ordinary target-memory layout.
    var block = im_node(body);
    var labeled = false;
    var i: usize = 0;
    loop {
        var done = i == block.items.length;
        if done {
            break;
        }
        var n = im_node(block.items.data[i]);
        var label = n.kind == KLabel();
        if label {
            labeled = true;
        }
        i = i + 1;
    }
    var omit = labeled == false;
    if omit {
        return;
    }
    f.escaped.length = 0;
    fm_collect_addresses(f, body);
    var node = im_node(f.functions.data[index].node);
    var all_registers = true;
    i = 0;
    loop {
        var done = i == node.locals.length;
        if done {
            break;
        }
        var local = im_node(node.locals.data[i]);
        var memory = local.global;
        var aggregate = local.type.scalar == 4;
        var array = local.type.scalar == 9;
        aggregate = im_or(aggregate, array);
        var value = local.type.pointers == 0;
        aggregate = im_and(aggregate, value);
        memory = im_or(memory, aggregate);
        var entry: IMEntry;
        entry.key = im_key(node.locals.data[i]);
        var j: usize = 0;
        loop {
            done = j == f.escaped.length;
            if done {
                break;
            }
            var escaped = f.escaped.data[j] == entry.key;
            memory = im_or(memory, escaped);
            j = j + 1;
        }
        if memory {
            all_registers = false;
        }
        else {
            var register = fm_register(f);
            register = register + 1;
            entry.value = convert(u64, register);
            fm_push(IMEntry, &f.locals, &entry);
        }
        i = i + 1;
    }
    f.pinned = f.next_register;
    f.functions.data[index].pinned = f.pinned;
    if all_registers {
        f.functions.data[index].frame_size = 0;
    }
    i = 0;
    loop {
        var done = i == node.parameters.length;
        if done {
            break;
        }
        var parameter = f.functions.data[index].parameters + i;
        f.parameters.data[parameter].register_slot = fm_local(f, node.parameters.data[i]);
        i = i + 1;
    }
}

fn fm_address(f: FMState*, node: void*): usize {
    var n = im_node(node);
    var load = n.kind == KLoad();
    if load {
        return fm_value(f, n.value);
    }
    var fm_condition_8 = n.kind == KField();
    var fm_condition_9 = n.kind == KIndex();

    var place = im_or(fm_condition_8, fm_condition_9);
    if place {
        var base: usize = 0;
        if n.indirect {
            base = fm_value(f, n.left);
        }
        else {
            base = fm_address(f, n.left);
        }
        var delta: usize = 0;
        var field = n.kind == KField();
        if field {
            delta = fm_constant(f, convert(u64, n.byte_offset));
        }
        else {
            delta = fm_value(f, n.right);
            var right = im_node(n.right);
            var signed = im_type_signed(&right.type);
            if signed {
                var copied = fm_register(f);
                fm_emit(f, 1, copied, delta, 0);
                delta = copied;
                fm_emit(f, 21, delta, fm_tag(&right.type), 0);
            }
            var size = fm_constant(f, convert(u64, im_type_size(&n.type)));
            var scaled = fm_register(f);
            fm_emit(f, 77, scaled, delta, size);
            delta = scaled;
        }
        var op: usize = 65;
        var wide = n.type.pointer_bytes == 8;
        if wide {
            op = 67;
        }
        var result = fm_register(f);
        fm_emit(f, op, result, base, delta);
        return result;
    }
    var binding = n;
    var bound = n.binding != null;
    if bound {
        binding = im_node(n.binding);
    }
    var op: usize = 2;
    if binding.global {
        op = 3;
    }
    var result = fm_register(f);
    fm_emit(f, op, result, binding.byte_offset, 0);
    return result;
}

fn fm_value(f: FMState*, node: void*): usize {
    var empty = node == null;
    if empty {
        return fm_constant(f, 0);
    }
    var n = im_node(node);
    var fm_condition_10 = n.kind == KOperand();

    var constant = im_and(fm_condition_10, n.constant);
    if constant {
        return fm_constant(f, n.bits);
    }
    var address = n.kind == KAddress();
    if address {
        return fm_address(f, n.value);
    }
    var query = n.kind == KSizeOf();
    if query {
        return fm_constant(f, convert(u64, im_type_size(&n.element)));
    }
    query = n.kind == KAlignOf();
    if query {
        return fm_constant(f, convert(u64, im_type_alignment(&n.element)));
    }
    var string = n.kind == KString();
    if string {
        var index = f.strings.length;
        im_storage_require(vector_push(void*, &f.strings, node));
        var result = fm_register(f);
        fm_emit(f, 18, result, index, 0);
        return result;
    }
    var operand = n.kind == KOperand();
    if operand {
        var slot = fm_local(f, node);
        var in_register = slot != 0;
        if in_register {
            slot = slot - 1;
            return slot;
        }
        var binding = n;
        var bound = n.binding != null;
        if bound {
            binding = im_node(n.binding);
        }
        var result = fm_register(f);
        var op: usize = 19;
        if binding.global {
            op = 23;
        }
        fm_emit(f, op, result, binding.byte_offset, im_type_size(&n.type));
        return result;
    }
    var fm_condition_11 = n.kind == KField();
    var fm_condition_12 = n.kind == KIndex();

    var place = im_or(fm_condition_11, fm_condition_12);
    var fm_condition_13 = n.kind == KLoad();

    place = im_or(place, fm_condition_13);
    if place {
        var address = fm_address(f, node);
        var result = fm_register(f);
        fm_emit(f, 4, result, address, im_type_size(&n.type));
        return result;
    }
    var call = n.kind == KCall();
    if call {
        var result = fm_register(f);
        var first = f.next_register;
        var i: usize = 0;
        loop {
            var end = i == n.items.length;
            if end {
                break;
            }
            fm_register(f);
            i = i + 1;
        }
        i = 0;
        loop {
            var end = i == n.items.length;
            if end {
                break;
            }
            var arg = fm_value(f, n.items.data[i]);
            var dest = first + i;
            fm_emit(f, 1, dest, arg, 0);
            i = i + 1;
        }
        fm_emit(f, 15, result, fm_function(f, n.binding), first);
        return result;
    }
    var fm_condition_14 = n.kind == KAllocate();
    var fm_condition_15 = n.kind == KReallocate();

    var allocation = im_or(fm_condition_14, fm_condition_15);
    if allocation {
        var pointer = fm_value(f, n.left);
        var count = fm_value(f, n.right);
        var result = fm_register(f);
        fm_emit(f, 1, result, pointer, 0);
        var op: usize = 8;
        var reallocating = n.kind == KReallocate();
        if reallocating {
            op = 9;
        }
        fm_emit(f, op, result, count, im_type_size(&n.element));
        return result;
    }
    var binary = n.kind == KBinary();
    if binary {
        var left = fm_value(f, n.left);
        var right = fm_value(f, n.right);
        var input = im_node(n.left);
        var pointer = input.type.pointers != 0;
        var fm_condition_16 = n.op == OAdd();
        var fm_condition_17 = n.op == OSub();

        var arithmetic = im_or(fm_condition_16, fm_condition_17);
        pointer = im_and(pointer, arithmetic);
        if pointer {
            var scaled = fm_register(f);
            fm_emit(f, 1, scaled, right, 0);
            right = scaled;
            var right_node = im_node(n.right);
            var signed = im_type_signed(&right_node.type);
            if signed {
                fm_emit(f, 21, right, fm_tag(&right_node.type), 0);
            }
            var size = fm_constant(f, convert(u64, im_pointee_size(&input.type)));
            fm_emit(f, 77, right, right, size);
        }
        var op = convert(usize, n.op) * 5;
        op = op + 64;
        op = op + fm_tag(&input.type);
        var result = fm_register(f);
        fm_emit(f, op, result, left, right);
        return result;
    }
    var value = fm_value(f, n.value);
    var converting = n.kind == KConvert();
    if converting {
        var input = im_node(n.value);
        var descriptor: FMConversion;
        descriptor.from = &input.type;
        descriptor.to = &n.type;
        var index = f.conversions.length;
        fm_push(FMConversion, &f.conversions, &descriptor);
        var result = fm_register(f);
        fm_emit(f, 7, result, value, index);
        return result;
    }
    // Bits preserves exactly the same width by the foundation verifier.
    return value;
}

fn fm_statement(f: FMState*, node: void*, breaks: vector(usize)*, continue_pc: usize): void {
    var n = im_node(node);
    f.current_offset = n.start;
    f.next_register = f.pinned;
    var label = n.kind == KLabel();
    if label {
        var entry: IMEntry;
        entry.key = im_key(node);
        entry.value = convert(u64, f.words.length);
        fm_push(IMEntry, &f.labels, &entry);
        return;
    }
    var jump_label = n.kind == KJump();
    if jump_label {
        var entry: IMEntry;
        entry.key = im_key(n.binding);
        var at = fm_emit(f, 13, 0, 0, 0);
        entry.value = convert(u64, at);
        fm_push(IMEntry, &f.jumps, &entry);
        return;
    }
    var trapping = n.kind == KTrap();
    if trapping {
        var message = fm_value(f, n.left);
        var offset = fm_value(f, n.right);
        fm_emit(f, 22, message, offset, 0);
        return;
    }
    var fm_condition_18 = n.kind == KBlock();
    var fm_condition_19 = n.kind == KProgram();

    var block = im_or(fm_condition_18, fm_condition_19);
    if block {
        var i: usize = 0;
        loop {
            var end = i == n.items.length;
            if end {
                break;
            }
            fm_statement(f, n.items.data[i], breaks, continue_pc);
            i = i + 1;
        }
        return;
    }
    var fm_condition_20 = n.kind == KFunction();
    var fm_condition_21 = n.kind == KType();

    var omitted = im_or(fm_condition_20, fm_condition_21);
    if omitted {
        return;
    }
    var declaration = n.kind == KDeclare();
    var fm_condition_22 = n.kind == KAssign();

    var assign = im_or(declaration, fm_condition_22);
    if assign {
        var has_value = n.value != null;
        if has_value {
            var target = n.target;
            if declaration {
                target = node;
            }
            var slot = fm_local(f, target);
            var in_register = slot != 0;
            if in_register {
                var value = fm_value(f, n.value);
                slot = slot - 1;
                fm_emit(f, 1, slot, value, 0);
                return;
            }
            var dest = fm_address(f, target);
            var value = fm_value(f, n.value);
            var target_node = im_node(target);
            fm_emit(f, 5, dest, value, im_type_size(&target_node.type));
        }
        return;
    }
    var conditional = n.kind == KIf();
    if conditional {
        var value = fm_value(f, n.value);
        var branch = fm_emit(f, 14, value, 0, 0);
        fm_statement(f, n.body, breaks, continue_pc);
        var jump = fm_emit(f, 13, 0, 0, 0);
        fm_patch(f, branch, 3, f.words.length);
        var has_else = n.otherwise != null;
        if has_else {
            fm_statement(f, n.otherwise, breaks, continue_pc);
        }
        fm_patch(f, jump, 2, f.words.length);
        return;
    }
    var loop_node = n.kind == KLoop();
    if loop_node {
        var local_breaks: vector(usize);
        vector_init(usize, &local_breaks);
        var start = f.words.length;
        fm_statement(f, n.body, &local_breaks, start);
        fm_emit(f, 13, start, 0, 0);
        var i: usize = 0;
        loop {
            var end = i == local_breaks.length;
            if end {
                break;
            }
            fm_patch(f, local_breaks.data[i], 2, f.words.length);
            i = i + 1;
        }
        vector_dispose(usize, &local_breaks);
        return;
    }
    var breaking = n.kind == KBreak();
    if breaking {
        var at = fm_emit(f, 13, 0, 0, 0);
        im_storage_require(vector_push(usize, breaks, at));
        return;
    }
    var continuing = n.kind == KContinue();
    if continuing {
        fm_emit(f, 13, continue_pc, 0, 0);
        return;
    }
    var returning = n.kind == KReturn();
    if returning {
        fm_emit(f, 16, fm_value(f, n.value), 0, 0);
        return;
    }
    var print = n.kind == KPrint();
    if print {
        var value = fm_value(f, n.value);
        var input = im_node(n.value);
        fm_emit(f, 17, value, fm_type(f, &input.type), 0);
        return;
    }
    var freeing = n.kind == KFree();
    if freeing {
        fm_emit(f, 10, fm_value(f, n.left), 0, 0);
        return;
    }
    var fm_condition_23 = n.kind == KCopy();
    var fm_condition_24 = n.kind == KFill();

    var memory = im_or(fm_condition_23, fm_condition_24);
    if memory {
        var left = fm_value(f, n.left);
        var right = fm_value(f, n.right);
        var count = fm_value(f, n.value);
        var op: usize = 11;
        var filling = n.kind == KFill();
        if filling {
            op = 12;
        }
        fm_emit(f, op, left, right, count);
        return;
    }
    fm_value(f, node);
}

export fn fast_interpreter_create(m: IMState*): FMState* {
    var f = alloc(FMState, 1);
    fill(f, 0, sizeof(FMState));
    var failed = m.failed;
    if failed {
        return f;
    }
    fm_function(f, im_root(m));
    var i: usize = 0;
    loop {
        var end = i == f.functions.length;
        if end {
            break;
        }
        var node = f.functions.data[i].node;
        var n = im_node(node);
        f.functions.data[i].entry = f.words.length;
        f.max_register = 1;
        f.next_register = 0;
        f.pinned = 0;
        f.locals.length = 0;
        var external = n.external;
        if external {} else {
            var body = n.body;
            var root = i == 0;
            if root {
                body = node;
            }
            fm_pin_locals(f, i, body);
            fm_statement(f, body, null, 0);
            f.next_register = f.pinned;
            fm_emit(f, 16, fm_constant(f, 0), 0, 0);
        }
        f.functions.data[i].registers = f.max_register;
        i = i + 1;
    }
    i = 0;
    loop {
        var done = i == f.jumps.length;
        if done {
            break;
        }
        var j: usize = 0;
        loop {
            var end = j == f.labels.length;
            var available = end == false;
            im_storage_require(available);
            var match = f.labels.data[j].key == f.jumps.data[i].key;
            if match {
                fm_patch(f, convert(usize, f.jumps.data[i].value), 2, convert(usize, f.labels.data[j].value));
                break;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    vector_dispose(IMEntry, &f.labels);
    vector_dispose(IMEntry, &f.jumps);
    vector_dispose(IMEntry, &f.locals);
    vector_dispose(u64, &f.escaped);
    f.base = 16;
    f.register_count = f.functions.data[0].registers;
    im_storage_require(vector_reserve(u64, &f.registers, f.register_count));
    f.registers.length = f.register_count;
    fm_trim(u32, &f.words);
    fm_trim(u64, &f.constants);
    fm_trim(FMFunction, &f.functions);
    fm_trim(FMParameter, &f.parameters);
    fm_trim(FoundationType*, &f.types);
    fm_trim(FMConversion, &f.conversions);
    fm_trim(void*, &f.strings);
    fm_trim(FMSource, &f.sources);
    // Release graph scheduling storage for this execution. The graph itself is
    // still the program and is available to formatting/reflection outside us.
    im_frame_pop(m);
    var graph_frame = &m.frames.data[0];
    vector_dispose(IMTask, &graph_frame.tasks);
    vector_dispose(IMEntry, &graph_frame.values);
    vector_dispose(IMEntry, &graph_frame.addresses);
    vector_dispose(IMFrame, &m.frames);
    vector_dispose(IMEntry, &m.node_cache);
    return f;
}

export fn fast_interpreter_dispose(f: FMState*): void {
    vector_dispose(u64, &f.escaped);
    vector_dispose(IMEntry, &f.labels);
    vector_dispose(IMEntry, &f.jumps);
    vector_dispose(IMEntry, &f.locals);
    vector_dispose(u32, &f.words);
    vector_dispose(u64, &f.constants);
    vector_dispose(FMFunction, &f.functions);
    vector_dispose(FMParameter, &f.parameters);
    vector_dispose(FoundationType*, &f.types);
    vector_dispose(FMConversion, &f.conversions);
    vector_dispose(void*, &f.strings);
    vector_dispose(FMSource, &f.sources);
    vector_dispose(u64, &f.registers);
    vector_dispose(FMFrame, &f.frames);
    free(f);
}

fn fm_offset(f: FMState*, pc: usize): usize {
    var begin: usize = 0;
    var end = f.sources.length;
    loop {
        var done = begin == end;
        if done {
            break;
        }
        var middle = end - begin;
        middle = middle / 2;
        middle = middle + begin;
        var before = f.sources.data[middle].pc <= pc;
        if before {
            begin = middle + 1;
        } else {
            end = middle;
        }
    }
    var empty = begin == 0;
    if empty {
        return 0;
    }
    begin = begin - 1;
    return f.sources.data[begin].offset;
}

fn fm_mask(tag: usize): u64 {
    var small = tag == 0;
    if small {
        return 255;
    }
    small = tag < 3;
    if small {
        return 4294967295;
    }
    return 18446744073709551615;
}

fn fm_sign(value: u64, tag: usize): i64 {
    var narrow = tag == 2;
    if narrow {
        return convert(i64, bits(i32, convert(u32, value)));
    }
    return bits(i64, value);
}

fn fm_binary(m: IMState*, opcode: usize, x: u64, y: u64): u64 {
    var instruction = opcode - 64;
    var op = instruction / 5;
    var tag = instruction % 5;
    var mask = fm_mask(tag);
    var signed = tag == 2;
    var wide_signed = tag == 4;
    signed = im_or(signed, wide_signed);
    var result = im_binary_scalar(m, convert(u32, op), x, y, mask, signed, 0);
    result = result & mask;
    return result;
}

export fn fast_interpreter_step(m: IMState*, f: FMState*, budget: usize): void {
    var count: usize = 0;
    loop {
        var stop = im_or(m.done, m.failed);
        var fm_condition_27 = count == budget;

        stop = im_or(stop, fm_condition_27);
        if stop {
            break;
        }
        var pc = f.pc;
        var word = f.words.data[pc];
        f.pc = pc + 1;
        var fm_condition_28 = word & 255;

        var op = convert(usize, fm_condition_28);
        var unpacked = word / 256;
        var a = convert(usize, unpacked);
        a = a & 255;
        unpacked = word / 65536;
        var b = convert(usize, unpacked);
        b = b & 255;
        unpacked = word / 16777216;
        var c = convert(usize, unpacked);
        var wide = op == 255;
        if wide {
            var at = pc + 1;
            op = convert(usize, f.words.data[at]);
            at = at + 1;
            a = convert(usize, f.words.data[at]);
            at = at + 1;
            b = convert(usize, f.words.data[at]);
            at = at + 1;
            c = convert(usize, f.words.data[at]);
            f.pc = at + 1;
        } else {
            var jump = op == 13;
            var branch = op == 14;
            if jump {
                a = convert(usize, f.words.data[f.pc]);
                f.pc = f.pc + 1;
            }
            if branch {
                b = convert(usize, f.words.data[f.pc]);
                f.pc = f.pc + 1;
            }
        }
        var r = &f.registers.data[f.register_base];
        count = count + 1;
        m.steps = m.steps + 1;
        var trapping = op == 22;
        if trapping {
            f.preserve_error_offset = true;
            im_raise(m, r[a], r[b]);
            m.done = true;
            continue;
        }
        var binary = op >= 64;
        if binary {
            r[a] = fm_binary(m, op, r[b], r[c]);
        }
        else {
            var selected = op == 0;
            if selected {
                r[a] = f.constants.data[b];
            }
            else {
                selected = op == 1;
                if selected {
                    r[a] = r[b];
                }
                else {
                    selected = op == 2;
                    if selected {
                        var address = f.base + b;
                        r[a] = convert(u64, address);
                    }
                    else {
                        selected = op == 3;
                        if selected {
                            var address = b + 16;
                            r[a] = convert(u64, address);
                        }
                        else {
                            selected = op == 4;
                            if selected {
                                r[a] = im_load_size(m, r[b], c, 0);
                            }
                            else {
                                selected = op == 5;
                                if selected {
                                    im_write_size(m, r[a], r[b], c, 0);
                                }
                                else {
                                    selected = op == 7;
                                    if selected {
                                        var conversion = &f.conversions.data[c];
                                        var result = im_convert_value(m, r[b], conversion.from, conversion.to, 0);
                                        r[a] = result & im_type_mask(conversion.to);
                                    }
                                    else {
                                        var fm_condition_29 = op == 8;
                                        var fm_condition_30 = op == 9;

                                        selected = im_or(fm_condition_29, fm_condition_30);
                                        if selected {
                                            var size = convert(u64, c);
                                            var limit = convert(u64, im_host_max());
                                            var narrow = im_pointer_bytes(m) == 4;
                                            if narrow {
                                                limit = 4294967295;
                                            }
                                            limit = limit / size;
                                            var too_big = r[b] > limit;
                                            if too_big {
                                                r[a] = 0;
                                            }
                                            else {
                                                size = size * r[b];
                                                var result: u64 = 0;
                                                var allocate = op == 8;
                                                if allocate {
                                                    result = interpreter_allocate(m, convert(usize, size));
                                                }
                                                else {
                                                    result = interpreter_reallocate(m, r[a], convert(usize, size));
                                                }
                                                r[a] = result;
                                            }
                                        }
                                        else {
                                            selected = op == 10;
                                            if selected {
                                                interpreter_deallocate(m, r[a]);
                                            }
                                            else {
                                                var fm_condition_31 = op == 11;
                                                var fm_condition_32 = op == 12;

                                                selected = im_or(fm_condition_31, fm_condition_32);
                                                if selected {
                                                    var fm_condition_33 = op == 11;
                                                    im_copy_values(m, r[a], r[b], r[c], fm_condition_33, 0);
                                                }
                                                else {
                                                    selected = op == 13;
                                                    if selected {
                                                        f.pc = a;
                                                    }
                                                    else {
                                                        selected = op == 14;
                                                        if selected {
                                                            var zero = r[a] == 0;
                                                            if zero {
                                                                f.pc = b;
                                                            }
                                                        }
                                                        else {
                                                            selected = op == 15;
                                                            if selected {
                                                                fm_call(m, f, a, b, c, 0);
                                                            }
                                                            else {
                                                                selected = op == 16;
                                                                if selected {
                                                                    var value = r[a];
                                                                    m.stack = f.base;
                                                                    var empty = f.frames.length == 0;
                                                                    if empty {
                                                                        m.done = true;
                                                                    }
                                                                    else {
                                                                        f.frames.length = f.frames.length - 1;
                                                                        var frame = &f.frames.data[f.frames.length];
                                                                        f.pc = frame.pc;
                                                                        f.base = frame.base;
                                                                        f.register_base = frame.registers;
                                                                        f.register_count = frame.count;
                                                                        f.registers.length = f.register_base + f.register_count;
                                                                        var dest = f.register_base + frame.result;
                                                                        f.registers.data[dest] = value;
                                                                    }
                                                                }
                                                                else {
                                                                    selected = op == 17;
                                                                    if selected {
                                                                        im_print_value(m, r[a], f.types.data[b]);
                                                                    }
                                                                    else {
                                                                        selected = op == 18;
                                                                        if selected {
                                                                            var node = f.strings.data[b];
                                                                            r[a] = im_read_uncached(m, node, im_node(node), 0);
                                                                        }
                                                                        else {
                                                                            var fm_condition_34 = op == 19;
                                                                            var fm_condition_35 = op == 23;

                                                                            selected = im_or(fm_condition_34, fm_condition_35);
                                                                            if selected {
                                                                                var base = f.base;
                                                                                var global = op == 23;
                                                                                if global {
                                                                                    base = 16;
                                                                                }
                                                                                var address = base + b;
                                                                                r[a] = im_load_size(m, convert(u64, address), c, 0);
                                                                            }
                                                                            else {
                                                                                selected = op == 21;
                                                                                if selected {
                                                                                    r[a] = bits(u64, fm_sign(r[a], b));
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if m.failed {
            var locate = f.preserve_error_offset == false;
            if locate {
                m.error_offset = fm_offset(f, pc);
            }
            m.done = true;
        }
    }
}

fn fm_call(m: IMState*, f: FMState*, dest: usize, index: usize, first: usize, offset: usize): void {
    var function = &f.functions.data[index];
    var arg_index = f.register_base + first;
    if function.external {
        var missing = im_has_foreign(m) == false;
        if missing {
            im_missing_foreign(m, function.node, offset);
            return;
        }
        var value = im_foreign(m, function.node, &f.registers.data[arg_index], function.parameter_count);
        if m.failed {
            f.preserve_error_offset = true;
        }
        var at = f.register_base + dest;
        f.registers.data[at] = value;
        return;
    }
    var remaining: usize = 4194304;
    remaining = remaining - m.stack;
    var exhausted = f.frames.length >= 127;
    var fm_condition_36 = function.frame_size > remaining;

    exhausted = im_or(exhausted, fm_condition_36);
    if exhausted {
        im_fail(m, "Tower call stack limit exceeded", offset);
        return;
    }
    var frame: FMFrame;
    frame.pc = f.pc;
    frame.base = f.base;
    frame.registers = f.register_base;
    frame.result = dest;
    frame.count = f.register_count;
    fm_push(FMFrame, &f.frames, &frame);
    var register_base = f.register_base + f.register_count;
    var needed = register_base + function.registers;
    im_storage_require(vector_reserve(u64, &f.registers, needed));
    f.registers.length = needed;
    f.register_count = function.registers;
    f.register_base = register_base;
    f.base = m.stack;
    m.stack = m.stack + function.frame_size;
    var pinned_bytes = function.pinned * 8;
    fill(&f.registers.data[register_base], 0, pinned_bytes);
    var i: usize = 0;
    loop {
        var end = i == function.parameter_count;
        if end {
            break;
        }
        var param_index = function.parameters + i;
        var parameter = &f.parameters.data[param_index];
        var address = f.base + parameter.offset;
        var arg = arg_index + i;
        var pinned = parameter.register_slot != 0;
        if pinned {
            var destination = register_base + parameter.register_slot;
            destination = destination - 1;
            f.registers.data[destination] = f.registers.data[arg];
        } else {
            im_write_size(m, convert(u64, address), f.registers.data[arg], parameter.size, offset);
        }
        i = i + 1;
    }
    f.pc = function.entry;
}

export fn fast_interpreter_stat(f: FMState*, key: usize): usize {
    var selected = key == 0;
    if selected {
        var bytes = f.words.length * 4;
        return bytes;
    }
    selected = key == 1;
    if selected {
        return f.instructions;
    }
    selected = key == 2;
    if selected {
        return f.wide_instructions;
    }
    selected = key == 3;
    if selected {
        var bytes = f.registers.capacity * 8;
        return bytes;
    }
    var bytes = f.constants.capacity * sizeof(u64);
    var extra = f.functions.capacity * sizeof(FMFunction);
    bytes = bytes + extra;
    extra = f.parameters.capacity * sizeof(FMParameter);
    bytes = bytes + extra;
    extra = f.types.capacity * sizeof(FoundationType*);
    bytes = bytes + extra;
    extra = f.conversions.capacity * sizeof(FMConversion);
    bytes = bytes + extra;
    extra = f.strings.capacity * sizeof(void*);
    bytes = bytes + extra;
    extra = f.sources.capacity * sizeof(FMSource);
    bytes = bytes + extra;
    extra = f.frames.capacity * sizeof(FMFrame);
    bytes = bytes + extra;
    extra = f.words.capacity * sizeof(u32);
    bytes = bytes + extra;
    extra = f.registers.capacity * sizeof(u64);
    bytes = bytes + extra;
    bytes = bytes + sizeof(FMState);
    return bytes;
}
