import tower;

// Standard C runtime text; no external Tower runtime or compiler extensions
// outside the legacy integer and optional non-returning function adapters.
fn ce_runtime(c: CEmitter*): void {
    ce_text(c, "#include <stddef.h>\n");
    ce_text(c, "#include <limits.h>\n");
    ce_text(c, "#include <stdio.h>\n");
    ce_text(c, "#include <stdlib.h>\n");
    ce_text(c, "#include <string.h>\n");
    ce_text(c, "#ifdef _WIN32\n#include <io.h>\n#include <fcntl.h>\n#endif\n");
    ce_text(c, "\n");
    ce_text(c, "\n");
    ce_text(c, "/* Prefer standard integer types; C89/C++98 use this small data-model adapter. */\n");
    ce_text(c, "#if (defined(__STDC_VERSION__) && __STDC_VERSION__ >= 199901L) || \\\n");
    ce_text(c, "    (defined(__cplusplus) && __cplusplus >= 201103L) || \\\n");
    ce_text(c, "    (defined(_MSC_VER) && _MSC_VER >= 1600)\n");
    ce_text(c, "#include <stdint.h>\n");
    ce_text(c, "#else\n");
    ce_text(c, "typedef unsigned char uint8_t;\n");
    ce_text(c, "#if UINT_MAX == 0xffffffffUL\n");
    ce_text(c, "typedef unsigned int uint32_t;\n");
    ce_text(c, "typedef int int32_t;\n");
    ce_text(c, "#elif ULONG_MAX == 0xffffffffUL\n");
    ce_text(c, "typedef unsigned long uint32_t;\n");
    ce_text(c, "typedef long int32_t;\n");
    ce_text(c, "#else\n");
    ce_text(c, "#error Tower requires an exact 32-bit integer type\n");
    ce_text(c, "#endif\n");
    ce_text(c, "#if ULONG_MAX > 0xffffffffUL\n");
    ce_text(c, "typedef unsigned long uint64_t;\n");
    ce_text(c, "typedef long int64_t;\n");
    ce_text(c, "#define UINT64_C(n) n##UL\n");
    ce_text(c, "#elif defined(_MSC_VER) || defined(__BORLANDC__)\n");
    ce_text(c, "typedef unsigned __int64 uint64_t;\n");
    ce_text(c, "typedef __int64 int64_t;\n");
    ce_text(c, "#define UINT64_C(n) n##ui64\n");
    ce_text(c, "#else\n");
    ce_text(c, "#error This compiler needs a 64-bit integer adapter for Tower\n");
    ce_text(c, "#endif\n");
    ce_text(c, "#define UINT32_MAX ((uint32_t)0xffffffffUL)\n");
    ce_text(c, "#define INT32_MAX ((int32_t)0x7fffffffL)\n");
    ce_text(c, "#define INT32_MIN (-INT32_MAX - 1)\n");
    ce_text(c, "#define UINT64_MAX (~(uint64_t)0)\n");
    ce_text(c, "#define INT64_MAX ((int64_t)(UINT64_MAX >> 1))\n");
    ce_text(c, "#define INT64_MIN (-INT64_MAX - 1)\n");
    ce_text(c, "#if TC_POINTER_BYTES == 8\n");
    ce_text(c, "typedef uint64_t uintptr_t;\n");
    ce_text(c, "#else\n");
    ce_text(c, "typedef uint32_t uintptr_t;\n");
    ce_text(c, "#endif\n");
    ce_text(c, "#define SIZE_MAX (~(size_t)0)\n");
    ce_text(c, "#endif\n");
    ce_text(c, "\n");
    ce_text(c, "#ifdef __cplusplus\n");
    ce_text(c, "extern \"C\" {\n");
    ce_text(c, "#endif\n");
    ce_text(c, "\n");
    ce_text(c, "/* Optional annotations preserve diagnostics across C89 compilers. */\n");
    ce_text(c, "#if defined(_MSC_VER)\n");
    ce_text(c, "#define TC_NORETURN __declspec(noreturn)\n");
    ce_text(c, "#define TC_MAIN_END\n");
    ce_text(c, "#elif defined(__GNUC__) || defined(__clang__)\n");
    ce_text(c, "#define TC_NORETURN __attribute__((noreturn))\n");
    ce_text(c, "#define TC_MAIN_END\n");
    ce_text(c, "#else\n");
    ce_text(c, "#define TC_NORETURN\n");
    ce_text(c, "#define TC_MAIN_END return 0;\n");
    ce_text(c, "#endif\n\n");
    ce_text(c, "typedef char tc_u8_width[(sizeof(uint8_t) == 1) ? 1 : -1];\n");
    ce_text(c, "typedef char tc_u32_width[(sizeof(uint32_t) == 4) ? 1 : -1];\n");
    ce_text(c, "typedef char tc_u64_width[(sizeof(uint64_t) == 8) ? 1 : -1];\n");
    ce_text(c, "struct tc_align32 { char prefix; uint32_t value; };\n");
    ce_text(c, "struct tc_align64 { char prefix; uint64_t value; };\n");
    ce_text(c, "struct tc_alignptr { char prefix; void *value; };\n");
    ce_text(c, "typedef char tc_u32_alignment[(offsetof(struct tc_align32, value) == 4) ? 1 : -1];\n");
    ce_text(c, "typedef char tc_u64_alignment[(offsetof(struct tc_align64, value) == 8) ? 1 : -1];\n");
    ce_text(c, "typedef char tc_pointer_alignment[(offsetof(struct tc_alignptr, value) == TC_POINTER_BYTES) ? 1 : -1];\n");
    ce_text(c, "void tc_print_pointer(uintptr_t value)\n{\n    char digits[TC_POINTER_BYTES * 2];\n    unsigned count = TC_POINTER_BYTES * 2;\n    unsigned i = count;\n    while (i) { digits[--i] = \"0123456789abcdef\"[value % 16]; value /= 16; }\n    fputs(\"0x\", stdout);\n    for (i = 0; i < count; ++i) putchar(digits[i]);\n    putchar('\\n');\n}\n");
    ce_text(c, "void tc_environment(void)\n{\n#ifdef _WIN32\n    (void)_setmode(_fileno(stdout), _O_BINARY);\n    (void)_setmode(_fileno(stderr), _O_BINARY);\n#endif\n}\n");
    ce_text(c, "\n");
    ce_text(c, "void tc_print_unsigned(uint64_t value)\n");
    ce_text(c, "{\n");
    ce_text(c, "    char digits[20];\n");
    ce_text(c, "    unsigned count = 0;\n");
    ce_text(c, "    do {\n");
    ce_text(c, "        digits[count++] = (char)('0' + value % 10);\n");
    ce_text(c, "        value /= 10;\n");
    ce_text(c, "    } while (value);\n");
    ce_text(c, "    while (count) putchar(digits[--count]);\n");
    ce_text(c, "    putchar('\\n');\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "void tc_print_signed(int64_t value)\n");
    ce_text(c, "{\n");
    ce_text(c, "    uint64_t magnitude = (uint64_t)value;\n");
    ce_text(c, "    if (value < 0) {\n");
    ce_text(c, "        putchar('-');\n");
    ce_text(c, "        magnitude = (uint64_t)0 - magnitude;\n");
    ce_text(c, "    }\n");
    ce_text(c, "    tc_print_unsigned(magnitude);\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "#if CHAR_BIT != 8\n");
    ce_text(c, "#error Tower requires eight-bit bytes\n");
    ce_text(c, "#endif\n");
    ce_text(c, "\n");
    ce_text(c, "#define tc_trap(message) (tc_error(message), exit(1))\n");
    ce_text(c, "void tc_error(const char *message)\n");
    ce_text(c, "{\n");
    ce_text(c, "    fputs(message, stderr);\n");
    ce_text(c, "    fputc('\\n', stderr);\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "int32_t tc_s32(uint32_t value)\n");
    ce_text(c, "{\n");
    ce_text(c, "    return value <= INT32_MAX ? (int32_t)value : -1 - (int32_t)(UINT32_MAX - value);\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "int64_t tc_s64(uint64_t value)\n");
    ce_text(c, "{\n");
    ce_text(c, "    return value <= INT64_MAX ? (int64_t)value : -1 - (int64_t)(UINT64_MAX - value);\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "uint64_t tc_div(uint64_t a, uint64_t b, unsigned width, int sign, int remainder)\n");
    ce_text(c, "{\n");
    ce_text(c, "    int64_t x, y;\n");
    ce_text(c, "    uint64_t magnitude_x, magnitude_y, result;\n");
    ce_text(c, "    if (!b) tc_trap(\"Division by zero\");\n");
    ce_text(c, "    if (!sign) return remainder ? a % b : a / b;\n");
    ce_text(c, "    x = width == 32 ? (int64_t)tc_s32((uint32_t)a) : tc_s64(a);\n");
    ce_text(c, "    y = width == 32 ? (int64_t)tc_s32((uint32_t)b) : tc_s64(b);\n");
    ce_text(c, "    if (y == -1 && x == (width == 32 ? INT32_MIN : INT64_MIN))\n");
    ce_text(c, "        tc_trap(\"Signed division overflow\");\n");
    ce_text(c, "    /* C89 leaves negative division rounding implementation-defined. */\n");
    ce_text(c, "    magnitude_x = x < 0 ? (uint64_t)0 - (uint64_t)x : (uint64_t)x;\n");
    ce_text(c, "    magnitude_y = y < 0 ? (uint64_t)0 - (uint64_t)y : (uint64_t)y;\n");
    ce_text(c, "    result = remainder ? magnitude_x % magnitude_y : magnitude_x / magnitude_y;\n");
    ce_text(c, "    if (remainder ? x < 0 : (x < 0) != (y < 0)) result = (uint64_t)0 - result;\n");
    ce_text(c, "    return result;\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "uint64_t tc_convert(uint64_t value, unsigned from, int from_signed, unsigned to, int to_signed)\n");
    ce_text(c, "{\n");
    ce_text(c, "    int64_t signed_value;\n");
    ce_text(c, "    uint64_t maximum;\n");
    ce_text(c, "    if (from_signed && from == 32) value = (uint64_t)(int64_t)tc_s32((uint32_t)value);\n");
    ce_text(c, "    signed_value = tc_s64(value);\n");
    ce_text(c, "    maximum = to == 64 ? UINT64_MAX : (UINT64_C(1) << to) - 1;\n");
    ce_text(c, "    if (to_signed) maximum >>= 1;\n");
    ce_text(c, "    if (from_signed && signed_value < 0) {\n");
    ce_text(c, "        if (!to_signed || signed_value < -1 - (int64_t)maximum)\n");
    ce_text(c, "            tc_trap(\"Numeric conversion out of range; use bits for bit reinterpretation\");\n");
    ce_text(c, "    } else if (value > maximum) {\n");
    ce_text(c, "        tc_trap(\"Numeric conversion out of range; use bits for bit reinterpretation\");\n");
    ce_text(c, "    }\n");
    ce_text(c, "    return value;\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "unsigned char *tc_offset(unsigned char *base, uintptr_t offset)\n");
    ce_text(c, "{\n");
    ce_text(c, "    return (unsigned char *)((uintptr_t)base + offset);\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "unsigned char *tc_alloc(size_t count, size_t size)\n");
    ce_text(c, "{\n");
    ce_text(c, "    if (size && count > SIZE_MAX / size) return NULL;\n");
    ce_text(c, "    return (unsigned char *)malloc(count * size);\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "unsigned char *tc_realloc(unsigned char *pointer, size_t count, size_t size)\n");
    ce_text(c, "{\n");
    ce_text(c, "    if (size && count > SIZE_MAX / size) return NULL;\n");
    ce_text(c, "    return (unsigned char *)realloc(pointer, count * size);\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "uint8_t tc_load8(const void *p)\n");
    ce_text(c, "{\n");
    ce_text(c, "    uint8_t value;\n");
    ce_text(c, "    memcpy(&value, p, sizeof value);\n");
    ce_text(c, "    return value;\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "uint32_t tc_load32(const void *p)\n");
    ce_text(c, "{\n");
    ce_text(c, "    uint32_t value;\n");
    ce_text(c, "    memcpy(&value, p, sizeof value);\n");
    ce_text(c, "    return value;\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "uint64_t tc_load64(const void *p)\n");
    ce_text(c, "{\n");
    ce_text(c, "    uint64_t value;\n");
    ce_text(c, "    memcpy(&value, p, sizeof value);\n");
    ce_text(c, "    return value;\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "unsigned char *tc_loadptr(const void *p)\n");
    ce_text(c, "{\n");
    ce_text(c, "    unsigned char *value;\n");
    ce_text(c, "    memcpy(&value, p, sizeof value);\n");
    ce_text(c, "    return value;\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "void tc_store8(void *p, uint8_t value) { memcpy(p, &value, sizeof value); }\n");
    ce_text(c, "void tc_store32(void *p, uint32_t value) { memcpy(p, &value, sizeof value); }\n");
    ce_text(c, "void tc_store64(void *p, uint64_t value) { memcpy(p, &value, sizeof value); }\n");
    ce_text(c, "void tc_storeptr(void *p, unsigned char *value) { memcpy(p, &value, sizeof value); }\n");
    ce_text(c, "\n");
    ce_text(c, "uint64_t tc_platform_write(uint32_t stream, unsigned char *data, size_t length)\n");
    ce_text(c, "{\n");
    ce_text(c, "    size_t written;\n");
    ce_text(c, "    if (stream != 1 && stream != 2) return UINT64_MAX;\n");
    ce_text(c, "    written = fwrite(data, 1, length, stream == 2 ? stderr : stdout);\n");
    ce_text(c, "    return written == 0 && length ? UINT64_MAX : (uint64_t)written;\n");
    ce_text(c, "}\n");
    ce_text(c, "\n");
    ce_text(c, "\n");
    ce_text(c, "\n");
}
