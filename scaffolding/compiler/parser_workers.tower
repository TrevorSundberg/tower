import tower;
import grammar_types;
import grammar_observer;
import worker_policy;
import .library.work_pool;
import .library.work_budget;
import .library.work_budget_types;
import .library.work_graph;

extern fn compiler_node_world(node: void*): void*;
extern fn compiler_world_grammar(world: void*): CompilerGrammarCache*;
extern fn compiler_world_work_budget(world: void*): WorkBudget*;

// A finite parser phase borrows the caller's already admitted lane. Reserve
// only extra workers; retained thread slots do not confer admission rights.
struct ParserAdmission {
    reservation: WorkReservation;
    extra: usize;
}

fn parser_admission_open(admission: ParserAdmission*, anchor: void*, preferred: usize): bool {
    return parser_admission_open_result(admission, anchor, preferred) == WorkBudgetError.None;
}

fn parser_admission_open_result(admission: ParserAdmission*, anchor: void*, preferred: usize): WorkBudgetError {
    if admission == null || preferred == 0 { return WorkBudgetError.Invalid; }
    if admission.reservation.active { return WorkBudgetError.Busy; }
    *admission = default;
    var capacity = compiler_worker_capacity(anchor);
    if preferred > capacity { preferred = capacity; }
    if preferred <= 1 { return WorkBudgetError.None; }
    var budget = compiler_world_work_budget(compiler_node_world(anchor));
    if budget == null {
        admission.extra = preferred - 1;
        return WorkBudgetError.None;
    }
    // This receipt admits lanes only. Pool/graph/runtime owners reserve their
    // physical buffers separately, including LR analysis/index scratch. The
    // ledger is not an allocator-private or foreign-heap process memory limit.
    var error = work_budget_reserve_result(budget, 0, preferred - 1, 0, &admission.reservation);
    if error != WorkBudgetError.None { return error; }
    admission.extra = admission.reservation.lanes;
    return WorkBudgetError.None;
}

// Every dispatch is synchronous and drains before returning. Keep this scope
// alive through ordered result publication and lease/view release, also on error.
fn parser_admission_close(admission: ParserAdmission*, graph: WorkGraph*): void {
    // A setup/transport failure may leave taken tickets without results. Their
    // jobs have already drained; cancel those logical leases before lane release.
    if graph != null && graph.running != 0 { work_cancel(graph); }
    if admission.reservation.active {
        var error = work_budget_release_result(admission.reservation.owner, &admission.reservation);
        if error != WorkBudgetError.None { trap("Cannot release parser worker budget reservation", 0); }
    }
    *admission = default;
}

// A coordinator lease, never shared by concurrently active parser requests.
// The pool survives grammar revisions; jobs, views and scratch do not. A plain
// entity store without a compiler world keeps the existing local lifetime.
struct ParserWorkers {
    pool: WorkPool*;
    cache: CompilerGrammarCache*;
    local: WorkPool;
}

fn parser_workers_open(lease: ParserWorkers*, anchor: void*, capacity: usize): bool {
    return parser_workers_open_result(lease, anchor, capacity) == WorkBudgetError.None;
}

fn parser_workers_open_result(lease: ParserWorkers*, anchor: void*, capacity: usize): WorkBudgetError {
    if lease == null { return WorkBudgetError.Invalid; }
    *lease = default;
    if capacity == 0 || capacity > WorkPoolMaximumCapacity { return WorkBudgetError.Invalid; }
    var world = compiler_node_world(anchor);
    if world == null {
        if !work_pool_open(&lease.local, capacity) { return lease.local.resource_error; }
        lease.pool = &lease.local;
        return WorkBudgetError.None;
    }
    var limit = compiler_world_worker_limit(world);
    if capacity > limit { capacity = limit; }
    var cache = compiler_world_grammar(world);
    grammar_observe(world, GrammarPhase.PoolOpen, true, capacity, cache.workers.count);
    defer grammar_observe(world, GrammarPhase.PoolOpen, false, capacity, cache.workers.count);
    if cache.workers_busy { return WorkBudgetError.Busy; }
    var pool = &cache.workers;
    // Grow only between leases. Never move live thread slots or discard jobs.
    // A serial transport keeps its one slot regardless of requested width.
    if pool.count != 0 && pool.threaded && pool.count < capacity {
        work_pool_close(pool);
    }
    if pool.count == 0 && !work_pool_open_budget(pool, capacity, compiler_world_work_budget(world)) { return pool.resource_error; }
    cache.workers_busy = true;
    lease.cache = cache;
    lease.pool = pool;
    return WorkBudgetError.None;
}

fn parser_workers_close(lease: ParserWorkers*): void {
    if lease.pool == null { return; }
    var observer: GrammarObserver = default;
    if lease.cache != null { observer = lease.cache.observer; }
    if observer.event != null { observer.event(observer.context, GrammarPhase.PoolClose, true, lease.pool.running, lease.pool.count); }
    defer { if observer.event != null { observer.event(observer.context, GrammarPhase.PoolClose, false, 0, 0); } }
    // Failure/cancellation must drain before the caller releases pinned inputs,
    // result components or scratch, even though these threads remain reusable.
    while lease.pool.running != 0 { work_pool_receive(lease.pool, true); }
    if lease.cache == null {
        work_pool_close(lease.pool);
    } else {
        if !work_thread_retention() { work_pool_close(lease.pool); }
        lease.cache.workers_busy = false;
    }
    lease.pool = null;
    lease.cache = null;
}
