extern fn syntax_parser_token_name(context: void*, id: u32): u8*;
extern fn syntax_parser_token_name_result(context: void*, id: u32, error: WorkBudgetError*): u8*;
extern fn parser_table_non_terminal_id_to_string_result(context: void*, id: u32, error: WorkBudgetError*): u8*;

extern fn syntax_parser_describe(context: void*, rule: usize): u8*;
extern fn syntax_parser_describe_into(context: void*, rule: usize, output: FormatResult*): void;
extern fn syntax_parser_token_name_into(context: void*, id: u32, output: FormatResult*): void;

extern fn parser_table_non_terminal_id_to_string(context: void*, id: u32): u8*;

extern fn compiler_buffer_free(memory: void*): void;

extern fn puts(text: u8*): i32;

extern fn putchar(byte: i32): i32;

fn parser_trace_write(text: u8*, length: usize): void {
    if text is null { return; }
    var index: usize = 0;
    while index < length {
        putchar(convert(i32, text[index]));
        index = index + 1;
    }
}

// The formatter's existing pull protocol owns traversal and composition. This
// service only answers names/descriptions and returns text through the existing
// host allocation API. Formatter vectors keep their own allocation family.
export fn parser_presentation_text(table: ParserHostTable*, kind: ParserFormatKind, first: usize, second: usize): u8* {
    var error = WorkBudgetError.None;
    var request = parser_presentation_format(table, kind, first, second, null, &error);
    if request == null { return null; }
    var output = parser_format_result(request);
    var text: u8* = null;
    if !output.failed { text = format_parser_host_text(output); }
    parser_format_destroy(request);
    return text;
}

// Descriptor, traversal, label scratch and detached text use the same explicit
// budget. The destination changes only after complete successful formatting.
export fn parser_presentation_buffer_result(table: ParserHostTable*, kind: ParserFormatKind,
    first: usize, second: usize, budget: WorkBudget*, output: WorkBuffer*): WorkBudgetError {
    if table == null || output == null { return WorkBudgetError.Invalid; }
    var error = WorkBudgetError.None;
    var request = parser_presentation_format(table, kind, first, second, budget, &error);
    if request == null { return error; }
    defer parser_format_destroy(request);
    var text = parser_format_result(request);
    return format_storage_finish(text, output);
}

fn parser_presentation_format(table: ParserHostTable*, kind: ParserFormatKind, first: usize, second: usize,
    budget: WorkBudget*, error: WorkBudgetError*): ParserFormat* {
    var names = table.presentation != ParserPresentation.Numeric;
    var descriptions = table.presentation == ParserPresentation.Syntax;
    var request = parser_format_create_result(table, kind, first, second, names, descriptions, budget, error);
    if request == null {
        return null;
    }
    loop {
        var need = parser_format_next(request);
        if need == ParserFormatNeed.Done {
            break;
        }
        var index = parser_format_index(request);
        var label: FormatResult = default;
        format_storage_begin(&label, budget);
        defer format_dispose(&label);
        if need == ParserFormatNeed.Description {
            syntax_parser_describe_into(table.userdata, index, &label);
        } else {
            var f: FormatEngine = {result: &label, ..default};
            match table.presentation {
                ParserPresentation.Utf8 => { format_parser_scalar(&label, convert(u32, index)); }
                ParserPresentation.NonTerminal => {
                    var owner = bits(ParserHostTable*, table.userdata);
                    if owner == null || owner.grammar == null { format_storage_fail(&label, WorkBudgetError.Invalid); }
                    else { if index < lr_grammar_name_count(owner.grammar) { format_text(&f, lr_grammar_name(owner.grammar, index)); } }
                }
                ParserPresentation.Syntax => { syntax_parser_token_name_into(table.userdata, convert(u32, index), &label); }
                _ => {}
            }
        }
        format_storage_fail(&request.result, format_storage_error(&label));
        if request.result.failed { break; }
        parser_format_reply(request, label.text.data, label.text.length);
    }
    return request;
}

// Callers guard this before any formatter request or debug string allocation.
export fn parser_trace_table(table: ParserHostTable*, kind: ParserFormatKind): void {
    if !table.trace {
        return;
    }
    var text = parser_presentation_text(table, kind, 0, 0);
    if text != null {
        puts(text);
        compiler_buffer_free(bits(void*, text));
    }
}

export fn parser_trace_step(table: ParserHostTable*, rule: usize, state: usize, offset: usize): void {
    if !table.trace {
        return;
    }
    var text = parser_presentation_text(table, ParserFormatKind.Edge, rule, state);
    if text != null {
        var result: FormatResult;
        var engine: FormatEngine = default;
        result = default;
        engine = default;
        engine.result = &result;
        format_text(&engine, "STEP: ");
        format_text(&engine, text);
        format_text(&engine, " at byte ");
        format_unsigned(&engine, convert(u64, offset));
        format_char(&engine, 10);
        parser_trace_write(result.text.data, result.text.length);
        format_dispose(&result);
        compiler_buffer_free(bits(void*, text));
    }
}

export fn parser_tree_debug_print(root: void*): void {
    var text = parser_tree_debug_string(root);
    if text != null {
        var length: usize = 0;
        while text[length] != 0 { length++; }
        parser_trace_write(text, length);
    }
    compiler_buffer_free(bits(void*, text));
}
