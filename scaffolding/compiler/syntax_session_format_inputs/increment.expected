import tower;

// Tower's place-aware increment fixtures use the full language. The standalone
// Bedrock teaching example deliberately defines a smaller grammar of its own.
fn post_increment(p: i32*): i32 {
    var old = *p;
    *p = old + 1;
    return old;
}

fn pre_increment(p: i32*): i32 {
    *p += 1;
    return *p;
}

var value: i32 = 5;
++value;
value++;
var before: i32 = value++;
var after: i32 = ++value;
print(value++);
print(++value);
var sum: i32 = value++ + ++value;
var array: i32[2];
var index: i32 = 0;
array[index++]++;

struct S {
    field: i32;
}

var s: S;
++s.field;
s.field++;
++ /* keep */
value;
value /* keep too */
++;
