import tower;
import .library.vector;
import .library.work_budget_types;

struct SyntaxExpansionCapture {
    name: u8*;
    uses: usize;
    repeated: bool;
}

struct SyntaxExpansionRule {
    tree: void*;
    rule: u8*;
    category: u8*;
    start: usize;
    end: usize;
    captures: SyntaxExpansionCapture*;
    count: usize;
}

struct SyntaxExpansionInput {
    rules: SyntaxExpansionRule**;
    count: usize;
    match_kind: void*;
}

struct SyntaxExpansionResult {
    resource_error: WorkBudgetError;
    root: void*;
    replacements: usize;
    generated_nodes: usize;
    copied_nodes: usize;
    error_offset: usize;
    error: vector(u8);
}

struct ExpansionFrame {
    node: void*;
    next: usize;
    index: usize;
}

struct ExpansionWork {
    source: void*;
    parent: void*;
    role: u8*;
}

struct ExpansionCapture {
    node: void*;
    remaining: usize;
}

struct ExpansionState {
    input: SyntaxExpansionInput*;
    result: SyntaxExpansionResult*;
    normal: vector(usize);
    normal_count: usize;
    frames: vector(ExpansionFrame);
    work: vector(ExpansionWork);
    clones: vector(ExpansionWork);
    captures: vector(ExpansionCapture);
    items: vector(void*);
    traces: vector(void*);
}

