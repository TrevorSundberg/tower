import tower;
import .library.work_budget_types;
import semantic_context_types;
import semantic_evaluation_types;
import compiler_kernel;
import semantic_context;
import semantic_program_types;
import semantic_evaluation;
import semantic_capture_work;
import semantic_control;
import semantic_support;
import semantic_types;
import semantic_work_ids;
import semantic_phase_work;
import .library.vector;
import .library.stack;
import .library.work_graph;
import .library.work_pool;

var EvaluationPrepareQuery: u32 = convert(u32, SemanticQuery.EvaluationPrepare);

struct SemanticEvaluationWork {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    context: SemanticContext*;
    evaluation: SemanticEvaluation*;
    stage: void*;
    ordinal: usize;
    count: usize;
    error: vector(u8);
    error_offset: usize;
    resource: SemanticResourceFailure;
    query_reads: vector(usize);
    aliases: vector(SemanticEvaluationAlias);
    cloning: bool;
    require_relocatable: bool;
}

// Each stage expression owns its checked semantic tree. Nested stages share
// immutable type/readiness information and integer literal placeholders; their
// hidden producer expressions belong to different jobs. Enum conversions belong
// to the consuming expression and lower around those same pending literals.
fn semantic_evaluation_prepare_kernel(result: SemanticEvaluationWork*): void {
    var context: SemanticContext;
    sem_context_snapshot(&context, result.context);
    var program = *context.program;
    context.program = &program;
    context.current = result.evaluation.subject;
    context.editor = null;
    context.entity_stage = result.stage;
    context.query_reads = &result.query_reads;
    context.evaluation_aliases = &result.aliases;
    context.control_reserved = context.control_names;
    context.control_names = null;
    context.count = 0;
    context.node_limit -= result.context.count;
    sem_scratch_private(&context, result.context);
    vector_init(&context.token_text);
    fill(&context.scan, 0, sizeof(stack(void*)));
    vector_init(&program.error);
    context.control_prefix = sem_cat(&context, result.cloning ? "control clone " : "control stage ",
        sem_cat(&context, sem_decimal(&context, convert(u64, result.ordinal)), "."));
    if sem_ok(&context) {
    if result.cloning { sem_evaluation_clone_expression(&context, result.evaluation); }
    else {
        sem_evaluation_prepare(&context, result.evaluation);
        if sem_ok(&context) { sem_evaluation_start(&context, result.evaluation, result.require_relocatable); }
    }
    }
    result.count = context.count;
    result.error = program.error;
    result.error_offset = program.error_offset;
    result.resource = program.resource;
    sem_scan_dispose(&context);
    sem_scratch_dispose(&context.scratch);
}

export fn sem_evaluation_prepare_all(c: SemanticContext*): void {
    sem_evaluation_work_all(c, false);
}

export fn sem_evaluation_clone_all(c: SemanticContext*): void {
    sem_evaluation_work_all(c, true);
    // KnownSnapshot owns this clone-only frontier before inferred evaluations
    // are demanded. Retain deferred errors in evaluation pumping, but restore
    // them here before the snapshot caller attempts its dependent ticket.
    if sem_ok(c) { sem_evaluation_select_failure(c, convert(u32, SemanticQuery.KnownClone)); }
}

// Register each subject once. Preparation is demanded by evaluation, including
// dependencies discovered later by executed interpreter reads. Clones snapshot
// inferred inputs before ordinary lowering mutates their source expressions.
export fn sem_evaluation_work_register(c: SemanticContext*, cloning: bool): void* {
    if !sem_ok(c) { return null; }
    var kind = cloning ? &c.evaluation_clones : &c.evaluation_preparations;
    var registered = cloning ? &c.evaluation_clone_registered : &c.evaluation_registered;
    var query_kind = convert(u32, cloning ? SemanticQuery.KnownClone : SemanticQuery.EvaluationPrepare);
    for(var i = *registered; i < c.evaluation_jobs.length; i++) {
        var evaluation = bits(SemanticEvaluation*, c.evaluation_jobs.data[i]);
        if cloning && !evaluation.inferred { *registered = i + 1; continue; }
        var subject = evaluation.subject;
        var id = work_find(&c.queries, subject, query_kind, 0);
        if id == 0 || sem_evaluation_get(c, subject) != evaluation || evaluation.ready == null {
            sem_type_resource(c, subject, WorkBudgetError.Invalid); return null;
        }
        var error: WorkBudgetError;
        if *kind == null {
            *kind = sem_kind_result(c.program.root, sizeof(SemanticEvaluationWork), alignof(SemanticEvaluationWork), &error);
            if *kind == null { sem_type_resource(c, subject, error); return null; }
        }
        var component = entity_component_add_result(subject, *kind, &error);
        var result = bits(SemanticEvaluationWork*, entity_component_data(component));
        if result == null { sem_type_resource(c, subject, error); return null; }
        fill(result, 0, sizeof(SemanticEvaluationWork));
        result.evaluation = evaluation;
        result.ordinal = i;
        result.cloning = cloning;
        // Freeze producer policy before dispatch; workers do not inspect a
        // different declaration's capture payload while preparing this job.
        result.require_relocatable = evaluation.inferred || sem_capture_evaluation(c, evaluation);
        result.kernel.kind = CompilerKernelKind.PrepareEvaluation;
        result.kernel.payload = bits(void*, result);
        // Disjoint expression output, immutable types and nested placeholders.
        // Evaluation reads expressions and writes results, so the graph also
        // excludes evaluation while a preparation wave owns these inputs.
        var domain = convert(u64, SemanticWorkDomain.Compiler);
        if !cloning && !sem_phase_evaluation_depend(c, evaluation, id) { return null; }
        if !work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Expression), i, 1, WorkAccessMode.Write)
            || !work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Layout), 0, ~convert(usize, 0), WorkAccessMode.Read)
            || !work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Evaluation), 0, ~convert(usize, 0), WorkAccessMode.Read)
            || !work_access(&c.queries, id, domain, convert(u64, SemanticAccess.KnownBinding), 0, ~convert(usize, 0), WorkAccessMode.Read)
            || !work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Body), 0, ~convert(usize, 0), WorkAccessMode.Read)
            || !work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Aggregate), 0, ~convert(usize, 0), WorkAccessMode.Read)
            || !work_seal(&c.queries, id) || (cloning && !work_demand(&c.queries, id)) {
            sem_type_resource(c, subject, sem_query_error(c)); return null;
        }
        *registered = i + 1;
    }
    *registered = c.evaluation_jobs.length;
    return *kind;
}

fn sem_evaluation_work_all(c: SemanticContext*, cloning: bool): void {
    if !sem_ok(c) { return; }
    var kind = sem_evaluation_work_register(c, cloning);
    if kind == null || !sem_ok(c) { return; }
    sem_control_names(c);
    if !sem_ok(c) { return; }
    var query_kind = convert(u32, cloning ? SemanticQuery.KnownClone : SemanticQuery.EvaluationPrepare);
    if c.workers.count == 0 && !sem_workers_open(c) { return; }
    var batch: vector(SemanticEvaluationWork*) = default;
    defer vector_dispose(&batch);
    sem_require(vector_reserve(&batch, SemanticPreparationWindow));
    while sem_ok(c) {
        var count: usize = 0;
        var ticket: WorkTicket;
        while count < SemanticPreparationWindow && work_take_query(&c.queries, &ticket, query_kind) {
            var subject = work_task(&c.queries, ticket.task).subject;
            var result = bits(SemanticEvaluationWork*, entity_component_data(entity_component_get(subject, kind)));
            if result == null {
                sem_type_resource(c, subject, WorkBudgetError.Invalid);
                if !work_finish(&c.queries, &ticket, false) { sem_type_resource(c, subject, sem_query_error(c)); }
                break;
            }
            result.ticket = ticket;
            result.stage = entity_stage_open(c.program.root);
            sem_require(result.stage != null);
            sem_require(entity_stage_lease(result.stage, result.evaluation.subject));
            if result.evaluation.function != null {
                sem_require(entity_stage_lease(result.stage, result.evaluation.function));
            }
            batch.data[count] = result;
            count++;
        }
        if count == 0 { break; }
        if !cloning {
            // Resource diagnostics must not grow their storage after a worker
            // exhausts its arena/buffer budget. Reserve the short fixed receipt
            // and its immediate coordinator destination before dispatch.
            sem_require(vector_reserve(&c.program.error, EvaluationResourceDiagnosticBytes));
            for(var i: usize = 0; i < count; i++) {
                sem_require(vector_reserve(&batch.data[i].evaluation.error, EvaluationResourceDiagnosticBytes));
            }
        }
        var view = entity_view_open(c.program.root);
        sem_require(view != null);
        var context: SemanticContext;
        sem_context_snapshot(&context, c);
        for(var i: usize = 0; i < count; i++) { batch.data[i].context = &context; }
        var receipt: WorkReservation;
        var extra: usize = 0;
        var dispatched = sem_workers_admit_result(c, count, &receipt, &extra);
        defer sem_workers_release(c, &receipt);
        if dispatched == WorkBudgetError.None {
            dispatched = compiler_kernel_dispatch_admitted_result(&c.workers, batch.data, count, extra);
        }
        if !sem_stage_wave(c, batch.data, count, view, dispatched, batch.data[0].evaluation.subject, null) { return; }
        for(var i: usize = 0; i < count; i++) {
            var result = batch.data[i];
            sem_query_observe(c, &result.ticket, &result.query_reads);
            sem_evaluation_aliases(c, &result.aliases);
            c.count += result.count;
            if result.resource.error != WorkBudgetError.None {
                var evaluation = result.evaluation;
                if evaluation.resource_error == WorkBudgetError.None {
                    evaluation.resource_error = result.resource.error;
                    evaluation.error_offset = result.resource.offset;
                    vector_dispose(&evaluation.error);
                    evaluation.error = result.error;
                    result.error = default;
                }
            } else {
                if result.error.length != 0 && sem_ok(c) {
                    sem_evaluation_fail(c, result.evaluation, result.error.data, result.error_offset);
                }
            }
            if c.count > c.node_limit && result.resource.error == WorkBudgetError.None {
                sem_evaluation_fail(c, result.evaluation, "Foundation component memory budget exceeded", sem_get(result.evaluation.subject).start);
            }
            sem_require(work_finish(&c.queries, &result.ticket, result.resource.error == WorkBudgetError.None
                && result.error.length == 0 && c.count <= c.node_limit));
            vector_dispose(&result.error);
            vector_dispose(&result.query_reads);
            vector_dispose(&result.aliases);
        }
    }
}
