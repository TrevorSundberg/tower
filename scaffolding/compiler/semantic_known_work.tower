extern fn entity_view_open_result(anchor: void*, error: WorkBudgetError*): void*;
extern fn entity_query_count(kind: void*): usize;
extern fn entity_query_at(kind: void*, index: usize): void*;
extern fn semantic_known_publish_kernel(result: SemanticKnownWork*): void;

var SemanticKnownArenaChunkBytes: usize = 4096;
var SemanticKnownDiagnosticBytes: usize = 128;

// Diagnostic capacity is reserved before admitting graph work. Failure paths
// retain the first error without allocating while the world budget is denied.
fn sem_known_work_error(c: SemanticContext*, subject: void*, error: WorkBudgetError, publication: bool): void {
    if c.program.resource.error != WorkBudgetError.None { return; }
    var message = "Cannot allocate semantic publication storage";
    if error == WorkBudgetError.Capacity { message = "Semantic publication memory budget exceeded"; }
    if error == WorkBudgetError.Invalid { message = "Invalid semantic publication storage request"; }
    if !publication {
        message = "Cannot allocate semantic query work";
        if error == WorkBudgetError.Capacity { message = "Semantic query work memory budget exceeded"; }
        if error == WorkBudgetError.Invalid { message = "Invalid semantic query work dispatch"; }
        if error == WorkBudgetError.Busy { message = "Semantic worker admission failed"; }
    }
    var length = sem_length(message);
    if length < c.program.error.capacity {
        copy(c.program.error.data, message, length + 1);
        c.program.error.length = length;
    }
    sem_type_resource(c, subject, error);
    c.program.error_offset = c.program.resource.offset;
}

// Admission runs on the joined coordinator. Invalidate partial registrations
// before any consumer can retry them or publish their output.
fn sem_known_admission_error(c: SemanticContext*, subject: void*, error: WorkBudgetError): void {
    sem_known_work_error(c, subject, error, false);
    sem_query_cancel_failure(c);
}

fn sem_known_query_check(c: SemanticContext*, subject: void*, ok: bool): bool {
    if ok { return true; }
    var error = sem_query_cancel_failure(c);
    sem_known_work_error(c, subject, error, false);
    return false;
}

fn sem_known_candidate(subject: void*): bool {
    var value = sem_get(subject);
    return value != null && value.kind == KDeclare && value.value != null
        && value.type.pointers == 0 && !semantic_aggregate(&value.type)
        && !semantic_enum(&value.type) && sem_known_surface(sem_member(subject, "value"));
}

// Avoid attaching analysis metadata to Foundation-only reconstructions. The
// existing declaration index suffices for this short-circuit eligibility check.
fn sem_known_needed(c: SemanticContext*): bool {
    foreach(var node in &sem_get(c.program.root).items) {
        if sem_known_candidate(node) { return true; }
    }
    foreach(var function in &c.program.functions) {
        foreach(var node in &sem_get(function).locals) {
            if sem_known_candidate(node) { return true; }
        }
    }
    return false;
}

fn sem_known_write(result: SemanticKnownWork*, place: void*): void {
    while place != null {
        var value = sem_get(place);
        if value == null { return; }
        if value.kind == KOperand {
            if value.binding != null { sem_push(&result.mutations, value.binding); }
            return;
        }
        if (value.kind != KField && value.kind != KIndex) || value.indirect { return; }
        place = value.left;
    }
}

fn semantic_known_kernel(result: SemanticKnownWork*): void {
    if result.action == SemanticKnownAction.Bind { semantic_source_binding_kernel(result); return; }
    if result.action == SemanticKnownAction.Publish { semantic_known_publish_kernel(result); return; }
    if result.action == SemanticKnownAction.Inputs {
        var pending: vector(void*) = default;
        defer vector_dispose(&pending);
        var selected: usize = 0;
        foreach(var &candidate in &result.candidates) {
            var binding = sem_known_binding(result.context, candidate.subject);
            if binding != null && binding.immutable && binding.ordered
                && sem_known_inputs(result.context, sem_get(candidate.subject).value, &pending) {
                result.candidates.data[selected++] = *candidate;
            }
        }
        result.candidates.length = selected;
        return;
    }
    var context: SemanticContext;
    sem_context_snapshot(&context, result.context);
    context.allocations = default;
    context.lists = default;
    context.query_reads = &result.query_reads;
    var pending = sem_list(&context);
    var seen = sem_table(&context);
    sem_push(pending, result.root);
    for(var at: usize = 0; at < pending.length; at++) {
        var subject = pending.data[at];
        if subject == null { continue; }
        var visit = sem_state(&context, seen, subject);
        if visit.number != 0 { continue; }
        visit.number = 1;
        var value = sem_get(subject);
        if value == null { continue; }
        sem_known_edges(pending, value);
        if result.action == SemanticKnownAction.Scan {
            if result.owner != null ? sem_known_candidate(subject) : sem_known_binding(&context, subject) != null {
                var candidate: SemanticKnownCandidate = default;
                candidate.subject = subject;
                candidate.ordinal = at;
                sem_require(vector_push(&result.candidates, candidate));
            }
            if value.kind == KAddress { sem_known_write(result, value.value); }
            if value.kind == KAssign || value.kind == SurfaceAssign || value.kind == SurfaceModify
                || value.kind == SurfaceDefaultStore || value.kind == SurfaceInitializerStore {
                sem_known_write(result, value.target);
            }
        }
        if result.action == SemanticKnownAction.Order {
            if value.kind == KOperand && !value.constant {
                var binding = sem_known_binding(&context, value.binding);
                if binding != null && binding.owner == null && binding.ordinal >= result.source_ordinal {
                    sem_push(&result.mutations, value.binding);
                }
            }
            if value.kind == KCall && value.binding != null {
                sem_query_input(&context, value.binding, convert(u32, SemanticQuery.Body));
                sem_push(pending, sem_get(value.binding).body);
            }
        }
    }
    foreach(var list in &context.lists) { vector_dispose(bits(vector(void*)*, list)); }
    vector_dispose(&context.lists);
    foreach(var allocation in &context.allocations) { compiler_buffer_free(allocation); }
    vector_dispose(&context.allocations);
}

fn sem_known_storage_publish(result: SemanticKnownWork*): void {
    foreach(var &update in &result.storage) {
        var value = sem_get(update.subject);
        if update.replace_items {
            vector_dispose(&value.items);
            value.items = update.items;
            update.items = default;
        }
        if update.replace_locals {
            vector_dispose(&value.locals);
            value.locals = update.locals;
            update.locals = default;
            if value.kind == KProgram || value.kind == KFunction {
                for(var at: usize = 0; at < value.locals.length; at++) { sem_get(value.locals.data[at]).index = at; }
            }
        }
    }
}

fn sem_known_kind(c: SemanticContext*): void* {
    if !sem_ok(c) { return null; }
    var error: WorkBudgetError;
    var kind = sem_kind_result(c.program.root, sizeof(SemanticKnownWork), alignof(SemanticKnownWork), &error);
    if kind == null { sem_known_admission_error(c, c.program.root, error); }
    return kind;
}

fn sem_known_job(c: SemanticContext*, kind: void*, subject: void*, root: void*, owner: void*, ordinal: usize,
    action: SemanticKnownAction): SemanticKnownWork* {
    if !sem_ok(c) { return null; }
    var error: WorkBudgetError;
    var result = bits(SemanticKnownWork*, entity_component_data(entity_component_add_result(subject, kind, &error)));
    if result == null { sem_known_admission_error(c, subject, error); return null; }
    *result = default;
    result.context = c;
    result.subject = subject;
    result.root = root;
    result.owner = owner;
    result.ordinal = ordinal;
    result.action = action;
    result.kernel.kind = CompilerKernelKind.KnownBinding;
    result.kernel.payload = bits(void*, result);
    if action == SemanticKnownAction.Publish {
        if !work_arena_init(&result.scratch, compiler_world_work_budget(compiler_node_world(c.program.root)),
            SemanticKnownArenaChunkBytes) {
            sem_known_admission_error(c, subject, WorkBudgetError.Invalid); return null;
        }
    }
    return result;
}

fn sem_known_jobs_begin(c: SemanticContext*, kind: void*, count: usize, query_kind: SemanticQuery): vector(SemanticKnownWork*) {
    var jobs: vector(SemanticKnownWork*) = default;
    if !sem_ok(c) { return jobs; }
    if kind == null || entity_query_count(kind) != count {
        sem_known_admission_error(c, c.program.root, WorkBudgetError.Invalid); return jobs;
    }
    if !vector_reserve(&c.program.error, SemanticKnownDiagnosticBytes) || !vector_reserve(&jobs, count) {
        sem_known_admission_error(c, c.program.root, WorkBudgetError.Memory); return jobs;
    }
    jobs.length = count;
    fill(jobs.data, 0, count * sizeof(SemanticKnownWork*));
    // The coordinator already owns the kind's exact component index. Avoid a
    // redundant table plan just to copy those same stable payload pointers.
    for(var index: usize = 0; index < count; index++) {
        var result = bits(SemanticKnownWork*, entity_component_data(entity_query_at(kind, index)));
        if result == null || result.ordinal >= count || jobs.data[result.ordinal] != null {
            sem_known_admission_error(c, c.program.root, WorkBudgetError.Invalid); return jobs;
        }
        jobs.data[result.ordinal] = result;
    }
    if count != 0 && c.workers.count == 0 && !sem_workers_open(c) {
        sem_query_cancel_failure(c);
        sem_known_work_error(c, jobs.data[0].subject, c.workers.resource_error, false);
        return jobs;
    }
    foreach(var result in &jobs) {
        var id = work_request(&c.queries, result.subject, convert(u32, query_kind), 0);
        if !sem_known_query_check(c, result.subject, id != 0) { return jobs; }
        if query_kind == SemanticQuery.KnownScan || query_kind == SemanticQuery.KnownOrder {
            var proof = work_find(&c.queries, c.program.root, convert(u32, SemanticQuery.KnownProof), 0);
            if !sem_known_query_check(c, result.subject, proof != 0 && work_depend(&c.queries, proof, id)) { return jobs; }
        }
        if query_kind == SemanticQuery.KnownInputs {
            var proof = work_find(&c.queries, c.program.root, convert(u32, SemanticQuery.KnownProof), 0);
            if !sem_known_query_check(c, result.subject, proof != 0 && work_depend(&c.queries, id, proof)) { return jobs; }
        }
        var input_kind = query_kind == SemanticQuery.KnownPublish ? SemanticQuery.Lowering : SemanticQuery.Body;
        var input = result.action == SemanticKnownAction.Bind ? 0
            : work_find(&c.queries, result.subject, convert(u32, input_kind), 0);
        if input != 0 && !sem_known_query_check(c, result.subject, work_depend(&c.queries, id, input)) { return jobs; }
        var domain = convert(u64, SemanticWorkDomain.Compiler);
        if !sem_known_query_check(c, result.subject,
            work_access(&c.queries, id, domain, convert(u64, SemanticAccess.KnownAnalysis), result.ordinal, 1, WorkAccessMode.Write)
            && work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Body), 0, ~convert(usize, 0), WorkAccessMode.Read)
            && work_access(&c.queries, id, domain, convert(u64, SemanticAccess.KnownBinding), 0, ~convert(usize, 0), WorkAccessMode.Read)
            && work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Expression), 0, ~convert(usize, 0), WorkAccessMode.Read)
            && work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Evaluation), 0, ~convert(usize, 0), WorkAccessMode.Read)
            && work_seal(&c.queries, id) && work_demand(&c.queries, id)) { return jobs; }
    }
    return jobs;
}

// A caller retains the source-ordered result vector and completed prefix across
// waits. An unavailable producer does not prevent later independent work from
// entering this bounded frontier, and never causes an immediate-take assertion.
fn sem_known_jobs_pump(c: SemanticContext*, jobs: vector(SemanticKnownWork*)*, query_kind: SemanticQuery,
    first: usize*): SemanticPumpResult {
    if !sem_ok(c) || !work_ok(&c.queries) { return SemanticPumpResult.Failed; }
    while *first < jobs.length {
        var result = jobs.data[*first];
        var id = work_find(&c.queries, result.subject, convert(u32, query_kind), 0);
        if !sem_known_query_check(c, result.subject, id != 0) { return SemanticPumpResult.Failed; }
        if work_task(&c.queries, id).state != WorkState.Succeeded { break; }
        (*first)++;
    }
    if *first == jobs.length { return SemanticPumpResult.Complete; }
    var batch: vector(SemanticKnownWork*) = default;
    defer vector_dispose(&batch);
    if !vector_reserve(&batch, jobs.length < SemanticPreparationWindow ? jobs.length : SemanticPreparationWindow) {
        sem_known_admission_error(c, c.program.root, WorkBudgetError.Memory); return SemanticPumpResult.Failed;
    }
    for(var index = *first; index < jobs.length && batch.length < SemanticPreparationWindow; index++) {
        var result = jobs.data[index];
        var id = work_find(&c.queries, result.subject, convert(u32, query_kind), 0);
        if !sem_known_query_check(c, result.subject, id != 0) { return SemanticPumpResult.Failed; }
        var state = work_task(&c.queries, id).state;
        if state == WorkState.Succeeded {
            if index == *first { (*first)++; }
            continue;
        }
        if state == WorkState.Failed {
            sem_known_admission_error(c, result.subject,
                result.resource_error == WorkBudgetError.None ? sem_query_error(c) : result.resource_error);
            return SemanticPumpResult.Failed;
        }
        if work_take_task(&c.queries, &result.ticket, id) { sem_require(vector_push(&batch, result)); }
        if !sem_known_query_check(c, jobs.data[*first].subject, work_ok(&c.queries)) { return SemanticPumpResult.Failed; }
    }
    if batch.length == 0 {
        return *first == jobs.length ? SemanticPumpResult.Complete : SemanticPumpResult.Waiting;
    }
    // Reserve tickets before freezing input. Join every reader before releasing
    // the view or publishing graph observations; the component owns its output.
    var context: SemanticContext;
    sem_context_snapshot(&context, c);
    foreach(var result in &batch) { result.context = &context; }
    var view_error: WorkBudgetError;
    var view = entity_view_open_result(c.program.root, &view_error);
    if view == null {
        foreach(var result in &batch) { result.context = null; }
        sem_known_admission_error(c, batch.data[0].subject, view_error);
        return SemanticPumpResult.Failed;
    }
    var receipt: WorkReservation;
    var extra: usize = 0;
    var dispatch_error = sem_workers_admit_result(c, batch.length, &receipt, &extra);
    defer sem_workers_release(c, &receipt);
    if dispatch_error == WorkBudgetError.None {
        dispatch_error = compiler_kernel_dispatch_admitted_result(&c.workers, batch.data, batch.length, extra);
    }
    // Admission requires a drained pool. A valid dispatch returns only after
    // joining every peer, even when some or all jobs ran before a failure.
    sem_require(c.workers.running == 0);
    entity_view_close(view);
    foreach(var result in &batch) { result.context = null; }
    var failed: SemanticKnownWork* = null;
    if dispatch_error == WorkBudgetError.None {
        foreach(var result in &batch) {
            if failed == null && result.resource_error != WorkBudgetError.None { failed = result; }
        }
    }
    foreach(var result in &batch) {
        var success = dispatch_error == WorkBudgetError.None && result.resource_error == WorkBudgetError.None;
        if (dispatch_error == WorkBudgetError.None && !sem_query_observe_checked(c, &result.ticket, &result.query_reads))
            || !work_finish(&c.queries, &result.ticket, success) {
            var graph_error = sem_query_cancel_failure(c);
            // A terminal graph failure must not replace an earlier joined
            // producer's typed cause. Otherwise reject the wave's first ordinal.
            if failed == null {
                if dispatch_error == WorkBudgetError.None { dispatch_error = graph_error; }
                failed = batch.data[0];
            }
            break;
        }
        if failed == null && !success { failed = result; }
    }
    if failed != null {
        var error = dispatch_error == WorkBudgetError.None ? failed.resource_error : dispatch_error;
        sem_known_work_error(c, failed.subject, error, dispatch_error == WorkBudgetError.None);
        // Every dispatched ticket is already settled above. Retain those exact
        // terminal receipts; sem_ok prevents any later frontier from replaying.
        return SemanticPumpResult.Failed;
    }
    return SemanticPumpResult.Progress;
}

fn sem_known_jobs(c: SemanticContext*, kind: void*, count: usize, query_kind: SemanticQuery): vector(SemanticKnownWork*) {
    var jobs = sem_known_jobs_begin(c, kind, count, query_kind);
    var first: usize = 0;
    var state = sem_known_jobs_pump(c, &jobs, query_kind, &first);
    while state == SemanticPumpResult.Progress { state = sem_known_jobs_pump(c, &jobs, query_kind, &first); }
    // Ordered late phases call this only after their prerequisites have drained.
    // Early proof consumers retain jobs and use the pump directly instead.
    if state != SemanticPumpResult.Complete && sem_ok(c) {
        sem_known_admission_error(c, c.program.root, WorkBudgetError.Invalid);
    }
    return jobs;
}

fn sem_known_jobs_dispose(jobs: vector(SemanticKnownWork*)*): void {
    foreach(var job in jobs) {
        if job == null { continue; }
        work_arena_dispose(&job.scratch);
        vector_dispose(&job.candidates);
        vector_dispose(&job.mutations);
        vector_dispose(&job.patches);
        vector_dispose(&job.query_reads);
        foreach(var &update in &job.storage) {
            vector_dispose(&update.items);
            vector_dispose(&update.locals);
        }
        vector_dispose(&job.storage);
        job.context = null;
    }
    vector_dispose(jobs);
}
