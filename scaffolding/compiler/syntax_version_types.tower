import tower;
import frontend_revision_types;
import grammar_types;
import .library.vector;
import .library.work_budget_types;

// Private execution owner. Grammar meaning remains on the retained entities;
// tables, lexicons and expansion views are disposable derived data.
struct SyntaxVersion {
    references: usize;
    grammar: FrontendRevision*;
    rules: void*;
    table: void*;
    lexicon: void*;
    emission: void*;
    pending: void*;
    bedrock: FrontendRevision*;
    replacements: void*;
    replacement_error_offset: usize;
    kinds: FrontendKinds;
}

struct SyntaxVersionDiagnostic {
    resource_error: WorkBudgetError;
    text: vector(u8);
    fallback: u8*;
    offset: usize;
}

struct SyntaxVersionCache {
    index: FrontendCache;
    versions: vector(SyntaxVersion*);
}
