import tower;
import frontend_revision_types;

// Private execution owner. Grammar meaning remains on the retained entities;
// tables, lexicons and expansion views are disposable derived data.
struct SyntaxVersion {
    references: usize;
    grammar: FrontendRevision*;
    rules: void*;
    table: void*;
    lexicon: void*;
    emission: void*;
    pending: void*;
    bedrock: FrontendRevision*;
    replacements: void*;
    replacement_error_offset: usize;
}
