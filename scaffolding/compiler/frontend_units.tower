// The unit service owns orchestration and retention, and calls the one linked
// compiler/editor implementation through its typed service boundary.
extern fn frontend_source_length(source: u8*): usize;
extern fn frontend_source_nul(source: u8*, length: usize): usize;
extern fn frontend_compile_sources(program: SemanticProgram*, sources: FrontendSource*, count: usize, environment: void*): void;
extern fn completion_dispose(query: CompletionQuery*): void;
extern fn language_document_world(world: void*, environment: void*, source: u8*, length: usize, mode: u32, pointer_bytes: u32): CompletionQuery*;
extern fn language_document_result(query: CompletionQuery*): u8*;
extern fn sem_resource_message(error: WorkBudgetError): u8*;

extern fn compiler_work_create_result(count: usize, workers: usize, revision: u64, profile: u64,
    budget: WorkBudget*, output: void**): WorkBudgetError;

extern fn compiler_work_close(work: void*): void;

extern fn compiler_work_anchor(work: void*): void*;

extern fn compiler_work_subject(work: void*, ordinal: usize): void*;

extern fn compiler_work_next(work: void*): usize;

extern fn compiler_work_accept(work: void*, ordinal: usize, revision: u64, profile: u64, success: bool): bool;

extern fn compiler_work_done(work: void*): bool;

extern fn compiler_work_failed(work: void*): usize;

extern fn compiler_work_cancel(work: void*): void;
extern fn compiler_work_graph(work: void*): void*;
extern fn compiler_work_plan(work: void*): void*;

extern fn entity_create(store: void*): void*;

extern fn entity_create_related(anchor: void*): void*;
extern fn entity_create_related_result(anchor: void*, error: WorkBudgetError*): void*;

extern fn entity_release(node: void*): usize;

extern fn entity_register(kind: void*, size: usize, alignment: usize, lifecycle: usize): bool;
extern fn entity_register_stage_result(kind: void*, size: usize, alignment: usize, lifecycle: usize, stage_rows: u8): WorkBudgetError;

extern fn entity_component_add(node: void*, kind: void*): void*;
extern fn entity_component_add_result(node: void*, kind: void*, error: WorkBudgetError*): void*;

extern fn entity_component_get(node: void*, kind: void*): void*;

extern fn entity_component_data(component: void*): void*;

extern fn compiler_world_create_result(limit: usize, budget: WorkBudget*, output: void**): WorkBudgetError;

extern fn compiler_world_store(world: void*): void*;

extern fn compiler_world_dispose(world: void*): bool;

extern fn frontend_world_clear(world: void*): bool;

extern fn frontend_modules_create_result(error: WorkBudgetError*): void*;

extern fn frontend_modules_destroy(environment: void*): void;

extern fn frontend_modules_bind_world_result(environment: void*, world: void*): WorkBudgetError;

extern fn frontend_modules_configure(environment: void*, source: u8*, library: u8*): void;

extern fn syntax_baseline_install(world: void*, environment: void*, source: u8*, foundation: bool, diagnostic: SyntaxVersionDiagnostic*): bool;

extern fn syntax_version_diagnostic_text(diagnostic: SyntaxVersionDiagnostic*): u8*;

extern fn syntax_version_diagnostic_dispose(diagnostic: SyntaxVersionDiagnostic*): void;

extern fn semantic_initialize(program: SemanticProgram*, root: void*, width: u32): void;

extern fn semantic_program_dispose(program: SemanticProgram*): void;

extern fn entity_view_open(anchor: void*): void*;

extern fn entity_view_close(view: void*): void;

// The coordinator store owns recipes/results and query identities. Each unit
// owns a separate compiler world and module cache, handed exclusively to one
// worker. Immutable snapshots stay alive through cancellation and joins.
enum FrontendUnitAction: u32 {
    Compile, Inspect
}

struct FrontendText {
    storage: WorkBuffer;
    length: usize;
}

struct FrontendUnit {
    kernel: CompilerWorkKernel;
    batch: FrontendUnits*;
    ordinal: usize;
    world: void*;
    modules: void*;
    path: FrontendText;
    source: FrontendText;
    program: SemanticProgram;
    diagnostic: SyntaxVersionDiagnostic;
    inspection: CompletionQuery*;
    action: FrontendUnitAction;
    mode: u32;
    success: bool;
    configured: bool;
    execution: WorkReservation;
}

struct FrontendUnits {
    work: void*;
    count: usize;
    pool: WorkPool;
    budget: WorkBudget;
    budget_gate: void*;
    resource_error: u8*;
    resource_offset: usize;
    kind: void*;
    view: void*;
    bedrock: FrontendText;
    foundation: FrontendText;
    library: FrontendText;
    width: u32;
    revision: u64;
    profile: u64;
    started: bool;
    finished: bool;
    cancelled: bool;
    borrowed: bool;
    continuation: void*;
    next: function(CompilerWorkKernel*, void*);
    settle: function(void, void*, bool);
    observer: function(void, void*, CompilerQuery, usize, bool);
    observer_context: void*;
}

struct FrontendSnapshot { output: FrontendText*; source: u8*; length: usize; }
var FrontendSnapshotLimit: usize = 3;
// Compatibility callers have no declared-byte policy. New bounded callers must
// supply a finite cap; neither policy accounts opaque compiler/LLVM allocations.
var FrontendLegacyByteLimit: usize = ~convert(usize, 0);

fn frontend_units_release(batch: FrontendUnits*, receipt: WorkReservation*): void {
    if receipt.active && work_budget_release_result(&batch.budget, receipt) != WorkBudgetError.None {
        trap("Invalid compilation unit budget receipt", 0);
    }
}

// Immutable snapshots need exact storage, not geometric growth. Each physical
// buffer reserves its full request before allocation; publish only after every
// replacement exists. Denial/failure leaves every old buffer and receipt intact.
fn frontend_units_snapshot(batch: FrontendUnits*, inputs: FrontendSnapshot*, count: usize): bool {
    return frontend_units_snapshot_result(batch, inputs, count) == WorkBudgetError.None;
}

fn frontend_units_snapshot_result(batch: FrontendUnits*, inputs: FrontendSnapshot*, count: usize): WorkBudgetError {
    if count == 0 || count > FrontendSnapshotLimit { return WorkBudgetError.Invalid; }
    var bytes: usize = 0;
    for(var i: usize = 0; i < count; i++) {
        var length = inputs[i].length;
        if length == ~convert(usize, 0) { return WorkBudgetError.Invalid; }
        var allocated = compiler_buffer_allocation_size(length + 1);
        if allocated == 0 || allocated > ~convert(usize, 0) - bytes { return WorkBudgetError.Invalid; }
        bytes += allocated;
    }
    var copies: FrontendText[FrontendSnapshotLimit] = default;
    defer {
        for(var i: usize = 0; i < count; i++) { work_buffer_dispose(&copies[i].storage); }
    }
    for(var i: usize = 0; i < count; i++) {
        var input = &inputs[i];
        var output = &copies[i];
        var error = work_buffer_resize(&output.storage, &batch.budget, input.length + 1, 0);
        if error != WorkBudgetError.None { return error; }
        copy(output.storage.data, input.source, input.length);
        output.storage.data[input.length] = 0;
        output.length = input.length;
    }
    for(var i: usize = 0; i < count; i++) {
        work_buffer_move(&inputs[i].output.storage, &copies[i].storage);
        inputs[i].output.length = copies[i].length;
    }
    return WorkBudgetError.None;
}

fn frontend_units_job(batch: FrontendUnits*, ordinal: usize): FrontendUnit* {
    var subject = compiler_work_subject(batch.work, ordinal);
    if subject is null || batch.kind is null {
        return null;
    }
    return bits(FrontendUnit*, entity_component_data(entity_component_get(subject, batch.kind)));
}

// This entry runs through the ordinary compiler-kernel dispatch. All parsing,
// dependency resolution, lazy interpreter queries and diagnostics use the same
// services as single-unit compilation; no alternate evaluator or graph exists.
export fn compiler_unit_kernel(payload: void*): void {
    var job = bits(FrontendUnit*, payload);
    frontend_units_observe(job.batch, CompilerQuery.Unit, job.ordinal, true);
    defer frontend_units_observe(job.batch, CompilerQuery.Unit, job.ordinal, false);
    frontend_unit_compile(job);
}

fn frontend_unit_compile(job: FrontendUnit*): void {
    var batch = job.batch;
    job.success = syntax_baseline_install(job.world, job.modules, batch.bedrock.storage.data, false, &job.diagnostic);
    job.success &&= syntax_baseline_install(job.world, job.modules, batch.foundation.storage.data, true, &job.diagnostic);
    if !job.success {
        return;
    }
    if job.action == FrontendUnitAction.Inspect {
        job.inspection = language_document_world(job.world, job.modules, job.source.storage.data, job.source.length, job.mode, batch.width);
        job.success = job.inspection is not null;
        if !job.success {
            job.diagnostic.fallback = "Unable to create inspection query";
        }
        return;
    }
    var root = entity_create(compiler_world_store(job.world));
    if root is null {
        job.success = false;
        return;
    }
    semantic_initialize(&job.program, root, batch.width);
    var source: FrontendSource;
    source.data = job.source.storage.data;
    source.length = job.source.length;
    frontend_compile_sources(&job.program, &source, 1, job.modules);
    job.success = job.program.resource.error == WorkBudgetError.None && job.program.error.length == 0;
    if !job.success && job.program.resource.error == WorkBudgetError.None {
        if vector_reserve(&job.program.error, job.program.error.length + 1) {
            job.program.error.data[job.program.error.length] = 0;
        } else {
            job.program.error.length = 0;
            job.diagnostic.fallback = "Unable to allocate compilation unit diagnostic";
        }
    }
}

// Cancel the graph first, then join every admitted worker before releasing
// pinned component payloads. A cancelled batch never exposes result programs.
export fn frontend_units_cancel(batch: FrontendUnits*): void {
    if batch.finished {
        return;
    }
    batch.cancelled = true;
    compiler_work_cancel(batch.work);
    while batch.pool.running != 0 {
        work_pool_receive(&batch.pool, true);
    }
    if batch.settle != null { batch.settle(batch.continuation, false); }
    for(var ordinal: usize = 1; ordinal <= batch.count; ordinal++) {
        var job = frontend_units_job(batch, ordinal);
        if job != null { frontend_units_release(batch, &job.execution); }
    }
    if batch.view is not null {
        entity_view_close(batch.view);
        batch.view = null;
    }
    batch.finished = true;
}

export fn frontend_units_close(batch: FrontendUnits*): void {
    if batch is null {
        return;
    }
    if batch.borrowed { trap("Compilation units still borrowed by a backend", 0); }
    if batch.work is not null {
        frontend_units_cancel(batch);
    }
    if batch.budget.wake != null && !work_budget_set_wake(&batch.budget, null, null) {
        trap("Compilation budget wake still borrowed", 0);
    }
    work_pool_close(&batch.pool);
    if batch.work is not null {
        for(var i: usize = 1; i <= batch.count; i++) {
            var job = frontend_units_job(batch, i);
            if job is null {
                continue;
            }
            if job.inspection is not null {
                completion_dispose(job.inspection);
            }
            var root = job.program.root;
            semantic_program_dispose(&job.program);
            if root is not null {
                entity_release(root);
            }
            if job.modules is not null {
                frontend_modules_destroy(job.modules);
            }
            if job.world is not null &&(!frontend_world_clear(job.world) || !compiler_world_dispose(job.world)) {
                trap("Compilation unit world still borrowed", 0);
            }
            syntax_version_diagnostic_dispose(&job.diagnostic);
            work_buffer_dispose(&job.path.storage);
            work_buffer_dispose(&job.source.storage);
        }
    }
    if batch.kind is not null {
        entity_release(batch.kind);
    }
    compiler_work_close(batch.work);
    work_buffer_dispose(&batch.bedrock.storage);
    work_buffer_dispose(&batch.foundation.storage);
    work_buffer_dispose(&batch.library.storage);
    if !work_budget_dispose(&batch.budget) { trap("Compilation budget still borrowed", 0); }
    work_gate_close(batch.budget_gate);
    free(batch);
}

// Budget bounds simultaneously executing compiler lanes. Each outer job owns
// one lane; nested phases borrow extra lanes from this same synchronized ledger.
// Width is explicit target layout, independent of the host or worker count.
export fn frontend_units_create(count: usize, budget: usize, width: u32,
revision: u64, profile: u64, bedrock: u8*, foundation: u8*, library: u8*): FrontendUnits* {
    var error = WorkBudgetError.None;
    return frontend_units_open(count, budget, FrontendLegacyByteLimit, width, revision, profile, bedrock, foundation, library, &error);
}

export fn frontend_units_create_bounded(count: usize, budget: usize, retained_bytes: usize, width: u32,
revision: u64, profile: u64, bedrock: u8*, foundation: u8*, library: u8*): FrontendUnits* {
    var error = WorkBudgetError.None;
    return frontend_units_create_bounded_result(count, budget, retained_bytes, width, revision, profile, bedrock, foundation, library, &error);
}

export fn frontend_units_create_bounded_result(count: usize, budget: usize, retained_bytes: usize, width: u32,
revision: u64, profile: u64, bedrock: u8*, foundation: u8*, library: u8*, error: WorkBudgetError*): FrontendUnits* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if retained_bytes == 0 || retained_bytes == FrontendLegacyByteLimit { return null; }
    return frontend_units_open(count, budget, retained_bytes, width, revision, profile, bedrock, foundation, library, error);
}

fn frontend_units_open(count: usize, budget: usize, retained_bytes: usize, width: u32,
revision: u64, profile: u64, bedrock: u8*, foundation: u8*, library: u8*, error: WorkBudgetError*): FrontendUnits* {
    *error = WorkBudgetError.Invalid;
    if count == 0 || budget == 0 || budget > WorkPoolMaximumCapacity ||(width != 4 && width != 8)
    || bedrock is null || foundation is null || library is null {
        return null;
    }
    var batch = alloc(FrontendUnits, 1);
    if batch is null {
        *error = WorkBudgetError.Memory;
        return null;
    }
    *batch = default;
    batch.width = width;
    batch.revision = revision;
    batch.profile = profile;
    var available = work_thread_available() ? work_thread_capacity() : 1;
    if budget > available { budget = available; }
    if !work_budget_init(&batch.budget, budget, retained_bytes, 1) {
        frontend_units_close(batch); return null;
    }
    if budget > 1 {
        batch.budget_gate = work_gate_open();
        if batch.budget_gate == null { *error = WorkBudgetError.Memory; frontend_units_close(batch); return null; }
        if !work_budget_synchronize(&batch.budget, batch.budget_gate, work_gate_enter, work_gate_leave) {
            frontend_units_close(batch); return null;
        }
    }
    var lanes = count < budget ? count: budget;
    if !work_pool_open_kernel_budget(&batch.pool, lanes, compiler_work_kernel_execute, &batch.budget) {
        *error = batch.pool.resource_error;
        frontend_units_close(batch);
        return null;
    }
    if batch.pool.threaded && !work_budget_set_wake(&batch.budget, work_pool_wake_signal(&batch.pool), work_signal_post) {
        *error = WorkBudgetError.Invalid; frontend_units_close(batch); return null;
    }
    batch.count = count;
    *error = compiler_work_create_result(count, batch.pool.count, revision, profile, &batch.budget, &batch.work);
    if *error != WorkBudgetError.None {
        frontend_units_close(batch);
        return null;
    }
    batch.kind = entity_create_related_result(compiler_work_anchor(batch.work), error);
    if batch.kind == null { frontend_units_close(batch); return null; }
    *error = entity_register_stage_result(batch.kind, sizeof(FrontendUnit), alignof(FrontendUnit), 0, 0);
    if *error != WorkBudgetError.None {
        frontend_units_close(batch); return null;
    }
    var inputs: FrontendSnapshot[FrontendSnapshotLimit];
    inputs[0] = { output: &batch.bedrock, source: bedrock, length: frontend_source_length(bedrock) };
    inputs[1] = { output: &batch.foundation, source: foundation, length: frontend_source_length(foundation) };
    inputs[2] = { output: &batch.library, source: library, length: frontend_source_length(library) };
    *error = frontend_units_snapshot_result(batch, &inputs[0], sizeof(decltype(inputs)) / sizeof(FrontendSnapshot));
    if *error != WorkBudgetError.None {
        frontend_units_close(batch);
        return null;
    }
    for(var i: usize = 1; i <= count; i++) {
        var node = compiler_work_subject(batch.work, i);
        var job = bits(FrontendUnit*, entity_component_data(entity_component_add_result(node, batch.kind, error)));
        if job is null {
            frontend_units_close(batch);
            return null;
        }
        *job = default;
        job.batch = batch;
        job.ordinal = i;
        job.kernel.payload = bits(void*, job);
        job.kernel.execute = compiler_unit_kernel;
        job.kernel.receive = frontend_unit_receive;
        *error = compiler_world_create_result(budget, &batch.budget, &job.world);
        if *error != WorkBudgetError.None {
            frontend_units_close(batch);
            return null;
        }
        job.modules = frontend_modules_create_result(error);
        if job.modules != null { *error = frontend_modules_bind_world_result(job.modules, job.world); }
        if *error != WorkBudgetError.None {
            frontend_units_close(batch);
            return null;
        }
    }
    *error = WorkBudgetError.None;
    return batch;
}

export fn frontend_units_source(batch: FrontendUnits*, ordinal: usize, path: u8*, source: u8*, length: usize): bool {
    if batch.started || batch.finished || path is null || source is null || length == ~convert(usize, 0) {
        return false;
    }
    batch.resource_error = null;
    batch.resource_offset = 0;
    var job = frontend_units_job(batch, ordinal);
    if job is null {
        return false;
    }
    // The current frontend accepts terminated text. Reject embedded NUL rather
    // than silently compiling only a prefix of this explicit input snapshot.
    var nul = frontend_source_nul(source, length);
    if nul != length {
        batch.resource_error = "Compilation source contains an embedded NUL byte";
        batch.resource_offset = nul;
        return false;
    }
    var inputs: FrontendSnapshot[2];
    inputs[0] = { output: &job.path, source: path, length: frontend_source_length(path) };
    inputs[1] = { output: &job.source, source: source, length: length };
    if !frontend_units_snapshot(batch, &inputs[0], sizeof(decltype(inputs)) / sizeof(FrontendSnapshot)) { return false; }
    frontend_modules_configure(job.modules, job.path.storage.data, batch.library.storage.data);
    job.configured = true;
    return true;
}

// Inspection uses the same unit query, immutable snapshots and world ownership.
// Its recoverable source diagnostics are part of the returned document, rather
// than an executable program. Batch failure/cancellation still hides all output.
export fn frontend_units_inspect(batch: FrontendUnits*, ordinal: usize, mode: u32): bool {
    if batch.started || batch.finished || batch.borrowed || mode > 2 {
        return false;
    }
    var job = frontend_units_job(batch, ordinal);
    if job is null {
        return false;
    }
    job.action = FrontendUnitAction.Inspect;
    job.mode = mode;
    return true;
}

fn frontend_unit_receive(payload: void*): void {
    var job = bits(FrontendUnit*, payload);
    var batch = job.batch;
    if !compiler_work_accept(batch.work, job.ordinal, batch.revision, batch.profile, job.success) {
        trap("Stale compilation unit receipt", 0);
    }
    frontend_units_release(batch, &job.execution);
}

fn frontend_units_receive(batch: FrontendUnits*, wait: bool): bool {
    var event: void* = null;
    if !work_pool_receive_event(&batch.pool, wait, &event) { return false; }
    var kernel = bits(CompilerWorkKernel*, event);
    if kernel != null { kernel.receive(kernel.payload); }
    return true;
}

// Poll is the only coordinator mutation entry while workers run. Completion
// order cannot change diagnostics: the graph settles every earlier ordinal.
export fn frontend_units_step(batch: FrontendUnits*, wait: bool): bool {
    if batch.finished {
        return true;
    }
    if !batch.started {
        for(var i: usize = 1; i <= batch.count; i++) {
            if !frontend_units_job(batch, i).configured {
                return false;
            }
        }
        batch.view = entity_view_open(compiler_work_anchor(batch.work));
        if batch.view is null {
            frontend_units_cancel(batch);
            return true;
        }
        batch.resource_error = null;
        batch.resource_offset = 0;
        batch.started = true;
    }
    loop {
        while batch.pool.running < batch.pool.count && compiler_work_failed(batch.work) == 0 {
            // Ready downstream queries get the released lane immediately. Both
            // phases use this pool, so their total dispatch cannot exceed its
            // budget. Completion and nested lane release both wake this owner;
            // the latter retries readiness before the outer unit has finished.
            var kernel: CompilerWorkKernel* = null;
            if batch.next != null { kernel = batch.next(batch.continuation); }
            if batch.finished { return true; }
            if kernel == null {
                var receipt: WorkReservation = default;
                var admission = work_budget_reserve_result(&batch.budget, 1, 1, 0, &receipt);
                if admission == WorkBudgetError.Capacity { break; }
                if admission != WorkBudgetError.None {
                    batch.resource_error = "Unable to reserve compilation unit worker";
                    frontend_units_cancel(batch); return true;
                }
                var ordinal = compiler_work_next(batch.work);
                if ordinal == 0 { frontend_units_release(batch, &receipt); break; }
                var job = frontend_units_job(batch, ordinal);
                job.execution = receipt;
                kernel = &job.kernel;
            }
            if !work_pool_submit(&batch.pool, bits(void*, kernel)) {
                frontend_units_cancel(batch);
                return true;
            }
        }
        if batch.pool.running == 0 {
            if !compiler_work_done(batch.work) { frontend_units_cancel(batch); return true; }
            if batch.settle != null { batch.settle(batch.continuation, compiler_work_failed(batch.work) == 0); }
            entity_view_close(batch.view);
            batch.view = null;
            batch.finished = true;
            return true;
        }
        if !frontend_units_receive(batch, wait) { return false; }
    }
}

export fn frontend_units_failed(batch: FrontendUnits*): usize {
    return compiler_work_failed(batch.work);
}

// Configuration and diagnostics borrow the private environment only while no
// worker can access it. Callers must not retain this borrow across step/close.
export fn frontend_units_environment(batch: FrontendUnits*, ordinal: usize): void* {
    if batch.started && !batch.finished { return null; }
    var job = frontend_units_job(batch, ordinal);
    return job == null ? null : job.modules;
}

export fn frontend_units_error_offset(batch: FrontendUnits*): usize {
    if !batch.started && batch.resource_error != null { return batch.resource_offset; }
    if !batch.finished || batch.cancelled || frontend_units_failed(batch) == 0 { return 0; }
    var job = frontend_units_job(batch, frontend_units_failed(batch));
    if job.program.resource.error != WorkBudgetError.None { return job.program.resource.offset; }
    return job.program.error.length == 0 ? job.diagnostic.offset : job.program.error_offset;
}

// One coordinator may extend a fresh plan or completed unit queries. An active
// dispatch cannot acquire a new owner; the frontend must outlive the lease.
export fn frontend_units_work_acquire(batch: FrontendUnits*): void* {
    if (batch.started && !batch.finished) || batch.cancelled || batch.borrowed { return null; }
    var graph = batch.started ? compiler_work_graph(batch.work) : compiler_work_plan(batch.work);
    if graph == null { return null; }
    batch.borrowed = true;
    return batch.work;
}

export fn frontend_units_work_release(batch: FrontendUnits*): void {
    if !batch.borrowed { trap("Compilation unit lease was not acquired", 0); }
    batch.borrowed = false;
    batch.continuation = null;
    batch.next = null;
    batch.settle = null;
}

// Configure a continuation before dispatch. Only its completed unit dependencies
// may expose program payloads; recipes and callbacks remain frozen until join.
export fn frontend_units_pending(batch: FrontendUnits*): bool { return !batch.started && !batch.finished; }

// Optional worker event tracing. Freeze the callback/context before dispatch;
// observers own their synchronization and must not mutate compiler state.
export fn frontend_units_observer(batch: FrontendUnits*, context: void*,
    event: function(void, void*, CompilerQuery, usize, bool)): bool {
    if batch.started || batch.finished { return false; }
    batch.observer = event;
    batch.observer_context = context;
    return true;
}

export fn frontend_units_observe(batch: FrontendUnits*, phase: CompilerQuery, ordinal: usize, entering: bool): void {
    if batch.observer != null { batch.observer(batch.observer_context, phase, ordinal, entering); }
}

export fn frontend_units_peak(batch: FrontendUnits*): usize { return batch.pool.peak; }

// Borrowed immutable binding; callers use synchronized per-call ledger APIs.
// The frontend (including retained input receipts) outlives all borrowers.
export fn frontend_units_work_budget(batch: FrontendUnits*): WorkBudget* { return &batch.budget; }

// Retained input subtotal, separate from parser/world/output owners sharing the
// ledger. The coordinator configures these buffers before dispatch; workers
// borrow them unchanged until the batch closes.
export fn frontend_units_input_bytes(batch: FrontendUnits*): usize {
    var bytes = batch.bedrock.storage.reservation.bytes
        + batch.foundation.storage.reservation.bytes + batch.library.storage.reservation.bytes;
    for(var i: usize = 1; i <= batch.count; i++) {
        var job = frontend_units_job(batch, i);
        if job != null { bytes += job.path.storage.reservation.bytes + job.source.storage.reservation.bytes; }
    }
    return bytes;
}

export fn frontend_units_work_extend(batch: FrontendUnits*, context: void*,
    next: function(CompilerWorkKernel*, void*), settle: function(void, void*, bool)): bool {
    if !batch.borrowed || batch.started || batch.finished || batch.next != null
        || context == null || next == null || settle == null { return false; }
    batch.continuation = context;
    batch.next = next;
    batch.settle = settle;
    return true;
}

// Address-only recipe borrow; contents are not readable until the unit query
// has succeeded and its worker receipt has been joined by this coordinator.
export fn frontend_units_program_recipe(batch: FrontendUnits*, ordinal: usize): SemanticProgram* {
    if !batch.borrowed || batch.started || batch.finished { return null; }
    var job = frontend_units_job(batch, ordinal);
    return job == null || job.action != FrontendUnitAction.Compile ? null : &job.program;
}

export fn frontend_units_cancelled(batch: FrontendUnits*): bool {
    return batch.cancelled;
}

// Borrow only after every worker joined and the whole compilation succeeded.
// The programs retain their private world until batch close; LLVM can consume
// these canonical Foundation entities with one context/module per result.
export fn frontend_units_program(batch: FrontendUnits*, ordinal: usize): SemanticProgram* {
    if !batch.finished || batch.cancelled || compiler_work_failed(batch.work) != 0 {
        return null;
    }
    var job = frontend_units_job(batch, ordinal);
    return job is null || job.action != FrontendUnitAction.Compile ? null: &job.program;
}

export fn frontend_units_document(batch: FrontendUnits*, ordinal: usize): u8* {
    if !batch.finished || batch.cancelled || compiler_work_failed(batch.work) != 0 {
        return null;
    }
    var job = frontend_units_job(batch, ordinal);
    return job is null || job.inspection is null ? null: language_document_result(job.inspection);
}

export fn frontend_units_error(batch: FrontendUnits*): u8* {
    if (!batch.started || batch.cancelled) && batch.resource_error != null { return batch.resource_error; }
    if !batch.finished || batch.cancelled || compiler_work_failed(batch.work) == 0 {
        return "";
    }
    var job = frontend_units_job(batch, compiler_work_failed(batch.work));
    if job.program.resource.error != WorkBudgetError.None {
        return sem_resource_message(job.program.resource.error);
    }
    if job.program.error.length != 0 {
        return job.program.error.data;
    }
    var error = syntax_version_diagnostic_text(&job.diagnostic);
    return error[0] == 0 ? "Unable to allocate compilation unit storage": error;
}
