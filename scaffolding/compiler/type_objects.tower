import tower;
import foundation_types;
import foundation_tags;
import type_object_index_types;
import .library.vector;
import .library.work_vector;
import .library.work_vector_types;
import .library.work_budget_types;

extern fn semantic_type_equal(left: FoundationType*, right: FoundationType*): bool;
extern fn sem_get(node: void*): FoundationNode*;
extern fn sem_require(ok: bool): void;
extern fn foundation_execution_item(parent: FoundationNode*, child: FoundationNode*): bool;
extern fn foundation_execution_reference(node: FoundationNode*): void*;

// Call after signature/field producers complete. Pointer transport still exposes
// its declared payload, including callback signatures and recursive records.
// The visited list is a disposable traversal index over the existing entities.
export fn type_object_abi_safe(type: FoundationType*): bool {
    var safe = false;
    sem_require(type_object_abi_safe_result(type, null, &safe) == WorkBudgetError.None);
    return safe;
}

export fn type_object_abi_safe_result(type: FoundationType*, budget: WorkBudget*, safe: bool*): WorkBudgetError {
    *safe = false;
    var pending: work_vector(FoundationType) = default;
    var visited: work_vector(void*) = default;
    defer work_vector_dispose(&pending);
    defer work_vector_dispose(&visited);
    var error = work_vector_push_result(&pending, budget, *type);
    if error != WorkBudgetError.None { return error; }
    while pending.length != 0 {
        var current = pending.data[--pending.length];
        if current.scalar == SType { return WorkBudgetError.None; }
        if current.scalar != SStruct && current.scalar != SArray && current.scalar != SFunction { continue; }
        if current.record == null { return WorkBudgetError.None; }
        var seen = false;
        foreach(var record in &visited) { if record == current.record { seen = true; break; } }
        if seen { continue; }
        error = work_vector_push_result(&visited, budget, current.record);
        if error != WorkBudgetError.None { return error; }
        var record = sem_get(current.record);
        if record == null { return WorkBudgetError.None; }
        if current.scalar == SArray || current.scalar == SFunction {
            error = work_vector_push_result(&pending, budget, record.element);
            if error != WorkBudgetError.None { return error; }
        }
        if current.scalar == SStruct {
            foreach(var field in &record.items) {
                error = work_vector_push_result(&pending, budget, sem_get(field).type);
                if error != WorkBudgetError.None { return error; }
            }
        }
        if current.scalar == SFunction {
            foreach(var parameter in &record.parameters) {
                error = work_vector_push_result(&pending, budget, sem_get(parameter).type);
                if error != WorkBudgetError.None { return error; }
            }
        }
    }
    *safe = true;
    return WorkBudgetError.None;
}

// LLVM's scalar return path cannot reconstruct opaque type identity after it
// lowers to an integer index. Preserve the checked Foundation program instead.
// Runtime roots and function references share the source emitters' policy.
// Keep canonical declarations intact; this is a disposable derived traversal.
export fn type_object_program(root: void*): bool {
    var contains = false;
    sem_require(type_object_program_result(root, null, &contains) == WorkBudgetError.None);
    return contains;
}

export fn type_object_program_result(root: void*, budget: WorkBudget*, contains: bool*): WorkBudgetError {
    *contains = false;
    var pending: work_vector(void*) = default;
    var functions: work_vector(void*) = default;
    defer work_vector_dispose(&pending);
    defer work_vector_dispose(&functions);
    var error = work_vector_push_result(&pending, budget, root);
    if error != WorkBudgetError.None { return error; }
    while pending.length != 0 {
        var subject = pending.data[--pending.length];
        if subject == null { continue; }
        var node = sem_get(subject);
        if node == null { continue; }
        if node.kind == KFunction {
            var seen = false;
            foreach(var function in &functions) { if function == subject { seen = true; break; } }
            if seen { continue; }
            error = work_vector_push_result(&functions, budget, subject);
            if error != WorkBudgetError.None { return error; }
        }
        if node.kind == KTypeReference || node.type.scalar == SType || node.element.scalar == SType {
            *contains = true;
            return WorkBudgetError.None;
        }
        if node.kind == KLabel { continue; }
        error = work_vector_push_result(&pending, budget, foundation_execution_reference(node));
        if error != WorkBudgetError.None { return error; }
        error = work_vector_push_result(&pending, budget, node.left);
        if error != WorkBudgetError.None { return error; }
        error = work_vector_push_result(&pending, budget, node.right);
        if error != WorkBudgetError.None { return error; }
        error = work_vector_push_result(&pending, budget, node.value);
        if error != WorkBudgetError.None { return error; }
        error = work_vector_push_result(&pending, budget, node.target);
        if error != WorkBudgetError.None { return error; }
        error = work_vector_push_result(&pending, budget, node.body);
        if error != WorkBudgetError.None { return error; }
        error = work_vector_push_result(&pending, budget, node.otherwise);
        if error != WorkBudgetError.None { return error; }
        foreach(var item in &node.items) {
            if foundation_execution_item(node, sem_get(item)) {
                error = work_vector_push_result(&pending, budget, item);
                if error != WorkBudgetError.None { return error; }
            }
        }
        foreach(var parameter in &node.parameters) {
            error = work_vector_push_result(&pending, budget, parameter);
            if error != WorkBudgetError.None { return error; }
        }
        foreach(var attribute in &node.attributes) {
            error = work_vector_push_result(&pending, budget, attribute);
            if error != WorkBudgetError.None { return error; }
        }
    }
    return WorkBudgetError.None;
}

// Disposable execution indexes for opaque type values. The canonical payload
// remains a Foundation type descriptor, including its nominal entity binding.
// Index order is private; formatting and staging relocate descriptors, never IDs.
export fn type_object_intern(values: vector(FoundationType)*, type: FoundationType*): u64 {
    var found = type_object_find(values.data, values.length, type);
    if found != 0 { return found; }
    if values.length == TypeObjectIndexLimit || !vector_push(values, *type) { return 0; }
    return convert(u64, values.length);
}

fn type_object_find(values: FoundationType*, count: usize, type: FoundationType*): u64 {
    for(var i: usize = 0; i < count; i++) {
        if semantic_type_equal(&values[i], type) { return convert(u64, i) + 1; }
    }
    return 0;
}

export fn type_object_index_intern(index: TypeObjectIndex*, budget: WorkBudget*, type: FoundationType*): u64 {
    if index.error != WorkBudgetError.None { return 0; }
    var values = &index.values;
    if values.length > values.capacity || (values.data != null && values.reservation.owner != budget) {
        index.error = WorkBudgetError.Invalid;
        return 0;
    }
    var found = type_object_find(values.data, values.length, type);
    if found != 0 { return found; }
    if values.length == TypeObjectIndexLimit {
        index.error = WorkBudgetError.Capacity;
        return 0;
    }
    index.error = work_vector_push_result(values, budget, *type);
    return index.error == WorkBudgetError.None ? convert(u64, values.length) : 0;
}

export fn type_object_index_dispose(index: TypeObjectIndex*): void {
    work_vector_dispose(&index.values);
    index.error = WorkBudgetError.None;
}
