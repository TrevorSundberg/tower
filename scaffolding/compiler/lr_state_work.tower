import tower;
import worker_policy;
import compiler_kernel;
import lr_analysis;
import lr_states;
import lr_types;
import lr_work;
import parser_workers;
import .library.vector;
import .library.work_graph;
import .library.work_pool;

struct LRStateTask {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    analysis: LRAnalysis*;
    source: LRItems*;
    symbols: usize*;
    results: LRItems**;
    begin: usize;
    count: usize;
    resource_error: WorkBudgetError;
}

var LRStateGrain: usize = 128;
var LRStateFanout: usize = 4;
var LRStateWorkPerJob: usize = 65536;
var LRStateRefineMinimumJobs: usize = 4;
var LRStateSerialMinimum: usize = 32;

export fn compiler_lr_state_kernel(payload: void*): void {
    var task = bits(LRStateTask*, payload);
    var analysis: LRAnalysis;
    copy(&analysis, task.analysis, sizeof(LRAnalysis));
    task.resource_error = WorkBudgetError.None;
    for(var i = task.begin; i < task.begin + task.count; i++) {
        var result = lr_items_create();
        task.results[i] = result;
        if result == null { task.resource_error = WorkBudgetError.Memory; return; }
        if !lr_items_goto(&analysis, task.source, &analysis.symbols[task.symbols[i]], result, false) {
            task.resource_error = lr_items_error(result);
            return;
        }
    }
}

// Outgoing closures of one state are independent. Only the coordinator interns
// kernels, publishes transition IDs and pops the pending stack, in exactly the
// serial order. Workers never mutate the state index or share failed flags.
export fn lr_states_create_parallel(analysis: LRAnalysis*, anchor: void*): LRStates* {
    var error = WorkBudgetError.None;
    return lr_states_create_parallel_result(analysis, anchor, &error);
}

export fn lr_states_create_parallel_result(analysis: LRAnalysis*, anchor: void*, error: WorkBudgetError*): LRStates* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if analysis == null || analysis.symbol_count > ~convert(usize, 0) - analysis.rule_count { return null; }
    var capacity = compiler_worker_capacity(anchor);
    if capacity <= 1 || anchor == null || analysis.symbol_count + analysis.rule_count < LRStateSerialMinimum {
        return lr_states_create_result(analysis, error);
    }
    var value = lr_states_begin_result(analysis, error);
    if value == null { return null; }
    defer lr_states_destroy(value);
    var shifts: LRShiftIndex = default;
    defer lr_shift_index_dispose(&shifts);
    var owner: void* = null;
    defer { if owner != null { entity_release(owner); } }
    var nodes: void*[WorkPoolMaximumCapacity];
    var jobs: LRStateTask*[WorkPoolMaximumCapacity];
    if capacity > sizeof(decltype(jobs)) / sizeof(LRStateTask*) { *error = WorkBudgetError.Invalid; return null; }
    var workers: ParserWorkers = default;
    defer parser_workers_close(&workers);
    var graph: WorkGraph;
    if !work_init_budget(&graph, 1, 0, compiler_world_work_budget(compiler_node_world(anchor))) {
        *error = lr_work_error(&graph); return null;
    }
    defer work_dispose(&graph);
    var results: vector(LRItems*);
    vector_init(LRItems*, &results);
    defer {
        for(var i: usize = 0; i < results.length; i++) { lr_items_destroy(results.data[i]); }
        vector_dispose(LRItems*, &results);
    }
    var ok = true;
    while value.pending.length != 0 && ok {
        value.pending.length--;
        var state = value.states.data[value.pending.data[value.pending.length]];
        *error = lr_state_symbols_result(analysis, state);
        if *error != WorkBudgetError.None { return null; }
        // A single outgoing edge exposes no parallel work; tiny closures cost
        // less than the handoff. Keep the same transition algorithm in both
        // paths and start platform threads only for a useful ready batch.
        var count: usize = 0;
        if state.symbols.length >= LRStateFanout && state.items.values.length >= LRStateGrain {
            // Each outgoing shift scans the source items. Bound the number of
            // jobs by that known work, without overflowing an items*edges product.
            // Closure expansion can add work; this is a conservative admission
            // estimate, not a claim that every edge has identical cost.
            var items = state.items.values.length;
            var symbols_per_job = LRStateWorkPerJob / items + (LRStateWorkPerJob % items != 0 ? 1 : 0);
            count = state.symbols.length / symbols_per_job;
            // Keep the measured coarse grain for narrow batches. Once several
            // full chunks are available, finer pieces profitably fill more lanes.
            if count >= LRStateRefineMinimumJobs {
                var work_per_job = LRStateWorkPerJob / 2;
                symbols_per_job = work_per_job / items + (work_per_job % items != 0 ? 1 : 0);
                count = state.symbols.length / symbols_per_job;
            }
            if count > capacity { count = capacity; }
        }
        var admission: ParserAdmission = default;
        defer parser_admission_close(&admission, &graph);
        if count >= 2 {
            *error = parser_admission_open_result(&admission, anchor, count);
            if *error != WorkBudgetError.None { return null; }
        }
        if count < 2 || admission.extra == 0 {
            *error = lr_shift_index_result(&shifts, analysis, state);
            if *error != WorkBudgetError.None { return null; }
            for(var i: usize = 0; i < state.symbols.length && ok; i++) {
                *error = lr_state_transition_result(value, state, i, &shifts);
                ok = *error == WorkBudgetError.None;
            }
            continue;
        }
        // A grammar can contain many symbols yet never expose a useful state
        // frontier. Allocate ECS jobs only when the same gate admits workers.
        // Reuse them for later states; all inputs stay frozen until each join.
        if owner == null {
            owner = entity_create_related_result(anchor, error);
            if owner == null { return null; }
            var kind = lr_work_node_result(owner, error);
            if kind == null { return null; }
            *error = entity_register_stage_result(kind, sizeof(LRStateTask), alignof(LRStateTask), 0, 0);
            if *error != WorkBudgetError.None { return null; }
            for(var i: usize = 0; i < capacity; i++) {
                nodes[i] = lr_work_node_result(owner, error);
                if nodes[i] == null { return null; }
                jobs[i] = bits(LRStateTask*, entity_component_data(entity_component_add_result(nodes[i], kind, error)));
                if jobs[i] == null { return null; }
                *jobs[i] = default;
                jobs[i].analysis = analysis;
                jobs[i].kernel.kind = CompilerKernelKind.LRState;
                jobs[i].kernel.payload = bits(void*, jobs[i]);
            }
            *error = parser_workers_open_result(&workers, anchor, capacity);
            if *error != WorkBudgetError.None { return null; }
        }
        var pool = workers.pool;
        *error = lr_reserve_result(&results, state.symbols.length);
        if *error != WorkBudgetError.None { return null; }
        results.length = state.symbols.length;
        fill(results.data, 0, results.length * sizeof(LRItems*));
        if count > pool.count { count = pool.count; }
        var position: usize = 0;
        // One joined wave per state. Each worker owns a contiguous output range,
        // amortizing dispatch over several closures instead of one tiny edge.
        for(var i: usize = 0; i < count && ok; i++) {
            var job = jobs[i];
            job.source = state.items;
            job.symbols = state.symbols.data;
            job.results = results.data;
            job.begin = position;
            job.count = results.length / count + (i < results.length % count ? 1 : 0);
            position += job.count;
            var id = work_request(&graph, nodes[i], 1, convert(u64, job.begin));
            ok = id != 0;
            ok &&= work_access(&graph, id, 1, 1, job.begin, job.count, WorkAccessMode.Write);
            ok &&= work_access(&graph, id, 1, 2, 0, 1, WorkAccessMode.Read);
            ok &&= work_seal(&graph, id);
            ok &&= work_demand(&graph, id);
            ok &&= work_take(&graph, &job.ticket);
        }
        if !ok { *error = lr_work_error(&graph); break; }
        var view = entity_view_open_result(owner, error);
        if view == null { return null; }
        *error = compiler_kernel_dispatch_admitted_result(pool, &jobs[0], count, admission.extra);
        entity_view_close(view);
        if *error != WorkBudgetError.None { return null; }
        for(var i: usize = 0; i < count; i++) {
            if !work_finish(&graph, &jobs[i].ticket, jobs[i].resource_error == WorkBudgetError.None) { ok = false; }
        }
        if !ok { *error = lr_work_error(&graph); return null; }
        for(var i: usize = 0; i < count; i++) {
            if jobs[i].resource_error != WorkBudgetError.None { *error = jobs[i].resource_error; return null; }
        }
        for(var i: usize = 0; i < results.length; i++) {
            var items = results.data[i];
            results.data[i] = null;
            if !ok { lr_items_destroy(items); continue; }
            var edge: LRTransition;
            edge.symbol = state.symbols.data[i];
            edge.state = lr_states_intern_result(value, items, edge.symbol, true, error);
            ok = edge.state != lr_none();
            if ok { *error = lr_push_result(&state.edges, edge); ok = *error == WorkBudgetError.None; }
        }
        results.length = 0;
        // No consumer crosses this joined wave. Retain capacity while rejecting
        // every prior ticket, including when a component slot is reused.
        if ok && !work_reset(&graph, graph.revision + 1, 0) { *error = lr_work_error(&graph); ok = false; }
    }
    if !ok { return null; }
    var result = value;
    value = null;
    return result;
}
