import tower;
import lexer_table;
import lr_analysis;
import lr_runtime;
import lr_states;
import syntax_types;
import .library.vector;
import lr_types;

// A revision's disposable lexical index. Patterns and text borrow its immutable
// declaration entities; declarations remain the authoritative grammar nodes.
struct LexiconToken {
    table: LexerTable*;
    id: u32;
    style: u8*;
    skipped: bool;
    contextual: bool;
    identifier: bool;
}

struct LexiconLiteral {
    text: u8*;
    length: usize;
    id: u32;
    word: bool;
    declaration: bool;
}

struct SyntaxLexicon {
    tokens: vector(LexiconToken);
    literals: vector(LexiconLiteral);
    starts: vector(LexiconLiteral);
}

struct LexiconChoice {
    length: usize;
    id: u32;
    style: u8*;
    skipped: bool;
    checks: usize;
}

fn lexicon_letter(byte: u8): bool {
    var valid = byte >= 97;
    valid &&= byte <= 122;
    if valid {
        return true;
    }
    valid = byte >= 65;
    valid &&= byte <= 90;
    if valid {
        return true;
    }
    valid = byte == 95;
    return valid;
}

fn lexicon_word(text: u8*, length: usize): bool {
    if length == 0 {
        return false;
    }
    var valid = lexicon_letter(text[0]);
    if !valid {
        return false;
    }
    var index: usize = 1;
    loop {
        if index == length {
            return true;
        }
        var byte = text[index];
        valid = lexicon_letter(byte);
        if !valid {
            valid = byte >= 48;
            valid &&= byte <= 57;
            if !valid {
                return false;
            }
        }
        index++;
    }
}

fn lexicon_prefix(source: u8*, length: usize, start: usize, text: u8*, count: usize): bool {
    var invalid = start > length;
    if invalid {
        return false;
    }
    var remaining = length -start;
    invalid = count > remaining;
    if invalid {
        return false;
    }
    var index: usize = 0;
    loop {
        if index == count {
            return true;
        }
        var at = start + index;
        if source[at] != text[index] {
            return false;
        }
        index++;
    }
}

export fn lexicon_create(): SyntaxLexicon* {
    var value = alloc(SyntaxLexicon, 1);
    if value != null {
        *value = default;
    }
    return value;
}

export fn lexicon_destroy(value: SyntaxLexicon*): void {
    if value == null {
        return;
    }
    vector_dispose(&value.tokens);
    vector_dispose(&value.literals);
    vector_dispose(&value.starts);
    free(value);
}

export fn lexicon_token(value: SyntaxLexicon*, table: LexerTable*, id: u32, style: u8*, skipped: bool, contextual: bool, identifier: bool): bool {
    var entry: LexiconToken = {
        table: table, id: id, style: style, skipped: skipped, contextual: contextual, identifier: identifier
    };
    return lr_append(LexiconToken, &value.tokens, &entry);
}

export fn lexicon_literal(value: SyntaxLexicon*, text: u8*, length: usize, id: u32, declaration: bool): bool {
    var literal: LexiconLiteral = { text: text, length: length, id: id, word: lexicon_word(text, length), declaration: declaration };
    return lr_append(LexiconLiteral, &value.literals, &literal);
}

export fn lexicon_start(value: SyntaxLexicon*, text: u8*, length: usize): bool {
    var literal: LexiconLiteral = default;
    literal.text = text;
    literal.length = length;
    return lr_append(LexiconLiteral, &value.starts, &literal);
}

fn lexicon_choice_init(choice: LexiconChoice*): void {
    *choice = default;
    choice.id = 4294967294;
    choice.style = "";
}

fn lexicon_accepts(runtime: LRRuntime*, state: usize, id: u32, choice: LexiconChoice*): bool {
    if runtime == null {
        return false;
    }
    if state >= runtime.states.length {
        return false;
    }
    choice.checks++;
    var action: LRAction;
    return lr_runtime_action(runtime, state, id, &action);
}

// Longest match, then declaration order. Contextual ties prefer an accepted
// token; equal-length literals win. The exact same path serves diagnostic peeks.
export fn lexicon_choose(value: SyntaxLexicon*, source: u8*, length: usize, start: usize, declaration: bool, runtime: LRRuntime*, state: usize, choice: LexiconChoice*): void {
    lexicon_choice_init(choice);
    var index: usize = 0;
    for(; index != value.tokens.length; index++) {
        var entry = &value.tokens.data[index];
        var eligible = true;
        if entry.contextual {
            eligible = lexicon_accepts(runtime, state, entry.id, choice);
        }
        if eligible {
            var count = lex_table_match(entry.table, source, length, start);
            var selected = count > choice.length;
            if !selected {
                var tie = count != 0;
                tie &&= count == choice.length;
                if tie {
                    if entry.contextual {
                        selected = lexicon_accepts(runtime, state, choice.id, choice);
                        selected = !selected;
                    }
                }
            }
            if selected {
                choice.length = count;
                choice.id = entry.id;
                choice.style = entry.style;
                choice.skipped = entry.skipped;
            }
        }
    }
    index = 0;
    var punctuation = false;
    for(; index != value.literals.length; index++) {
        var literal = &value.literals.data[index];
        // LR acceptance cannot make a nonmatching or shorter literal win.
        // Test source bytes first; querying the frozen table is pure, and
        // matching literals retain their original order and contextual policy.
        if literal.length < choice.length || !lexicon_prefix(source, length, start, literal.text, literal.length) { continue; }
        var eligible = !declaration;
        if literal.declaration {
            eligible = true;
        }
        eligible ||= lexicon_accepts(runtime, state, literal.id, choice);
        if eligible {
            choice.length = literal.length;
            choice.id = literal.id;
            choice.style = "operator";
            if literal.word {
                choice.style = "keyword";
            }
            choice.skipped = false;
            punctuation = !literal.word;
        }
    }
    // Attributes can reuse ordinary expressions, making their punctuation
    // reachable from declarations too. An unavailable compound punctuation
    // must not swallow an accepted shorter literal (e.g. dots in an import).
    // Keep longest-match behavior for ordinary code, words and explicit tokens;
    // retain the original token for diagnostics if no accepted prefix exists.
    if declaration && punctuation && runtime is not null
        && !lexicon_accepts(runtime, state, choice.id, choice) {
        var selected: LexiconLiteral* = null;
        foreach (var &literal in &value.literals) {
            if literal.word || literal.length >= choice.length { continue; }
            if selected is not null && literal.length <= selected.length { continue; }
            if lexicon_prefix(source, length, start, literal.text, literal.length)
                && lexicon_accepts(runtime, state, literal.id, choice) { selected = literal; }
        }
        if selected is not null { choice.length = selected.length; choice.id = selected.id; }
    }
}

export fn lexicon_skip(value: SyntaxLexicon*, source: u8*, length: usize, start: usize, choice: LexiconChoice*): void {
    lexicon_choice_init(choice);
    var index: usize = 0;
    loop {
        if index == value.tokens.length {
            return;
        }
        var entry = &value.tokens.data[index];
        if entry.skipped {
            var count = lex_table_match(entry.table, source, length, start);
            if count > choice.length {
                choice.length = count;
                choice.id = entry.id;
                choice.style = entry.style;
                choice.skipped = true;
            }
        }
        index++;
    }
}

export fn lexicon_identifier(value: SyntaxLexicon*, source: u8*, length: usize, start: usize): usize {
    var index: usize = 0;
    loop {
        if index == value.tokens.length {
            return 0;
        }
        var entry = &value.tokens.data[index];
        if entry.identifier {
            return lex_table_match(entry.table, source, length, start);
        }
        index++;
    }
}

export fn lexicon_declaration(value: SyntaxLexicon*, source: u8*, length: usize, start: usize): bool {
    var index: usize = 0;
    loop {
        var done = index == value.starts.length;
        if done {
            return false;
        }
        var keyword = &value.starts.data[index];
        if lexicon_prefix(source, length, start, keyword.text, keyword.length) {
            var position: usize = 0;
            loop {
                done = position == value.tokens.length;
                if done {
                    return true;
                }
                var entry = &value.tokens.data[position];
                var eligible = !entry.skipped;
                if entry.contextual {
                    eligible = false;
                }
                if eligible {
                    var count = lex_table_match(entry.table, source, length, start);
                    if count > keyword.length {
                        break;
                    }
                }
                position++;
            }
        }
        index++;
    }
}
