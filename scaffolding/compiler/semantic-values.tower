import tower;

// Semantic compiler over shared Foundation components.
// Temporary indexes and scratch allocations are scoped to one compilation.

fn sem_location(c: SemanticContext*, n: void*, depth: u32): void* {
    loop {
        var step1 = sem_is(n, "CoreCallArgument");
        var step2 = step1;
        var step3 = step2 == false;
        if step3 {
            var step4 = sem_is(n, "CoreOperand");
            step2 = step4;
        }
        var step5 = step2;
        if step5 {
            var step6 = sem_child_count(n);
            var step7 = step6 == 1;
            step5 = step7;
        }
        var step8 = step5 == false;
        if step8 {
            break;
        }
        var step9 = sem_child(n, 0);
        n = step9;
    }
    var step10 = sem_is(n, "CorePointerArgument");
    if step10 {
        sem_node(c, n, 5);
        sem_fail(c, n, "Expected a value argument, got a type spelling");
        return n;
    }
    var step11 = depth > 128;
    if step11 {
        sem_node(c, n, 5);
        sem_fail(c, n, "Foundation field path limit is 128");
        return n;
    }
    var step12 = sem_get(n);
    var step13 = step12 != null;
    if step13 {
        return n;
    }
    if sem_enum_operand(c, n) {
        sem_fail(c, n, "An enum member is a value, not an addressable location");
        return n;
    }
    var step14 = sem_is(n, "CoreLocation");
    var step15 = step14 == false;
    var step16 = step15;
    var step17 = step16 == false;
    if step17 {
        var step18 = sem_member(n, "base");
        var step19 = step18 == null;
        step16 = step19;
    }
    if step16 {
        var name: void* = n;
        var step20 = sem_is(n, "CoreLocation");
        if step20 {
            var step21 = sem_member(n, "name");
            name = step21;
        }
        var step22 = name == null;
        if step22 {
            sem_fail(c, n, "Malformed CoreLocation tree: missing capture 'name'");
            return n;
        }
        var step23 = sem_node(c, n, 5);
        var value: FoundationNode* = step23;
        var step24 = sem_lookup(c, name);
        value.binding = step24;
        var step25 = value.binding != null;
        if step25 {
            var step26 = sem_get(value.binding);
            sem_set_type(&value.type, &step26.type);
        }
        return n;
    }
    var step27 = sem_member(n, "index");
    var index: void* = step27;
    var step28 = index != null;
    if step28 {
        var step29 = sem_node(c, n, 22);
        var value: FoundationNode* = step29;
        var step30 = sem_member(n, "base");
        var step31 = depth + 1;
        var step32 = sem_location(c, step30, step31);
        value.left = step32;
        var step33 = sem_ok(c);
        var step34 = step33 == false;
        if step34 {
            return n;
        }
        var step35 = sem_get(value.left);
        var step36 = sem_type_copy(c, &step35.type);
        var parent: FoundationType* = step36;
        var step37 = parent.pointers != 0;
        value.indirect = step37;
        var step38 = parent.pointers != 0;
        if step38 {
            parent.pointers = parent.pointers - 1;
            sem_set_type(&value.type, parent);
        } else {
            var step39 = parent.scalar == SArray();
            if step39 {
                var step40 = sem_get(parent.record);
                sem_set_type(&value.type, &step40.element);
            } else {
                sem_fail(c, n, "Indexing requires a pointer or an array");
                return n;
            }
        }
        var step41 = semantic_aggregate(&value.type);
        if step41 {
            sem_layout(c, value.type.record);
        }
        var step42 = semantic_size(&value.type);
        var step43 = step42 == 0;
        if step43 {
            sem_fail(c, n, "Cannot index a void pointer");
            return n;
        }
        var expected_type: FoundationType* = null;
        if sem_editor_contains(c, index) {
            c.editor.require_integer = true;
        }
        var step44 = sem_literal(c, index);
        if step44 {
            var step45 = sem_type_new(c, SUSize(), 0, null);
            expected_type = step45;
        }
        var step46 = sem_operand(c, index, expected_type);
        value.right = step46;
        var step47 = sem_ok(c);
        var step48 = step47 == false;
        if step48 {
            return n;
        }
        var step49 = sem_get(value.right);
        var step50 = semantic_integer(&step49.type);
        if semantic_enum(&step49.type) {
            step50 = false;
        }
        var step51 = step50 == false;
        if step51 {
            sem_fail(c, index, "An index must be an integer");
        }
        return n;
    }
    var step52 = sem_shape(c, n, "base");
    var step53 = step52 == false;
    var step54 = step53;
    var step55 = step54 == false;
    if step55 {
        var step56 = sem_shape(c, n, "field");
        var step57 = step56 == false;
        step54 = step57;
    }
    if step54 {
        return n;
    }
    var step58 = sem_node(c, n, 21);
    var value: FoundationNode* = step58;
    var step59 = sem_member(n, "base");
    var step60 = depth + 1;
    var step61 = sem_location(c, step59, step60);
    value.left = step61;
    var step62 = sem_ok(c);
    var step63 = step62 == false;
    if step63 {
        return n;
    }
    var step64 = sem_get(value.left);
    var parent: FoundationType* = &step64.type;
    var step65 = sem_member(n, "field");
    if sem_editor_capture(c, step65, 3, parent) {
        return n;
    }
    var step66 = sem_identifier(c, step65);
    sem_set_name(value, step66);
    var step67 = parent.pointers == 1;
    value.indirect = step67;
    var step68 = parent.scalar != SStruct();
    var step69 = step68;
    var step70 = step69 == false;
    if step70 {
        var step71 = parent.pointers > 1;
        step69 = step71;
    }
    if step69 {
        sem_fail(c, n, "Field access requires a struct or a single pointer to a struct");
        return n;
    }
    sem_layout(c, parent.record);
    var step72 = sem_ok(c);
    var step73 = step72 == false;
    if step73 {
        return n;
    }
    var step74 = sem_get(parent.record);
    var fields: vector(void*)* = &step74.items;
    var i: usize = 0;
    loop {
        var step75 = i < fields.length;
        var step76 = step75 == false;
        if step76 {
            break;
        }
        var field: void* = fields.data[i];
        var step77 = sem_get(field);
        var step78 = sem_name(step77);
        var step79 = sem_name(value);
        var step80 = sem_equal(step78, step79);
        if step80 {
            value.binding = field;
        }
        i = i + 1;
    }
    var step81 = value.binding == null;
    if step81 {
        var step82 = sem_name(value);
        var step83 = sem_cat(c, "Unknown field '", step82);
        var step84 = sem_cat(c, step83, "' in '");
        var step85 = sem_get(parent.record);
        var step86 = sem_name(step85);
        var step87 = sem_cat(c, step86, "'");
        var step88 = sem_cat(c, step84, step87);
        sem_fail(c, n, step88);
        return n;
    }
    var step89 = sem_get(value.binding);
    sem_set_type(&value.type, &step89.type);
    var step90 = sem_get(value.binding);
    value.byte_offset = step90.byte_offset;
    return n;
}

fn sem_operand(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    if sem_editor_contains(c, n) {
        c.editor.value_required = true;
        c.editor.has_expected = expected_type != null;
        if c.editor.has_expected {
            sem_set_type(&c.editor.type, expected_type);
        }
    }
    var step1 = n == null;
    if step1 {
        sem_fail(c, n, "Missing operand");
        return null;
    }
    c.value_depth = c.value_depth + 1;
    var step2 = sem_operand_impl(c, n, expected_type);
    var result: void* = step2;
    c.value_depth = c.value_depth - 1;
    return result;
}

fn sem_operand_impl(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    var step1 = c.value_depth > 128;
    if step1 {
        sem_fail(c, n, "Foundation expression nesting limit is 128");
        return n;
    }
    loop {
        var step2 = sem_is(n, "CoreCallArgument");
        var step3 = step2;
        var step4 = step3 == false;
        if step4 {
            var step5 = sem_is(n, "CoreOperand");
            step3 = step5;
        }
        var step6 = step3;
        if step6 {
            var step7 = sem_child_count(n);
            var step8 = step7 == 1;
            step6 = step8;
        }
        var step9 = step6 == false;
        if step9 {
            break;
        }
        var step10 = sem_child(n, 0);
        n = step10;
    }
    var step11 = sem_is(n, "CoreCall");
    if sem_editor_contains(c, n) {
        if c.editor.has_expected {
            if sem_is(n, "CoreAddress") {
                var pointer = c.editor.type.pointers != 0;
                if pointer {
                    c.editor.type.pointers = c.editor.type.pointers - 1;
                }
            }
            if sem_is(n, "CoreLoad") {
                c.editor.type.pointers = c.editor.type.pointers + 1;
            }
        }
    }
    if step11 {
        var step12 = sem_get(n);
        var step13 = step12 == null;
        var step14 = step13;
        if step14 {
            var step15 = sem_call(c, n);
            var step16 = step15 == null;
            step14 = step16;
        }
        var step17 = step14;
        var step18 = step17 == false;
        if step18 {
            var step19 = sem_ok(c);
            var step20 = step19 == false;
            step17 = step20;
        }
        if step17 {
            return n;
        }
        var step21 = sem_get(n);
        var v: FoundationNode* = step21;
        var step22 = v.type.pointers == 0;
        var step23 = step22;
        if step23 {
            var step24 = v.type.scalar == SVoid();
            step23 = step24;
        }
        if step23 {
            sem_fail(c, n, "A void call cannot be used as a value");
            return n;
        }
    } else {
        var step25 = sem_is(n, "CoreAddress");
        var step26 = step25;
        var step27 = step26 == false;
        if step27 {
            var step28 = sem_is(n, "CoreLoad");
            step26 = step28;
        }
        if step26 {
            var step29 = sem_shape(c, n, "name");
            var step30 = step29 == false;
            if step30 {
                return n;
            }
            var step31 = sem_is(n, "CoreAddress");
            var address: bool = step31;
            var kind: u32 = 8;
            if address {
                kind = KAddress();
            }
            var step32 = sem_node(c, n, kind);
            var value: FoundationNode* = step32;
            if address {
                var step33 = sem_member(n, "name");
                var step34 = sem_location(c, step33, 0);
                value.value = step34;
            } else {
                var step35 = sem_member(n, "name");
                var load_expected: FoundationType* = null;
                if sem_editor_contains(c, step35) {
                    c.editor.require_pointer = true;
                    if c.editor.has_expected {
                        load_expected = &c.editor.type;
                    }
                }
                var step36 = sem_operand(c, step35, load_expected);
                value.value = step36;
            }
            var step37 = sem_ok(c);
            var step38 = step37 == false;
            if step38 {
                return n;
            }
            var step39 = sem_get(value.value);
            sem_set_type(&value.type, &step39.type);
            if address {
                value.type.pointers = value.type.pointers + 1;
            } else {
                var step40 = value.type.pointers == 0;
                if step40 {
                    sem_fail(c, n, "Load requires a pointer");
                    return n;
                } else {
                    value.type.pointers = value.type.pointers - 1;
                }
            }
        } else {
            var step41 = sem_literal(c, n);
            var step42 = step41 == false;
            if step42 {
                if sem_enum_operand(c, n) {} else {
                    var step43 = sem_location(c, n, 0);
                    n = step43;
                }
            }
        }
    }
    var step44 = sem_ok(c);
    var step45 = step44 == false;
    if step45 {
        return n;
    }
    var step46 = sem_get(n);
    var value: FoundationNode* = step46;
    var step47 = value == null;
    if step47 {
        var step48 = sem_node(c, n, 5);
        value = step48;
    }
    var step49 = sem_tokens(c, n);
    var text: u8* = step49;
    var step50 = sem_literal(c, n);
    if step50 {
        var nominal = expected_type != null;
        if nominal {
            nominal = expected_type.pointers == 0;
        }
        if nominal {
            nominal = semantic_enum(expected_type);
        }
        if nominal {
            sem_fail(c, n, "Enum values require a named member or an explicit conversion");
            return n;
        }
        value.constant = true;
        var step51 = sem_equal(text, "true");
        var step52 = step51;
        var step53 = step52 == false;
        if step53 {
            var step54 = sem_equal(text, "false");
            step52 = step54;
        }
        if step52 {
            var step55 = sem_type_new(c, SBool(), 0, null);
            sem_set_type(&value.type, step55);
            value.type.pointer_bytes = 4;
            var step56 = sem_equal(text, "true");
            var step57 = convert(u64, step56);
            value.bits = step57;
        } else {
            var step58 = sem_equal(text, "null");
            if step58 {
                var step59 = expected_type != null;
                if step59 {
                    sem_set_type(&value.type, expected_type);
                } else {
                    var step60 = sem_type_new(c, SVoid(), 1, null);
                    sem_set_type(&value.type, step60);
                }
                value.bits = 0;
                var step61 = value.type.pointers == 0;
                if step61 {
                    sem_fail(c, n, "null requires a pointer type");
                }
            } else {
                var step62 = text[0] == 39;
                var step63 = step62;
                var step64 = step63 == false;
                if step64 {
                    var step65 = text[0] == 34;
                    step63 = step65;
                }
                if step63 {
                    value.kind = KString();
                    var step66 = sem_type_new(c, SU8(), 1, null);
                    sem_set_type(&value.type, step66);
                    var i: usize = 1;
                    var step67 = sem_length(text);
                    var length: usize = step67;
                    loop {
                        var step68 = i + 1;
                        var step69 = step68 < length;
                        var step70 = step69 == false;
                        if step70 {
                            break;
                        }
                        var byte: u8 = text[i];
                        var step71 = byte == 92;
                        var step72 = step71;
                        if step72 {
                            var step73 = i + 2;
                            var step74 = step73 < length;
                            step72 = step74;
                        }
                        if step72 {
                            i = i + 1;
                            byte = text[i];
                            var step75 = byte == 110;
                            if step75 {
                                byte = 10;
                            } else {
                                var step76 = byte == 114;
                                if step76 {
                                    byte = 13;
                                } else {
                                    var step77 = byte == 116;
                                    if step77 {
                                        byte = 9;
                                    }
                                }
                            }
                        }
                        var step78 = foundation_name_append(&value.name, byte);
                        sem_require(step78);
                        i = i + 1;
                    }
                } else {
                    var step79 = expected_type != null;
                    if step79 {
                        sem_set_type(&value.type, expected_type);
                    } else {
                        var step80 = sem_type_new(c, SI32(), 0, null);
                        sem_set_type(&value.type, step80);
                        value.type.pointer_bytes = 4;
                    }
                    var step81 = semantic_integer(&value.type);
                    var step82 = step81 == false;
                    if step82 {
                        sem_fail(c, n, "An integer literal needs an integer type");
                        return n;
                    }
                    var step83 = text[0] == 45;
                    var negative: bool = step83;
                    var number: u64 = 0;
                    var i: usize = 0;
                    if negative {
                        i = 1;
                    }
                    var step84 = sem_length(text);
                    var length: usize = step84;
                    var maximum: u64 = 0;
                    maximum = maximum - 1;
                    loop {
                        var step85 = i < length;
                        var step86 = step85 == false;
                        if step86 {
                            break;
                        }
                        var step87 = convert(u64, text[i]);
                        var digit: u64 = step87;
                        digit = digit - 48;
                        var step88 = digit > 9;
                        var step89 = step88;
                        var step90 = step89 == false;
                        if step90 {
                            var step91 = maximum - digit;
                            var step92 = step91 / 10;
                            var step93 = number > step92;
                            step89 = step93;
                        }
                        if step89 {
                            sem_fail(c, n, "Integer literal out of range");
                            break;
                        }
                        var step94 = number * 10;
                        var step95 = step94 + digit;
                        number = step95;
                        i = i + 1;
                    }
                    var step96 = semantic_mask(&value.type);
                    var mask: u64 = step96;
                    var limit: u64 = mask;
                    var step97 = semantic_signed(&value.type);
                    var signed: bool = step97;
                    if signed {
                        var step98 = mask / 2;
                        limit = step98;
                        if negative {
                            limit = limit + 1;
                        }
                    }
                    var step99 = number > limit;
                    var step100 = step99;
                    var step101 = step100 == false;
                    if step101 {
                        var step102 = negative;
                        if step102 {
                            var step103 = signed == false;
                            step102 = step103;
                        }
                        step100 = step102;
                    }
                    if step100 {
                        var step104 = sem_type_name(c, &value.type);
                        var step105 = sem_cat(c, "Integer literal out of range for ", step104);
                        sem_fail(c, n, step105);
                    }
                    if negative {
                        var negated: u64 = 0;
                        var step106 = negated - number;
                        number = step106;
                    }
                    var step107 = number & mask;
                    value.bits = step107;
                }
            }
        }
    }
    var step108 = semantic_aggregate(&value.type);
    if step108 {
        sem_fail(c, n, "Struct values require field access or a pointer; aggregate copies are not implemented");
    }
    var step109 = expected_type != null;
    var step110 = step109;
    if step110 {
        var step111 = semantic_type_equal(&value.type, expected_type);
        var step112 = step111 == false;
        step110 = step112;
    }
    if step110 {
        var step113 = sem_type_name(c, expected_type);
        var step114 = sem_cat(c, "Expected ", step113);
        var step115 = sem_cat(c, step114, ", got ");
        var step116 = sem_type_name(c, &value.type);
        var step117 = sem_cat(c, step116, "; use an explicit conversion");
        var step118 = sem_cat(c, step115, step117);
        sem_fail(c, n, step118);
    }
    return n;
}

fn sem_builtin(c: SemanticContext*, n: void*, kind: u32, args: vector(void*)*): void* {
    var label = kind == 31;
    var jump = kind == 32;
    if label {
        sem_fail(c, n, "label is only valid as a function-body statement");
        return n;
    }
    if jump {
        sem_fail(c, n, "jump is only valid as a function-body statement");
        return n;
    }
    var step1 = sem_node(c, n, kind);
    var value: FoundationNode* = step1;
    var step2 = sem_type_new(c, SVoid(), 0, null);
    sem_set_type(&value.type, step2);
    value.type.pointer_bytes = 4;
    // Observe the argument at the editor hole even when later arguments have
    // not been written. Resolution still uses the ordinary type/value helpers.
    if sem_editor_contains(c, n) {
        var index: usize = 0;
        loop {
            var done = index == args.length;
            if done {
                break;
            }
            var argument = args.data[index];
            if sem_editor_contains(c, argument) {
                var type_argument = kind == KSizeOf();
                var editor_guard_1 = kind == KAlignOf();
                if editor_guard_1 {
                    type_argument = true;
                }
                var editor_guard_2 = kind == KAllocate();
                if editor_guard_2 {
                    type_argument = true;
                }
                var editor_guard_3 = kind == KReallocate();
                if editor_guard_3 {
                    type_argument = true;
                }
                var editor_guard_4 = kind == KConvert();
                if editor_guard_4 {
                    type_argument = true;
                }
                var editor_guard_5 = kind == KBits();
                if editor_guard_5 {
                    type_argument = true;
                }
                var editor_guard_6 = index != 0;
                if editor_guard_6 {
                    type_argument = false;
                }
                if type_argument {
                    sem_type(c, argument);
                } else {
                    var expected_type: FoundationType* = null;
                    var last = semantic_builtin_arity(kind);
                    last = last - 1;
                    var size_argument = kind == KAllocate();
                    var editor_guard_7 = kind == KReallocate();
                    if editor_guard_7 {
                        size_argument = true;
                    }
                    var editor_guard_8 = kind == KCopy();
                    if editor_guard_8 {
                        size_argument = true;
                    }
                    var editor_guard_9 = kind == KFill();
                    if editor_guard_9 {
                        size_argument = true;
                    }
                    var editor_guard_10 = index != last;
                    if editor_guard_10 {
                        size_argument = false;
                    }
                    if size_argument {
                        expected_type = sem_type_new(c, SUSize(), 0, null);
                    }
                    var editor_guard_11 = kind == KFree();
                    if editor_guard_11 {
                        c.editor.require_pointer = true;
                    }
                    var editor_guard_12 = kind == KCopy();
                    if editor_guard_12 {
                        var editor_guard_13 = index < 2;
                        if editor_guard_13 {
                            c.editor.require_pointer = true;
                        }
                    }
                    var editor_guard_14 = kind == KFill();
                    if editor_guard_14 {
                        var editor_guard_15 = index == 0;
                        if editor_guard_15 {
                            c.editor.require_pointer = true;
                        }
                        var editor_guard_16 = index == 1;
                        if editor_guard_16 {
                            expected_type = sem_type_new(c, SU8(), 0, null);
                        }
                    }
                    var editor_guard_17 = kind == KReallocate();
                    if editor_guard_17 {
                        var editor_guard_18 = index == 1;
                        if editor_guard_18 {
                            expected_type = sem_type(c, args.data[0]);
                            expected_type.pointers = expected_type.pointers + 1;
                        }
                    }
                    var trapping_argument = kind == KTrap();
                    if trapping_argument {
                        var message = index == 0;
                        if message {
                            expected_type = sem_type_new(c, SU8(), 1, null);
                        } else {
                            expected_type = sem_type_new(c, SU32(), 0, null);
                        }
                    }
                    sem_operand(c, argument, expected_type);
                }
                return n;
            }
            index = index + 1;
        }
    }
    var step3 = semantic_builtin_arity(kind);
    var count: usize = step3;
    var step4 = args.length != count;
    if step4 {
        var step5 = semantic_builtin_name(kind);
        var step6 = sem_cat(c, "Wrong argument count for '", step5);
        var step7 = sem_cat(c, step6, "': expected ");
        var step8 = convert(u64, count);
        var step9 = sem_decimal(c, step8);
        var step10 = sem_cat(c, step7, step9);
        sem_fail(c, n, step10);
        return n;
    }
    var step11 = sem_type_new(c, SUSize(), 0, null);
    var trapping = kind == KTrap();
    if trapping {
        value.left = sem_operand(c, args.data[0], sem_type_new(c, SU8(), 1, null));
        value.right = sem_operand(c, args.data[1], sem_type_new(c, SU32(), 0, null));
        return n;
    }
    var size: FoundationType* = step11;
    var step12 = sem_type_new(c, SU8(), 0, null);
    var byte: FoundationType* = step12;
    byte.pointer_bytes = 4;
    var step13 = kind == KPrint();
    if step13 {
        var step14 = sem_operand(c, args.data[0], null);
        value.value = step14;
    } else {
        var step15 = kind == KFree();
        var step16 = step15;
        var step17 = step16 == false;
        if step17 {
            var step18 = kind == KCopy();
            step16 = step18;
        }
        var step19 = step16 == false;
        if step19 {
            var step20 = kind == KFill();
            step16 = step20;
        }
        if step16 {
            var step21 = sem_operand(c, args.data[0], null);
            value.left = step21;
            var step22 = sem_ok(c);
            var step23 = step22 == false;
            if step23 {
                return n;
            }
            var step24 = sem_get(value.left);
            var step25 = step24.type.pointers == 0;
            if step25 {
                sem_fail(c, n, "Memory operations require a pointer");
            }
            var step26 = kind != KFree();
            if step26 {
                var step27 = sem_operand(c, args.data[2], size);
                value.value = step27;
                var expected_type: FoundationType* = null;
                var step28 = kind == KFill();
                if step28 {
                    expected_type = byte;
                }
                var step29 = sem_operand(c, args.data[1], expected_type);
                value.right = step29;
                var step30 = sem_ok(c);
                var step31 = step30 == false;
                if step31 {
                    return n;
                }
                var step32 = kind == KCopy();
                var step33 = step32;
                if step33 {
                    var step34 = sem_get(value.right);
                    var step35 = step34.type.pointers == 0;
                    step33 = step35;
                }
                if step33 {
                    sem_fail(c, n, "copy requires source and destination pointers");
                }
            }
        } else {
            var step36 = kind == KSizeOf();
            var step37 = step36;
            var step38 = step37 == false;
            if step38 {
                var step39 = kind == KAlignOf();
                step37 = step39;
            }
            if step37 {
                var step40 = sem_type(c, args.data[0]);
                sem_set_type(&value.element, step40);
                var step41 = semantic_aggregate(&value.element);
                if step41 {
                    sem_layout(c, value.element.record);
                }
                sem_set_type(&value.type, size);
            } else {
                var step42 = kind == KAllocate();
                var step43 = step42;
                var step44 = step43 == false;
                if step44 {
                    var step45 = kind == KReallocate();
                    step43 = step45;
                }
                if step43 {
                    var step46 = sem_type(c, args.data[0]);
                    sem_set_type(&value.element, step46);
                    var step47 = semantic_aggregate(&value.element);
                    if step47 {
                        sem_layout(c, value.element.record);
                    }
                    var step48 = semantic_size(&value.element);
                    var step49 = step48 == 0;
                    if step49 {
                        sem_fail(c, n, "Cannot allocate void elements");
                        return n;
                    }
                    sem_set_type(&value.type, &value.element);
                    value.type.pointers = value.type.pointers + 1;
                    var step50 = args.length - 1;
                    var step51 = sem_operand(c, args.data[step50], size);
                    value.right = step51;
                    var step52 = kind == KReallocate();
                    if step52 {
                        var step53 = sem_operand(c, args.data[1], &value.type);
                        value.left = step53;
                    }
                } else {
                    var step54 = kind == KConvert();
                    var step55 = step54;
                    var step56 = step55 == false;
                    if step56 {
                        var step57 = kind == KBits();
                        step55 = step57;
                    }
                    if step55 {
                        var step58 = sem_type(c, args.data[0]);
                        sem_set_type(&value.type, step58);
                        var step59 = sem_operand(c, args.data[1], null);
                        value.value = step59;
                        var step60 = sem_ok(c);
                        var step61 = step60 == false;
                        if step61 {
                            return n;
                        }
                        var step62 = sem_get(value.value);
                        var source: FoundationType* = &step62.type;
                        var step63 = semantic_aggregate(&value.type);
                        var step64 = step63;
                        var step65 = step64 == false;
                        if step65 {
                            var step66 = value.type.pointers == 0;
                            var step67 = step66;
                            if step67 {
                                var step68 = value.type.scalar == SVoid();
                                step67 = step68;
                            }
                            step64 = step67;
                        }
                        if step64 {
                            sem_fail(c, n, "Conversion requires scalar values");
                        }
                        var step69 = kind == KConvert();
                        var step70 = step69;
                        if step70 {
                            var step71 = value.type.pointers != 0;
                            var step72 = step71;
                            var step73 = step72 == false;
                            if step73 {
                                var step74 = source.pointers != 0;
                                step72 = step74;
                            }
                            step70 = step72;
                        }
                        if step70 {
                            sem_fail(c, n, "Pointer reinterpretation requires bits");
                        }
                        var step75 = kind == KBits();
                        var step76 = step75;
                        if step76 {
                            var step77 = semantic_width(&value.type);
                            var step78 = semantic_width(source);
                            var step79 = step77 != step78;
                            var step80 = step79;
                            var step81 = step80 == false;
                            if step81 {
                                var step82 = semantic_integer(&value.type);
                                var step83 = step82 == false;
                                var step84 = step83;
                                if step84 {
                                    var step85 = value.type.pointers == 0;
                                    step84 = step85;
                                }
                                step80 = step84;
                            }
                            var step86 = step80 == false;
                            if step86 {
                                var step87 = semantic_integer(source);
                                var step88 = step87 == false;
                                var step89 = step88;
                                if step89 {
                                    var step90 = source.pointers == 0;
                                    step89 = step90;
                                }
                                step80 = step89;
                            }
                            step76 = step80;
                        }
                        if step76 {
                            sem_fail(c, n, "bits requires equal-width integers or pointers");
                        }
                    } else {
                        sem_fail(c, n, "Unsupported foundation builtin");
                    }
                }
            }
        }
    }
    return n;
}

fn sem_call(c: SemanticContext*, n: void*): void* {
    if sem_editor_capture(c, sem_member(n, "name"), 4, null) {
        sem_node(c, n, KCall());
        return n;
    }
    var step1 = sem_shape(c, n, "name");
    var step2 = step1 == false;
    if step2 {
        return null;
    }
    var step3 = sem_member(n, "name");
    var step4 = sem_identifier(c, step3);
    var name: u8* = step4;
    var step5 = sem_member(n, "args");
    var step6 = sem_collect(c, step5, "CoreCallArgument");
    var args: vector(void*)* = step6;
    var step7 = semantic_builtin_kind(name);
    var builtin: u32 = step7;
    var step8 = builtin != 0;
    if step8 {
        var step9 = sem_builtin(c, n, builtin, args);
        return step9;
    }
    var step10 = sem_lookup_table(c.type_functions, name);
    var step11 = step10 != null;
    if step11 {
        var step12 = sem_cat(c, "Type constructor '", name);
        var step13 = sem_cat(c, step12, "' produces a type, not a runtime value");
        sem_fail(c, n, step13);
        return n;
    }
    var step14 = sem_lookup_table(c.templates, name);
    var definition: void* = step14;
    var step15 = definition != null;
    if step15 {
        var step16 = generic_parameter_count(c.generics, definition);
        var step17 = args.length != step16;
        if step17 {
            var step18 = sem_cat(c, "Wrong argument count for template '", name);
            var step19 = sem_cat(c, step18, "'");
            sem_fail(c, n, step19);
            return n;
        }
        var step20 = sem_list(c);
        var arguments: vector(void*)* = step20;
        var step21 = sem_list(c);
        var values: vector(void*)* = step21;
        var i: usize = 0;
        loop {
            var step22 = i < args.length;
            var step23 = step22 == false;
            if step23 {
                break;
            }
            var step24 = generic_type_parameter(c.generics, definition, i);
            if step24 {
                var step25 = sem_type(c, args.data[i]);
                var step26 = sem_type_entity(c, step25);
                sem_push(arguments, step26);
            } else {
                sem_push(values, args.data[i]);
            }
            var step27 = sem_ok(c);
            var step28 = step27 == false;
            if step28 {
                return n;
            }
            i = i + 1;
        }
        var step29 = generic_instantiate(c.generics, definition, n, arguments.data, arguments.length);
        var instance: void* = step29;
        var step30 = sem_generic_ok(c, n);
        var step31 = step30 == false;
        var step32 = step31;
        var step33 = step32 == false;
        if step33 {
            var step34 = instance == null;
            step32 = step34;
        }
        if step32 {
            return n;
        }
        var step35 = sem_state(c, c.source_bases, instance);
        var step36 = sem_source_base(c, definition);
        step35.number = step36;
        var step37 = sem_get(instance);
        var step38 = step37 == null;
        if step38 {
            var step39 = sem_instance_name(c, definition, arguments);
            sem_header(c, instance, step39, definition);
            var step40 = sem_ok(c);
            var step41 = step40 == false;
            if step41 {
                return n;
            }
            sem_push(&c.generated, instance);
        }
        var step42 = sem_node(c, n, KCall());
        var value: FoundationNode* = step42;
        var step43 = sem_get(instance);
        var callee: FoundationNode* = step43;
        value.binding = instance;
        sem_set_type(&value.type, &callee.type);
        i = 0;
        loop {
            var step44 = i < values.length;
            var step45 = step44 == false;
            if step45 {
                break;
            }
            var step46 = sem_get(callee.parameters.data[i]);
            var step47 = sem_operand(c, values.data[i], &step46.type);
            sem_push(&value.items, step47);
            i = i + 1;
        }
        return n;
    }
    var step48 = sem_node(c, n, KCall());
    var value: FoundationNode* = step48;
    var step49 = sem_lookup_table(c.functions, name);
    value.binding = step49;
    var step50 = value.binding == null;
    if step50 {
        var step51 = sem_cat(c, "Unknown function '", name);
        var step52 = sem_cat(c, step51, "'");
        sem_fail(c, n, step52);
        return n;
    }
    var step53 = sem_get(value.binding);
    var callee: FoundationNode* = step53;
    sem_set_type(&value.type, &callee.type);
    var step54 = args.length != callee.parameters.length;
    // A completion snapshot may end before later arguments have been written.
    // Resolve every present argument using the real signature nonetheless.
    if sem_editor_contains(c, n) {
        step54 = args.length > callee.parameters.length;
    }
    if step54 {
        var step55 = sem_cat(c, "Wrong argument count for '", name);
        var step56 = sem_cat(c, step55, "'");
        sem_fail(c, n, step56);
        return n;
    }
    var i: usize = 0;
    loop {
        var step57 = i < args.length;
        var step58 = step57 == false;
        if step58 {
            break;
        }
        var step59 = sem_get(callee.parameters.data[i]);
        var step60 = sem_operand(c, args.data[i], &step59.type);
        sem_push(&value.items, step60);
        i = i + 1;
    }
    return n;
}

fn sem_expression(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    var step1 = sem_is(n, "CoreValue");
    var step2 = step1;
    if step2 {
        var step3 = sem_child_count(n);
        var step4 = step3 == 1;
        step2 = step4;
    }
    if step2 {
        var step5 = sem_child(n, 0);
        n = step5;
    }
    var step6 = sem_label(n);
    var kind: u8* = step6;
    var step7 = sem_equal(kind, "CoreOperand");
    var step8 = step7;
    var step9 = step8 == false;
    if step9 {
        var step10 = sem_equal(kind, "CoreAddress");
        step8 = step10;
    }
    var step11 = step8 == false;
    if step11 {
        var step12 = sem_equal(kind, "CoreLoad");
        step8 = step12;
    }
    if step8 {
        var step13 = sem_operand(c, n, expected_type);
        return step13;
    }
    var step14 = n == null;
    if step14 {
        sem_fail(c, n, "Missing expression");
        return null;
    }
    var step15 = sem_equal(kind, "CoreCall");
    if step15 {
        var step16 = sem_call(c, n);
        var step17 = step16 == null;
        if step17 {
            return null;
        }
    } else {
        var step18 = sem_equal(kind, "CoreBinary");
        if step18 {
            var step19 = sem_shape(c, n, "left");
            var step20 = step19 == false;
            var step21 = step20;
            var step22 = step21 == false;
            if step22 {
                var step23 = sem_shape(c, n, "op");
                var step24 = step23 == false;
                step21 = step24;
            }
            var step25 = step21 == false;
            if step25 {
                var step26 = sem_shape(c, n, "right");
                var step27 = step26 == false;
                step21 = step27;
            }
            if step21 {
                return null;
            }
            var step28 = sem_node(c, n, 6);
            var value: FoundationNode* = step28;
            var step29 = sem_member(n, "op");
            var step30 = sem_tokens(c, step29);
            var op: u8* = step30;
            var found: bool = false;
            var i: u32 = 0;
            loop {
                var step31 = i <= 13;
                var step32 = step31 == false;
                if step32 {
                    break;
                }
                var step33 = semantic_operator(i);
                var step34 = sem_equal(op, step33);
                if step34 {
                    value.op = i;
                    found = true;
                    break;
                }
                i = i + 1;
            }
            var step35 = found == false;
            if step35 {
                sem_fail(c, n, "Unknown foundation binary operation");
            }
            var step36 = sem_type_new(c, SI32(), 0, null);
            var input: FoundationType* = step36;
            input.pointer_bytes = 4;
            var step37 = expected_type != null;
            if step37 {
                input = expected_type;
            }
            var step38 = value.op >= OEq();
            var comparison: bool = step38;
            var step39 = sem_member(n, "left");
            var left: void* = step39;
            var step40 = sem_member(n, "right");
            var right: void* = step40;
            var step41 = comparison;
            var step42 = step41 == false;
            if step42 {
                var step43 = expected_type == null;
                step41 = step43;
            }
            if step41 {
                var anchor: void* = left;
                var step44 = sem_literal(c, left);
                var step45 = step44;
                if step45 {
                    var step46 = sem_literal(c, right);
                    var step47 = step46 == false;
                    step45 = step47;
                }
                if step45 {
                    anchor = right;
                }
                var step48 = sem_operand(c, anchor, null);
                var known: void* = step48;
                var step49 = sem_ok(c);
                var step50 = step49 == false;
                var step51 = step50;
                var step52 = step51 == false;
                if step52 {
                    var step53 = known == null;
                    step51 = step53;
                }
                if step51 {
                    return n;
                }
                var step54 = sem_get(known);
                input = &step54.type;
            }
            var step55 = sem_operand(c, left, input);
            value.left = step55;
            var nominal = input.pointers == 0;
            if nominal {
                nominal = semantic_enum(input);
            }
            if nominal {
                var equality = value.op == OEq();
                var inequality = value.op == ONe();
                if inequality {
                    equality = true;
                }
                if equality {} else {
                    sem_fail(c, n, "Enum operations require equality or an explicit integer conversion");
                }
            }
            var step56 = sem_ok(c);
            var step57 = step56 == false;
            if step57 {
                return n;
            }
            var step58 = input.pointers != 0;
            var step59 = step58;
            if step59 {
                var step60 = value.op == OAdd();
                var step61 = step60;
                var step62 = step61 == false;
                if step62 {
                    var step63 = value.op == OSub();
                    step61 = step63;
                }
                step59 = step61;
            }
            var pointer_offset: bool = step59;
            var right_type: FoundationType* = input;
            if pointer_offset {
                right_type = null;
                var step64 = sem_literal(c, right);
                if step64 {
                    var step65 = sem_type_new(c, SUSize(), 0, null);
                    right_type = step65;
                }
            }
            var step66 = sem_operand(c, right, right_type);
            value.right = step66;
            var step67 = sem_ok(c);
            var step68 = step67 == false;
            if step68 {
                return n;
            }
            if comparison {
                var step69 = sem_type_new(c, SBool(), 0, null);
                sem_set_type(&value.type, step69);
                value.type.pointer_bytes = 4;
            } else {
                sem_set_type(&value.type, input);
            }
            if pointer_offset {
                var step70 = sem_get(value.right);
                var step71 = semantic_integer(&step70.type);
                if semantic_enum(&step70.type) {
                    step71 = false;
                }
                var step72 = step71 == false;
                if step72 {
                    sem_fail(c, n, "A pointer offset must be an integer");
                }
                var step73 = sem_type_copy(c, input);
                var element: FoundationType* = step73;
                element.pointers = element.pointers - 1;
                var step74 = semantic_aggregate(element);
                if step74 {
                    sem_layout(c, element.record);
                }
                var step75 = semantic_size(element);
                var step76 = step75 == 0;
                if step76 {
                    sem_fail(c, n, "Cannot offset a void pointer");
                }
            } else {
                var step77 = semantic_integer(input);
                var step78 = step77 == false;
                var step79 = step78;
                if step79 {
                    var step80 = value.op != OEq();
                    step79 = step80;
                }
                if step79 {
                    var step81 = value.op != ONe();
                    step79 = step81;
                }
                if step79 {
                    sem_fail(c, n, "This operation requires integer operands");
                }
            }
        } else {
            var step82 = sem_cat(c, "Unsupported foundation expression '", kind);
            var step83 = sem_cat(c, step82, "'");
            sem_fail(c, n, step83);
            return null;
        }
    }
    var step84 = sem_get(n);
    var value: FoundationNode* = step84;
    var step85 = value == null;
    if step85 {
        return n;
    }
    var step86 = semantic_aggregate(&value.type);
    if step86 {
        sem_fail(c, n, "Struct values require field access or a pointer; aggregate copies are not implemented");
    }
    var step87 = expected_type != null;
    var step88 = step87;
    if step88 {
        var step89 = semantic_type_equal(&value.type, expected_type);
        var step90 = step89 == false;
        step88 = step90;
    }
    if step88 {
        var step91 = sem_type_name(c, expected_type);
        var step92 = sem_cat(c, "Expected ", step91);
        var step93 = sem_cat(c, step92, ", got ");
        var step94 = sem_type_name(c, &value.type);
        var step95 = sem_cat(c, step93, step94);
        sem_fail(c, n, step95);
    }
    return n;
}
