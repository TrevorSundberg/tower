import tower;
import format_types;
import format;
import frontend_table;
import grammar_types;
import lr_tree;
import parser_nodes;
import regex_lowering;
import syntax_nodes;
import syntax_types;
import .library.work_budget_types;

// Token patterns use the same character grammar/table reader as Bedrock.
// Errors use the shared text formatter and Unicode character positions.
struct FrontendPatternCompiler {
    kinds: FrontendKinds;
    table: FrontendTable;
}

export fn frontend_pattern_destroy(compiler: FrontendPatternCompiler*): void {
    if compiler == null {
        return;
    }
    frontend_table_dispose(&compiler.table);
    free(compiler);
}

export fn frontend_pattern_create(kinds: FrontendKinds*): FrontendPatternCompiler* {
    var error = WorkBudgetError.None;
    return frontend_pattern_create_result(kinds, &error);
}

export fn frontend_pattern_create_result(kinds: FrontendKinds*, error: WorkBudgetError*): FrontendPatternCompiler* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if kinds == null { return null; }
    var compiler = alloc(FrontendPatternCompiler, 1);
    if compiler == null {
        *error = WorkBudgetError.Memory;
        return null;
    }
    *compiler = {kinds: *kinds, ..default};
    if frontend_pattern_table_result(&compiler.table, &compiler.kinds, error) {
        return compiler;
    }
    frontend_pattern_destroy(compiler);
    return null;
}

fn frontend_pattern_position(source: u8*, length: usize, offset: usize): usize {
    var character: usize = 1;
    var at: usize = 0;
    loop {
        var done = at >= offset;
        if at >= length {
            done = true;
        }
        if done {
            return character;
        }
        var id: u32;
        var remaining = length -at;
        var width = tower_utf8_decode(&source[at], remaining, &id);
        if width == 0 {
            width = 1;
        }
        at = at + width;
        character++;
    }
}

export fn frontend_pattern_read(compiler: FrontendPatternCompiler*, source: u8*, length: usize,
error: FormatResult*): SyntaxPattern* {
    var resource_error = WorkBudgetError.None;
    return frontend_pattern_read_result(compiler, source, length, error, &resource_error);
}

export fn frontend_pattern_read_result(compiler: FrontendPatternCompiler*, source: u8*, length: usize,
    error: FormatResult*, resource_error: WorkBudgetError*): SyntaxPattern* {
    if resource_error == null { return null; }
    *resource_error = WorkBudgetError.Invalid;
    if error == null || (source == null && length != 0) { return null; }
    *resource_error = WorkBudgetError.None;
    // Diagnostic allocation cannot overwrite an earlier producer's exact cause.
    defer { if error.failed && *resource_error == WorkBudgetError.None { *resource_error = WorkBudgetError.Memory; } }
    var formatter: FormatEngine = default;
    formatter.result = error;
    if length > FrontendPatternMaximumBytes {
        format_text(&formatter, "Token pattern exceeds ");
        format_unsigned(&formatter, convert(u64, FrontendPatternMaximumBytes));
        format_text(&formatter, " bytes");
        return null;
    }
    if !(tower_utf8_validate(source, length, 0) != 0) {
        format_text(&formatter, "Invalid UTF-8 in token pattern");
        return null;
    }
    var missing = compiler == null;
    if missing {
        *resource_error = WorkBudgetError.Invalid;
        format_text(&formatter, "Unable to allocate token pattern grammar");
        return null;
    }
    var input: FrontendCharacters = default;
    input.source = source;
    input.length = length;
    var root = frontend_read_characters_result(&compiler.table, &compiler.kinds, &input, resource_error);
    missing = root == null;
    if missing {
        if *resource_error != WorkBudgetError.None {
            format_text(&formatter, "Unable to allocate token pattern");
            return null;
        }
        format_text(&formatter, "Unexpected ");
        if input.offset == length {
            format_text(&formatter, "end of input");
        } else {
            if source[input.offset] == 0 {
                format_text(&formatter, "'\\0'");
            } else {
                var id: u32;
                var remaining = length -input.offset;
                var width = tower_utf8_decode(&source[input.offset], remaining, &id);
                format_escape(&formatter, &source[input.offset], width, 39);
            }
        }
        format_text(&formatter, ". In token pattern at character ");
        var position = frontend_pattern_position(source, length, input.offset);
        format_unsigned(&formatter, convert(u64, position));
        return null;
    }
    var pattern = syntax_pattern_create(root);
    entity_release(root);
    missing = pattern == null;
    if missing {
        *resource_error = WorkBudgetError.Memory;
        format_text(&formatter, "Unable to allocate token pattern");
        return null;
    }
    var offset: usize = 0;
    var message = regex_compile_tree_result(pattern.grammar, source, length, compiler.kinds.`match`, pattern.table, &offset, resource_error);
    if message != null {
        format_text(&formatter, message);
        format_text(&formatter, " at pattern character ");
        var position = frontend_pattern_position(source, length, offset);
        format_unsigned(&formatter, convert(u64, position));
        syntax_pattern_release(pattern);
        return null;
    }
    return pattern;
}
