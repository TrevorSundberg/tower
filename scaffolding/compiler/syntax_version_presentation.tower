import tower;
import frontend_revision_types;
import lr_tree;
import parser_nodes;
import parser_types;
import regex_lowering;
import syntax_emission;
import syntax_emission_lexical;
import syntax_reader;
import syntax_revision;
import syntax_version_types;
import .library.vector;

extern fn syntax_description_text(entity: void*, name: u8*, name_only: bool, syntax: void*, kind: void*): u8*;
extern fn syntax_origin_text(entity: void*, prefix: u8*, syntax: void*, kind: void*): u8*;
extern fn tower_memory_allocate(size: usize): void*;
extern fn tower_memory_free(memory: void*): void;

fn syntax_version_text(text: u8*): u8* {
    var size = syntax_text_length(text) + 1;
    var result = bits(u8*, tower_memory_allocate(size));
    if result is not null { copy(result, text, size); }
    return result;
}

export fn syntax_version_description(value: SyntaxVersion*, definitions: FrontendRevision*, index: usize, name_only: bool): u8* {
    var found = syntax_emission_find_index(bits(SyntaxEmission*, value.emission), index);
    if found is null { return null; }
    var rule = syntax_revision_rule(definitions, found.name, syntax_text_length(found.name));
    if rule is null || found.alternative >= rule.count { return null; }
    return syntax_description_text(rule.alternatives[name_only ? 0 : found.alternative], found.name, name_only, value.kinds.syntax, value.kinds.`match`);
}

export fn syntax_parser_describe(context: void*, index: usize): u8* {
    var value = bits(SyntaxVersion*, context);
    var text = syntax_version_description(value, value.grammar, index, false);
    if text is not null && text[0] != 0 { return text; }
    tower_memory_free(bits(void*, text));
    var node = index == 0 ? null : entity_child_at(value.rules, index - 1);
    if node is null { return syntax_version_text("start of input"); }
    var rule = bits(ParserRuleData*, entity_component_data(entity_component_get(node, value.kinds.rule)));
    var helper = syntax_emission_find_helper(bits(SyntaxEmission*, value.emission), node_rule_name(rule));
    if helper is not null {
        return syntax_origin_text(helper.source, helper.capture ? "capture " : "repetition ", value.kinds.syntax, value.kinds.`match`);
    }
    return syntax_version_text("start of a statement or grammar declaration");
}

export fn syntax_parser_resolve(context: void*, name: u8*): u32 {
    var value = bits(SyntaxVersion*, context);
    return syntax_emission_terminal(bits(SyntaxEmission*, value.emission), name);
}

export fn syntax_parser_token_name(context: void*, id: u32): u8* {
    var value = bits(SyntaxVersion*, context);
    return syntax_emission_token_text(bits(SyntaxEmission*, value.emission), id);
}
