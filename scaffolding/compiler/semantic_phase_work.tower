import tower;
import semantic_context_types;
import semantic_context;
import semantic_support;
import semantic_work_ids;
import semantic_lowering_work;
import semantic_aggregates;
import semantic_evaluation_types;
import .library.work_graph;

// These joins describe the frozen ordinary function set after sem_run and the
// known snapshot. Subjects and payloads remain on the same compilation world;
// the graph is the sole readiness index, not another scheduler or function list.
fn sem_phase_query(c: SemanticContext*, phase: SemanticQuery): usize {
    return work_find(&c.queries, c.program.root, convert(u32, phase), 0);
}

fn sem_phase_begin(c: SemanticContext*): bool {
    if !sem_ok(c) || !sem_query_check(c, c.program.root, work_ok(&c.queries)) { return false; }
    if sem_phase_query(c, SemanticQuery.LifecycleLowered) != 0 { return true; }
    sem_lower_register(c, true);
    sem_lower_register(c, false);
    if !sem_ok(c) { work_cancel(&c.queries); return false; }
    var signatures = work_request(&c.queries, c.program.root, convert(u32, SemanticQuery.LifecycleSignatures), 0);
    var lowered = work_request(&c.queries, c.program.root, convert(u32, SemanticQuery.LifecycleLowered), 0);
    if !sem_query_check(c, c.program.root, signatures != 0 && lowered != 0
        && work_depend(&c.queries, lowered, signatures)) { return false; }
    var snapshot = sem_phase_query(c, SemanticQuery.KnownSnapshot);
    if snapshot != 0 && !sem_query_check(c, c.program.root, work_depend(&c.queries, signatures, snapshot)) { return false; }
    foreach(var subject in &c.program.functions) {
        var preparation = work_find(&c.queries, subject, convert(u32, SemanticQuery.AggregatePrepare), 0);
        var lowering = work_find(&c.queries, subject, convert(u32, SemanticQuery.Lowering), 0);
        if preparation != 0 && !sem_query_check(c, subject, work_depend(&c.queries, signatures, preparation)) { return false; }
        if lowering != 0 && !sem_query_check(c, subject, work_depend(&c.queries, lowered, lowering)) { return false; }
    }
    return sem_query_check(c, c.program.root, work_seal(&c.queries, signatures)
        && work_seal(&c.queries, lowered) && work_demand(&c.queries, lowered));
}

// Publish shared callback records only after signature producers join. Ordinary
// lowering reads checked operand types and its own return metadata, so unrelated
// expression jobs need not finish first. The ticket makes publication exactly once.
fn sem_phase_publish(c: SemanticContext*): SemanticPumpResult {
    var progress = false;
    var signatures = sem_phase_query(c, SemanticQuery.LifecycleSignatures);
    var lowered = sem_phase_query(c, SemanticQuery.LifecycleLowered);
    var ticket: WorkTicket = default;
    if work_take_task(&c.queries, &ticket, signatures) {
        foreach(var type in &c.type_arguments) { sem_aggregate_function_type(c, &sem_get(type).type); }
        if !sem_query_check(c, c.program.root, work_finish(&c.queries, &ticket, true)) { return SemanticPumpResult.Failed; }
        progress = true;
    }
    if !sem_query_check(c, c.program.root, work_ok(&c.queries)) { return SemanticPumpResult.Failed; }
    if work_take_task(&c.queries, &ticket, lowered) {
        if !sem_query_check(c, c.program.root, work_finish(&c.queries, &ticket, true)) { return SemanticPumpResult.Failed; }
        progress = true;
    }
    if !sem_query_check(c, c.program.root, work_ok(&c.queries)) { return SemanticPumpResult.Failed; }
    if progress { return SemanticPumpResult.Progress; }
    return work_task(&c.queries, lowered).state == WorkState.Succeeded ? SemanticPumpResult.Complete : SemanticPumpResult.Waiting;
}

fn sem_phase_evaluation_input(c: SemanticContext*, result: SemanticEvaluation*): usize {
    // Early type checking retains its existing executed-dependency pipeline.
    if sem_phase_query(c, SemanticQuery.LifecycleLowered) == 0 { return 0; }
    // Both policies execute reached calls through stable executable inputs.
    // KnownClone/Proof protect each inferred expression before its owner lowers;
    // unrelated canonical bodies are no longer inputs to that evaluation.
    return sem_phase_query(c, SemanticQuery.LifecycleSignatures);
}

fn sem_phase_evaluation_depend(c: SemanticContext*, result: SemanticEvaluation*, query: usize): bool {
    var phase = sem_phase_evaluation_input(c, result);
    if phase == 0 { return true; }
    var owner = work_find(&c.queries, result.owner, convert(u32, SemanticQuery.Lowering), 0);
    return sem_query_check(c, result.subject, work_depend(&c.queries, query, phase)
        && (owner == 0 || work_depend(&c.queries, query, owner)));
}

// Preparations created during earlier type queries may already be sealed or
// started. Add their late prerequisites through ordinary suspension/observation,
// preserving interpreter continuation state without running/replaying effects.
fn sem_phase_evaluation_admit(c: SemanticContext*, result: SemanticEvaluation*, ticket: WorkTicket*): bool {
    var phase = sem_phase_evaluation_input(c, result);
    if phase == 0 { return true; }
    if work_task(&c.queries, phase).state != WorkState.Succeeded {
        sem_query_check(c, result.subject, work_suspend(&c.queries, ticket, phase));
        return false;
    }
    if !sem_query_check(c, result.subject, work_observe(&c.queries, ticket, phase)) { return false; }
    var owner = work_find(&c.queries, result.owner, convert(u32, SemanticQuery.Lowering), 0);
    if owner == 0 { return true; }
    if work_task(&c.queries, owner).state != WorkState.Succeeded {
        sem_query_check(c, result.subject, work_suspend(&c.queries, ticket, owner));
        return false;
    }
    return sem_query_check(c, result.subject, work_observe(&c.queries, ticket, owner));
}

fn sem_phase_lowering_pending(c: SemanticContext*): bool {
    var phase = sem_phase_query(c, SemanticQuery.LifecycleLowered);
    return phase != 0 && work_task(&c.queries, phase).state != WorkState.Succeeded;
}
