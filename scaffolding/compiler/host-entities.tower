import tower;

// Existing host API over the same entity store. No copied nodes or components.
// Only singleton lifetime and native callback dispatch remain host boundaries.
extern fn compiler_entity_store(): EntityStore*;

extern fn abort(): void;

fn host_entity_require(ok: bool): void {
    if ok {} else {
        abort();
    }
}

export fn tower_node_get_allocated_count(): usize {
    return entity_store_count(compiler_entity_store());
}

export fn tower_component_get_allocated_count(): usize {
    return entity_store_component_count(compiler_entity_store());
}

export fn tower_node_create(): Entity* {
    var node = entity_create(compiler_entity_store());
    var ok = node != null;
    host_entity_require(ok);
    return node;
}

export fn tower_node_add_ref(node: Entity*): usize {
    return entity_retain(node);
}

export fn tower_node_release_ref(node: Entity*): usize {
    return entity_release(node);
}

export fn tower_node_get_ref_count(node: Entity*): usize {
    return entity_references(node);
}

export fn tower_node_get_id(node: Entity*): usize {
    return entity_id(node);
}

export fn tower_node_attach(child: Entity*, parent: Entity*): void {
    host_entity_require(entity_attach(child, parent, null));
}

export fn tower_node_attach_member(child: Entity*, parent: Entity*, name: u8*): void {
    host_entity_require(entity_attach(child, parent, name));
}

export fn tower_node_detach(child: Entity*): void {
    host_entity_require(entity_attach(child, null, null));
}

export fn tower_node_get_parent(child: Entity*): Entity* {
    return entity_parent(child);
}

export fn tower_node_get_child_count(parent: Entity*): usize {
    return entity_child_count(parent);
}

export fn tower_node_get_child(parent: Entity*, index: usize): Entity* {
    return entity_child_at(parent, index);
}

export fn tower_node_replace_child(parent: Entity*, index: usize, node: Entity*): void {
    host_entity_require(entity_replace_child(parent, index, node));
}

export fn tower_node_take_last_child(parent: Entity*): Entity* {
    return entity_take_last_child(parent);
}

export fn tower_node_get_child_member_index(parent: Entity*, name: u8*): usize {
    var ok = name != null;
    host_entity_require(ok);
    ok = *name != 0;
    host_entity_require(ok);
    return entity_member_index(parent, name);
}

export fn tower_node_get_child_member(parent: Entity*, name: u8*): Entity* {
    var index = tower_node_get_child_member_index(parent, name);
    return entity_child_at(parent, index);
}

export fn tower_node_get_parent_member_name(child: Entity*): u8* {
    var parent = entity_parent(child);
    var absent = parent == null;
    if absent {
        return null;
    }
    var index = entity_child_index(parent, child);
    return entity_child_name(parent, index);
}

export fn tower_node_get_child_member_name(parent: Entity*, index: usize): u8* {
    return entity_child_name(parent, index);
}

export fn tower_node_get_parent_child_index(child: Entity*): usize {
    var parent = entity_parent(child);
    var absent = parent == null;
    if absent {
        var invalid: usize = 0;
        invalid = invalid - 1;
        return invalid;
    }
    return entity_child_index(parent, child);
}

export fn tower_node_get_component(owner: Entity*, type: Entity*): EntityComponent* {
    return entity_component_get(owner, type);
}

export fn tower_node_get_component_userdata(owner: Entity*, type: Entity*): void* {
    var component = entity_component_get(owner, type);
    return bits(void*, entity_component_data(component));
}

export fn tower_node_get_component_count(owner: Entity*): usize {
    return entity_component_count(owner);
}

export fn tower_node_get_component_by_index(owner: Entity*, index: usize): EntityComponent* {
    return entity_component_at(owner, index);
}

export fn tower_component_get_owner(component: EntityComponent*): Entity* {
    return entity_component_owner(component);
}

export fn tower_component_get_type(component: EntityComponent*): Entity* {
    return entity_component_type(component);
}

export fn tower_component_get_userdata(component: EntityComponent*): void* {
    return bits(void*, entity_component_data(component));
}

export fn tower_component_from_userdata(data: void*): EntityComponent* {
    return entity_component_from_data(bits(u8*, data));
}

export fn tower_component_type_count(type: Entity*): usize {
    return entity_query_count(type);
}

export fn tower_component_type_at(type: Entity*, index: usize): EntityComponent* {
    return entity_query_at(type, index);
}

export fn tower_node_remove_component(owner: Entity*, type: Entity*): bool {
    return entity_component_remove(owner, type);
}
