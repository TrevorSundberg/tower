import .format_diagnostic_test;
import backend.text;
import library.testing;

extern fn selected_diagnostic_case(): u8*;

test() {
    var name = selected_diagnostic_case();
    defer free(name);
    if backend_equal(name, "delimiters") { delimiter_gaps(); return; }
    if backend_equal(name, "separator") { declaration_separator(); return; }
    if backend_equal(name, "line_break") { line_break_repair(); return; }
    if backend_equal(name, "literals") { grammar_literals(); return; }
    if backend_equal(name, "ambiguous") { ambiguous_repairs(); return; }
    if backend_equal(name, "conflicts") { conflict_choices(); return; }
    if backend_equal(name, "cache") { cached_locations(); return; }
    if backend_equal(name, "contextual") { contextual_word(); return; }
    if backend_equal(name, "limits") { fallback_limits(); return; }
    if backend_equal(name, "boundaries") { statement_boundaries(); return; }
    assert(false, name);
}
