import tower;
import format_storage;
import format_foundation;
import format_types;
import format;
import syntax_tags;
import syntax_types;
import grammar_attributes;

fn format_grammar_attribute(f: FormatEngine*, attribute: SyntaxNode*): void {
    format_text(f, "[");
    format_identifier(f, &attribute.name);
    if attribute.items.length != 0 {
        format_text(f, "(");
        for(var index: usize = 0; index < attribute.items.length; index++) {
            if index != 0 { format_text(f, ", "); }
            var value = format_syntax(f, attribute.items.data[index]);
            if value.kind == convert(u32, SyntaxKind.AttributeString) { format_quote(f, &value.text); }
            else { if value.kind == convert(u32, SyntaxKind.AttributeInteger) { format_bytes(f, &value.text); }
            else { format_identifier(f, &value.text); } }
        }
        format_text(f, ")");
    }
    format_text(f, "]");
}

fn format_grammar_has_attribute(f: FormatEngine*, node: SyntaxNode*, kind: GrammarAttributeKind): bool {
    foreach(var entity in &node.attributes) {
        if grammar_attribute_kind(&format_syntax(f, entity).name) == kind { return true; }
    }
    return false;
}

fn format_grammar_attributes(f: FormatEngine*, node: SyntaxNode*): void {
    foreach(var entity in &node.attributes) {
        var attribute = format_syntax(f, entity);
        var start = f.result.text.length;
        format_grammar_attribute(f, attribute);
        format_span(f, start, attribute.start);
        format_text(f, "\n");
        format_indent(f);
    }
}

// Grammar terms, alternatives and declarations retain shared entity identity.
fn format_grammar_term(f: FormatEngine*, entity: void*): void {
    var term = format_syntax(f, entity);
    if term.capture.length != 0 {
        format_text(f, "$");
        format_identifier(f, &term.capture);
        var same = term.capture.length == term.text.length;
        var i: usize = 0;
        loop {
            if i == term.capture.length {
                break;
            }
            if !same {
                break;
            }
            same = term.capture.data[i] == term.text.data[i];
            i++;
        }
        if same {
            if term.repetition != 0 {
                format_char(f, term.repetition);
            }
            return;
        }
        format_text(f, ":");
    }
    if term.terminal_set {
        format_text(f, "[^");
        var i: usize = 0;
        loop {
            if i == term.items.length {
                break;
            }
            if i != 0 {
                format_text(f, " ");
            }
            var item = format_syntax(f, term.items.data[i]);
            format_quote(f, &item.text);
            i++;
        }
        format_text(f, "]");
    } else {
        if term.literal {
            format_quote(f, &term.text);
        }
        else {
            format_identifier(f, &term.text);
        }
    }
    if term.repetition != 0 {
        format_char(f, term.repetition);
    }
}

fn format_alternative(f: FormatEngine*, entity: void*): void {
    var n = format_syntax(f, entity);
    var i: usize = 0;
    loop {
        if i == n.items.length {
            break;
        }
        if i != 0 {
            format_text(f, " ");
        }
        format_grammar_term(f, n.items.data[i]);
        i++;
    }
}

fn format_precedence(f: FormatEngine*, n: SyntaxNode*): void {
    if n.precedence == 0 || format_grammar_has_attribute(f, n, GrammarAttributeKind.Precedence) {
        return;
    }
    format_text(f, " @ ");
    format_unsigned(f, convert(u64, n.precedence));
    if n.associativity == 1 {
        format_text(f, " left");
    }
    else {
        if n.associativity == 2 {
            format_text(f, " right");
        }
        else {
            format_text(f, " nonassoc");
        }
    }
}

fn format_comments(f: FormatEngine*, n: SyntaxNode*): void {
    var i: usize = 0;
    loop {
        if i == n.comments.length {
            break;
        }
        format_indent(f);
        format_bytes(f, &n.comments.data[i]);
        format_text(f, "\n");
        i++;
    }
}

fn format_replacement(f: FormatEngine*, n: SyntaxNode*): void {
    if n.replacement == null {
        return;
    }
    format_text(f, "\n");
    f.result.depth++;
    format_indent(f);
    f.result.depth--;
    format_text(f, "=> replace {");
    var replacement = format_syntax(f, n.replacement);
    format_bytes(f, &replacement.text);
    format_text(f, "}");
}

fn format_grammar(f: FormatEngine*, entity: void*): void {
    var n = format_syntax(f, entity);
    if n.kind == 0 {
        var i: usize = 0;
        loop {
            if i == n.items.length {
                break;
            }
            format_node(f, n.items.data[i]);
            i++;
        }
        format_comments(f, n);
        return;
    }
    format_comments(f, n);
    format_indent(f);
    var begin = f.result.text.length;
    format_grammar_attributes(f, n);
    if n.kind == convert(u32, SyntaxKind.Attribute) { format_grammar_attribute(f, n); return; }
    if n.kind == 7 {
        format_text(f, "import ");
        if n.literal {
            format_quote(f, &n.name);
        }
        else {
            if n.items.length == 0 {
                format_identifier(f, &n.name);
            } else {
                var i: usize = 0;
                var separator: bool = false;
                loop {
                    if i == n.items.length {
                        break;
                    }
                    var segment = format_syntax(f, n.items.data[i]);
                    if segment.literal {
                        format_text(f, ".");
                        i = i + 1;
                        continue;
                    }
                    if separator {
                        format_text(f, ".");
                    }
                    format_identifier(f, &segment.text);
                    separator = true;
                    i++;
                }
            }
        }
        if n.capture.length != 0 {
            format_text(f, " as ");
            format_identifier(f, &n.capture);
        }
        format_text(f, ";\n");
        format_span(f, begin, n.start);
        return;
    }
    if n.kind == 1 {
        format_text(f, "parse ");
        format_identifier(f, &n.name);
        if n.append {
            format_text(f, " |=");
        }
        else {
            format_text(f, " =");
        }
        var continuation = format_column(f);
        var i: usize = 0;
        loop {
            if i == n.items.length {
                break;
            }
            if i != 0 {
                var output: FormatResult = default;
                format_storage_child(&output, f.result);
                var probe: FormatEngine = default;
                probe.source_names = false;
                probe.result = &output;
                probe.syntax_kind = f.syntax_kind;
                probe.foundation_kind = f.foundation_kind;
                probe.match_kind = f.match_kind;
                format_alternative(&probe, n.items.data[i]);
                format_storage_fail(f.result, format_storage_error(&output));
                var column = format_column(f);
                column = column + 3;
                column = column + output.text.length;
                format_dispose(&output);
                if column > 110 {
                    format_text(f, "\n");
                    format_repeat(f, 32, continuation);
                    format_text(f, "|");
                } else {
                    format_text(f, " |");
                }
            }
            var alternative = format_syntax(f, n.items.data[i]);
            if alternative.items.length != 0 {
                format_text(f, " ");
            }
            format_alternative(f, n.items.data[i]);
            i++;
        }
        format_precedence(f, n);
        format_replacement(f, n);
        if n.replacement == null {
            if n.items.length != 0 {
                var last = n.items.length -1;
                var alternative = format_syntax(f, n.items.data[last]);
                if alternative.items.length == 0 {
                    format_text(f, " ");
                }
            }
        }
        format_text(f, ";\n");
    } else {
        var entry = n.kind == 2;
        var skipped = n.kind == 3;
        if format_or(entry, skipped) {
            if skipped {
                format_text(f, "skip ");
            } else {
                format_text(f, "token ");
            }
            format_identifier(f, &n.name);
            format_text(f, " = /");
            format_bytes(f, &n.text);
            format_text(f, "/");
            if n.contextual && !format_grammar_has_attribute(f, n, GrammarAttributeKind.Contextual) {
                format_text(f, " when expected");
            }
            if n.style.length != 0 && !format_grammar_has_attribute(f, n, GrammarAttributeKind.Style) {
                format_text(f, " as ");
                format_identifier(f, &n.style);
            }
            format_text(f, ";\n");
        } else {
            if n.kind == 4 {
                format_alternative(f, entity);
                format_replacement(f, n);
            }
            else {
                if n.kind == 5 {
                    format_grammar_term(f, entity);
                }
                else {
                    format_bytes(f, &n.text);
                }
            }
        }
    }
    var invalid: usize = 0;
    invalid--;
    if n.start != invalid {
        format_span(f, begin, n.start);
    }
}

// Compact grammar previews share canonical spelling without enclosing comments
// or replacement bodies. Hover descriptions are emitted by the language query.
export fn format_grammar_preview(result: FormatResult*, entity: void*, syntax: void*): void {
    var f: FormatEngine = default;
    f.source_names = false;
    f = default;
    f.result = result;
    f.syntax_kind = syntax;
    var n = format_syntax(&f, entity);
    if n == null {
        return;
    }
    format_grammar_attributes(&f, n);
    if n.kind == SyntaxAlternative {
        format_alternative(&f, entity);
        format_precedence(&f, n);
        return;
    }
    if n.kind == SyntaxTerm {
        format_grammar_term(&f, entity);
        return;
    }
    if n.kind == SyntaxToken {
        format_text(&f, "token ");
    }
    if n.kind == SyntaxSkip {
        format_text(&f, "skip ");
    }
    format_identifier(&f, &n.name);
    if n.kind == SyntaxToken {
        format_text(&f, " = /");
        format_bytes(&f, &n.text);
        format_text(&f, "/");
    }
    if n.kind == SyntaxSkip {
        format_text(&f, " = /");
        format_bytes(&f, &n.text);
        format_text(&f, "/");
    }
}
