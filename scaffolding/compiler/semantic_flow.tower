extern fn entity_view_open_result(anchor: void*, error: WorkBudgetError*): void*;
extern fn compiler_node_world(node: void*): void*;

var FlowQuery: u32 = convert(u32, SemanticQuery.Flow);
var SemanticFlowDepthLimit: usize = 1024;

struct SemanticFlow {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    subject: void*;
    ordinal: usize;
    invalid_label: void*;
    excessive_depth: void*;
    flow: u32;
}

fn sem_flow_resource(c: SemanticContext*, subject: void*, error: WorkBudgetError): void {
    var message: vector(u8) = default;
    var operation = sem_get(subject);
    sem_restore_resource(c, error, &message, operation == null ? 0 : operation.start);
}

// This is a readiness check, not evaluation of a constant expression. Only the
// ordinary interpreter publishes the producer's value. Conservative initial
// flow keeps cleanup paths until the dependent result is available.
fn sem_flow_known(c: SemanticContext*, node: void*): bool {
    if !sem_get(node).constant { return false; }
    var dependency = sem_evaluation_dependency(c, node);
    if dependency != null && !dependency.ready {
        if !sem_has(&c.flow_dependencies, dependency.subject) {
            if !vector_push(&c.flow_dependencies, dependency.subject) {
                // Body workers own their private program receipt. Cancellation
                // belongs to the joined body caller, never to this worker.
                sem_flow_resource(c, c.current, WorkBudgetError.Memory);
            }
        }
        return false;
    }
    return true;
}

export fn sem_flow_request(c: SemanticContext*, subject: void*, dependencies: vector(void*)*): void {
    if !sem_ok(c) { return; }
    if !sem_query_check(c, subject, work_ok(&c.queries)) { return; }
    // The first request owns the complete dependency list. A repeated body
    // publication must not reset its result, ordinal or sealed access claims.
    if work_find(&c.queries, subject, FlowQuery, 0) != 0 { return; }
    var query = work_request(&c.queries, subject, FlowQuery, 0);
    if !sem_query_check(c, subject, query != 0) { return; }
    foreach(var dependency_subject in dependencies) {
        var dependency = work_find(&c.queries, dependency_subject, EvaluationQuery, 0);
        if !sem_query_check(c, subject, dependency != 0 && work_depend(&c.queries, query, dependency)) { return; }
    }
    var domain = convert(u64, SemanticWorkDomain.Compiler);
    if !sem_query_check(c, subject,
        work_access(&c.queries, query, domain, convert(u64, SemanticAccess.Flow), c.flow_count, 1, WorkAccessMode.Write)
        && work_access(&c.queries, query, domain, convert(u64, SemanticAccess.Expression), 0, ~convert(usize, 0), WorkAccessMode.Read)
        && work_seal(&c.queries, query)) { return; }
    if c.flow_results == null {
        var error: WorkBudgetError;
        c.flow_results = sem_kind_result(c.program.root, sizeof(SemanticFlow), alignof(SemanticFlow), &error);
        if c.flow_results == null { sem_flow_resource(c, subject, error); work_cancel(&c.queries); return; }
    }
    var error: WorkBudgetError;
    var result = bits(SemanticFlow*, entity_component_data(entity_component_add_result(subject, c.flow_results, &error)));
    if result == null { sem_flow_resource(c, subject, error); work_cancel(&c.queries); return; }
    fill(result, 0, sizeof(SemanticFlow));
    result.subject = subject;
    result.ordinal = c.flow_count;
    result.kernel.kind = CompilerKernelKind.Flow;
    result.kernel.payload = bits(void*, result);
    c.flow_count++;
}

// Read-only return/reachability validation of the already-lowered Foundation
// tree. It neither rewrites nodes nor computes expression values. Labels and
// loop exits retain the same flow contract as the initial body checker.
fn sem_flow_node(result: SemanticFlow*, node: void*, depth: usize): u32 {
    if node == null { return FlowNext; }
    if depth > SemanticFlowDepthLimit { result.excessive_depth = node; return FlowNext; }
    var value = sem_get(node);
    if value == null { return FlowNext; }
    if value.kind == KReturn { return FlowReturn; }
    if value.kind == KBreak { return FlowBreak; }
    if value.kind == KContinue { return FlowContinue; }
    if value.kind == KTrap || value.kind == KJump { return 0; }
    if value.kind == KBlock || value.kind == KProgram {
        var flow = FlowNext;
        var labeled = false;
        for(var i: usize = 0; i < value.items.length; i++) {
            var item = value.items.data[i];
            var child = sem_get(item);
            if child != null && child.kind == KLabel {
                if labeled && (flow & FlowNext) != 0 && result.invalid_label == null {
                    result.invalid_label = item;
                }
                labeled = true;
                flow = FlowNext;
            }
            var next = sem_flow_node(result, item, depth + 1);
            if (flow & FlowNext) != 0 { flow = (flow & ~FlowNext) | next; }
        }
        return flow;
    }
    if value.kind == KIf {
        var yes = sem_flow_node(result, value.body, depth + 1);
        var no = sem_flow_node(result, value.otherwise, depth + 1);
        var condition = sem_get(value.value);
        if condition != null && condition.constant { return condition.bits != 0 ? yes : no; }
        return yes | no;
    }
    if value.kind == KLoop {
        var body = sem_flow_node(result, value.body, depth + 1);
        return (body & FlowReturn) | ((body & FlowBreak) != 0 ? FlowNext : 0);
    }
    return FlowNext;
}

fn semantic_flow_kernel(result: SemanticFlow*): void {
    result.flow = sem_flow_node(result, sem_get(result.subject).body, 0);
}

fn sem_flow_missing(c: SemanticContext*, result: SemanticFlow*): bool {
    var function = sem_get(result.subject);
    var returns = function.type.pointers != 0 || function.type.scalar != SVoid;
    var signature = sem_aggregate_signature(c, result.subject);
    returns ||= signature != null && signature.result_parameter != null;
    return returns && (result.flow & FlowNext) != 0;
}

fn sem_flow_failure(c: SemanticContext*, result: SemanticFlow*, query: usize): void {
    if result.invalid_label != null {
        sem_fail(c, result.invalid_label, "A labeled block must end with jump or return before the next label");
    } else { if result.excessive_depth != null {
        sem_fail(c, result.excessive_depth, sem_cat(c, "Foundation control-flow analysis nesting exceeds ",
            sem_decimal(c, convert(u64, SemanticFlowDepthLimit))));
    } else { if sem_flow_missing(c, result) {
        sem_fail(c, result.subject, sem_cat(c, "Function '", sem_cat(c, sem_name(sem_get(result.subject)),
            "' can finish without returning a value")));
    } else { if !sem_declaration_failure(c, query) {
        sem_fail(c, result.subject, "Flow dependency failed without a retained diagnostic");
    } } } }
}

// Only the late lifecycle boundary may enter this pump: canonical lowering,
// evaluation, known publication and module initializers must already be settled.
// Readiness alone is not permission to move this read-only pass before them.
export fn sem_flows_pump(c: SemanticContext*): SemanticPumpResult {
    if !sem_ok(c) { return SemanticPumpResult.Failed; }
    if !sem_query_check(c, c.program.root, work_ok(&c.queries)) { return SemanticPumpResult.Failed; }
    if c.flow_count == 0 { return SemanticPumpResult.Complete; }
    // Registration owns exactly one component for every source ordinal. Its
    // world-owned instance index already supplies stable payloads under a pin;
    // rebuilding a two-term archetype plan adds no information to this pass.
    sem_require(c.flow_results != null && entity_query_count(c.flow_results) == c.flow_count);
    var owner = bits(SemanticFlow*, entity_component_data(entity_query_at(c.flow_results, 0))).subject;
    for(var index: usize = 0; index < c.flow_count; index++) {
        var result = bits(SemanticFlow*, entity_component_data(entity_query_at(c.flow_results, index)));
        if result.ordinal == 0 { owner = result.subject; break; }
    }
    defer { if !sem_ok(c) { work_cancel(&c.queries); } }
    if c.workers.count == 0 {
        var current = c.current;
        c.current = owner;
        var opened = sem_workers_open(c);
        c.current = current;
        if !opened { return SemanticPumpResult.Failed; }
    }
    var error: WorkBudgetError;
    var view = entity_view_open_result(c.program.root, &error);
    if view == null { sem_flow_resource(c, owner, error); return SemanticPumpResult.Failed; }
    defer entity_view_close(view);
    var budget = compiler_world_work_budget(compiler_node_world(c.program.root));
    var jobs: work_vector(SemanticFlow*) = default;
    defer work_vector_dispose(&jobs);
    error = work_vector_reserve_result(&jobs, budget, c.flow_count);
    if error != WorkBudgetError.None { sem_flow_resource(c, owner, error); return SemanticPumpResult.Failed; }
    jobs.length = c.flow_count;
    fill(jobs.data, 0, jobs.length * sizeof(SemanticFlow*));
    for(var index: usize = 0; index < c.flow_count; index++) {
        var result = bits(SemanticFlow*, entity_component_data(entity_query_at(c.flow_results, index)));
        sem_require(result.ordinal < jobs.length && jobs.data[result.ordinal] == null);
        jobs.data[result.ordinal] = result;
    }
    // Archetype/row order is an execution detail. Demand, admission and errors
    // retain the source ordinal recorded when each dependency query was created.
    for(var i: usize = 0; i < c.flow_count; i++) {
        var result = jobs.data[i];
        if !sem_query_check(c, result.subject, work_demand(&c.queries, work_find(&c.queries, result.subject, FlowQuery, 0))) {
            return SemanticPumpResult.Failed;
        }
    }
    var batch: work_vector(SemanticFlow*) = default;
    defer work_vector_dispose(&batch);
    error = work_vector_reserve_result(&batch, budget, jobs.length < SemanticPreparationWindow ? jobs.length : SemanticPreparationWindow);
    if error != WorkBudgetError.None { sem_flow_resource(c, owner, error); return SemanticPumpResult.Failed; }
    foreach(var result in &jobs) {
        var id = work_find(&c.queries, result.subject, FlowQuery, 0);
        if work_take_task(&c.queries, &result.ticket, id) {
            batch.data[batch.length++] = result;
            if batch.length == SemanticPreparationWindow { break; }
        }
        if !sem_query_check(c, result.subject, work_ok(&c.queries)) { return SemanticPumpResult.Failed; }
    }
    if batch.length != 0 {
        var receipt: WorkReservation;
        var extra: usize = 0;
        error = sem_workers_admit_result(c, batch.length, &receipt, &extra);
        defer sem_workers_release(c, &receipt);
        if error == WorkBudgetError.None {
            error = compiler_kernel_dispatch_admitted_result(&c.workers, batch.data, batch.length, extra);
        }
        // Dispatch joins every admitted peer before errors invalidate tickets or
        // release this view. Flow has no staged structural output to publish.
        if error != WorkBudgetError.None {
            var message: vector(u8) = default;
            work_cancel(&c.queries);
            sem_restore_resource(c, error, &message, sem_get(batch.data[0].subject).start);
            return SemanticPumpResult.Failed;
        }
        var failing = false;
        foreach(var result in &batch) {
            failing ||= sem_flow_missing(c, result) || result.invalid_label != null || result.excessive_depth != null;
        }
        if !sem_completion_reserve(c, batch.data, batch.length, failing) { return SemanticPumpResult.Failed; }
        foreach(var result in &batch) {
            if !sem_query_check(c, result.subject, work_finish(&c.queries, &result.ticket,
                !sem_flow_missing(c, result) && result.invalid_label == null && result.excessive_depth == null)) {
                return SemanticPumpResult.Failed;
            }
        }
    }
    // Retain later failed results while an earlier source owner is waiting.
    // Repeated calls neither take completed queries nor replay their kernels.
    foreach(var result in &jobs) {
        var id = work_find(&c.queries, result.subject, FlowQuery, 0);
        var state = work_task(&c.queries, id).state;
        if state == WorkState.Succeeded { continue; }
        if state == WorkState.Failed {
            sem_flow_failure(c, result, id);
            return SemanticPumpResult.Failed;
        }
        return batch.length != 0 ? SemanticPumpResult.Progress : SemanticPumpResult.Waiting;
    }
    return SemanticPumpResult.Complete;
}

export fn sem_flows(c: SemanticContext*): void {
    var state = sem_flows_pump(c);
    while state == SemanticPumpResult.Progress { state = sem_flows_pump(c); }
    if state != SemanticPumpResult.Waiting { return; }
    // This caller is the final, quiescent lifecycle boundary; earlier producer
    // pipelines have already drained. Ordinary pump suspension never diagnoses
    // a cycle. Select the first source query and preserve graph-walker failures.
    foreach(var &task in &c.queries.tasks) {
        if task.query != FlowQuery || task.state == WorkState.Succeeded { continue; }
        var id = work_find(&c.queries, task.subject, FlowQuery, 0);
        var cycle: vector(usize) = default;
        defer vector_dispose(&cycle);
        var found = work_cycle(&c.queries, id, &cycle);
        if !sem_query_check(c, task.subject, work_ok(&c.queries)) { return; }
        var message: u8* = "Flow is waiting for an unfinished compiler query";
        if found {
            message = "Flow dependency cycle";
            for(var i: usize = 0; i < cycle.length; i++) {
                message = sem_cat(c, message, i == 0 ? ": " : " -> ");
                if !sem_ok(c) { return; }
                message = sem_cat(c, message, sem_decimal(c, convert(u64, sem_get(work_task(&c.queries, cycle.data[i]).subject).start)));
                if !sem_ok(c) { return; }
            }
        }
        sem_fail(c, task.subject, message);
        return;
    }
}
