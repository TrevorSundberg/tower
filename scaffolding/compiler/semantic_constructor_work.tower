// Static identity forms use the existing type producer graph. Resolve ordinary
// callees first: a user function named function is still an ordinary call.
fn sem_type_identity_call(c: SemanticContext*, node: void*): bool {
    if node == null || sem_member(node, "args") == null { return false; }
    var name_node = sem_member(node, "name");
    if name_node == null || sem_call_uses_value(c, name_node) { return false; }
    var name = sem_identifier(c, name_node);
    if !sem_ok(c) { return default; }
    if sem_resolve(c, c.functions, name_node, name) != null
        || sem_resolve(c, c.templates, name_node, name) != null { return false; }
    return sem_resolve(c, c.type_functions, name_node, name) != null || sem_equal(name, "function");
}

// Value-position representation calls execute their ordinary operands. Type
// spelling retains the declaration query path below; no eager numeric folding
// or interning occurs while a body worker checks this operation.
fn sem_type_construct_value(c: SemanticContext*, node: void*, name: u8*,
    arguments: vector(void*)*): bool {
    if sem_equal(name, "function") && sem_type_identity_call(c, node) {
        var type = sem_constructor_prepared(c, node);
        if type == null { sem_fail(c, node, "Function type value requires its type construction query"); }
        else {
            var value = sem_node_result(c, node, KTypeReference);
            if value == null { return true; }
            value.type = sem_type_value(c, SType, 0, null);
            value.element = *type;
        }
        return true;
    }
    if !sem_type_representation_name(name) { return false; }
    var integer = sem_equal(name, "integer_type");
    var floating = sem_equal(name, "float_type");
    var pointer = sem_equal(name, "pointer_type");
    var array = sem_equal(name, "array_type");
    if !integer && !floating && !pointer && !array {
        var type = sem_type_primitive(c, node, name);
        if sem_ok(c) {
            var value = sem_node_result(c, node, KTypeReference);
            if value == null { return true; }
            value.type = sem_type_value(c, SType, 0, null);
            value.element = *type;
        }
        return true;
    }
    var arity: usize = integer || array ? 2 : 1;
    if arguments.length != arity {
        sem_fail(c, node, "Wrong argument count for representation type constructor");
        return true;
    }
    var value = sem_node_result(c, node, KTypeConstruct);
    if value == null { return true; }
    value.type = sem_type_value(c, SType, 0, null);
    value.op = convert(u32, integer ? TypeConstructionKind.Integer : floating ? TypeConstructionKind.Floating
        : pointer ? TypeConstructionKind.Pointer : TypeConstructionKind.Array);
    value.left = sem_operand(c, arguments.data[0], pointer || array ? &value.type : null);
    if !sem_ok(c) { return true; }
    if !pointer && !array && !semantic_integer(&sem_get(value.left).type) {
        sem_fail(c, arguments.data[0], "Type constructor requires an integer argument");
        return true;
    }
    if arity == 2 {
        value.right = sem_operand(c, arguments.data[1], null);
        if sem_ok(c) && !semantic_integer(&sem_get(value.right).type) {
            sem_fail(c, arguments.data[1], "Type constructor requires an integer argument");
        }
    }
    return true;
}

// Syntax consumers and canonical instance results use the same dependency
// graph, but retain separate receipts. Instance bodies are copied by the shared
// staged clone executor; nominal identity never waits for its own fields.

fn sem_constructor_state(c: SemanticContext*, node: void*): SemanticConstructor* {
    sem_require(c.entity_stage == null);
    if !sem_ok(c) { return null; }
    var error: WorkBudgetError;
    if c.type_constructors == null {
        c.type_constructors = sem_kind_result(c.program.root, sizeof(SemanticConstructor), alignof(SemanticConstructor), &error);
        if c.type_constructors == null { sem_type_resource(c, node, error); return null; }
    }
    var component = entity_component_get(node, c.type_constructors);
    if component != null { return bits(SemanticConstructor*, entity_component_data(component)); }
    var result = bits(SemanticConstructor*, entity_component_data(entity_component_add_result(node, c.type_constructors, &error)));
    if result == null { sem_type_resource(c, node, error); return null; }
    *result = default;
    return result;
}

fn sem_constructor_dispose(c: SemanticContext*): void {
    if c.type_constructors == null { return; }
    for(var i: usize = 0; i < entity_query_count(c.type_constructors); i++) {
        var result = bits(SemanticConstructor*, entity_component_data(entity_query_at(c.type_constructors, i)));
        *result = default;
    }
}

fn sem_constructor_prepared(c: SemanticContext*, node: void*): FoundationType* {
    if c.type_constructors == null { return null; }
    node = sem_surface_unwrap(node);
    while (sem_is(node, "CoreTypeArgument") || sem_is(node, "CoreCallArgument") || sem_is(node, "CoreOperand"))
        && sem_child_count(node) == 1 { node = sem_surface_unwrap(sem_child(node, 0)); }
    var result = bits(SemanticConstructor*, entity_component_data(entity_component_get(node, c.type_constructors)));
    if result == null || result.phase != SemanticConstructorPhase.Ready { return null; }
    sem_query_input(c, node, convert(u32, SemanticQuery.TypeConstruction));
    return &result.type;
}

fn sem_type_query_syntax(c: SemanticContext*, node: void*): bool {
    if sem_array_syntax(node) { return true; }
    var value = sem_value_binding(c, node);
    if value != null && sem_get(value).type.scalar == SType && sem_get(value).type.pointers == 0 { return true; }
    if (!sem_is(node, "CoreType") && !sem_is(node, "CoreCall")) || sem_member(node, "args") == null { return false; }
    var name_node = sem_member(node, "name");
    var name = sem_identifier(c, name_node);
    if !sem_ok(c) { return default; }
    // Array construction has its own element/count query and coordinated
    // interning. Other Foundation representations need no user body to clone.
    if sem_equal(name, "array_type") || sem_equal(name, "integer_type") || sem_equal(name, "float_type") { return true; }
    if sem_type_representation_name(name) { return false; }
    // Existing static signature spellings can still walk their type arguments
    // directly. A same-named ordinary callee instead needs executed preparation.
    return !sem_equal(name, "function") || !sem_type_identity_call(c, node)
        || sem_resolve(c, c.type_functions, name_node, name) != null;
}

// Restore known numeric forwarding only for a chain of single-return calls
// ending in an existing static constructor. Resolve real declarations in each
// definition's module; never classify an effectful ordinary callee by spelling.
fn sem_constructor_wrapper(c: SemanticContext*, node: void*): void* {
    var name = sem_member(node, "name");
    if name == null || sem_call_uses_value(c, name) { return null; }
    var spelling = sem_identifier(c, name);
    var definition = sem_resolve(c, c.templates, name, spelling);
    if definition == null { definition = sem_resolve(c, c.functions, name, spelling); }
    return sem_constructor_wrapper_definition(c, definition);
}

// Body admission and known type calls use the same declaration proof. This
// inspects only a strict forwarding chain, never executes or completes a body.
fn sem_constructor_wrapper_definition(c: SemanticContext*, definition: void*): void* {
    if definition == null || !sem_ok(c) { return null; }
    var first = definition;
    var seen = sem_list(c);
    if !sem_ok(c) { return null; }
    loop {
        var result_type = sem_tokens(c, sem_member(definition, "type"));
        if !sem_ok(c) { return null; }
        if !sem_equal(result_type, "type")
            || sem_has(seen, definition) { return null; }
        if !sem_push_checked(c, seen, definition) { return null; }
        var error: u8* = null;
        var returned = generic_type_result_read(definition, &error);
        if error != null || !sem_is(returned, "CoreCall") { return null; }
        var callee = sem_member(returned, "name");
        var called = sem_identifier(c, callee);
        var parameters = sem_collect(c, sem_member(definition, "params"), "CoreParameter");
        if !sem_ok(c) { return null; }
        var numeric = false;
        for(var i: usize = 0; i < parameters.length; i++) {
            var parameter = parameters.data[i];
            // A formal callee is a value binding, not the same-named module fn.
            var parameter_name = sem_identifier(c, sem_member(parameter, "name"));
            if !sem_ok(c) || sem_equal(called, parameter_name) { return null; }
            if definition != first || generic_type_parameter(c.generics, definition, i) { continue; }
            numeric = true;
            var annotation = sem_member(parameter, "type");
            var type_name = sem_identifier(c, annotation);
            // This bounded path admits source-bound scalar parameter types.
            // Dependent/structural parameter signatures keep ordinary execution.
            if sem_resolve(c, c.types, annotation, type_name) == null { return null; }
            for(var j: usize = 0; j < parameters.length; j++) {
                var parameter_name = sem_identifier(c, sem_member(parameters.data[j], "name"));
                if !sem_ok(c) { return null; }
                if generic_type_parameter(c.generics, definition, j)
                    && sem_equal(type_name, parameter_name) { return null; }
            }
        }
        if definition == first && !numeric { return null; }
        if !sem_ok(c) || sem_resolve(c, c.globals, callee, called) != null { return null; }
        var next = sem_resolve(c, c.templates, callee, called);
        if next == null { next = sem_resolve(c, c.functions, callee, called); }
        if !sem_ok(c) { return null; }
        if next == null {
            return sem_resolve(c, c.type_functions, callee, called) != null ? first : null;
        }
        definition = next;
    }
}

export fn sem_constructor_add(c: SemanticContext*, node: void*, parent: SemanticDeclaration*): SemanticDeclaration* {
    if !sem_ok(c) { return null; }
    if node == null || parent == null { sem_type_resource(c, node, WorkBudgetError.Invalid); return null; }
    var result = sem_declaration_state_result(c, node);
    if result == null { return null; }
    if result.query != 0 { sem_require(result.constructor != null); return result; }
    result.constructor = sem_constructor_state(c, node);
    if result.constructor == null { return null; }
    if sem_member(node, "args") == null && sem_value_binding(c, node) != null {
        result.constructor.phase = SemanticConstructorPhase.Execute;
    }
    var name = sem_member(node, "name");
    result.constructor.definition = sem_resolve(c, c.type_functions, name, sem_identifier(c, name));
    if result.constructor.definition == null && result.constructor.phase == SemanticConstructorPhase.Call {
        result.constructor.definition = sem_constructor_wrapper(c, node);
        if result.constructor.definition != null { result.constructor.phase = SemanticConstructorPhase.Parameters; }
    }
    if !sem_ok(c) { return default; }
    result.construction_owner = parent.construction_owner ?? parent;
    result.scope = parent.scope;
    result.current = parent.current;
    result.lexical = parent.lexical;
    return sem_ok(c) && sem_declaration_add_result(c, node) ? result : null;
}

fn sem_constructor_roots(c: SemanticContext*, result: SemanticDeclaration*, scan: vector(DeclarationScan)*): void {
    var work = result.constructor;
    if work.phase == SemanticConstructorPhase.Parameters {
        var parameters = sem_collect(c, sem_member(work.definition, "params"), "CoreParameter");
        if !sem_ok(c) { return; }
        for(var i: usize = 0; i < parameters.length; i++) {
            if !generic_type_parameter(c.generics, work.definition, i) {
                sem_declaration_scan_push(c, scan, sem_member(parameters.data[i], "type"), true);
            }
        }
        return;
    }
    if work.phase == SemanticConstructorPhase.Execute {
        sem_declaration_scan_push(c, scan, result.subject, false);
        return;
    }
    if work.phase == SemanticConstructorPhase.Alias {
        sem_declaration_scan_push(c, scan, work.syntax, true);
    }
    if work.phase != SemanticConstructorPhase.Call { return; }
    var node = result.subject;
    var args = sem_collect(c, sem_member(node, "args"), sem_is(node, "CoreCall") ? "CoreCallArgument" : "CoreTypeArgument");
    if !sem_ok(c) { return; }
    var definition = work.definition;
    if definition == null && sem_type_identity_call(c, node) {
        foreach(var argument in args) { sem_declaration_scan_push(c, scan, argument, true); }
        return;
    }
    if definition == null || args.length != generic_parameter_count(c.generics, definition) { return; }
    var parameters = sem_collect(c, sem_member(definition, "params"), "CoreParameter");
    if !sem_ok(c) { return; }
    for(var i: usize = 0; i < args.length; i++) {
        var type = generic_type_parameter(c.generics, definition, i);
        if !type { sem_declaration_scan_push(c, scan, sem_member(parameters.data[i], "type"), true); }
        if type { sem_declaration_scan_push(c, scan, args.data[i], true); }
    }
}

fn sem_constructor_instance(c: SemanticContext*, call: SemanticDeclaration*): SemanticDeclaration* {
    var source = call.constructor;
    var result = sem_declaration_state_result(c, source.instance);
    if result == null { return null; }
    if result.query != 0 { sem_require(result.constructor != null); return result; }
    var work = sem_constructor_state(c, source.instance);
    if work == null { return null; }
    result.constructor = work;
    result.construction_owner = call.construction_owner;
    result.construction_identity = call.construction_identity;
    work.phase = SemanticConstructorPhase.Clone;
    work.definition = source.definition;
    work.instance = source.instance;
    work.arguments = source.arguments;
    // The definition's module/generic bindings supply the body scope, never the
    // caller's lexical locals. Cached identities from structural checking can
    // still acquire a receipt without cloning or publishing them twice.
    var entry = sem_state(c, c.type_results, source.instance);
    if !sem_ok(c) { return default; }
    if entry.value != null {
        work.type = *bits(FoundationType*, entry.value);
        work.phase = SemanticConstructorPhase.Ready;
        result.checked = true;
    }
    return sem_ok(c) && sem_declaration_add_result(c, source.instance) ? result : null;
}

// Returns true only when a changed continuation needs readmission. Waiting
// dependencies are installed by the declaration executor after publication.
fn sem_constructor_step(c: SemanticContext*, result: SemanticDeclaration*): bool {
    if !sem_ok(c) { return false; }
    var work = result.constructor;
    if work.phase == SemanticConstructorPhase.Parameters {
        var parameters = sem_collect(c, sem_member(work.definition, "params"), "CoreParameter");
        if !sem_ok(c) { return false; }
        work.phase = SemanticConstructorPhase.Call;
        for(var i: usize = 0; i < parameters.length; i++) {
            if generic_type_parameter(c.generics, work.definition, i) { continue; }
            var type = sem_type(c, sem_member(parameters.data[i], "type"));
            if !sem_ok(c) { return false; }
            if !semantic_integer(type) {
                work.definition = null;
                work.phase = SemanticConstructorPhase.Execute;
                break;
            }
        }
        result.calls_scanned = false;
        result.call_index = 0;
        result.type_frontier = 0;
        result.calls.length = 0;
        return true;
    }
    if work.phase == SemanticConstructorPhase.Call {
        if work.definition == null && sem_type_identity_call(c, result.subject) {
            work.type = *sem_type_call(c, result.subject);
            result.checked = sem_ok(c);
            if result.checked { work.phase = SemanticConstructorPhase.Ready; }
            return false;
        }
        var primitive = sem_type_primitive(c, result.subject, sem_identifier(c, sem_member(result.subject, "name")));
        if !sem_ok(c) { return default; }
        if primitive != null {
            work.type = *primitive;
            work.phase = SemanticConstructorPhase.Ready;
            result.checked = sem_ok(c);
            return false;
        }
        if work.definition == null {
            var name = sem_member(result.subject, "name");
            var spelling = sem_identifier(c, name);
            if !sem_ok(c) { return default; }
            if sem_resolve(c, c.functions, name, spelling) != null || sem_resolve(c, c.templates, name, spelling) != null {
                work.phase = SemanticConstructorPhase.Execute;
                result.calls_scanned = false;
                result.call_index = 0;
                result.type_frontier = 0;
                result.calls.length = 0;
                return true;
            }
        }
        if work.instance == null {
            work.arguments = sem_constructor_arguments(c, result.subject, work.definition);
            if !sem_ok(c) { return false; }
            var resource_error = WorkBudgetError.None;
            work.instance = generic_instantiate_deferred_result(c.generics, work.definition, result.subject,
                work.arguments.data, work.arguments.length, &resource_error);
            if resource_error != WorkBudgetError.None {
                sem_resource_record(c.program, resource_error, sem_offset(c, result.subject));
                return false;
            }
            if !sem_generic_ok(c, result.subject) || work.instance == null { return false; }
            var scratch_entry42 = sem_state(c, c.source_bases, work.instance);
            if scratch_entry42 == null { return default; }
            scratch_entry42.number = sem_source_base(c, work.definition);
        }
        // Structural statement checking can have reached this instance first.
        // Its retained failure predates query registration; discovery must not
        // overwrite it with an empty diagnostic or reuse its partial identity.
        var prior = sem_declaration_state_result(c, work.instance);
        if prior == null { return false; }
        if prior.query == 0 && sem_declaration_restore_error(c, prior) { return false; }
        var instance = sem_constructor_instance(c, result);
        if instance == null { return false; }
        sem_declaration_discover(c);
        if !sem_ok(c) { return false; }
        if instance == null || instance.query == 0 {
            sem_resource_record(c.program, sem_query_error(c), sem_offset(c, result.subject));
            return false;
        }
        if sem_declaration_input(c, result, instance.query)
            || work_task(&c.queries, instance.query).state != WorkState.Succeeded {
            result.waiting = instance.query;
            return false;
        }
        work.type = instance.constructor.type;
        work.phase = SemanticConstructorPhase.Ready;
        result.checked = true;
        return false;
    }
    if work.phase == SemanticConstructorPhase.Clone {
        if generic_body_pending(c.generics, work.instance) {
            var copy = sem_generic_body_request(c, work.instance, 0);
            if !sem_ok(c) { return false; }
            if copy == null || copy.query == 0 {
                sem_resource_record(c.program, sem_query_error(c), sem_offset(c, result.subject));
                return false;
            }
            result.waiting = copy.query;
            return false;
        }
        work.syntax = generic_type_result(c.generics, work.instance);
        if !sem_generic_ok(c, work.instance) || work.syntax == null { return false; }
        var scratch_entry81 = sem_state(c, c.source_bases, work.syntax);
        if scratch_entry81 == null { return default; }
        scratch_entry81.number = sem_source_base(c, work.definition);
        if sem_is(work.syntax, "CoreStruct") {
            sem_type_header(c, work.syntax, sem_instance_name(c, work.definition, work.arguments));
            if !sem_ok(c) { return false; }
            work.type = sem_get(work.syntax).type;
            work.phase = SemanticConstructorPhase.Ready;
            var scratch_entry87 = sem_state(c, c.type_results, work.instance);
            if scratch_entry87 == null { return default; }
            scratch_entry87.value = bits(void*, &work.type);
            if !sem_push_checked(c, &c.generated, work.syntax) { return default; }
            sem_declaration_add(c, work.syntax);
            sem_declaration_discover(c);
            if !sem_ok(c) { return false; }
            if !work_demand(&c.queries, sem_declaration_query(c, work.syntax)) {
                sem_resource_record(c.program, sem_query_error(c), sem_offset(c, result.subject));
                return false;
            }
            result.checked = true;
            return false;
        }
        work.phase = SemanticConstructorPhase.Alias;
        result.calls_scanned = false;
        result.call_index = 0;
        result.type_frontier = 0;
        result.calls.length = 0;
        return true;
    }
    if work.phase == SemanticConstructorPhase.Alias {
        var type = sem_type(c, work.syntax);
        if !sem_ok(c) { return false; }
        work.type = *type;
        result.checked = sem_ok(c);
        return false;
    }
    if work.phase == SemanticConstructorPhase.Execute {
        if work.evaluation == null {
            var previous = c.integer_arguments;
            c.integer_arguments = true;
            defer { c.integer_arguments = previous; }
            sem_executables_begin(c);
            if !sem_ok(c) { return false; }
            sem_captures_begin(c);
            if !sem_ok(c) { return false; }
            var value = sem_operand(c, result.subject, sem_type_new(c, SType, 0, null));
            if !sem_ok(c) { return false; }
            var output = sem_evaluation_node(c, result.subject);
            if output == null { return false; }
            var expression = sem_defer_clone(c, output, value, sem_table(c), sem_list(c));
            if !sem_ok(c) { return default; }
            sem_evaluation_expression(c, output, expression, null, false);
            if !sem_ok(c) { return false; }
            work.evaluation = sem_evaluation_get(c, output);
            if work.evaluation == null { sem_type_resource(c, result.subject, WorkBudgetError.Invalid); return false; }
            sem_evaluation_work_register(c, false);
            if !sem_ok(c) { return false; }
        }
        var query = work_find(&c.queries, work.evaluation.subject, EvaluationQuery, 0);
        if query == 0 {
            sem_resource_record(c.program, sem_query_error(c), sem_offset(c, result.subject));
            return false;
        }
        if sem_declaration_input(c, result, query) || work_task(&c.queries, query).state != WorkState.Succeeded {
            result.waiting = query;
            return false;
        }
        work.type = sem_get(work.evaluation.literal).element;
        work.phase = SemanticConstructorPhase.Ready;
        result.checked = true;
        return false;
    }
    result.checked = true;
    return false;
}

fn sem_constructor_publish(c: SemanticContext*, result: SemanticDeclaration*): void {
    var work = result.constructor;
    if !sem_ok(c) || !result.checked || work == null { return; }
    work.phase = SemanticConstructorPhase.Ready;
    if work.instance == result.subject {
        var scratch_entry5 = sem_state(c, c.type_results, work.instance);
        if scratch_entry5 == null { return; }
        scratch_entry5.value = bits(void*, &work.type);
    }
    sem_type_use(c, result.subject, &work.type);
}
