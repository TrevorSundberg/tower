import tower;
import compiler_kernel;
import foundation_types;
import interpreter_context_types;
import semantic_context_types;
import .library.vector;
import .library.work_graph;

struct SemanticEvaluationLeaf {
    subject: void*;
    field: void*;
    parent: usize;
    index: usize;
    type: FoundationType;
    byte_offset: usize;
}

struct SemanticEvaluation {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    subject: void*;
    owner: void*;
    literal: void*;
    expression: void*;
    function: void*;
    ready: IMDependency*;
    invocation: IMInvocation;
    requested: bool;
    started: bool;
    inferred: bool;
    type_argument: bool;
    capture_order: bool;
    capture_ordinal: usize;
    error: vector(u8);
    error_offset: usize;
    aliases: vector(SemanticEvaluationAlias);
    leaves: vector(SemanticEvaluationLeaf);
    aggregate_type: FoundationType;
    aggregate: bool;
}
