import tower;
import semantic_context;
import semantic_support;
import semantic_types;
import semantic_values;
import semantic_expressions;
import semantic_control;
import semantic_expression_lowering;
import semantic_evaluation_work;
import semantic_defer;
import compiler_kernel;
import semantic_work_ids;
import foundation_tags;
import foundation_types;
import interpreter_context_types;
import .library.vector;
import .library.work_graph;
import .library.work_pool;

extern fn interpreter_invocation_init(invocation: IMInvocation*, function: void*, width: usize, arguments: u64*, count: usize, strict: bool, fuel: u64): bool;
extern fn interpreter_invocation_dispose(invocation: IMInvocation*): void;
extern fn entity_view_open(anchor: void*): void*;
extern fn entity_view_close(view: void*): void;

var EvaluationQuery: u32 = 2;
var EvaluationFuel: u64 = 1000000;

struct SemanticEvaluation {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    subject: void*;
    owner: void*;
    literal: void*;
    expression: void*;
    function: void*;
    ready: IMDependency*;
    invocation: IMInvocation;
    requested: bool;
    started: bool;
    inferred: bool;
    unavailable: bool;
    capture_checked: bool;
    aliases: vector(void*);
}

fn sem_evaluation_dependency(c: SemanticContext*, node: void*): IMDependency* {
    if c.evaluation_ready == null { return null; }
    var dependency = bits(IMDependency*, entity_component_data(entity_component_get(node, c.evaluation_ready)));
    if dependency != null && dependency.source != null { return dependency.source; }
    return dependency;
}

// Deferred cleanup clones canonical operations before stages run. Keep their
// literal results linked to the original producer instead of copying its zero
// placeholder as if it were a completed compile-time value.
fn sem_evaluation_clone(c: SemanticContext*, original: void*, clone: void*): void {
    var dependency = sem_evaluation_dependency(c, original);
    if dependency == null { return; }
    var result = sem_evaluation_get(c, dependency.subject);
    sem_require(result != null);
    if c.evaluation_aliases != null {
        var alias: SemanticEvaluationAlias = default;
        alias.producer = dependency.subject;
        alias.clone = clone;
        sem_require(vector_push(c.evaluation_aliases, alias));
    } else { sem_push(&result.aliases, clone); }
    var link = bits(IMDependency*, entity_component_data(entity_component_add(clone, c.evaluation_ready)));
    sem_require(link != null);
    fill(link, 0, sizeof(IMDependency));
    link.subject = clone;
    link.source = dependency;
}

// Workers never append to another producer's alias vector. Publish these links
// only after every stage in the wave has released its component leases.
fn sem_evaluation_aliases(c: SemanticContext*, aliases: vector(SemanticEvaluationAlias)*): void {
    foreach(var &alias in aliases) {
        var result = sem_evaluation_get(c, alias.producer);
        sem_require(result != null);
        sem_push(&result.aliases, alias.clone);
    }
    aliases.length = 0;
}

fn sem_evaluation_get(c: SemanticContext*, subject: void*): SemanticEvaluation* {
    if c.evaluation_results == null { return null; }
    var component = entity_component_get(subject, c.evaluation_results);
    return bits(SemanticEvaluation*, entity_component_data(component));
}

fn sem_evaluation_begin(c: SemanticContext*): void {
    if c.evaluation_results != null { return; }
    c.evaluation_results = sem_create(c.program.root);
    sem_require(entity_register(c.evaluation_results, sizeof(SemanticEvaluation), alignof(SemanticEvaluation), 0));
    c.evaluation_ready = sem_create(c.program.root);
    sem_require(entity_register(c.evaluation_ready, sizeof(IMDependency), alignof(IMDependency), 0));
}

fn sem_evaluation_request(c: SemanticContext*, result: SemanticEvaluation*): void {
    var id = work_request(&c.queries, result.subject, EvaluationQuery, 0);
    sem_require(id != 0);
    var preparation = work_request(&c.queries, result.subject, EvaluationPrepareQuery, 0);
    sem_require(preparation != 0 && work_depend(&c.queries, id, preparation));
    var body = work_find(&c.queries, result.owner, convert(u32, SemanticQuery.Body), 0);
    if body != 0 { sem_require(work_depend(&c.queries, preparation, body)); }
    if result.inferred {
        var proof = work_find(&c.queries, c.program.root, convert(u32, SemanticQuery.KnownProof), 0);
        var clone = work_request(&c.queries, result.subject, convert(u32, SemanticQuery.KnownClone), 0);
        sem_require(proof != 0 && clone != 0 && work_depend(&c.queries, clone, proof));
        sem_require(work_depend(&c.queries, preparation, clone));
    }
    sem_require(work_access(&c.queries, id, 1, 2, id, 1, WorkAccessMode.Write));
    sem_require(work_access(&c.queries, id, 1, 3, 0, ~convert(usize, 0), WorkAccessMode.Read));
    sem_require(work_seal(&c.queries, id));
}

fn sem_comptime(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    var existing = sem_get(n);
    if existing != null { return sem_surface_expected(c, n, expected_type); }
    c.evaluation_depth++;
    var expression = sem_operand(c, sem_member(n, "value"), expected_type);
    c.evaluation_depth--;
    if !sem_ok(c) || expression == null { return n; }
    var input = sem_get(expression);
    var value = sem_node(c, n, KOperand);
    sem_set_type(&value.type, &input.type);
    value.constant = true;
    // This typed placeholder cannot leave compilation. The query result replaces
    // it before any formatter, runtime or backend can consume the checked graph.
    value.bits = 0;
    var literal = n;
    if input.type.pointers == 0 && semantic_enum(&input.type) {
        var underlying = sem_type_copy(c, &input.type);
        underlying.record = null;
        literal = sem_surface_constant(c, n, underlying, 0);
        value.kind = KConvert;
        value.constant = false;
        value.value = literal;
    }
    if c.unevaluated { return n; }
    if input.type.pointers != 0 || semantic_aggregate(&input.type) || input.type.scalar == SVoid {
        sem_fail(c, n, "Compile-time results currently require an integer or bool value");
        return n;
    }
    sem_evaluation_begin(c);
    var result = bits(SemanticEvaluation*, entity_component_data(entity_component_add(n, c.evaluation_results)));
    sem_require(result != null);
    fill(result, 0, sizeof(SemanticEvaluation));
    result.subject = n;
    result.owner = c.current;
    result.literal = literal;
    result.expression = expression;
    result.requested = c.evaluation_depth == 0;
    result.ready = bits(IMDependency*, entity_component_data(entity_component_add(n, c.evaluation_ready)));
    sem_require(result.ready != null);
    fill(result.ready, 0, sizeof(IMDependency));
    result.ready.subject = n;
    if literal != n {
        // Lowering may materialize the typed integer before its enum conversion.
        // That initializer must suspend too, before it can capture a stale zero.
        var link = bits(IMDependency*, entity_component_data(entity_component_add(literal, c.evaluation_ready)));
        sem_require(link != null);
        *link = default;
        link.subject = literal;
        link.source = result.ready;
    }
    result.kernel.kind = CompilerKernelKind.Evaluate;
    result.kernel.payload = bits(void*, &result.invocation);
    sem_require(vector_push(void*, &c.evaluation_jobs, bits(void*, result)));
    // Interpreter state is private to this subject; shared input entities are
    // immutable for a dispatch wave and publication happens after all joins.
    // Body workers attach canonical result components under their entity lease;
    // the coordinator registers dependencies after publication at the barrier.
    if c.entity_stage == null { sem_evaluation_request(c, result); }
    return n;
}

fn sem_evaluation_available(c: SemanticContext*, result: SemanticEvaluation*): bool {
    if result.unavailable { return false; }
    if result.capture_checked { return true; }
    // A stage expression has explicit arguments. Borrowing an ordinary local's
    // byte offset would accidentally read unrelated helper-frame storage.
    var scan = sem_list(c);
    sem_push(scan, result.expression);
    while scan.length != 0 && sem_ok(c) {
        scan.length--;
        var entity = scan.data[scan.length];
        var value = sem_get(entity);
        if value == null { continue; }
        if value.kind == KOperand && value.binding != null && !value.constant {
            var input = c.value_inputs == null ? null : entity_component_get(value.binding, c.value_inputs);
            if input == null {
                if result.inferred { result.unavailable = true; }
                else { sem_fail(c, entity, "Compile-time expression cannot capture runtime storage; pass explicit compile-time arguments"); }
                return false;
            }
        }
        if value.left != null { sem_push(scan, value.left); }
        if value.right != null { sem_push(scan, value.right); }
        if value.value != null { sem_push(scan, value.value); }
        if value.target != null { sem_push(scan, value.target); }
        if value.kind == KCall || value.kind == SurfaceInitializer {
            var index: usize = 0;
            while index < value.items.length {
                sem_push(scan, value.items.data[index]);
                index++;
            }
        }
    }
    result.capture_checked = sem_ok(c);
    return result.capture_checked;
}

fn sem_evaluation_function(c: SemanticContext*, result: SemanticEvaluation*): void* {
    if result.function == null {
        result.function = sem_control_node(c, result.subject, KFunction);
        sem_set_type(&sem_get(result.function).type, &sem_get(result.subject).type);
    }
    return result.function;
}

fn sem_evaluation_clone_expression(c: SemanticContext*, result: SemanticEvaluation*): void {
    // All value-input metadata is published before this read-only availability
    // check. It computes no values; the ordinary interpreter still evaluates
    // every eligible expression and dynamically suspends on its actual inputs.
    if !sem_evaluation_available(c, result) { return; }
    var function = sem_evaluation_function(c, result);
    var previous = c.current;
    c.current = function;
    var clones = sem_table(c);
    var nodes = sem_list(c);
    result.expression = sem_defer_clone(c, function, result.expression, clones, nodes);
    foreach(var node in nodes) {
        var value = sem_get(node);
        if value.binding != null {
            var local = sem_find(clones, null, value.binding);
            if local != null { value.binding = local.value; }
        }
    }
    c.current = previous;
}

fn sem_evaluation_prepare(c: SemanticContext*, result: SemanticEvaluation*): void {
    if !sem_evaluation_available(c, result) { return; }
    var function = sem_evaluation_function(c, result);
    var definition = sem_get(function);
    definition.body = sem_control_node(c, function, KBlock);
    var returned = sem_control_node(c, definition.body, KReturn);
    sem_get(returned).value = result.expression;
    sem_push(&sem_get(definition.body).items, returned);
    var previous = c.current;
    c.current = function;
    sem_lift_block(c, definition.body);
    c.current = previous;
}

fn sem_evaluation_cycle(c: SemanticContext*, id: usize): void {
    var cycle: vector(usize);
    vector_init(usize, &cycle);
    var found = work_cycle(&c.queries, id, &cycle);
    sem_require(found);
    var text: u8* = "Compile-time dependency cycle";
    var index: usize = 0;
    while index < cycle.length {
        var task = work_task(&c.queries, cycle.data[index]);
        text = sem_cat(c, text, index == 0 ? ": " : " -> ");
        text = sem_cat(c, text, sem_decimal(c, convert(u64, sem_get(task.subject).start)));
        index++;
    }
    vector_dispose(usize, &cycle);
    sem_fail(c, work_task(&c.queries, id).subject, text);
}

fn sem_evaluations(c: SemanticContext*): void {
    if !sem_ok(c) || c.evaluation_jobs.length == 0 { return; }
    sem_evaluation_prepare_all(c);
    if !sem_ok(c) { return; }
    var index: usize = 0;
    while index < c.evaluation_jobs.length && sem_ok(c) {
        var result = bits(SemanticEvaluation*, c.evaluation_jobs.data[index]);
        if result.requested {
            sem_require(work_demand(&c.queries, work_request(&c.queries, result.subject, EvaluationQuery, 0)));
        }
        index++;
    }
    if !sem_ok(c) { return; }
    if c.workers.count == 0 { sem_require(sem_workers_open(c)); }
    var view = entity_view_open(c.program.root);
    sem_require(view != null);
    var batch: SemanticEvaluation*[256];
    loop {
        var count: usize = 0;
        var ticket: WorkTicket;
        while count < c.workers.count && work_take_query(&c.queries, &ticket, EvaluationQuery) {
            var task = work_task(&c.queries, ticket.task);
            sem_require(task.query == EvaluationQuery);
            var result = sem_evaluation_get(c, task.subject);
            sem_require(result != null);
            result.ticket = ticket;
            if result.unavailable {
                result.ready.failed = true;
                result.ready.ready = true;
                sem_require(work_finish(&c.queries, &result.ticket, true));
                continue;
            }
            if !result.started {
                interpreter_invocation_init(&result.invocation, result.function, convert(usize, c.program.pointer_bytes), null, 0, true, EvaluationFuel);
                result.invocation.context.dependency_kind = c.evaluation_ready;
                result.invocation.context.value_inputs = c.value_inputs;
                result.invocation.context.require_relocatable = result.inferred;
                result.started = true;
            }
            batch[count] = result;
            sem_require(work_pool_submit(&c.workers, bits(void*, &result.kernel)));
            count++;
        }
        if count == 0 { break; }
        index = 0;
        while index < count {
            sem_require(work_pool_receive(&c.workers, true) != null);
            index++;
        }
        index = 0;
        while index < count {
            var result = batch[index];
            var invocation = &result.invocation;
            if invocation.state.failed {
                result.ready.failed = true;
                result.ready.ready = true;
                if !result.inferred { sem_fail(c, result.subject, invocation.context.error.data); }
                sem_require(work_finish(&c.queries, &result.ticket, result.inferred));
                interpreter_invocation_dispose(invocation);
            } else {
                if invocation.state.done {
                    sem_get(result.subject).bits = invocation.context.result;
                    sem_get(result.literal).bits = invocation.context.result;
                    for(var alias: usize = 0; alias < result.aliases.length; alias++) {
                        sem_get(result.aliases.data[alias]).bits = invocation.context.result;
                    }
                    result.ready.ready = true;
                    sem_require(work_finish(&c.queries, &result.ticket, true));
                    interpreter_invocation_dispose(invocation);
                } else {
                    var waiting = invocation.context.waiting;
                    if waiting != null {
                        var dependency = work_request(&c.queries, waiting, EvaluationQuery, 0);
                        sem_require(work_suspend(&c.queries, &result.ticket, dependency));
                    } else {
                        sem_require(work_yield(&c.queries, &result.ticket));
                    }
                }
            }
            index++;
        }
        if !sem_ok(c) { break; }
    }
    entity_view_close(view);
    index = 0;
    while index < c.queries.tasks.length && sem_ok(c) {
        var task = work_task(&c.queries, index + 1);
        if task.query == EvaluationQuery && task.demanded && task.state != WorkState.Succeeded {
            var result = sem_evaluation_get(c, task.subject);
            if result != null && result.inferred {
                result.ready.failed = true;
                result.ready.ready = true;
            } else { sem_evaluation_cycle(c, index + 1); }
        }
        index++;
    }
}

fn sem_evaluation_dispose(c: SemanticContext*): void {
    var index: usize = 0;
    while index < c.evaluation_jobs.length {
        var result = bits(SemanticEvaluation*, c.evaluation_jobs.data[index]);
        interpreter_invocation_dispose(&result.invocation);
        vector_dispose(void*, &result.aliases);
        index++;
    }
    vector_dispose(void*, &c.evaluation_jobs);
}
