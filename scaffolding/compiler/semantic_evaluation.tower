extern fn interpreter_invocation_init(invocation: IMInvocation*, function: void*, width: usize, arguments: u64*, count: usize, strict: bool, fuel: u64): bool;
extern fn interpreter_invocation_dispose(invocation: IMInvocation*): void;
extern fn interpreter_function_result(invocation: IMInvocation*, reference: u64, type: FoundationType*, offset: usize): void*;
extern fn interpreter_type_result(invocation: IMInvocation*, reference: u64, type: FoundationType*, offset: usize): bool;
extern fn entity_view_open(anchor: void*): void*;
extern fn entity_view_close(view: void*): void;

var EvaluationQuery: u32 = convert(u32, SemanticQuery.Evaluation);
var EvaluationFuel: u64 = 1000000;
var EvaluationResourceDiagnosticBytes: usize = 128;


fn sem_evaluation_dependency(c: SemanticContext*, node: void*): IMDependency* {
    if c.evaluation_ready == null { return null; }
    var dependency = bits(IMDependency*, entity_component_data(entity_component_get(node, c.evaluation_ready)));
    if dependency != null && dependency.source != null { return dependency.source; }
    return dependency;
}

// Deferred cleanup clones canonical operations before stages run. Keep their
// literal results linked to the original producer instead of copying its zero
// placeholder as if it were a completed compile-time value.
fn sem_evaluation_clone(c: SemanticContext*, original: void*, clone: void*): void {
    if !sem_ok(c) { return; }
    var dependency = sem_evaluation_dependency(c, original);
    if dependency == null { return; }
    var result = sem_evaluation_get(c, dependency.subject);
    if result == null { sem_scratch_error(c, original, WorkBudgetError.Invalid); return; }
    var alias: SemanticEvaluationAlias = default;
    alias.producer = dependency.subject;
    alias.original = original;
    alias.clone = clone;
    var aliases = c.evaluation_aliases == null ? &result.aliases : c.evaluation_aliases;
    if aliases.length == ~convert(usize, 0) || !vector_reserve(aliases, aliases.length + 1) {
        sem_scratch_error(c, original, WorkBudgetError.Memory); return;
    }
    var error: WorkBudgetError;
    var link = bits(IMDependency*, entity_component_data(entity_component_add_result(clone, c.evaluation_ready, &error)));
    if link == null { sem_scratch_error(c, original, error); return; }
    fill(link, 0, sizeof(IMDependency));
    link.subject = clone;
    link.source = dependency;
    aliases.data[aliases.length++] = alias;
}

// Workers never append to another producer's alias vector. Publish these links
// only after every stage in the wave has released its component leases.
fn sem_evaluation_aliases(c: SemanticContext*, aliases: vector(SemanticEvaluationAlias)*): void {
    if !sem_ok(c) { aliases.length = 0; return; }
    foreach(var &alias in aliases) {
        var result = sem_evaluation_get(c, alias.producer);
        if result == null { sem_scratch_error(c, alias.original, WorkBudgetError.Invalid); break; }
        if !vector_push(&result.aliases, *alias) { sem_scratch_error(c, alias.original, WorkBudgetError.Memory); break; }
    }
    aliases.length = 0;
}

export fn sem_evaluation_get(c: SemanticContext*, subject: void*): SemanticEvaluation* {
    if c.evaluation_results == null { return null; }
    var component = entity_component_get(subject, c.evaluation_results);
    var result = bits(SemanticEvaluation*, entity_component_data(component));
    return result != null && result.subject == subject ? result : null;
}

// Retain an early stage failure on its producer, so independent body checking
// can select diagnostics in source order after joining all continuations.
fn sem_evaluation_fail_counted(c: SemanticContext*, result: SemanticEvaluation*, message: u8*, length: usize, offset: usize): void {
    if result.error.length == 0 {
        result.error_offset = offset;
        if length == ~convert(usize, 0) || !vector_reserve(&result.error, length + 1) {
            if result.resource_error == WorkBudgetError.None { result.resource_error = WorkBudgetError.Memory; }
            return;
        }
        copy(result.error.data, message, length);
        result.error.data[length] = 0;
        result.error.length = length;
        result.error_offset = offset;
    }
}

fn sem_evaluation_fail(c: SemanticContext*, result: SemanticEvaluation*, message: u8*, offset: usize): void {
    var length: usize = 0;
    while message[length] != 0 { length++; }
    sem_evaluation_fail_counted(c, result, message, length, offset);
}

fn sem_evaluation_failure(c: SemanticContext*, result: SemanticEvaluation*): bool {
    return result != null && (sem_restore_resource(c, result.resource_error, &result.error, result.error_offset)
        || sem_restore_error(c, &result.error, result.error_offset));
}

// Readiness and worker completion do not define diagnostic order. The owning
// declaration/body publication appends this index in canonical source order.
// An earlier demanded continuation may still discover a failure in a later
// pump, so retain later failures until that earlier producer has terminated.
fn sem_evaluation_select_failure(c: SemanticContext*, query: u32): bool {
    if c.declaration_isolated || sem_phase_lowering_pending(c) { return false; }
    foreach(var job in &c.evaluation_jobs) {
        var result = bits(SemanticEvaluation*, job);
        var id = work_find(&c.queries, result.subject, query, 0);
        if id == 0 { continue; }
        var task = work_task(&c.queries, id);
        if !task.demanded || task.state == WorkState.Succeeded { continue; }
        // A failed executed dependency may own the retained receipt. Follow
        // the existing failed edges, without diagnosing pending work as cyclic.
        return task.state == WorkState.Failed && sem_declaration_failure(c, id);
    }
    return false;
}

// Unsupported optional staging may keep its runtime initializer. Exhausting
// physical storage is a compilation failure, including when its interpreter
// state is disposed before the owning declaration selects a diagnostic.
fn sem_evaluation_failed(c: SemanticContext*, result: SemanticEvaluation*): bool {
    var invocation = &result.invocation;
    if result.resource_error == WorkBudgetError.None {
        result.resource_error = invocation.state.storage_error;
    }
    if result.inferred && result.resource_error == WorkBudgetError.None { return true; }
    if invocation.context.error.length != 0 {
        sem_evaluation_fail_counted(c, result, invocation.context.error.data, invocation.context.error.length, sem_get(result.subject).start);
        return false;
    }
    var message: u8* = null;
    if result.resource_error != WorkBudgetError.None {
        message = "Compile-time evaluation storage reservation failed";
        if result.resource_error == WorkBudgetError.Capacity {
            message = "Compile-time evaluation memory budget exceeded";
        } else {
            if result.resource_error == WorkBudgetError.Memory {
                message = "Cannot allocate compile-time evaluation storage";
            } else {
                if result.resource_error == WorkBudgetError.Invalid {
                    message = "Invalid compile-time evaluation storage request";
                }
            }
        }
    } else {
        if message == null || message[0] == 0 { message = "Compile-time evaluation failed"; }
    }
    sem_evaluation_fail(c, result, message, sem_get(result.subject).start);
    return false;
}

// A joined dependency request may already have failed or cancelled its graph.
// Retire only a still-owned ticket, then drain the private invocation regardless
// of graph state. Remaining joined peers use this same path without publication.
fn sem_evaluation_stop(c: SemanticContext*, result: SemanticEvaluation*): void {
    result.ready.failed = true;
    result.ready.ready = true;
    if c.queries.resource_error != WorkBudgetError.None {
        var message: vector(u8) = default;
        sem_restore_resource(c, c.queries.resource_error, &message, sem_get(result.subject).start);
    }
    if work_ticket_valid(&c.queries, &result.ticket) {
        if !work_finish(&c.queries, &result.ticket, false) {
            var error = sem_query_cancel_failure(c);
            var message: vector(u8) = default;
            sem_restore_resource(c, error, &message, sem_get(result.subject).start);
        }
    }
    if !work_ok(&c.queries) && !c.queries.cancelled { work_cancel(&c.queries); }
    interpreter_invocation_dispose(&result.invocation);
}

export fn sem_evaluation_begin(c: SemanticContext*): void {
    sem_evaluation_begin_at(c, c.program.root);
}

fn sem_evaluation_begin_at(c: SemanticContext*, subject: void*): void {
    if !sem_ok(c) || c.evaluation_results != null { return; }
    var error: WorkBudgetError;
    var results = sem_kind_result(c.program.root, sizeof(SemanticEvaluation), alignof(SemanticEvaluation), &error);
    if results == null { sem_type_resource(c, subject, error); return; }
    var ready = sem_kind_result(c.program.root, sizeof(IMDependency), alignof(IMDependency), &error);
    if ready == null {
        sem_require(entity_attach_result(results, null, null) == WorkBudgetError.None);
        sem_type_resource(c, subject, error);
        return;
    }
    c.evaluation_results = results;
    c.evaluation_ready = ready;
}

// These output nodes are coordinator-owned. Worker stage creation stays with
// its existing ownership protocol; this helper never substitutes a default world.
fn sem_evaluation_node(c: SemanticContext*, parent: void*): void* {
    if !sem_ok(c) { return null; }
    sem_require(c.entity_stage == null);
    var error: WorkBudgetError;
    var node = sem_create_result(parent, &error);
    if node == null { sem_type_resource(c, parent, error); return null; }
    if sem_node_result(c, node, KOperand) == null {
        sem_require(entity_attach_result(node, null, null) == WorkBudgetError.None);
        return null;
    }
    return node;
}

fn sem_evaluation_state(c: SemanticContext*, subject: void*): SemanticEvaluation* {
    sem_evaluation_begin_at(c, subject);
    if !sem_ok(c) { return null; }
    if !vector_reserve(&c.evaluation_jobs, c.evaluation_jobs.length + 1) {
        sem_type_resource(c, subject, WorkBudgetError.Memory); return null;
    }
    var error: WorkBudgetError;
    var result = bits(SemanticEvaluation*, entity_component_data(entity_component_add_result(subject, c.evaluation_results, &error)));
    if result == null { sem_type_resource(c, subject, error); return null; }
    *result = default;
    var ready = bits(IMDependency*, entity_component_data(entity_component_add_result(subject, c.evaluation_ready, &error)));
    if ready == null { sem_type_resource(c, subject, error); return null; }
    *ready = { subject: subject, ..default };
    result.subject = subject;
    result.ready = ready;
    result.kernel.kind = CompilerKernelKind.Evaluate;
    result.kernel.payload = bits(void*, &result.invocation);
    // Own cleanup before aggregate projection or query admission can fail.
    c.evaluation_jobs.data[c.evaluation_jobs.length++] = bits(void*, result);
    return result;
}

export fn sem_evaluation_request(c: SemanticContext*, result: SemanticEvaluation*): void {
    if !sem_ok(c) { return; }
    if result == null || result.subject == null || result.ready == null || result.ready.subject != result.subject {
        sem_type_resource(c, result == null ? c.program.root : result.subject, WorkBudgetError.Invalid); return;
    }
    var id = work_request(&c.queries, result.subject, EvaluationQuery, 0);
    if id == 0 { sem_type_resource(c, result.subject, sem_query_error(c)); return; }
    var preparation = work_request(&c.queries, result.subject, EvaluationPrepareQuery, 0);
    if preparation == 0 || !work_depend(&c.queries, id, preparation) {
        sem_type_resource(c, result.subject, sem_query_error(c)); return;
    }
    if result.inferred {
        var body = work_find(&c.queries, result.owner, convert(u32, SemanticQuery.Body), 0);
        if body != 0 && !work_depend(&c.queries, preparation, body) {
            sem_type_resource(c, result.subject, sem_query_error(c)); return;
        }
        var proof = work_find(&c.queries, c.program.root, convert(u32, SemanticQuery.KnownProof), 0);
        var clone = work_request(&c.queries, result.subject, convert(u32, SemanticQuery.KnownClone), 0);
        if proof == 0 || clone == 0 || !work_depend(&c.queries, clone, proof)
            || !work_depend(&c.queries, preparation, clone) {
            sem_type_resource(c, result.subject, sem_query_error(c)); return;
        }
    }
    // Required and optional stages share lazy executable readiness. This does
    // not grant optional inference capture/type/effect capabilities: those stay
    // on its invocation policy and its separate known-value producer links.
    sem_executables_begin(c);
    if !sem_ok(c) { return; }
    if !result.inferred {
        // Required expressions are checked and published before registration.
        // Their lexical owner remains provenance, not a whole-body barrier:
        // a later declaration may need this earlier prefix's staged value.
        // Executed reads request existing capture/function producers instead.
        sem_captures_begin(c);
        if !sem_ok(c) { return; }
    }
    var domain = convert(u64, SemanticWorkDomain.Compiler);
    if !work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Evaluation), id, 1, WorkAccessMode.Write)
        || !work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Expression), 0, ~convert(usize, 0), WorkAccessMode.Read)
        || !work_seal(&c.queries, id) { sem_type_resource(c, result.subject, sem_query_error(c)); }
}

fn sem_comptime(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    var existing = sem_get(n);
    if existing != null { return sem_surface_expected(c, n, expected_type); }
    c.evaluation_depth++;
    var expression = sem_operand(c, sem_member(n, "value"), expected_type);
    c.evaluation_depth--;
    if !sem_ok(c) || expression == null { return n; }
    return sem_evaluation_expression(c, n, expression, c.integer_arguments ? null : c.current,
        !c.integer_arguments && c.evaluation_depth == 0);
}

// Explicit stages and required integer arguments share execution and result
// materialization. Callers own readiness; a type argument has no runtime frame.
export fn sem_evaluation_expression(c: SemanticContext*, n: void*, expression: void*, owner: void*, requested: bool): void* {
    if c.program.resource.error != WorkBudgetError.None { return null; }
    var result = sem_evaluation_expression_impl(c, n, expression, owner, requested);
    return c.program.resource.error == WorkBudgetError.None ? result : null;
}

fn sem_evaluation_expression_impl(c: SemanticContext*, n: void*, expression: void*, owner: void*, requested: bool): void* {
    if !sem_ok(c) { return n; }
    var input = sem_get(expression);
    if input == null { sem_type_resource(c, n, WorkBudgetError.Invalid); return n; }
    var value = sem_node_result(c, n, KOperand);
    if value == null { return n; }
    sem_set_type(&value.type, &input.type);
    value.constant = true;
    // This typed placeholder cannot leave compilation. The query result replaces
    // it before any formatter, runtime or backend can consume the checked graph.
    value.bits = 0;
    var literal = n;
    if input.type.pointers == 0 && semantic_enum(&input.type) {
        var underlying = sem_type_copy(c, &input.type);
        if !sem_ok(c) { return default; }
        underlying.record = null;
        literal = sem_surface_constant(c, n, underlying, 0);
        if literal == null { return default; }
        value.kind = KConvert;
        value.constant = false;
        value.value = literal;
    }
    if c.unevaluated { return n; }
    if input.type.pointers != 0 || input.type.scalar == SVoid {
        sem_fail(c, n, "Compile-time results require a relocatable value, not a raw pointer or void");
        return n;
    }
    var result = sem_evaluation_state(c, n);
    if result == null { return n; }
    result.owner = owner;
    result.literal = literal;
    result.expression = expression;
    result.requested = requested;
    result.type_argument = c.integer_arguments;
    result.aggregate = semantic_aggregate(&input.type);
    if result.aggregate {
        result.aggregate_type = input.type;
        sem_evaluation_aggregate(c, result, n, &input.type, EvaluationRootProjection);
        if !sem_ok(c) { return n; }
    }
    if literal != n {
        // Lowering may materialize the typed integer before its enum conversion.
        // That initializer must suspend too, before it can capture a stale zero.
        var error: WorkBudgetError;
        var link = bits(IMDependency*, entity_component_data(entity_component_add_result(literal, c.evaluation_ready, &error)));
        if link == null { sem_type_resource(c, n, error); return n; }
        *link = default;
        link.subject = literal;
        link.source = result.ready;
    }
    // Interpreter state is private to this subject; shared input entities are
    // immutable for a dispatch wave and publication happens after all joins.
    // Body workers attach canonical result components under their entity lease;
    // the coordinator registers dependencies after publication at the barrier.
    if c.entity_stage == null { sem_evaluation_request(c, result); }
    return n;
}

fn sem_evaluation_function(c: SemanticContext*, result: SemanticEvaluation*): void* {
    if !sem_ok(c) { return null; }
    if result.function == null {
        result.function = sem_control_node(c, result.subject, KFunction);
        if result.function == null { return default; }
        sem_set_type(&sem_get(result.function).type, &sem_get(result.subject).type);
        if result.aggregate {
            sem_get(result.function).type = result.aggregate_type;
            sem_get(result.function).type.pointers++;
        }
    }
    return result.function;
}

fn sem_evaluation_clone_expression(c: SemanticContext*, result: SemanticEvaluation*): void {
    // Capture validity follows executed interpreter reads, after ordinary
    // lowering has preserved lazy branches. This clone computes no values.
    var function = sem_evaluation_function(c, result);
    if function == null { return; }
    var previous = c.current;
    c.current = function;
    defer { c.current = previous; }
    var clones = sem_table(c);
    if !sem_ok(c) { return; }
    var nodes = sem_list(c);
    if !sem_ok(c) { return; }
    var expression = sem_defer_clone(c, function, result.expression, clones, nodes);
    if expression == null { return; }
    foreach(var node in nodes) {
        var value = sem_get(node);
        if value.binding != null {
            var local = sem_find(clones, null, value.binding);
            if local != null { value.binding = local.value; }
        }
    }
    result.expression = expression;
}

fn sem_evaluation_prepare(c: SemanticContext*, result: SemanticEvaluation*): void {
    if !sem_ok(c) { return; }
    if result.expression == null {
        sem_require(result.function != null && sem_get(result.function).body != null);
        return;
    }
    if result.aggregate { sem_evaluation_aggregate_prepare(c, result); return; }
    var function = sem_evaluation_function(c, result);
    if function == null { return; }
    var definition = sem_get(function);
    definition.body = sem_control_node(c, function, KBlock);
    if definition.body == null { return; }
    var returned = sem_control_node(c, definition.body, KReturn);
    if returned == null { return; }
    sem_get(returned).value = result.expression;
    if !sem_push_checked(c, &sem_get(definition.body).items, returned) { return; }
    var previous = c.current;
    c.current = function;
    sem_lift_block(c, definition.body);
    c.current = previous;
}

// The preparation worker owns its executable function and invocation storage.
// Initialize the ordinary interpreter there; dispatch only resumes that state.
export fn sem_evaluation_start(c: SemanticContext*, result: SemanticEvaluation*, require_relocatable: bool): void {
    sem_require(!result.started);
    interpreter_invocation_init(&result.invocation, result.function, convert(usize, c.program.pointer_bytes), null, 0, true, EvaluationFuel);
    result.invocation.context.dependency_kind = c.evaluation_ready;
    result.invocation.context.value_inputs = c.value_inputs;
    result.invocation.context.require_relocatable = require_relocatable;
    result.invocation.context.type_arguments = !result.inferred;
    result.invocation.context.capture_order = result.capture_order;
    result.invocation.context.capture_ordinal = result.capture_ordinal;
    result.invocation.context.executable_functions = c.executable_ready;
    result.invocation.context.retain_result_storage = result.aggregate;
    // Required stages (explicit comptime, type arguments and their captures)
    // have compiler capability. Optional known-value inference must retain a
    // reached runtime constructor's failure instead of erasing it as a constant.
    result.invocation.context.construct_types = !result.inferred;
    result.invocation.context.type_construction.owner = result.subject;
    result.started = true;
}

fn sem_evaluation_cycle(c: SemanticContext*, id: usize): void {
    var cycle: vector(usize);
    vector_init(usize, &cycle);
    defer vector_dispose(&cycle);
    var found = work_cycle(&c.queries, id, &cycle);
    if !found {
        sem_fail(c, work_task(&c.queries, id).subject, "Compile-time dependency is waiting for an unfinished compiler query");
        return;
    }
    var text: u8* = "Compile-time dependency cycle";
    var index: usize = 0;
    while index < cycle.length {
        var task = work_task(&c.queries, cycle.data[index]);
        text = sem_cat(c, text, index == 0 ? ": " : " -> ");
        if !sem_ok(c) { return; }
        text = sem_cat(c, text, sem_decimal(c, convert(u64, sem_get(task.subject).start)));
        if !sem_ok(c) { return; }
        index++;
    }
    sem_fail(c, work_task(&c.queries, id).subject, text);
}

export fn sem_evaluations(c: SemanticContext*): void {
    loop {
        var evaluation = sem_evaluation_pump(c);
        if evaluation == SemanticPumpResult.Failed { break; }
        var producers = sem_query_pipeline_pump(c);
        if producers == SemanticPumpResult.Failed { break; }
        if evaluation != SemanticPumpResult.Progress && producers != SemanticPumpResult.Progress { break; }
    }
    sem_evaluation_finish(c);
}

// One bounded interpreter frontier. Keep final cycle/error selection separate
// so a pipeline coordinator can service a waiting type/body/lowering phase.
export fn sem_evaluation_pump(c: SemanticContext*): SemanticPumpResult {
    return sem_evaluation_pump_inputs(c, true);
}

// Early type consumers demand their own stages. Preserve unrelated explicit
// roots until their ordinary body/proof/lowering prerequisites have published.
fn sem_evaluation_pump_inputs(c: SemanticContext*, demand_roots: bool): SemanticPumpResult {
    if !sem_ok(c) || !work_ok(&c.queries) { return SemanticPumpResult.Failed; }
    if c.evaluation_jobs.length == 0 { return SemanticPumpResult.Complete; }
    // Early local captures may be registered while a declaration owns a query
    // ticket. Their clone wave becomes runnable after that producer suspends.
    // Cloning is part of this evaluation owner's frontier. A later clone error
    // must wait for an earlier demanded evaluation, even if its clone is done.
    sem_evaluation_work_all(c, true);
    sem_evaluation_work_register(c, false);
    if !sem_ok(c) { return SemanticPumpResult.Failed; }
    var index: usize = 0;
    while index < c.evaluation_jobs.length && sem_ok(c) {
        var result = bits(SemanticEvaluation*, c.evaluation_jobs.data[index]);
        if demand_roots && result.requested {
            var query = work_find(&c.queries, result.subject, EvaluationQuery, 0);
            if query == 0 || !work_demand(&c.queries, query) {
                sem_type_resource(c, result.subject, sem_query_error(c)); return SemanticPumpResult.Failed;
            }
        }
        index++;
    }
    if !sem_ok(c) { return SemanticPumpResult.Failed; }
    if c.workers.count == 0 && !sem_workers_open(c) { return SemanticPumpResult.Failed; }
    var batch: vector(SemanticEvaluation*) = default;
    defer vector_dispose(&batch);
    sem_require(vector_reserve(&batch, SemanticPreparationWindow));
    {
        // A suspended interpreter can demand another stage. Prepare only that
        // ready frontier before opening the next immutable execution view.
        sem_evaluation_prepare_all(c);
        if !sem_ok(c) || sem_evaluation_select_failure(c, EvaluationQuery) { return SemanticPumpResult.Failed; }
        var view = entity_view_open(c.program.root);
        sem_require(view != null);
        var count: usize = 0;
        var ticket: WorkTicket;
        while count < SemanticPreparationWindow && work_take_query(&c.queries, &ticket, EvaluationQuery) {
            var task = work_task(&c.queries, ticket.task);
            sem_require(task.query == EvaluationQuery);
            var result = sem_evaluation_get(c, task.subject);
            sem_require(result != null);
            result.ticket = ticket;
            if !sem_phase_evaluation_admit(c, result, &result.ticket) { continue; }
            batch.data[count++] = result;
        }
        if !sem_ok(c) || !work_ok(&c.queries) {
            entity_view_close(view);
            for(var i: usize = 0; i < count; i++) { sem_evaluation_stop(c, batch.data[i]); }
            return SemanticPumpResult.Failed;
        }
        if count == 0 {
            entity_view_close(view);
            return sem_query_pending(c, EvaluationQuery) ? SemanticPumpResult.Waiting : SemanticPumpResult.Complete;
        }
        // Reserve a bounded ready frontier, then refill each completed slot.
        // No results become visible until all readers in this window join.
        for(var i: usize = 0; i < count; i++) { sem_require(batch.data[i].started); }
        var receipt: WorkReservation;
        var extra = sem_workers_admit(c, count, &receipt);
        defer sem_workers_release(c, &receipt);
        sem_require(compiler_kernel_dispatch_admitted(&c.workers, batch.data, count, extra));
        entity_view_close(view);
        index = 0;
        while index < count {
            var result = batch.data[index];
            var invocation = &result.invocation;
            if !sem_ok(c) || !work_ok(&c.queries) {
                sem_evaluation_stop(c, result);
                index++;
                continue;
            }
            if invocation.state.failed || invocation.state.storage_error != WorkBudgetError.None {
                result.ready.failed = true;
                result.ready.ready = true;
                var optional = sem_evaluation_failed(c, result);
                sem_require(work_finish(&c.queries, &result.ticket, optional));
                interpreter_invocation_dispose(invocation);
            } else {
                if invocation.state.done {
                    if result.aggregate { sem_evaluation_aggregate_publish(c, result); }
                    else {
                        sem_evaluation_value(result.subject, invocation, invocation.context.result);
                        sem_evaluation_value(result.literal, invocation, invocation.context.result);
                    }
                    var success = true;
                    if invocation.state.failed || invocation.state.storage_error != WorkBudgetError.None {
                        success = sem_evaluation_failed(c, result);
                    }
                    foreach(var &alias in &result.aliases) {
                        if invocation.state.failed || !success { break; }
                        var original = sem_get(alias.original);
                        if original.constant || original.kind == KFunctionReference || original.kind == KTypeReference {
                            var target = sem_get(alias.clone);
                            target.bits = original.bits;
                            target.binding = original.binding;
                            target.element = original.element;
                            target.kind = original.kind;
                            target.constant = original.constant;
                        }
                    }
                    result.ready.failed = invocation.state.failed || !success || !sem_ok(c);
                    result.ready.ready = true;
                    sem_require(work_finish(&c.queries, &result.ticket, sem_ok(c) && success));
                    interpreter_invocation_dispose(invocation);
                } else {
                    var waiting = invocation.context.waiting;
                    if invocation.context.waiting_type {
                        var dependency = sem_type_execution_request(c, result.subject,
                            &invocation.context.type_construction, &result.ticket);
                        if dependency == 0 {
                            sem_evaluation_stop(c, result);
                        } else { sem_require(work_suspend(&c.queries, &result.ticket, dependency)); }
                    } else {
                        if waiting != null {
                            var dependency = invocation.context.waiting_function ? sem_executable_request(c, waiting)
                                : invocation.context.waiting_binding ? sem_capture_request(c, waiting)
                                : work_request(&c.queries, waiting, EvaluationQuery, 0);
                            if dependency == 0 { sem_evaluation_stop(c, result); }
                            else { sem_require(work_suspend(&c.queries, &result.ticket, dependency)); }
                        } else { sem_require(work_yield(&c.queries, &result.ticket)); }
                    }
                }
            }
            index++;
        }
    }
    return sem_ok(c) && work_ok(&c.queries) && !sem_evaluation_select_failure(c, EvaluationQuery)
        ? SemanticPumpResult.Progress : SemanticPumpResult.Failed;
}

// Call only after the owning pipeline can no longer satisfy a waiting producer.
// Ordinary phase pumping never declares its unfinished dependencies cyclic.
fn sem_evaluation_finish(c: SemanticContext*): void {
    foreach(var job in &c.evaluation_jobs) {
        if !sem_ok(c) { break; }
        var result = bits(SemanticEvaluation*, job);
        var id = work_find(&c.queries, result.subject, EvaluationQuery, 0);
        if id == 0 { continue; }
        var task = work_task(&c.queries, id);
        if task.demanded && task.state != WorkState.Succeeded {
            if sem_declaration_failure(c, id) { break; }
            if result != null && result.inferred && result.resource_error == WorkBudgetError.None {
                result.ready.failed = true;
                result.ready.ready = true;
            } else {
                sem_evaluation_cycle(c, id);
            }
        }
    }
}

// Function results relocate through their bound Foundation declaration. The
// interpreter's private numeric reference never becomes a serialized constant.
fn sem_evaluation_value(node: void*, invocation: IMInvocation*, bits_value: u64): void {
    if invocation.state.failed { return; }
    var value = sem_get(node);
    value.bits = bits_value;
    if value.type.scalar == SType && value.type.pointers == 0 {
        if !interpreter_type_result(invocation, bits_value, &value.element, value.start) { return; }
        value.kind = KTypeReference;
        value.constant = false;
        value.bits = 0;
    }
    if value.type.scalar == SFunction && value.type.pointers == 0 && value.bits != 0 {
        value.binding = interpreter_function_result(invocation, value.bits, &value.type, value.start);
        if invocation.state.failed { return; }
        value.kind = KFunctionReference;
        value.constant = false;
        value.bits = 0;
    }
}

fn sem_evaluation_dispose_jobs(jobs: vector(void*)*): void {
    // The owning pipeline has drained its worker pool. Dispose every consumer
    // invocation before releasing any producer's borrowed projection array.
    foreach(var job in jobs) {
        var result = bits(SemanticEvaluation*, job);
        interpreter_invocation_dispose(&result.invocation);
    }
    var index: usize = 0;
    while index < jobs.length {
        var result = bits(SemanticEvaluation*, jobs.data[index]);
        vector_dispose(&result.aliases);
        vector_dispose(&result.leaves);
        vector_dispose(&result.error);
        index++;
    }
    vector_dispose(jobs);
}

fn sem_evaluation_dispose(c: SemanticContext*): void {
    sem_evaluation_dispose_jobs(&c.evaluation_jobs);
}
