import tower;

// Compiler UTF-8 utilities. Counts and capacities are bytes, never characters.
// Decode one Unicode scalar; invalid/truncated input returns 0 and clears value.
export fn tower_utf8_decode(data: u8*, size: usize, value: u32*): usize {
    *value = 0;
    var empty = size == 0;
    if empty {
        return 0;
    }
    var first = convert(u32, data[0]);
    var ascii = first < 128;
    if ascii {
        *value = first;
        return 1;
    }
    var count: usize = 0;
    var minimum: u32 = 0;
    var scalar: u32 = 0;
    var invalid_lead = first < 194;
    if invalid_lead {
        return 0;
    }
    invalid_lead = first > 244;
    if invalid_lead {
        return 0;
    }
    var two = first <= 223;
    if two {
        count = 2;
        minimum = 128;
        scalar = first & 31;
    } else {
        var three = first <= 239;
        if three {
            count = 3;
            minimum = 2048;
            scalar = first & 15;
        } else {
            count = 4;
            minimum = 65536;
            scalar = first & 7;
        }
    }
    var truncated = size < count;
    if truncated {
        return 0;
    }
    var index: usize = 1;
    for(; index != count; index++) {
        var byte = convert(u32, data[index]);
        var prefix = byte &192;
        var invalid = prefix != 128;
        if invalid {
            return 0;
        }
        var payload = byte &63;
        scalar = scalar * 64;
        scalar = scalar | payload;
    }
    var overlong = scalar < minimum;
    if overlong {
        return 0;
    }
    var too_large = scalar > 1114111;
    if too_large {
        return 0;
    }
    var low = scalar >= 55296;
    if low {
        var high = scalar <= 57343;
        if high {
            return 0;
        }
    }
    *value = scalar;
    return count;
}

// A null output queries size. Insufficient capacity or invalid scalars write nothing.
export fn tower_utf8_encode(scalar: u32, output: u8*, capacity: usize): usize {
    var low = scalar >= 55296;
    if low {
        var high = scalar <= 57343;
        if high {
            return 0;
        }
    }
    var too_large = scalar > 1114111;
    if too_large {
        return 0;
    }
    var count: usize = 1;
    var prefix: u32 = 0;
    var multiple = scalar > 127;
    if multiple {
        count = 2;
        prefix = 192;
        var three = scalar > 2047;
        if three {
            count = 3;
            prefix = 224;
            var four = scalar > 65535;
            if four {
                count = 4;
                prefix = 240;
            }
        }
    }
    var query = output == null;
    if query {
        return count;
    }
    var short_buffer = capacity < count;
    if short_buffer {
        return 0;
    }
    var index = count -1;
    var remaining = scalar;
    for(; index != 0; index--) {
        var byte = remaining &63;
        byte = byte | 128;
        output[index] = convert(u8, byte);
        remaining = remaining / 64;
    }
    var first = prefix | remaining;
    first = first & 255;
    output[0] = convert(u8, first);
    return count;
}

// Source text accepts every Unicode scalar except NUL; arbitrary buffers may contain NUL.
export fn tower_utf8_validate(data: u8*, size: usize, reject_nul: u32): u32 {
    var index: usize = 0;
    var scalar: u32 = 0;
    loop {
        var done = index == size;
        if done {
            return 1;
        }
        var byte = data[index];
        var nul = byte == 0;
        if nul {
            var reject = reject_nul != 0;
            if reject {
                return 0;
            }
        }
        var ascii = byte < 128;
        if ascii {
            index++;
        } else {
            var start = data + index;
            var remaining = size -index;
            var count = tower_utf8_decode(start, remaining, &scalar);
            var invalid = count == 0;
            if invalid {
                return 0;
            }
            index = index + count;
        }
    }
}
