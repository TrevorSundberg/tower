import tower;

// Compiler UTF-8 utilities. Counts and capacities are bytes, never characters.
// Decode one Unicode scalar; invalid/truncated input returns 0 and clears value.
// The caller supplies a writable value disjoint from the input bytes.
export fn tower_utf8_decode(data: u8*, size: usize, value: u32*): usize {
    *value = 0;
    if size == 0 {
        return 0;
    }
    var first = convert(u32, data[0]);
    if first < 128 {
        *value = first;
        return 1;
    }
    var count: usize = 0;
    var minimum: u32 = 0;
    var scalar: u32 = 0;
    var invalid_lead = first < 194;
    if invalid_lead {
        return 0;
    }
    invalid_lead = first > 244;
    if invalid_lead {
        return 0;
    }
    if first <= 223 {
        count = 2;
        minimum = 128;
        scalar = first & 31;
    } else {
        if first <= 239 {
            count = 3;
            minimum = 2048;
            scalar = first & 15;
        } else {
            count = 4;
            minimum = 65536;
            scalar = first & 7;
        }
    }
    if size < count {
        return 0;
    }
    var index: usize = 1;
    for(; index != count; index++) {
        var byte = convert(u32, data[index]);
        var prefix = byte &192;
        if prefix != 128 {
            return 0;
        }
        var payload = byte &63;
        scalar = scalar * 64;
        scalar = scalar | payload;
    }
    if scalar < minimum {
        return 0;
    }
    if scalar > 1114111 {
        return 0;
    }
    if scalar >= 55296 {
        if scalar <= 57343 {
            return 0;
        }
    }
    *value = scalar;
    return count;
}

// A null output queries size. Insufficient capacity or invalid scalars write nothing.
export fn tower_utf8_encode(scalar: u32, output: u8*, capacity: usize): usize {
    if scalar >= 55296 {
        if scalar <= 57343 {
            return 0;
        }
    }
    if scalar > 1114111 {
        return 0;
    }
    var count: usize = 1;
    var prefix: u32 = 0;
    if scalar > 127 {
        count = 2;
        prefix = 192;
        if scalar > 2047 {
            count = 3;
            prefix = 224;
            if scalar > 65535 {
                count = 4;
                prefix = 240;
            }
        }
    }
    if output == null {
        return count;
    }
    if capacity < count {
        return 0;
    }
    var index = count -1;
    var remaining = scalar;
    for(; index != 0; index--) {
        var byte = remaining &63;
        byte = byte | 128;
        output[index] = convert(u8, byte);
        remaining = remaining / 64;
    }
    var first = prefix | remaining;
    first = first & 255;
    output[0] = convert(u8, first);
    return count;
}

// Source text accepts every Unicode scalar except NUL; arbitrary buffers may contain NUL.
export fn tower_utf8_validate(data: u8*, size: usize, reject_nul: u32): u32 {
    var index: usize = 0;
    var scalar: u32 = 0;
    loop {
        if index == size {
            return 1;
        }
        var byte = data[index];
        if byte == 0 {
            if reject_nul != 0 {
                return 0;
            }
        }
        if byte < 128 {
            index++;
        } else {
            var start = data + index;
            var remaining = size -index;
            var count = tower_utf8_decode(start, remaining, &scalar);
            if count == 0 {
                return 0;
            }
            index = index + count;
        }
    }
}
