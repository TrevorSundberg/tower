import tower;
import frontend_revision_types;
import lr_tree;
import parser_nodes;
import regex_lowering;
import syntax_emission;
import syntax_expansion_types;
import syntax_nodes;
import syntax_replacement_types;
import syntax_reader;
import syntax_revision;
import syntax_types;
import syntax_validation;
import .library.vector;

struct SyntaxReplacementOwner {
    host: void*;
    emission: SyntaxEmission*;
    kind: void*;
    current: SyntaxReplacement;
    sequence: void*;
    selected: void*;
    category: vector(u8);
    uses: vector(usize);
    entries: vector(SyntaxReplacement);
    productions: vector(usize);
    captures: vector(SyntaxExpansionCapture);
    rules: vector(SyntaxExpansionRule);
    index: vector(SyntaxExpansionRule*);
    input: SyntaxExpansionInput;
    diagnostic: vector(u8);
    failed: bool;
    frozen: bool;
}

fn replacement_release(node: void*): void {
    if node is not null {
        entity_release(node);
    }
}

fn replacement_dispose(value: SyntaxReplacement*): void {
    replacement_release(value.tree);
    foreach(var & capture in &value.captures) {
        replacement_release(capture.source);
        vector_dispose(&capture.name);
    }
    vector_dispose(&value.captures);
    vector_dispose(&value.rule);
    vector_dispose(&value.category);
    fill(value, 0, sizeof(SyntaxReplacement));
}

export fn syntax_replacement_owner_create(host: void*, emission: SyntaxEmission*, kind: void*, match_kind: void*): SyntaxReplacementOwner* {
    var value = alloc(SyntaxReplacementOwner, 1);
    if value is null {
        return null;
    }
    fill(value, 0, sizeof(SyntaxReplacementOwner));
    value.host = host;
    value.emission = emission;
    value.kind = kind;
    value.input.match_kind = match_kind;
    return value;
}

export fn syntax_replacement_owner_destroy(value: SyntaxReplacementOwner*): void {
    if value is null {
        return;
    }
    replacement_dispose(&value.current);
    replacement_release(value.sequence);
    replacement_release(value.selected);
    foreach(var & entry in &value.entries) {
        replacement_dispose(entry);
    }
    vector_dispose(&value.entries);
    vector_dispose(&value.productions);
    vector_dispose(&value.captures);
    vector_dispose(&value.rules);
    vector_dispose(&value.index);
    vector_dispose(&value.category);
    vector_dispose(&value.uses);
    vector_dispose(&value.diagnostic);
    free(value);
}

export fn syntax_replacement_begin(context: void*, name: u8*, sequence: void*, start: usize, end: usize): void {
    var value = bits(SyntaxReplacementOwner*, context);
    if value.frozen {
        return;
    }
    replacement_dispose(&value.current);
    replacement_release(value.sequence);
    replacement_release(value.selected);
    value.selected = null;
    value.sequence = sequence;
    if sequence is not null {
        entity_retain(sequence);
    }
    value.current.start = start;
    value.current.end = end;
    value.current.error_offset = start;
    value.failed ||= !node_text_set(&value.current.rule, name);
    value.uses.length = 0;
    value.category.length = 0;
}

export fn syntax_replacement_capture(context: void*, name: u8*, source: void*): void {
    var value = bits(SyntaxReplacementOwner*, context);
    if value.failed || value.frozen {
        return;
    }
    var captures = &value.current.captures;
    var length = syntax_text_length(name);
    var index: usize = 0;
    for(; index < captures.length; ++index) {
        var previous = &captures.data[index];
        var order = syntax_bytes_compare(previous.name.data, previous.name.length, name, length);
        if order == 0 {
            entity_retain(source);
            replacement_release(previous.source);
            previous.source = source;
            return;
        }
        if order > 0 {
            break;
        }
    }
    var capture: SyntaxReplacementCapture;
    fill(&capture, 0, sizeof(SyntaxReplacementCapture));
    if !node_text_set(&capture.name, name) || !vector_reserve(captures, captures.length + 1) {
        vector_dispose(&capture.name);
        value.failed = true;
        return;
    }
    capture.source = source;
    entity_retain(source);
    for(var i = captures.length; i > index; --i) {
        copy(&captures.data[i], &captures.data[i -1], sizeof(SyntaxReplacementCapture));
    }
    copy(&captures.data[index], &capture, sizeof(SyntaxReplacementCapture));
    captures.length++;
}

// The temporary parser borrows this mutable candidate only during preparation.
export fn syntax_replacement_candidate(value: SyntaxReplacementOwner*, category: u8*): SyntaxReplacement* {
    if value.failed || value.frozen {
        return null;
    }
    value.failed = !node_text_set(&value.current.category, category);
    if value.failed {
        return null;
    }
    value.diagnostic.length = 0;
    if value.diagnostic.data is not null {
        value.diagnostic.data[0] = 0;
    }
    value.current.error_offset = value.current.start;
    foreach(var & capture in &value.current.captures) {
        (*capture).uses = 0;
    }
    return &value.current;
}

export fn syntax_replacement_host(value: SyntaxReplacementOwner*): void* {
    return value.host;
}

export fn syntax_replacement_sequence(value: SyntaxReplacementOwner*): void* {
    return value.sequence;
}

// Adopt the parser's one owned tree reference, replacing any previous attempt.
export fn syntax_replacement_tree(value: SyntaxReplacementOwner*, tree: void*): void {
    replacement_release(value.current.tree);
    value.current.tree = tree;
}

export fn syntax_replacement_error(value: SyntaxReplacementOwner*, text: u8*): void {
    value.failed ||= !node_text_set(&value.diagnostic, text);
}

export fn syntax_replacement_diagnostic(context: void*): u8* {
    var value = bits(SyntaxReplacementOwner*, context);
    return value.failed ? "Unable to allocate replacement preparation storage": node_text_get(&value.diagnostic);
}

export fn syntax_replacement_offset(context: void*): usize {
    var value = bits(SyntaxReplacementOwner*, context);
    return value.current.error_offset;
}

export fn syntax_replacement_select(context: void*): void {
    var value = bits(SyntaxReplacementOwner*, context);
    if value.failed || value.frozen {
        return;
    }
    var captures = &value.current.captures;
    value.failed = !node_text_set(&value.category, node_text_get(&value.current.category)) || !vector_reserve(&value.uses, captures.length);
    if value.failed {
        return;
    }
    value.uses.length = captures.length;
    for(var i: usize = 0; i < captures.length; ++i) {
        value.uses.data[i] = captures.data[i].uses;
    }
    replacement_release(value.selected);
    value.selected = value.current.tree;
    value.current.tree = null;
}

// Production order, like capture-name order, is derived and deterministic.
export fn syntax_replacement_commit(context: void*, alternative: usize): void {
    var value = bits(SyntaxReplacementOwner*, context);
    if value.failed || value.frozen {
        return;
    }
    var current = &value.current;
    var production = syntax_emission_find_name(value.emission, node_text_get(&current.rule), alternative);
    var index: usize = 0;
    for(; index < value.productions.length; ++index) {
        if value.productions.data[index] >= production {
            break;
        }
    }
    if index < value.productions.length && value.productions.data[index] == production {
        return;
    }
    value.failed = !vector_reserve(&value.entries, value.entries.length + 1) || !vector_reserve(&value.productions, value.productions.length + 1);
    if value.failed {
        return;
    }
    replacement_release(current.tree);
    current.tree = value.selected;
    value.selected = null;
    vector_move(&current.category, &value.category);
    for(var i: usize = 0; i < current.captures.length; ++i) {
        current.captures.data[i].uses = value.uses.data[i];
    }
    for(var i = value.entries.length; i > index; --i) {
        copy(&value.entries.data[i], &value.entries.data[i -1], sizeof(SyntaxReplacement));
        value.productions.data[i] = value.productions.data[i -1];
    }
    copy(&value.entries.data[index], current, sizeof(SyntaxReplacement));
    fill(current, 0, sizeof(SyntaxReplacement));
    value.productions.data[index] = production;
    value.entries.length++;
    value.productions.length++;
}

export fn syntax_replacement_freeze(value: SyntaxReplacementOwner*): bool {
    if value.failed {
        return false;
    }
    if value.frozen {
        return true;
    }
    var total: usize = 0;
    foreach(var & entry in &value.entries) {
        var count =(*entry).captures.length;
        if count > ~convert(usize, 0) -total {
            return false;
        }
        total += count;
    }
    var count = value.entries.length;
    var slots = count == 0 ? 0: value.productions.data[count -1] + 1;
    if count != 0 && slots == 0 {
        return false;
    }
    if !vector_reserve(&value.captures, total) ||
    !vector_reserve(&value.rules, count) ||
    !vector_reserve(&value.index, slots) {
        return false;
    }
    fill(value.index.data, 0, slots *sizeof(SyntaxExpansionRule*));
    var offset: usize = 0;
    for(var i: usize = 0; i < count; ++i) {
        var entry = &value.entries.data[i];
        var rule = &value.rules.data[i];
        rule.tree = entry.tree;
        rule.rule = node_text_get(&entry.rule);
        rule.category = node_text_get(&entry.category);
        rule.start = entry.start;
        rule.end = entry.end;
        rule.count = entry.captures.length;
        rule.captures = rule.count == 0 ? null: &value.captures.data[offset];
        for(var j: usize = 0; j < rule.count; ++j) {
            var capture = &entry.captures.data[j];
            var view = &value.captures.data[offset++];
            view.name = node_text_get(&capture.name);
            view.uses = capture.uses;
            var node = bits(SyntaxNode*, entity_component_data(entity_component_get(capture.source, value.kind)));
            view.repeated = node.repetition != 0;
        }
        value.index.data[value.productions.data[i]] = rule;
    }
    value.captures.length = total;
    value.rules.length = count;
    value.index.length = slots;
    value.input.rules = value.index.data;
    value.input.count = slots;
    value.host = null;
    value.frozen = true;
    return true;
}

export fn syntax_replacement_input(value: SyntaxReplacementOwner*): SyntaxExpansionInput* {
    return &value.input;
}

export fn syntax_replacement_count(value: SyntaxReplacementOwner*): usize {
    return value.entries.length;
}

export fn syntax_replacement_inspect(value: SyntaxReplacementOwner*, grammar: FrontendRevision*, body: void*): SyntaxReplacement* {
    if value is null {
        return null;
    }
    for(var i: usize = 0; i < value.entries.length; ++i) {
        var production = syntax_emission_find_index(value.emission, value.productions.data[i]);
        if production is null {
            continue;
        }
        var rule = syntax_revision_rule(grammar, production.name, syntax_text_length(production.name));
        if rule is null || production.alternative >= rule.count {
            continue;
        }
        var node = bits(SyntaxNode*, entity_component_data(entity_component_get(rule.alternatives[production.alternative], value.kind)));
        if node.replacement == body {
            return &value.entries.data[i];
        }
    }
    return null;
}
