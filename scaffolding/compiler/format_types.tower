import .library.vector;
import tower;
import .library.work_buffer_types;
import .library.work_budget_types;

// Shared formatter result ABI. Editor previews use the same formatting engine.
struct FormatSpan {
    begin: usize;
    end: usize;
    source: usize;
}

struct FormatComment {
    start: usize;
    end: usize;
}

struct FormatResult {
    text: vector(u8);
    spans: vector(FormatSpan);
    depth: usize;
    failed: bool;
    // Legacy default results retain vector ownership. Checked requests expose
    // the same borrowed views while these receipts own their physical storage.
    checked: bool;
    budget: WorkBudget*;
    resource_error: WorkBudgetError;
    text_storage: WorkBuffer;
    span_storage: WorkBuffer;
}

// A disposable view of original syntax with bound arguments. The source tree
// remains authoritative; each replacement retains its own binding context.
struct FormatSubstitution {
    node: void*;
    replacement: void*;
    nested: FormatSubstitution*;
    next: FormatSubstitution*;
}

struct FormatEngine {
    result: FormatResult*;
    syntax_kind: void*;
    foundation_kind: void*;
    match_kind: void*;
    source_names: bool;
    substitutions: FormatSubstitution*;
    dependent_subject: void*;
    dependent_annotation: void*;
}
