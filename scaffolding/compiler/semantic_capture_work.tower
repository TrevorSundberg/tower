import tower;
import semantic_declaration_types;
import semantic_source_binding_types;
import semantic_context_types;
import semantic_evaluation_types;
import semantic_context;
import semantic_known_bindings;
import semantic_types;
import semantic_expression_lowering;
import semantic_source_bindings;
import semantic_declarations;
import semantic_defer;
import semantic_control;
import semantic_evaluation;
import semantic_evaluation_work;
import semantic_support;
import semantic_work_ids;
import foundation_tags;
import interpreter_context_types;
import .library.vector;
import .library.work_graph;

struct SemanticCapture {
    subject: void*;
    proof: SemanticSourceBinding*;
    expression: SemanticDeclaration*;
    evaluation: SemanticEvaluation*;
    error: vector(u8);
    error_offset: usize;
    block: void*;
    begin: usize;
    end: usize;
    lowering: WorkTicket;
}

extern fn entity_query_count(kind: void*): usize;
extern fn entity_query_at(kind: void*, index: usize): void*;

fn sem_captures_begin(c: SemanticContext*): void {
    if c.capture_inputs == null {
        c.capture_inputs = sem_create(c.program.root);
        sem_require(entity_register(c.capture_inputs, sizeof(SemanticCapture), alignof(SemanticCapture), 0));
    }
    if c.value_inputs == null {
        c.value_inputs = sem_create(c.program.root);
        sem_require(entity_register(c.value_inputs, sizeof(IMValueInput), alignof(IMValueInput), 0));
    }
}

fn sem_capture_request(c: SemanticContext*, subject: void*): usize {
    sem_captures_begin(c);
    var query = convert(u32, SemanticQuery.CaptureInput);
    var existing = work_find(&c.queries, subject, query, 0);
    if existing != 0 { return existing; }
    // Membership on the program (never a declaration) closes new admission.
    // Only the successful producer-drain boundary may attach that component.
    sem_require(entity_component_get(c.program.root, c.capture_inputs) == null);
    var result = sem_capture_storage(c, subject);
    result.subject = subject;
    var id = work_request(&c.queries, subject, query, 0);
    sem_require(id != 0);
    sem_require(work_seal(&c.queries, id));
    return id;
}

fn sem_capture_storage(c: SemanticContext*, subject: void*): SemanticCapture* {
    var result = bits(SemanticCapture*, entity_component_data(entity_component_get(subject, c.capture_inputs)));
    if result == null {
        result = bits(SemanticCapture*, entity_component_data(entity_component_add(subject, c.capture_inputs)));
        sem_require(result != null);
        *result = default;
    }
    return result;
}

// Reserve metadata before the function's exclusive lowering lease and view.
// Only source initializers need a range; generated locals belong to that range.
fn sem_capture_ranges(c: SemanticContext*, block: void*, ticket: WorkTicket*, stage: void*): void {
    sem_captures_begin(c);
    var pending: vector(void*) = default;
    defer vector_dispose(&pending);
    sem_push(&pending, block);
    while pending.length != 0 {
        var node = pending.data[--pending.length];
        var value = sem_get(node);
        if value == null { continue; }
        if value.kind == KDeclare && value.value != null && sem_member(node, "value") != null {
            var result = sem_capture_storage(c, node);
            sem_require(result.block == null);
            result.lowering = *ticket;
            // A function lease is not recursive. Reserve this declaration's
            // payload too before a worker can record its initializer range.
            sem_require(entity_stage_lease(stage, node));
        }
        sem_known_edges(&pending, value);
    }
}

// The owning lowering worker writes only already-attached declaration payloads.
// Its exact dispatch receipt is published after all generated stages have joined.
fn sem_capture_range(c: SemanticContext*, node: void*, block: void*, begin: usize): void {
    if c.capture_inputs == null { return; }
    var result = bits(SemanticCapture*, entity_component_data(entity_component_get(node, c.capture_inputs)));
    if result == null || result.lowering.task == 0 { return; }
    sem_require(work_task(&c.queries, result.lowering.task).subject == c.current);
    result.block = block;
    result.begin = begin;
    result.end = sem_get(block).items.length;
}

fn sem_capture_clone_range(c: SemanticContext*, result: SemanticCapture*): void {
    var output = sem_control_node(c, result.subject, KOperand);
    sem_evaluation_expression(c, output, result.subject, null, false);
    if !sem_ok(c) { return; }
    var evaluation = sem_evaluation_get(c, output);
    var function = sem_evaluation_function(c, evaluation);
    var body = sem_control_node(c, function, KBlock);
    sem_get(function).body = body;
    var previous = c.current;
    var preserve = c.preserve_clone_storage;
    c.current = function;
    c.preserve_clone_storage = false;
    var clones = sem_table(c);
    var nodes = sem_list(c);
    var source = sem_get(result.block);
    sem_require(result.begin < result.end && result.end <= source.items.length);
    for(var at = result.begin; at < result.end; at++) {
        sem_lift_append(body, sem_defer_clone(c, body, source.items.data[at], clones, nodes));
    }
    foreach(var node in nodes) {
        var value = sem_get(node);
        if value.kind == KDeclare { value.global = false; }
        if value.binding == null || sem_get(value.binding).kind == KFunction { continue; }
        var local = sem_find(clones, null, value.binding);
        if local != null { value.binding = local.value; }
    }
    var declaration = sem_find(clones, null, result.subject);
    sem_require(declaration != null && declaration.value != null);
    var value = sem_control_read(c, body, declaration.value);
    if evaluation.aggregate { value = sem_get(sem_lift_target(c, body, value)).value; }
    var returned = sem_control_node(c, body, KReturn);
    sem_get(returned).value = value;
    sem_lift_append(body, returned);
    c.preserve_clone_storage = preserve;
    c.current = previous;
    evaluation.expression = null;
    result.evaluation = evaluation;
}

fn sem_capture_pump(c: SemanticContext*): SemanticPumpResult {
    if c.capture_inputs == null { return SemanticPumpResult.Complete; }
    var query = convert(u32, SemanticQuery.CaptureInput);
    var ticket: WorkTicket;
    if !work_take_query(&c.queries, &ticket, query) {
        return sem_query_pending(c, query) ? SemanticPumpResult.Waiting : SemanticPumpResult.Complete;
    }
    var subject = work_task(&c.queries, ticket.task).subject;
    var result = bits(SemanticCapture*, entity_component_data(entity_component_get(subject, c.capture_inputs)));
    var binding = sem_get(subject);
    if result.proof == null {
        // Suspend before dispatching proof workers. A retained proof pipeline
        // publishes declaration facts once, after all of its scans have joined.
        var proof = sem_source_binding_request(c, subject);
        if work_task(&c.queries, proof).state != WorkState.Succeeded {
            sem_require(work_suspend(&c.queries, &ticket, proof));
            return SemanticPumpResult.Progress;
        }
        result.proof = sem_source_binding(c, subject);
        sem_require(work_observe(&c.queries, &ticket, proof));
        if result.proof != null { sem_require(work_observe(&c.queries, &ticket, result.proof.query)); }
    }
    if result.proof == null || !result.proof.immutable || sem_member(subject, "value") == null {
        sem_fail(c, subject, "Compile-time expression cannot capture runtime storage: binding is mutable, escaped or lacks an initializer");
    }
    if sem_ok(c) && result.evaluation == null {
        if result.lowering.task != 0 {
            var lowering = work_task(&c.queries, result.lowering.task);
            // A closed admission component is published only after required
            // producers drain. Query registration is not a finalization signal.
            sem_require(result.lowering.revision == c.queries.revision
                && result.lowering.profile == c.queries.profile
                && result.lowering.dispatch == lowering.dispatch
                && entity_component_get(c.program.root, c.capture_inputs) == null);
            if lowering.state != WorkState.Succeeded {
                sem_require(work_suspend(&c.queries, &ticket, result.lowering.task));
                return SemanticPumpResult.Progress;
            }
            sem_require(work_observe(&c.queries, &ticket, result.lowering.task));
            sem_capture_clone_range(c, result);
            if sem_ok(c) {
                result.evaluation.capture_order = result.proof.owner == null;
                result.evaluation.capture_ordinal = result.proof.ordinal;
                sem_evaluation_work_register(c, false);
                sem_require(work_suspend(&c.queries, &ticket,
                    work_find(&c.queries, result.evaluation.subject, EvaluationQuery, 0)));
                return SemanticPumpResult.Progress;
            }
        }
    }
    if sem_ok(c) && result.evaluation == null {
        var value = binding.value;
        if value != null && !binding.global {
            var checked = work_find(&c.queries, subject, convert(u32, SemanticQuery.CheckedBinding), 0);
            // A for initializer can publish through its expression query before
            // the enclosing body resumes. That completed producer is the same
            // checked-prefix evidence, without depending on the whole body.
            if checked == 0 { checked = sem_declaration_query(c, sem_member(subject, "value")); }
            sem_require(checked != 0 && work_observe(&c.queries, &ticket, checked));
        }
        if value == null {
            if result.expression == null {
                var declaration = sem_declaration_state(c, subject);
                var lexical = declaration.lexical;
                lexical.current = result.proof.owner ?? c.program.root;
                if lexical.scope == null { lexical.scope = c.scope; }
                if binding.global { sem_declaration_state(c, sem_member(subject, "value")).module_initializer = true; }
                result.expression = sem_expression_add(c, sem_member(subject, "value"), &binding.type,
                    &lexical, SemanticExpressionMode.Initializer);
                sem_declaration_discover(c);
                sem_require(work_suspend(&c.queries, &ticket, result.expression.query));
                return SemanticPumpResult.Progress;
            }
            value = result.expression.value;
            // Publish the checked initializer to its declaration once. Later
            // module initialization consumes this same node and still performs
            // its runtime initialization in source order.
            binding.value = value;
        }
        var output = sem_control_node(c, subject, KOperand);
        var clones = sem_table(c);
        var nodes = sem_list(c);
        var expression = sem_defer_clone(c, output, value, clones, nodes);
        var previous = c.integer_arguments;
        c.integer_arguments = true;
        sem_evaluation_expression(c, output, expression, null, false);
        c.integer_arguments = previous;
        if sem_ok(c) {
            result.evaluation = sem_evaluation_get(c, output);
            result.evaluation.capture_order = result.proof.owner == null;
            result.evaluation.capture_ordinal = result.proof.ordinal;
            sem_evaluation_work_register(c, false);
            sem_require(work_suspend(&c.queries, &ticket, work_find(&c.queries, output, EvaluationQuery, 0)));
            return SemanticPumpResult.Progress;
        }
    }
    if sem_ok(c) {
        var input = bits(IMValueInput*, entity_component_data(entity_component_get(subject, c.value_inputs)));
        if input == null {
            input = bits(IMValueInput*, entity_component_data(entity_component_add(subject, c.value_inputs)));
            sem_require(input != null);
            *input = default;
        }
        input.producer = result.evaluation.literal;
        input.owner = result.proof.owner;
        input.ordinal = result.proof.ordinal;
    } else {
        result.error = c.program.error;
        result.error_offset = c.program.error_offset;
        c.program.error = default;
    }
    sem_require(work_finish(&c.queries, &ticket, result.error.length == 0));
    return SemanticPumpResult.Progress;
}

fn sem_capture_failure(c: SemanticContext*, subject: void*): bool {
    var result = bits(SemanticCapture*, entity_component_data(entity_component_get(subject, c.capture_inputs)));
    return result != null && sem_restore_error(c, &result.error, result.error_offset);
}

// The sole KnownPublish caller follows the complete evaluation pump/finalizer.
// Attribute publication only changes metadata tags; subsequent module/flow
// checks consume completed receipts and never create captures or generic bodies.
// Assert the terminal boundary before any initializer range can be compacted.
fn sem_captures_finalize(c: SemanticContext*): void {
    sem_require(c.workers.running == 0 && c.queries.running == 0);
    foreach(var &task in &c.queries.tasks) {
        if !task.demanded { continue; }
        if task.query == convert(u32, SemanticQuery.CaptureInput) {
            sem_require(task.state == WorkState.Succeeded);
        }
        if task.query == EvaluationQuery {
            var evaluation = sem_evaluation_get(c, task.subject);
            if !evaluation.inferred { sem_require(task.state == WorkState.Succeeded); }
        }
    }
    sem_captures_begin(c);
    sem_capture_storage(c, c.program.root).subject = c.program.root;
}

fn sem_captures_dispose(c: SemanticContext*): void {
    if c.capture_inputs == null { return; }
    for(var i: usize = 0; i < entity_query_count(c.capture_inputs); i++) {
        var result = bits(SemanticCapture*, entity_component_data(entity_query_at(c.capture_inputs, i)));
        vector_dispose(&result.error);
    }
}
