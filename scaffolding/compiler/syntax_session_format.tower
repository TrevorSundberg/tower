import tower;
import component_kinds;
import format_types;
import frontend_modules;
import lr_tree;
import syntax_reader;
import syntax_session_pins;
import syntax_session_state;
import syntax_session_types;
import syntax_validation;
import syntax_version_cache;
import .library.vector;
import .library.work_budget_types;

extern fn compiler_world_type(world: void*, kind: u32): void*;

// Formatting remains in its existing compiled unit. These calls share its
// result and comment records without importing its independent LR bindings.
extern fn format_dispose(result: FormatResult*): void;

extern fn format_source(result: FormatResult*, roots: void**, count: usize, source: u8*, length: usize,
comments: FormatComment*, comment_count: usize, syntax: void*, foundation: void*, match_kind: void*): void;

extern fn format_same_tree(a: void*, b: void*, source_a: u8*, size_a: usize,
source_b: u8*, size_b: usize, syntax: void*, kind: void*): bool;

fn syntax_format_clone(source: SyntaxSession*, text: u8*): SyntaxSession* {
    var value = syntax_session_allocate(source.inputs.world, source.inputs.environment);
    if value is null {
        return null;
    }
    syntax_session_pins_baseline(&value.pins, &source.pins);
    value.bootstrapping = source.bootstrapping;
    value.building_bedrock = source.building_bedrock;
    // Cache cloning is optional; reset can build the same grammar uncached.
    syntax_version_cache_copy(&value.cache, &source.cache);
    value.formatting = true;
    syntax_reset(bits(void*, value), text, null);
    return value;
}

fn syntax_format_roots_dispose(roots: vector(void*)*): void {
    foreach(var & root in roots) {
        entity_release(*root);
    }
    vector_dispose(roots);
}

// The caller owns the shared formatter output. Diagnostics are immutable static
// text and remain valid after both result disposal and session destruction.
// An unavailable session produces an empty result/error, as the legacy API did.
export fn syntax_format_into(opaque: void*, output: FormatResult*, error: u8**): bool {
    var session = bits(SyntaxSession*, opaque);
    *error = "";
    if session.resource_error != WorkBudgetError.None {
        *error = "Unable to acquire syntax resources";
        return false;
    }
    if session.error.length != 0 || !session.finalized {
        return false;
    }
    var source = syntax_format_clone(session, session.source);
    if source is null {
        return false;
    }
    defer syntax_destroy(bits(void*, source));
    var roots: vector(void*);
    vector_init(&roots);
    defer syntax_format_roots_dispose(&roots);
    loop {
        var root = syntax_next(bits(void*, source));
        if root is null {
            break;
        }
        if !vector_push(&roots, root) {
            entity_release(root);
            *error = "Unable to allocate canonical formatted source";
            return false;
        }
    }
    if source.resource_error != WorkBudgetError.None {
        *error = "Unable to acquire syntax resources";
        return false;
    }
    if source.error.length != 0 {
        return false;
    }
    var comments: vector(FormatComment);
    vector_init(&comments);
    defer vector_dispose(&comments);
    foreach(var & row in &source.highlights.items) {
        if syntax_bytes_compare(row.kind, syntax_text_length(row.kind), "comment", syntax_text_length("comment")) != 0 {
            continue;
        }
        if !vector_reserve(&comments, comments.length + 1) {
            *error = "Unable to allocate canonical formatted source";
            return false;
        }
        comments.data[comments.length].start = row.start;
        comments.data[comments.length++].end = row.end;
    }
    var syntax = compiler_world_type(source.inputs.world, CompilerSyntax);
    var match_kind = compiler_world_type(source.inputs.world, CompilerParserMatch);
    format_source(output, roots.data, roots.length, source.source, source.source_length,
    comments.data, comments.length, syntax, null, match_kind);
    if !output.failed {
        output.failed = !vector_reserve(&output.text, output.text.length + 1);
        if !output.failed {
            output.text.data[output.text.length] = 0;
        }
    }
    if output.failed {
        format_dispose(output);
        *error = "Unable to allocate canonical formatted source";
    }
    // Reparse without replacements, preserving the same baseline/cache and
    // exact shared-tree comparison used by the old source formatting path.
    var verify = syntax_format_clone(source, output.text.data ?? "");
    if verify is null {
        format_dispose(output);
        *error = "";
        return false;
    }
    defer syntax_destroy(bits(void*, verify));
    var index: usize = 0;
    var same = true;
    loop {
        var root = syntax_next(bits(void*, verify));
        if root is null {
            break;
        }
        defer entity_release(root);
        // Keep comparing later roots even after an earlier mismatch.
        var matches = index < roots.length && format_same_tree(roots.data[index], root,
        source.source, source.source_length, verify.source, verify.source_length, syntax, match_kind);
        same &&= matches;
        index++;
    }
    if verify.resource_error != WorkBudgetError.None {
        format_dispose(output);
        *error = "Unable to acquire syntax resources";
        return false;
    }
    if !same || index != roots.length || verify.error.length != 0 {
        format_dispose(output);
        *error = "Formatting would change the parsed source under this grammar; source was left unchanged";
        return false;
    }
    return(*error)[0] == 0;
}
