import tower;
import format_storage;
import .library.work_buffer;
import .library.work_buffer_types;
import component_kinds;
import format_types;
import frontend_modules;
import lr_tree;
import syntax_reader;
import syntax_session_pins;
import syntax_session_state;
import syntax_session_types;
import syntax_validation;
import syntax_version_cache;
import .library.vector;
import .library.work_budget_types;

extern fn compiler_world_work_budget(world: void*): WorkBudget*;
extern fn compiler_world_type(world: void*, kind: u32): void*;

// Formatting remains in its existing compiled unit. These calls share its
// result and comment records without importing its independent LR bindings.
extern fn format_dispose(result: FormatResult*): void;

extern fn format_source(result: FormatResult*, roots: void**, count: usize, source: u8*, length: usize,
comments: FormatComment*, comment_count: usize, syntax: void*, foundation: void*, match_kind: void*): void;

extern fn format_same_tree_result(a: void*, b: void*, source_a: u8*, size_a: usize,
source_b: u8*, size_b: usize, syntax: void*, kind: void*, budget: WorkBudget*, error: WorkBudgetError*): bool;

fn syntax_format_clone(source: SyntaxSession*, text: u8*, error: WorkBudgetError*): SyntaxSession* {
    var value = syntax_session_allocate_result(source.inputs.world, source.inputs.environment, error);
    if value is null {
        return null;
    }
    syntax_session_pins_baseline(&value.pins, &source.pins);
    value.bootstrapping = source.bootstrapping;
    value.building_bedrock = source.building_bedrock;
    // Cache cloning is optional; reset can build the same grammar uncached.
    syntax_version_cache_copy(&value.cache, &source.cache);
    value.formatting = true;
    syntax_reset(bits(void*, value), text, null);
    return value;
}

fn syntax_format_roots_dispose(roots: vector(void*)*, storage: WorkBuffer*): void {
    foreach(var & root in roots) {
        entity_release(*root);
    }
    work_buffer_dispose(storage);
}

// The caller owns the shared formatter output. Diagnostics are immutable static
// text and remain valid after both result disposal and session destruction.
// An unavailable session produces an empty result/error, as the legacy API did.
export fn syntax_format_into(opaque: void*, output: FormatResult*, error: u8**): bool {
    var session = bits(SyntaxSession*, opaque);
    *error = "";
    if session.resource_error != WorkBudgetError.None {
        *error = "Unable to acquire syntax resources";
        return false;
    }
    if session.error.length != 0 || !session.finalized {
        return false;
    }
    format_storage_begin(output, compiler_world_work_budget(session.inputs.world));
    if output.failed { *error = "Invalid formatter output owner"; return false; }
    var resource_error = WorkBudgetError.None;
    var source = syntax_format_clone(session, session.source, &resource_error);
    if source is null {
        format_storage_fail(output, resource_error);
        *error = "Unable to acquire formatter session resources";
        return false;
    }
    defer syntax_destroy(bits(void*, source));
    var roots: vector(void*) = default; // Borrowed view of roots_storage.
    var roots_storage: WorkBuffer = default;
    defer syntax_format_roots_dispose(&roots, &roots_storage);
    loop {
        var root = syntax_next(bits(void*, source));
        if root is null {
            break;
        }
        var resource = WorkBudgetError.None;
        var needed = roots.length + 1;
        if needed == 0 { resource = WorkBudgetError.Invalid; }
        else { if needed > roots.capacity {
            resource = work_buffer_grow_elements(&roots_storage, output.budget, roots.length, roots.capacity, needed, sizeof(void*), alignof(void*));
            if resource == WorkBudgetError.None { roots.data = bits(void**, roots_storage.data); roots.capacity = roots_storage.capacity / sizeof(void*); }
        } }
        if resource != WorkBudgetError.None {
            format_storage_fail(output, resource);
            entity_release(root);
            *error = "Unable to allocate canonical formatted source";
            return false;
        }
        roots.data[roots.length++] = root;
    }
    if source.resource_error != WorkBudgetError.None {
        format_storage_fail(output, source.resource_error);
        *error = "Unable to acquire syntax resources";
        return false;
    }
    if source.error.length != 0 {
        return false;
    }
    var comments: vector(FormatComment) = default; // Borrowed view of comment_storage.
    var comment_storage: WorkBuffer = default;
    defer work_buffer_dispose(&comment_storage);
    foreach(var & row in &source.highlights.items) {
        if syntax_bytes_compare(row.kind, syntax_text_length(row.kind), "comment", syntax_text_length("comment")) != 0 {
            continue;
        }
        var resource = WorkBudgetError.None;
        var needed = comments.length + 1;
        if needed == 0 { resource = WorkBudgetError.Invalid; }
        else { if needed > comments.capacity {
            resource = work_buffer_grow_elements(&comment_storage, output.budget, comments.length, comments.capacity, needed, sizeof(FormatComment), alignof(FormatComment));
            if resource == WorkBudgetError.None { comments.data = bits(FormatComment*, comment_storage.data); comments.capacity = comment_storage.capacity / sizeof(FormatComment); }
        } }
        if resource != WorkBudgetError.None {
            format_storage_fail(output, resource);
            *error = "Unable to allocate canonical formatted source";
            return false;
        }
        comments.data[comments.length].start = row.start;
        comments.data[comments.length++].end = row.end;
    }
    var syntax = compiler_world_type(source.inputs.world, CompilerSyntax);
    var match_kind = compiler_world_type(source.inputs.world, CompilerParserMatch);
    format_source(output, roots.data, roots.length, source.source, source.source_length,
    comments.data, comments.length, syntax, null, match_kind);
    if !output.failed {
        format_storage_reserve(output, output.text.length + 1, false);
        if !output.failed {
            output.text.data[output.text.length] = 0;
        }
    }
    if output.failed {
        format_dispose(output);
        *error = "Unable to allocate canonical formatted source";
        return false;
    }
    // Reparse without replacements, preserving the same baseline/cache and
    // exact shared-tree comparison used by the old source formatting path.
    var verify = syntax_format_clone(source, output.text.data ?? "", &resource_error);
    if verify is null {
        format_storage_fail(output, resource_error);
        format_dispose(output);
        *error = "Unable to acquire formatter verification resources";
        return false;
    }
    defer syntax_destroy(bits(void*, verify));
    var index: usize = 0;
    var same = true;
    loop {
        var root = syntax_next(bits(void*, verify));
        if root is null {
            break;
        }
        defer entity_release(root);
        // Keep comparing later roots even after an earlier mismatch.
        var resource = WorkBudgetError.None;
        var matches = index < roots.length && format_same_tree_result(roots.data[index], root,
        source.source, source.source_length, verify.source, verify.source_length, syntax, match_kind, output.budget, &resource);
        format_storage_fail(output, resource);
        same &&= matches;
        index++;
    }
    if verify.resource_error != WorkBudgetError.None || output.failed {
        format_storage_fail(output, verify.resource_error);
        format_dispose(output);
        *error = "Unable to acquire syntax resources";
        return false;
    }
    if !same || index != roots.length || verify.error.length != 0 {
        format_dispose(output);
        *error = "Formatting would change the parsed source under this grammar; source was left unchanged";
        return false;
    }
    return(*error)[0] == 0;
}
