import tower;
import world;
import component_kinds;
import parser_types;
import syntax_types;
import .library.entities;
import .library.entity_types;
import .library.entity_stage;
import .library.vector;
import .library.work_budget_types;
import .library.work_vector;
import .library.work_vector_types;

extern fn bytes_assign_text(value: vector(u8)*, source: u8*, length: usize): bool;

fn provenance_owner(trace: SyntaxExpansion*): Entity* {
    var component = entity_component_from_data(bits(u8*, trace));
    return entity_component_owner(component);
}

export fn syntax_trace_retain(trace: SyntaxExpansion*): void {
    if trace != null {
        entity_retain(provenance_owner(trace));
    }
}

// Detach a uniquely owned chain before reclaiming each entity, avoiding recursive
// destruction. A pinned trace remains unchanged until the view drains.
export fn syntax_trace_release(trace: SyntaxExpansion*): void {
    loop {
        if trace == null {
            return;
        }
        var owner = provenance_owner(trace);
        var unique = entity_references(owner) == 1;
        var unpinned = owner.store.views == 0;
        if unique {
            if unpinned {
                var previous = trace.previous;
                trace.previous = null;
                entity_release(owner);
                trace = previous;
                continue;
            }
        }
        entity_release(owner);
        return;
    }
}

export fn syntax_trace_dispose(trace: SyntaxExpansion*): void {
    var previous = trace.previous;
    trace.previous = null;
    work_vector_dispose(&trace.rule);
    syntax_trace_release(previous);
}

export fn syntax_origin_dispose(origin: SyntaxOrigin*): void {
    syntax_trace_release(origin.expansion);
    origin.expansion = null;
    foreach(var & splice in &origin.splices) {
        syntax_trace_release(*splice);
    }
    work_vector_dispose(&origin.splices);
}

export fn syntax_origin_get(world: CompilerWorld*, node: Entity*): SyntaxOrigin* {
    return bits(SyntaxOrigin*, compiler_world_get(world, node, CompilerSyntaxOrigin));
}

export fn syntax_trace_create(world: CompilerWorld*, invocation: Entity*, rule: u8*, definition_start: usize, definition_end: usize): SyntaxExpansion* {
    var error = WorkBudgetError.None;
    return syntax_trace_create_result(world, invocation, rule, definition_start, definition_end, &error);
}

export fn syntax_trace_create_result(world: CompilerWorld*, invocation: Entity*, rule: u8*, definition_start: usize,
    definition_end: usize, error: WorkBudgetError*): SyntaxExpansion* {
    *error = WorkBudgetError.Invalid;
    if world == null || invocation == null || invocation.store != world.store || rule == null { return null; }
    var span = bits(ParserMatchData*, compiler_world_get(world, invocation, CompilerParserMatch));
    var missing = span == null;
    if missing {
        return null;
    }
    if span.length > ~convert(usize, 0) - span.start { return null; }
    var owner = entity_create_result(world.store, error);
    missing = owner == null;
    if missing {
        return null;
    }
    var trace = bits(SyntaxExpansion*, compiler_world_component_result(world, owner, CompilerSyntaxExpansion, error));
    missing = trace == null;
    if missing {
        entity_release(owner);
        return null;
    }
    var length: usize = 0;
    for(; rule[length] != 0; length++) {}
    if length == ~convert(usize, 0) { *error = WorkBudgetError.Invalid; entity_release(owner); return null; }
    *error = work_vector_reserve_result(&trace.rule, world.work_budget, length + 1);
    if *error != WorkBudgetError.None {
        entity_release(owner);
        return null;
    }
    copy(trace.rule.data, rule, length + 1);
    trace.rule.length = length;
    trace.start = span.start;
    trace.end = span.start + span.length;
    trace.definition_start = definition_start;
    trace.definition_end = definition_end;
    var prior = syntax_origin_get(world, invocation);
    if prior != null {
        trace.previous = prior.expansion;
        syntax_trace_retain(trace.previous);
    }
    return trace;
}

// Copies own their splice storage and retain shared immutable history. Prepare
// all allocations before replacing destination state, including self-copy.
export fn syntax_origin_copy(world: CompilerWorld*, source: Entity*, destination: Entity*): bool {
    return syntax_origin_copy_result(world, source, destination) == WorkBudgetError.None;
}

export fn syntax_origin_copy_result(world: CompilerWorld*, source: Entity*, destination: Entity*): WorkBudgetError {
    if source == null || destination == null || source.store != destination.store { return WorkBudgetError.Invalid; }
    if world == null { return compiler_node_world(source) == null ? WorkBudgetError.None : WorkBudgetError.Invalid; }
    if source.store != world.store { return WorkBudgetError.Invalid; }
    if source == destination { return WorkBudgetError.None; }
    if source.stage != null || destination.stage != null || world.store.views != 0 { return WorkBudgetError.Busy; }
    var prior = syntax_origin_get(world, source);
    var missing = prior == null;
    if missing {
        return WorkBudgetError.None;
    }
    var pending: work_vector(SyntaxExpansion*) = default;
    var error = work_vector_reserve_result(&pending, world.work_budget, prior.splices.length);
    if error != WorkBudgetError.None { return error; }
    var target = bits(SyntaxOrigin*, compiler_world_component_result(world, destination, CompilerSyntaxOrigin, &error));
    missing = target == null;
    if missing {
        work_vector_dispose(&pending);
        return error;
    }
    for(var index: usize = 0; index < prior.splices.length; index++) {
        var trace = prior.splices.data[index];
        syntax_trace_retain(trace);
        pending.data[index] = trace;
    }
    pending.length = prior.splices.length;
    syntax_trace_retain(prior.expansion);
    syntax_origin_dispose(target);
    target.template_start = prior.template_start;
    target.template_end = prior.template_end;
    target.generated = prior.generated;
    target.expansion = prior.expansion;
    work_vector_move(&target.splices, &pending);
    return WorkBudgetError.None;
}

// Worker copy into a new private node only. The source history is immutable and
// pinned; shared reference counts transfer on the coordinator after join.
// Allocate everything before queuing ownership, then install without failure.
fn syntax_origin_cancel_borrowed(context: void*): void {
    var origin = bits(SyntaxOrigin*, context);
    origin.expansion = null;
    foreach(var &splice in &origin.splices) { *splice = null; }
}

export fn syntax_origin_copy_staged(world: CompilerWorld*, source: Entity*, destination: Entity*, stage: EntityStage*): bool {
    return syntax_origin_copy_staged_result(world, source, destination, stage) == WorkBudgetError.None;
}

export fn syntax_origin_copy_staged_result(world: CompilerWorld*, source: Entity*, destination: Entity*, stage: EntityStage*): WorkBudgetError {
    if world == null || source == null || destination == null || stage == null || stage.anchor == null
        || source.store != world.store || stage.anchor.store != world.store
        || destination.store != world.store || destination.stage != bits(void*, stage)
        || destination.id != 0 { return WorkBudgetError.Invalid; }
    if syntax_origin_get(world, destination) != null { return WorkBudgetError.Invalid; }
    var prior = syntax_origin_get(world, source);
    if prior == null { return WorkBudgetError.None; }
    if prior.splices.length >= ~convert(usize, 0) / sizeof(Entity*)
        || prior.splices.length > ~convert(usize, 0) / sizeof(SyntaxExpansion*) { return WorkBudgetError.Invalid; }
    var pending: work_vector(SyntaxExpansion*) = default;
    defer work_vector_dispose(&pending);
    var references: work_vector(Entity*) = default;
    defer work_vector_dispose(&references);
    var error = work_vector_reserve_result(&pending, world.work_budget, prior.splices.length);
    if error != WorkBudgetError.None { return error; }
    error = work_vector_reserve_result(&references, world.work_budget, prior.splices.length + 1);
    if error != WorkBudgetError.None { return error; }
    var target = bits(SyntaxOrigin*, compiler_world_component_result(world, destination, CompilerSyntaxOrigin, &error));
    if target == null { return error; }
    references.data[0] = prior.expansion == null ? null : provenance_owner(prior.expansion);
    for(var i: usize = 0; i < prior.splices.length; i++) {
        var trace = prior.splices.data[i];
        pending.data[i] = trace;
        references.data[i + 1] = trace == null ? null : provenance_owner(trace);
    }
    error = entity_stage_references_cancellable_result(stage, references.data, prior.splices.length + 1,
        syntax_origin_cancel_borrowed, bits(void*, target));
    if error != WorkBudgetError.None { return error; }
    pending.length = prior.splices.length;
    target.template_start = prior.template_start;
    target.template_end = prior.template_end;
    target.generated = prior.generated;
    target.expansion = prior.expansion;
    work_vector_move(&target.splices, &pending);
    return WorkBudgetError.None;
}

export fn syntax_origin_mark(world: CompilerWorld*, trace: SyntaxExpansion*, node: Entity*, source: Entity*, generated: bool): bool {
    return syntax_origin_mark_result(world, trace, node, source, generated) == WorkBudgetError.None;
}

export fn syntax_origin_mark_result(world: CompilerWorld*, trace: SyntaxExpansion*, node: Entity*, source: Entity*, generated: bool): WorkBudgetError {
    if world == null || node == null || source == null || node.store != world.store || source.store != world.store {
        return WorkBudgetError.Invalid;
    }
    if node.stage != null || world.store.views != 0 { return WorkBudgetError.Busy; }
    var missing = trace == null;
    if missing {
        return WorkBudgetError.Invalid;
    }
    var owner = provenance_owner(trace);
    if owner.store != world.store {
        return WorkBudgetError.Invalid;
    }
    var existing = syntax_origin_get(world, node);
    var splice = !generated;
    splice &&= existing != null;
    if splice {
        var error = work_vector_push_result(&existing.splices, world.work_budget, trace);
        if error == WorkBudgetError.None {
            syntax_trace_retain(trace);
        }
        return error;
    }
    var span = bits(ParserMatchData*, compiler_world_get(world, source, CompilerParserMatch));
    missing = span == null;
    if missing {
        return WorkBudgetError.Invalid;
    }
    if span.length > ~convert(usize, 0) - span.start { return WorkBudgetError.Invalid; }
    var error = WorkBudgetError.None;
    var origin = bits(SyntaxOrigin*, compiler_world_component_result(world, node, CompilerSyntaxOrigin, &error));
    missing = origin == null;
    if missing {
        return error;
    }
    syntax_trace_retain(trace);
    syntax_trace_release(origin.expansion);
    origin.expansion = trace;
    origin.generated = generated;
    origin.template_start = span.start;
    origin.template_end = span.start + span.length;
    return WorkBudgetError.None;
}
