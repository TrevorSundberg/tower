import tower;
import world;
import component_kinds;
import parser_types;
import syntax_types;
import .library.entities;
import .library.entity_types;
import .library.entity_stage;
import .library.vector;

extern fn bytes_assign_text(value: vector(u8)*, source: u8*, length: usize): bool;

fn provenance_owner(trace: SyntaxExpansion*): Entity* {
    var component = entity_component_from_data(bits(u8*, trace));
    return entity_component_owner(component);
}

export fn syntax_trace_retain(trace: SyntaxExpansion*): void {
    if trace != null {
        entity_retain(provenance_owner(trace));
    }
}

// Detach a uniquely owned chain before reclaiming each entity, avoiding recursive
// destruction. A pinned trace remains unchanged until the view drains.
export fn syntax_trace_release(trace: SyntaxExpansion*): void {
    loop {
        if trace == null {
            return;
        }
        var owner = provenance_owner(trace);
        var unique = entity_references(owner) == 1;
        var unpinned = owner.store.views == 0;
        if unique {
            if unpinned {
                var previous = trace.previous;
                trace.previous = null;
                entity_release(owner);
                trace = previous;
                continue;
            }
        }
        entity_release(owner);
        return;
    }
}

export fn syntax_trace_dispose(trace: SyntaxExpansion*): void {
    var previous = trace.previous;
    trace.previous = null;
    vector_dispose(&trace.rule);
    syntax_trace_release(previous);
}

export fn syntax_origin_dispose(origin: SyntaxOrigin*): void {
    syntax_trace_release(origin.expansion);
    origin.expansion = null;
    foreach(var & splice in &origin.splices) {
        syntax_trace_release(*splice);
    }
    vector_dispose(&origin.splices);
}

export fn syntax_origin_get(world: CompilerWorld*, node: Entity*): SyntaxOrigin* {
    return bits(SyntaxOrigin*, compiler_world_get(world, node, CompilerSyntaxOrigin));
}

export fn syntax_trace_create(world: CompilerWorld*, invocation: Entity*, rule: u8*, definition_start: usize, definition_end: usize): SyntaxExpansion* {
    var span = bits(ParserMatchData*, compiler_world_get(world, invocation, CompilerParserMatch));
    var missing = span == null;
    if missing {
        return null;
    }
    var owner = entity_create(world.store);
    missing = owner == null;
    if missing {
        return null;
    }
    var trace = bits(SyntaxExpansion*, compiler_world_component(world, owner, CompilerSyntaxExpansion));
    missing = trace == null;
    if missing {
        entity_release(owner);
        return null;
    }
    var length: usize = 0;
    for(; rule[length] != 0; length++) {}
    if !bytes_assign_text(&trace.rule, rule, length) {
        entity_release(owner);
        return null;
    }
    trace.start = span.start;
    trace.end = span.start + span.length;
    trace.definition_start = definition_start;
    trace.definition_end = definition_end;
    var prior = syntax_origin_get(world, invocation);
    if prior != null {
        trace.previous = prior.expansion;
        syntax_trace_retain(trace.previous);
    }
    return trace;
}

// Copies own their splice storage and retain shared immutable history. Prepare
// all allocations before replacing destination state, including self-copy.
export fn syntax_origin_copy(world: CompilerWorld*, source: Entity*, destination: Entity*): bool {
    var prior = syntax_origin_get(world, source);
    var missing = prior == null;
    if missing {
        return true;
    }
    if source == destination {
        return true;
    }
    missing = destination == null;
    if missing {
        return false;
    }
    if destination.store != world.store {
        return false;
    }
    var pending: vector(SyntaxExpansion*);
    vector_init(&pending);
    if !vector_reserve(&pending, prior.splices.length) {
        return false;
    }
    var target = bits(SyntaxOrigin*, compiler_world_component(world, destination, CompilerSyntaxOrigin));
    missing = target == null;
    if missing {
        vector_dispose(&pending);
        return false;
    }
    for(var index: usize = 0; index < prior.splices.length; index++) {
        var trace = prior.splices.data[index];
        syntax_trace_retain(trace);
        pending.data[index] = trace;
    }
    pending.length = prior.splices.length;
    syntax_trace_retain(prior.expansion);
    syntax_origin_dispose(target);
    target.template_start = prior.template_start;
    target.template_end = prior.template_end;
    target.generated = prior.generated;
    target.expansion = prior.expansion;
    copy(&target.splices, &pending, sizeof(vector(SyntaxExpansion*)));
    return true;
}

// Worker copy into a new private node only. The source history is immutable and
// pinned; shared reference counts transfer on the coordinator after join.
// Allocate everything before queuing ownership, then install without failure.
export fn syntax_origin_copy_staged(world: CompilerWorld*, source: Entity*, destination: Entity*, stage: EntityStage*): bool {
    if world == null || destination == null || stage == null
        || destination.store != world.store || destination.stage != bits(void*, stage)
        || destination.id != 0 { return false; }
    if syntax_origin_get(world, destination) != null { return false; }
    var prior = syntax_origin_get(world, source);
    if prior == null { return true; }
    if prior.splices.length == ~convert(usize, 0) { return false; }
    var pending: vector(SyntaxExpansion*) = default;
    defer vector_dispose(&pending);
    var references: vector(Entity*) = default;
    defer vector_dispose(&references);
    if !vector_reserve(&pending, prior.splices.length)
        || !vector_reserve(&references, prior.splices.length + 1) { return false; }
    var target = bits(SyntaxOrigin*, compiler_world_component(world, destination, CompilerSyntaxOrigin));
    if target == null { return false; }
    references.data[0] = prior.expansion == null ? null : provenance_owner(prior.expansion);
    for(var i: usize = 0; i < prior.splices.length; i++) {
        var trace = prior.splices.data[i];
        pending.data[i] = trace;
        references.data[i + 1] = trace == null ? null : provenance_owner(trace);
    }
    if !entity_stage_references(stage, references.data, prior.splices.length + 1) { return false; }
    pending.length = prior.splices.length;
    target.template_start = prior.template_start;
    target.template_end = prior.template_end;
    target.generated = prior.generated;
    target.expansion = prior.expansion;
    copy(&target.splices, &pending, sizeof(vector(SyntaxExpansion*)));
    pending = default;
    return true;
}

export fn syntax_origin_mark(world: CompilerWorld*, trace: SyntaxExpansion*, node: Entity*, source: Entity*, generated: bool): bool {
    var missing = trace == null;
    if missing {
        return false;
    }
    var owner = provenance_owner(trace);
    if owner.store != world.store {
        return false;
    }
    var existing = syntax_origin_get(world, node);
    var splice = !generated;
    splice &&= existing != null;
    if splice {
        var ok = vector_push(&existing.splices, trace);
        if ok {
            syntax_trace_retain(trace);
        }
        return ok;
    }
    var span = bits(ParserMatchData*, compiler_world_get(world, source, CompilerParserMatch));
    missing = span == null;
    if missing {
        return false;
    }
    var origin = bits(SyntaxOrigin*, compiler_world_component(world, node, CompilerSyntaxOrigin));
    missing = origin == null;
    if missing {
        return false;
    }
    syntax_trace_retain(trace);
    syntax_trace_release(origin.expansion);
    origin.expansion = trace;
    origin.generated = generated;
    origin.template_start = span.start;
    origin.template_end = span.start + span.length;
    return true;
}
