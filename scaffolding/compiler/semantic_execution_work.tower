extern fn entity_query_count(kind: void*): usize;
extern fn entity_query_at(kind: void*, index: usize): void*;
extern fn entity_stage_discard(stage: void*): void;
extern fn entity_stage_open_result(anchor: void*, error: WorkBudgetError*): void*;
extern fn entity_stage_lease_result(stage: void*, node: void*): WorkBudgetError;
extern fn entity_stage_hold_result(stage: void*): WorkBudgetError;
extern fn entity_stage_publish_result(stage: void*): WorkBudgetError;
extern fn entity_view_open_result(anchor: void*, error: WorkBudgetError*): void*;

// Derived executable snapshots use ordinary Foundation entities. Source bodies
// and signatures remain authoritative and available to later checking/proofs.
struct SemanticExecutable {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    context: SemanticContext*;
    subject: void*;
    root: void*;
    function: void*;
    stage: void*;
    ordinal: usize;
    count: usize;
    error: vector(u8);
    error_offset: usize;
    resource: SemanticResourceFailure;
    query_reads: vector(usize);
    aliases: vector(SemanticEvaluationAlias);
    prepared: bool;
    lowered: bool;
}

fn sem_executable_admission_failure(c: SemanticContext*, subject: void*, error: WorkBudgetError): usize {
    sem_executable_resource(c, subject, error);
    work_cancel(&c.queries);
    return 0;
}

fn sem_executable_kind(c: SemanticContext*, size: usize, alignment: usize): void* {
    var error: WorkBudgetError;
    var kind = sem_create_result(c.program.root, &error);
    if kind != null && !entity_register(kind, size, alignment, 0) {
        sem_require(entity_attach_result(kind, null, null) == WorkBudgetError.None);
        kind = null;
        error = WorkBudgetError.Invalid;
    }
    if kind == null { sem_executable_admission_failure(c, c.program.root, error); }
    return kind;
}

fn sem_executables_begin(c: SemanticContext*): void {
    if !sem_ok(c) || c.executable_functions != null { return; }
    c.executable_functions = sem_executable_kind(c, sizeof(SemanticExecutable), alignof(SemanticExecutable));
    if !sem_ok(c) { return; }
    c.executable_ready = sem_executable_kind(c, sizeof(IMFunctionInput), alignof(IMFunctionInput));
    if !sem_ok(c) { return; }
    if c.aggregate_signatures == null {
        c.aggregate_signatures = sem_executable_kind(c, sizeof(SemanticAggregateSignature), alignof(SemanticAggregateSignature));
    }
}

fn sem_executable_request(c: SemanticContext*, subject: void*): usize {
    if !sem_ok(c) || !work_ok(&c.queries) { return 0; }
    var query = convert(u32, SemanticQuery.ExecutableFunction);
    var existing = work_find(&c.queries, subject, query, 0);
    if existing != 0 { return existing; }
    var body = sem_body_request(c, subject);
    if body == null || !sem_ok(c) || !work_ok(&c.queries) { return 0; }
    var id = work_request(&c.queries, subject, query, 0);
    if !sem_query_check(c, subject, id != 0 && work_depend(&c.queries, id, work_find(&c.queries, subject, BodyQuery, 0))) { return 0; }
    var domain = convert(u64, SemanticWorkDomain.Compiler);
    if !sem_query_check(c, subject,
        work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Body), body.ordinal, 1, WorkAccessMode.Read)
        && work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Layout), 0, ~convert(usize, 0), WorkAccessMode.Read)
        && work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Expression), id, 1, WorkAccessMode.Write)
        && work_seal(&c.queries, id)) { return 0; }
    sem_executables_begin(c);
    if !sem_ok(c) { return 0; }
    var error: WorkBudgetError;
    var component = entity_component_add_result(subject, c.executable_functions, &error);
    if component == null { return sem_executable_admission_failure(c, subject, error); }
    var result = bits(SemanticExecutable*, entity_component_data(component));
    *result = default;
    result.subject = subject;
    result.root = sem_create_result(subject, &error);
    if result.root == null { return sem_executable_admission_failure(c, subject, error); }
    if sem_node_result(c, result.root, KBlock) == null || !sem_ok(c) {
        // The synthetic block has no source token. Its admission belongs to
        // the executable request's canonical function, not offset zero.
        if c.program.resource.error != WorkBudgetError.None {
            c.program.resource.offset = sem_get(subject).start;
            c.program.error_offset = c.program.resource.offset;
        }
        work_cancel(&c.queries);
        return 0;
    }
    result.ordinal = body.ordinal;
    result.kernel.kind = CompilerKernelKind.PrepareFunction;
    result.kernel.payload = bits(void*, result);
    component = entity_component_add_result(subject, c.executable_ready, &error);
    if component == null { return sem_executable_admission_failure(c, subject, error); }
    var input = bits(IMFunctionInput*, entity_component_data(component));
    *input = default;
    return id;
}

fn semantic_executable_kernel(result: SemanticExecutable*): void {
    var context: SemanticContext;
    sem_context_snapshot(&context, result.context);
    var program = *context.program;
    context.program = &program;
    context.current = result.subject;
    context.editor = null;
    context.entity_stage = result.stage;
    context.query_reads = &result.query_reads;
    context.evaluation_aliases = &result.aliases;
    context.preserve_clone_storage = true;
    context.control_reserved = context.control_names;
    context.control_names = null;
    context.control_prefix = "staged function ";
    context.count = 0;
    context.node_limit -= result.context.count;
    sem_scratch_private(&context, result.context);
    context.token_text = default;
    context.scan = default;
    program.error = default;
    var clones = sem_table(&context);
    var nodes = sem_list(&context);
    result.function = sem_defer_clone(&context, result.root, result.subject, clones, nodes);
    if sem_ok(&context) { foreach(var node in nodes) {
        var value = sem_get(node);
        if value.binding == null || sem_get(value.binding).kind == KFunction { continue; }
        var local = sem_find(clones, null, value.binding);
        if local != null { value.binding = local.value; }
    } }
    context.current = result.function;
    context.preserve_clone_storage = false;
    if sem_ok(&context) && (result.prepared || sem_aggregate_needed(result.function)) {
        var error: WorkBudgetError;
        var component = entity_component_add_result(result.function, context.aggregate_signatures, &error);
        if component == null {
            sem_resource_record(&program, error, sem_get(result.subject).start);
        } else {
            var signature = bits(SemanticAggregateSignature*, entity_component_data(component));
            *signature = default;
            if result.prepared {
                *signature = *sem_aggregate_signature(&context, result.subject);
                if signature.result_parameter != null {
                    var parameter = sem_find(clones, null, signature.result_parameter);
                    sem_require(parameter != null && parameter.value != null);
                    signature.result_parameter = parameter.value;
                }
            } else {
                sem_aggregate_function(&context, result.function);
            }
        }
    }
    if sem_ok(&context) && !result.lowered { sem_lift_block(&context, sem_get(result.function).body); }
    result.count = context.count;
    result.error = program.error;
    result.error_offset = program.error_offset;
    result.resource = program.resource;
    sem_scan_dispose(&context);
    sem_scratch_dispose(&context.scratch);
}

fn sem_executable_resource(c: SemanticContext*, subject: void*, error: WorkBudgetError): SemanticPumpResult {
    var message: vector(u8) = default;
    var operation = sem_get(subject);
    sem_restore_resource(c, error, &message, operation == null ? 0 : operation.start);
    return SemanticPumpResult.Failed;
}

fn sem_executables_pump(c: SemanticContext*): SemanticPumpResult {
    if !sem_ok(c) { return SemanticPumpResult.Failed; }
    if c.executable_functions == null { return SemanticPumpResult.Complete; }
    sem_control_names(c);
    if c.workers.count == 0 && !sem_workers_open(c) { return SemanticPumpResult.Failed; }
    var budget = compiler_world_work_budget(compiler_node_world(c.program.root));
    var batch: work_vector(SemanticExecutable*) = default;
    var receipt: WorkReservation = default;
    var view: void* = null;
    // Failed ownership transfer must discard private stages while their
    // borrowed inputs are still pinned. This defer runs after batch cleanup.
    defer { if view != null { entity_view_close(view); } }
    defer {
        foreach(var result in &batch) {
            if result.stage != null {
                entity_stage_discard(result.stage);
                result.stage = null;
                result.function = null;
            }
            result.context = null;
        }
        // Admission and dispatch failures arrive here with no running workers.
        // Retire private ownership before invalidating the unsettled tickets.
        if !sem_ok(c) { work_cancel(&c.queries); }
        sem_workers_release(c, &receipt);
        work_vector_dispose(&batch);
    }
    var query = convert(u32, SemanticQuery.ExecutableFunction);
    var ticket: WorkTicket;
    while batch.length < SemanticPreparationWindow && work_take_query(&c.queries, &ticket, query) {
        var subject = work_task(&c.queries, ticket.task).subject;
        var result = bits(SemanticExecutable*, entity_component_data(entity_component_get(subject, c.executable_functions)));
        result.ticket = ticket;
        // A late stage can request a function after ordinary lowering. Its
        // canonical operations must be copied once, never lifted a second time.
        var preparation = work_find(&c.queries, subject, convert(u32, SemanticQuery.AggregatePrepare), 0);
        result.prepared = preparation != 0 && work_task(&c.queries, preparation).state == WorkState.Succeeded;
        var lowering = work_find(&c.queries, subject, convert(u32, SemanticQuery.Lowering), 0);
        result.lowered = lowering != 0 && work_task(&c.queries, lowering).state == WorkState.Succeeded;
        if (result.prepared && !vector_push(&result.query_reads, preparation))
            || (result.lowered && !vector_push(&result.query_reads, lowering)) {
            return sem_executable_resource(c, subject, WorkBudgetError.Memory);
        }
        var admission = work_vector_push_result(&batch, budget, result);
        if admission != WorkBudgetError.None { return sem_executable_resource(c, subject, admission); }
        result.stage = entity_stage_open_result(c.program.root, &admission);
        if result.stage == null { return sem_executable_resource(c, subject, admission); }
        admission = entity_stage_lease_result(result.stage, result.root);
        if admission != WorkBudgetError.None { return sem_executable_resource(c, subject, admission); }
    }
    if !work_ok(&c.queries) {
        foreach(var result in &batch) {
            entity_stage_discard(result.stage);
            result.stage = null;
            result.context = null;
        }
        sem_query_check(c, c.program.root, false);
        return SemanticPumpResult.Failed;
    }
    if batch.length == 0 { return sem_query_pending(c, query) ? SemanticPumpResult.Waiting : SemanticPumpResult.Complete; }
    var context: SemanticContext;
    sem_context_snapshot(&context, c);
    var view_error: WorkBudgetError;
    view = entity_view_open_result(c.program.root, &view_error);
    if view == null { return sem_executable_resource(c, batch.data[0].subject, view_error); }
    foreach(var result in &batch) { result.context = &context; }
    var extra: usize = 0;
    var admitted = sem_workers_admit_result(c, batch.length, &receipt, &extra);
    if admitted != WorkBudgetError.None { return sem_executable_resource(c, batch.data[0].subject, admitted); }
    var dispatched = compiler_kernel_dispatch_admitted_result(&c.workers, batch.data, batch.length, extra);
    // Joined private payloads must own their queued inputs before the last
    // lifetime pin closes, including the partial-dispatch failure path.
    foreach(var result in &batch) {
        var held = entity_stage_hold_result(result.stage);
        if held != WorkBudgetError.None {
            return sem_executable_resource(c, result.subject,
                dispatched != WorkBudgetError.None ? dispatched : held);
        }
    }
    entity_view_close(view);
    view = null;
    if dispatched != WorkBudgetError.None { return sem_executable_resource(c, batch.data[0].subject, dispatched); }
    foreach(var result in &batch) {
        var published = entity_stage_publish_result(result.stage);
        if published != WorkBudgetError.None { return sem_executable_resource(c, result.subject, published); }
        result.stage = null;
        result.context = null;
    }
    foreach(var result in &batch) {
        if !sem_query_check(c, result.subject, sem_query_observe_checked(c, &result.ticket, &result.query_reads)) {
            return SemanticPumpResult.Failed;
        }
        sem_evaluation_aliases(c, &result.aliases);
        c.count += result.count;
        if c.count > c.node_limit && result.resource.error == WorkBudgetError.None && result.error.length == 0 {
            sem_fail(c, result.subject, "Foundation component memory budget exceeded");
            result.error = c.program.error;
            result.error_offset = c.program.error_offset;
            c.program.error = default;
        }
        var input = bits(IMFunctionInput*, entity_component_data(entity_component_get(result.subject, c.executable_ready)));
        var ready = result.resource.error == WorkBudgetError.None && result.error.length == 0;
        if !sem_query_check(c, result.subject, work_finish(&c.queries, &result.ticket, ready)) {
            return SemanticPumpResult.Failed;
        }
        input.function = result.function;
        input.ready = ready;
    }
    return SemanticPumpResult.Progress;
}

fn sem_executable_failure(c: SemanticContext*, subject: void*): bool {
    var result = bits(SemanticExecutable*, entity_component_data(entity_component_get(subject, c.executable_functions)));
    if result == null { return false; }
    if sem_restore_resource(c, result.resource.error, &result.error, result.resource.offset) { return true; }
    if result.error.length == 0 || c.program.resource.error != WorkBudgetError.None { return false; }
    sem_fail(c, subject, result.error.data);
    c.program.error_offset = result.error_offset;
    return true;
}

fn sem_executables_dispose(c: SemanticContext*): void {
    if c.executable_functions == null { return; }
    for(var i: usize = 0; i < entity_query_count(c.executable_functions); i++) {
        var result = bits(SemanticExecutable*, entity_component_data(entity_query_at(c.executable_functions, i)));
        vector_dispose(&result.error);
        vector_dispose(&result.query_reads);
        vector_dispose(&result.aliases);
    }
}
