import tower;
import semantic_context_types;
import foundation_tags;
import foundation_types;
import semantic_context;
import semantic_control;
import semantic_evaluation;
import semantic_statements;
import semantic_support;
import semantic_types;
import .library.vector;
import .library.work_budget_types;

extern fn entity_stage_create_result(stage: void*, parent: void*, error: WorkBudgetError*): void*;

// Compilation-local scope analysis. Programs retain only ordinary Foundation
// blocks and operations; this list is neither a runtime stack nor a public IR.
struct SemanticDeferred {
    previous: SemanticDeferred*;
    body: void*;
    loops: usize;
    flow: u32;
}

fn sem_defer_copy_text(c: SemanticContext*, subject: void*, destination: vector(u8)*, source: vector(u8)*): bool {
    if source.length == 0 {
        return true;
    }
    if !vector_reserve(destination, source.length + 1) {
        sem_scratch_error(c, subject, WorkBudgetError.Memory);
        return false;
    }
    copy(destination.data, source.data, source.length);
    destination.data[source.length] = 0;
    destination.length = source.length;
    return true;
}

export fn sem_defer_clone(c: SemanticContext*, parent: void*, original: void*, clones: SemanticTable*, to: vector(void*)*): void* {
    if original == null || !sem_ok(c) {
        return null;
    }
    var found = sem_state(c, clones, original);
    if !sem_ok(c) { return default; }
    if found.value != null {
        return found.value;
    }
    var source = sem_get(original);
    if source == null {
        sem_fail(c, original, "Deferred cleanup has an unchecked operation");
        return null;
    }
    var error: WorkBudgetError;
    var entity = c.entity_stage == null ? sem_create_result(parent, &error)
        : entity_stage_create_result(c.entity_stage, parent, &error);
    if entity == null { sem_scratch_error(c, original, error); return null; }
    var value = sem_node_result(c, entity, source.kind);
    if value == null {
        // The private clone has no source match of its own. Retain the exact
        // producer cause, with the original operation's declaration position.
        c.program.resource.offset = source.start;
        c.program.error_offset = source.start;
        if c.entity_stage == null { sem_require(entity_attach_result(entity, null, null) == WorkBudgetError.None); }
        return null;
    }
    // Types and external bindings are shared references. Owned vectors and
    // operation edges are copied; a second pass remaps internal local bindings.
    copy(value, source, sizeof(FoundationNode));
    value.name = default;
    value.comments = default;
    fill(&value.items, 0, sizeof(vector(void*)));
    fill(&value.locals, 0, sizeof(vector(void*)));
    fill(&value.parameters, 0, sizeof(vector(void*)));
    fill(&value.attributes, 0, sizeof(vector(void*)));
    if !sem_defer_copy_text(c, original, &value.name, &source.name)
        || !sem_defer_copy_text(c, original, &value.comments, &source.comments) { return null; }
    sem_evaluation_clone(c, original, entity);
    if !sem_ok(c) || !sem_push_checked(c, to, entity) { return null; }
    found.value = entity;
    value.left = sem_defer_clone(c, entity, source.left, clones, to);
    value.right = sem_defer_clone(c, entity, source.right, clones, to);
    value.value = sem_defer_clone(c, entity, source.value, clones, to);
    value.target = sem_defer_clone(c, entity, source.target, clones, to);
    value.body = sem_defer_clone(c, entity, source.body, clones, to);
    value.otherwise = sem_defer_clone(c, entity, source.otherwise, clones, to);
    foreach(var & item in &source.items) {
        if !sem_push_checked(c, &value.items, sem_defer_clone(c, entity, *item, clones, to)) { return default; }
    }
    foreach(var & local in &source.locals) {
        if !sem_push_checked(c, &value.locals, sem_defer_clone(c, entity, *local, clones, to)) { return default; }
    }
    foreach(var & parameter in &source.parameters) {
        if !sem_push_checked(c, &value.parameters, sem_defer_clone(c, entity, *parameter, clones, to)) { return default; }
    }
    if !sem_ok(c) { found.value = null; return null; }
    if value.kind == KDeclare && !c.preserve_clone_storage {
        sem_add_local(c, entity);
    }
    return sem_ok(c) ? entity : null;
}

fn sem_defer_emit(c: SemanticContext*, block: void*, stop: void*, loops: usize): u32 {
    var pending = bits(SemanticDeferred*, c.deferred);
    var flow = FlowNext;
    while pending != bits(SemanticDeferred*, stop) && sem_ok(c) {
        if pending == null || pending.loops < loops {
            break;
        }
        var clones = sem_table(c);
        if !sem_ok(c) { return default; }
        var to = sem_list(c);
        if !sem_ok(c) { return default; }
        var body = sem_defer_clone(c, block, pending.body, clones, to);
        if !sem_ok(c) { return FlowStop; }
        foreach(var & to_item in to) {
            var value = sem_get(*to_item);
            if value.binding != null {
                var local = sem_find(clones, null, value.binding);
                if local != null {
                    value.binding = local.value;
                } else {
                    var binding = sem_get(value.binding);
                    if binding.kind == KDeclare || binding.kind == KParameter {
                        if c.defer_bindings == null {
                            c.defer_bindings = sem_table(c);
                            if !sem_ok(c) { return default; }
                            c.defer_order = sem_list(c);
                            if !sem_ok(c) { return default; }
                        }
                        var captured = sem_state(c, c.defer_bindings, value.binding);
                        if !sem_ok(c) { return default; }
                        if captured.value == null {
                            captured.value = value.binding;
                            if !sem_push_checked(c, c.defer_order, value.binding) { return default; }
                        }
                    }
                }
            }
        }
        if !sem_push_checked(c, &sem_get(block).items, body) { return default; }
        if(flow &FlowNext) != 0 {
            flow =(flow & ~FlowNext) | pending.flow;
        }
        pending = pending.previous;
    }
    return flow;
}

// An exit can occur inside a scope that shadows a captured source name. Give
// captured declarations unique Foundation spellings only after name resolution,
// so text reconstruction retains the direct bindings of the checked graph.
// Editor analysis keeps source names and never publishes an execution graph.
fn sem_defer_hygiene(c: SemanticContext*): void {
    if c.defer_bindings == null || c.editor != null || !sem_ok(c) {
        return;
    }
    // Encounter order is stable across hosts; pointer-keyed hash-table iteration
    // must never decide serialized names.
    foreach(var & defer_order_item in c.defer_order) {
        if !sem_set_name(c, sem_get(*defer_order_item), sem_control_name(c)) { return; }
    }
}

struct SemanticDeferCursor {
    deferred: void*;
    loops: usize;
    locals: usize;
    frame_size: usize;
}

fn sem_defer_begin(c: SemanticContext*, n: void*, depth: u32, state: SemanticDeferCursor*): bool {
    *state = default;
    if depth > 125 {
        sem_fail(c, n, "defer lowering exceeds Foundation block nesting limit of 128");
        return false;
    }
    if c.labels != null && c.labels.count != 0 {
        sem_fail(c, n, "defer cannot be combined with explicit function labels or jumps");
        return false;
    }
    sem_node(c, n, KBlock);
    c.has_defer = true;
    var function = sem_get(c.current);
    state.deferred = c.deferred;
    state.loops = c.loops;
    state.locals = function.locals.length;
    state.frame_size = function.frame_size;
    c.deferred = null;
    c.loops = 0;
    c.deferring++;
    return true;
}

fn sem_defer_finish(c: SemanticContext*, n: void*, state: SemanticDeferCursor*, flow: u32): u32 {
    c.deferring--;
    c.loops = state.loops;
    c.deferred = state.deferred;
    // The checked prototype is metadata, not an executable local allocation.
    // Each emitted cleanup owns fresh declarations and frame slots.
    var function = sem_get(c.current);
    function.locals.length = state.locals;
    function.frame_size = state.frame_size;
    if !sem_ok(c) {
        return FlowNext;
    }
    var pending = bits(SemanticDeferred*, sem_allocate(c, sizeof(SemanticDeferred)));
    if !sem_ok(c) { return default; }
    pending.previous = bits(SemanticDeferred*, state.deferred);
    pending.body = sem_member(n, "body");
    pending.loops = state.loops;
    pending.flow = flow;
    c.deferred = bits(void*, pending);
    return FlowNext;
}

fn sem_defer_register(c: SemanticContext*, n: void*, depth: u32): u32 {
    var state: SemanticDeferCursor;
    if !sem_defer_begin(c, n, depth, &state) { return FlowNext; }
    var flow = sem_statement(c, sem_member(n, "body"), depth + 1);
    return sem_defer_finish(c, n, &state, flow);
}

export fn sem_defer_exit(c: SemanticContext*, n: void*, flow: u32): u32 {
    if !sem_ok(c) { return FlowStop; }
    var value = sem_get(n);
    if value == null {
        return flow;
    }
    var returned = value.kind == KReturn;
    if returned && c.deferring != 0 {
        sem_fail(c, n, "A deferred cleanup cannot return from its enclosing function");
        return flow;
    }
    if !returned && value.kind != KBreak && value.kind != KContinue {
        return flow;
    }
    var pending = bits(SemanticDeferred*, c.deferred);
    if pending == null {
        return flow;
    }
    var loops: usize = 0;
    if !returned {
        loops = c.loops;
        if pending.loops < loops {
            return flow;
        }
    }
    var kind = value.kind;
    var result = value.value;
    value.kind = KBlock;
    value.value = null;
    // Evaluate a return value once before any cleanup can mutate its operands.
    if result != null {
        result = sem_control_read(c, n, sem_control_local(c, n, result));
        if !sem_ok(c) { return FlowStop; }
    }
    var cleanup = sem_defer_emit(c, n, null, loops);
    if !sem_ok(c) { return FlowStop; }
    var terminal = sem_control_node(c, n, kind);
    sem_get(terminal).value = result;
    if !sem_push_checked(c, &value.items, terminal) { return default; }
    if(cleanup &FlowNext) == 0 {
        return 0;
    }
    return flow;
}

fn sem_defer_depth(c: SemanticContext*, n: void*, depth: u32): void {
    if n == null || !sem_ok(c) {
        return;
    }
    if depth > ControlBlockNestingLimit {
        sem_fail(c, n, "defer expansion exceeds Foundation block nesting limit of 128");
        return;
    }
    var value = sem_get(n);
    if value == null {
        return;
    }
    if value.kind == KBlock || value.kind == KProgram {
        var child_depth = depth;
        if value.kind == KBlock {
            child_depth++;
        }
        for(var i: usize = 0; i < value.items.length && sem_ok(c); i++) {
            sem_defer_depth(c, value.items.data[i], child_depth);
        }
    }
    if value.kind == KIf || value.kind == KLoop {
        sem_defer_depth(c, value.body, depth);
        sem_defer_depth(c, value.otherwise, depth);
    }
}
