import tower;
import .library.work_buffer;
import .library.work_buffer_types;
import .library.work_vector;
import lr_parser;
import parser_nodes;
import syntax_highlights;
import syntax_session_inputs;
import syntax_session_pins;
import syntax_session_types;
import syntax_version_cache;
import .library.vector;
import .library.work_budget_types;

extern fn compiler_buffer_free(memory: void*): void;
extern fn compiler_world_work_budget(world: void*): WorkBudget*;

export fn syntax_session_allocate(world: void*, environment: void*): SyntaxSession* {
    var error = WorkBudgetError.None;
    return syntax_session_allocate_result(world, environment, &error);
}

export fn syntax_session_allocate_result(world: void*, environment: void*, error: WorkBudgetError*): SyntaxSession* {
    var storage: WorkBuffer = default;
    *error = work_buffer_resize(&storage, compiler_world_work_budget(world), sizeof(SyntaxSession), 0);
    if *error != WorkBudgetError.None { return null; }
    var value = bits(SyntaxSession*, storage.data);
    *value = default;
    value.storage = storage;
    value.inputs.world = world;
    value.inputs.environment = environment;
    value.declarations_only = true;
    return value;
}

export fn syntax_session_completion(value: SyntaxSession*, completion: LRCompletion*): void {
    lr_completion_destroy(bits(LRCompletion*, value.completion));
    value.completion = bits(void*, completion);
}

export fn syntax_session_suffix(value: SyntaxSession*, text: u8*): u8* {
    compiler_buffer_free(bits(void*, value.completion_suffix));
    value.completion_suffix = text;
    return text;
}

export fn syntax_session_progress(value: SyntaxSession*): void {
    value.resource_error = WorkBudgetError.None;
    value.source = value.inputs.source ?. text.data;
    value.source_length = value.inputs.source ?. text.length ?? 0;
    value.cursor = 0;
    value.revision = 0;
    value.error_offset = 0;
    value.error_insertion = false;
    value.cache.index.builds = 0;
    value.cache.index.hits = 0;
    fill(&value.expansion_stats, 0, sizeof(SyntaxSessionExpansionStats));
    value.finalized = false;
    value.declarations_only = true;
    value.comment_cursor = 0;
    value.declaration = false;
    value.error.length = 0;
    value.error_fallback = null;
    if value.error.data is not null { value.error.data[0] = 0; }
    syntax_highlights_clear(&value.highlights);
    syntax_session_pin_revision(&value.pins.grammar, value.pins.baseline);
}

export fn syntax_destroy(opaque: void*): void {
    var value = bits(SyntaxSession*, opaque);
    if value is null { return; }
    // Completion data is gone before the version/table it borrows can disappear.
    lr_completion_destroy(bits(LRCompletion*, value.completion));
    compiler_buffer_free(bits(void*, value.completion_suffix));
    syntax_version_cache_dispose(&value.cache);
    syntax_session_inputs_dispose(&value.inputs);
    syntax_session_pins_dispose(&value.pins);
    syntax_highlights_dispose(&value.highlights);
    work_vector_dispose(&value.error);
    var storage = value.storage;
    work_buffer_dispose(&storage);
}
