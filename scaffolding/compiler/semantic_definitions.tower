import tower;
import foundation_tags;
import semantic_support;

// Shared semantic spellings and arities for Foundation checking and formatting.
// Numeric tags are defined in foundation_tags on the shared component model,
// not a public instruction encoding; coordinate any renumbering.
export fn semantic_scalar_name(scalar: u32): u8* {
    if scalar == SI32() {
        return "i32";
    }
    if scalar == SU32() {
        return "u32";
    }
    if scalar == SBool() {
        return "bool";
    }
    if scalar == SVoid() {
        return "void";
    }
    if scalar == SStruct() {
        return "";
    }
    if scalar == SU8() {
        return "u8";
    }
    if scalar == SI64() {
        return "i64";
    }
    if scalar == SU64() {
        return "u64";
    }
    if scalar == SUSize() {
        return "usize";
    }
    return "";
}

export fn semantic_operator(op: u32): u8* {
    if op == OAdd() {
        return "+";
    }
    if op == OSub() {
        return "-";
    }
    if op == OMul() {
        return "*";
    }
    if op == ODiv() {
        return "/";
    }
    if op == ORem() {
        return "%";
    }
    if op == OAnd() {
        return "&";
    }
    if op == OOr() {
        return "|";
    }
    if op == OXor() {
        return "^";
    }
    if op == OEq() {
        return "==";
    }
    if op == ONe() {
        return "!=";
    }
    if op == OLt() {
        return "<";
    }
    if op == OLe() {
        return "<=";
    }
    if op == OGt() {
        return ">";
    }
    if op == OGe() {
        return ">=";
    }
    return "";
}

export fn semantic_builtin_name(kind: u32): u8* {
    if kind == 31 {
        return "label";
    }
    if kind == 32 {
        return "jump";
    }
    if kind == 33 {
        return "trap";
    }
    if kind == KPrint() {
        return "print";
    }
    if kind == KAllocate() {
        return "alloc";
    }
    if kind == KReallocate() {
        return "realloc";
    }
    if kind == KFree() {
        return "free";
    }
    if kind == KCopy() {
        return "copy";
    }
    if kind == KFill() {
        return "fill";
    }
    if kind == KSizeOf() {
        return "sizeof";
    }
    if kind == KAlignOf() {
        return "alignof";
    }
    if kind == KConvert() {
        return "convert";
    }
    if kind == KBits() {
        return "bits";
    }
    return null;
}

export fn semantic_builtin_arity(kind: u32): usize {
    if kind == 31 {
        return 1;
    }
    if kind == 32 {
        return 1;
    }
    if kind == 33 {
        return 2;
    }
    if kind == KPrint() {
        return 1;
    }
    if kind == KAllocate() {
        return 2;
    }
    if kind == KReallocate() {
        return 3;
    }
    if kind == KFree() {
        return 1;
    }
    if kind == KCopy() {
        return 3;
    }
    if kind == KFill() {
        return 3;
    }
    if kind == KSizeOf() {
        return 1;
    }
    if kind == KAlignOf() {
        return 1;
    }
    if kind == KConvert() {
        return 2;
    }
    if kind == KBits() {
        return 2;
    }
    return 0;
}

fn semantic_builtin_type_argument(kind: u32, index: usize): bool {
    return index == 0 && (kind == KSizeOf() || kind == KAlignOf()
        || kind == KConvert() || kind == KBits() || kind == KAllocate() || kind == KReallocate());
}

export fn semantic_builtin_kind(name: u8*): u32 {
    if sem_equal(name, "label") {
        return 31;
    }
    if sem_equal(name, "jump") {
        return 32;
    }
    if sem_equal(name, "trap") {
        return 33;
    }
    if sem_equal(name, "print") {
        return 17;
    }
    if sem_equal(name, "alloc") {
        return 26;
    }
    if sem_equal(name, "realloc") {
        return 27;
    }
    if sem_equal(name, "free") {
        return 28;
    }
    if sem_equal(name, "copy") {
        return 29;
    }
    if sem_equal(name, "fill") {
        return 30;
    }
    if sem_equal(name, "sizeof") {
        return 24;
    }
    if sem_equal(name, "alignof") {
        return 25;
    }
    if sem_equal(name, "convert") {
        return 9;
    }
    if sem_equal(name, "bits") {
        return 10;
    }
    return 0;
}

export fn semantic_builtin_at(index: usize): u32 {
    if index == 10 {
        return 31;
    }
    if index == 11 {
        return 32;
    }
    if index == 12 {
        return 33;
    }
    if index == 0 {
        return 17;
    }
    if index == 1 {
        return 26;
    }
    if index == 2 {
        return 27;
    }
    if index == 3 {
        return 28;
    }
    if index == 4 {
        return 29;
    }
    if index == 5 {
        return 30;
    }
    if index == 6 {
        return 24;
    }
    if index == 7 {
        return 25;
    }
    if index == 8 {
        return 9;
    }
    if index == 9 {
        return 10;
    }
    return 0;
}
