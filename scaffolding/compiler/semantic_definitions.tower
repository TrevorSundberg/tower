import tower;
import foundation_tags;
import semantic_support;

// Shared semantic spellings and arities for Foundation checking and formatting.
// Numeric tags are defined in foundation_tags on the shared component model,
// not a public instruction encoding; coordinate any renumbering.
var FoundationParameterLimit: usize = 64;
enum FoundationBuiltinIndex: u32 {
    Print, Allocate, Reallocate, Free, Copy, Fill, SizeOf, AlignOf, Convert, Bits, Label, Jump, Trap, TypeValue
}

export fn semantic_scalar_name(scalar: u32): u8* {
    if scalar == SType { return "type"; }
    if scalar == SI8 { return "i8"; }
    if scalar == SI16 { return "i16"; }
    if scalar == SU16 { return "u16"; }
    if scalar == SF32 { return "f32"; }
    if scalar == SF64 { return "f64"; }
    if scalar == SI32 {
        return "i32";
    }
    if scalar == SU32 {
        return "u32";
    }
    if scalar == SBool {
        return "bool";
    }
    if scalar == SVoid {
        return "void";
    }
    if scalar == SStruct {
        return "";
    }
    if scalar == SU8 {
        return "u8";
    }
    if scalar == SI64 {
        return "i64";
    }
    if scalar == SU64 {
        return "u64";
    }
    if scalar == SUSize {
        return "usize";
    }
    return "";
}

export fn semantic_operator(op: u32): u8* {
    if op == OAdd {
        return "+";
    }
    if op == OSub {
        return "-";
    }
    if op == OMul {
        return "*";
    }
    if op == ODiv {
        return "/";
    }
    if op == ORem {
        return "%";
    }
    if op == OAnd {
        return "&";
    }
    if op == OOr {
        return "|";
    }
    if op == OXor {
        return "^";
    }
    if op == OEq {
        return "==";
    }
    if op == ONe {
        return "!=";
    }
    if op == OLt {
        return "<";
    }
    if op == OLe {
        return "<=";
    }
    if op == OGt {
        return ">";
    }
    if op == OGe {
        return ">=";
    }
    return "";
}

export fn semantic_builtin_name(kind: u32): u8* {
    if kind == KTypeReference { return "type_value"; }
    if kind == 31 {
        return "label";
    }
    if kind == 32 {
        return "jump";
    }
    if kind == 33 {
        return "trap";
    }
    if kind == KPrint {
        return "print";
    }
    if kind == KAllocate {
        return "alloc";
    }
    if kind == KReallocate {
        return "realloc";
    }
    if kind == KFree {
        return "free";
    }
    if kind == KCopy {
        return "copy";
    }
    if kind == KFill {
        return "fill";
    }
    if kind == KSizeOf {
        return "sizeof";
    }
    if kind == KAlignOf {
        return "alignof";
    }
    if kind == KConvert {
        return "convert";
    }
    if kind == KBits {
        return "bits";
    }
    return null;
}

export fn semantic_builtin_arity(kind: u32): usize {
    if kind == KTypeReference { return 1; }
    if kind == 31 {
        return 1;
    }
    if kind == 32 {
        return 1;
    }
    if kind == 33 {
        return 2;
    }
    if kind == KPrint {
        return 1;
    }
    if kind == KAllocate {
        return 2;
    }
    if kind == KReallocate {
        return 3;
    }
    if kind == KFree {
        return 1;
    }
    if kind == KCopy {
        return 3;
    }
    if kind == KFill {
        return 3;
    }
    if kind == KSizeOf {
        return 1;
    }
    if kind == KAlignOf {
        return 1;
    }
    if kind == KConvert {
        return 2;
    }
    if kind == KBits {
        return 2;
    }
    return 0;
}

fn semantic_builtin_type_argument(kind: u32, index: usize): bool {
    return index == 0 && (kind == KSizeOf || kind == KAlignOf
        || kind == KConvert || kind == KBits || kind == KAllocate || kind == KReallocate || kind == KTypeReference);
}

export fn semantic_builtin_kind(name: u8*): u32 {
    if sem_equal(name, "type_value") { return KTypeReference; }
    if sem_equal(name, "label") {
        return KLabel;
    }
    if sem_equal(name, "jump") {
        return KJump;
    }
    if sem_equal(name, "trap") {
        return KTrap;
    }
    if sem_equal(name, "print") {
        return KPrint;
    }
    if sem_equal(name, "alloc") {
        return KAllocate;
    }
    if sem_equal(name, "realloc") {
        return KReallocate;
    }
    if sem_equal(name, "free") {
        return KFree;
    }
    if sem_equal(name, "copy") {
        return KCopy;
    }
    if sem_equal(name, "fill") {
        return KFill;
    }
    if sem_equal(name, "sizeof") {
        return KSizeOf;
    }
    if sem_equal(name, "alignof") {
        return KAlignOf;
    }
    if sem_equal(name, "convert") {
        return KConvert;
    }
    if sem_equal(name, "bits") {
        return KBits;
    }
    return 0;
}

export fn semantic_builtin_at(index: usize): u32 {
    if index == convert(usize, FoundationBuiltinIndex.Print) { return KPrint; }
    if index == convert(usize, FoundationBuiltinIndex.Allocate) { return KAllocate; }
    if index == convert(usize, FoundationBuiltinIndex.Reallocate) { return KReallocate; }
    if index == convert(usize, FoundationBuiltinIndex.Free) { return KFree; }
    if index == convert(usize, FoundationBuiltinIndex.Copy) { return KCopy; }
    if index == convert(usize, FoundationBuiltinIndex.Fill) { return KFill; }
    if index == convert(usize, FoundationBuiltinIndex.SizeOf) { return KSizeOf; }
    if index == convert(usize, FoundationBuiltinIndex.AlignOf) { return KAlignOf; }
    if index == convert(usize, FoundationBuiltinIndex.Convert) { return KConvert; }
    if index == convert(usize, FoundationBuiltinIndex.Bits) { return KBits; }
    if index == convert(usize, FoundationBuiltinIndex.Label) { return KLabel; }
    if index == convert(usize, FoundationBuiltinIndex.Jump) { return KJump; }
    if index == convert(usize, FoundationBuiltinIndex.Trap) { return KTrap; }
    if index == convert(usize, FoundationBuiltinIndex.TypeValue) { return KTypeReference; }
    return 0;
}
