// Semantic compiler over shared Foundation components.
// Temporary indexes and scratch allocations are scoped to one compilation.

fn sem_track(c: SemanticContext*, data: u8*): void {
    var step1 = bits(void*, data);
    sem_require(vector_push(&c.allocations, step1));
}

fn sem_context_init(c: SemanticContext*, program: SemanticProgram*): void {
    var step1 = sizeof(SemanticContext);
    fill(c, 0, step1);
    c.program = program;
    c.current = program.root;
    c.node_limit = SemanticComponentBudgetBytes / sizeof(FoundationNode);
    var step2 = sem_table(c);
    c.functions = step2;
    var step3 = sem_table(c);
    c.types = step3;
    var step4 = sem_table(c);
    c.globals = step4;
    var step5 = sem_table(c);
    c.templates = step5;
    var step6 = sem_table(c);
    c.type_functions = step6;
    var step7 = sem_table(c);
    c.type_results = step7;
    var step8 = sem_table(c);
    c.source_names = step8;
    var step9 = sem_table(c);
    c.source_bases = step9;
    c.output_names = sem_table(c);
    var step10 = sem_table(c);
    c.fields_done = step10;
    work_init(&c.queries, 1, convert(u64, program.pointer_bytes));
    var step13 = sem_scope(c, null);
    c.scope = step13;
    foreach(var n in &program.types) {
        var step17 = sem_name(sem_get(n));
        sem_put(c, c.types, step17, n);
    }
}

fn sem_context_dispose(c: SemanticContext*): void {
    sem_layout_dispose(c);
    sem_evaluation_dispose(c);
    vector_dispose(&c.flow_dependencies);
    sem_declaration_dispose(c);
    sem_generic_body_dispose(c);
    stack_dispose(&c.scan);
    vector_dispose(&c.token_text);
    work_dispose(&c.queries);
    var i: usize = 0;
    for(; i < c.lists.length; i++) {
        var step3 = bits(vector(void*)*, c.lists.data[i]);
        vector_dispose(step3);
    }
    vector_dispose(&c.lists);
    vector_dispose(&c.type_arguments);
    vector_dispose(&c.constant_arguments);
    vector_dispose(&c.generated);
    vector_dispose(&c.template_nodes);
    vector_dispose(&c.inferring);
    i = 0;
    for(; i < c.allocations.length; i++) {
        free(c.allocations.data[i]);
    }
    vector_dispose(&c.allocations);
}

export fn semantic_initialize(program: SemanticProgram*, root: void*, width: u32): void {
    var step1 = sizeof(SemanticProgram);
    fill(program, 0, step1);
    program.pointer_bytes = width;
    program.root = root;
    var n: FoundationNode* = sem_attach(root, KProgram);
    n.type.scalar = SVoid;
    sem_push(&program.functions, root);
    var scalar: u32 = 0;
    loop {
        if scalar >= FoundationScalarLimit {
            break;
        }
        if scalar == SStruct || scalar == SArray || scalar == SFunction {
            scalar++;
            continue;
        }
        var entity: void* = sem_create(root);
        var t: FoundationNode* = sem_attach(entity, KType);
        t.type.scalar = scalar;
        t.type.pointer_bytes = width;
        var step8 = semantic_scalar_name(scalar);
        sem_set_name(t, step8);
        var step9 = semantic_size(&t.type);
        t.size = step9;
        var step10 = semantic_alignment(&t.type);
        t.alignment = step10;
        sem_push(&program.types, entity);
        scalar++;
    }
}

export fn semantic_compile_budget(program: SemanticProgram*, roots: void**, bases: usize*, count: usize, source: u8*, component_bytes: usize): void {
    var context: SemanticContext;
    var c: SemanticContext* = &context;
    sem_context_init(c, program);
    c.node_limit = component_bytes / sizeof(FoundationNode);
    c.source = source;
    var step1 = generic_begin(program.root);
    c.generics = step1;
    for(var i: usize = 0; i < count; i++) {
        var step4 = sem_state(c, c.source_bases, roots[i]);
        step4.number = bases[i];
    }
    sem_run(c);
    sem_defer_hygiene(c);
    sem_known_infer(c);
    sem_lower_expressions(c);
    sem_defer_validate(c);
    sem_evaluations(c);
    sem_attributes_publish(c);
    sem_known_publish(c);
    sem_module_initializers(c);
    sem_flows(c);
    sem_context_dispose(c);
}

export fn semantic_compile(program: SemanticProgram*, roots: void**, bases: usize*, count: usize, source: u8*): void {
    semantic_compile_budget(program, roots, bases, count, source, SemanticComponentBudgetBytes);
}

export fn semantic_program_dispose(program: SemanticProgram*): void {
    vector_dispose(&program.functions);
    vector_dispose(&program.types);
    vector_dispose(&program.error);
}

export fn semantic_format_type(t: FoundationType*, output: vector(u8)*): void {
    var context: SemanticContext;
    var program: SemanticProgram;
    var step1 = sizeof(SemanticContext);
    fill(&context, 0, step1);
    var step2 = sizeof(SemanticProgram);
    fill(&program, 0, step2);
    context.program = &program;
    var text: u8* = sem_type_name(&context, t);
    var count: usize = sem_length(text);
    var step5 = count + 1;
    sem_require(vector_reserve(output, step5));
    var step7 = count + 1;
    copy(output.data, text, step7);
    output.length = count;
    sem_context_dispose(&context);
}

export fn semantic_format_number(value: u64, t: FoundationType*, output: vector(u8)*): void {
    var context: SemanticContext;
    var step1 = sizeof(SemanticContext);
    fill(&context, 0, step1);
    var text: u8* = sem_number(&context, value, t);
    var count: usize = sem_length(text);
    var step4 = count + 1;
    sem_require(vector_reserve(output, step4));
    var step6 = count + 1;
    copy(output.data, text, step6);
    output.length = count;
    sem_context_dispose(&context);
}
