import tower;
import interpreter_types;
import foundation_types;
import .library.vector;
import .library.work_vector_types;
import .library.work_budget_types;

// One reached constructor retains evaluated operands until the coordinator
// publishes a descriptor. Owner and sequence distinguish recursion/loop visits;
// private type-value indexes never cross this invocation boundary.
struct IMTypeConstruction {
    owner: void*;
    subject: void*;
    sequence: usize;
    kind: u32;
    first: u64;
    second: u64;
    input: FoundationType;
    result: FoundationType;
    error: work_vector(u8);
    budget: WorkBudget*;
    storage_error: WorkBudgetError;
    ready: bool;
    failed: bool;
}

// Derived projections of an already-published aggregate value. The owning
// evaluation retains this array; consumers borrow its frozen canonical leaves.
struct IMValueProjection {
    subject: void*;
    field: void*;
    parent: usize;
    index: usize;
    type: FoundationType;
    byte_offset: usize;
}

// Private target-byte copies belong to the frame that first consumes an input.
// They survive nested calls and statement-cache resets, never another invocation.
struct IMValueStorage { producer: void*; address: usize; bytes: usize; frame: usize; }

// An invocation context belongs to its evaluation request, which may be a
// shared compiler entity. No ambient world, host address table or TLS lookup is
// needed. Host clients share these Tower layouts and rebuild with the engines.
struct IMContext {
    root: void*;
    pointer_bytes: usize;
    error: work_vector(u8);
    output: work_vector(u8);
    result: u64;
    returned: bool;
    strict: bool;
    fuel: u64;
    initialized: work_vector(u8);
    dependency_kind: void*;
    value_inputs: void*;
    require_relocatable: bool;
    type_arguments: bool;
    executable_functions: void*;
    waiting_function: bool;
    waiting_binding: bool;
    capture_order: bool;
    capture_ordinal: usize;
    waiting: void*;
    retain_result_storage: bool;
    construct_types: bool;
    waiting_type: bool;
    type_construction: IMTypeConstruction;
    input_storage: work_vector(IMValueStorage);
}

// Shared query metadata; the evaluator reads readiness, while only the
// coordinator materializes the Foundation constant and publishes readiness.
struct IMDependency {
    ready: bool;
    failed: bool;
    subject: void*;
    source: IMDependency*;
}

// Both producers are ordinary Foundation values published through the graph.
// Required capture proof owns producer/owner/ordinal. Optional inference owns
// known_producer and cannot borrow a value proved only for a required stage.
// A local's own invocation still reads its normal stack storage.
struct IMValueInput {
    producer: void*;
    owner: void*;
    ordinal: usize;
    known_producer: void*;
    projections: IMValueProjection*;
    projection_count: usize;
    aggregate: bool;
}

// The compiler can prepare an executable snapshot lazily without changing the
// source function's signature or declaration identity. The interpreter retains
// source function references; this mapping selects only its execution body.
struct IMFunctionInput { function: void*; ready: bool; failed: bool; }

struct IMExecution {
    state: IMState*;
    context: IMContext*;
}

struct IMInvocation {
    state: IMState;
    context: IMContext;
}
