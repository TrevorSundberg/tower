import tower;
import format_types;
import .library.vector;
import format_api;
import parser_types;
import format_parser_table;
import format_syntax_preview;
import format_diagnostic;

// Diagnostic views use the shared formatter and graph. They are not program
// serialization; format_entity remains the canonical foundation spelling.
struct FormatTreeEntry {
    node: void*;
    depth: usize;
    member: u8*;
}

extern fn entity_child_index(parent: void*, child: void*): usize;

extern fn entity_parent(node: void*): void*;

extern fn entity_child_name(parent: void*, index: usize): u8*;

extern fn entity_child_count(parent: void*): usize;

extern fn entity_child_at(parent: void*, index: usize): void*;

extern fn parser_match_get_type(): void*;

extern fn tower_memory_allocate(bytes: usize): void*;

extern fn abort(): void;

fn format_parser_no_rule(): usize {
    var invalid: usize = 0;
    invalid--;
    return invalid;
}

fn format_tree_push(pending: vector(FormatTreeEntry)*, node: void*, depth: usize, member: u8*): bool {
    var needed = pending.length + 1;
    var overflow = needed == 0;
    if overflow {
        return false;
    }
    var ok = vector_reserve(FormatTreeEntry, pending, needed);
    if ok {
        var entry = &pending.data[pending.length];
        entry.node = node;
        entry.depth = depth;
        entry.member = member;
        pending.length = needed;
    }
    return ok;
}

// The caller keeps the graph and component kind alive and immutable for this
// query. No global world lookup, graph mutation or borrowed pointer escapes.
export fn format_parser_tree(result: FormatResult*, root: void*, kind: void*): void {
    var f: FormatEngine;
    fill(&f, 0, sizeof(FormatEngine));
    f.result = result;
    f.match_kind = kind;
    var empty = root == null;
    if empty {
        format_text(&f, "<empty tree>\n");
        return;
    }
    var member: u8* = null;
    var parent = entity_parent(root);
    var attached = parent != null;
    if attached {
        member = entity_child_name(parent, entity_child_index(parent, root));
    }
    var pending: vector(FormatTreeEntry);
    vector_init(FormatTreeEntry, &pending);
    var ok = format_tree_push(&pending, root, 0, member);
    if !ok {
        result.failed = true;
    }
    while pending.length != 0 {
        if result.failed {
            break;
        }
        pending.length--;
        var entry = &pending.data[pending.length];
        var node = entry.node;
        var depth = entry.depth;
        member = entry.member;
        var indent = depth *2;
        var overflow = indent < depth;
        if overflow {
            result.failed = true;
            break;
        }
        format_repeat(&f, 32, indent);
        var named = member != null;
        named &&= *member != 0;
        if named {
            format_text(&f, member);
            format_text(&f, ": ");
        }
        var span = format_match(&f, node);
        var matched = span != null;
        if matched {
            var rule = span.rule != format_parser_no_rule();
            if rule {
                format_text(&f, "rule ");
            } else {
                format_text(&f, "token ");
            }
            var label = span.label.length != 0;
            if label {
                format_bytes(&f, &span.label);
            } else {
                format_unsigned(&f, convert(u64, span.id));
            }
            if rule {
                format_text(&f, " #");
                format_unsigned(&f, convert(u64, span.rule));
            }
            format_text(&f, " [");
            format_unsigned(&f, convert(u64, span.start));
            format_text(&f, ", ");
            var end = span.start + span.length;
            format_unsigned(&f, convert(u64, end));
            format_text(&f, ")");
        } else {
            format_text(&f, "node");
        }
        format_char(&f, 10);
        var count = entity_child_count(node);
        var next_depth = depth + 1;
        while count != 0 {
            count--;
            ok = format_tree_push(&pending, entity_child_at(node, count), next_depth, entity_child_name(node, count));
            if !ok {
                result.failed = true;
                break;
            }
        }
    }
    vector_dispose(FormatTreeEntry, &pending);
}

enum ParserScalar: u32 {
    Nul = 0,
    Tab = 9,
    LineFeed = 10,
    CarriageReturn = 13,
    Quote = 39,
    Backslash = 92
}

fn format_parser_escape(id: u32): u8* {
    var scalar = convert(ParserScalar, id);
    match scalar {
        ParserScalar.Nul => {
            return "'\\0'";
        }
        ParserScalar.Tab => {
            return "'\\t'";
        }
        ParserScalar.LineFeed => {
            return "'\\n'";
        }
        ParserScalar.CarriageReturn => {
            return "'\\r'";
        }
        ParserScalar.Quote => {
            return "'\\\''";
        }
        ParserScalar.Backslash => {
            return "'\\\\'";
        }
        _ => {
            return null;
        }
    }
}

extern fn tower_utf8_encode(id: u32, output: u8*, capacity: usize): usize;

// Invalid scalars leave the result unchanged. Allocation failure is reported
// through FormatResult.failed, as with the other shared formatting operations.
export fn format_parser_scalar(result: FormatResult*, id: u32): bool {
    var encoded: u8[4];
    var count = tower_utf8_encode(id, &encoded[0], 4);
    var invalid = count == 0;
    if invalid {
        return false;
    }
    var f: FormatEngine;
    fill(&f, 0, sizeof(FormatEngine));
    f.result = result;
    var escaped = format_parser_escape(id);
    var special = escaped != null;
    if special {
        format_text(&f, escaped);
    } else {
        format_char(&f, convert(u8, ParserScalar.Quote));
        format_write(&f, &encoded[0], count);
        format_char(&f, convert(u8, ParserScalar.Quote));
    }
    return true;
}

export fn format_parser_host_text(result: FormatResult*): u8* {
    var size = result.text.length + 1;
    var overflow = size == 0;
    if overflow {
        result.failed = true;
    }
    if result.failed {
        format_dispose(result);
        abort();
        return null;
    }
    var text = bits(u8*, tower_memory_allocate(size));
    var missing = text == null;
    if missing {
        format_dispose(result);
        abort();
        return null;
    }
    copy(text, result.text.data, result.text.length);
    text[result.text.length] = 0;
    format_dispose(result);
    return text;
}

// Existing host ABI and allocator ownership. The implementation stays in Tower.
// Labels already have their spelling; allocate only the final host-owned string.
// This is the same direct-output approach as the bounded scalar formatter below.
export fn format_parser_label_text(text: u8*, length: usize, prefix: u8*, suffix: u8*): u8* {
    var before: usize = 0;
    while prefix[before] != 0 { ++before; }
    var after: usize = 0;
    while suffix[after] != 0 { ++after; }
    var size = length + before;
    var end = size + after;
    var capacity = end + 1;
    if size < length || end < size || capacity == 0 { abort(); return null; }
    var output = bits(u8*, tower_memory_allocate(capacity));
    if output is null { abort(); return null; }
    copy(output, prefix, before);
    copy(&output[before], text, length);
    copy(&output[size], suffix, after);
    output[end] = 0;
    return output;
}

export fn parser_tree_debug_string(root: void*): u8* {
    var result: FormatResult;
    fill(&result, 0, sizeof(FormatResult));
    var kind: void* = null;
    var present = root != null;
    if present {
        kind = parser_match_get_type();
    }
    format_parser_tree(&result, root, kind);
    return format_parser_host_text(&result);
}

export fn parser_table_utf8_id_to_string(userdata: void*, id: u32): u8* {
    // One scalar needs at most four UTF-8 bytes plus quotes. Use bounded scratch
    // storage so this hot host path still allocates only its returned string.
    var scratch: u8[6];
    var result: FormatResult;
    fill(&result, 0, sizeof(FormatResult));
    result.text.data = &scratch[0];
    result.text.capacity = 6;
    var valid = format_parser_scalar(&result, id);
    if !valid {
        return null;
    }
    var size = result.text.length + 1;
    var text = bits(u8*, tower_memory_allocate(size));
    var missing = text == null;
    if missing {
        abort();
        return null;
    }
    copy(text, result.text.data, result.text.length);
    text[result.text.length] = 0;
    return text;
}
