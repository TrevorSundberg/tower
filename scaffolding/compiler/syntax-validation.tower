// Disposable revision analysis over shared grammar entities. Only lookup and
// dependency indexes live here; declarations remain the authoritative nodes.
struct SyntaxRuleView {
    name: u8*;
    name_length: usize;
    alternatives: void**;
    count: usize;
}

struct SyntaxDependent {
    owner: usize;
    term: void*;
}

struct SyntaxRuleState {
    dependents: vector(SyntaxDependent);
    nullable: bool;
    productive: bool;
}

struct SyntaxValidation {
    rules: SyntaxRuleView*;
    count: usize;
    tokens: void**;
    token_count: usize;
    kind: void*;
    states: vector(SyntaxRuleState);
    pending: void**;
    queue: vector(usize);
    captures: vector(SyntaxNode*);
    error: vector(u8)*;
    offset: usize*;
    allocated: bool;
}

fn syntax_validation_node(value: SyntaxValidation*, node: void*): SyntaxNode* {
    var component = entity_component_get(node, value.kind);
    return bits(SyntaxNode*, entity_component_data(component));
}

fn syntax_bytes_compare(left: u8*, left_length: usize, right: u8*, right_length: usize): i32 {
    var index: usize = 0;
    loop {
        var end = index == left_length;
        if end {
            var same = index == right_length;
            if same {
                return 0;
            }
            return -1;
        }
        end = index == right_length;
        if end {
            return 1;
        }
        var less = left[index] < right[index];
        if less {
            return -1;
        }
        var greater = left[index] > right[index];
        if greater {
            return 1;
        }
        index = index + 1;
    }
}

fn syntax_validation_find(value: SyntaxValidation*, name: u8*, length: usize): usize {
    var low: usize = 0;
    var high = value.count;
    loop {
        var done = low == high;
        if done {
            return lr_none();
        }
        var middle = high - low;
        middle = middle / 2;
        middle = middle + low;
        var rule = &value.rules[middle];
        var order = syntax_bytes_compare(name, length, rule.name, rule.name_length);
        var same = order == 0;
        if same {
            return middle;
        }
        var less = order < 0;
        if less {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
}

fn syntax_validation_token(value: SyntaxValidation*, text: u8*, length: usize, skipped: bool): bool {
    var index: usize = 0;
    loop {
        var done = index == value.token_count;
        if done {
            return false;
        }
        var node = syntax_validation_node(value, value.tokens[index]);
        var eligible = node.kind != 3;
        if skipped {
            eligible = true;
        }
        if eligible {
            var order = syntax_bytes_compare(text, length, node.name.data, node.name.length);
            var same = order == 0;
            if same {
                return true;
            }
        }
        index = index + 1;
    }
}

fn syntax_validation_append(value: SyntaxValidation*, text: u8*, length: usize): void {
    if value.allocated {
        value.allocated = bytes_append(value.error, text, length);
    }
}

fn syntax_validation_text(value: SyntaxValidation*, text: u8*): void {
    var length = syntax_text_length(text);
    syntax_validation_append(value, text, length);
}

fn syntax_validation_error(value: SyntaxValidation*, prefix: u8*, text: u8*, length: usize): bool {
    syntax_validation_text(value, prefix);
    syntax_validation_append(value, text, length);
    return false;
}

fn syntax_validation_location(value: SyntaxValidation*, node: SyntaxNode*): void {
    var located = node.start != lr_none();
    if located {
        *value.offset = node.start;
    }
}

// Reuse a borrowed-name hash set for each alternative. Its capacity is bounded
// by the largest sequence, without copying capture names or rescanning prefixes.
fn syntax_validation_captures(value: SyntaxValidation*, count: usize): bool {
    var size = count * 2;
    var overflow = size < count;
    if overflow {
        value.allocated = false;
        return false;
    }
    size = size + 1;
    value.allocated = vector_reserve(SyntaxNode*, &value.captures, size);
    if value.allocated {
        value.captures.length = size;
        var bytes = size * sizeof(SyntaxNode*);
        fill(value.captures.data, 0, bytes);
    }
    return value.allocated;
}

fn syntax_validation_capture(value: SyntaxValidation*, term: SyntaxNode*): bool {
    var empty = term.capture.length == 0;
    if empty {
        return true;
    }
    var hash: usize = 2166136261;
    var index: usize = 0;
    loop {
        var done = index == term.capture.length;
        if done {
            break;
        }
        var byte = convert(usize, term.capture.data[index]);
        hash = hash ^ byte;
        hash = hash * 16777619;
        index = index + 1;
    }
    var size = value.captures.length;
    var unavailable = size == 0;
    if unavailable {
        value.allocated = false;
        return false;
    }
    var slot = hash % size;
    loop {
        var previous = value.captures.data[slot];
        empty = previous == null;
        if empty {
            value.captures.data[slot] = term;
            return true;
        }
        var same = syntax_text_equal(&previous.capture, &term.capture);
        if same {
            return syntax_validation_error(value, "Duplicate capture: ", term.capture.data, term.capture.length);
        }
        slot = slot + 1;
        var wrap = slot == value.captures.length;
        if wrap {
            slot = 0;
        }
    }
}

fn syntax_validation_terms(value: SyntaxValidation*): bool {
    var index: usize = 0;
    loop {
        var done = index == value.count;
        if done {
            return true;
        }
        var rule = &value.rules[index];
        var collision = syntax_validation_token(value, rule.name, rule.name_length, true);
        if collision {
            return syntax_validation_error(value, "Name already defines a token or skip rule: ", rule.name, rule.name_length);
        }
        var alternative: usize = 0;
        loop {
            done = alternative == rule.count;
            if done {
                break;
            }
            var sequence = syntax_validation_node(value, rule.alternatives[alternative]);
            var ok = syntax_validation_captures(value, sequence.items.length);
            if ok {} else {
                return false;
            }
            var item: usize = 0;
            loop {
                done = item == sequence.items.length;
                if done {
                    break;
                }
                var term = syntax_validation_node(value, sequence.items.data[item]);
                if term.literal {
                    var status = syntax_literal_check(term.text.data, term.text.length);
                    var invalid = status != 0;
                    if invalid {
                        syntax_validation_location(value, term);
                        var empty = status == 1;
                        if empty {
                            syntax_validation_text(value, "Token literal is empty. Expected at least one character between the quotes.");
                            return false;
                        }
                        return syntax_validation_error(value, "Unsupported token literal: ", term.text.data, term.text.length);
                    }
                }
                ok = syntax_validation_capture(value, term);
                if ok {} else {
                    return false;
                }
                item = item + 1;
            }
            alternative = alternative + 1;
        }
        index = index + 1;
    }
}

fn syntax_validation_has_capture(value: SyntaxValidation*, sequence: SyntaxNode*, capture: u8*): bool {
    var length = syntax_text_length(capture);
    var index: usize = 0;
    loop {
        var done = index == sequence.items.length;
        if done {
            return false;
        }
        var term = syntax_validation_node(value, sequence.items.data[index]);
        var order = syntax_bytes_compare(term.capture.data, term.capture.length, capture, length);
        var found = order == 0;
        if found {
            return true;
        }
        index = index + 1;
    }
}

fn syntax_validation_required(value: SyntaxValidation*, sequence: SyntaxNode*, name: u8*, capture: u8*): bool {
    var present = syntax_validation_has_capture(value, sequence, capture);
    if present {
        return true;
    }
    syntax_validation_location(value, sequence);
    syntax_validation_text(value, "Declaration rule ");
    syntax_validation_text(value, name);
    syntax_validation_text(value, " must preserve capture '");
    syntax_validation_text(value, capture);
    syntax_validation_text(value, "'");
    return false;
}

// The declaration reader consumes these named roles. Checking them here keeps
// grammar edits transactional; changing the reader syntax cannot drop its data.
fn syntax_validation_declaration(value: SyntaxValidation*, name: u8*, empty: bool, first: u8*, second: u8*, third: u8*, fourth: u8*, atom: bool): bool {
    var length = syntax_text_length(name);
    var index = syntax_validation_find(value, name, length);
    var missing = index == lr_none();
    if missing {
        return syntax_validation_error(value, "Missing declaration rule: ", name, length);
    }
    var rule = &value.rules[index];
    var alternative: usize = 0;
    loop {
        var done = alternative == rule.count;
        if done {
            return true;
        }
        var sequence = syntax_validation_node(value, rule.alternatives[alternative]);
        alternative = alternative + 1;
        if empty {
            var vacant = sequence.items.length == 0;
            if vacant {
                continue;
            }
        }
        var present = first != null;
        var ok = true;
        if present {
            ok = syntax_validation_required(value, sequence, name, first);
        }
        present = second != null;
        if present {
            if ok {
                ok = syntax_validation_required(value, sequence, name, second);
            }
        }
        present = third != null;
        if present {
            if ok {
                ok = syntax_validation_required(value, sequence, name, third);
            }
        }
        present = fourth != null;
        if present {
            if ok {
                ok = syntax_validation_required(value, sequence, name, fourth);
            }
        }
        if ok {} else {
            return false;
        }
        if atom {
            ok = syntax_validation_has_capture(value, sequence, "literal");
            if ok {} else {
                ok = syntax_validation_has_capture(value, sequence, "reference");
            }
            if ok {} else {
                ok = syntax_validation_has_capture(value, sequence, "capture");
            }
            if ok {} else {
                ok = syntax_validation_has_capture(value, sequence, "set");
            }
            if ok {} else {
                syntax_validation_text(value, "GrammarAtom must capture a literal, reference or capture name");
                return false;
            }
        }
    }
}

fn syntax_validation_declarations(value: SyntaxValidation*): bool {
    var ok = syntax_validation_declaration(value, "GrammarAlternatives", false, "sequence", null, null, null, false);
    if ok {
        ok = syntax_validation_declaration(value, "GrammarAssignment", false, null, null, null, null, false);
    }
    if ok {
        ok = syntax_validation_declaration(value, "GrammarAtom", false, null, null, null, null, true);
    }
    if ok {
        ok = syntax_validation_declaration(value, "GrammarDeclaration", false, "name", "op", "alternatives", "replacement", false);
    }
    if ok {
        ok = syntax_validation_declaration(value, "GrammarReplacement", true, "body", null, null, null, false);
    }
    if ok {
        ok = syntax_validation_declaration(value, "GrammarSequence", true, "previous", "term", null, null, false);
    }
    if ok {
        ok = syntax_validation_declaration(value, "GrammarSkipDeclaration", false, "name", "pattern", "style", null, false);
    }
    if ok {
        ok = syntax_validation_declaration(value, "GrammarStyle", true, "kind", null, null, null, false);
    }
    if ok {
        ok = syntax_validation_declaration(value, "GrammarSuffix", false, null, null, null, null, false);
    }
    if ok {
        ok = syntax_validation_declaration(value, "GrammarTerm", false, "atom", "suffix", null, null, false);
    }
    if ok {
        ok = syntax_validation_declaration(value, "GrammarTokenDeclaration", false, "name", "pattern", "style", null, false);
    }
    return ok;
}

fn syntax_validation_wait(value: SyntaxValidation*, owner: usize, term: void*): bool {
    var fresh = value.pending[owner] == null;
    if fresh {
        value.allocated = vector_push(usize, &value.queue, owner);
        if value.allocated {
            value.pending[owner] = term;
        }
    }
    return value.allocated;
}

fn syntax_validation_dependencies(value: SyntaxValidation*): bool {
    var index: usize = 0;
    loop {
        var done = index == value.count;
        if done {
            break;
        }
        var rule = &value.rules[index];
        var alternative: usize = 0;
        loop {
            done = alternative == rule.count;
            if done {
                break;
            }
            var sequence = syntax_validation_node(value, rule.alternatives[alternative]);
            var item: usize = 0;
            loop {
                done = item == sequence.items.length;
                if done {
                    break;
                }
                var entity = sequence.items.data[item];
                var term = syntax_validation_node(value, entity);
                item = item + 1;
                if term.literal {
                    continue;
                }
                if term.terminal_set {
                    continue;
                }
                var terminal = syntax_validation_token(value, term.text.data, term.text.length, false);
                if terminal {
                    continue;
                }
                var target = syntax_validation_find(value, term.text.data, term.text.length);
                var missing = target == lr_none();
                if missing {
                    syntax_validation_wait(value, index, entity);
                } else {
                    var edge: SyntaxDependent;
                    edge.owner = index;
                    edge.term = entity;
                    value.allocated = lr_append(SyntaxDependent, &value.states.data[target].dependents, &edge);
                }
                if value.allocated {} else {
                    return false;
                }
            }
            alternative = alternative + 1;
        }
        index = index + 1;
    }
    index = 0;
    loop {
        var done = index == value.queue.length;
        if done {
            return true;
        }
        var owner = value.queue.data[index];
        var edges = &value.states.data[owner].dependents;
        var edge: usize = 0;
        loop {
            done = edge == edges.length;
            if done {
                break;
            }
            var ok = syntax_validation_wait(value, edges.data[edge].owner, edges.data[edge].term);
            if ok {} else {
                return false;
            }
            edge = edge + 1;
        }
        index = index + 1;
    }
}

fn syntax_validation_root(value: SyntaxValidation*, name: u8*): bool {
    var length = syntax_text_length(name);
    var index = syntax_validation_find(value, name, length);
    var missing = index == lr_none();
    if missing {
        return true;
    }
    var ready = value.pending[index] == null;
    if ready {
        return true;
    }
    syntax_validation_text(value, "Cannot activate incomplete grammar: ");
    syntax_validation_append(value, name, length);
    loop {
        var term = syntax_validation_node(value, value.pending[index]);
        syntax_validation_location(value, term);
        name = term.text.data;
        length = term.text.length;
        syntax_validation_text(value, " -> ");
        syntax_validation_append(value, name, length);
        index = syntax_validation_find(value, name, length);
        missing = index == lr_none();
        if missing {
            break;
        }
    }
    syntax_validation_text(value, " (undefined rule '");
    syntax_validation_append(value, name, length);
    syntax_validation_text(value, "')");
    return false;
}

fn syntax_validation_optional(term: SyntaxNode*): bool {
    var optional = term.repetition == 42;
    if optional {
        return true;
    }
    optional = term.repetition == 63;
    return optional;
}

fn syntax_validation_properties(value: SyntaxValidation*): void {
    loop {
        var changed = false;
        var index: usize = 0;
        loop {
            var done = index == value.count;
            if done {
                break;
            }
            var owner = index;
            index = index + 1;
            var waiting = value.pending[owner] != null;
            if waiting {
                continue;
            }
            var rule = &value.rules[owner];
            var state = &value.states.data[owner];
            var alternative: usize = 0;
            loop {
                done = alternative == rule.count;
                if done {
                    break;
                }
                var sequence = syntax_validation_node(value, rule.alternatives[alternative]);
                var nullable = true;
                var productive = true;
                var item: usize = 0;
                loop {
                    done = item == sequence.items.length;
                    if done {
                        break;
                    }
                    var term = syntax_validation_node(value, sequence.items.data[item]);
                    item = item + 1;
                    var optional = syntax_validation_optional(term);
                    if optional {
                        continue;
                    }
                    var terminal = term.literal;
                    if term.terminal_set {
                        terminal = true;
                    }
                    if terminal {
                        nullable = false;
                        continue;
                    }
                    var target = syntax_validation_find(value, term.text.data, term.text.length);
                    var found = target != lr_none();
                    var empty = false;
                    var produces = false;
                    if found {
                        empty = value.states.data[target].nullable;
                        produces = value.states.data[target].productive;
                    } else {
                        produces = syntax_validation_token(value, term.text.data, term.text.length, false);
                    }
                    if empty {} else {
                        nullable = false;
                    }
                    if produces {} else {
                        productive = false;
                    }
                }
                if nullable {
                    var fresh = state.nullable == false;
                    if fresh {
                        state.nullable = true;
                        changed = true;
                    }
                }
                if productive {
                    var fresh = state.productive == false;
                    if fresh {
                        state.productive = true;
                        changed = true;
                    }
                }
                alternative = alternative + 1;
            }
        }
        if changed {} else {
            return;
        }
    }
}

fn syntax_validation_productive(value: SyntaxValidation*): bool {
    var statement = syntax_validation_find(value, "Statement", 9);
    var present = statement != lr_none();
    if present {
        if value.states.data[statement].nullable {
            syntax_validation_text(value, "Statement must consume input");
            return false;
        }
    }
    var index: usize = 0;
    loop {
        var done = index == value.count;
        if done {
            return true;
        }
        var owner = index;
        index = index + 1;
        var waiting = value.pending[owner] != null;
        if waiting {
            continue;
        }
        var rule = &value.rules[owner];
        var productive = value.states.data[owner].productive;
        if productive {} else {
            return syntax_validation_error(value, "Unproductive grammar rule: ", rule.name, rule.name_length);
        }
        var alternative: usize = 0;
        loop {
            done = alternative == rule.count;
            if done {
                break;
            }
            var sequence = syntax_validation_node(value, rule.alternatives[alternative]);
            var item: usize = 0;
            loop {
                done = item == sequence.items.length;
                if done {
                    break;
                }
                var term = syntax_validation_node(value, sequence.items.data[item]);
                item = item + 1;
                if term.literal {
                    continue;
                }
                var repeated = term.repetition == 42;
                var plus = term.repetition == 43;
                if plus {
                    repeated = true;
                }
                if repeated {
                    var target = syntax_validation_find(value, term.text.data, term.text.length);
                    var found = target != lr_none();
                    if found {
                        if value.states.data[target].nullable {
                            return syntax_validation_error(value, "Cannot repeat nullable rule: ", term.text.data, term.text.length);
                        }
                    }
                }
            }
            alternative = alternative + 1;
        }
    }
}

export fn syntax_validate(rules: SyntaxRuleView*, count: usize, tokens: void**, token_count: usize, kind: void*, error: vector(u8)*, offset: usize*, pending: void**): bool {
    var value: SyntaxValidation;
    fill(&value, 0, sizeof(SyntaxValidation));
    value.rules = rules;
    value.count = count;
    value.tokens = tokens;
    value.token_count = token_count;
    value.kind = kind;
    value.error = error;
    value.offset = offset;
    value.pending = pending;
    value.allocated = true;
    var index: usize = 0;
    loop {
        var done = index == count;
        if done {
            break;
        }
        pending[index] = null;
        index = index + 1;
    }
    value.allocated = vector_reserve(SyntaxRuleState, &value.states, count);
    var ok = value.allocated;
    if ok {
        var bytes = count * sizeof(SyntaxRuleState);
        fill(value.states.data, 0, bytes);
        value.states.length = count;
        ok = syntax_validation_terms(&value);
    }
    if ok {
        ok = syntax_validation_declarations(&value);
    }
    if ok {
        ok = syntax_validation_dependencies(&value);
    }
    if ok {
        ok = syntax_validation_root(&value, "GrammarDeclaration");
    }
    if ok {
        ok = syntax_validation_root(&value, "GrammarTokenDeclaration");
    }
    if ok {
        ok = syntax_validation_root(&value, "GrammarSkipDeclaration");
    }
    if ok {
        ok = syntax_validation_root(&value, "Statement");
    }
    if ok {
        syntax_validation_properties(&value);
        ok = syntax_validation_productive(&value);
    }
    index = 0;
    loop {
        var done = index == value.states.length;
        if done {
            break;
        }
        vector_dispose(SyntaxDependent, &value.states.data[index].dependents);
        index = index + 1;
    }
    vector_dispose(SyntaxRuleState, &value.states);
    vector_dispose(usize, &value.queue);
    vector_dispose(SyntaxNode*, &value.captures);
    if value.allocated {} else {
        vector_dispose(u8, error);
        index = 0;
        loop {
            var done = index == count;
            if done {
                break;
            }
            pending[index] = null;
            index = index + 1;
        }
        return false;
    }
    return ok;
}
