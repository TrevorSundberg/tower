import tower;
import foundation_tags;
import foundation_types;
import semantic_context;
import semantic_control;
import semantic_definitions;
import semantic_support;
import semantic_types;
import semantic_layout;
import semantic_values;

// Transient surface classifications on the same entities. These are eliminated
// before publishing a Foundation graph; they have no interpreter/cache encoding.
const SurfaceSelect: u32 = 100;
const SurfaceAnd: u32 = 101;
const SurfaceOr: u32 = 102;
const SurfaceAssign: u32 = 103;
const SurfaceModify: u32 = 104;
const SurfaceComma: u32 = 105;
const SurfaceShift: u32 = 106;
const SurfaceCompare: u32 = 107;
const SurfaceDiscard: u32 = 108;
const SurfaceCoalesce: u32 = 109;
const SurfaceNullField: u32 = 110;
const SurfaceNullIndex: u32 = 111;
const SurfaceDefault: u32 = 112;
const SurfaceDefaultStore: u32 = 113;
const SurfaceInitializer: u32 = 114;
const SurfaceInitializerStore: u32 = 115;
const SurfaceShiftLeft: u32 = 14;
const SurfaceShiftRight: u32 = 15;
const SurfaceShiftUnsigned: u32 = 16;
const SurfaceSet: u32 = 4294967295;

fn sem_surface_unwrap(n: void*): void* {
    loop {
        var wrapper = sem_is(n, "TowerExpression");
        wrapper ||= sem_is(n, "TowerComma");
        wrapper ||= sem_is(n, "CoreOperand");
        wrapper ||= sem_is(n, "CoreCallArgument");
        wrapper ||= sem_is(n, "CoreValue");
        if !wrapper {
            return n;
        }
        if sem_child_count(n) == 1 {
            n = sem_child(n, 0);
        }
        else {
            var group = sem_member(n, "value");
            if group != null {
                n = group;
            } else {
                return n;
            }
        }
    }
}

fn sem_surface_expected(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    if !sem_ok(c) {
        return n;
    }
    var value = sem_get(n);
    if value == null {
        return n;
    }
    if expected_type != null {
        if !semantic_type_equal(&value.type, expected_type) {
            sem_fail(c, n, sem_cat(c, "Expected ", sem_cat(c, sem_type_name(c, expected_type),
            sem_cat(c, ", got ", sem_type_name(c, &value.type)))));
        }
    }
    return n;
}

// Aggregate defaults belong to complete initializers/resets, never temporaries.
fn sem_default(c: SemanticContext*, n: void*, expected_type: FoundationType*, destination: bool): void* {
    var value = sem_node(c, n, KOperand());
    var type = expected_type;
    var annotation = sem_member(n, "type");
    if annotation != null { type = sem_type(c, annotation); }
    if !sem_ok(c) { return n; }
    if type == null {
        sem_fail(c, n, "default requires a target type or an explicit default(Type)");
        return n;
    }
    sem_set_type(&value.type, type);
    if type.pointers == 0 && type.scalar == SVoid() {
        sem_fail(c, n, "default requires a non-void type");
        return n;
    }
    if semantic_aggregate(type) {
        if !destination {
            sem_fail(c, n, "Aggregate default requires a complete declaration initializer or reset destination");
            return n;
        }
        value.kind = SurfaceDefault();
        c.surface_expressions = true;
    } else {
        if type.pointers == 0 && semantic_enum(type) {
            // Zero need not name an enum member. Preserve its ordinary compilable
            // conversion spelling instead of creating an unnamed enum constant.
            var underlying = sem_type_copy(c, type);
            underlying.record = null;
            value.kind = KConvert();
            value.value = sem_surface_constant(c, n, underlying, 0);
            c.surface_expressions = true;
        } else {
            value.constant = true;
            value.bits = 0;
        }
    }
    return sem_surface_expected(c, n, expected_type);
}

// Construction checking is independent of storage lowering. The initializer's
// ordered field nodes bind the same declarations used by ordinary field access.
// Stronger source policies can inspect completeness/default coverage here, and
// analyze the resulting ordinary stores without changing Foundation semantics.
fn sem_named_initialization(c: SemanticContext*, n: void*, expected_type: FoundationType*, destination: bool): void* {
    var initial = sem_node(c, n, SurfaceInitializer());
    var type = expected_type;
    var annotation = sem_member(n, "type");
    if annotation != null { type = sem_type(c, annotation); }
    if !sem_ok(c) { return n; }
    if type == null {
        sem_fail(c, n, "Named initialization requires a target type or init(Type)");
        return n;
    }
    sem_set_type(&initial.type, type);
    if type.pointers != 0 || type.scalar != SStruct() || semantic_enum(type) {
        sem_fail(c, n, "Named initialization requires a struct type");
        return n;
    }
    sem_surface_expected(c, n, expected_type);
    if !sem_ok(c) { return n; }
    if !destination {
        sem_fail(c, n, "Named initialization requires a complete declaration initializer or reset destination");
        return n;
    }
    sem_layout(c, type.record);
    if !sem_ok(c) { return n; }
    var fields = &sem_get(type.record).items;
    var supplied = sem_table(c);
    var entries = sem_collect(c, sem_member(n, "fields"), "TowerInitializerEntry");
    for(var i: usize = 0; i < entries.length && sem_ok(c); i++) {
        var entry = sem_child(entries.data[i], 0);
        if sem_is(entry, "TowerInitializerDefault") {
            if initial.op != 0 || i + 1 != entries.length {
                sem_fail(c, entry, "The ..default initializer must occur once, at the end");
            }
            initial.op = 1;
            continue;
        }
        var field = sem_node(c, entry, KAssign());
        var name = sem_identifier(c, sem_member(entry, "name"));
        sem_set_name(field, name);
        foreach(var declaration in fields) {
            if sem_equal(name, sem_name(sem_get(declaration))) { field.binding = declaration; }
        }
        if field.binding == null {
            sem_fail(c, entry, sem_cat(c, "Unknown initializer field '", sem_cat(c, name, "'")));
            break;
        }
        if !sem_put(c, supplied, name, entry) {
            sem_fail(c, entry, sem_cat(c, "Duplicate initializer field '", sem_cat(c, name, "'")));
            break;
        }
        sem_set_type(&field.type, &sem_get(field.binding).type);
        field.value = sem_initial_value(c, sem_member(entry, "value"), &field.type);
        sem_push(&initial.items, entry);
    }
    if sem_ok(c) && initial.op == 0 {
        foreach(var declaration in fields) {
            var name = sem_name(sem_get(declaration));
            if sem_lookup_table(supplied, name) == null {
                sem_fail(c, n, sem_cat(c, "Missing initializer field '", sem_cat(c, name, "'; provide it or use ..default")));
                break;
            }
        }
    }
    c.surface_expressions = true;
    return n;
}

fn sem_initial_value(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    var source = sem_surface_unwrap(n);
    if sem_is(source, "TowerDefault") { return sem_default(c, source, expected_type, true); }
    if sem_is(source, "TowerInitializer") {
        if c.value_depth >= 128 {
            sem_fail(c, source, "Foundation expression nesting limit is 128");
            return source;
        }
        c.value_depth++;
        var result = sem_named_initialization(c, source, expected_type, true);
        c.value_depth--;
        return result;
    }
    return sem_expression(c, n, expected_type);
}

fn sem_surface_integer(c: SemanticContext*, n: void*): bool {
    var value = sem_get(n);
    var ok = semantic_integer(&value.type);
    if ok {
        if semantic_enum(&value.type) {
            ok = false;
        }
    }
    if !ok {
        sem_fail(c, n, "This operation requires integer operands");
    }
    return ok;
}

fn sem_surface_constant(c: SemanticContext*, parent: void*, type: FoundationType*, bits_value: u64): void* {
    var n = sem_control_node(c, parent, KOperand());
    var value = sem_get(n);
    sem_set_type(&value.type, type);
    if type.pointers == 0 && semantic_enum(type) {
        // Internal zero temporaries need not name a member. Use the same
        // ordinary Foundation conversion as an enum default initializer.
        var underlying = sem_type_copy(c, type);
        underlying.record = null;
        value.kind = KConvert();
        value.value = sem_surface_constant(c, n, underlying, bits_value);
    } else {
        value.constant = true;
        value.bits = bits_value;
    }
    return n;
}

fn sem_surface_pointee(c: SemanticContext*, n: void*, pointer: FoundationType*): void {
    var element = sem_type_copy(c, pointer);
    element.pointers--;
    // Pointee layout is an execution/lowering input, not an inference input.
    if !semantic_aggregate(element) && semantic_size(element) == 0 {
        sem_fail(c, n, "Cannot offset a void pointer");
    }
}

fn sem_surface_optional(value: FoundationNode*): bool {
    return value.kind == SurfaceNullField() || value.kind == SurfaceNullIndex();
}

fn sem_surface_nullable(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    if c.value_depth > 128 {
        sem_fail(c, n, "Foundation expression nesting limit is 128");
        return n;
    }
    c.value_depth++;
    var result = sem_surface_nullable_impl(c, n, expected_type);
    c.value_depth--;
    return result;
}

fn sem_surface_nullable_impl(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    n = sem_surface_unwrap(n);
    if !sem_is(n, "TowerNullAccess") {
        return sem_operand(c, n, expected_type);
    }
    if sem_get(n) != null {
        return n;
    }
    c.surface_expressions = true;
    var source = sem_surface_unwrap(sem_member(n, "base"));
    var base: void* = null;
    if sem_is(source, "CoreLocation") {
        base = sem_location(c, source, 0);
    }
    else {
        base = sem_surface_nullable(c, source, null);
    }
    if !sem_ok(c) {
        return n;
    }
    var guarded = sem_tokens(c, sem_child(n, 1))[0] == 63;
    if guarded && sem_get(base).type.pointers == 0 {
        sem_fail(c, n, "Null-conditional access requires a pointer receiver");
        return n;
    }
    sem_location(c, n, 0);
    if !sem_ok(c) {
        return n;
    }
    var value = sem_get(n);
    value.kind = SurfaceNullField();
    if sem_member(n, "index") != null {
        value.kind = SurfaceNullIndex();
    }
    value.op = convert(u32, guarded);
    return n;
}

// One operator classification is shared by binary and compound syntax.
// Compound assignment strips '=' and uses this same operation/type contract.
fn sem_surface_code(operation: u8*): u32 {
    if sem_equal(operation, "&&") {
        return SurfaceAnd();
    }
    if sem_equal(operation, "||") {
        return SurfaceOr();
    }
    if sem_equal(operation, "??") {
        return SurfaceCoalesce();
    }
    if sem_equal(operation, "<<") {
        return SurfaceShiftLeft();
    }
    if sem_equal(operation, ">>") {
        return SurfaceShiftRight();
    }
    if sem_equal(operation, ">>>") {
        return SurfaceShiftUnsigned();
    }
    for(var code: u32 = 0; code <= OGe(); code++) {
        if sem_equal(operation, semantic_operator(code)) {
            return code;
        }
    }
    return SurfaceSet();
}

fn sem_surface_compound(op: u8*): bool {
    var length = sem_length(op);
    if length < 2 || op[length -1] != 61 {
        return false;
    }
    return !sem_equal(op, "==") && !sem_equal(op, "!=")
    && !sem_equal(op, "<=") && !sem_equal(op, ">=");
}

fn sem_surface_binary(c: SemanticContext*, n: void*, left: void*, right: void*, op: u32, expected_type: FoundationType*): void* {
    var value = sem_node(c, n, KBinary());
    value.op = op;
    var comparison = op >= OEq();
    var input = expected_type;
    var infer = comparison;
    infer ||= input == null;
    if infer {
        var anchor = left;
        if sem_literal(c, left) {
            if !sem_literal(c, right) {
                anchor = right;
            }
        }
        var known = sem_operand(c, anchor, null);
        if !sem_ok(c) {
            return n;
        }
        input = &sem_get(known).type;
    }
    value.left = sem_operand(c, left, input);
    if !sem_ok(c) {
        return n;
    }
    var offset = input.pointers != 0;
    if offset {
        offset = op == OAdd();
        offset ||= op == OSub();
    }
    var right_type = input;
    if offset {
        right_type = null;
        if sem_literal(c, right) {
            right_type = sem_type_new(c, SUSize(), 0, null);
        }
    }
    value.right = sem_operand(c, right, right_type);
    if !sem_ok(c) {
        return n;
    }
    if comparison {
        sem_set_type(&value.type, sem_type_new(c, SBool(), 0, null));
    }
    else {
        sem_set_type(&value.type, input);
    }
    if offset {
        sem_surface_integer(c, value.right);
        sem_surface_pointee(c, n, input);
    } else {
        var equality = op == OEq();
        equality ||= op == ONe();
        if !equality {
            if semantic_enum(input) {
                sem_fail(c, n, "Enum operations require equality or inequality");
            } else {
                sem_surface_integer(c, value.left);
            }
        }
    }
    return sem_surface_expected(c, n, expected_type);
}

fn sem_surface_place(c: SemanticContext*, n: void*): void* {
    n = sem_surface_unwrap(n);
    if sem_is(n, "CoreLocation") {
        return sem_location(c, n, 0);
    }
    var value: void* = null;
    var dereference = sem_is(n, "TowerExpression") && sem_member(n, "left") == null
    && sem_member(n, "right") != null && sem_equal(sem_tokens(c, sem_child(n, 0)), "*");
    if dereference {
        value = sem_surface(c, n, null);
    }
    else {
        value = sem_operand(c, n, null);
    }
    if !sem_ok(c) {
        return value;
    }
    var data = sem_get(value);
    var place = data.kind == KLoad();
    place ||= data.kind == KField();
    place ||= data.kind == KIndex();
    if !place {
        sem_fail(c, n, "Operator requires an addressable location");
    }
    return value;
}

fn sem_surface_operator(c: SemanticContext*, n: void*, left: void*): u8* {
    var index: usize = 0;
    if left != null {
        index = 1;
    }
    var op = sem_tokens(c, sem_child(n, index));
    if sem_equal(op, "not") {
        return "!";
    }
    if sem_equal(op, "compl") {
        return "~";
    }
    if sem_equal(op, "bitand") {
        return "&";
    }
    if sem_equal(op, "bitor") {
        return "|";
    }
    if sem_equal(op, "xor") {
        return "^";
    }
    if sem_equal(op, "and") {
        return "&&";
    }
    if sem_equal(op, "or") {
        return "||";
    }
    if sem_equal(op, "not_eq") {
        return "!=";
    }
    if sem_equal(op, "and_eq") {
        return "&=";
    }
    if sem_equal(op, "or_eq") {
        return "|=";
    }
    if sem_equal(op, "xor_eq") {
        return "^=";
    }
    return op;
}

// A discarded/comma-left expression may be void. Value contexts still use the
// ordinary operand checker, so a void branch cannot initialize a local or argument.
fn sem_surface_discard(c: SemanticContext*, n: void*): void* {
    n = sem_surface_unwrap(n);
    if sem_is(n, "CoreCall") {
        return sem_call(c, n);
    }
    var condition = sem_member(n, "condition");
    var comma = sem_is(n, "TowerComma") && sem_member(n, "left") != null;
    if condition == null && !comma {
        var result = sem_operand(c, n, null);
        // Bare and module-qualified names can grow into void calls, including
        // for updates. Holes inside operands or arguments still need values.
        if c.editor != null && c.editor.found && sem_is(n, "CoreLocation") {
            var bare_name = c.editor.node == sem_member(n, "name");
            var module_name = c.editor.node == n && c.editor.module != null;
            if bare_name || module_name {
                c.editor.value_required = false;
            }
        }
        return result;
    }
    c.surface_expressions = true;
    var kind = SurfaceSelect();
    if comma {
        kind = SurfaceComma();
    }
    var value = sem_node(c, n, kind);
    var left = sem_member(n, "body");
    var right = sem_member(n, "otherwise");
    if comma {
        left = sem_member(n, "left");
        right = sem_member(n, "right");
    } else {
        value.value = sem_operand(c, condition, sem_type_new(c, SBool(), 0, null));
    }
    value.left = sem_surface_discard(c, left);
    if !sem_ok(c) {
        return n;
    }
    value.right = sem_surface_discard(c, right);
    if !sem_ok(c) {
        return n;
    }
    var left_value = sem_get(value.left);
    var right_value = sem_get(value.right);
    if !comma && !semantic_type_equal(&left_value.type, &right_value.type) {
        sem_fail(c, n, "Conditional branches must have the same type");
    }
    sem_set_type(&value.type, &right_value.type);
    return n;
}

fn sem_surface(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    var original = n;
    n = sem_surface_unwrap(n);
    if n != original {
        return sem_operand(c, n, expected_type);
    }
    var existing = sem_get(n);
    if existing != null {
        return sem_surface_expected(c, n, expected_type);
    }
    c.surface_expressions = true;
    var group = sem_member(n, "value");
    if group != null {
        return sem_operand(c, group, expected_type);
    }
    var left = sem_member(n, "left");
    var right = sem_member(n, "right");
    var condition = sem_member(n, "condition");
    if condition != null {
        var value = sem_node(c, n, SurfaceSelect());
        value.value = sem_operand(c, condition, sem_type_new(c, SBool(), 0, null));
        var body = sem_member(n, "body");
        var otherwise = sem_member(n, "otherwise");
        var input = expected_type;
        if input == null && sem_literal(c, body) && !sem_literal(c, otherwise) {
            var known = sem_operand(c, otherwise, null);
            if !sem_ok(c) {
                return n;
            }
            input = &sem_get(known).type;
        }
        value.left = sem_operand(c, body, input);
        if !sem_ok(c) {
            return n;
        }
        value.right = sem_operand(c, otherwise, &sem_get(value.left).type);
        sem_set_type(&value.type, &sem_get(value.left).type);
        return sem_surface_expected(c, n, expected_type);
    }
    var op = sem_surface_operator(c, n, left);
    if sem_equal(op, ",") {
        var value = sem_node(c, n, SurfaceComma());
        value.left = sem_surface_discard(c, left);
        if !sem_ok(c) {
            return n;
        }
        value.right = sem_operand(c, right, expected_type);
        if sem_ok(c) {
            sem_set_type(&value.type, &sem_get(value.right).type);
        }
        return n;
    }
    var postfix = left != null;
    var increment = sem_equal(op, "++");
    var decrement = sem_equal(op, "--");
    var modify = increment;
    if decrement {
        modify = true;
    }
    if modify {
        var place = right;
        if postfix {
            place = left;
        }
        var value = sem_node(c, n, SurfaceModify());
        value.target = sem_surface_place(c, place);
        if !sem_ok(c) {
            return n;
        }
        sem_set_type(&value.type, &sem_get(value.target).type);
        var pointer = value.type.pointers != 0;
        if pointer {
            sem_surface_pointee(c, n, &value.type);
        }
        else {
            sem_surface_integer(c, value.target);
        }
        value.op = OAdd();
        if decrement {
            value.op = OSub();
        }
        value.indirect = postfix;
        return sem_surface_expected(c, n, expected_type);
    }
    if left == null {
        var missing = right == null;
        if missing {
            sem_fail(c, n, "A pointer type spelling cannot be used as a value");
            return n;
        }
        var address = sem_equal(op, "&");
        var load = sem_equal(op, "*");
        var indirect = address;
        if load {
            indirect = true;
        }
        if indirect {
            var kind = KLoad();
            if address {
                kind = KAddress();
            }
            var value = sem_node(c, n, kind);
            if address {
                value.value = sem_surface_place(c, right);
            }
            else {
                value.value = sem_operand(c, right, null);
            }
            if !sem_ok(c) {
                return n;
            }
            sem_set_type(&value.type, &sem_get(value.value).type);
            if address {
                value.type.pointers++;
            }
            else {
                if value.type.pointers == 0 {
                    sem_fail(c, n, "Load requires a pointer");
                }
                else {
                    value.type.pointers--;
                    if value.type.pointers == 0 && value.type.scalar == SVoid() {
                        sem_fail(c, n, "Cannot load a void pointer");
                    }
                }
            }
            return sem_surface_expected(c, n, expected_type);
        }
        var negate = sem_equal(op, "!");
        var input = expected_type;
        if negate {
            input = sem_type_new(c, SBool(), 0, null);
        }
        // Preserve the existing signed minimum literal/range contract.
        if sem_equal(op, "-") {
            var text = sem_tokens(c, right);
            var literal = text[0] != 0;
            for(var index: usize = 0; !(text[index] == 0); index++) {
                var digit = text[index] >= 48;
                digit &&= text[index] <= 57;
                if !digit {
                    literal = false;
                    break;
                }
            }
            if literal {
                return sem_operand_leaf(c, n, expected_type);
            }
        }
        var operand = sem_operand(c, right, input);
        if !sem_ok(c) {
            return n;
        }
        if !negate {
            sem_surface_integer(c, operand);
        }
        if sem_equal(op, "+") {
            return sem_surface_expected(c, operand, expected_type);
        }
        var value = sem_node(c, n, KBinary());
        sem_set_type(&value.type, &sem_get(operand).type);
        value.op = OSub();
        value.left = sem_surface_constant(c, n, &value.type, 0);
        value.right = operand;
        if negate {
            value.op = OEq();
        }
        if sem_equal(op, "~") {
            value.op = OXor();
            sem_get(value.left).bits = semantic_mask(&value.type);
        }
        return sem_surface_expected(c, n, expected_type);
    }
    var missing = right == null;
    if missing {
        sem_fail(c, n, "A pointer type spelling cannot be used as a value");
        return n;
    }
    var logical_and = sem_equal(op, "&&");
    var logical_or = sem_equal(op, "||");
    var logical = logical_and;
    if logical_or {
        logical = true;
    }
    if logical {
        var kind = SurfaceAnd();
        if logical_or {
            kind = SurfaceOr();
        }
        var value = sem_node(c, n, kind);
        var boolean = sem_type_new(c, SBool(), 0, null);
        value.left = sem_operand(c, left, boolean);
        value.right = sem_operand(c, right, boolean);
        sem_set_type(&value.type, boolean);
        return sem_surface_expected(c, n, expected_type);
    }
    var length = sem_length(op);
    var assignment = sem_equal(op, "=");
    var compound = sem_surface_compound(op);
    var assign = assignment;
    if compound {
        assign = true;
    }
    var operation = op;
    if compound {
        var count = length -1;
        operation = sem_text(c, op, count);
    }
    var shift_left = sem_equal(operation, "<<");
    var shift_right = sem_equal(operation, ">>");
    var shift_unsigned = sem_equal(operation, ">>>");
    var shift = shift_left;
    if shift_right {
        shift = true;
    }
    if shift_unsigned {
        shift = true;
    }
    var threeway = sem_equal(operation, "<=>");
    var code = sem_surface_code(operation);
    if !assign && code == SurfaceCoalesce() {
        var value = sem_node(c, n, SurfaceCoalesce());
        var infer = sem_equal(sem_tokens(c, left), "null") && expected_type == null;
        var input = expected_type;
        if infer {
            var known = sem_operand(c, right, null);
            if !sem_ok(c) {
                return n;
            }
            input = &sem_get(known).type;
        }
        value.left = sem_surface_nullable(c, left, input);
        if !sem_ok(c) {
            return n;
        }
        var first = sem_get(value.left);
        if !sem_surface_optional(first) && first.type.pointers == 0 {
            sem_fail(c, n, "Null coalescing requires a pointer or null-conditional access");
            return n;
        }
        value.right = sem_operand(c, right, &first.type);
        sem_set_type(&value.type, &first.type);
        return sem_surface_expected(c, n, expected_type);
    }
    if assign {
        var value = sem_node(c, n, SurfaceAssign());
        value.target = sem_surface_place(c, left);
        if !sem_ok(c) {
            return n;
        }
        sem_set_type(&value.type, &sem_get(value.target).type);
        value.op = SurfaceSet();
        var input = &value.type;
        if compound {
            value.op = code;
            var pointer = input.pointers != 0;
            if code == SurfaceAnd() || code == SurfaceOr() {
                if input.scalar != SBool() || pointer {
                    sem_fail(c, n, "Logical compound assignment requires bool operands");
                }
            } else {
                if code == SurfaceCoalesce() {
                    if !pointer {
                        sem_fail(c, n, "Null-coalescing assignment requires a pointer location");
                    }
                } else {
                    if pointer {
                        var offset = code == OAdd();
                        offset ||= code == OSub();
                        if offset {
                            sem_surface_pointee(c, n, input);
                            input = null;
                        }
                        else {
                            sem_fail(c, n, "Only += and -= (or ??=) apply to pointers");
                        }
                    } else {
                        sem_surface_integer(c, value.target);
                    }
                    if shift {
                        input = null;
                    }
                }
            }
        }
        var initial = sem_surface_unwrap(right);
        var named = sem_is(initial, "TowerInitializer");
        if !compound && semantic_aggregate(input) && (sem_is(initial, "TowerDefault") || named) {
            value.value = sem_initial_value(c, initial, input);
            value.kind = named ? SurfaceInitializerStore() : SurfaceDefaultStore();
            sem_set_type(&value.type, sem_type_new(c, SVoid(), 0, null));
        } else { value.value = sem_operand(c, right, input); }
        if sem_ok(c) {
            if input == null {
                sem_surface_integer(c, value.value);
            }
        }
        return sem_surface_expected(c, n, expected_type);
    }
    var special = shift;
    if threeway {
        special = true;
    }
    if special {
        var kind = SurfaceShift();
        if threeway {
            kind = SurfaceCompare();
        }
        var value = sem_node(c, n, kind);
        var input = expected_type;
        if threeway {
            input = null;
        }
        value.left = sem_operand(c, left, input);
        if !sem_ok(c) {
            return n;
        }
        sem_surface_integer(c, value.left);
        input = null;
        if threeway {
            input = &sem_get(value.left).type;
        }
        value.right = sem_operand(c, right, input);
        if !sem_ok(c) {
            return n;
        }
        sem_surface_integer(c, value.right);
        value.op = code;
        sem_set_type(&value.type, &sem_get(value.left).type);
        if threeway {
            sem_set_type(&value.type, sem_type_new(c, SI32(), 0, null));
        }
        return sem_surface_expected(c, n, expected_type);
    }
    return sem_surface_binary(c, n, left, right, code, expected_type);
}
