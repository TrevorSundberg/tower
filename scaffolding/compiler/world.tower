import tower;
import .library.entities;
import .library.entity_types;
import component_kinds;
import parser_types;
import syntax_types;
import foundation_types;
import grammar_types;
import .library.work_pool;

extern fn node_payload_init(kind: u32, data: void*): void;

extern fn syntax_node_init(data: SyntaxNode*): void;

extern fn foundation_node_init(data: FoundationNode*): void;

// Coordinator-owned identity and lifetime. Worlds do not share stores or type
// entities. The legacy host uses one default world until its sessions migrate.
struct CompilerWorld {
    store: EntityStore*;
    types: Entity*[9]; // CompilerComponentCount slots.
    registered: usize;
    worker_limit: usize;
    grammar: CompilerGrammarCache;
}

// Set once, before any nodes, pools or requests exist. This is an execution
// resource policy, never part of type identity or Tower program semantics.
export fn compiler_world_create_workers(limit: usize): CompilerWorld* {
    if limit == 0 || limit > 256 { return null; }
    var world = alloc(CompilerWorld, 1);
    if world == null {
        return null;
    }
    *world = default;
    world.worker_limit = limit;
    world.store = entity_store_create();
    if world.store == null {
        free(world);
        return null;
    }
    if !entity_store_set_context(world.store, bits(void*, world)) {
        entity_store_dispose(world.store);
        free(world);
        return null;
    }
    return world;
}

export fn compiler_world_create(): CompilerWorld* {
    return compiler_world_create_workers(work_thread_capacity());
}

export fn compiler_world_worker_limit(world: CompilerWorld*): usize {
    return world.worker_limit;
}

// Entity identity determines its compiler world. Workers never switch a global
// current-world handle, and nodes from independent worlds cannot alias kinds.
export fn compiler_node_world(node: Entity*): CompilerWorld* {
    return bits(CompilerWorld*, entity_context(node));
}

export fn compiler_node_type(node: Entity*, kind: u32): Entity* {
    var world = compiler_node_world(node);
    if world == null { return null; }
    return compiler_world_type(world, kind);
}

export fn compiler_node_get(node: Entity*, kind: u32): void* {
    var world = compiler_node_world(node);
    if world == null { return null; }
    return compiler_world_get(world, node, kind);
}

// Borrowed store and type handles; callers retain types they need to own.
export fn compiler_world_store(world: CompilerWorld*): EntityStore* {
    return world.store;
}

export fn compiler_world_grammar(world: CompilerWorld*): CompilerGrammarCache* {
    return &world.grammar;
}

export fn compiler_world_pinned(world: CompilerWorld*): bool {
    var pinned = world.store.views != 0;
    return pinned;
}

export fn compiler_world_type_existing(world: CompilerWorld*, kind: u32): Entity* {
    return kind < CompilerComponentCount ? world.types[kind] : null;
}

export fn compiler_world_type(world: CompilerWorld*, kind: u32): Entity* {
    if kind >= CompilerComponentCount {
        return null;
    }
    var type = world.types[kind];
    if type != null {
        return type;
    }
    var size = sizeof(FoundationNode);
    var alignment = alignof(FoundationNode);
    var lifecycle = compiler_foundation_lifecycle();
    if kind == CompilerSyntax {
        size = sizeof(SyntaxNode);
        alignment = alignof(SyntaxNode);
        lifecycle = compiler_syntax_lifecycle();
    }
    if kind <= CompilerParserMatch {
        lifecycle = compiler_parser_lifecycle(kind);
        if kind == CompilerParserRule {
            size = sizeof(ParserRuleData);
            alignment = alignof(ParserRuleData);
        }
        if kind == CompilerParserReference {
            size = sizeof(ParserReferenceData);
            alignment = alignof(ParserReferenceData);
        }
        if kind == CompilerParserString {
            size = sizeof(ParserStringData);
            alignment = alignof(ParserStringData);
        }
        if kind == CompilerParserRange {
            size = sizeof(ParserRangeData);
            alignment = alignof(ParserRangeData);
        }
        if kind == CompilerParserMatch {
            size = sizeof(ParserMatchData);
            alignment = alignof(ParserMatchData);
        }
    }
    if kind == CompilerSyntaxOrigin {
        size = sizeof(SyntaxOrigin);
        alignment = alignof(SyntaxOrigin);
        lifecycle = compiler_origin_lifecycle();
    }
    if kind == CompilerSyntaxExpansion {
        size = sizeof(SyntaxExpansion);
        alignment = alignof(SyntaxExpansion);
        lifecycle = compiler_expansion_lifecycle();
    }
    type = entity_create(world.store);
    if type == null {
        return null;
    }
    var registered = entity_register(type, size, alignment, lifecycle);
    if !registered {
        entity_release(type);
        return null;
    }
    world.types[kind] = type;
    world.registered++;
    return type;
}

export fn compiler_world_get(world: CompilerWorld*, owner: Entity*, kind: u32): void* {
    var missing_owner = owner == null || world == null;
    if missing_owner {
        return null;
    }
    if owner.store != world.store {
        return null;
    }
    if kind >= CompilerComponentCount {
        return null;
    }
    var type = world.types[kind];
    if type == null {
        return null;
    }
    return bits(void*, entity_component_data(entity_component_get(owner, type)));
}

// Reattachment preserves payload state. A failed attachment leaves the node
// unchanged; a successfully registered type may remain cached for a retry.
export fn compiler_world_component(world: CompilerWorld*, owner: Entity*, kind: u32): void* {
    var missing_owner = owner == null || world == null;
    if missing_owner {
        return null;
    }
    if owner.store != world.store {
        return null;
    }
    var type = compiler_world_type(world, kind);
    if type == null {
        return null;
    }
    var data = compiler_world_get(world, owner, kind);
    if data != null {
        return data;
    }
    data = bits(void*, entity_component_data(entity_component_add(owner, type)));
    if data == null {
        return null;
    }
    if kind <= CompilerParserMatch {
        node_payload_init(kind, data);
    }
    if kind == CompilerSyntax {
        syntax_node_init(bits(SyntaxNode*, data));
    }
    if kind == CompilerFoundation {
        foundation_node_init(bits(FoundationNode*, data));
    }
    if kind == CompilerSyntaxOrigin {
        fill(data, 0, sizeof(SyntaxOrigin));
    }
    if kind == CompilerSyntaxExpansion {
        fill(data, 0, sizeof(SyntaxExpansion));
    }
    return data;
}

// Failed disposal is non-mutating. All requests and views must drain first.
export fn compiler_world_dispose(world: CompilerWorld*): bool {
    if world.grammar.workers_busy { return false; }
    // Drain frontend caches explicitly, after their requests have joined.
    var cached = world.grammar.bedrock != null;
    if cached {
        return false;
    }
    cached = world.grammar.patterns != null;
    if cached {
        return false;
    }
    if world.grammar.syntax is not null {
        return false;
    }
    if world.store.views != 0 {
        return false;
    }
    if entity_store_count(world.store) != world.registered {
        return false;
    }
    if entity_store_component_count(world.store) != 0 {
        return false;
    }
    var index: u32 = 0;
    for(; index < CompilerComponentCount; index++) {
        var type = world.types[index];
        var present = type != null;
        if present {
            if entity_references(type) != 1 {
                return false;
            }
        }
    }
    index = 0;
    work_pool_close(&world.grammar.workers);
    for(; index < CompilerComponentCount; index++) {
        var type = world.types[index];
        var present = type != null;
        if present {
            entity_release(type);
        }
    }
    var disposed = entity_store_dispose(world.store);
    free(world);
    return disposed;
}
