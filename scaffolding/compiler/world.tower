import tower;
import .library.entities;
import .library.entity_types;
import component_kinds;
import parser_types;
import syntax_types;
import foundation_types;
import grammar_types;
import .library.work_pool;
import .library.work_budget;
import .library.work_budget_types;
import .library.work_buffer;
import .library.work_buffer_types;

extern fn node_payload_init(kind: u32, data: void*): void;

extern fn syntax_node_init(data: SyntaxNode*): void;

extern fn foundation_node_init(data: FoundationNode*): void;

// Independent semantic stages often publish only one or two Foundation rows.
// Bound their unused payload slots without changing dense coordinator pages.
var CompilerFoundationStagePageRows: u8 = 4;

// Coordinator-owned identity and lifetime. Worlds do not share stores or type
// entities. The legacy host uses one default world until its sessions migrate.
struct CompilerWorld {
    allocation: WorkBuffer;
    store: EntityStore*;
    types: Entity*[CompilerComponentCount];
    registered: usize;
    worker_limit: usize;
    work_budget: WorkBudget*; // Borrowed immutable binding; owner outlives this world.
    grammar: CompilerGrammarCache;
}

// Set once, before any nodes, pools or requests exist. This is an execution
// resource policy, never part of type identity or Tower program semantics.
export fn compiler_world_create_workers(limit: usize): CompilerWorld* {
    var world: CompilerWorld* = null;
    compiler_world_create_result(limit, null, &world);
    return world;
}

// Freeze the ledger before even the world/store descriptors exist. Failure
// retires both private owners and leaves the caller's empty output unchanged.
export fn compiler_world_create_result(limit: usize, budget: WorkBudget*, output: CompilerWorld**): WorkBudgetError {
    if output == null || *output != null || limit == 0 || limit > WorkPoolMaximumCapacity {
        return WorkBudgetError.Invalid;
    }
    if budget != null && (!budget.initialized || limit > budget.lanes
        || (budget.lanes > 1 && (budget.gate == null || budget.enter == null || budget.leave == null))) {
        return WorkBudgetError.Invalid;
    }
    var allocation: WorkBuffer = default;
    var result = work_buffer_resize(&allocation, budget, sizeof(CompilerWorld), 0);
    if result != WorkBudgetError.None { return result; }
    var world = bits(CompilerWorld*, allocation.data);
    *world = { allocation: allocation, worker_limit: limit, work_budget: budget, ..default };
    result = entity_store_create_result(budget, &world.store);
    if result != WorkBudgetError.None {
        work_buffer_dispose(&allocation);
        return result;
    }
    if !entity_store_set_context(world.store, bits(void*, world)) {
        entity_store_dispose(world.store);
        work_buffer_dispose(&allocation);
        return WorkBudgetError.Invalid;
    }
    *output = world;
    return WorkBudgetError.None;
}

export fn compiler_world_create(): CompilerWorld* {
    return compiler_world_create_workers(work_thread_capacity());
}

export fn compiler_world_worker_limit(world: CompilerWorld*): usize {
    return world.worker_limit;
}

// Legacy boundary for selected-buffer fixtures: descriptors were already
// allocated standalone. Production bounded owners use create_result instead.
// Nested kernels reserve extra lanes; their caller already owns one lane.
export fn compiler_world_bind_budget(world: CompilerWorld*, budget: WorkBudget*): bool {
    if world == null || budget == null || !budget.initialized
        || world.work_budget != null || world.registered != 0
        || world.store.next_id != 0 || world.store.views != 0
        || world.store.component_count != 0 || world.grammar.workers.slots != null
        || world.grammar.workers_busy || world.grammar.bedrock != null
        || world.grammar.patterns != null || world.grammar.syntax != null {
        return false;
    }
    if world.worker_limit > budget.lanes
        || (budget.lanes > 1 && (budget.gate == null || budget.enter == null || budget.leave == null)) {
        return false;
    }
    world.work_budget = budget;
    return true;
}

export fn compiler_world_work_budget(world: CompilerWorld*): WorkBudget* {
    return world == null ? null : world.work_budget;
}

// Linked semantic clients use the one world-bound ledger without importing
// its implementation. Standalone worlds have no shared receipt to reserve.
export fn compiler_world_worker_reserve(world: CompilerWorld*, preferred: usize, receipt: WorkReservation*): WorkBudgetError {
    if world == null || world.work_budget == null || receipt == null
        || world.worker_limit == 0 || preferred >= world.worker_limit { return WorkBudgetError.Invalid; }
    return work_budget_reserve_result(world.work_budget, 0, preferred, 0, receipt);
}

export fn compiler_world_worker_release(world: CompilerWorld*, receipt: WorkReservation*): WorkBudgetError {
    if world == null || world.work_budget == null || receipt == null
        || receipt.owner != world.work_budget { return WorkBudgetError.Invalid; }
    return work_budget_release_result(world.work_budget, receipt);
}

// Entity identity determines its compiler world. Workers never switch a global
// current-world handle, and nodes from independent worlds cannot alias kinds.
export fn compiler_node_world(node: Entity*): CompilerWorld* {
    return bits(CompilerWorld*, entity_context(node));
}

export fn compiler_node_type(node: Entity*, kind: u32): Entity* {
    var world = compiler_node_world(node);
    if world == null { return null; }
    return compiler_world_type(world, kind);
}

export fn compiler_node_get(node: Entity*, kind: u32): void* {
    var world = compiler_node_world(node);
    if world == null { return null; }
    return compiler_world_get(world, node, kind);
}

// Borrowed store and type handles; callers retain types they need to own.
export fn compiler_world_store(world: CompilerWorld*): EntityStore* {
    return world.store;
}

export fn compiler_world_grammar(world: CompilerWorld*): CompilerGrammarCache* {
    return &world.grammar;
}

export fn compiler_world_pinned(world: CompilerWorld*): bool {
    var pinned = world.store.views != 0;
    return pinned;
}

export fn compiler_world_type_existing(world: CompilerWorld*, kind: u32): Entity* {
    return kind < CompilerComponentCount ? world.types[kind] : null;
}

export fn compiler_world_type(world: CompilerWorld*, kind: u32): Entity* {
    var error = WorkBudgetError.None;
    return compiler_world_type_result(world, kind, &error);
}

export fn compiler_world_type_result(world: CompilerWorld*, kind: u32, error: WorkBudgetError*): Entity* {
    *error = WorkBudgetError.None;
    if world is null || kind >= CompilerComponentCount {
        *error = WorkBudgetError.Invalid;
        return null;
    }
    var type = world.types[kind];
    if type != null {
        return type;
    }
    var size = sizeof(FoundationNode);
    var alignment = alignof(FoundationNode);
    var lifecycle = compiler_foundation_lifecycle();
    if kind == CompilerSyntax {
        size = sizeof(SyntaxNode);
        alignment = alignof(SyntaxNode);
        lifecycle = compiler_syntax_lifecycle();
    }
    if kind <= CompilerParserMatch {
        lifecycle = compiler_parser_lifecycle(kind);
        if kind == CompilerParserRule {
            size = sizeof(ParserRuleData);
            alignment = alignof(ParserRuleData);
        }
        if kind == CompilerParserReference {
            size = sizeof(ParserReferenceData);
            alignment = alignof(ParserReferenceData);
        }
        if kind == CompilerParserString {
            size = sizeof(ParserStringData);
            alignment = alignof(ParserStringData);
        }
        if kind == CompilerParserRange {
            size = sizeof(ParserRangeData);
            alignment = alignof(ParserRangeData);
        }
        if kind == CompilerParserMatch {
            size = sizeof(ParserMatchData);
            alignment = alignof(ParserMatchData);
        }
    }
    if kind == CompilerSyntaxOrigin {
        size = sizeof(SyntaxOrigin);
        alignment = alignof(SyntaxOrigin);
        lifecycle = compiler_origin_lifecycle();
    }
    if kind == CompilerSyntaxExpansion {
        size = sizeof(SyntaxExpansion);
        alignment = alignof(SyntaxExpansion);
        lifecycle = compiler_expansion_lifecycle();
    }
    type = entity_create_result(world.store, error);
    if type == null {
        return null;
    }
    var stage_rows: u8 = kind == CompilerFoundation ? CompilerFoundationStagePageRows : 0;
    *error = entity_register_stage_result(type, size, alignment, lifecycle, stage_rows);
    if *error != WorkBudgetError.None {
        entity_release(type);
        return null;
    }
    world.types[kind] = type;
    world.registered++;
    return type;
}

export fn compiler_world_get(world: CompilerWorld*, owner: Entity*, kind: u32): void* {
    var missing_owner = owner == null || world == null;
    if missing_owner {
        return null;
    }
    if owner.store != world.store {
        return null;
    }
    if kind >= CompilerComponentCount {
        return null;
    }
    var type = world.types[kind];
    if type == null {
        return null;
    }
    return bits(void*, entity_component_data(entity_component_get(owner, type)));
}

// Reattachment preserves payload state. A failed attachment leaves the node
// unchanged; a successfully registered type may remain cached for a retry.
export fn compiler_world_component(world: CompilerWorld*, owner: Entity*, kind: u32): void* {
    var error = WorkBudgetError.None;
    return compiler_world_component_result(world, owner, kind, &error);
}

export fn compiler_world_component_result(world: CompilerWorld*, owner: Entity*, kind: u32, error: WorkBudgetError*): void* {
    *error = WorkBudgetError.None;
    var missing_owner = owner == null || world == null;
    if missing_owner || owner.store != world.store {
        *error = WorkBudgetError.Invalid;
        return null;
    }
    var type = compiler_world_type_result(world, kind, error);
    if type == null {
        return null;
    }
    var data = compiler_world_get(world, owner, kind);
    if data != null {
        return data;
    }
    data = bits(void*, entity_component_data(entity_component_add_result(owner, type, error)));
    if data == null {
        return null;
    }
    if kind <= CompilerParserMatch {
        node_payload_init(kind, data);
    }
    if kind == CompilerSyntax {
        syntax_node_init(bits(SyntaxNode*, data));
    }
    if kind == CompilerFoundation {
        foundation_node_init(bits(FoundationNode*, data));
    }
    if kind == CompilerSyntaxOrigin {
        fill(data, 0, sizeof(SyntaxOrigin));
    }
    if kind == CompilerSyntaxExpansion {
        fill(data, 0, sizeof(SyntaxExpansion));
    }
    return data;
}

// Failed disposal is non-mutating. All requests and views must drain first.
export fn compiler_world_dispose(world: CompilerWorld*): bool {
    if world.grammar.workers_busy { return false; }
    // Drain frontend caches explicitly, after their requests have joined.
    var cached = world.grammar.bedrock != null;
    if cached {
        return false;
    }
    cached = world.grammar.patterns != null;
    if cached {
        return false;
    }
    if world.grammar.syntax is not null {
        return false;
    }
    if world.store.views != 0 {
        return false;
    }
    if entity_store_count(world.store) != world.registered {
        return false;
    }
    if entity_store_component_count(world.store) != 0 || world.store.storage.first != null {
        return false;
    }
    var index: u32 = 0;
    for(; index < CompilerComponentCount; index++) {
        var type = world.types[index];
        var present = type != null;
        if present {
            if entity_references(type) != 1 {
                return false;
            }
        }
    }
    index = 0;
    work_pool_close(&world.grammar.workers);
    for(; index < CompilerComponentCount; index++) {
        var type = world.types[index];
        var present = type != null;
        if present {
            entity_release(type);
        }
    }
    if !entity_store_dispose(world.store) { trap("Compiler world store still borrowed", 0); }
    var allocation = world.allocation;
    work_buffer_dispose(&allocation);
    return true;
}
