import tower;

// Shared parser protocol markers; ordinary scalar IDs occupy the other values.
var ParserStreamEnd: u32 = 4294967294;
var ParserLookahead: u32 = 4294967293;

fn ParserNoIndex(): usize {
    var index: usize = 0;
    index--;
    return index;
}

// These statuses describe a request protocol, never foundation instructions.
enum ParserAction: u32 {
    NeedInput, Shift, Reduce, Accept, Unexpected, EmptyPrefix,
    SequenceShift, SequenceReduce, Invalid
}

enum ParserInputService: u32 {
    Empty, Utf8, Recognizer, Syntax, Template
}
