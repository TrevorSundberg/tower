import tower;
import .library.work_pool;

extern fn compiler_node_world(node: void*): void*;
extern fn compiler_world_worker_limit(world: void*): usize;

// Each world has an immutable capacity ceiling. Shared-ledger callers reserve
// extra lanes separately before dispatch; capacity alone grants no entitlement.
// Plain library entity stores retain the host policy.
fn compiler_worker_capacity(anchor: void*): usize {
    var world = compiler_node_world(anchor);
    var available = work_thread_capacity();
    if world is not null {
        var limit = compiler_world_worker_limit(world);
        return limit < available ? limit : available;
    }
    return available;
}
