import tower;
import syntax_types;
import parser_nodes;
import .library.vector;

// Immutable source storage shared by declaration entities and later diagnostics.
// These references use the compiler runtime's current single-threaded ownership.
export fn syntax_source_size(): usize {
    return sizeof(SyntaxSource);
}

export fn syntax_source_retain(source: SyntaxSource*): void {
    if source != null {
        source.references++;
    }
}

export fn syntax_source_release(source: SyntaxSource*): void {
    if source == null {
        return;
    }
    source.references--;
    if source.references == 0 {
        vector_dispose(&source.name);
        vector_dispose(&source.text);
        free(source);
    }
}

export fn syntax_source_create(name: u8*, text: u8*, length: usize): SyntaxSource* {
    var needed = length + 1;
    if needed == 0 {
        return null;
    }
    var source = alloc(SyntaxSource, 1);
    if source == null {
        return null;
    }
    fill(source, 0, sizeof(SyntaxSource));
    source.references = 1;
    var ok = node_text_set(&source.name, name);
    ok &&= vector_reserve(&source.text, needed);
    if ok {
        if length != 0 {
            copy(source.text.data, text, length);
        }
        source.text.length = length;
        source.text.data[length] = 0;
        return source;
    }
    syntax_source_release(source);
    return null;
}

// Match the compiler's source-column convention: one per non-continuation UTF-8
// byte, newline resets to column one. Offsets beyond the snapshot clamp to EOF.
export fn syntax_source_location(source: SyntaxSource*, offset: usize, line: usize*, column: usize*): void {
    *line = 1;
    *column = 1;
    if offset > source.text.length {
        offset = source.text.length;
    }
    var index: usize = 0;
    loop {
        if index == offset {
            return;
        }
        var byte = source.text.data[index];
        if byte == 10 {
            *line = *line + 1;
            *column = 1;
        } else {
            var prefix = byte &192;
            if prefix != 128 {
                *column = *column + 1;
            }
        }
        index++;
    }
}
