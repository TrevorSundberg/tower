import tower;
import lr_types;
import lexer_table;
import .library.vector;
import .library.work_vector;
import .library.work_vector_types;
import .library.work_budget_types;
import .library.work_buffer;
import .library.work_buffer_types;
import .library.work_arena_api;
import .library.work_arena_types;
import .library.graph_components_interface;

struct LRSuffix {
    begin: usize;
    count: usize;
    nullable: bool;
    error: WorkBudgetError;
}

// Derived, immutable after FIRST converges. Production bases distinguish rules
// that borrow overlapping symbol spans but have different suffix boundaries.
struct LRSuffixIndex {
    storage: WorkBuffer;
    range_storage: WorkBuffer;
    bases: usize*;
    entries: LRSuffix*;
    ranges: vector(SymbolRange);
}

// Disposable FIRST/nullable and LR item indexes over the shared grammar entities.
// Character and token streams use the same integer ranges and closure algorithm.
struct LRNonterminal {
    nullable: bool;
    order: usize;
    first: work_vector(SymbolRange);
    productions: work_vector(usize);
    initial_first: SymbolRange[WorkBufferInitialElements];
    initial_productions: usize[WorkBufferInitialElements];
}

struct LRAnalysis {
    storage: WorkBuffer;
    nonterminal_storage: WorkBuffer;
    budget: WorkBudget*;
    rules: LRProduction*;
    rule_count: usize;
    symbols: LRSymbol*;
    symbol_count: usize;
    nonterminals: LRNonterminal*;
    nonterminal_count: usize;
    failed: bool;
    suffix_ready: bool;
    suffix: LRSuffixIndex*;
    closure_scratch: LRClosureScratch*;
}

struct LRItems {
    storage: WorkBuffer;
    budget: WorkBudget*;
    scratch: WorkArena;
    memory: WorkArena*;
    values: work_vector(LRItem);
    pending: work_vector(LRItem);
    failed: bool;
    resource_error: WorkBudgetError;
    initial_values: LRItem[WorkBufferInitialElements];
    initial_pending: LRItem[WorkBufferInitialElements];
}

fn lr_items_fail(value: LRItems*, error: WorkBudgetError): bool {
    value.failed = true;
    if value.resource_error == WorkBudgetError.None { value.resource_error = error; }
    return false;
}

fn lr_none(): usize {
    var value: usize = 0;
    value--;
    return value;
}

fn lr_append(T: type, values: vector(T)*, value: T*): bool {
    var count = values.length + 1;
    if count == 0 {
        return false;
    }
    var ok = vector_reserve(values, count);
    if ok {
        copy(&values.data[values.length], value, sizeof(T));
        values.length = count;
    }
    return ok;
}

// Disposable indexes use the same transactional physical owner as other compiler
// scratch. The borrowed budget is fixed before dispatch; null is standalone only.
fn lr_reserve_result(T: type, values: work_vector(T)*, count: usize, budget: WorkBudget*): WorkBudgetError {
    if sizeof(T) == 0 || count > ~convert(usize, 0) / sizeof(T) { return WorkBudgetError.Invalid; }
    return work_vector_reserve_result(values, budget, count);
}

fn lr_push_result(T: type, values: work_vector(T)*, value: T, budget: WorkBudget*): WorkBudgetError {
    var count = values.length + 1;
    if count == 0 { return WorkBudgetError.Invalid; }
    var error = lr_reserve_result(values, count, budget);
    if error != WorkBudgetError.None { return error; }
    values.data[values.length] = value;
    values.length = count;
    return WorkBudgetError.None;
}

// A propagation row initially borrows its own stable inline slots. Its node
// buffer charges those bytes. Promote transactionally to an ordinary owner;
// never free the borrowed slots or copy a receipt as independent ownership.
fn lr_reserve_initial_result(T: type, values: work_vector(T)*, count: usize, budget: WorkBudget*, initial: T*): WorkBudgetError {
    if initial == null || values.data != initial { return lr_reserve_result(values, count, budget); }
    if count <= values.capacity { return WorkBudgetError.None; }
    var capacity = values.capacity * 2;
    if capacity < values.capacity || capacity < count { capacity = count; }
    var next: work_vector(T) = default;
    var error = lr_reserve_result(&next, capacity, budget);
    if error != WorkBudgetError.None { return error; }
    copy(next.data, values.data, values.length * sizeof(T));
    next.length = values.length;
    *values = next;
    return WorkBudgetError.None;
}

fn lr_push_initial_result(T: type, values: work_vector(T)*, value: T, budget: WorkBudget*, initial: T*): WorkBudgetError {
    var count = values.length + 1;
    if count == 0 { return WorkBudgetError.Invalid; }
    var error = lr_reserve_initial_result(values, count, budget, initial);
    if error != WorkBudgetError.None { return error; }
    values.data[values.length] = value;
    values.length = count;
    return WorkBudgetError.None;
}

// Vectors in a common-retirement arena are borrowed views, not buffer owners.
// Growth keeps old bytes charged until that arena closes. A joined independent
// worker buffer is released only after a successful copy into the arena.
fn lr_reserve_arena_result(T: type, values: work_vector(T)*, count: usize, arena: WorkArena*, owned: bool*): WorkBudgetError {
    return lr_buffer_arena_reserve(bits(u8**, &values.data), values.length, &values.capacity,
        &values.reservation, count, sizeof(T), alignof(T), arena, owned);
}

// One synchronous field borrow keeps the ordinary generic expansion bounded.
// The shared WorkArena still performs allocation, alignment and byte admission.
fn lr_buffer_arena_reserve(data: u8**, length: usize, old_capacity: usize*, reservation: WorkReservation*,
    count: usize, size: usize, alignment: usize, arena: WorkArena*, owned: bool*): WorkBudgetError {
    if length > *old_capacity || size == 0 || count > ~convert(usize, 0) / size { return WorkBudgetError.Invalid; }
    if count <= *old_capacity { return WorkBudgetError.None; }
    var capacity = *old_capacity * 2;
    if capacity < *old_capacity || capacity < count || capacity > ~convert(usize, 0) / size { capacity = count; }
    if capacity < WorkBufferInitialElements { capacity = WorkBufferInitialElements; }
    if capacity > ~convert(usize, 0) / size { capacity = count; }
    var next: u8* = null;
    var error = work_arena_allocate_result(arena, capacity * size, alignment, &next);
    if error != WorkBudgetError.None { return error; }
    if length != 0 { copy(next, *data, length * size); }
    if owned != null && *owned { work_buffer_release(bits(void*, *data), reservation); *owned = false; }
    *data = next;
    *old_capacity = capacity;
    *reservation = default;
    return WorkBudgetError.None;
}

fn lr_push_arena_result(T: type, values: work_vector(T)*, value: T, arena: WorkArena*, owned: bool*): WorkBudgetError {
    var count = values.length + 1;
    if count == 0 { return WorkBudgetError.Invalid; }
    var error = lr_reserve_arena_result(values, count, arena, owned);
    if error != WorkBudgetError.None { return error; }
    values.data[values.length] = value;
    values.length = count;
    return WorkBudgetError.None;
}

// Preserve distinct range identities here: overlapping ranges can represent
// different parse actions. Union/partition belongs to action construction.
fn lr_range_insert_result(values: work_vector(SymbolRange)*, first: u32, last: u32, changed: bool*, budget: WorkBudget*): WorkBudgetError {
    return lr_range_insert_storage_result(values, first, last, changed, budget, null);
}

fn lr_range_insert_storage_result(values: work_vector(SymbolRange)*, first: u32, last: u32, changed: bool*, budget: WorkBudget*, initial: SymbolRange*): WorkBudgetError {
    return lr_range_insert_arena_result(values, first, last, changed, budget, initial, null, null);
}

fn lr_range_insert_arena_result(values: work_vector(SymbolRange)*, first: u32, last: u32, changed: bool*, budget: WorkBudget*, initial: SymbolRange*, arena: WorkArena*, owned: bool*): WorkBudgetError {
    var low: usize = 0;
    var high = values.length;
    // Unsigned lexicographic order of two u32 endpoints is exactly the order
    // of this u64 key. Construct values explicitly, independent of byte order
    // or payload layout; overlapping ranges retain their distinct identities.
    var key = (convert(u64, first) << 32) | convert(u64, last);
    loop {
        if low == high {
            break;
        }
        var middle = high -low;
        middle = middle / 2;
        middle = middle + low;
        var value = &values.data[middle];
        var candidate = (convert(u64, value.first) << 32) | convert(u64, value.last);
        if candidate < key {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if low < values.length {
        var value = &values.data[low];
        var same = value.first == first;
        var end_same = value.last == last;
        same &&= end_same;
        if same {
            return WorkBudgetError.None;
        }
    }
    var count = values.length + 1;
    if count == 0 { return WorkBudgetError.Invalid; }
    var error = arena == null ? lr_reserve_initial_result(values, count, budget, initial) : lr_reserve_arena_result(values, count, arena, owned);
    if error != WorkBudgetError.None { return error; }
    var moved = values.length -low;
    var bytes = moved *sizeof(SymbolRange);
    var next = low + 1;
    copy(&values.data[next], &values.data[low], bytes);
    values.data[low].first = first;
    values.data[low].last = last;
    values.length = count;
    *changed = true;
    return WorkBudgetError.None;
}

fn lr_range_merge_result(destination: work_vector(SymbolRange)*, source: work_vector(SymbolRange)*, changed: bool*, budget: WorkBudget*): WorkBudgetError {
    return lr_range_merge_storage_result(destination, source, changed, budget, null);
}

fn lr_range_merge_storage_result(destination: work_vector(SymbolRange)*, source: work_vector(SymbolRange)*, changed: bool*, budget: WorkBudget*, initial: SymbolRange*): WorkBudgetError {
    return lr_range_merge_arena_result(destination, source, changed, budget, initial, null, null);
}

fn lr_range_merge_arena_result(destination: work_vector(SymbolRange)*, source: work_vector(SymbolRange)*, changed: bool*, budget: WorkBudget*, initial: SymbolRange*, arena: WorkArena*, owned: bool*): WorkBudgetError {
    if destination == source || source.length == 0 {
        return WorkBudgetError.None;
    }
    if source.length == 1 {
        return lr_range_insert_arena_result(destination, source.data[0].first, source.data[0].last, changed, budget, initial, arena, owned);
    }
    // FIRST, suffix and propagation callers supply distinct owned vectors (or
    // the identical descriptor handled above). Both sets are already sorted.
    // Count only new exact ranges: overlapping intervals must stay distinct.
    var left: usize = 0;
    var right: usize = 0;
    var added: usize = 0;
    while right < source.length {
        if left == destination.length { added += source.length - right; break; }
        var a = &destination.data[left];
        var b = &source.data[right];
        if a.first == b.first && a.last == b.last { left++; right++; }
        else {
            if a.first < b.first || (a.first == b.first && a.last < b.last) { left++; }
            else { added++; right++; }
        }
    }
    if added == 0 { return WorkBudgetError.None; }
    if added > ~convert(usize, 0) - destination.length { return WorkBudgetError.Invalid; }
    var count = destination.length + added;
    var error = arena == null ? lr_reserve_initial_result(destination, count, budget, initial) : lr_reserve_arena_result(destination, count, arena, owned);
    if error != WorkBudgetError.None { return error; }
    // The source already holds the complete sorted union for an empty row.
    if destination.length == 0 {
        copy(destination.data, source.data, count * sizeof(SymbolRange));
        destination.length = count;
        *changed = true;
        return WorkBudgetError.None;
    }
    // Backward merge consumes each old slot before overwriting it. No scratch
    // owner or per-insert shifting is needed; denial leaves the old set intact.
    left = destination.length;
    right = source.length;
    var out = count;
    while right != 0 {
        var b = source.data[right - 1];
        if left != 0 {
            var a = destination.data[left - 1];
            if a.first == b.first && a.last == b.last { left--; right--; destination.data[--out] = a; }
            else {
                if b.first < a.first || (b.first == a.first && b.last < a.last) {
                    left--; destination.data[--out] = a;
                } else { right--; destination.data[--out] = b; }
            }
        } else { right--; destination.data[--out] = b; }
    }
    destination.length = count;
    *changed = true;
    return WorkBudgetError.None;
}

export fn lr_analysis_destroy(value: LRAnalysis*): void {
    if value == null {
        return;
    }
    lr_analysis_scratch_dispose(value);
    lr_suffix_index_dispose(value.suffix);
    var index: usize = 0;
    for(; index != value.nonterminal_count; index++) {
        var item = &value.nonterminals[index];
        if item.first.data != &item.initial_first[0] { work_vector_dispose(&item.first); }
        if item.productions.data != &item.initial_productions[0] { work_vector_dispose(&item.productions); }
    }
    work_buffer_dispose(&value.nonterminal_storage);
    var storage = value.storage;
    work_buffer_dispose(&storage);
}

// Production/symbol arrays are borrowed and immutable for this analysis lifetime.
export fn lr_analysis_create(rules: LRProduction*, rule_count: usize, symbols: LRSymbol*, symbol_count: usize, nonterminal_count: usize): LRAnalysis* {
    var error = WorkBudgetError.None;
    return lr_analysis_create_result(rules, rule_count, symbols, symbol_count, nonterminal_count, &error);
}

export fn lr_analysis_create_result(rules: LRProduction*, rule_count: usize, symbols: LRSymbol*, symbol_count: usize,
nonterminal_count: usize, error: WorkBudgetError*): LRAnalysis* {
    return lr_analysis_create_budget_result(rules, rule_count, symbols, symbol_count, nonterminal_count, null, error);
}

export fn lr_analysis_create_budget_result(rules: LRProduction*, rule_count: usize, symbols: LRSymbol*, symbol_count: usize,
nonterminal_count: usize, budget: WorkBudget*, error: WorkBudgetError*): LRAnalysis* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if (rule_count != 0 && rules == null) || (symbol_count != 0 && symbols == null)
        || rule_count > ~convert(usize, 0) / sizeof(LRProduction)
        || symbol_count > ~convert(usize, 0) / sizeof(LRSymbol)
        || nonterminal_count > ~convert(usize, 0) / sizeof(LRNonterminal) { return null; }
    for(var i: usize = 0; i < rule_count; i++) {
        var rule = &rules[i];
        if rule.owner >= nonterminal_count || rule.begin > symbol_count
            || rule.count > symbol_count - rule.begin { return null; }
    }
    var storage: WorkBuffer = default;
    *error = work_buffer_resize(&storage, budget, sizeof(LRAnalysis), 0);
    if *error != WorkBudgetError.None { return null; }
    var result = bits(LRAnalysis*, storage.data);
    *result = default;
    result.storage = storage;
    result.budget = budget;
    result.rules = rules;
    result.rule_count = rule_count;
    result.symbols = symbols;
    result.symbol_count = symbol_count;
    *error = work_buffer_resize(&result.nonterminal_storage, budget, sizeof(LRNonterminal) * nonterminal_count, 0);
    if *error != WorkBudgetError.None {
        lr_analysis_destroy(result);
        return null;
    }
    result.nonterminals = bits(LRNonterminal*, result.nonterminal_storage.data);
    result.nonterminal_count = nonterminal_count;
    var bytes = sizeof(LRNonterminal) *nonterminal_count;
    fill(result.nonterminals, 0, bytes);
    var index: usize = 0;
    for(; index != nonterminal_count; index++) {
        var item = &result.nonterminals[index];
        item.order = index;
        item.first.data = &item.initial_first[0];
        item.first.capacity = sizeof(decltype(item.initial_first)) / sizeof(SymbolRange);
        item.productions.data = &item.initial_productions[0];
        item.productions.capacity = sizeof(decltype(item.initial_productions)) / sizeof(usize);
    }
    index = 0;
    loop {
        if index == rule_count {
            *error = WorkBudgetError.None;
            return result;
        }
        var rule = &rules[index];
        var item = &result.nonterminals[rule.owner];
        *error = lr_push_initial_result(&item.productions, index, budget, &item.initial_productions[0]);
        if *error != WorkBudgetError.None {
            lr_analysis_destroy(result);
            return null;
        }
        index++;
    }
}

export fn lr_analysis_compute(value: LRAnalysis*): bool {
    return lr_analysis_compute_result(value) == WorkBudgetError.None;
}

export fn lr_analysis_compute_result(value: LRAnalysis*): WorkBudgetError {
    var error = lr_analysis_first_result(value);
    if error == WorkBudgetError.None { error = lr_suffix_index_result(value, value.budget); }
    if value != null { value.failed = error != WorkBudgetError.None; }
    return error;
}

// The parallel FIRST pump may finish a narrow frontier here. Its owning caller
// publishes suffix storage only after the entire FIRST dependency graph joins.
fn lr_analysis_first_result(value: LRAnalysis*): WorkBudgetError {
    if value == null { return WorkBudgetError.Invalid; }
    loop {
        var changed: bool = false;
        var index: usize = 0;
        loop {
            var done = index == value.rule_count;
            if done {
                break;
            }
            var rule = &value.rules[index];
            var owner = &value.nonterminals[rule.owner];
            var nullable: bool = true;
            var position: usize = 0;
            loop {
                done = position == rule.count;
                if done {
                    break;
                }
                var symbol_index = rule.begin + position;
                var symbol = &value.symbols[symbol_index];
                var terminal = symbol.nonterminal == lr_none();
                var error = WorkBudgetError.None;
                if terminal {
                    error = lr_range_insert_storage_result(&owner.first, symbol.first, symbol.last, &changed, value.budget, &owner.initial_first[0]);
                    nullable = false;
                } else {
                    if symbol.nonterminal >= value.nonterminal_count {
                        value.failed = true;
                        return WorkBudgetError.Invalid;
                    }
                    var referenced = &value.nonterminals[symbol.nonterminal];
                    error = lr_range_merge_storage_result(&owner.first, &referenced.first, &changed, value.budget, &owner.initial_first[0]);
                    nullable = referenced.nullable;
                }
                if error != WorkBudgetError.None {
                    value.failed = true;
                    return error;
                }
                if !nullable {
                    break;
                }
                position++;
            }
            if nullable {
                if !owner.nullable {
                    owner.nullable = true;
                    changed = true;
                }
            }
            index++;
        }
        if !changed {
            value.failed = false;
            return WorkBudgetError.None;
        }
    }
}

export fn lr_analysis_failed(value: LRAnalysis*): bool {
    return value.failed;
}

export fn lr_analysis_order(value: LRAnalysis*, index: usize, order: usize): void {
    value.nonterminals[index].order = order;
}

export fn lr_analysis_nullable(value: LRAnalysis*, index: usize): bool {
    return value.nonterminals[index].nullable;
}

export fn lr_analysis_first_count(value: LRAnalysis*, index: usize): usize {
    return value.nonterminals[index].first.length;
}

export fn lr_analysis_first_data(value: LRAnalysis*, index: usize): SymbolRange* {
    return value.nonterminals[index].first.data;
}

export fn lr_items_create(): LRItems* {
    var error = WorkBudgetError.None;
    return lr_items_create_result(null, &error);
}

export fn lr_items_create_result(budget: WorkBudget*, error: WorkBudgetError*): LRItems* {
    if error == null { return null; }
    var storage: WorkBuffer = default;
    *error = work_buffer_resize(&storage, budget, sizeof(LRItems), 0);
    if *error != WorkBudgetError.None { return null; }
    var result = bits(LRItems*, storage.data);
    *result = default;
    result.storage = storage;
    result.budget = budget;
    lr_items_initial(result);
    return result;
}

fn lr_items_initial(value: LRItems*): void {
    if value.memory == null {
        var bytes = sizeof(WorkArenaChunk) + sizeof(decltype(value.initial_values)) + sizeof(decltype(value.initial_pending));
        if !work_arena_init(&value.scratch, value.budget, bytes) { lr_items_fail(value, WorkBudgetError.Invalid); }
        value.memory = &value.scratch;
    }
    value.values.data = &value.initial_values[0];
    value.values.capacity = sizeof(decltype(value.initial_values)) / sizeof(LRItem);
    value.pending.data = &value.initial_pending[0];
    value.pending.capacity = sizeof(decltype(value.initial_pending)) / sizeof(LRItem);
}

// Coordinator state/item descriptors share the state's retirement boundary.
// The arena owns their physical bytes; each descriptor still disposes its own
// promoted vectors. Worker results and standalone callers remain separate owners.
fn lr_items_arena_result(arena: WorkArena*, error: WorkBudgetError*): LRItems* {
    var data: u8* = null;
    *error = work_arena_allocate_result(arena, sizeof(LRItems), alignof(LRItems), &data);
    if *error != WorkBudgetError.None { return null; }
    var value = bits(LRItems*, data);
    *value = default;
    value.budget = arena.budget;
    value.memory = arena;
    lr_items_initial(value);
    return value;
}

fn lr_items_vectors_dispose(value: LRItems*): void {
    work_arena_dispose(&value.scratch);
}

export fn lr_items_destroy(value: LRItems*): void {
    if value == null {
        return;
    }
    lr_items_vectors_dispose(value);
    var storage = value.storage;
    work_buffer_dispose(&storage);
}

fn lr_item_less(a: LRItem*, b: LRItem*): bool {
    var different = a.rule != b.rule;
    if different {
        var less = a.rule < b.rule;
        return less;
    }
    different = a.position != b.position;
    if different {
        var less = a.position < b.position;
        return less;
    }
    different = a.first != b.first;
    if different {
        var less = a.first < b.first;
        return less;
    }
    var less = a.last < b.last;
    return less;
}

export fn lr_items_insert(value: LRItems*, item: LRItem*): bool {
    if value.failed {
        return false;
    }
    // The caller may supply an item from this vector, which growth invalidates.
    var saved: LRItem;
    copy(&saved, item, sizeof(LRItem));
    var low: usize = 0;
    var high = value.values.length;
    loop {
        if low == high {
            break;
        }
        var middle = high -low;
        middle = middle / 2;
        middle = middle + low;
        if lr_item_less(&value.values.data[middle], &saved) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if low < value.values.length {
        if !lr_item_less(&saved, &value.values.data[low]) {
            return true;
        }
    }
    var count = value.values.length + 1;
    if count == 0 { return lr_items_fail(value, WorkBudgetError.Invalid); }
    var error = lr_reserve_arena_result(&value.values, count, value.memory, null);
    if error == WorkBudgetError.None { error = lr_push_arena_result(&value.pending, saved, value.memory, null); }
    if error != WorkBudgetError.None { return lr_items_fail(value, error); }
    var moved = value.values.length -low;
    var bytes = moved *sizeof(LRItem);
    var next = low + 1;
    copy(&value.values.data[next], &value.values.data[low], bytes);
    copy(&value.values.data[low], &saved, sizeof(LRItem));
    value.values.length = count;
    return true;
}

export fn lr_items_count(value: LRItems*): usize {
    return value.values.length;
}

export fn lr_items_data(value: LRItems*): LRItem* {
    return value.values.data;
}

fn lr_suffix_result(value: LRAnalysis*, rule: LRProduction*, position: usize, item: LRItem*, ranges: work_vector(SymbolRange)*, initial: SymbolRange*): WorkBudgetError {
    var changed: bool = false;
    if value.suffix_ready && position != 0 && position < rule.count {
        var suffix = &value.suffix.entries[value.suffix.bases[item.rule] + position - 1];
        if suffix.error != WorkBudgetError.None { return suffix.error; }
        var needed = suffix.count + (suffix.nullable ? 1 : 0);
        if needed < suffix.count { return WorkBudgetError.Invalid; }
        var error = lr_reserve_initial_result(ranges, needed, value.budget, initial);
        if error != WorkBudgetError.None { return error; }
        if suffix.count != 0 {
            copy(ranges.data, value.suffix.ranges.data + suffix.begin, suffix.count * sizeof(SymbolRange));
        }
        ranges.length = suffix.count;
        return suffix.nullable ? lr_range_insert_storage_result(ranges, item.first, item.last, &changed, value.budget, initial) : WorkBudgetError.None;
    }
    loop {
        if position >= rule.count {
            return lr_range_insert_storage_result(ranges, item.first, item.last, &changed, value.budget, initial);
        }
        var index = rule.begin + position;
        var symbol = &value.symbols[index];
        if symbol.nonterminal == lr_none() {
            return lr_range_insert_storage_result(ranges, symbol.first, symbol.last, &changed, value.budget, initial);
        }
        if symbol.nonterminal >= value.nonterminal_count { return WorkBudgetError.Invalid; }
        var next = &value.nonterminals[symbol.nonterminal];
        var error = lr_range_merge_storage_result(ranges, &next.first, &changed, value.budget, initial);
        if error != WorkBudgetError.None { return error; }
        if !next.nullable {
            return WorkBudgetError.None;
        }
        position++;
    }
}

fn lr_suffix_index_dispose(index: LRSuffixIndex*): void {
    if index == null { return; }
    work_buffer_dispose(&index.range_storage);
    var storage = index.storage;
    work_buffer_dispose(&storage);
}

fn lr_suffix_range_result(index: LRSuffixIndex*, budget: WorkBudget*, begin: usize,
    first: u32, last: u32): WorkBudgetError {
    var needed = index.ranges.length + 1;
    if needed == 0 { return WorkBudgetError.Invalid; }
    var error = WorkBudgetError.None;
    if needed > index.ranges.capacity {
        error = work_buffer_grow_elements(&index.range_storage, budget, index.ranges.length,
            index.ranges.capacity, needed, sizeof(SymbolRange), alignof(SymbolRange));
        if error != WorkBudgetError.None { return error; }
        index.ranges.data = bits(SymbolRange*, index.range_storage.data);
        index.ranges.capacity = index.range_storage.capacity / sizeof(SymbolRange);
    }
    // Non-owning bounded view: the work buffer reserved the insertion slot, so
    // the shared exact-range insertion cannot grow or free this borrowed slice.
    var ranges = init(work_vector(SymbolRange)) {data: index.ranges.data + begin,
        length: index.ranges.length - begin, capacity: index.ranges.capacity - begin, ..default};
    // Borrow only: no active receipt, no disposal, and the insertion slot was
    // reserved above. The owner check still uses the actual parent budget.
    ranges.reservation.owner = budget;
    var changed = false;
    error = lr_range_insert_result(&ranges, first, last, &changed, budget);
    index.ranges.length = begin + ranges.length;
    return error;
}

fn lr_suffix_index_result(value: LRAnalysis*, budget: WorkBudget*): WorkBudgetError {
    if value.suffix_ready { return WorkBudgetError.None; }
    var count: usize = 0;
    for(var i: usize = 0; i < value.rule_count; i++) {
        if value.rules[i].count > ~convert(usize, 0) - count { return WorkBudgetError.Invalid; }
        count += value.rules[i].count;
    }
    if count == 0 { value.suffix_ready = true; return WorkBudgetError.None; }
    var maximum = ~convert(usize, 0);
    if value.rule_count > (maximum - sizeof(LRSuffixIndex)) / sizeof(usize) { return WorkBudgetError.Invalid; }
    var offset = sizeof(LRSuffixIndex) + value.rule_count * sizeof(usize);
    var alignment = alignof(LRSuffix);
    var padding = (alignment - offset % alignment) % alignment;
    if padding > maximum - offset { return WorkBudgetError.Invalid; }
    offset += padding;
    if count > (maximum - offset) / sizeof(LRSuffix) { return WorkBudgetError.Invalid; }
    var storage: WorkBuffer = default;
    var error = work_buffer_resize(&storage, budget, offset + count * sizeof(LRSuffix), 0);
    if error != WorkBudgetError.None { return error; }
    var index = bits(LRSuffixIndex*, storage.data);
    *index = default;
    index.storage = storage;
    index.bases = bits(usize*, storage.data + sizeof(LRSuffixIndex));
    index.entries = bits(LRSuffix*, storage.data + offset);
    var unpublished = index;
    defer lr_suffix_index_dispose(unpublished);
    fill(index.entries, 0, count * sizeof(LRSuffix));
    var base: usize = 0;
    for(var i: usize = 0; i < value.rule_count; i++) {
        var rule = &value.rules[i];
        index.bases[i] = base;
        for(var at: usize = 0; at < rule.count; at++) {
            // Closure only requests the suffix following a nonterminal.
            if value.symbols[rule.begin + at].nonterminal == lr_none() { continue; }
            var suffix = &index.entries[base + at];
            suffix.begin = index.ranges.length;
            suffix.nullable = true;
            for(var position = at + 1; position < rule.count && suffix.nullable; position++) {
                var symbol = &value.symbols[rule.begin + position];
                if symbol.nonterminal == lr_none() {
                    error = lr_suffix_range_result(index, budget, suffix.begin, symbol.first, symbol.last);
                    if error != WorkBudgetError.None { return error; }
                    suffix.nullable = false;
                } else {
                    // An invalid unreachable tail must not fail FIRST early.
                    // Publish its error only when a closure requests this row.
                    if symbol.nonterminal >= value.nonterminal_count {
                        suffix.error = WorkBudgetError.Invalid;
                        suffix.nullable = false;
                        break;
                    }
                    var next = &value.nonterminals[symbol.nonterminal];
                    foreach(var &range in &next.first) {
                        error = lr_suffix_range_result(index, budget, suffix.begin, range.first, range.last);
                        if error != WorkBudgetError.None { return error; }
                    }
                    suffix.nullable = next.nullable;
                }
            }
            suffix.count = index.ranges.length - suffix.begin;
        }
        base += rule.count;
    }
    // No partially built row escapes on denial. Workers copy only a borrow of
    // these buffers; the analysis owner releases them after every reader joins.
    value.suffix = index;
    unpublished = null;
    value.suffix_ready = true;
    return WorkBudgetError.None;
}

// Closure-local membership index. Item order is private until the closure joins;
// sorting once then restores the exact public LR order without quadratic shifts.
// Each worker owns this scratch; grammar entities remain the semantic authority.
struct LRItemIndex {
    slots: work_vector(usize);
    initial: usize*;
}

var LRItemIndexInitialSlots: usize = 32;

// One charged, closure-private allocation owns the initial temporary slots.
// Larger rows promote independently; all readers end before this owner closes.
struct LRClosureScratch {
    storage: WorkBuffer;
    expanded: LRItems;
    membership: LRItemIndex;
    expansion: LRItemIndex;
    ranges: work_vector(SymbolRange);
    initial_membership: usize[LRItemIndexInitialSlots];
    initial_expansion: usize[LRItemIndexInitialSlots];
    initial_ranges: SymbolRange[WorkBufferInitialElements];
}

fn lr_analysis_scratch_dispose(value: LRAnalysis*): void {
    var scratch = value.closure_scratch;
    if scratch == null { return; }
    value.closure_scratch = null;
    lr_items_vectors_dispose(&scratch.expanded);
    if scratch.membership.slots.data != scratch.membership.initial { work_vector_dispose(&scratch.membership.slots); }
    if scratch.expansion.slots.data != scratch.expansion.initial { work_vector_dispose(&scratch.expansion.slots); }
    if scratch.ranges.data != &scratch.initial_ranges[0] { work_vector_dispose(&scratch.ranges); }
    var storage = scratch.storage;
    work_buffer_dispose(&storage);
}

enum LRItemSlot: usize { Vacant = 0 }

fn lr_item_hash(item: LRItem*): usize {
    var basis: usize = 2166136261;
    var multiplier: usize = 16777619;
    var hash = (basis ^ item.rule) * multiplier;
    hash = (hash ^ item.position) * multiplier;
    hash = (hash ^ convert(usize, item.first)) * multiplier;
    return (hash ^ convert(usize, item.last)) * multiplier;
}

fn lr_item_index_reserve_result(index: LRItemIndex*, values: work_vector(LRItem)*, budget: WorkBudget*): WorkBudgetError {
    var minimum_capacity = LRItemIndexInitialSlots;
    var load_divisor: usize = 2;
    if values.length < index.slots.length / load_divisor { return WorkBudgetError.None; }
    var capacity = index.slots.length;
    if capacity == 0 { capacity = minimum_capacity; }
    while values.length >= capacity / load_divisor {
        var next = capacity * load_divisor;
        if next <= capacity { return WorkBudgetError.Invalid; }
        capacity = next;
    }
    var error = lr_reserve_initial_result(&index.slots, capacity, budget, index.initial);
    if error != WorkBudgetError.None { return error; }
    index.slots.length = capacity;
    // Zero is vacant; occupied slots contain the item index plus one.
    fill(index.slots.data, 0, capacity * sizeof(usize));
    for (var i: usize = 0; i < values.length; ++i) {
        var slot = lr_item_hash(&values.data[i]) & (capacity - 1);
        while index.slots.data[slot] != convert(usize, LRItemSlot.Vacant) { slot = (slot + 1) & (capacity - 1); }
        index.slots.data[slot] = i + 1;
    }
    return WorkBudgetError.None;
}

fn lr_item_index_insert(index: LRItemIndex*, items: LRItems*, item: LRItem*, queue: bool): bool {
    if items.failed { return false; }
    var saved = *item;
    var error = lr_item_index_reserve_result(index, &items.values, items.budget);
    if error != WorkBudgetError.None { return lr_items_fail(items, error); }
    var mask = index.slots.length - 1;
    var slot = lr_item_hash(&saved) & mask;
    while index.slots.data[slot] != convert(usize, LRItemSlot.Vacant) {
        var previous = &items.values.data[index.slots.data[slot] - 1];
        if previous.rule == saved.rule && previous.position == saved.position &&
            previous.first == saved.first && previous.last == saved.last { return true; }
        slot = (slot + 1) & mask;
    }
    var count = items.values.length + 1;
    if count == 0 { return lr_items_fail(items, WorkBudgetError.Invalid); }
    error = lr_reserve_arena_result(&items.values, count, items.memory, null);
    if error == WorkBudgetError.None && queue { error = lr_push_arena_result(&items.pending, saved, items.memory, null); }
    if error != WorkBudgetError.None { return lr_items_fail(items, error); }
    items.values.data[items.values.length] = saved;
    items.values.length = count;
    index.slots.data[slot] = count;
    return true;
}

fn lr_items_sift(values: work_vector(LRItem)*, root: usize, count: usize): void {
    var branches: usize = 2;
    var saved = values.data[root];
    while root < count / branches {
        var child = root * branches + 1;
        if child + 1 < count && lr_item_less(&values.data[child], &values.data[child + 1]) { ++child; }
        if !lr_item_less(&saved, &values.data[child]) { break; }
        values.data[root] = values.data[child];
        root = child;
    }
    values.data[root] = saved;
}

fn lr_items_heap_sort(values: work_vector(LRItem)*): void {
    var branches: usize = 2;
    var root = values.length / branches;
    while root != 0 { --root; lr_items_sift(values, root, values.length); }
    var count = values.length;
    while count > 1 {
        --count;
        var last = values.data[count];
        values.data[count] = values.data[0];
        values.data[0] = last;
        lr_items_sift(values, 0, count);
    }
}

var LRItemsInsertionLimit: usize = 16;
fn lr_items_swap(left: LRItem*, right: LRItem*): void {
    var saved = *left; *left = *right; *right = saved;
}

// Private contiguous closure items, with the same lexicographic comparator.
// Partition sequentially instead of repeatedly walking a large heap. Recurse
// only into the smaller side; a size-derived depth limit retains heapsort's
// worst-case bound. No allocation, new cache, ownership or public order change.
fn lr_items_sort_range(values: LRItem*, count: usize, depth: usize): void {
    while count > LRItemsInsertionLimit {
        if depth == 0 {
            // Borrowed descriptor only; this helper never disposes the owner.
            var heap = init(work_vector(LRItem)) {data: values, length: count, capacity: count, ..default};
            lr_items_heap_sort(&heap);
            return;
        }
        depth--;
        var middle = count / 2;
        if lr_item_less(&values[middle], &values[0]) { lr_items_swap(&values[middle], &values[0]); }
        if lr_item_less(&values[count - 1], &values[0]) { lr_items_swap(&values[count - 1], &values[0]); }
        if lr_item_less(&values[count - 1], &values[middle]) { lr_items_swap(&values[count - 1], &values[middle]); }
        var pivot = values[middle];
        var left: usize = 0;
        var right = count;
        while left < right {
            while left < right && lr_item_less(&values[left], &pivot) { left++; }
            while left < right && lr_item_less(&pivot, &values[right - 1]) { right--; }
            if left < right { lr_items_swap(&values[left], &values[right - 1]); left++; right--; }
        }
        if left < count - left {
            lr_items_sort_range(values, left, depth);
            values += left; count -= left;
        } else {
            lr_items_sort_range(values + left, count - left, depth);
            count = left;
        }
    }
    for(var i: usize = 1; i < count; i++) {
        var saved = values[i];
        var at = i;
        while at != 0 && lr_item_less(&saved, &values[at - 1]) { values[at] = values[at - 1]; at--; }
        values[at] = saved;
    }
}

fn lr_items_sort(values: work_vector(LRItem)*): void {
    var depth: usize = 0;
    for(var count = values.length; count > 1; count /= 2) { depth += 2; }
    lr_items_sort_range(values.data, values.length, depth);
}

export fn lr_items_close(value: LRAnalysis*, items: LRItems*, lookahead: bool): bool {
    if value == null || items == null { return false; }
    if items.budget != value.budget { return lr_items_fail(items, WorkBudgetError.Invalid); }
    if value.failed { return lr_items_fail(items, WorkBudgetError.Invalid); }
    // Many items reach the same nonterminal with identical lookahead. Expand
    // each pair once, rather than inserting every production for every incoming
    // item. Exact range identities and the sorted closure remain unchanged.
    var scratch = value.closure_scratch;
    if scratch != null {
        scratch.expanded.values.length = 0;
        scratch.expanded.pending.length = 0;
        scratch.expanded.failed = false;
        scratch.expanded.resource_error = WorkBudgetError.None;
        scratch.membership.slots.length = 0;
        scratch.expansion.slots.length = 0;
    }
    // A phase reuses private capacity, never checked items or effects. Failed
    // work retires it immediately; successful phase owners dispose after join.
    defer { if items.failed { lr_analysis_scratch_dispose(value); } }
    defer lr_items_sort(&items.values);
    var ok: bool = true;
    loop {
        var done = items.pending.length == 0;
        if items.failed {
            done = true;
        }
        if value.failed {
            done = true;
        }
        if done {
            break;
        }
        items.pending.length--;
        var item: LRItem;
        copy(&item, &items.pending.data[items.pending.length], sizeof(LRItem));
        if item.rule >= value.rule_count { lr_items_fail(items, WorkBudgetError.Invalid); break; }
        var rule = &value.rules[item.rule];
        done = item.position >= rule.count;
        if done {
            continue;
        }
        var index = rule.begin + item.position;
        var symbol = &value.symbols[index];
        if symbol.nonterminal == lr_none() {
            continue;
        }
        if symbol.nonterminal >= value.nonterminal_count { lr_items_fail(items, WorkBudgetError.Invalid); break; }
        if scratch == null {
            var storage: WorkBuffer = default;
            var error = work_buffer_resize(&storage, value.budget, sizeof(LRClosureScratch), 0);
            if error != WorkBudgetError.None { lr_items_fail(items, error); break; }
            scratch = bits(LRClosureScratch*, storage.data);
            *scratch = default;
            scratch.storage = storage;
            value.closure_scratch = scratch;
            scratch.expanded.budget = value.budget;
            lr_items_initial(&scratch.expanded);
            scratch.membership.initial = &scratch.initial_membership[0];
            scratch.membership.slots.data = scratch.membership.initial;
            scratch.membership.slots.capacity = sizeof(decltype(scratch.initial_membership)) / sizeof(usize);
            scratch.expansion.initial = &scratch.initial_expansion[0];
            scratch.expansion.slots.data = scratch.expansion.initial;
            scratch.expansion.slots.capacity = sizeof(decltype(scratch.initial_expansion)) / sizeof(usize);
            scratch.ranges.data = &scratch.initial_ranges[0];
            scratch.ranges.capacity = sizeof(decltype(scratch.initial_ranges)) / sizeof(SymbolRange);
        }
        var ranges = &scratch.ranges;
        var expanded = &scratch.expanded;
        ranges.length = 0;
        var error = WorkBudgetError.None;
        if lookahead {
            var position = item.position + 1;
            error = lr_suffix_result(value, rule, position, &item, ranges, &scratch.initial_ranges[0]);
        } else {
            var changed: bool = false;
            error = lr_range_insert_storage_result(ranges, 0, 0, &changed, value.budget, &scratch.initial_ranges[0]);
        }
        if error != WorkBudgetError.None {
            lr_items_fail(items, error);
            break;
        }
        var productions = &value.nonterminals[symbol.nonterminal].productions;
        var range: usize = 0;
        loop {
            done = range == ranges.length;
            if items.failed {
                done = true;
            }
            if done {
                break;
            }
            var key: LRItem = { rule: symbol.nonterminal, position: 0, first: ranges.data[range].first, last: ranges.data[range].last };
            range++;
            var previous = expanded.values.length;
            ok = lr_item_index_insert(&scratch.expansion, expanded, &key, false);
            if !ok {
                lr_items_fail(items, expanded.resource_error);
                break;
            }
            if previous == expanded.values.length {
                continue;
            }
            var production: usize = 0;
            loop {
                done = production == productions.length;
                if done {
                    break;
                }
                var next: LRItem = { rule: productions.data[production], position: 0, first: key.first, last: key.last };
                ok = lr_item_index_insert(&scratch.membership, items, &next, true);
                if !ok {
                    break;
                }
                production++;
            }
        }
    }
    if items.failed {
        value.failed = true;
    }
    ok = !value.failed;
    return ok;
}

export fn lr_items_shift(value: LRAnalysis*, input: LRItems*, symbol: LRSymbol*, output: LRItems*): bool {
    if value == null || input == null || symbol == null || output == null { return false; }
    var index: usize = 0;
    for(; index != input.values.length; index++) {
        var item: LRItem;
        copy(&item, &input.values.data[index], sizeof(LRItem));
        if item.rule >= value.rule_count {
            value.failed = true;
            return lr_items_fail(output, WorkBudgetError.Invalid);
        }
        var rule = &value.rules[item.rule];
        if item.position < rule.count {
            var at = rule.begin + item.position;
            var next = &value.symbols[at];
            var matches = next.nonterminal == symbol.nonterminal;
            if next.nonterminal == lr_none() {
                var contained = symbol.first >= next.first;
                if !contained {
                    matches = false;
                }
                contained = symbol.last <= next.last;
                if !contained {
                    matches = false;
                }
            }
            if matches {
                item.position++;
                if !lr_items_insert(output, &item) {
                    value.failed = true;
                    return false;
                }
            }
        }
    }
    return true;
}

export fn lr_items_goto(value: LRAnalysis*, input: LRItems*, symbol: LRSymbol*, output: LRItems*, lookahead: bool): bool {
    if !lr_items_shift(value, input, symbol, output) {
        return false;
    }
    return lr_items_close(value, output, lookahead);
}

fn lr_items_error(items: LRItems*): WorkBudgetError {
    return items.resource_error != WorkBudgetError.None ? items.resource_error : WorkBudgetError.Invalid;
}

// LALR lookahead dependencies refer to kernel items by temporary dense indices.
// Propagate only changed sets; cyclic grammars converge without recursive calls.
struct LRPropagationNode {
    ranges: work_vector(SymbolRange);
    edges: work_vector(usize);
    queued: bool;
    range_owned: bool;
    initial_ranges: SymbolRange[WorkBufferInitialElements];
    initial_edges: usize[WorkBufferInitialElements];
}

struct LRPropagation {
    storage: WorkBuffer;
    node_storage: WorkBuffer;
    budget: WorkBudget*;
    scratch: WorkArena;
    nodes: LRPropagationNode*;
    count: usize;
    pending: work_vector(usize);
}

export fn lr_propagation_destroy(value: LRPropagation*): void {
    if value == null {
        return;
    }
    var index: usize = 0;
    for(; index != value.count; index++) {
        var node = &value.nodes[index];
        if node.range_owned { work_vector_dispose(&node.ranges); }
    }
    work_buffer_dispose(&value.node_storage);
    work_arena_dispose(&value.scratch);
    work_vector_dispose(&value.pending);
    var storage = value.storage;
    work_buffer_dispose(&storage);
}

export fn lr_propagation_create(count: usize): LRPropagation* {
    var error = WorkBudgetError.None;
    return lr_propagation_create_result(count, &error);
}

export fn lr_propagation_create_result(count: usize, error: WorkBudgetError*): LRPropagation* {
    return lr_propagation_create_budget_result(count, null, error);
}

export fn lr_propagation_create_budget_result(count: usize, budget: WorkBudget*, error: WorkBudgetError*): LRPropagation* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if count > ~convert(usize, 0) / sizeof(LRPropagationNode) { return null; }
    var storage: WorkBuffer = default;
    *error = work_buffer_resize(&storage, budget, sizeof(LRPropagation), 0);
    if *error != WorkBudgetError.None { return null; }
    var value = bits(LRPropagation*, storage.data);
    *value = default;
    value.storage = storage;
    value.budget = budget;
    var initial = count < WorkBufferInitialElements ? WorkBufferInitialElements : count;
    var chunk_bytes = sizeof(WorkArenaChunk) + initial * sizeof(SymbolRange);
    if !work_arena_init(&value.scratch, budget, chunk_bytes) { *error = WorkBudgetError.Invalid; lr_propagation_destroy(value); return null; }
    *error = work_buffer_resize(&value.node_storage, budget, sizeof(LRPropagationNode) * count, 0);
    if *error != WorkBudgetError.None {
        lr_propagation_destroy(value);
        return null;
    }
    value.nodes = bits(LRPropagationNode*, value.node_storage.data);
    value.count = count;
    var bytes = sizeof(LRPropagationNode) *count;
    fill(value.nodes, 0, bytes);
    for(var i: usize = 0; i < count; i++) {
        var node = &value.nodes[i];
        node.ranges.data = &node.initial_ranges[0];
        node.ranges.capacity = sizeof(decltype(node.initial_ranges)) / sizeof(SymbolRange);
        node.edges.data = &node.initial_edges[0];
        node.edges.capacity = sizeof(decltype(node.initial_edges)) / sizeof(usize);
    }
    *error = lr_reserve_result(&value.pending, count, budget);
    if *error != WorkBudgetError.None {
        lr_propagation_destroy(value);
        return null;
    }
    return value;
}

fn lr_propagation_queue(value: LRPropagation*, index: usize): void {
    var node = &value.nodes[index];
    if node.queued {
        return;
    }
    // At most count distinct nodes can be queued. Capacity was reserved once.
    value.pending.data[value.pending.length] = index;
    value.pending.length++;
    node.queued = true;
}

export fn lr_propagation_seed(value: LRPropagation*, index: usize, first: u32, last: u32): bool {
    return lr_propagation_seed_result(value, index, first, last) == WorkBudgetError.None;
}

export fn lr_propagation_seed_result(value: LRPropagation*, index: usize, first: u32, last: u32): WorkBudgetError {
    if value == null || index >= value.count { return WorkBudgetError.Invalid; }
    var changed: bool = false;
    var node = &value.nodes[index];
    var error = lr_range_insert_arena_result(&node.ranges, first, last, &changed, value.budget, &node.initial_ranges[0], &value.scratch, &node.range_owned);
    if changed {
        lr_propagation_queue(value, index);
    }
    return error;
}

export fn lr_propagation_edge(value: LRPropagation*, source: usize, destination: usize): bool {
    return lr_propagation_edge_result(value, source, destination) == WorkBudgetError.None;
}

export fn lr_propagation_edge_result(value: LRPropagation*, source: usize, destination: usize): WorkBudgetError {
    if value == null || source >= value.count || destination >= value.count { return WorkBudgetError.Invalid; }
    // Duplicate dependencies do not change the fixed point or queued work.
    var node = &value.nodes[source];
    var count = node.edges.length + 1;
    if count == 0 { return WorkBudgetError.Invalid; }
    var error = lr_reserve_arena_result(&node.edges, count, &value.scratch, null);
    if error == WorkBudgetError.None {
        node.edges.data[node.edges.length] = destination;
        node.edges.length = count;
        lr_propagation_queue(value, source);
    }
    return error;
}

export fn lr_propagation_solve(value: LRPropagation*): bool {
    return lr_propagation_solve_result(value) == WorkBudgetError.None;
}

export fn lr_propagation_solve_result(value: LRPropagation*): WorkBudgetError {
    if value == null { return WorkBudgetError.Invalid; }
    loop {
        var done = value.pending.length == 0;
        if done {
            return WorkBudgetError.None;
        }
        value.pending.length--;
        var index = value.pending.data[value.pending.length];
        var source = &value.nodes[index];
        source.queued = false;
        var edge: usize = 0;
        loop {
            done = edge == source.edges.length;
            if done {
                break;
            }
            var destination = source.edges.data[edge];
            var target = &value.nodes[destination];
            var changed: bool = false;
            var error = lr_range_merge_arena_result(&target.ranges, &source.ranges, &changed, value.budget, &target.initial_ranges[0], &value.scratch, &target.range_owned);
            if error != WorkBudgetError.None { return error; }
            if changed {
                lr_propagation_queue(value, destination);
            }
            edge++;
        }
    }
}

export fn lr_propagation_count(value: LRPropagation*, index: usize): usize {
    return value.nodes[index].ranges.length;
}

// Edges transfer complete exact-range unions. Equal-component nodes therefore
// converge to one set; every cross-component input precedes its destination.
// Rebuild for each dirty solve: late edges may merge components. No index or
// shared range payload survives this synchronous, exclusively owned call.
export fn lr_propagation_solve_components_result(value: LRPropagation*, budget: WorkBudget*): WorkBudgetError {
    if value == null { return WorkBudgetError.Invalid; }
    if value.pending.length == 0 { return WorkBudgetError.None; }
    if value.count > ~convert(usize, 0) / sizeof(GraphAdjacency) { return WorkBudgetError.Invalid; }
    var adjacency: WorkBuffer = default;
    defer work_buffer_dispose(&adjacency);
    var error = work_buffer_resize(&adjacency, budget, value.count * sizeof(GraphAdjacency), 0);
    if error != WorkBudgetError.None { return error; }
    var spans = bits(GraphAdjacency*, adjacency.data);
    for(var i: usize = 0; i < value.count; i++) {
        spans[i] = { data: value.nodes[i].edges.data, count: value.nodes[i].edges.length };
    }
    var index: GraphComponents = default;
    defer graph_components_dispose(&index);
    error = graph_components_result(spans, value.count, budget, &index);
    if error != WorkBudgetError.None { return error; }
    for(var component = index.count; component != 0;) {
        component--;
        var head = index.heads[component];
        var ranges = &value.nodes[head].ranges;
        for(var member = index.nodes[head].next; member != lr_none(); member = index.nodes[member].next) {
            var changed = false;
            error = lr_range_merge_arena_result(ranges, &value.nodes[member].ranges, &changed, value.budget, &value.nodes[head].initial_ranges[0], &value.scratch, &value.nodes[head].range_owned);
            if error != WorkBudgetError.None { return error; }
        }
        for(var member = head; member != lr_none(); member = index.nodes[member].next) {
            foreach(var destination in &value.nodes[member].edges) {
                var target = index.nodes[destination].component;
                if target == component { continue; }
                var changed = false;
                var row = &value.nodes[index.heads[target]];
                error = lr_range_merge_arena_result(&row.ranges, ranges, &changed, value.budget, &row.initial_ranges[0], &value.scratch, &row.range_owned);
                if error != WorkBudgetError.None { return error; }
            }
        }
        // Materialize independent original-node owners. On denial, all changes
        // are monotone unions and the original pending queue remains available
        // for a direct retry; no partially published index needs to be repaired.
        for(var member = index.nodes[head].next; member != lr_none(); member = index.nodes[member].next) {
            var changed = false;
            error = lr_range_merge_arena_result(&value.nodes[member].ranges, ranges, &changed, value.budget, &value.nodes[member].initial_ranges[0], &value.scratch, &value.nodes[member].range_owned);
            if error != WorkBudgetError.None { return error; }
        }
    }
    for(var i: usize = 0; i < value.count; i++) { value.nodes[i].queued = false; }
    value.pending.length = 0;
    return WorkBudgetError.None;
}

export fn lr_propagation_data(value: LRPropagation*, index: usize): SymbolRange* {
    return value.nodes[index].ranges.data;
}
