import tower;
import .library.work_buffer;
import .library.work_buffer_types;
import parser_table;
import lr_api;
import parser_markers;
import parser_table_types;
import format_parser_table_types;
import .library.work_budget_types;

extern fn parser_presentation_buffer_result(table: ParserHostTable*, kind: ParserFormatKind, first: usize, second: usize, budget: WorkBudget*, output: WorkBuffer*): WorkBudgetError;
extern fn parser_presentation_text(table: ParserHostTable*, kind: ParserFormatKind, first: usize, second: usize): u8*;

extern fn parser_trace_table(table: ParserHostTable*, kind: ParserFormatKind): void;

extern fn syntax_parser_resolve(context: void*, name: u8*): u32;

// Coordinator configuration only. A completed table snapshots this value;
// request workers never read/write a global tracing setting.
extern fn parser_match_get_type(): void*;

extern fn entity_member_index(owner: void*, name: u8*): usize;

extern fn entity_child_at(owner: void*, index: usize): void*;

extern fn entity_create_related(owner: void*): void*;

extern fn entity_attach(node: void*, parent: void*, name: u8*): bool;

extern fn entity_release(node: void*): usize;

// Legacy host setting lives on its world's registry, just like IDE transport
// metadata. Only the coordinator changes it; explicit worlds set table.trace.
export fn parser_set_debug_trace(enabled: bool): bool {
    var owner = parser_match_get_type();
    var slot = entity_member_index(owner, "parser.trace");
    var present = slot != ParserNoIndex();
    if enabled {
        if present {
            return true;
        }
        var marker = entity_create_related(owner);
        if marker == null { return false; }
        var attached = entity_attach(marker, owner, "parser.trace");
        entity_release(marker);
        return attached;
    } else {
        if present {
            return entity_attach(entity_child_at(owner, slot), null, null);
        }
    }
    return true;
}

fn parser_copy_text(source: u8*): u8* {
    var size: usize = 1;
    var index: usize = 0;
    while source[index] != 0 {
        index = index + 1;
    }
    size = size + index;
    var result = bits(u8*, compiler_buffer_allocate(size));
    if result != null {
        copy(result, source, size);
    }
    return result;
}

// Complete construction on the coordinator before sharing. Missing-name
// resolution, conflict formatting and all failure cleanup are Tower-owned.
export fn parser_table_finish(table: ParserHostTable*, error: u8**, specialize: bool): ParserHostTable* {
    var resource_error = WorkBudgetError.None;
    return parser_table_finish_result(table, error, specialize, &resource_error);
}

export fn parser_table_finish_result(table: ParserHostTable*, error: u8**, specialize: bool, resource_error: WorkBudgetError*): ParserHostTable* {
    var message: WorkBuffer = default;
    defer work_buffer_dispose(&message);
    var result = parser_table_finish_buffer_result(table, &message, specialize, resource_error);
    if error != null {
        *error = message.data == null ? null : parser_copy_text(message.data);
        if message.data != null && *error == null && *resource_error == WorkBudgetError.None { *resource_error = WorkBudgetError.Memory; }
    }
    return result;
}

fn parser_copy_buffer(source: u8*, budget: WorkBudget*, output: WorkBuffer*): WorkBudgetError {
    if source == null { return WorkBudgetError.Invalid; }
    var length: usize = 0;
    while source[length] != 0 { length++; }
    var bytes = length + 1;
    if bytes == 0 { return WorkBudgetError.Invalid; }
    var error = work_buffer_resize(output, budget, bytes, 0);
    if error == WorkBudgetError.None { copy(output.data, source, bytes); }
    return error;
}

export fn parser_table_finish_buffer_result(table: ParserHostTable*, error: WorkBuffer*, specialize: bool, resource_error: WorkBudgetError*): ParserHostTable* {
    *resource_error = table == null ? WorkBudgetError.Invalid : table.resource_error;
    var output = error != null;
    if table == null {
        return null;
    }
    var message: WorkBuffer = default;
    defer work_buffer_dispose(&message);
    var presentation_error = WorkBudgetError.None;
    var failed = table.error != null;
    if failed {
        presentation_error = parser_copy_buffer(table.error, table.budget, &message);
    }
    if !failed {
        var count = lr_grammar_missing_count(table.grammar);
        var index: usize = 0;
        while index < count {
            var name = lr_grammar_missing_name(table.grammar, index);
            var id = ParserStreamEnd;
            match table.presentation {
                ParserPresentation.NonTerminal => {
                    id = parser_table_non_terminal_resolve_reference(table.userdata, name);
                }
                ParserPresentation.Syntax => {
                    id = syntax_parser_resolve(table.userdata, name);
                }
                _ => {}
            }
            if !lr_grammar_resolve(table.grammar, index, id) {
                presentation_error = parser_presentation_buffer_result(table, ParserFormatKind.Missing, index, 0, table.budget, &message);
                failed = true;
                break;
            }
            index = index + 1;
        }
    }
    if !failed {
        if table.trace {
            parser_trace_table(table, ParserFormatKind.Grammar);
        }
        if parser_table_build(table, specialize) {
            presentation_error = parser_presentation_buffer_result(table, ParserFormatKind.Conflict, 0, 0, table.budget, &message);
            failed = presentation_error != WorkBudgetError.None;
            failed ||= message.data[0] != 0;
        } else {
            presentation_error = parser_copy_buffer(table.error, table.budget, &message);
            failed = true;
        }
    }
    if failed {
        *resource_error = table.resource_error;
        if *resource_error == WorkBudgetError.None { *resource_error = presentation_error; }
        if output {
            work_buffer_move(error, &message);
        } else {
            work_buffer_dispose(&message);
        }
        parser_table_destroy(table);
        return null;
    }
    work_buffer_dispose(&message);
    if table.trace {
        parser_trace_table(table, ParserFormatKind.Tables);
    }
    return table;
}

export fn parser_table_create(root: void*, userdata: void*, presentation: ParserPresentation, error: u8**, mode: u32, specialize: bool): ParserHostTable* {
    var table = parser_table_open_host(root, userdata, presentation, mode);
    var present = table != null;
    present &&= table.match_kind != null;
    if present {
        table.trace = entity_member_index(table.match_kind, "parser.trace") != ParserNoIndex();
    }
    return parser_table_finish(table, error, specialize);
}
