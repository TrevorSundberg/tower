import tower;
import .library.work_buffer_types;
import .library.work_budget_types;
import .library.work_vector_types;
import frontend_diagnostic_types;

enum ParserReadMode: u32 {
    WholeInput, Constructs
}

struct ParserHostState {
    origin: usize;
    kernels: usize;
    contexts: work_vector(FrontendContextPosition);
}

// Frozen derived LR data. Per-version grammar labels/captures, userdata,
// emission, replacements and source provenance stay on the borrowing table.
// Coordinator pins protect the numeric runtime and diagnostic context columns.
struct ParserStructure {
    storage: WorkBuffer;
    references: usize;
    grammar: void*;
    runtime: void*;
    states: work_vector(ParserHostState);
    mode: u32;
    specialize: bool;
}

struct ParserStructureCache {
    world: void*;
    budget: WorkBudget*;
    limit: usize;
    entries: work_vector(ParserStructure*);
}

// Presentation services are explicit until Tower supports function values. The
// Syntax service calls the existing syntax owner's exported views; it does not
// own or mutate a SyntaxSession or grammar revision.
enum ParserPresentation: u32 {
    Numeric, Utf8, NonTerminal, Syntax
}

// The coordinator owns the table and pins it and its world for all requests.
// Build completes before publication. Requests borrow it without refcount/cache
// writes; it must not be rebuilt or destroyed until those requests have ended.
struct ParserHostTable {
    storage: WorkBuffer;
    budget: WorkBudget*;
    grammar: void*;
    runtime: void*;
    states: work_vector(ParserHostState);
    userdata: void*;
    presentation: ParserPresentation;
    mode: u32;
    error: u8*;
    resource_error: WorkBudgetError;
    built: bool;
    match_kind: void*;
    trace: bool;
    structure: ParserStructure*;
    reuse: ParserStructureCache*; // construction-only borrow, cleared on completion
}
