import tower;
import semantic_control;
import semantic_defer;
import semantic_iteration;
import foundation_tags;
import foundation_types;
import semantic_context;
import semantic_definitions;
import semantic_enums;
import semantic_layout;
import semantic_modules;
import semantic_support;
import semantic_types;
import semantic_values;
import semantic_expressions;
import semantic_declarations;
import semantic_body_work;
import semantic_flow;
import .library.vector;

// Semantic compiler over shared Foundation components.
// Temporary indexes and scratch allocations are scoped to one compilation.

fn sem_function_declare(c: SemanticContext*, n: void*, name: u8*): void {
    var external = sem_is(n, "CoreExternal");
    var function_node: FoundationNode* = sem_node(c, n, KFunction());
    if name[0] == 0 {
        var step15 = sem_member(n, "name");
        name = sem_identifier(c, step15);
    }
    var published = external;
    if sem_is(n, "CoreExport") {
        published = true;
    }
    if published {
        sem_set_name(function_node, name);
    } else {
        sem_set_name(function_node, sem_output_name(c, n, name));
    }
    var step26 = name[0] == 0;
    if !step26 {
        var step28 = sem_owned(c.functions, sem_owner(c, n), name);
        var step29 = step28 != null;
        step26 = step29;
    }
    if !step26 {
        var step31 = sem_owned(c.templates, sem_owner(c, n), name);
        var step32 = step31 != null;
        step26 = step32;
    }
    if !step26 {
        var step34 = sem_owned(c.type_functions, sem_owner(c, n), name);
        var step35 = step34 != null;
        step26 = step35;
    }
    if step26 {
        var step36 = sem_cat(c, "Missing or duplicate function '", name);
        var step37 = sem_cat(c, step36, "'");
        sem_fail(c, n, step37);
        return;
    }
    function_node.index = c.program.functions.length;
    sem_define(c, c.functions, n, name);
    sem_push(&c.program.functions, n);
    function_node.external = external;
    function_node.exported = sem_is(n, "CoreExport");
}

// Bind the entire signature before requesting its types. Parameter entities
// participate in the same declaration graph as globals, fields and returns.
fn sem_parameters(c: SemanticContext*, n: void*, definition: void*): SemanticScope* {
    var state = sem_declaration_state(c, n);
    if state.scope != null { return state.scope; }
    state.scope = sem_scope(c, null);
    var function_node = sem_get(n);
    var params = sem_collect(c, sem_member(n, "params"), "CoreParameter");
    for(var i: usize = 0; i < params.length && sem_ok(c); ++i) {
        if definition != null && generic_type_parameter(c.generics, definition, i) { continue; }
        var p = params.data[i];
        if !sem_shape(c, p, "name") || !sem_shape(c, p, "type") { break; }
        var param = sem_node(c, p, KParameter());
        var name = sem_identifier(c, sem_member(p, "name"));
        sem_set_name(param, name);
        if name[0] == 0 || !sem_put(c, state.scope.names, name, p) {
            sem_fail(c, p, "Invalid or duplicate function parameter");
            break;
        }
        sem_declaration_state(c, p).scope = state.scope;
        sem_push(&function_node.parameters, p);
    }
    if function_node.parameters.length > 64 { sem_fail(c, n, "Foundation parameter limit is 64"); }
    return state.scope;
}

fn sem_header(c: SemanticContext*, n: void*, name: u8*, definition: void*): void {
    var external = sem_is(n, "CoreExternal");
    if !sem_shape(c, n, "name") || !sem_shape(c, n, "type") { return; }
    if !external && !sem_shape(c, n, "body") { return; }
    if sem_get(n) == null { sem_function_declare(c, n, name); }
    if !sem_ok(c) { return; }
    var function_node = sem_get(n);
    var saved_scope = c.scope;
    var saved_current = c.current;
    c.scope = sem_parameters(c, n, definition);
    c.current = n;
    for(var i: usize = 0; i < function_node.parameters.length && sem_ok(c); ++i) {
        var p = function_node.parameters.data[i];
        if !sem_declaration_type(c, p) { break; }
        if semantic_aggregate(&sem_get(p).type) {
            sem_fail(c, p, "Struct parameters require a pointer; by-value arguments are not implemented");
            break;
        }
        sem_add_local(c, p);
    }
    if sem_ok(c) {
        sem_set_type(&function_node.type, sem_type(c, sem_member(n, "type")));
        name = sem_name(function_node);
        if semantic_builtin_kind(name) != 0 {
            sem_fail(c, n, sem_cat(c, "Function name '", sem_cat(c, name, "' already names a foundation builtin")));
        }
        if semantic_aggregate(&function_node.type) {
            sem_fail(c, n, "Struct returns require a pointer; by-value returns are not implemented");
        }
    }
    function_node.external = external;
    function_node.exported = sem_is(n, "CoreExport");
    c.scope = saved_scope;
    c.current = saved_current;
}

fn sem_scope(c: SemanticContext*, parent: SemanticScope*): SemanticScope* {
    var step2 = sem_allocate(c, sizeof(SemanticScope));
    var scope: SemanticScope* = bits(SemanticScope*, step2);
    scope.parent = parent;
    var step4 = sem_table(c);
    scope.names = step4;
    return scope;
}

fn sem_text_less(a: u8*, b: u8*): bool {
    var i: usize = 0;
    loop {
        if !(a[i] == b[i] && a[i] != 0) {
            break;
        }
        i++;
    }
    return a[i] < b[i];
}

fn sem_order_name(c: SemanticContext*, node: void*, value: FoundationNode*): u8* {
    if value != null {
        return sem_name(value);
    }
    return sem_identifier(c, sem_member(node, "name"));
}

fn sem_scope_locals(c: SemanticContext*, scope: SemanticScope*, locals: vector(void*)*): void {
    var i: usize = 0;
    for(; i < scope.names.capacity; i++) {
        var entry: SemanticEntry* = scope.names.entries[i];
        if entry != null && entry.value != null {
            sem_push(locals, entry.value);
        }
    }
    i = 1;
    for(; i < locals.length; i++) {
        var value: void* = locals.data[i];
        var j: usize = i;
        loop {
            var step9 = j != 0;
            if step9 {
                var step11 = sem_order_name(c, value, sem_get(value));
                var step12 = j -1;
                var step13 = sem_get(locals.data[step12]);
                step9 = sem_text_less(step11, sem_order_name(c, locals.data[step12], step13));
            }
            if !step9 {
                break;
            }
            var step17 = j -1;
            locals.data[j] = locals.data[step17];
            j--;
        }
        locals.data[j] = value;
    }
}

fn sem_control_call(c: SemanticContext*, statement: void*, name: u8*): void* {
    if sem_is(statement, "TowerExpressionStatement") {
        var call = sem_surface_unwrap(sem_member(statement, "value"));
        if sem_is(call, "CoreCall") {
            var spelling = sem_identifier(c, sem_member(call, "name"));
            if sem_equal(spelling, name) {
                return call;
            }
        }
    }
    if sem_is(statement, "CoreCallStatement") {
        var call = sem_member(statement, "call");
        var identifier = sem_member(call, "name");
        var spelling = sem_identifier(c, identifier);
        if sem_equal(spelling, name) {
            return call;
        }
    }
    return null;
}

fn sem_label_name(c: SemanticContext*, call: void*): u8* {
    var arguments = sem_collect(c, sem_member(call, "args"), "CoreCallArgument");
    var one = arguments.length == 1;
    if one {
        var argument = arguments.data[0];
        var names = sem_collect(c, argument, "CoreLocation");
        one = names.length == 1;
        if one {
            var whole = sem_tokens(c, argument);
            var identifier = sem_member(names.data[0], "name");
            var name = sem_tokens(c, identifier);
            if sem_equal(whole, name) {
                return sem_identifier(c, identifier);
            }
        }
    }
    sem_fail(c, call, "label/jump require one label identifier");
    return "";
}

fn sem_labels(c: SemanticContext*, body: void*): void {
    c.labels = sem_table(c);
    var index: usize = 0;
    var i: usize = 0;
    loop {
        if i == sem_child_count(body) {
            return;
        }
        var item = sem_child(body, i);
        if sem_is(item, "Statement") {
            item = sem_unwrap(item);
            var call = sem_control_call(c, item, "label");
            if call != null {
                var label = sem_node(c, call, KLabel());
                var name = sem_label_name(c, call);
                sem_set_name(label, name);
                label.body = body;
                label.index = index;
                if !sem_put(c, c.labels, name, call) {
                    sem_fail(c, item, "Duplicate function label");
                }
            }
            index++;
        }
        i++;
    }
}

fn sem_block(c: SemanticContext*, n: void*, depth: u32): u32 {
    if n == null || !sem_is(n, "CoreBlock") {
        sem_fail(c, n, "Expected a CoreBlock tree");
        return 1;
    }
    var value: FoundationNode* = sem_node(c, n, KBlock());
    var deferred = c.deferred;
    var step7 = sem_scope(c, c.scope);
    c.scope = step7;
    var flow: u32 = 1;
    var labeled = false;
    var i: usize = 0;
    loop {
        var step8 = sem_child_count(n);
        if !(i < step8 && sem_ok(c)) {
            break;
        }
        var at: void* = sem_child(n, i);
        if sem_is(at, "Statement") {
            at = sem_unwrap(at);
            var label_call = sem_control_call(c, at, "label");
            if label_call != null {
                var falls = flow &1;
                if labeled {
                    var open = falls != 0;
                    if open && c.flow_dependencies.length == 0 {
                        sem_fail(c, at, "A labeled block must end with jump or return before the next label");
                    }
                }
                labeled = true;
                flow = 1;
            }
            var next: u32 = sem_statement(c, at, depth + 1);
            if sem_is(at, "CoreCallStatement") {
                at = sem_member(at, "call");
            }
            var control = sem_control_call(c, at, "label");
            if control == null {
                control = sem_control_call(c, at, "jump");
            }
            if control != null {
                at = control;
            }
            sem_push(&value.items, at);
            if(flow &1) != 0 {
                flow = flow & 4294967294 | next;
            }
        } else {
            if !sem_is(at, "{") && !sem_is(at, "}") {
                sem_fail(c, at, "Malformed CoreBlock tree");
            }
        }
        i++;
    }
    sem_scope_locals(c, c.scope, &value.locals);
    if(flow &FlowNext()) != 0 && c.deferred != deferred && sem_ok(c) {
        flow =(flow & ~FlowNext()) | sem_defer_emit(c, n, deferred, 0);
    }
    c.deferred = deferred;
    c.scope = c.scope.parent;
    return flow;
}

fn sem_statement(c: SemanticContext*, n: void*, depth: u32): u32 {
    if c.deferring != 0 && sem_control_call(c, n, "jump") != null {
        sem_fail(c, n, "A deferred cleanup cannot jump out of its scope");
        return FlowNext();
    }
    var flow = sem_statement_impl(c, n, depth);
    if(c.deferred != null || c.deferring != 0) && sem_ok(c) {
        return sem_defer_exit(c, n, flow);
    }
    return flow;
}

fn sem_statement_impl(c: SemanticContext*, n: void*, depth: u32): u32 {
    var label_call = sem_control_call(c, n, "label");
    if label_call != null {
        var direct = depth == 1;
        var found = sem_get(label_call) != null;
        if direct {
            if found {
                return 1;
            }
        }
        sem_fail(c, n, "Labels must be direct statements in a function body");
        return 1;
    }
    var jump_call = sem_control_call(c, n, "jump");
    if jump_call != null {
        var value = sem_node(c, jump_call, KJump());
        var name = sem_label_name(c, jump_call);
        sem_set_name(value, name);
        var labels = c.labels != null;
        if labels {
            value.binding = sem_lookup_table(c.labels, name);
        }
        if value.binding == null {
            sem_fail(c, n, "Unknown function label");
        }
        return 0;
    }
    if depth > 128 {
        sem_fail(c, n, "Foundation block nesting limit is 128");
        return 1;
    }
    if !sem_ok(c) {
        return 1;
    }
    if sem_is(n, "TowerMatch") {
        return sem_control_match(c, n, depth);
    }
    if sem_is(n, "TowerWhile") {
        return sem_control_while(c, n, depth);
    }
    if sem_is(n, "TowerDefer") {
        return sem_defer_register(c, n, depth);
    }
    if sem_is(n, "TowerForeach") {
        return sem_iteration(c, n, depth);
    }
    if sem_is(n, "TowerFor") {
        return sem_control_for(c, n, depth);
    }
    if sem_is(n, "TowerExpressionStatement") {
        c.surface_expressions = true;
        var expression = sem_surface_unwrap(sem_member(n, "value"));
        var value = sem_node(c, n, SurfaceDiscard());
        value.value = sem_surface_discard(c, expression);
        if sem_ok(c) {
            var operation = sem_get(value.value);
            if operation.kind == KTrap() {
                return 0;
            }
        }
        return FlowNext();
    }
    if sem_is(n, "CoreEnum") {
        sem_fail(c, n, "Enum types must be declared at top level");
        return FlowNext();
    }
    var kind: u8* = sem_label(n);
    if sem_equal(kind, "CoreDeclare") {
        if !sem_shape(c, n, "name") {
            return 1;
        }
        var value: FoundationNode* = sem_node(c, n, KDeclare());
        var name: u8* = sem_identifier(c, sem_member(n, "name"));
        if !value.global {
            sem_set_name(value, name);
        }
        if name[0] == 0 || !value.global && sem_lookup_table(c.scope.names, name) != null {
            var step18 = sem_cat(c, "Missing or duplicate local '", name);
            sem_fail(c, n, sem_cat(c, step18, "'"));
            return 1;
        }
        if !value.global {
            sem_put(c, c.scope.names, name, n);
        }
        if !sem_declaration_type(c, n) {
            return 1;
        }
        if !value.global {
            sem_add_local(c, n);
        }
        var initial: void* = sem_member(n, "value");
        if initial != null && value.value == null {
            var step28 = sem_expression(c, initial, &value.type);
            value.value = step28;
        }
    } else {
        if sem_equal(kind, "CoreAssign") {
            if !sem_shape(c, n, "target") || !sem_shape(c, n, "value") || !sem_shape(c, sem_member(n, "target"), "name") {
                return 1;
            }
            var value: FoundationNode* = sem_node(c, n, KAssign());
            var target: void* = sem_member(n, "target");
            var step43 = sem_location(c, sem_member(target, "name"), 0);
            value.target = step43;
            if !sem_ok(c) {
                return 1;
            }
            var step46 = sem_get(value.target);
            var expected_type: FoundationType* = sem_type_copy(c, &step46.type);
            if sem_equal(sem_tokens(c, sem_child(target, 0)), "*") {
                var dest: FoundationNode* = sem_node(c, target, KLoad());
                dest.value = value.target;
                if expected_type.pointers == 0 {
                    sem_fail(c, target, "Store requires a pointer");
                } else {
                    expected_type.pointers--;
                }
                sem_set_type(&dest.type, expected_type);
                value.target = target;
            }
            if semantic_aggregate(expected_type) {
                sem_fail(c, target, "Struct values require field access or a pointer; aggregate copies are not implemented");
            }
            var step55 = sem_expression(c, sem_member(n, "value"), expected_type);
            value.value = step55;
        } else {
            if sem_equal(kind, "CoreCallStatement") {
                var step57 = sem_member(n, "call");
                sem_call(c, step57);
                var call_node = sem_get(step57);
                if call_node != null {
                    if call_node.kind == 33 {
                        return 0;
                    }
                }
            } else {
                if sem_equal(kind, "CoreReturn") {
                    var value: FoundationNode* = sem_node(c, n, KReturn());
                    var returned: void* = sem_member(n, "value");
                    var present: bool = sem_length(sem_tokens(c, returned)) != 0;
                    var function: FoundationNode* = sem_get(c.current);
                    if function.type.pointers == 0 && function.type.scalar == SVoid() {
                        if present {
                            sem_fail(c, n, "A void function cannot return a value");
                        }
                    } else {
                        if !present {
                            sem_fail(c, n, "A non-void function must return a value");
                        } else {
                            var operands = sem_collect(c, returned, "CoreOperand");
                            if operands.length == 1 {
                                value.value = sem_operand(c, operands.data[0], &function.type);
                            }
                            else {
                                sem_fail(c, n, "A return value must contain one Foundation operand");
                            }
                        }
                    }
                    return 8;
                } else {
                    if sem_function_syntax(n) {
                        sem_fail(c, n, "Functions must be declared at top level");
                    } else {
                        if sem_equal(kind, "CoreStruct") {
                            sem_fail(c, n, "Struct types must be declared at top level");
                        } else {
                            if sem_equal(kind, "CoreBlock") {
                                return sem_block(c, n, depth);
                            } else {
                                if sem_equal(kind, "CoreIf") {
                                    if !sem_shape(c, n, "condition") || !sem_shape(c, n, "body") {
                                        return 1;
                                    }
                                    var value: FoundationNode* = sem_node(c, n, KIf());
                                    var step86 = sem_operand(c, sem_member(n, "condition"), sem_type_new(c, SBool(), 0, null));
                                    value.value = step86;
                                    var step87 = sem_member(n, "body");
                                    value.body = step87;
                                    var yes: u32 = sem_block(c, value.body, depth);
                                    var no: u32 = 1;
                                    var step89 = sem_member(n, "otherwise");
                                    value.otherwise = step89;
                                    if value.otherwise != null {
                                        no = sem_block(c, value.otherwise, depth);
                                    }
                                    var condition: FoundationNode* = sem_get(value.value);
                                    var step94 = condition != null;
                                    step94 &&= sem_flow_known(c, value.value);
                                    if step94 {
                                        if condition.bits != 0 {
                                            return yes;
                                        }
                                        return no;
                                    }
                                    return yes | no;
                                } else {
                                    if sem_equal(kind, "CoreLoop") {
                                        var value: FoundationNode* = sem_node(c, n, KLoop());
                                        var step99 = sem_member(n, "body");
                                        value.body = step99;
                                        c.loops++;
                                        var flow: u32 = sem_block(c, value.body, depth);
                                        c.loops--;
                                        var result: u32 = flow &8;
                                        if(flow &2) != 0 {
                                            result = result | 1;
                                        }
                                        return result;
                                    } else {
                                        if sem_equal(kind, "CoreBreak") || sem_equal(kind, "CoreContinue") {
                                            var op: u32 = 16;
                                            var result: u32 = 4;
                                            if sem_equal(kind, "CoreBreak") {
                                                op = 15;
                                                result = 2;
                                            }
                                            sem_node(c, n, op);
                                            if c.loops == 0 {
                                                sem_fail(c, n, sem_cat(c, kind, " requires an enclosing loop"));
                                            }
                                            return result;
                                        } else {
                                            var step112 = sem_cat(c, "No execution semantics for '", kind);
                                            sem_fail(c, n, sem_cat(c, step112, "'; replace it with a foundation operation"));
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return 1;
}

fn sem_function_syntax(n: void*): bool {
    return sem_is(n, "CoreFunction") || sem_is(n, "CoreExternal") || sem_is(n, "CoreExport");
}

fn sem_function_body(c: SemanticContext*, n: void*): void {
    var function_node = sem_get(n);
    c.current = n;
    if c.editor != null && !sem_editor_contains(c, n) { return; }
    if function_node.external { return; }
    c.scope = sem_scope(c, null);
    c.loops = 0;
    c.flow_dependencies.length = 0;
    foreach(var parameter in &function_node.parameters) {
        sem_put(c, c.scope.names, sem_name(sem_get(parameter)), parameter);
    }
    function_node.body = sem_member(n, "body");
    sem_labels(c, function_node.body);
    var flow = sem_block(c, function_node.body, 0);
    if c.flow_dependencies.length != 0 {
        if c.entity_stage == null { sem_flow_request(c, n, &c.flow_dependencies); }
        return;
    }
    if (function_node.type.pointers != 0 || function_node.type.scalar != SVoid()) && (flow & 1) != 0 {
        sem_fail(c, n, sem_cat(c, "Function '", sem_cat(c, sem_name(function_node),
            "' can finish without returning a value")));
    }
}

fn sem_run(c: SemanticContext*): void {
    sem_validate_aliases(c);
    var step1 = sem_get(c.program.root);
    var statements: vector(void*)* = &step1.items;
    var i: usize = 0;
    for(; i < statements.length; i++) {
        var n: void* = statements.data[i];
        var name: void* = sem_member(n, "name");
        if name != null {
            var step6 = sem_identifier(c, name);
            var entry = sem_entry(c, c.source_names, step6, null);
            if entry.value != null {
                if sem_owner(c, entry.value) != sem_owner(c, n) {
                    entry.number = 1;
                }
            } else {
                entry.value = n;
            }
        }
        if sem_ok(c) && sem_function_syntax(n) {
            sem_register_template(c, n);
        }
    }
    i = 0;
    var count: usize = 0;
    for(; i < statements.length; i++) {
        var n: void* = statements.data[i];
        if !sem_has(&c.template_nodes, n) {
            statements.data[count] = n;
            count++;
        }
    }
    statements.length = count;
    i = 0;
    loop {
        if !(i < statements.length && sem_ok(c)) {
            break;
        }
        var n: void* = statements.data[i];
        if sem_is(n, "CoreStruct") {
            sem_type_header(c, n, "");
        }
        if sem_is(n, "CoreEnum") {
            sem_enum_header(c, n);
        }
        i++;
    }
    i = 0;
    loop {
        if !(i < statements.length && sem_ok(c)) {
            break;
        }
        var n: void* = statements.data[i];
        if sem_is(n, "CoreDeclare") {
            if !sem_shape(c, n, "name") {
                break;
            }
            var value: FoundationNode* = sem_node(c, n, KDeclare());
            value.global = true;
            var step42 = sem_member(n, "name");
            var name: u8* = sem_identifier(c, step42);
            sem_set_name(value, sem_output_name(c, n, name));
            if !sem_define(c, c.globals, n, name) {
                var step46 = sem_cat(c, "Duplicate module variable '", name);
                var step47 = sem_cat(c, step46, "'");
                sem_fail(c, n, step47);
                break;
            }
        }
        i++;
    }
    i = 0;
    while i < statements.length && sem_ok(c) {
        var n = statements.data[i];
        if sem_function_syntax(n) { sem_function_declare(c, n, ""); }
        i++;
    }
    sem_declarations(c, statements);
    sem_link_functions(c);
    sem_layout_all(c);
    i = 0;
    loop {
        if !(i < statements.length && sem_ok(c)) {
            break;
