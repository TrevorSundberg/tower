        i++;
    }
    i = 0;
    loop {
        var step55 = i < statements.length;
        if !step55 {
            break;
        }
        var n: void* = statements.data[i];
        var step57 = sem_function_syntax(n);
        var step59 = !step57;
        if step59 {
            var step60 = sem_is(n, "CoreStruct");
            if sem_is(n, "CoreEnum") {
                step60 = true;
            }
            var step61 = !step60;
            step59 = step61;
        }
        if step59 {
            sem_statement(c, n, 0);
            if sem_is(n, "CoreCallStatement") {
