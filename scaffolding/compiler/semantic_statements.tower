        }
        var n: void* = statements.data[i];
        if sem_is(n, "CoreDeclare") {
            var step39 = sem_shape(c, n, "name");
            if !step39 {
                break;
            }
            var value: FoundationNode* = sem_node(c, n, KDeclare());
            value.global = true;
            var step42 = sem_member(n, "name");
            var name: u8* = sem_identifier(c, step42);
