            var step50 = sem_ok(c);
            step49 = step50;
        }
        if !step49 {
            break;
        }
        var n: void* = statements.data[i];
        if sem_is(n, "CoreDeclare") {
            var step53 = sem_declaration_type(c, n);
            if !step53 {
                break;
            }
            sem_add_local(c, n);
