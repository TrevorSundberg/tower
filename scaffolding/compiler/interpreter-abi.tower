// Same scalar execution state as CoreMachineState; public CoreMachine fields
// remain available during foreign callbacks and at every suspension boundary.
struct IMState {
    stack: usize;
    heap: usize;
    error_offset: usize;
    output_bytes: usize;
    steps: u64;
    done: bool;
    output_truncated: bool;
    failed: bool;
    frame_count: usize;
    task_count: usize;
    cached: bool;
}

// Host container operations and existing shared type queries only.
// FoundationNode and FoundationType are composed from foundation-nodes.tower.
struct IMTask {
    node: void*;
    loop_resume: u64;
    phase: usize;
    offset: usize;
}

extern fn im_node(node: void*): FoundationNode*;

extern fn im_binding(node: void*): void*;

extern fn im_type_size(type: FoundationType*): usize;

extern fn im_type_alignment(type: FoundationType*): usize;

extern fn im_type_mask(type: FoundationType*): u64;

extern fn im_type_signed(type: FoundationType*): bool;

extern fn im_pointer_bytes(host: IMState*): usize;

extern fn im_root(host: IMState*): void*;

extern fn im_memory_size(host: IMState*): usize;

extern fn im_memory(host: IMState*): u8*;

extern fn im_base(host: IMState*): usize;

extern fn im_frame_call(host: IMState*): void*;

extern fn im_has_foreign(host: IMState*): bool;

extern fn im_memory_resize(host: IMState*, count: usize): void;

extern fn im_fail(host: IMState*, text: u8*, offset: usize): void;

extern fn im_missing_foreign(host: IMState*, node: void*, offset: usize): void;

extern fn im_append(host: IMState*, text: u8*, count: usize): void;

extern fn im_frame_push(host: IMState*, function: void*, base: usize, offset: usize, call: void*): void;

extern fn im_frame_pop(host: IMState*): void;

extern fn im_task_push(host: IMState*, node: void*, loop_resume: bool, phase: usize, offset: usize): void;

extern fn im_task_pop(host: IMState*, task: IMTask*): void;

extern fn im_cache_clear(host: IMState*): void;

extern fn im_free_neighbor(host: IMState*, key: u64, previous: bool, count: u64*): u64;

extern fn im_foreign(host: IMState*, node: void*, args: u64*, count: usize): u64;

extern fn im_pointee_size(type: FoundationType*): usize;

extern fn im_allocations_get(host: IMState*, key: u64, found: bool*): u64;

extern fn im_strings_get(host: IMState*, key: u64, found: bool*): u64;

extern fn im_sequenced_get(host: IMState*, key: u64, found: bool*): u64;

extern fn im_values_get(host: IMState*, key: u64, found: bool*): u64;

extern fn im_addresses_get(host: IMState*, key: u64, found: bool*): u64;

extern fn im_allocations_set(host: IMState*, key: u64, value: u64): void;

extern fn im_free_blocks_set(host: IMState*, key: u64, value: u64): void;

extern fn im_strings_set(host: IMState*, key: u64, value: u64): void;

extern fn im_sequenced_set(host: IMState*, key: u64, value: u64): void;

extern fn im_values_set(host: IMState*, key: u64, value: u64): void;

extern fn im_addresses_set(host: IMState*, key: u64, value: u64): void;

extern fn im_free_blocks_erase(host: IMState*, key: u64): void;

extern fn im_allocations_take(host: IMState*, key: u64, found: bool*): u64;

// Verify the transitional C++ view under each actual compilation target.
export fn interpreter_state_size(): usize {
    return sizeof(IMState);
}

export fn interpreter_state_offset(field: usize): usize {
    var state: IMState;
    var base = bits(usize, &state);
    var address: usize = base;
    var selected_0 = field == 0;
    if selected_0 {
        address = bits(usize, &state.stack);
    }
    var selected_1 = field == 1;
    if selected_1 {
        address = bits(usize, &state.heap);
    }
    var selected_2 = field == 2;
    if selected_2 {
        address = bits(usize, &state.error_offset);
    }
    var selected_3 = field == 3;
    if selected_3 {
        address = bits(usize, &state.output_bytes);
    }
    var selected_4 = field == 4;
    if selected_4 {
        address = bits(usize, &state.steps);
    }
    var selected_5 = field == 5;
    if selected_5 {
        address = bits(usize, &state.done);
    }
    var selected_6 = field == 6;
    if selected_6 {
        address = bits(usize, &state.output_truncated);
    }
    var selected_7 = field == 7;
    if selected_7 {
        address = bits(usize, &state.failed);
    }
    var selected_8 = field == 8;
    if selected_8 {
        address = bits(usize, &state.frame_count);
    }
    var selected_9 = field == 9;
    if selected_9 {
        address = bits(usize, &state.task_count);
    }
    var selected_10 = field == 10;
    if selected_10 {
        address = bits(usize, &state.cached);
    }
    var offset = address - base;
    return offset;
}

struct IMNeighbors {
    next: u64;
    next_count: u64;
    previous: u64;
    previous_count: u64;
}

extern fn im_free_neighbors(host: IMState*, key: u64, neighbors: IMNeighbors*): void;

extern fn im_free_first(host: IMState*, count: u64*): u64;
