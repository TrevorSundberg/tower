import tower;
import .library.work_budget_types;
import semantic_context_types;
import compiler_kernel;
import semantic_context;
import semantic_program_types;
import semantic_control;
import semantic_support;
import semantic_expression_lowering;
import semantic_aggregates;
import semantic_defer;
import semantic_evaluation;
import semantic_declarations;
import semantic_capture_work;
import semantic_work_ids;
import .library.vector;
import .library.stack;
import .library.work_graph;
import .library.work_pool;

struct SemanticLowering {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    context: SemanticContext*;
    subject: void*;
    block: void*;
    stage: void*;
    ordinal: usize;
    count: usize;
    error: vector(u8);
    error_offset: usize;
    resource: SemanticResourceFailure;
    query_reads: vector(usize);
    signature: bool;
    evaluation_aliases: vector(SemanticEvaluationAlias);
}

extern fn entity_view_open(anchor: void*): void*;
extern fn entity_view_close(view: void*): void;

fn semantic_lowering_kernel(result: SemanticLowering*): void {
    var context: SemanticContext;
    sem_context_snapshot(&context, result.context);
    var program = *context.program;
    context.program = &program;
    context.editor = null;
    context.current = result.subject;
    context.entity_stage = result.stage;
    context.query_reads = &result.query_reads;
    context.evaluation_aliases = &result.evaluation_aliases;
    context.control_reserved = context.control_names;
    context.control_names = null;
    context.count = 0;
    context.node_limit -= result.context.count;
    vector_init(void*, &context.allocations);
    vector_init(void*, &context.lists);
    vector_init(u8, &context.token_text);
    fill(&context.scan, 0, sizeof(stack(void*)));
    vector_init(u8, &program.error);
    context.control_prefix = sem_cat(&context, result.signature ? "aggregate value " : "control value ",
        sem_cat(&context, sem_decimal(&context, convert(u64, result.ordinal)), "."));
    if result.signature { sem_aggregate_function(&context, result.subject); }
    else {
        sem_lift_block(&context, result.block);
        // Validate the completed expansion under the same function ownership
        // and diagnostic receipt as lowering, after its final blocks exist.
        if context.has_defer { sem_defer_depth(&context, result.block, 0); }
    }
    result.count = context.count;
    result.error = program.error;
    result.error_offset = program.error_offset;
    result.resource = program.resource;
    stack_dispose(void*, &context.scan);
    vector_dispose(u8, &context.token_text);
    for(var i: usize = 0; i < context.lists.length; ++i) {
        vector_dispose(void*, bits(vector(void*)*, context.lists.data[i]));
    }
    vector_dispose(void*, &context.lists);
    for(var i: usize = 0; i < context.allocations.length; ++i) { compiler_buffer_free(context.allocations.data[i]); }
    vector_dispose(void*, &context.allocations);
}

fn sem_lower_parallel(c: SemanticContext*): void {
    sem_lower_transform(c, false);
}

fn sem_lower_transform(c: SemanticContext*, signature: bool): void {
    var outcome = sem_lower_pump(c, signature);
    while outcome == SemanticPumpResult.Progress { outcome = sem_lower_pump(c, signature); }
    if outcome != SemanticPumpResult.Waiting { return; }
    // This compatibility entry owns the complete phase. A pipeline coordinator
    // uses the pump directly and services other producers before finalization.
    var query = convert(u32, signature ? SemanticQuery.AggregatePrepare : SemanticQuery.Lowering);
    foreach(var subject in &c.program.functions) {
        var id = work_find(&c.queries, subject, query, 0);
        if id == 0 || work_task(&c.queries, id).state == WorkState.Succeeded { continue; }
        if sem_declaration_failure(c, id) { return; }
        var cycle: vector(usize) = default;
        defer vector_dispose(&cycle);
        sem_fail(c, subject, work_cycle(&c.queries, id, &cycle)
            ? "Lowering dependency cycle" : "Lowering is waiting for an unfinished compiler query");
        return;
    }
}

// Stable per-function components allow newly ready bodies to join the same
// phase without rebuilding jobs or lowering previously published functions.
fn sem_lower_register(c: SemanticContext*, signature: bool): void* {
    var kind = signature ? &c.aggregate_preparations : &c.lowering_results;
    if !sem_ok(c) || (!signature && !c.surface_expressions && !c.has_defer) { return *kind; }
    // Source spellings and names produced by earlier control lowering are frozen
    // before dispatch. Every function owns its generated-name table and prefix.
    sem_control_names(c);
    var query_kind = convert(u32, signature ? SemanticQuery.AggregatePrepare : SemanticQuery.Lowering);
    for(var i: usize = 0; i < c.program.functions.length; ++i) {
        var subject = c.program.functions.data[i];
        var block = i == 0 ? subject : sem_get(subject).body;
        if block == null { continue; }
        if signature && (i == 0 || !sem_aggregate_needed(subject)) { continue; }
        if *kind == null {
            *kind = sem_create(c.program.root);
            sem_require(entity_register(*kind, sizeof(SemanticLowering), alignof(SemanticLowering), 0));
        }
        if entity_component_get(subject, *kind) != null { continue; }
        if signature {
            if c.aggregate_signatures == null {
                c.aggregate_signatures = sem_create(c.program.root);
                sem_require(entity_register(c.aggregate_signatures, sizeof(SemanticAggregateSignature), alignof(SemanticAggregateSignature), 0));
            }
            var metadata = bits(SemanticAggregateSignature*, entity_component_data(entity_component_add(subject, c.aggregate_signatures)));
            sem_require(metadata != null);
            *metadata = default;
        }
        var result = bits(SemanticLowering*, entity_component_data(entity_component_add(subject, *kind)));
        sem_require(result != null);
        fill(result, 0, sizeof(SemanticLowering));
        result.subject = subject;
        result.block = block;
        result.ordinal = i;
        result.signature = signature;
        result.kernel.kind = CompilerKernelKind.Lower;
        result.kernel.payload = bits(void*, result);
        var id = work_request(&c.queries, subject, query_kind, 0);
        sem_require(id != 0);
        var body = work_find(&c.queries, subject, convert(u32, SemanticQuery.Body), 0);
        if body != 0 { sem_require(work_depend(&c.queries, id, body)); }
        var snapshot = work_find(&c.queries, c.program.root, convert(u32, SemanticQuery.KnownSnapshot), 0);
        if snapshot != 0 { sem_require(work_depend(&c.queries, id, snapshot)); }
        if !signature {
            var preparation = work_find(&c.queries, subject, convert(u32, SemanticQuery.AggregatePrepare), 0);
            if preparation != 0 { sem_require(work_depend(&c.queries, id, preparation)); }
        }
        // Disjoint function payload ranges; layout/type inputs are immutable.
        // Generated entities remain private until the publication barrier.
        var domain = convert(u64, SemanticWorkDomain.Compiler);
        sem_require(work_access(&c.queries, id, domain,
            convert(u64, signature ? SemanticAccess.Aggregate : SemanticAccess.Lowering), i, 1, WorkAccessMode.Write));
        sem_require(work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Body), i, 1, WorkAccessMode.Write));
        sem_require(work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Layout), 0, ~convert(usize, 0), WorkAccessMode.Read));
        if !signature {
            sem_require(work_access(&c.queries, id, domain, convert(u64, SemanticAccess.Aggregate), 0, ~convert(usize, 0), WorkAccessMode.Read));
        }
        sem_require(work_seal(&c.queries, id));
        sem_require(work_demand(&c.queries, id));
    }
    if signature && *kind != null { c.surface_expressions = true; }
    return *kind;
}

export fn sem_lower_pump(c: SemanticContext*, signature: bool): SemanticPumpResult {
    if !sem_ok(c) || !work_ok(&c.queries) { return SemanticPumpResult.Failed; }
    var kind = sem_lower_register(c, signature);
    if kind == null { return SemanticPumpResult.Complete; }
    var query_kind = convert(u32, signature ? SemanticQuery.AggregatePrepare : SemanticQuery.Lowering);
    if c.workers.count == 0 && !sem_workers_open(c) { return SemanticPumpResult.Failed; }
    var batch: vector(SemanticLowering*) = default;
    defer vector_dispose(&batch);
    sem_require(vector_reserve(&batch, SemanticPreparationWindow));
    {
        var count: usize = 0;
        var ticket: WorkTicket;
        while count < SemanticPreparationWindow && work_take_query(&c.queries, &ticket, query_kind) {
            var subject = work_task(&c.queries, ticket.task).subject;
            var result = bits(SemanticLowering*, entity_component_data(entity_component_get(subject, kind)));
            result.ticket = ticket;
            // The immutable work-kind entity anchors this wave. The program
            // root can itself be leased by its own lowering job.
            result.stage = entity_stage_open(kind);
            sem_require(result.stage != null);
            if !signature { sem_capture_ranges(c, result.block, &ticket, result.stage); }
            sem_require(entity_stage_lease(result.stage, result.subject));
            if signature {
                foreach(var parameter in &sem_get(result.subject).parameters) {
                    sem_require(entity_stage_lease(result.stage, parameter));
                }
            }
            batch.data[count] = result;
            count++;
        }
        if count == 0 {
            return sem_query_pending(c, query_kind) ? SemanticPumpResult.Waiting : SemanticPumpResult.Complete;
        }
        var view = entity_view_open(kind);
        sem_require(view != null);
        var context: SemanticContext;
        sem_context_snapshot(&context, c);
        for(var i: usize = 0; i < count; i++) { batch.data[i].context = &context; }
        var receipt: WorkReservation;
        var extra = sem_workers_admit(c, count, &receipt);
        defer sem_workers_release(c, &receipt);
        sem_require(compiler_kernel_dispatch_admitted(&c.workers, batch.data, count, extra));
        entity_view_close(view);
        for(var i: usize = 0; i < count; ++i) {
            sem_require(entity_stage_publish(batch.data[i].stage));
            batch.data[i].stage = null;
            batch.data[i].context = null;
        }
        for(var i: usize = 0; i < count; ++i) {
            var result = batch.data[i];
            sem_query_observe(c, &result.ticket, &result.query_reads);
            // Even a failed function owns its generated nodes until the failed
            // program is destroyed. Publish them so ordinary lifecycle cleanup
            // handles all canonical links without dangling staged references.
            sem_evaluation_aliases(c, &result.evaluation_aliases);
            c.count += result.count;
            if !sem_restore_resource(c, result.resource.error, &result.error, result.resource.offset) {
                sem_restore_error(c, &result.error, result.error_offset);
            }
            if c.count > c.node_limit { sem_fail(c, result.subject, "Foundation component memory budget exceeded"); }
            var success = result.resource.error == WorkBudgetError.None && result.error.length == 0 && c.count <= c.node_limit;
            sem_require(work_finish(&c.queries, &result.ticket, success));
            vector_dispose(u8, &result.error);
            vector_dispose(&result.query_reads);
            vector_dispose(&result.evaluation_aliases);
        }
    }
    return sem_ok(c) ? SemanticPumpResult.Progress : SemanticPumpResult.Failed;
}

fn sem_lower_dispose_kind(kind: void*): void {
    if kind == null { return; }
    for(var i: usize = 0; i < entity_query_count(kind); i++) {
        var result = bits(SemanticLowering*, entity_component_data(entity_query_at(kind, i)));
        sem_require(result.stage == null);
        result.context = null;
        vector_dispose(&result.error);
        vector_dispose(&result.query_reads);
        vector_dispose(&result.evaluation_aliases);
    }
}

fn sem_lower_dispose(c: SemanticContext*): void {
    sem_require(c.workers.running == 0);
    sem_lower_dispose_kind(c.aggregate_preparations);
    sem_lower_dispose_kind(c.lowering_results);
}
