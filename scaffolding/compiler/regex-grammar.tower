import tower;

// Regex notation is parsed by the ordinary LR engine over Unicode scalar IDs.
// These are the same Rule/Reference/String/Range components as other grammars.
import 'grammar-builder';
import 'grammar-types';

fn regex_reference(builder: GrammarBuilder*, name: u8*, child: u8*): void {
    var rule = grammar_builder_rule(builder, name, false);
    grammar_builder_reference(builder, rule, child, "value");
}

fn regex_symbols(builder: GrammarBuilder*, name: u8*, symbols: u8*): void {
    var i: usize = 0;
    loop {
        var value = symbols[i];
        var done = value == 0;
        if done {
            return;
        }
        var rule = grammar_builder_rule(builder, name, false);
        var scalar = convert(u32, value);
        grammar_builder_range(builder, rule, scalar, scalar);
        i++;
    }
}

fn regex_characters(builder: GrammarBuilder*, name: u8*, excluded: u8*): void {
    var blocked: u8[128];
    fill(&blocked, 0, 128);
    var i: usize = 0;
    loop {
        var value = excluded[i];
        var done = value == 0;
        if done {
            break;
        }
        blocked[value] = 1;
        i++;
    }
    var first: u32 = 0;
    var scalar: u32 = 0;
    loop {
        var done = scalar == 128;
        if done {
            break;
        }
        var omit = blocked[scalar] != 0;
        if omit {
            var nonempty = first < scalar;
            if nonempty {
                var last = scalar - 1;
                var rule = grammar_builder_rule(builder, name, false);
                grammar_builder_range(builder, rule, first, last);
            }
            first = scalar + 1;
        }
        scalar++;
    }
    var rule = grammar_builder_rule(builder, name, false);
    grammar_builder_range(builder, rule, first, 1114111);
}

export fn regex_grammar_create(kinds: FrontendKinds*): void* {
    var storage: GrammarBuilder;
    var builder = &storage;
    grammar_builder_init(builder, kinds);
    regex_reference(builder, "Regex", "RegexChoice");

    var rule = grammar_builder_rule(builder, "RegexChoice", false);
    grammar_builder_reference(builder, rule, "RegexChoice", "left");
    grammar_builder_literal(builder, rule, "|");
    grammar_builder_reference(builder, rule, "RegexSequence", "right");
    regex_reference(builder, "RegexChoice", "RegexSequence");

    rule = grammar_builder_rule(builder, "RegexSequence", false);
    grammar_builder_reference(builder, rule, "RegexSequence", "left");
    grammar_builder_reference(builder, rule, "RegexRepeat", "right");
    grammar_builder_rule(builder, "RegexSequence", false);

    rule = grammar_builder_rule(builder, "RegexRepeat", false);
    grammar_builder_reference(builder, rule, "RegexAtom", "atom");
    grammar_builder_reference(builder, rule, "RegexSuffix", "suffix");
    regex_symbols(builder, "RegexSuffix", "*+?");
    grammar_builder_rule(builder, "RegexSuffix", false);

    rule = grammar_builder_rule(builder, "RegexAtom", false);
    grammar_builder_literal(builder, rule, "(");
    grammar_builder_reference(builder, rule, "RegexChoice", "group");
    grammar_builder_literal(builder, rule, ")");
    regex_reference(builder, "RegexAtom", "RegexClass");
    regex_reference(builder, "RegexAtom", "RegexCharacter");
    rule = grammar_builder_rule(builder, "RegexAtom", false);
    grammar_builder_literal(builder, rule, ".");

    // Class dashes remain character entries. Range grouping is a semantic step;
    // escaped dashes and leading/trailing dashes keep their literal meanings.
    rule = grammar_builder_rule(builder, "RegexClass", false);
    grammar_builder_literal(builder, rule, "[");
    grammar_builder_literal(builder, rule, "^");
    grammar_builder_reference(builder, rule, "RegexClassCharacters", "negated");
    grammar_builder_literal(builder, rule, "]");
    rule = grammar_builder_rule(builder, "RegexClass", false);
    grammar_builder_literal(builder, rule, "[");
    grammar_builder_reference(builder, rule, "RegexClassBody", "body");
    grammar_builder_literal(builder, rule, "]");
    rule = grammar_builder_rule(builder, "RegexClassBody", false);
    grammar_builder_reference(builder, rule, "RegexClassFirst", "first");
    grammar_builder_reference(builder, rule, "RegexClassCharacters", "rest");
    grammar_builder_rule(builder, "RegexClassBody", false);
    rule = grammar_builder_rule(builder, "RegexClassCharacters", false);
    grammar_builder_reference(builder, rule, "RegexClassCharacters", "left");
    grammar_builder_reference(builder, rule, "RegexClassCharacter", "right");
    grammar_builder_rule(builder, "RegexClassCharacters", false);
    regex_reference(builder, "RegexClassFirst", "RegexClassInitial");
    regex_reference(builder, "RegexClassFirst", "RegexEscape");
    regex_reference(builder, "RegexClassCharacter", "RegexClassPlain");
    regex_reference(builder, "RegexClassCharacter", "RegexEscape");
    regex_characters(builder, "RegexClassInitial", "^]\\");
    regex_characters(builder, "RegexClassPlain", "]\\");

    regex_reference(builder, "RegexCharacter", "RegexPlain");
    regex_reference(builder, "RegexCharacter", "RegexEscape");
    regex_characters(builder, "RegexPlain", "\\[()|.*+?^${}");
    rule = grammar_builder_rule(builder, "RegexEscape", false);
    grammar_builder_literal(builder, rule, "\\");
    grammar_builder_reference(builder, rule, "RegexEscapedSymbol", "symbol");
    regex_symbols(builder, "RegexEscapedSymbol", "nrt\\/[]()|*+?.^-{}$\"'");
    rule = grammar_builder_rule(builder, "RegexEscape", false);
    grammar_builder_literal(builder, rule, "\\x");
    grammar_builder_reference(builder, rule, "RegexHexDigit", "first");
    grammar_builder_reference(builder, rule, "RegexHexDigit", "second");
    rule = grammar_builder_rule(builder, "RegexEscape", false);
    grammar_builder_literal(builder, rule, "\\u{");
    grammar_builder_reference(builder, rule, "RegexHexDigits", "digits");
    grammar_builder_literal(builder, rule, "}");
    regex_reference(builder, "RegexHexDigits", "RegexHexDigit");
    rule = grammar_builder_rule(builder, "RegexHexDigits", false);
    grammar_builder_reference(builder, rule, "RegexHexDigits", "left");
    grammar_builder_reference(builder, rule, "RegexHexDigit", "right");
    rule = grammar_builder_rule(builder, "RegexHexDigit", false);
    grammar_builder_range(builder, rule, 48, 57);
    rule = grammar_builder_rule(builder, "RegexHexDigit", false);
    grammar_builder_range(builder, rule, 65, 70);
    rule = grammar_builder_rule(builder, "RegexHexDigit", false);
    grammar_builder_range(builder, rule, 97, 102);
    return grammar_builder_finish(builder);
}
