import tower;
import semantic_context_types;
import inspection_policy;
import semantic_context;
import semantic_support;
import semantic_statements;
import semantic_types;
import semantic_modules;
import semantic_generic_values;
import semantic_declarations;
import semantic_constructor_work;
import .library.vector;
import .library.work_budget_types;

extern fn entity_stage_lease_at(stage: void*, index: usize): void*;
extern fn entity_component_owner(component: void*): void*;

// Optional, disposable analysis on the original shared entities. The annotation
// is the actual type-expression tree, whose name leaves bind to declarations;
// it is not a second type language or a partially instantiated Foundation graph.
enum GenericInfoKind: u32 {
    Function, Constructor, TypeParameter, ConstantParameter, Parameter,
    Structure, Field, Variable, TypeExpression, Return,
    Member, Index, Binary, Value, Load, Assignment, Call, PrimitiveType
}

enum GenericShapeState: u32 {
    Uninspected, Fixed, Unknown
}

// Query-local substitutions bind declaration entities to existing argument
// trees. They are a view of the shared graph, not another type representation.
struct GenericBinding {
    parameter: void*;
    argument: void*;
    bindings: GenericBinding*;
    next: GenericBinding*;
}

struct GenericInfo {
    kind: GenericInfoKind;
    definition: void*;
    declaration: void*;
    annotation: void*;
    resolved: void*;
    dependent: bool;
    bindings: GenericBinding*;
    shape_state: GenericShapeState;
    fixed_record: void*;
}

struct GenericAnalysis {
    context: SemanticContext*;
    component: void*;
    stage: void*;
    definition: void*;
    constructor: bool;
    resolve_types: bool;
    binding: bool;
    budget: usize;
    truncated: bool;
}

fn generic_info(node: void*, component: void*): GenericInfo* {
    if node == null {
        return null;
    }
    return bits(GenericInfo*, entity_component_data(entity_component_get(node, component)));
}

fn generic_info_add(a: GenericAnalysis*, node: void*, declaration: void*, kind: GenericInfoKind): GenericInfo* {
    if !sem_ok(a.context) { return null; }
    var error = entity_stage_lease_result(a.stage, node);
    if error != WorkBudgetError.None { sem_scratch_error(a.context, node, error); return null; }
    var result = bits(GenericInfo*, entity_component_data(entity_component_add_result(node, a.component, &error)));
    if result == null { sem_scratch_error(a.context, node, error); return null; }
    fill(result, 0, sizeof(GenericInfo));
    result.kind = kind;
    result.definition = a.definition;
    result.declaration = declaration;
    result.annotation = sem_member(declaration, "type");
    return result;
}

fn generic_info_bind(a: GenericAnalysis*, node: void*, declaration: void*): void {
    var meaning = generic_info(declaration, a.component);
    if meaning == null {
        return;
    }
    var result = generic_info_add(a, node, declaration, meaning.kind);
    if result == null { return; }
    copy(result, meaning, sizeof(GenericInfo));
}

fn generic_info_lookup(scope: SemanticScope*, name: u8*): void* {
    while scope != null {
        var found = sem_lookup_table(scope.names, name);
        if found != null {
            return found;
        }
        scope = scope.parent;
    }
    return null;
}

fn generic_info_name(a: GenericAnalysis*, scope: SemanticScope*, node: void*): void {
    var name = sem_member(node, "name");
    if name != null {
        // Duplicate/invalid unused bodies remain for ordinary instantiation to
        // diagnose. Never make a failed speculative check a document error.
        sem_put(a.context, scope.names, sem_identifier(a.context, name), node);
    }
}

fn generic_info_dependent(node: void*, component: void*, depth: usize): bool {
    var next = depth + 1;
    if node == null {
        return false;
    }
    if depth == InspectionDepthLimit {
        return true;
    }
    var meaning = generic_info(node, component);
    if meaning != null {
        if meaning.kind == GenericInfoKind.TypeParameter {
            return true;
        }
        if meaning.kind == GenericInfoKind.ConstantParameter {
            return true;
        }
        if meaning.kind == GenericInfoKind.Structure {
            return true;
        }
    }
    for(var i: usize = 0; i < sem_child_count(node); i++) {
        if generic_info_dependent(sem_child(node, i), component, next) {
            return true;
        }
    }
    return false;
}

fn generic_info_type(a: GenericAnalysis*, meaning: GenericInfo*): void {
    if a.context.program.resource.error != WorkBudgetError.None { return; }
    var annotation = meaning.annotation;
    if annotation == null {
        return;
    }
    meaning.dependent = generic_info_dependent(annotation, a.component, 0);
    if meaning.dependent {
        return;
    }
    // A failed check may leave a named type with an unfinished layout in the
    // ordinary registry. Its written annotation/bindings remain useful, but
    // querying that partial registry must not turn zeroed fields into a layout.
    if !a.resolve_types || a.binding {
        return;
    }
    if sem_equal(sem_tokens(a.context, annotation), "type") {
        return;
    }
    meaning.resolved = generic_resolved_type(a, annotation);
    a.context.program.error.length = 0;
}

fn generic_resolved_type(a: GenericAnalysis*, annotation: void*): void* {
    var c = a.context;
    if !generic_type_inputs(a, annotation, 0) { return null; }
    var previous = c.entity_stage;
    defer c.entity_stage = previous;
    // Function-type parameters belong to the leased annotation. Only this
    // query uses its stage; independently owned expression clones do not.
    if a.stage != null { c.entity_stage = a.stage; }
    var type = sem_type(c, annotation);
    return sem_ok(c) ? sem_type_entity(c, type, annotation) : null;
}

// Failed speculative constructors remain failed graph receipts. Never fall
// through to synchronous construction under the annotation's lease on retry.
fn generic_type_inputs(a: GenericAnalysis*, node: void*, depth: usize): bool {
    if node == null { return true; }
    if depth >= InspectionDepthLimit { a.truncated = true; return false; }
    if sem_declaration_query(a.context, node) != 0 {
        sem_declaration_report(a.context, node);
        return sem_ok(a.context);
    }
    for(var i: usize = 0; i < sem_child_count(node); i++) {
        if !generic_type_inputs(a, sem_child(node, i), depth + 1) { return false; }
    }
    return true;
}

// Binding establishes which annotations are concrete. Its stage must release
// the source leases before declaration workers can borrow those same trees.
// The component kind stays query-private until the entire inspection succeeds.
fn generic_types_prepare(a: GenericAnalysis*): void {
    var c = a.context;
    sem_require(c.entity_stage == null && a.stage == null);
    if !a.resolve_types { return; }
    var subjects = sem_list(c);
    if subjects == null { return; }
    var previous_subjects = c.declaration_subjects;
    var previous_isolated = c.declaration_isolated;
    c.declaration_subjects = subjects;
    c.declaration_isolated = true;
    defer { c.declaration_subjects = previous_subjects; c.declaration_isolated = previous_isolated; }
    for(var i: usize = 0; i < entity_query_count(a.component) && sem_ok(c); i++) {
        var meaning = bits(GenericInfo*, entity_component_data(entity_query_at(a.component, i)));
        if meaning.kind != GenericInfoKind.TypeExpression || meaning.dependent || meaning.annotation == null { continue; }
        if !sem_type_query_syntax(c, meaning.annotation) { continue; }
        var owner = sem_declaration_state(c, meaning.definition);
        if owner == null { return; }
        var existing = sem_declaration_query(c, meaning.annotation);
        var query = sem_type_query_add(c, meaning.annotation, owner, false);
        if query == null { return; }
        // Inspection consumes storage descriptions, not only nominal identity.
        // Its root query owns the ordinary constructed-layout continuation;
        // the unused template definition has no executable declaration job.
        if existing == 0 { query.construction_owner = null; }
    }
    if !sem_ok(c) || subjects.length == 0 { return; }
    sem_declaration_discover(c);
    sem_declarations_execute(c, subjects);
}

fn generic_info_walk(a: GenericAnalysis*, node: void*, values: SemanticScope*, types: SemanticScope*, depth: usize): void {
    if node == null || !generic_step(a, depth) { return; }
    var next = depth + 1;
    var c = a.context;
    var declaration = generic_info(node, a.component);
    var name: void* = null;
    if sem_is(node, "CoreStruct") {
        declaration = generic_info_add(a, node, node, GenericInfoKind.Structure);
        if declaration == null { return; }
        declaration.dependent = true;
        generic_info_name(a, types, node);
        name = sem_member(node, "name");
    }
    if sem_is(node, "CoreField") {
        declaration = generic_info_add(a, node, node, GenericInfoKind.Field);
        if declaration == null { return; }
        name = sem_member(node, "name");
    }
    var local = sem_is(node, "CoreDeclare");
    if local {
        declaration = generic_info_add(a, node, node, GenericInfoKind.Variable);
        if declaration == null { return; }
        name = sem_member(node, "name");
    }
    if sem_is(node, "CoreParameter") {
        name = sem_member(node, "name");
    }
    if node == a.definition {
        name = sem_member(node, "name");
    }
    if sem_is(node, "CoreType") {
        declaration = generic_info_add(a, node, node, GenericInfoKind.TypeExpression);
        if declaration == null { return; }
        declaration.annotation = node;
    }
    if sem_is(node, "CoreReturn") {
        declaration = generic_info_add(a, node, node, GenericInfoKind.Return);
        if declaration == null { return; }
        declaration.annotation = sem_member(a.definition, "type");
    }
    if sem_is(node, "CoreCall") {
        var callee = sem_member(node, "name");
        var representation = sem_type_representation_name(sem_identifier(c, callee));
        if !sem_ok(a.context) { return; }
        declaration = generic_info_add(a, node, node, representation ? GenericInfoKind.PrimitiveType : GenericInfoKind.Call);
        if declaration == null { return; }
        // Attach the callable meaning to the callee, not its argument leaves.
        // Argument traversal below can independently bind parameters and literals.
        generic_info_bind(a, callee, node);
    }
    if sem_is(node, "Number") || sem_is(node, "FloatNumber") {
        declaration = generic_info_add(a, node, node, GenericInfoKind.Value);
        if declaration == null { return; }
    }
    // Bind names by their semantic tree roles, not token spelling. In particular
    // a member name is never mistaken for a same-named parameter or local.
    var reference: void* = null;
    var type_name = sem_is(node, "CoreTypeName");
    var location = sem_is(node, "CoreLocation");
    var reference_role = type_name;
    if location {
        reference_role = true;
    }
    if reference_role {
        if sem_member(node, "base") == null {
            reference = sem_member(node, "name");
        }
    }
    if sem_is(node, "CoreArrayCount") {
        reference = node;
    }
    if reference != null {
        var text = sem_identifier(c, reference);
        if !sem_ok(a.context) { return; }
        var binding: void* = null;
        if type_name {
            binding = generic_info_lookup(types, text);
            // A type application's argument can name a compile-time integer.
            if binding == null {
                var value = generic_info_lookup(values, text);
                var meaning = generic_info(value, a.component);
                var constant = meaning != null;
                constant &&= meaning.kind == GenericInfoKind.ConstantParameter;
                if constant {
                    binding = value;
                }
            }
        }
        else {
            binding = generic_info_lookup(values, text);
            if binding == null {
                binding = generic_info_lookup(types, text);
            }
        }
        if binding != null {
            generic_info_bind(a, node, binding);
        }
    }
    if sem_is(node, "CoreBlock") {
        values = sem_scope(c, values);
        if !sem_ok(a.context) { return; }
        types = sem_scope(c, types);
        if !sem_ok(a.context) { return; }
    }
    for(var i: usize = 0; i < sem_child_count(node) && c.program.resource.error == WorkBudgetError.None; i++) {
        var child = sem_child(node, i);
        if child != name {
            generic_info_walk(a, child, values, types, next);
        }
    }
    if c.program.resource.error != WorkBudgetError.None { return; }
    if declaration != null {
        generic_info_type(a, declaration);
        if c.program.resource.error != WorkBudgetError.None { return; }
        if name != null {
            generic_info_bind(a, name, node);
        }
    }
    // Local scope begins after the initializer, preserving lexical shadowing.
    if local {
        generic_info_name(a, values, node);
    }
}

// Query clients opt into this pass; executable compilation still checks each
// concrete instance normally. Type/value bindings stay on the source entities.
export fn sem_generic_inspect(c: SemanticContext*, resolve_types: bool, truncated: bool*): void* {
    if !sem_ok(c) { return null; }
    *truncated = false;
    var error: WorkBudgetError;
    var component = sem_kind_result(c.program.root, sizeof(GenericInfo), alignof(GenericInfo), &error);
    if component == null { sem_scratch_error(c, c.program.root, error); return null; }
    var committed = false;
    defer { if !committed { sem_require(entity_attach_result(component, null, null) == WorkBudgetError.None); } }
    var stage = entity_stage_open_result(c.program.root, &error);
    if stage == null { sem_scratch_error(c, c.program.root, error); return null; }
    // No client receives the private kind before every inspection phase joins.
    defer { if stage != null { entity_stage_discard(stage); } }
    var a: GenericAnalysis = {context: c, component: component, resolve_types: resolve_types,
        stage: stage, binding: true, budget: InspectionNodeLimit, ..default};
    var i: usize = 0;
    for(; i < c.template_nodes.length && c.program.resource.error == WorkBudgetError.None; i++) {
        var definition = c.template_nodes.data[i];
        a.definition = definition;
        a.constructor = sem_equal(sem_tokens(c, sem_member(definition, "type")), "type");
        if !sem_ok(c) { return default; }
        var kind = GenericInfoKind.Function;
        if a.constructor {
            kind = GenericInfoKind.Constructor;
        }
        if generic_info_add(&a, definition, definition, kind) == null { return null; }
        var values = sem_scope(c, null);
        if !sem_ok(c) { return default; }
        var types = sem_scope(c, null);
        if !sem_ok(c) { return default; }
        var parameters = sem_collect(c, sem_member(definition, "params"), "CoreParameter");
        if !sem_ok(c) { return default; }
        var p: usize = 0;
        for(; p < parameters.length; p++) {
            var parameter = parameters.data[p];
            var parameter_kind = GenericInfoKind.Parameter;
            if a.constructor {
                parameter_kind = GenericInfoKind.ConstantParameter;
            }
            var is_type = generic_type_parameter(c.generics, definition, p);
            if is_type {
                parameter_kind = GenericInfoKind.TypeParameter;
            }
            if generic_info_add(&a, parameter, parameter, parameter_kind) == null { return null; }
            if is_type {
                generic_info_name(&a, types, parameter);
            }
            else {
                generic_info_name(&a, values, parameter);
            }
        }
        generic_info_walk(&a, definition, values, types, 0);
    }
    if !sem_ok(c) { return null; }
    a.binding = false;
    if resolve_types {
        error = entity_stage_publish_result(stage);
        if error != WorkBudgetError.None { sem_scratch_error(c, c.program.root, error); return null; }
        stage = null;
        a.stage = null;
        generic_types_prepare(&a);
        if !sem_ok(c) { return null; }
        stage = entity_stage_open_result(c.program.root, &error);
        if stage == null { sem_scratch_error(c, c.program.root, error); return null; }
        a.stage = stage;
        for(var index: usize = 0; index < entity_query_count(component); index++) {
            var entry = entity_query_at(component, index);
            error = entity_stage_lease_result(stage, entity_component_owner(entry));
            if error != WorkBudgetError.None { sem_scratch_error(c, c.program.root, error); return null; }
        }
        for(var index: usize = 0; index < entity_query_count(component) && sem_ok(c); index++) {
            var meaning = bits(GenericInfo*, entity_component_data(entity_query_at(component, index)));
            generic_info_type(&a, meaning);
        }
    } else {
        // No declaration worker needs these source leases. Revisit the bound
        // annotations through their owners and publish both passes together.
        for(var index: usize = 0; ; index++) {
            var owner = entity_stage_lease_at(stage, index);
            if owner == null { break; }
            generic_info_type(&a, generic_info(owner, component));
        }
    }
    // Bind every definition before following type applications. This preserves
    // module forward references and makes inspection independent of file order.
    i = 0;
    for(; i < c.template_nodes.length && c.program.resource.error == WorkBudgetError.None; i++) {
        a.definition = c.template_nodes.data[i];
        generic_value_walk(&a, a.definition, 0);
    }
    *truncated = a.truncated;
    if !sem_ok(c) { return null; }
    error = entity_stage_publish_result(stage);
    if error != WorkBudgetError.None { sem_scratch_error(c, c.program.root, error); return null; }
    stage = null;
    committed = true;
    return component;
}
