import tower;
import 'foundation-tags';
import 'foundation-types';
import 'semantic-context';
import 'semantic-support';
import 'semantic-types';
import '../library/vector';
import '../library/work-graph';

const LayoutQuery: u32 = 1;
const LayoutMaximumBytes: usize = 4194304;

extern fn entity_view_open(anchor: void*): void*;

extern fn entity_view_close(view: void*): void;

// A layout kernel reads completed dependency layouts and writes only its type
// and field offsets. Discovery/scheduling is shared work-graph infrastructure.
// No graph traversal, recursion or dependency allocation belongs in this kernel.
fn sem_layout_compute(c: SemanticContext*, n: void*): void {
    var t = sem_get(n);
    t.size = 0;
    t.alignment = 1;
    if semantic_enum(&t.type) {
        t.size = semantic_size(&t.element);
        t.alignment = semantic_alignment(&t.element);
        return;
    }
    var array_type = t.type.scalar == SArray();
    if array_type {
        var size = semantic_size(&t.element);
        var empty = t.length == 0;
        if empty {
            sem_fail(c, n, "An array needs a positive length");
            return;
        }
        var limit = LayoutMaximumBytes() / t.length;
        var large = size > limit;
        if large {
            sem_fail(c, n, "Array storage exceeds 4 MiB");
            return;
        }
        t.size = size * t.length;
        t.alignment = semantic_alignment(&t.element);
        return;
    }
    var i: usize = 0;
    while i < t.items.length {
        var field = t.items.data[i];
        var value = sem_get(field);
        var alignment = semantic_alignment(&value.type);
        var larger = alignment > t.alignment;
        if larger {
            t.alignment = alignment;
        }
        value.byte_offset = sem_round(t.size, alignment);
        var bytes = semantic_size(&value.type);
        var maximum = LayoutMaximumBytes() - value.byte_offset;
        var large = bytes > maximum;
        if large {
            sem_fail(c, field, "Foundation struct storage exceeds 4 MiB");
            return;
        }
        t.size = value.byte_offset + bytes;
        i = i + 1;
    }
    t.size = sem_round(t.size, t.alignment);
    var empty = t.size == 0;
    if empty {
        t.size = 1;
    }
}

fn sem_layout_dependency(c: SemanticContext*, consumer: usize, type: FoundationType*): void {
    if semantic_aggregate(type) {
        var dependency = work_request(&c.layout_work, type.record, LayoutQuery(), 0);
        var present = dependency != 0;
        sem_require(present);
        sem_require(work_depend(&c.layout_work, consumer, dependency));
    }
}

fn sem_layout(c: SemanticContext*, n: void*): void {
    if sem_ok(c) {} else {
        return;
    }
    var g = &c.layout_work;
    var first = g.tasks.length;
    var root = work_request(g, n, LayoutQuery(), 0);
    var present = root != 0;
    sem_require(present);
    var task = work_task(g, root);
    var complete = task.state == WorkState.Succeeded;
    if complete {
        return;
    }
    // Work discovered while scanning is appended to this compact list. Each
    // layout and each by-value edge is indexed once for the whole compilation.
    // Pointer fields do not demand pointee layout, so recursive pointers work.
    var i = first;
    while i < g.tasks.length {
        var id = i + 1;
        task = work_task(g, id);
        var type = sem_get(task.subject);
        var array_type = type.type.scalar == SArray();
        if array_type {
            sem_layout_dependency(c, id, &type.element);
        } else {
            if semantic_enum(&type.type) {} else {
                var j: usize = 0;
                while j < type.items.length {
                    var field = sem_get(type.items.data[j]);
                    sem_layout_dependency(c, id, &field.type);
                    j = j + 1;
                }
            }
        }
        sem_require(work_seal(g, id));
        i = i + 1;
    }
    sem_require(work_demand(g, root));
    // The coordinator owns this view until all admitted kernels have joined.
    // Discovery is complete: kernels may update their declared layout payloads,
    // but cannot invalidate query indexes or reclaim their borrowed entities.
    var view = entity_view_open(n);
    var pinned = view != null;
    sem_require(pinned);
    var ticket: WorkTicket;
    while work_take(g, &ticket) {
        task = work_task(g, ticket.task);
        sem_layout_compute(c, task.subject);
        var success = sem_ok(c);
        sem_require(work_finish(g, &ticket, success));
        if success {} else {
            entity_view_close(view);
            return;
        }
    }
    entity_view_close(view);
    task = work_task(g, root);
    complete = task.state == WorkState.Succeeded;
    if complete {
        return;
    }
    var cycle: vector(usize);
    vector_init(usize, &cycle);
    var found = work_cycle(g, root, &cycle);
    sem_require(work_ok(g));
    var chain: u8* = "";
    if found {
        i = 0;
        while i < cycle.length {
            task = work_task(g, cycle.data[i]);
            var value = sem_get(task.subject);
            var separator = i != 0;
            if separator {
                chain = sem_cat(c, chain, " -> ");
            }
            chain = sem_cat(c, chain, sem_name(value));
            i = i + 1;
        }
    }
    vector_dispose(usize, &cycle);
    sem_fail(c, n, sem_cat(c, "Recursive by-value layout: ", sem_cat(c, chain, "; use a pointer")));
}
