import tower;
import syntax_view;

enum SyntaxTokenId: u32 {
    Name = 1114112, String = 1114113, Token = 1179648,
    Literal = 2097152, Hole = 3145728, End = 4294967294
}

// Derived grammar-emission views; names belong to the retained emission result.
struct SyntaxEmissionLiteral {
    text: u8*;
    length: usize;
    id: u32;
}

struct SyntaxEmissionInput {
    rules: SyntaxRuleView*;
    count: usize;
    tokens: void**;
    token_count: usize;
    reserved: u8**;
    reserved_count: usize;
    literals: SyntaxEmissionLiteral*;
    literal_count: usize;
    category: u8*;
    // Ordinary construct roots only; lexical inputs still include every rule.
    // False retains the eager emission path for general callers and oracles.
    reachable: bool;
    root: void*;
    syntax_kind: void*;
    rule_kind: void*;
    reference_kind: void*;
    string_kind: void*;
    range_kind: void*;
}

struct SyntaxEmissionName {
    text: u8*;
    length: usize;
    wrapper: u8*;
    literal: u32;
    used: bool;
    declaration: bool;
    start: bool;
}

struct SyntaxEmissionProduction {
    name: u8*;
    alternative: usize;
    index: usize;
}

struct SyntaxEmissionHelper {
    name: u8*;
    source: void*;
    capture: bool;
}
