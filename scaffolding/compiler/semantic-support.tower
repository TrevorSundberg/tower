import tower;

// Semantic compiler over shared Foundation components.
// Temporary indexes and scratch allocations are scoped to one compilation.

export fn semantic_type_equal(a: FoundationType*, b: FoundationType*): bool {
    var step1 = a.scalar != b.scalar;
    var step2 = step1;
    var step3 = step2 == false;
    if step3 {
        var step4 = a.pointers != b.pointers;
        step2 = step4;
    }
    var step5 = step2 == false;
    if step5 {
        var step6 = a.record != b.record;
        step2 = step6;
    }
    if step2 {
        return false;
    }
    var step7 = a.pointers != 0;
    var step8 = step7;
    var step9 = step8 == false;
    if step9 {
        var step10 = a.scalar == SUSize();
        step8 = step10;
    }
    if step8 {
        var step11 = a.pointer_bytes == b.pointer_bytes;
        return step11;
    }
    return true;
}

export fn semantic_aggregate(t: FoundationType*): bool {
    var step1 = t.pointers == 0;
    var step2 = step1;
    if step2 {
        var step3 = t.scalar == SStruct();
        var step4 = step3;
        var step5 = step4 == false;
        if step5 {
            var step6 = t.scalar == SArray();
            step4 = step6;
        }
        step2 = step4;
    }
    return step2;
}

export fn semantic_integer(t: FoundationType*): bool {
    var step1 = t.pointers == 0;
    var step2 = step1;
    if step2 {
        var step3 = t.scalar == SI32();
        var step4 = step3;
        var step5 = step4 == false;
        if step5 {
            var step6 = t.scalar == SU32();
            step4 = step6;
        }
        var step7 = step4 == false;
        if step7 {
            var step8 = t.scalar == SU8();
            step4 = step8;
        }
        var step9 = step4 == false;
        if step9 {
            var step10 = t.scalar == SI64();
            step4 = step10;
        }
        var step11 = step4 == false;
        if step11 {
            var step12 = t.scalar == SU64();
            step4 = step12;
        }
        var step13 = step4 == false;
        if step13 {
            var step14 = t.scalar == SUSize();
            step4 = step14;
        }
        step2 = step4;
    }
    return step2;
}

export fn semantic_signed(t: FoundationType*): bool {
    var step1 = t.pointers == 0;
    var step2 = step1;
    if step2 {
        var step3 = t.scalar == SI32();
        var step4 = step3;
        var step5 = step4 == false;
        if step5 {
            var step6 = t.scalar == SI64();
            step4 = step6;
        }
        step2 = step4;
    }
    return step2;
}

export fn semantic_size(t: FoundationType*): usize {
    var step1 = t.pointers != 0;
    var step2 = step1;
    var step3 = step2 == false;
    if step3 {
        var step4 = t.scalar == SUSize();
        step2 = step4;
    }
    if step2 {
        var step5 = convert(usize, t.pointer_bytes);
        return step5;
    }
    var step6 = semantic_aggregate(t);
    if step6 {
        var step7 = sem_get(t.record);
        return step7.size;
    }
    var step8 = t.scalar == SVoid();
    if step8 {
        return 0;
    }
    var step9 = t.scalar == SBool();
    var step10 = step9;
    var step11 = step10 == false;
    if step11 {
        var step12 = t.scalar == SU8();
        step10 = step12;
    }
    if step10 {
        return 1;
    }
    var step13 = t.scalar == SI64();
    var step14 = step13;
    var step15 = step14 == false;
    if step15 {
        var step16 = t.scalar == SU64();
        step14 = step16;
    }
    if step14 {
        return 8;
    }
    return 4;
}

export fn semantic_alignment(t: FoundationType*): usize {
    var step1 = t.pointers != 0;
    var step2 = step1;
    var step3 = step2 == false;
    if step3 {
        var step4 = t.scalar == SUSize();
        step2 = step4;
    }
    if step2 {
        var step5 = convert(usize, t.pointer_bytes);
        return step5;
    }
    var step6 = semantic_aggregate(t);
    if step6 {
        var step7 = sem_get(t.record);
        return step7.alignment;
    }
    var step8 = semantic_size(t);
    var result: usize = step8;
    var step9 = result == 0;
    if step9 {
        return 1;
    }
    return result;
}

export fn semantic_width(t: FoundationType*): u32 {
    var step1 = semantic_size(t);
    var step2 = step1 * 8;
    var step3 = convert(u32, step2);
    return step3;
}

export fn semantic_mask(t: FoundationType*): u64 {
    var step1 = semantic_width(t);
    var width: u32 = step1;
    var result: u64 = 1;
    var i: u32 = 0;
    loop {
        var step2 = i < width;
        var step3 = step2 == false;
        if step3 {
            break;
        }
        result = result * 2;
        i = i + 1;
    }
    var step4 = result - 1;
    return step4;
}

fn sem_length(s: u8*): usize {
    var i: usize = 0;
    var step1 = s != null;
    if step1 {
        loop {
            var step2 = s[i] != 0;
            var step3 = step2 == false;
            if step3 {
                break;
            }
            i = i + 1;
        }
    }
    return i;
}

fn sem_equal(a: u8*, b: u8*): bool {
    var i: usize = 0;
    loop {
        var step1 = a[i] == b[i];
        var step2 = step1 == false;
        if step2 {
            break;
        }
        var step3 = a[i] == 0;
        if step3 {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn sem_allocate(c: SemanticContext*, count: usize): u8* {
    var step1 = alloc(u8, count);
    var result: u8* = step1;
    var step2 = result != null;
    sem_require(step2);
    sem_track(c, result);
    return result;
}

fn sem_text(c: SemanticContext*, s: u8*, count: usize): u8* {
    var step1 = count + 1;
    var step2 = sem_allocate(c, step1);
    var result: u8* = step2;
    var step3 = count != 0;
    if step3 {
        copy(result, s, count);
    }
    result[count] = 0;
    return result;
}

fn sem_cat(c: SemanticContext*, a: u8*, b: u8*): u8* {
    var step1 = sem_length(a);
    var x: usize = step1;
    var step2 = sem_length(b);
    var y: usize = step2;
    var step3 = x + y;
    var step4 = step3 + 1;
    var step5 = sem_allocate(c, step4);
    var result: u8* = step5;
    copy(result, a, x);
    copy(&result[x], b, y);
    var step6 = x + y;
    result[step6] = 0;
    return result;
}

fn sem_decimal(c: SemanticContext*, value: u64): u8* {
    var buffer: u8[21];
    var i: usize = 20;
    buffer[i] = 0;
    loop {
        var step1 = true == false;
        if step1 {
            break;
        }
        i = i - 1;
        var step2 = value % 10;
        var digit: u64 = step2;
        var step3 = digit + 48;
        var step4 = convert(u8, step3);
        buffer[i] = step4;
        var step5 = value / 10;
        value = step5;
        var step6 = value == 0;
        if step6 {
            break;
        }
    }
    var step7 = 20 - i;
    var step8 = sem_text(c, &buffer[i], step7);
    return step8;
}

fn sem_type_new(c: SemanticContext*, scalar: u32, pointers: u32, record: void*): FoundationType* {
    var step1 = sizeof(FoundationType);
    var step2 = sem_allocate(c, step1);
    var step3 = bits(FoundationType*, step2);
    var t: FoundationType* = step3;
    var step4 = sizeof(FoundationType);
    fill(t, 0, step4);
    t.scalar = scalar;
    t.pointers = pointers;
    t.record = record;
    t.pointer_bytes = c.program.pointer_bytes;
    return t;
}

fn sem_type_copy(c: SemanticContext*, t: FoundationType*): FoundationType* {
    var step1 = sem_type_new(c, 0, 0, null);
    var result: FoundationType* = step1;
    var step2 = sizeof(FoundationType);
    copy(result, t, step2);
    return result;
}

fn sem_set_type(out: FoundationType*, t: FoundationType*): void {
    var step1 = sizeof(FoundationType);
    copy(out, t, step1);
}

fn sem_type_name(c: SemanticContext*, t: FoundationType*): u8* {
    var name: u8* = "";
    var step1 = t.scalar == SArray();
    if step1 {
        var step2 = sem_get(t.record);
        var a: FoundationNode* = step2;
        var step3 = sem_type_name(c, &a.element);
        var step4 = sem_cat(c, step3, "[");
        var step5 = convert(u64, a.length);
        var step6 = sem_decimal(c, step5);
        var step7 = sem_cat(c, step4, step6);
        var step8 = sem_cat(c, step7, "]");
        name = step8;
    } else {
        var step9 = t.scalar == SStruct();
        if step9 {
            var step10 = sem_get(t.record);
            var step11 = sem_name(step10);
            name = step11;
        } else {
            var step12 = semantic_scalar_name(t.scalar);
            name = step12;
        }
    }
    var i: u32 = 0;
    loop {
        var step13 = i < t.pointers;
        var step14 = step13 == false;
        if step14 {
            break;
        }
        var step15 = sem_cat(c, name, "*");
        name = step15;
        i = i + 1;
    }
    return name;
}

fn sem_number(c: SemanticContext*, value: u64, t: FoundationType*): u8* {
    var step1 = semantic_mask(t);
    var mask: u64 = step1;
    var step2 = value & mask;
    value = step2;
    var step3 = mask / 2;
    var sign: u64 = step3;
    sign = sign + 1;
    var step4 = semantic_signed(t);
    var step5 = step4;
    if step5 {
        var step6 = value & sign;
        var step7 = step6 != 0;
        step5 = step7;
    }
    if step5 {
        var negative: u64 = 0;
        negative = negative - value;
        var step8 = negative & mask;
        var step9 = sem_decimal(c, step8);
        var step10 = sem_cat(c, "-", step9);
        return step10;
    }
    var step11 = sem_decimal(c, value);
    return step11;
}

fn sem_name(n: FoundationNode*): u8* {
    var step1 = n.name.data == null;
    if step1 {
        return "";
    }
    return n.name.data;
}

fn sem_set_name(n: FoundationNode*, name: u8*): void {
    var step1 = sem_length(name);
    var count: usize = step1;
    var step2 = count + 1;
    var step3 = vector_reserve(u8, &n.name, step2);
    sem_require(step3);
    var step4 = count + 1;
    copy(n.name.data, name, step4);
    n.name.length = count;
}

fn sem_push(v: vector(void*)*, n: void*): void {
    var step1 = vector_push(void*, v, n);
    sem_require(step1);
}

fn sem_list(c: SemanticContext*): vector(void*)* {
    var step1 = sizeof(vector(void*));
    var step2 = sem_allocate(c, step1);
    var step3 = bits(vector(void*)*, step2);
    var v: vector(void*)* = step3;
    var step4 = sizeof(vector(void*));
    fill(v, 0, step4);
    var step5 = bits(void*, v);
    var step6 = vector_push(void*, &c.lists, step5);
    sem_require(step6);
    return v;
}

fn sem_has(v: vector(void*)*, n: void*): bool {
    var i: usize = 0;
    loop {
        var step1 = i < v.length;
        var step2 = step1 == false;
        if step2 {
            break;
        }
        var step3 = v.data[i] == n;
        if step3 {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn sem_collect(c: SemanticContext*, n: void*, wanted: u8*): vector(void*)* {
    var step1 = sem_list(c);
    var result: vector(void*)* = step1;
    var step2 = sem_list(c);
    var pending: vector(void*)* = step2;
    var step3 = n != null;
    if step3 {
        sem_push(pending, n);
    }
    loop {
        var step4 = pending.length != 0;
        var step5 = step4 == false;
        if step5 {
            break;
        }
        pending.length = pending.length - 1;
        var at: void* = pending.data[pending.length];
        var step6 = sem_is(at, wanted);
        if step6 {
            sem_push(result, at);
        } else {
            var step7 = sem_child_count(at);
            var i: usize = step7;
            loop {
                var step8 = i != 0;
                var step9 = step8 == false;
                if step9 {
                    break;
                }
                i = i - 1;
                var step10 = sem_child(at, i);
                sem_push(pending, step10);
            }
        }
    }
    return result;
}

fn sem_tokens(c: SemanticContext*, n: void*): u8* {
    var buffer: vector(u8);
    var step1 = sizeof(vector(u8));
    fill(&buffer, 0, step1);
    var step2 = sem_list(c);
    var pending: vector(void*)* = step2;
    var step3 = n != null;
    if step3 {
        sem_push(pending, n);
    }
    loop {
        var step4 = pending.length != 0;
        var step5 = step4 == false;
        if step5 {
            break;
        }
        pending.length = pending.length - 1;
        var at: void* = pending.data[pending.length];
        var step6 = sem_match(at);
        var m: ParserMatchData* = step6;
        var step7 = m != null;
        var step8 = step7;
        if step8 {
            var step9 = sem_maximum();
            var step10 = m.rule == step9;
            step8 = step10;
        }
        if step8 {
            var i: usize = 0;
            loop {
                var step11 = i < m.label.length;
                var step12 = step11 == false;
                if step12 {
                    break;
                }
                var step13 = vector_push(u8, &buffer, m.label.data[i]);
                sem_require(step13);
                i = i + 1;
            }
        } else {
            var step14 = sem_child_count(at);
            var i: usize = step14;
            loop {
                var step15 = i != 0;
                var step16 = step15 == false;
                if step16 {
                    break;
                }
                i = i - 1;
                var step17 = sem_child(at, i);
                sem_push(pending, step17);
            }
        }
    }
    var step18 = sem_text(c, buffer.data, buffer.length);
    var result: u8* = step18;
    vector_dispose(u8, &buffer);
    return result;
}

fn sem_identifier(c: SemanticContext*, n: void*): u8* {
    var step1 = sem_tokens(c, n);
    var text: u8* = step1;
    sem_decode_identifier(text);
    return text;
}

fn sem_literal(c: SemanticContext*, n: void*): bool {
    var step1 = sem_tokens(c, n);
    var text: u8* = step1;
    var step2 = sem_equal(text, "true");
    var step3 = step2;
    var step4 = step3 == false;
    if step4 {
        var step5 = sem_equal(text, "false");
        step3 = step5;
    }
    var step6 = step3 == false;
    if step6 {
        var step7 = sem_equal(text, "null");
        step3 = step7;
    }
    var step8 = step3 == false;
    if step8 {
        var step9 = text[0] == 39;
        step3 = step9;
    }
    var step10 = step3 == false;
    if step10 {
        var step11 = text[0] == 34;
        step3 = step11;
    }
    var step12 = step3 == false;
    if step12 {
        var step13 = text[0] == 45;
        step3 = step13;
    }
    var step14 = step3 == false;
    if step14 {
        var step15 = text[0] >= 48;
        var step16 = step15;
        if step16 {
            var step17 = text[0] <= 57;
            step16 = step17;
        }
        step3 = step16;
    }
    return step3;
}

fn sem_unwrap(n: void*): void* {
    var step1 = sem_is(n, "Statement");
    var step2 = step1;
    if step2 {
        var step3 = sem_child_count(n);
        var step4 = step3 == 1;
        step2 = step4;
    }
    if step2 {
        var step5 = sem_child(n, 0);
        return step5;
    }
    return n;
}

fn sem_maximum(): usize {
    var n: usize = 0;
    var step1 = n - 1;
    return step1;
}

fn sem_hash(key: u8*): usize {
    var h: usize = 2166136261;
    var i: usize = 0;
    loop {
        var step1 = key[i] != 0;
        var step2 = step1 == false;
        if step2 {
            break;
        }
        var step3 = convert(usize, key[i]);
        var step4 = h ^ step3;
        h = step4;
        h = h * 16777619;
        i = i + 1;
    }
    return h;
}

fn sem_table(c: SemanticContext*): SemanticTable* {
    var step1 = sizeof(SemanticTable);
    var step2 = sem_allocate(c, step1);
    var step3 = bits(SemanticTable*, step2);
    var t: SemanticTable* = step3;
    var step4 = sizeof(SemanticTable);
    fill(t, 0, step4);
    return t;
}

fn sem_find(t: SemanticTable*, text: u8*, entity: void*): SemanticEntry* {
    var step1 = t.capacity == 0;
    if step1 {
        return null;
    }
    var step2 = bits(usize, entity);
    var h: usize = step2;
    var step3 = text != null;
    if step3 {
        var step4 = sem_hash(text);
        h = step4;
    } else {
        var step5 = h / 8;
        h = step5;
    }
    var step6 = h % t.capacity;
    var i: usize = step6;
    loop {
        var step7 = t.entries[i] != null;
        var step8 = step7 == false;
        if step8 {
            break;
        }
        var entry: SemanticEntry* = t.entries[i];
        var step9 = text != null;
        if step9 {
            var step10 = entry.text != null;
            var step11 = step10;
            if step11 {
                var step12 = sem_equal(entry.text, text);
                step11 = step12;
            }
            if step11 {
                return entry;
            }
        } else {
            var step13 = entry.text == null;
            var step14 = step13;
            if step14 {
                var step15 = entry.entity == entity;
                step14 = step15;
            }
            if step14 {
                return entry;
            }
        }
        var step16 = i + 1;
        var step17 = step16 % t.capacity;
        i = step17;
    }
    return null;
}

fn sem_insert(t: SemanticTable*, entry: SemanticEntry*): void {
    var step1 = bits(usize, entry.entity);
    var h: usize = step1;
    var step2 = entry.text != null;
    if step2 {
        var step3 = sem_hash(entry.text);
        h = step3;
    } else {
        var step4 = h / 8;
        h = step4;
    }
    var step5 = h % t.capacity;
    var i: usize = step5;
    loop {
        var step6 = t.entries[i] != null;
        var step7 = step6 == false;
        if step7 {
            break;
        }
        var step8 = i + 1;
        var step9 = step8 % t.capacity;
        i = step9;
    }
    t.entries[i] = entry;
}

fn sem_entry(c: SemanticContext*, t: SemanticTable*, text: u8*, entity: void*): SemanticEntry* {
    var step1 = sem_find(t, text, entity);
    var found: SemanticEntry* = step1;
    var step2 = found != null;
    if step2 {
        return found;
    }
    var step3 = t.count + 1;
    var step4 = step3 * 2;
    var step5 = step4 >= t.capacity;
    if step5 {
        var step6 = t.capacity * 2;
        var capacity: usize = step6;
        var step7 = capacity < 16;
        if step7 {
            capacity = 16;
        }
        var old: SemanticEntry** = t.entries;
        var count: usize = t.capacity;
        var step8 = sizeof(SemanticEntry*);
        var step9 = capacity * step8;
        var step10 = sem_allocate(c, step9);
        var step11 = bits(SemanticEntry**, step10);
        t.entries = step11;
        var step12 = sizeof(SemanticEntry*);
        var step13 = capacity * step12;
        fill(t.entries, 0, step13);
        t.capacity = capacity;
        var i: usize = 0;
        loop {
            var step14 = i < count;
            var step15 = step14 == false;
            if step15 {
                break;
            }
            var step16 = old[i] != null;
            if step16 {
                sem_insert(t, old[i]);
            }
            i = i + 1;
        }
    }
    var step17 = sizeof(SemanticEntry);
    var step18 = sem_allocate(c, step17);
    var step19 = bits(SemanticEntry*, step18);
    var result: SemanticEntry* = step19;
    var step20 = sizeof(SemanticEntry);
    fill(result, 0, step20);
    result.text = text;
    result.entity = entity;
    sem_insert(t, result);
    t.count = t.count + 1;
    return result;
}

fn sem_lookup_table(t: SemanticTable*, text: u8*): void* {
    var step1 = sem_find(t, text, null);
    var found: SemanticEntry* = step1;
    var step2 = found == null;
    if step2 {
        return null;
    }
    return found.value;
}

fn sem_put(c: SemanticContext*, t: SemanticTable*, text: u8*, value: void*): bool {
    var step1 = sem_entry(c, t, text, null);
    var found: SemanticEntry* = step1;
    var step2 = found.value != null;
    if step2 {
        return false;
    }
    found.value = value;
    return true;
}

fn sem_state(c: SemanticContext*, t: SemanticTable*, n: void*): SemanticEntry* {
    var step1 = sem_entry(c, t, null, n);
    return step1;
}

fn sem_source_base(c: SemanticContext*, n: void*): usize {
    loop {
        var step1 = n != null;
        var step2 = step1 == false;
        if step2 {
            break;
        }
        var step3 = sem_find(c.source_bases, null, n);
        var found: SemanticEntry* = step3;
        var step4 = found != null;
        if step4 {
            return found.number;
        }
        var step5 = sem_parent(n);
        n = step5;
    }
    return 0;
}

fn sem_offset(c: SemanticContext*, n: void*): usize {
    var step1 = sem_match(n);
    var m: ParserMatchData* = step1;
    var step2 = sem_source_base(c, n);
    var at: usize = step2;
    var step3 = m != null;
    if step3 {
        at = at + m.start;
    }
    return at;
}

fn sem_ok(c: SemanticContext*): bool {
    var step1 = c.program.error.length == 0;
    return step1;
}

fn sem_fail(c: SemanticContext*, n: void*, text: u8*): void {
    var step1 = sem_ok(c);
    var step2 = step1 == false;
    if step2 {
        return;
    }
    var step3 = sem_offset(c, n);
    c.program.error_offset = step3;
    var step4 = sem_list(c);
    var seen: vector(void*)* = step4;
    var step5 = generic_origin(c.generics, n);
    var use: void* = step5;
    loop {
        var step6 = use != null;
        var step7 = step6;
        if step7 {
            var step8 = seen.length < 8;
            step7 = step8;
        }
        if step7 {
            var step9 = sem_has(seen, use);
            var step10 = step9 == false;
            step7 = step10;
        }
        var step11 = step7 == false;
        if step11 {
            break;
        }
        sem_push(seen, use);
        var step12 = sem_offset(c, use);
        var at: usize = step12;
        var line: u64 = 1;
        var column: u64 = 1;
        var i: usize = 0;
        loop {
            var step13 = i < at;
            var step14 = step13;
            if step14 {
                var step15 = c.source[i] != 0;
                step14 = step15;
            }
            var step16 = step14 == false;
            if step16 {
                break;
            }
            var step17 = c.source[i] == 10;
            if step17 {
                line = line + 1;
                column = 1;
            } else {
                column = column + 1;
            }
            i = i + 1;
        }
        var step18 = sem_tokens(c, use);
        var step19 = sem_cat(c, "\nInstantiated by ", step18);
        var step20 = sem_cat(c, text, step19);
        text = step20;
        var step21 = sem_decimal(c, line);
        var step22 = sem_cat(c, " at line ", step21);
        var step23 = sem_cat(c, text, step22);
        text = step23;
        var step24 = sem_decimal(c, column);
        var step25 = sem_cat(c, step24, ".");
        var step26 = sem_cat(c, ", column ", step25);
        var step27 = sem_cat(c, text, step26);
        text = step27;
        var step28 = generic_origin(c.generics, use);
        use = step28;
    }
    var step29 = sem_length(text);
    var count: usize = step29;
    var step30 = count + 1;
    var step31 = vector_reserve(u8, &c.program.error, step30);
    sem_require(step31);
    var step32 = count + 1;
    copy(c.program.error.data, text, step32);
    c.program.error.length = count;
}

fn sem_generic_ok(c: SemanticContext*, n: void*): bool {
    var step1 = generic_error(c.generics);
    var error: u8* = step1;
    var step2 = error != null;
    if step2 {
        sem_fail(c, n, error);
    }
    var step3 = sem_ok(c);
    return step3;
}

fn sem_shape(c: SemanticContext*, n: void*, capture: u8*): bool {
    var step1 = n == null;
    if step1 {
        sem_fail(c, n, "Missing foundation tree");
        return false;
    }
    var step2 = sem_member(n, capture);
    var step3 = step2 == null;
    if step3 {
        var step4 = sem_label(n);
        var step5 = sem_cat(c, "Malformed ", step4);
        var step6 = sem_cat(c, step5, " tree: missing capture '");
        var step7 = sem_cat(c, capture, "'");
        var step8 = sem_cat(c, step6, step7);
        sem_fail(c, n, step8);
        return false;
    }
    return true;
}

fn sem_node(c: SemanticContext*, n: void*, kind: u32): FoundationNode* {
    var step1 = sem_get(n);
    var step2 = step1 == null;
    var fresh: bool = step2;
    var step3 = sem_attach(n, kind);
    var result: FoundationNode* = step3;
    var step4 = sem_offset(c, n);
    result.start = step4;
    result.end = result.start;
    var step5 = sem_match(n);
    var m: ParserMatchData* = step5;
    var step6 = m != null;
    if step6 {
        result.end = result.end + m.length;
    }
    if fresh {
        c.count = c.count + 1;
        var step7 = c.count > 65536;
        if step7 {
            sem_fail(c, n, "Foundation node limit is 65,536");
        }
    }
    return result;
}
