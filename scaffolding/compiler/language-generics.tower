import tower;
import 'completion';
import 'language-query';
import 'semantic-generic-info';
import 'semantic-context';
import 'semantic-support';
import 'semantic-types';
import 'format-types';
import 'foundation-types';
import 'frontend-compilation';
import 'inspection-policy';
import 'source-comments';
import '../library/vector';

extern fn format_dependent_summary(result: FormatResult*, entity: void*, match_kind: void*): void;

fn language_generic_kind(info: GenericInfo*): u8* {
    var generic_check1 = info.kind == GenericInfoKind.Function;
    if generic_check1 {
        return "function template";
    }
    var generic_check2 = info.kind == GenericInfoKind.Constructor;
    if generic_check2 {
        return "type function";
    }
    var generic_check3 = info.kind == GenericInfoKind.TypeParameter;
    if generic_check3 {
        return "type parameter";
    }
    var generic_check4 = info.kind == GenericInfoKind.ConstantParameter;
    if generic_check4 {
        return "compile-time parameter";
    }
    var generic_check5 = info.kind == GenericInfoKind.Parameter;
    if generic_check5 {
        return "parameter";
    }
    var generic_check6 = info.kind == GenericInfoKind.Structure;
    if generic_check6 {
        return "struct type";
    }
    var generic_check7 = info.kind == GenericInfoKind.Field;
    if generic_check7 {
        return "field";
    }
    var generic_check8 = info.kind == GenericInfoKind.Variable;
    if generic_check8 {
        return "local variable";
    }
    var generic_check9 = info.kind == GenericInfoKind.TypeExpression;
    if generic_check9 {
        return "type";
    }
    return "";
}

fn language_generic_description(info: GenericInfo*): u8* {
    var generic_check10 = info.kind == GenericInfoKind.Function;
    if generic_check10 {
        return "Reusable code that accepts types as inputs. Each set of type arguments is checked separately; the remaining parameters receive values when the function runs.";
    }
    var generic_check11 = info.kind == GenericInfoKind.Constructor;
    if generic_check11 {
        return "Runs during compilation to produce a type. Its arguments choose the types and sizes used in the result.";
    }
    var generic_check12 = info.kind == GenericInfoKind.TypeParameter;
    if generic_check12 {
        return "A type you supply when calling this function. Uses of this name refer to that supplied type.";
    }
    var generic_check13 = info.kind == GenericInfoKind.ConstantParameter;
    if generic_check13 {
        return "A value supplied during compilation. It can determine the shape or size of the resulting type.";
    }
    var generic_check14 = info.kind == GenericInfoKind.Parameter;
    if generic_check14 {
        return "A named input to the function. Each call supplies a value; its type can depend on the type arguments.";
    }
    var generic_check15 = info.kind == GenericInfoKind.Structure;
    if generic_check15 {
        return "Groups named fields into a type. The field types and memory layout are determined for each set of arguments.";
    }
    var generic_check16 = info.kind == GenericInfoKind.Field;
    if generic_check16 {
        return "A named part of this struct. Each value of the struct has its own copy of the field.";
    }
    var generic_check17 = info.kind == GenericInfoKind.Variable;
    if generic_check17 {
        return "A named place to store a value. You can read it or change it later by assigning a new value.";
    }
    var generic_check18 = info.kind == GenericInfoKind.Return;
    if generic_check18 {
        return "Ends this function and gives its result back to the code that called it.";
    }
    if info.dependent {
        return "Describes a type using this function's parameters. Supplying the arguments determines the concrete type.";
    }
    return "Describes which values can be stored here.";
}

fn language_generic_present(q: CompletionQuery*, node: void*, candidate: LanguageCandidate*): void {
    var info = generic_info(node, q.generic_info);
    candidate.generic = info;
    candidate.subject = info.declaration;
    candidate.description = language_generic_description(info);
    candidate.structural = false;
}

fn language_generic_space(text: u8*, first: usize, last: usize): bool {
    while first < last {
        var byte = text[first];
        var space = byte == TriviaSpace();
        var generic_check19 = byte == TriviaTab();
        if generic_check19 {
            space = true;
        }
        var generic_check20 = byte == TriviaNewline();
        if generic_check20 {
            space = true;
        }
        var generic_check21 = byte == TriviaCarriageReturn();
        if generic_check21 {
            space = true;
        }
        if space {} else {
            return false;
        }
        first = first + 1;
    }
    return true;
}

// Reuse captured lexer trivia and Foundation comment normalization. No browser
// source parsing and no need to instantiate a template just to read its docs.
fn language_generic_documentation(q: CompletionQuery*, declaration: void*): void {
    var span = sem_match(declaration);
    var generic_check22 = span == null;
    if generic_check22 {
        return;
    }
    var base = sem_source_base(&q.context, declaration);
    var m: usize = 0;
    while m < q.comment_modules.length {
        var generic_check23 = q.comment_bases.data[m] == base;
        if generic_check23 {
            var module = q.comment_modules.data[m];
            var count: usize = 0;
            var comments = frontend_module_comments(module, &count);
            var total = count;
            var source = frontend_module_source(module);
            var end = span.start;
            var first = count;
            while first != 0 {
                var before = first - 2;
                var after = before + 1;
                var last = comments[after];
                var generic_check24 = last <= end;
                if generic_check24 {
                    if language_generic_space(source, last, end) {} else {
                        break;
                    }
                    end = comments[before];
                    count = first;
                }
                first = before;
            }
            var generic_check25 = end != span.start;
            if generic_check25 {
                // Find the first attached comment after skipping later trivia.
                first = 0;
                while first < count {
                    var generic_check26 = comments[first] == end;
                    if generic_check26 {
                        break;
                    }
                    first = first + 2;
                }
                var docs: FoundationNode;
                fill(&docs, 0, sizeof(FoundationNode));
                while first < total {
                    var after = first + 1;
                    var last = comments[after];
                    var generic_check27 = last > span.start;
                    if generic_check27 {
                        break;
                    }
                    source_comment_append(&docs, source, comments[first], last);
                    first = first + 2;
                }
                language_documentation(q, &docs);
                vector_dispose(u8, &docs.comments);
            }
            return;
        }
        m = m + 1;
    }
}

fn language_generic_details(q: CompletionQuery*, info: GenericInfo*): void {
    var annotation = info.annotation;
    var generic_check28 = annotation != null;
    if generic_check28 {
        var formatted: FormatResult;
        fill(&formatted, 0, sizeof(FormatResult));
        format_dependent_summary(&formatted, annotation, parser_match_get_type());
        var formatted_ok = formatted.failed == false;
        if formatted_ok {
            formatted_ok = formatted.text.length != 0;
        }
        if formatted_ok {
            completion_text(&q.output, ",\"type\":");
            language_quote(q, formatted.text.data, formatted.text.length);
        }
        format_dispose(&formatted);
    }
    if info.dependent {
        language_string(q, "resolution", "Depends on the arguments supplied to this function.");
    }
    var generic_check29 = info.resolved != null;
    if generic_check29 {
        var resolved = sem_get(info.resolved);
        language_number(q, "size", semantic_size(&resolved.type));
        language_number(q, "alignment", semantic_alignment(&resolved.type));
    }
    language_number(q, "binding", entity_id(info.declaration));
    language_declaration_location(q, info.declaration);
    language_generic_documentation(q, info.declaration);
}
