import tower;

// Private component slots and lifecycle IDs, not Foundation operation numbers.
var CompilerParserRule: u32 = 0;
var CompilerParserReference: u32 = 1;
var CompilerParserString: u32 = 2;
var CompilerParserRange: u32 = 3;
var CompilerParserMatch: u32 = 4;
var CompilerSyntax: u32 = 5;
var CompilerFoundation: u32 = 6;
var CompilerSyntaxOrigin: u32 = 7;
var CompilerSyntaxExpansion: u32 = 8;
var CompilerComponentCount: u32 = 9;

fn compiler_foundation_lifecycle(): usize {
    var last: usize = 0;
    last--;
    return last;
}

fn compiler_syntax_lifecycle(): usize {
    var value = compiler_foundation_lifecycle() -1;
    return value;
}

fn compiler_parser_lifecycle(kind: u32): usize {
    var value = compiler_syntax_lifecycle() -1;
    value = value - convert(usize, kind);
    return value;
}

fn compiler_origin_lifecycle(): usize {
    var value = compiler_parser_lifecycle(CompilerParserMatch) -1;
    return value;
}

fn compiler_expansion_lifecycle(): usize {
    var value = compiler_origin_lifecycle() -1;
    return value;
}
