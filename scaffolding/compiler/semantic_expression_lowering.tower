import tower;
import foundation_tags;
import foundation_types;
import semantic_context;
import semantic_control;
import semantic_definitions;
import semantic_expressions;
import semantic_support;
import semantic_types;
import .library.vector;
import semantic_lowering_work;
import semantic_aggregates;
import semantic_known_bindings;
import semantic_evaluation;
import .library.float_bits;

// Expressions are normalized on the shared ECS entities into ordinary bound
// locals, calls, loads/stores and control flow. No backend sees surface tags.
fn sem_lift_append(block: void*, n: void*): void {
    var owner = sem_get(block);
    var value = sem_get(n);
    if value != null && value.kind == KLabel {
        // Expression lifting can insert several statements before a label.
        // Keep the derived jump position aligned with the canonical block.
        value.body = block;
        value.index = owner.items.length;
    }
    sem_push(&owner.items, n);
}

fn sem_lift_result(source: void*, result: void*): void* {
    // Keep the source entity useful to reflection after normalization. Its
    // syntax children/provenance remain; its semantic value is the bound result.
    var value = sem_get(source);
    var read = sem_get(result);
    value.kind = read.kind;
    value.binding = read.binding;
    value.constant = read.constant;
    value.bits = read.bits;
    value.op = read.op;
    value.left = null;
    value.right = null;
    value.value = null;
    value.target = null;
    sem_set_type(&value.type, &read.type);
    return result;
}

fn sem_lift_snapshot(c: SemanticContext*, block: void*, n: void*): void* {
    var value = sem_get(n);
    if value.constant {
        return n;
    }
    if value.kind == KString {
        return n;
    }
    var local = sem_control_local(c, block, n);
    return sem_control_read(c, block, local);
}

fn sem_lift_binary(c: SemanticContext*, block: void*, op: u32, left: void*, right: void*, type: FoundationType*): void* {
    var entity = sem_control_node(c, block, KBinary);
    var value = sem_get(entity);
    value.op = op;
    value.left = left;
    value.right = right;
    sem_set_type(&value.type, type);
    return sem_lift_snapshot(c, block, entity);
}

fn sem_lift_store(c: SemanticContext*, block: void*, target: void*, value: void*): void {
    var entity = sem_control_node(c, block, KAssign);
    var assignment = sem_get(entity);
    assignment.target = target;
    assignment.value = value;
    sem_lift_append(block, entity);
}

fn sem_lift_place(c: SemanticContext*, block: void*, n: void*): void* {
    var value = sem_get(n);
    if semantic_aggregate(&value.type) && value.kind != KOperand && value.kind != KLoad
        && value.kind != KField && value.kind != KIndex {
        return sem_lift_value(c, block, n);
    }
    if value.kind == KLoad {
        value.value = sem_lift_value(c, block, value.value);
        return n;
    }
    var field = value.kind == KField;
    var index = value.kind == KIndex;
    var projection = field;
    if index {
        projection = true;
    }
    if projection {
        if value.indirect {
            value.left = sem_lift_value(c, block, value.left);
        }
        else {
            value.left = sem_lift_place(c, block, value.left);
            var base = sem_get(value.left);
            if base.kind == KLoad {
                // Foundation field paths already dereference a struct pointer.
                // An array dereference needs an explicit element pointer so its
                // indexed spelling reconstructs the same element type/stride.
                value.left = base.value;
                if index {
                    var pointer = sem_control_node(c, block, KBits);
                    var cast = sem_get(pointer);
                    cast.value = value.left;
                    sem_set_type(&cast.type, &value.type);
                    cast.type.pointers++;
                    value.left = sem_lift_snapshot(c, block, pointer);
                }
                value.indirect = true;
            }
        }
        if index {
            value.right = sem_lift_value(c, block, value.right);
        }
    }
    return n;
}

fn sem_lift_target(c: SemanticContext*, block: void*, n: void*): void* {
    n = sem_lift_place(c, block, n);
    var source = sem_get(n);
    if source.kind == KLoad {
        return n;
    }
    var address = sem_control_node(c, block, KAddress);
    var pointer = sem_get(address);
    pointer.value = n;
    sem_set_type(&pointer.type, &source.type);
    pointer.type.pointers++;
    var saved = sem_lift_snapshot(c, block, address);
    var target = sem_control_node(c, block, KLoad);
    var load = sem_get(target);
    load.value = saved;
    sem_set_type(&load.type, &source.type);
    return target;
}

// Total shifts: counts are masked by (width - 1), signed right shift extends
// the sign, left shift wraps. This portable expansion uses Foundation integers;
// LLVM's existing optimization may recognize it, but no machine-code claim is made.
fn sem_lift_shift(c: SemanticContext*, block: void*, left: void*, right: void*, operation: u32): void* {
    var input = sem_get(left);
    var backwards = operation != SurfaceShiftLeft;
    if operation == SurfaceShiftUnsigned && semantic_signed(&input.type) {
        var original = &input.type;
        var type = sem_type_copy(c, original);
        type.scalar = semantic_unsigned_scalar(original.scalar);
        var converted = sem_control_node(c, block, KBits);
        sem_get(converted).value = left;
        sem_set_type(&sem_get(converted).type, type);
        var shifted = sem_lift_shift(c, block, sem_lift_snapshot(c, block, converted), right, SurfaceShiftRight);
        var result = sem_control_node(c, block, KBits);
        sem_get(result).value = shifted;
        sem_set_type(&sem_get(result).type, original);
        return sem_lift_snapshot(c, block, result);
    }
    var count_type = sem_get(right);
    var width = semantic_size(&input.type) *8;
    var mask = convert(u64, width) -1;
    var count_mask = sem_surface_constant(c, block, &count_type.type, mask);
    var count = sem_lift_binary(c, block, OAnd, right, count_mask, &count_type.type);
    var remaining = sem_control_local(c, block, count);
    var result = sem_control_local(c, block, left);
    var loop_node = sem_control_node(c, block, KLoop);
    var loop_value = sem_get(loop_node);
    var body = sem_control_node(c, loop_node, KBlock);
    loop_value.body = body;
    sem_lift_append(block, loop_node);
    var zero = sem_surface_constant(c, body, &count_type.type, 0);
    var current_count = sem_control_read(c, body, remaining);
    var boolean = sem_type_new(c, SBool, 0, null);
    var finished = sem_lift_binary(c, body, OEq, current_count, zero, boolean);
    var stop = sem_control_node(c, body, KBlock);
    sem_lift_append(stop, sem_control_node(c, stop, KBreak));
    sem_control_branch(c, body, finished, stop);
    var current = sem_control_read(c, body, result);
    var two = sem_surface_constant(c, body, &input.type, 2);
    var op = OMul;
    if backwards {
        op = ODiv;
    }
    var next = sem_lift_binary(c, body, op, current, two, &input.type);
    if backwards {
        if semantic_signed(&input.type) {
            // Truncating division differs from arithmetic shift for negative odd values.
            var one = sem_surface_constant(c, body, &input.type, 1);
            var low = sem_lift_binary(c, body, OAnd, current, one, &input.type);
            var negative = sem_lift_binary(c, body, OLt, current,
            sem_surface_constant(c, body, &input.type, 0), boolean);
            var adjusted = sem_control_local(c, body, next);
            var correction = sem_control_node(c, body, KBlock);
            var rounded = sem_lift_binary(c, correction, OSub, next, low, &input.type);
            sem_lift_store(c, correction, sem_control_read(c, correction, adjusted), rounded);
            sem_control_branch(c, body, negative, correction);
            next = sem_control_read(c, body, adjusted);
        }
    }
    sem_lift_store(c, body, sem_control_read(c, body, result), next);
    var one_count = sem_surface_constant(c, body, &count_type.type, 1);
    var next_count = sem_lift_binary(c, body, OSub, current_count, one_count, &count_type.type);
    sem_lift_store(c, body, sem_control_read(c, body, remaining), next_count);
    return sem_control_read(c, block, result);
}

fn sem_lift_nonnull(c: SemanticContext*, block: void*, value: void*): void* {
    var zero = sem_surface_constant(c, block, &sem_get(value).type, 0);
    return sem_lift_binary(c, block, ONe, value, zero, sem_type_new(c, SBool, 0, null));
}

// Follow a null-conditional chain inside nested success blocks. Index operands
// and later receivers are evaluated only after the preceding guard succeeds.
// Intermediate struct fields remain places, so no aggregate copy is introduced.
fn sem_lift_guarded_path(c: SemanticContext*, selected: void**, n: void*): void* {
    var value = sem_get(n);
    if !sem_surface_optional(value) {
        return sem_lift_value(c, *selected, n);
    }
    var indexed = value.kind == SurfaceNullIndex;
    var left = sem_lift_guarded_path(c, selected, value.left);
    if sem_get(left).type.pointers != 0 {
        left = sem_lift_value(c, *selected, left);
    }
    if value.op != 0 {
        var present = sem_lift_nonnull(c, *selected, left);
        var yes = sem_control_node(c, *selected, KBlock);
        sem_control_branch(c, *selected, present, yes);
        *selected = yes;
    }
    value.kind = KField;
    if indexed {
        value.kind = KIndex;
    }
    value.op = 0;
    value.left = left;
    if indexed {
        value.right = sem_lift_value(c, *selected, value.right);
    }
    var projection = sem_control_node(c, *selected, value.kind);
    var data = sem_get(projection);
    data.left = value.left;
    data.right = value.right;
    data.binding = value.binding;
    data.indirect = value.indirect;
    data.byte_offset = value.byte_offset;
    sem_set_name(data, sem_name(value));
    sem_set_type(&data.type, &value.type);
    return projection;
}

fn sem_lift_coalesce(c: SemanticContext*, block: void*, left: void*, right: void*, target: void*): void* {
    var type = &sem_get(left).type;
    var result = sem_control_local(c, block, sem_surface_constant(c, block, type, 0));
    var boolean = sem_type_new(c, SBool, 0, null);
    var found = sem_control_local(c, block, sem_surface_constant(c, block, boolean, 0));
    var selected = block;
    var first = sem_lift_guarded_path(c, &selected, left);
    first = sem_lift_value(c, selected, first);
    if type.pointers != 0 || type.scalar == SFunction {
        var present = sem_lift_nonnull(c, selected, first);
        var yes = sem_control_node(c, selected, KBlock);
        sem_control_branch(c, selected, present, yes);
        selected = yes;
    }
    sem_lift_store(c, selected, sem_control_read(c, selected, result), first);
    sem_lift_store(c, selected, sem_control_read(c, selected, found), sem_surface_constant(c, selected, boolean, 1));
    var missing = sem_lift_binary(c, block, OEq, sem_control_read(c, block, found),
    sem_surface_constant(c, block, boolean, 0), boolean);
    var fallback = sem_control_node(c, block, KBlock);
    sem_control_branch(c, block, missing, fallback);
    var second = sem_lift_value(c, fallback, right);
    sem_lift_store(c, fallback, sem_control_read(c, fallback, result), second);
    if target != null {
        sem_lift_store(c, fallback, target, second);
    }
    return sem_control_read(c, block, result);
}

fn sem_lift_logical(c: SemanticContext*, block: void*, left: void*, right: void*, operation: u32, target: void*): void* {
    var first = sem_lift_value(c, block, left);
    var result = sem_control_local(c, block, first);
    var yes = sem_control_node(c, block, KBlock);
    var no = sem_control_branch(c, block, first, yes);
    var chosen = yes;
    if operation == SurfaceOr {
        chosen = no;
    }
    var second = sem_lift_value(c, chosen, right);
    sem_lift_store(c, chosen, sem_control_read(c, chosen, result), second);
    if target != null {
        sem_lift_store(c, chosen, target, second);
    }
    return sem_control_read(c, block, result);
}

// The ordinary fill operation defines byte initialization, including padding.
// Capture a destination once; sizeof consumes its explicit target layout.
fn sem_lift_default(c: SemanticContext*, block: void*, target: void*): void* {
    target = sem_lift_target(c, block, target);
    var type = &sem_get(target).type;
    var count = sem_control_node(c, block, KSizeOf);
    sem_set_type(&sem_get(count).element, type);
    sem_set_type(&sem_get(count).type, sem_type_new(c, SUSize, 0, null));
    var result = sem_control_node(c, block, KFill);
    var value = sem_get(result);
    value.left = sem_get(target).value;
    value.right = sem_surface_constant(c, result, sem_type_new(c, SU8, 0, null), 0);
    value.value = sem_lift_value(c, block, count);
    sem_set_type(&value.type, sem_type_new(c, SVoid, 0, null));
    sem_lift_append(block, result);
    return result;
}

// Lower construction into the existing destination. Field stores stay ordered;
// explicit ..default establishes zero storage before those writes. A field's
// source node becomes its ordinary bound assignment, retaining provenance.
fn sem_lift_initialization(c: SemanticContext*, block: void*, target: void*, n: void*): void {
    var initial = sem_get(n);
    if initial.kind != SurfaceDefault && initial.kind != SurfaceInitializer {
        target = sem_lift_target(c, block, target);
        var source = sem_lift_value(c, block, n);
        sem_aggregate_copy(c, block, target, source);
        return;
    }
    if initial.kind == SurfaceDefault {
        sem_lift_default(c, block, target);
    } else {
        target = sem_lift_target(c, block, target);
        if initial.op != 0 { sem_lift_default(c, block, target); }
        foreach(var entry in &initial.items) {
            var field = sem_get(entry);
            var place = sem_control_node(c, entry, KField);
            var location = sem_get(place);
            location.left = sem_get(target).value;
            location.indirect = true;
            location.binding = field.binding;
            location.byte_offset = sem_get(field.binding).byte_offset;
            sem_set_name(location, sem_name(field));
            sem_set_type(&location.type, &field.type);
            if semantic_aggregate(&field.type) {
                sem_lift_initialization(c, block, place, field.value);
                field.kind = KBlock;
                field.value = null;
                sem_set_type(&field.type, sem_type_new(c, SVoid, 0, null));
            } else {
                field.target = sem_lift_target(c, block, place);
                field.value = sem_lift_value(c, block, field.value);
                field.binding = null;
                sem_set_name(field, "");
                sem_set_type(&field.type, sem_type_new(c, SVoid, 0, null));
                sem_lift_append(block, entry);
            }
        }
    }
    initial.items.length = 0;
    initial.op = 0;
    initial.kind = KBlock;
    sem_set_type(&initial.type, sem_type_new(c, SVoid, 0, null));
}

fn sem_lift_value(c: SemanticContext*, block: void*, n: void*): void* {
    var absent = n == null;
    if absent {
        return null;
    }
    var value = sem_get(n);
    if value.constant {
        return n;
    }
    // A nested staged enum exposes a conversion around its pending integer
    // literal. The producer owns that conversion, including its component lease.
    // Lower a consumer-owned projection while sharing the immutable/readiness-
    // tracked literal; never rewrite the producer from another worker.
    if value.kind == KConvert && sem_evaluation_dependency(c, n) != null {
        var projection = sem_control_node(c, block, KConvert);
        var local = sem_get(projection);
        sem_set_type(&local.type, &value.type);
        local.value = value.value;
        n = projection;
        value = local;
    }
    if semantic_aggregate(&value.type) {
        return sem_aggregate_value(c, block, n);
    }
    if value.kind == SurfaceInitializerStore {
        sem_lift_initialization(c, block, value.target, value.value);
        value.kind = KBlock;
        value.target = null;
        value.value = null;
        return n;
    }
    if value.kind == SurfaceDefaultStore {
        var result = sem_lift_default(c, block, value.target);
        value.kind = KBlock;
        value.target = null;
        value.value = null;
        return result;
    }
    if sem_surface_optional(value) {
        var absent = sem_surface_constant(c, block, &value.type, 0);
        return sem_lift_result(n, sem_lift_coalesce(c, block, n, absent, null));
    }
    if value.kind == SurfaceCoalesce {
        return sem_lift_result(n, sem_lift_coalesce(c, block, value.left, value.right, null));
    }
    if value.kind == SurfaceComma {
        sem_lift_value(c, block, value.left);
        return sem_lift_result(n, sem_lift_value(c, block, value.right));
    }
    var select = value.kind == SurfaceSelect;
    var logical_and = value.kind == SurfaceAnd;
    var logical_or = value.kind == SurfaceOr;
    if logical_and || logical_or {
        return sem_lift_result(n, sem_lift_logical(c, block, value.left, value.right, value.kind, null));
    }
    if select {
        var condition = sem_lift_value(c, block, value.value);
        if value.type.scalar == SVoid && value.type.pointers == 0 {
            var yes = sem_control_node(c, block, KBlock);
            var no = sem_control_branch(c, block, condition, yes);
            sem_lift_value(c, yes, value.left);
            sem_lift_value(c, no, value.right);
            value.kind = KBlock;
            value.left = null;
            value.right = null;
            value.value = null;
            return n;
        }
        var initial = sem_surface_constant(c, block, &value.type, 0);
        var result = sem_control_local(c, block, initial);
        var yes = sem_control_node(c, block, KBlock);
        var no = sem_control_branch(c, block, condition, yes);
        var left = sem_lift_value(c, yes, value.left);
        sem_lift_store(c, yes, sem_control_read(c, yes, result), left);
        var right = sem_lift_value(c, no, value.right);
        sem_lift_store(c, no, sem_control_read(c, no, result), right);
        return sem_lift_result(n, sem_control_read(c, block, result));
    }
    var assign = value.kind == SurfaceAssign;
    var modify = value.kind == SurfaceModify;
    var writes = assign;
    if modify {
        writes = true;
    }
    if writes {
        var target = sem_lift_target(c, block, value.target);
        var previous: void* = null;
        var compound = value.op != SurfaceSet;
        if compound {
            previous = sem_lift_snapshot(c, block, target);
        }
        if value.op == SurfaceCoalesce {
            return sem_lift_result(n, sem_lift_coalesce(c, block, previous, value.value, target));
        }
        if value.op == SurfaceAnd || value.op == SurfaceOr {
            return sem_lift_result(n, sem_lift_logical(c, block, previous, value.value, value.op, target));
        }
        var next: void* = null;
        if modify {
            var type = &value.type;
            if type.pointers != 0 {
                type = sem_type_new(c, SUSize, 0, null);
            }
            next = sem_surface_constant(c, block, type, 1);
              if semantic_float(type) {
                  sem_get(next).bits = tower_float_from_integer(1, Float32Width, false, semantic_width(type));
              }
        } else {
            next = sem_lift_value(c, block, value.value);
        }
        if compound {
            var shift = value.op >= SurfaceShiftLeft && value.op <= SurfaceShiftUnsigned;
            if shift {
                next = sem_lift_shift(c, block, previous, next, value.op);
            }
            else {
                next = sem_lift_binary(c, block, value.op, previous, next, &value.type);
            }
        }
        sem_lift_store(c, block, target, next);
        if modify {
            if value.indirect {
                return sem_lift_result(n, previous);
            }
        }
        return sem_lift_result(n, next);
    }
    var shift = value.kind == SurfaceShift;
    var threeway = value.kind == SurfaceCompare;
    var binary = value.kind == KBinary;
    var pair = binary;
    if shift {
        pair = true;
    }
    if threeway {
        pair = true;
    }
    if pair {
        value.left = sem_lift_value(c, block, value.left);
        value.right = sem_lift_value(c, block, value.right);
        if shift {
            return sem_lift_result(n, sem_lift_shift(c, block, value.left, value.right, value.op));
        }
        if threeway {
            var boolean = sem_type_new(c, SBool, 0, null);
            var less = sem_lift_binary(c, block, OLt, value.left, value.right, boolean);
            var more = sem_lift_binary(c, block, OGt, value.left, value.right, boolean);
            var low = sem_control_node(c, block, KConvert);
            var a = sem_get(low);
            a.value = less;
            sem_set_type(&a.type, &value.type);
            low = sem_lift_snapshot(c, block, low);
            var high = sem_control_node(c, block, KConvert);
            var b = sem_get(high);
            b.value = more;
            sem_set_type(&b.type, &value.type);
            high = sem_lift_snapshot(c, block, high);
            return sem_lift_result(n, sem_lift_binary(c, block, OSub, high, low, &value.type));
        }
        return sem_lift_snapshot(c, block, n);
    }
    if value.kind == KAddress {
        value.value = sem_lift_place(c, block, value.value);
        var location = sem_get(value.value);
        if location.kind == KLoad {
            return location.value;
        }
    }
    else {
        var location = value.kind == KField;
        location ||= value.kind == KIndex;
        if location {
            sem_lift_place(c, block, n);
        }
        else {
            value.left = sem_lift_value(c, block, value.left);
            value.right = sem_lift_value(c, block, value.right);
            value.value = sem_lift_value(c, block, value.value);
        }
    }
    if value.kind == KCall {
        sem_aggregate_arguments(c, block, n);
    }
    var discarded = value.type.pointers == 0;
    discarded &&= value.type.scalar == SVoid;
    if discarded {
        sem_lift_append(block, n);
        return n;
    }
    return sem_lift_snapshot(c, block, n);
}

fn sem_lift_block(c: SemanticContext*, block: void*): void {
    var value = sem_get(block);
    var source = sem_list(c);
    var index: usize = 0;
    for(; index != value.items.length; index++) {
        sem_push(source, value.items.data[index]);
    }
    value.items.length = 0;
    index = 0;
    loop {
        if index == source.length {
            return;
        }
        var n = source.data[index];
        index++;
        var statement = sem_get(n);
        if statement == null {
            sem_lift_append(block, n);
            continue;
        }
        if statement.kind == SurfaceDiscard {
            sem_lift_value(c, block, statement.value);
            statement.kind = KBlock;
            statement.value = null;
            continue;
        }
        if statement.kind == KBlock {
            sem_lift_block(c, n);
        }
        if statement.kind == KLoop {
            sem_lift_block(c, statement.body);
        }
        if statement.kind == KIf {
            statement.value = sem_lift_value(c, block, statement.value);
            sem_lift_block(c, statement.body);
            var otherwise = statement.otherwise != null;
            if otherwise {
                sem_lift_block(c, statement.otherwise);
            }
        }
        var declaration = statement.kind == KDeclare;
        var known = declaration ? sem_known_binding(c, n) : null;
        if known != null && known.evaluation != null {
            known.block = block;
            known.begin = value.items.length;
        }
        if declaration && statement.value != null && semantic_aggregate(&statement.type) {
            var initial = statement.value;
            statement.value = null;
            sem_lift_append(block, n);
            sem_lift_initialization(c, block, sem_control_read(c, n, n), initial);
            continue;
        }
        var assignment = statement.kind == KAssign;
        var returned = statement.kind == KReturn;
        if assignment && semantic_aggregate(&sem_get(statement.target).type) {
            sem_lift_initialization(c, block, statement.target, statement.value);
            statement.kind = KBlock;
            statement.target = null;
            statement.value = null;
            continue;
        }
        if returned && statement.value != null && semantic_aggregate(&sem_get(statement.value).type) {
            var signature = sem_aggregate_signature(c, c.current);
            sem_require(signature != null && signature.result_parameter != null);
            var source = sem_lift_value(c, block, statement.value);
            var destination = sem_control_read(c, block, signature.result_parameter);
            var from = sem_get(sem_lift_target(c, block, source)).value;
            sem_aggregate_transfer(c, block, destination, from, &signature.result_type);
            statement.value = null;
        }
        if assignment {
            statement.target = sem_lift_target(c, block, statement.target);
        }
        var initializer = declaration;
        if assignment {
            initializer = true;
        }
        if returned {
            initializer = true;
        }
        if initializer {
            statement.value = sem_lift_value(c, block, statement.value);
        }
        var call = statement.kind == KCall;
        call ||= statement.kind == KPrint;
        call ||= statement.kind == KFree;
        call ||= statement.kind == KCopy;
        call ||= statement.kind == KFill;
        if call {
            sem_lift_value(c, block, n);
        }
        else {
            sem_lift_append(block, n);
        }
        if known != null && known.evaluation != null { known.end = value.items.length; }
    }
}

fn sem_lower_expressions(c: SemanticContext*): void {
    sem_aggregate_prepare(c);
    sem_lower_parallel(c);
}
