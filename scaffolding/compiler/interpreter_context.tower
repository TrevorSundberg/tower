import tower;
import interpreter_types;
import interpreter_abi;
import interpreter_context_types;
import .library.vector;

fn ix_strict(m: IMExecution*): bool {
    return m.context != null && m.context.strict;
}

fn ix_initialize_frame(m: IMExecution*, base: usize, size: usize): bool {
    if !ix_strict(m) {
        return true;
    }
    var end = base + size;
    if end < base || !vector_reserve(u8, &m.context.initialized, end) {
        ix_fail(m, "Cannot allocate strict evaluation initialization state", 0);
        return false;
    }
    if end > m.context.initialized.length {
        m.context.initialized.length = end;
    }
    if size != 0 {
        fill(m.context.initialized.data + base, 0, size);
    }
    return true;
}

fn ix_initialized(m: IMExecution*, address: u64, size: usize, writing: bool, offset: usize): bool {
    if !ix_strict(m) {
        return true;
    }
    var bytes = &m.context.initialized;
    var limit = convert(u64, bytes.length);
    if address > limit || convert(u64, size) > limit - address {
        ix_fail(m, "Strict evaluation access is outside live local storage", offset);
        return false;
    }
    if writing && size != 0 {
        var end = address + convert(u64, size);
        foreach(var &input in &m.context.input_storage) {
            if address < convert(u64, input.address + input.bytes)
                && convert(u64, input.address) < end {
                ix_fail(m, "Compile-time evaluation cannot modify an immutable captured value", offset);
                return false;
            }
        }
    }
    var first = convert(usize, address);
    var i: usize = 0;
    while i < size {
        if writing {
            bytes.data[first + i] = 1;
        } else {
            if bytes.data[first + i] == 0 {
                ix_fail(m, "Strict evaluation reads an uninitialized local", offset);
                return false;
            }
        }
        i++;
    }
    return true;
}

fn ix_pointer_bytes(m: IMExecution*): usize {
    if m.context != null {
        return m.context.pointer_bytes;
    }
    return im_pointer_bytes(m.state);
}

fn ix_root(m: IMExecution*): void* {
    if m.context != null {
        return m.context.root;
    }
    return im_root(m.state);
}

fn ix_fail(m: IMExecution*, text: u8*, offset: usize): void {
    if m.context == null {
        im_fail(m.state, text, offset);
        return;
    }
    if m.state.failed {
        return;
    }
    m.state.failed = true;
    m.state.error_offset = offset;
    var length: usize = 0;
    while text[length] != 0 {
        length++;
    }
    if vector_reserve(u8, &m.context.error, length + 1) {
        copy(m.context.error.data, text, length + 1);
        m.context.error.length = length;
    }
}

fn ix_has_foreign(m: IMExecution*): bool {
    if m.context != null {
        return false;
    }
    return im_has_foreign(m.state);
}

fn ix_missing_foreign(m: IMExecution*, node: void*, offset: usize): void {
    if m.context == null {
        im_missing_foreign(m.state, node, offset);
        return;
    }
    ix_fail(m, "External call requires an explicit evaluation capability", offset);
}

fn ix_foreign(m: IMExecution*, node: void*, args: u64*, count: usize): u64 {
    if m.context == null {
        return im_foreign(m.state, node, args, count);
    }
    ix_missing_foreign(m, node, 0);
    return 0;
}

fn ix_append(m: IMExecution*, text: u8*, count: usize): void {
    if m.context == null {
        im_append(m.state, text, count);
        return;
    }
    var out = &m.context.output;
    var needed = out.length + count;
    if needed < out.length || needed == ~convert(usize, 0) {
        ix_fail(m, "Evaluation output size overflow", 0);
        return;
    }
    if !vector_reserve(u8, out, needed + 1) {
        ix_fail(m, "Cannot allocate evaluation output", 0);
        return;
    }
    copy(out.data + out.length, text, count);
    out.data[needed] = 0;
    out.length = needed;
    m.state.output_bytes = needed;
}
