// Semantic results live on FoundationNode components. Compilation-local lists
// and scratch below are derived indexes, never another semantic graph.
import semantic_program_types;

struct SemanticEntry {
    text: u8*;
    entity: void*;
    value: void*;
    number: usize;
}

struct SemanticTable {
    entries: SemanticEntry**;
    capacity: usize;
    count: usize;
}

struct SemanticScope {
    parent: SemanticScope*;
    names: SemanticTable*;
}

// Lexical continuation data borrowed exclusively by one body or its active
// declaration producer. The shared entities still own all program semantics.
struct SemanticBodyScope {
    current: void*;
    scope: SemanticScope*;
    labels: SemanticTable*;
    loops: usize;
    deferred: void*;
    deferring: usize;
    defer_bindings: SemanticTable*;
    defer_order: vector(void*)*;
    has_defer: bool;
    control_names: SemanticTable*;
    control_reserved: SemanticTable*;
    control_prefix: u8*;
    flow_dependencies: vector(void*);
}

// Optional inspection metadata on the syntax entity used as a type. The target
// is the ordinary reflected type entity, not another type representation.
struct SemanticTypeUse {
    target: void*;
}

// Workers record type observations by value. Interning reflected type objects
// and attaching inspection metadata happen after every stage in the wave joins.
struct SemanticTypeObservation {
    node: void*;
    type: FoundationType;
}

// Scheduling provenance on a function entity, separate from its signature.
struct SemanticBodyDemand { source: void*; }

struct SemanticEvaluationAlias { producer: void*; original: void*; clone: void*; }

var EditorEnumMembers: u32 = 5;

// Default resource policy for attached semantic payloads, not a language/node
// index limit or a bound on the entire process heap. Callers may supply another
// explicit budget through semantic_compile_budget.
// The compiler's threaded parser/fixture unit exceeds 64 MiB after aggregate
// value lowering. This is a lazy payload allowance, not an up-front allocation;
// hosts with a tighter policy still use semantic_compile_budget explicitly.
var SemanticComponentBudgetBytes: usize = 134217728;

// Optional editor observation of ordinary resolution. The hole is identified by
// source coordinates, never by a reserved identifier or an independent AST.
struct SemanticEditor {
    offset: usize;
    length: usize;
    found: bool;
    kind: u32;
    has_expected: bool;
    value_required: bool;
    require_pointer: bool;
    require_integer: bool;
    current: void*;
    loops: usize;
    blocks: usize;
    type: FoundationType;
    receiver: FoundationType;
    scope: SemanticScope*;
    node: void*;
    module: void*;
}

struct SemanticContext {
    editor: SemanticEditor*;
    type_uses: void*;
    type_observations: vector(SemanticTypeObservation)*;
    program: SemanticProgram*;
    current: void*;
    count: usize;
    node_limit: usize;
    loops: usize;
    value_depth: u32;
    type_depth: u32;
    generics: void*;
    source: u8*;
    functions: SemanticTable*;
    types: SemanticTable*;
    globals: SemanticTable*;
    templates: SemanticTable*;
    type_functions: SemanticTable*;
    type_results: SemanticTable*;
    source_names: SemanticTable*;
    source_bases: SemanticTable*;
    output_names: SemanticTable*;
    fields_done: SemanticTable*;
    queries: WorkGraph;
    declaration_state: void*;
    declaration_jobs: vector(void*);
    declaration_subjects: vector(void*)*;
    declaration_isolated: bool;
    prepared_calls: void*;
    aggregate_signatures: void*;
    known_bindings: void*;
    value_inputs: void*;
    body_demands: void*;
    body_seen: SemanticTable*;
    generic_copies: void*;
    type_constructors: void*;
    defer_type_fields: bool;
    control_names: SemanticTable*;
    control_reserved: SemanticTable*;
    control_prefix: u8*;
    entity_stage: void*;
    scope: SemanticScope*;
    labels: SemanticTable*;
    type_arguments: vector(void*);
    constant_arguments: vector(void*);
    generated: vector(void*);
    template_nodes: vector(void*);
    inferring: vector(void*);
    allocations: vector(void*);
    lists: vector(void*);
    // Non-reentrant tree scans reuse scratch storage. Results remain owned by
    // allocations/lists; no caller receives a pointer into either scratch buffer.
    scan: stack(void*);
    token_text: vector(u8);
    surface_expressions: bool;
    deferred: void*;
    deferring: usize;
    defer_bindings: SemanticTable*;
    defer_order: vector(void*)*;
    has_defer: bool;
    workers: WorkPool;
    layout_results: void*;
    layout_jobs: vector(void*);
    // Types append during this compilation; published layouts never mutate.
    // Readiness is distinct from the precise layout inputs of each query.
    layout_checked: usize;
    query_reads: vector(usize)*;
    evaluation_results: void*;
    evaluation_ready: void*;
    evaluation_jobs: vector(void*);
    evaluation_aliases: vector(SemanticEvaluationAlias)*;
    evaluation_depth: usize;
    unevaluated: bool;
    type_query_operand: void*;
    flow_results: void*;
    flow_count: usize;
    flow_dependencies: vector(void*);
    attribute_sources: vector(void*)*;
}

// Each dispatched work component owns this read log. Only the coordinator
// updates the dependency graph, after joining readers of its immutable indexes.
fn sem_query_read(c: SemanticContext*, query: usize): void {
    if c.query_reads == null { return; }
    var reads = c.query_reads;
    if reads.length == 0 || reads.data[reads.length - 1] != query {
        sem_require(vector_push(reads, query));
    }
}

fn sem_query_input(c: SemanticContext*, subject: void*, query: u32): void {
    if c.query_reads == null { return; }
    var id = work_find(&c.queries, subject, query, 0);
    if id != 0 && work_task(&c.queries, id).state == WorkState.Succeeded { sem_query_read(c, id); }
}

fn sem_query_observe(c: SemanticContext*, ticket: WorkTicket*, reads: vector(usize)*): void {
    foreach(var query in reads) { sem_require(work_observe(&c.queries, ticket, query)); }
    reads.length = 0;
}

fn sem_editor_private(c: SemanticContext*, editor: SemanticEditor*): void {
    if c.editor == null { return; }
    *editor = *c.editor;
    c.editor = editor;
}

fn sem_editor_publish(c: SemanticContext*, editor: SemanticEditor*): void {
    if c.editor != null && !c.editor.found && editor.found && sem_ok(c) {
        *c.editor = *editor;
    }
}

fn sem_editor_contains(c: SemanticContext*, n: void*): bool {
    if c.editor == null {
        return false;
    }
    if n == null {
        return false;
    }
    if sem_source_base(c, n) != 0 {
        return false;
    }
    var span = sem_match(n);
    if span == null {
        return false;
    }
    if span.start > c.editor.offset {
        return false;
    }
    var end = span.start + span.length;
    var hole_end = c.editor.offset + c.editor.length;
    var editor_result9 = hole_end <= end;
    return editor_result9;
}

fn sem_editor_capture(c: SemanticContext*, n: void*, kind: u32, receiver: FoundationType*): bool {
    if !sem_editor_contains(c, n) {
        return false;
    }
    var span = sem_match(n);
    if span.start != c.editor.offset {
        return false;
    }
    if span.length != c.editor.length {
        return false;
    }
    if c.editor.found {
        return true;
    }
    c.editor.found = true;
    c.editor.kind = kind;
    c.editor.scope = c.scope;
    c.editor.node = n;
    c.editor.current = c.current;
    c.editor.loops = c.loops;
    var parent = n;
    loop {
        if parent == null {
            break;
        }
        if sem_is(parent, "CoreBlock") {
            c.editor.blocks++;
        }
        parent = sem_parent(parent);
    }
    if receiver != null {
        sem_set_type(&c.editor.receiver, receiver);
    }
    sem_fail(c, n, "Editor resolution boundary");
    return true;
}

// Accessors only: adapters neither resolve nor validate semantic operations.
extern fn core_component_type(): void*;

extern fn entity_component_get(node: void*, type: void*): void*;

extern fn entity_component_data(component: void*): void*;

extern fn entity_component_add(node: void*, type: void*): void*;

extern fn entity_register(type: void*, size: usize, alignment: usize, lifecycle: usize): bool;

extern fn tower_node_create(): void*;
extern fn entity_create_related(node: void*): void*;
extern fn entity_stage_open(anchor: void*): void*;
extern fn entity_stage_lease(stage: void*, node: void*): bool;
extern fn entity_stage_create(stage: void*, parent: void*): void*;
extern fn entity_stage_publish(stage: void*): bool;
extern fn compiler_node_type(node: void*, kind: u32): void*;
extern fn compiler_node_get(node: void*, kind: u32): void*;

extern fn entity_attach(child: void*, parent: void*, name: u8*): bool;

extern fn entity_release(node: void*): usize;

extern fn entity_child_at(node: void*, index: usize): void*;

extern fn entity_child_count(node: void*): usize;

extern fn entity_parent(node: void*): void*;

extern fn entity_member_index(node: void*, name: u8*): usize;

extern fn foundation_node_init(value: FoundationNode*): void;

extern fn syntax_identifier_decode_in_place(text: u8*, length: usize): usize;

extern fn abort(): void;

// The component identity is supplied explicitly for reusable compiler contexts.
// Its payload and ownership are the existing entity model, with no copied graph.
export fn semantic_component_get(node: void*, type: void*): FoundationNode* {
    if node == null {
        return null;
    }
    return bits(FoundationNode*, entity_component_data(entity_component_get(node, type)));
}

// Allocation failure leaves both the existing component and owner unchanged.
export fn semantic_component_attach(node: void*, type: void*, kind: u32): FoundationNode* {
    var value = semantic_component_get(node, type);
    var present = value != null;
    if present {
        value.kind = kind;
        return value;
    }
    var lifecycle: usize = 0;
    lifecycle--;
    if !entity_register(type, sizeof(FoundationNode), alignof(FoundationNode), lifecycle) {
        return null;
    }
    value = bits(FoundationNode*, entity_component_data(entity_component_add(node, type)));
    present = value != null;
    if present {
        foundation_node_init(value);
        value.kind = kind;
    }
    return value;
}

export fn sem_get(node: void*): FoundationNode* {
    return bits(FoundationNode*, compiler_node_get(node, CompilerFoundation));
}

export fn sem_attach(node: void*, kind: u32): FoundationNode* {
    var value = semantic_component_attach(node, compiler_node_type(node, CompilerFoundation), kind);
    var present = value != null;
    sem_require(present);
    return value;
}

export fn sem_create(parent: void*): void* {
    var node = entity_create_related(parent);
    sem_require(node != null);
    sem_require(entity_attach(node, parent, null));
    entity_release(node);
    return node;
}

extern fn sem_match(node: void*): ParserMatchData*;

export fn sem_child(node: void*, index: usize): void* {
    if node == null {
        return null;
    }
    return entity_child_at(node, index);
}

export fn sem_child_count(node: void*): usize {
    if node == null {
        return 0;
    }
    return entity_child_count(node);
}

export fn sem_parent(node: void*): void* {
    return entity_parent(node);
}

export fn sem_member(node: void*, name: u8*): void* {
    if node == null {
        return null;
    }
    return entity_child_at(node, entity_member_index(node, name));
}

export fn sem_decode_identifier(text: u8*): void {
    var length = syntax_identifier_decode_in_place(text, sem_length(text));
    text[length] = 0;
}

export fn sem_require(ok: bool): void {
    if !ok {
        abort();
    }
}

extern fn generic_begin(root: void*): void*;

extern fn generic_error(context: void*): u8*;

extern fn generic_register(context: void*, definition: void*): u32;

extern fn generic_parameter_count(context: void*, definition: void*): usize;

extern fn generic_type_parameter(context: void*, definition: void*, index: usize): bool;

extern fn generic_instantiate(context: void*, definition: void*, use: void*, arguments: void**, count: usize): void*;

extern fn generic_instantiate_deferred(context: void*, definition: void*, use: void*, arguments: void**, count: usize): void*;

extern fn generic_lookup(context: void*, node: void*, name: void*): void*;

extern fn generic_type_result(context: void*, instance: void*): void*;

extern fn generic_type_result_read(instance: void*, error: u8**): void*;

extern fn generic_origin(context: void*, node: void*): void*;

extern fn generic_definition(context: void*, node: void*): void*;

extern fn generic_specialization(context: void*, node: void*): void*;

extern fn generic_argument_count(context: void*, node: void*): usize;

extern fn generic_argument(context: void*, node: void*, index: usize): void*;

fn sem_label(node: void*): u8* {
    var `match` = sem_match(node);
    var present = `match` != null;
    if present {
        present = `match`.label.data != null;
        if present {
            return `match`.label.data;
        }
    }
    return "";
}

fn sem_is(node: void*, name: u8*): bool {
    return sem_equal(sem_label(node), name);
}

extern fn foundation_name_append(value: vector(u8)*, byte: u8): bool;

extern fn foundation_nodes_prepend(values: vector(void*)*, source: void**, count: usize): bool;

// The same immutable world budget governs every semantic phase, including
// interpreter evaluation and resumed declaration/body work.
fn sem_workers_open(c: SemanticContext*): bool {
    return c.workers.count != 0 || work_pool_open(&c.workers, compiler_worker_capacity(c.program.root));
}
