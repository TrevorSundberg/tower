// The coordinator records joined results in source order. A worker may call
// this only on its private program, then transfer the receipt with its result.
// This does not allocate, format text, or mutate a shared budget/error slot.
export fn sem_resource_record(program: SemanticProgram*, error: WorkBudgetError, offset: usize): void {
    if error == WorkBudgetError.None || program.resource.error != WorkBudgetError.None { return; }
    program.resource = { error: error, offset: offset };
}

// Output boundaries can report a retained failure even if diagnostic storage
// was unavailable or an editor intentionally cleared ordinary source errors.
export fn sem_resource_message(error: WorkBudgetError): u8* {
    if error == WorkBudgetError.None { return ""; }
    if error == WorkBudgetError.Capacity { return "Semantic memory budget exceeded"; }
    if error == WorkBudgetError.Memory { return "Cannot allocate semantic storage"; }
    if error == WorkBudgetError.Busy { return "Semantic worker admission failed"; }
    if error == WorkBudgetError.Stale { return "Stale semantic resource reservation"; }
    if error == WorkBudgetError.Exhausted { return "Semantic resource reservation identifiers exhausted"; }
    return "Invalid semantic resource request";
}

// Classify an actual failed graph operation only. An empty take on a healthy
// graph is ordinary waiting. This helper never cancels, drains or releases work.
export fn sem_query_error(c: SemanticContext*): WorkBudgetError {
    return c.queries.resource_error == WorkBudgetError.None ? WorkBudgetError.Invalid : c.queries.resource_error;
}

extern fn compiler_world_work_budget(world: void*): WorkBudget*;
extern fn compiler_world_worker_reserve(world: void*, preferred: usize, receipt: WorkReservation*): WorkBudgetError;
extern fn compiler_world_worker_release(world: void*, receipt: WorkReservation*): WorkBudgetError;

// Capture the descriptor once at the existing frozen-input boundary. The
// destination is private; graph, pool and shared payload ownership stay borrowed.
// Keep one descriptor copy here, but never copy ownership of scratch storage.
// Frozen lexical lists remain explicit borrows through the source context;
// allocations made by this snapshot belong to its own private scratch owner.
export fn sem_context_snapshot(destination: SemanticContext*, source: SemanticContext*): void {
    *destination = *source;
    sem_scratch_private(destination, source);
}

// Each dispatched work component owns this read log. Only the coordinator
// updates the dependency graph, after joining readers of its immutable indexes.
fn sem_query_read(c: SemanticContext*, query: usize): void {
    if !sem_query_read_checked(c, query) { sem_scratch_error(c, c.current, WorkBudgetError.Memory); }
}

fn sem_query_read_checked(c: SemanticContext*, query: usize): bool {
    if c.query_reads == null { return true; }
    var reads = c.query_reads;
    if reads.length == 0 || reads.data[reads.length - 1] != query {
        return vector_push(reads, query);
    }
    return true;
}

fn sem_query_input(c: SemanticContext*, subject: void*, query: u32): void {
    if !sem_query_input_checked(c, subject, query) { sem_scratch_error(c, subject, WorkBudgetError.Memory); }
}

export fn sem_query_input_checked(c: SemanticContext*, subject: void*, query: u32): bool {
    if c.query_reads == null { return true; }
    var id = work_find(&c.queries, subject, query, 0);
    return id == 0 || work_task(&c.queries, id).state != WorkState.Succeeded || sem_query_read_checked(c, id);
}

fn sem_query_observe(c: SemanticContext*, ticket: WorkTicket*, reads: vector(usize)*): void {
    if !sem_query_observe_checked(c, ticket, reads) { sem_scratch_error(c, c.current, sem_query_error(c)); }
}

fn sem_query_observe_checked(c: SemanticContext*, ticket: WorkTicket*, reads: vector(usize)*): bool {
    foreach(var query in reads) {
        if !work_observe(&c.queries, ticket, query) { return false; }
    }
    reads.length = 0;
    return true;
}

// Graph growth can fail after releasing a ticket or publishing some ready
// edges. Only the joined coordinator may invalidate the remaining receipts.
// The caller retains private outputs until it has selected its diagnostic.
fn sem_query_cancel_failure(c: SemanticContext*): WorkBudgetError {
    sem_require(c.workers.running == 0);
    var error = sem_query_error(c);
    work_cancel(&c.queries);
    return error;
}

// Joined phase owners select the graph failure before exposing ready outputs.
// Release any undispatched private stages before calling this cancellation path.
fn sem_query_check(c: SemanticContext*, subject: void*, ok: bool): bool {
    if ok { return true; }
    var error = sem_query_cancel_failure(c);
    var message: vector(u8) = default;
    var operation = sem_get(subject);
    sem_restore_resource(c, error, &message, operation == null ? 0 : operation.start);
    return false;
}

// Inspect only demanded queries of this phase. An empty ready queue is a
// suspension point, not permission to diagnose a cycle or replay its consumer.
fn sem_query_pending(c: SemanticContext*, query: u32): bool {
    foreach(var &task in &c.queries.tasks) {
        if task.query == query && task.demanded && task.state != WorkState.Succeeded { return true; }
    }
    return false;
}

fn sem_editor_private(c: SemanticContext*, editor: SemanticEditor*): void {
    if c.editor == null { return; }
    *editor = *c.editor;
    c.editor = editor;
}

fn sem_editor_publish(c: SemanticContext*, editor: SemanticEditor*): void {
    if c.editor != null && !c.editor.found && editor.found && sem_ok(c) {
        *c.editor = *editor;
    }
}

fn sem_editor_contains(c: SemanticContext*, n: void*): bool {
    if c.editor == null {
        return false;
    }
    if n == null {
        return false;
    }
    if sem_source_base(c, n) != 0 {
        return false;
    }
    var span = sem_match(n);
    if span == null {
        return false;
    }
    if span.start > c.editor.offset {
        return false;
    }
    var end = span.start + span.length;
    var hole_end = c.editor.offset + c.editor.length;
    var editor_result9 = hole_end <= end;
    return editor_result9;
}

fn sem_editor_capture(c: SemanticContext*, n: void*, kind: u32, receiver: FoundationType*): bool {
    if !sem_editor_contains(c, n) {
        return false;
    }
    var span = sem_match(n);
    if span.start != c.editor.offset {
        return false;
    }
    if span.length != c.editor.length {
        return false;
    }
    if c.editor.found {
        return true;
    }
    c.editor.found = true;
    c.editor.kind = kind;
    c.editor.scope = c.scope;
    c.editor.node = n;
    c.editor.current = c.current;
    c.editor.loops = c.loops;
    var parent = n;
    loop {
        if parent == null {
            break;
        }
        if sem_is(parent, "CoreBlock") {
            c.editor.blocks++;
        }
        parent = sem_parent(parent);
    }
    if receiver != null {
        sem_set_type(&c.editor.receiver, receiver);
    }
    sem_fail(c, n, "Editor resolution boundary");
    return true;
}

