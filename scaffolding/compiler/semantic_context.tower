fn sem_label(node: void*): u8* {
    var `match` = sem_match(node);
    var present = `match` != null;
    if present {
        present = `match`.label.data != null;
        if present {
            return `match`.label.data;
        }
    }
    return "";
}

fn sem_is(node: void*, name: u8*): bool {
    return sem_equal(sem_label(node), name);
}

extern fn foundation_name_append(value: vector(u8)*, byte: u8): bool;

extern fn foundation_nodes_prepend(values: vector(void*)*, source: void**, count: usize): bool;

// The same immutable world budget governs every semantic phase, including
// interpreter evaluation and resumed declaration/body work.
export fn sem_workers_open(c: SemanticContext*): bool {
    if !sem_ok(c) { return false; }
    if c.workers.count != 0 { return true; }
    var world = compiler_node_world(c.program.root);
    if work_pool_open_budget(&c.workers, compiler_worker_capacity(c.program.root),
        compiler_world_work_budget(world)) { return true; }
    var error = c.workers.resource_error;
    if error == WorkBudgetError.None { error = WorkBudgetError.Invalid; }
    var message: vector(u8) = default;
    var operation = sem_get(c.current ?? c.program.root);
    sem_restore_resource(c, error, &message, operation == null ? 0 : operation.start);
    return false;
}

// The coordinator already owns its outer lane. A retained pool is capacity,
// not permission to dispatch; this receipt outlives joins and stage publication.
// The output is fresh storage, never an existing live receipt.
fn sem_workers_admit(c: SemanticContext*, count: usize, receipt: WorkReservation*): usize {
    var extra: usize = 0;
    if sem_workers_admit_result(c, count, receipt, &extra) != WorkBudgetError.None {
        trap("Unable to reserve shared semantic worker budget", 0);
    }
    return extra;
}

fn sem_workers_admit_result(c: SemanticContext*, count: usize, receipt: WorkReservation*, admitted: usize*): WorkBudgetError {
    sem_require(c.workers.running == 0);
    *receipt = default;
    *admitted = 0;
    if count < 2 || !c.workers.threaded { return WorkBudgetError.None; }
    var capacity = compiler_worker_capacity(c.program.root);
    if capacity < 2 { return WorkBudgetError.None; }
    var extra = count - 1;
    if extra >= capacity { extra = capacity - 1; }
    if extra > c.workers.count { extra = c.workers.count; }
    var world = compiler_node_world(c.program.root);
    if compiler_world_work_budget(world) == null { *admitted = extra; return WorkBudgetError.None; }
    var error = compiler_world_worker_reserve(world, extra, receipt);
    if error == WorkBudgetError.None {
        *admitted = receipt.lanes;
    }
    return error;
}

fn sem_workers_release(c: SemanticContext*, receipt: WorkReservation*): void {
    sem_require(c.workers.running == 0);
    if receipt.active && compiler_world_worker_release(compiler_node_world(c.program.root), receipt) != WorkBudgetError.None {
        trap("Invalid shared semantic worker budget receipt", 0);
    }
}
