// The component identity is supplied explicitly for reusable compiler contexts.
// Its payload and ownership are the existing entity model, with no copied graph.
export fn semantic_component_get(node: void*, type: void*): FoundationNode* {
    if node == null {
        return null;
    }
    return bits(FoundationNode*, entity_component_data(entity_component_get(node, type)));
}

// Allocation failure leaves both the existing component and owner unchanged.
export fn semantic_component_attach(node: void*, type: void*, kind: u32): FoundationNode* {
    var value = semantic_component_get(node, type);
    var present = value != null;
    if present {
        value.kind = kind;
        return value;
    }
    var lifecycle: usize = 0;
    lifecycle--;
    if !entity_register(type, sizeof(FoundationNode), alignof(FoundationNode), lifecycle) {
        return null;
    }
    value = bits(FoundationNode*, entity_component_data(entity_component_add(node, type)));
    present = value != null;
    if present {
        foundation_node_init(value);
        value.kind = kind;
    }
    return value;
}

export fn sem_get(node: void*): FoundationNode* {
    return bits(FoundationNode*, compiler_node_get(node, CompilerFoundation));
}

export fn sem_attach(node: void*, kind: u32): FoundationNode* {
    var error: WorkBudgetError;
    var value = sem_attach_result(node, kind, &error);
    var present = value != null;
    sem_require(present);
    return value;
}

// Lifetime pins do not forbid an already admitted payload write. The shared
// producer checks structural admission only when a component must be created.
export fn sem_attach_result(node: void*, kind: u32, error: WorkBudgetError*): FoundationNode* {
    if error == null { return null; }
    var value = bits(FoundationNode*, compiler_world_component_result(
        compiler_node_world(node), node, CompilerFoundation, error));
    if value != null { value.kind = kind; }
    return value;
}

export fn sem_create(parent: void*): void* {
    var error: WorkBudgetError;
    var node = sem_create_result(parent, &error);
    sem_require(node != null);
    return node;
}

// The returned node is borrowed from its parent's containment, as in sem_create.
// A failed attachment retires the private allocation before returning its cause.
export fn sem_create_result(parent: void*, error: WorkBudgetError*): void* {
    var node = entity_create_related_result(parent, error);
    if node == null { return null; }
    *error = entity_attach_result(node, parent, null);
    var attached = *error == WorkBudgetError.None;
    entity_release(node);
    return attached ? node : null;
}

// Dynamic kinds share containment admission and retire an unregistered node.
fn sem_kind_result(parent: void*, size: usize, alignment: usize, error: WorkBudgetError*): void* {
    var kind = sem_create_result(parent, error);
    if kind == null { return null; }
    if entity_register(kind, size, alignment, 0) { return kind; }
    *error = WorkBudgetError.Invalid;
    sem_require(entity_attach_result(kind, null, null) == WorkBudgetError.None);
    return null;
}

extern fn sem_match(node: void*): ParserMatchData*;

export fn sem_child(node: void*, index: usize): void* {
    if node == null {
        return null;
    }
    return entity_child_at(node, index);
}

export fn sem_child_count(node: void*): usize {
    if node == null {
        return 0;
    }
    return entity_child_count(node);
}

export fn sem_parent(node: void*): void* {
    return entity_parent(node);
}

export fn sem_member(node: void*, name: u8*): void* {
    if node == null {
        return null;
    }
    return entity_child_at(node, entity_member_index(node, name));
}

export fn sem_decode_identifier(text: u8*): void {
    var length = syntax_identifier_decode_in_place(text, sem_length(text));
    text[length] = 0;
}

export fn sem_require(ok: bool): void {
    if !ok {
        abort();
    }
}

