import 'semantic-program-types';
import tower;
import 'language-grammar';
import 'foundation-tags';
import 'frontend-compilation';
import 'semantic-context';
import 'semantic-definitions';
import 'semantic-lifecycle';
import 'semantic-modules';
import 'semantic-statements';
import 'semantic-support';
import 'semantic-types';
import '../library/vector';

// Editor queries over the compiler's shared syntax entities. Recovery text is
// scratch input to the ordinary parser, never a second AST or program format.
// Candidate lists retain borrowed entity handles only for the duration of a query.
struct CompletionSpan {
    start: usize;
    end: usize;
    opaque: bool;
}

struct CompletionQuery {
    active: void*;
    program: SemanticProgram;
    context: SemanticContext;
    editor: SemanticEditor;
    semantic: bool;
    analyzed: bool;
    inspection: bool;
    inspection_session: void*;
    generic_info: void*;
    grammar: vector(LanguageGrammar);
    grammar_index: SemanticTable*;
    comment_modules: vector(void*);
    comment_bases: vector(usize);
    truncated: bool;
    input: vector(u8);
    roots: vector(void*);
    bases: vector(usize);
    source: u8*;
    length: usize;
    cursor: usize;
    from: usize;
    to: usize;
    boundary: usize;
    mode: u32;
    hidden: bool;
    recovered: vector(u8);
    names: vector(u8*);
    bindings: vector(u8*);
    output: vector(u8);
    count: usize;
}

extern fn syntax_completion_create(source: u8*, mode: u32): void*;

extern fn syntax_destroy(session: void*): void;

extern fn syntax_completion_module(session: void*): void*;

extern fn syntax_completion_enable(session: void*): void;

extern fn syntax_completion_accepts(session: void*, text: u8*, literal: bool): bool;

extern fn syntax_completion_callable(session: void*): bool;

extern fn syntax_completion_identifier(session: void*, text: u8*): bool;

extern fn syntax_completion_close(session: void*, type_name: u8*): u8*;

export fn completion_from(q: CompletionQuery*): usize {
    return q.from;
}

fn completion_attach(q: CompletionQuery*, root: void*, base: usize): void {
    var node = sem_child(root, 0);
    if sem_is(node, "Statement") {
        node = sem_unwrap(node);
    }
    sem_require(entity_attach(root, q.program.root, ""));
    var target = sem_get(q.program.root);
    sem_push(&target.items, node);
    sem_push(&q.roots, root);
    sem_require(vector_push(usize, &q.bases, base));
}

fn completion_parse(q: CompletionQuery*, source: u8*, mode: u32, future: bool): bool {
    var first_root = q.roots.length;
    var base = q.input.length;
    var length = sem_length(source);
    sem_require(bytes_append(&q.input, source, length));
    sem_require(vector_push(u8, &q.input, 10));
    var session = syntax_completion_create(source, mode);
    var entries: vector(void*);
    vector_init(void*, &entries);
    var count: usize = 0;
    loop {
        var editor_condition1 = count == 1024;
        if editor_condition1 {
            q.truncated = true;
            break;
        }
        var revision = syntax_get_revision(session);
        var root = syntax_next(session);
        var editor_condition2 = root == null;
        if editor_condition2 {
            break;
        }
        var keep = revision == syntax_get_revision(session);
        if future {
            var span = sem_match(root);
            var editor_condition3 = span.start < q.cursor;
            if editor_condition3 {
                keep = false;
            }
        }
        if keep {
            if q.inspection {
                language_match_snapshot(q, root, session, 0);
            }
            sem_push(&entries, root);
        } else {
            if q.inspection {
                language_snapshot(q, root, session, 0);
                language_templates_refresh(q, session);
                // Keep grammar entities for inspection without adding them to
                // the executable statement list consumed by ordinary checking.
                sem_require(entity_attach(root, q.program.root, ""));
                sem_push(&q.roots, root);
                sem_require(vector_push(usize, &q.bases, base));
            }
            entity_release(root);
        }
        count++;
    }
    var error = syntax_get_error(session);
    var clean = error[0] == 0;
    var parsed_module = syntax_completion_module(session);
    var scoped = parsed_module != null;
    if scoped {
        sem_module_graph(&q.program, parsed_module);
        // Entry statements collected during recovery may not be in the normal
        // module roots yet; retain their same explicit owner before teardown.
        var owner = sem_module_scope(&q.program, parsed_module);
        sem_module_position(&q.program, parsed_module, base);
        var root_index: usize = 0;
        while root_index < entries.length {
            sem_module_link(entries.data[root_index], q.program.modules.owner_kind, owner);
            root_index++;
        }
        // Grammar declarations also carry a definition scope for replacement
        // inspection, without modifying cached template trees.
        root_index = first_root;
        while root_index < q.roots.length {
            sem_module_link(q.roots.data[root_index], q.program.modules.owner_kind, owner);
            root_index++;
        }
    }
    // Only the entry's actual import closure contributes external declarations.
    // These are fresh ordinary module entities, retained before session teardown.
    if !future {
        var module = syntax_completion_module(session);
        var present = module != null;
        if present {
            var i: usize = 0;
            var total = frontend_module_count(module);
            loop {
                var done = i == total;
                if done {
                    break;
                }
                var dependency = frontend_module_at(module, i);
                var imported = dependency != module;
                if imported {
                    var dependency_base = q.input.length;
                    sem_module_position(&q.program, dependency, dependency_base);
                    if q.inspection {
                        sem_push(&q.comment_modules, dependency);
                        sem_require(vector_push(usize, &q.comment_bases, dependency_base));
                    }
                    var data = frontend_module_source(dependency);
                    var bytes = frontend_module_size(dependency);
                    sem_require(bytes_append(&q.input, data, bytes));
                    sem_require(vector_push(u8, &q.input, 10));
                    var n: usize = 0;
                    var trees = frontend_module_roots(dependency);
                    loop {
                        done = n == trees;
                        if done {
                            break;
                        }
                        completion_attach(q, frontend_module_tree(dependency, n), dependency_base);
                        n++;
                    }
                }
                i++;
            }
        }
    }
    var i: usize = 0;
    loop {
        var done = i == entries.length;
        if done {
            break;
        }
        completion_attach(q, entries.data[i], base);
        entity_release(entries.data[i]);
        i++;
    }
    vector_dispose(void*, &entries);
    if q.inspection {
        // Keep the normal module/lexer metadata alive until semantic checking
        // has attached Foundation components for the shared comment pass.
        q.inspection_session = session;
        var module = syntax_completion_module(session);
        var present = module != null;
        if present {
            syntax_capture_comments(session, module);
            sem_push(&q.comment_modules, module);
            sem_require(vector_push(usize, &q.comment_bases, base));
        }
    } else {
        syntax_destroy(session);
    }
    return clean;
}

export fn completion_analyze(q: CompletionQuery*, active: void*, mode: u32, files: u8**, lengths: usize*, count: usize): void {
    q.active = active;
    if q.hidden {
        return;
    }
    var editor_condition4 = mode != 0;
    if editor_condition4 {
        return;
    }
    var editor_condition5 = q.mode == 2;
    if editor_condition5 {
        return;
    }
    // Select a concrete identifier through the current lexer. Its coordinates,
    // not its spelling, mark the query, including under local token overrides.
    var hole: vector(u8);
    vector_init(u8, &hole);
    var prefix_length = q.cursor - q.from;
    var preferred = &q.source[q.from];
    sem_require(bytes_append(&hole, preferred, prefix_length));
    sem_require(host_text_terminate(&hole));
    var attempt: usize = 0;
    loop {
        if syntax_completion_identifier(active, hole.data) {
            break;
        }
        var editor_check_1 = attempt == 6;
        if editor_check_1 {
            vector_dispose(u8, &hole);
            return;
        }
        var spelling: u8* = "a";
        var editor_check_2 = attempt == 1;
        if editor_check_2 {
            spelling = "A";
        }
        var editor_check_3 = attempt == 2;
        if editor_check_3 {
            spelling = "aa";
        }
        var editor_check_4 = attempt == 3;
        if editor_check_4 {
            spelling = "AA";
        }
        var editor_check_5 = attempt == 4;
        if editor_check_5 {
            spelling = "_";
        }
        var editor_check_6 = attempt == 5;
        if editor_check_6 {
            spelling = "`a`";
        }
        hole.length = 0;
        completion_text(&hole, spelling);
        sem_require(host_text_terminate(&hole));
        attempt++;
    }
    q.editor.length = hole.length;
    var text: vector(u8);
    vector_init(u8, &text);
    sem_require(bytes_append(&text, q.source, q.from));
    completion_text(&text, hole.data);
    vector_dispose(u8, &hole);
    var prefix_end = text.length;
    var suffix_length = q.length - q.to;
    sem_require(bytes_append(&text, &q.source[q.to], suffix_length));
    sem_require(host_text_terminate(&text));
    var root = tower_node_create();
    semantic_initialize(&q.program, root, 4);
    q.semantic = true;
    var valid = completion_parse(q, text.data, mode, false);
    // Prefer the actual suffix, so later operands and declarations participate
    // in resolution. Fall back to a bounded LR continuation for incomplete edits.
    if !valid {
        semantic_program_dispose(&q.program);
        entity_release(root);
        root = tower_node_create();
        semantic_initialize(&q.program, root, 4);
        q.roots.length = 0;
        q.bases.length = 0;
        q.input.length = 0;
        text.length = prefix_end;
        sem_require(host_text_terminate(&text));
        var probe = syntax_completion_create(text.data, mode);
        syntax_completion_enable(probe);
        var i: usize = 0;
        loop {
            var editor_condition6 = i == 1024;
            if editor_condition6 {
                break;
            }
            var root = syntax_next(probe);
            var editor_condition7 = root == null;
            if editor_condition7 {
                break;
            }
            entity_release(root);
            i++;
        }
        var suffix = syntax_completion_close(probe, semantic_scalar_name(SVoid()));
        var editor_condition8 = suffix == null;
        if editor_condition8 {
            syntax_destroy(probe);
            vector_dispose(u8, &text);
            return;
        }
        // host_text_terminate writes beyond length; append replaces that terminator.
        completion_text(&text, suffix);
        sem_require(host_text_terminate(&text));
        syntax_destroy(probe);
        valid = completion_parse(q, text.data, mode, false);
        if !valid {
            vector_dispose(u8, &text);
            return;
        }
        completion_parse(q, q.recovered.data, mode, true);
    }
    vector_dispose(u8, &text);
    var i: usize = 0;
    sem_require(host_text_terminate(&q.input));
    var c = &q.context;
    sem_context_init(c, &q.program);
    q.analyzed = true;
    c.source = q.input.data;
    c.editor = &q.editor;
    q.editor.offset = q.from;
    c.generics = generic_begin(root);
    i = 0;
    loop {
        var editor_condition10 = i == q.roots.length;
        if editor_condition10 {
            break;
        }
        var entry = sem_state(c, c.source_bases, q.roots.data[i]);
        entry.number = q.bases.data[i];
        i++;
    }
    sem_run(c);
    // Observed scope tables borrow real entities and remain valid until dispose.
    if q.editor.found {
        c.scope = q.editor.scope;
    }
    c.editor = null;
    q.program.error.length = 0;
}

extern fn host_json_quote(out: vector(u8)*, source: u8*, count: usize): bool;

extern fn host_json_unsigned(out: vector(u8)*, value: u64): bool;

extern fn host_text_terminate(out: vector(u8)*): bool;

fn completion_word(byte: u8): bool {
    var yes = byte >= 65;
    yes &&= byte <= 90;
    if yes {
        return true;
    }
    yes = byte >= 97;
    yes &&= byte <= 122;
    if yes {
        return true;
    }
    yes = byte >= 48;
    yes &&= byte <= 57;
    if yes {
        return true;
    }
    var underscore = byte == 95;
    return underscore;
}

fn completion_slice(source: u8*, start: usize, end: usize, word: u8*): bool {
    var size = end - start;
    var same = size == sem_length(word);
    if !same {
        return false;
    }
    var i: usize = 0;
    loop {
        var done = i == size;
        if done {
            return true;
        }
        var at = start + i;
        same = source[at] == word[i];
        if !same {
            return false;
        }
        i++;
    }
}

fn completion_text(out: vector(u8)*, text: u8*): void {
    sem_require(bytes_append(out, text, sem_length(text)));
}

// Offsets and lexer spans use UTF-8 bytes, including quoted identifiers.
// mode 2 marks declaration-reader queries. Value/type/member roles come from
// semantic resolution, not adjacent punctuation.
export fn completion_begin(source: u8*, length: usize, cursor: usize, spans: CompletionSpan*, count: usize): CompletionQuery* {
    var q = alloc(CompletionQuery, 1);
    var missing = q == null;
    if missing {
        return null;
    }
    fill(q, 0, sizeof(CompletionQuery));
    q.source = source;
    q.length = length;
    q.cursor = cursor;
    q.from = cursor;
    q.to = cursor;
    var i: usize = 0;
    var grammar: bool = false;
    loop {
        var done = i == count;
        if done {
            break;
        }
        var s = &spans[i];
        var inside = s.start < cursor;
        inside &&= cursor <= s.end;
        if inside {
            if s.opaque {
                var whitespace = source[s.start] <= 32;
                if !whitespace {
                    q.hidden = true;
                }
            } else {
                var word = completion_word(source[s.start]);
                var quoted = source[s.start] == 96;
                if quoted {
                    word = true;
                }
                if word {
                    q.from = s.start;
                    q.to = s.end;
                }
            }
        }
        var past = s.start >= q.from;
        if past {
            break;
        }
        if !s.opaque {
            var start = completion_slice(source, s.start, s.end, "parse");
            var token_decl = completion_slice(source, s.start, s.end, "token");
            var skip_decl = completion_slice(source, s.start, s.end, "skip");
            if token_decl {
                start = true;
            }
            if skip_decl {
                start = true;
            }
            if start {
                grammar = true;
            }
            var semi = completion_slice(source, s.start, s.end, ";");
            var brace = completion_slice(source, s.start, s.end, "{");
            var close = completion_slice(source, s.start, s.end, "}");
            if semi {
                grammar = false;
                q.boundary = s.end;
            }
            if !grammar {
                if brace {
                    q.boundary = s.end;
                }
                if close {
                    q.boundary = s.end;
                }
            }
        }
        i++;
    }
    if grammar {
        q.mode = 2;
    }
    // The normal lexer reports incomplete quotes/comments as invalid tokens.
    // Suppress completion in those unfinished default-language regions too.
    i = 0;
    loop {
        var done = i == count;
        if done {
            break;
        }
        var s = &spans[i];
        done = s.start >= cursor;
        if done {
            break;
        }
        if !s.opaque {
            var byte = source[s.start];
            var quote = byte == 34;
            var single = byte == 39;
            if single {
                quote = true;
            }
            if quote {
                q.hidden = true;
            }
            var slash = byte == 47;
            var next = s.start + 1;
            slash &&= next < length;
            slash &&= source[next] == 42;
            if slash {
                q.hidden = true;
            }
        }
        i++;
    }
    sem_require(bytes_append(&q.recovered, source, length));
    // Blank the unfinished statement without shifting source coordinates. The
    // parser then gives us ordinary shared nodes for the enclosing function.
    var end = length;
    i = 0;
    loop {
        var done = i == count;
        if done {
            break;
        }
        var s = &spans[i];
        var after = s.start >= cursor;
        if after {
            if !s.opaque {
                var close = completion_slice(source, s.start, s.end, "}");
                if close {
                    end = s.start;
                    break;
                }
                var semi = completion_slice(source, s.start, s.end, ";");
                if semi {
                    end = s.end;
                    break;
                }
            }
        }
        i++;
    }
    i = q.boundary;
    loop {
        var done = i >= end;
        if done {
            break;
        }
        var newline = source[i] == 10;
        if !newline {
            q.recovered.data[i] = 32;
        }
        i++;
    }
    var depth: usize = 0;
    i = 0;
    loop {
        var done = i == count;
        if done {
            break;
        }
        var s = &spans[i];
        var kept = s.start < q.boundary;
        var suffix = s.start >= end;
        if suffix {
            kept = true;
        }
        if s.opaque {
            kept = false;
        }
        if kept {
            var open = completion_slice(source, s.start, s.end, "{");
            var close = completion_slice(source, s.start, s.end, "}");
            if open {
                depth++;
            }
            var nested = depth != 0;
            if nested {
                if close {
                    depth--;
                }
            }
        }
        i++;
    }
    // Bounded recovery; deeply malformed input still gets grammar suggestions.
    var bounded = depth < 256;
    if bounded {
        loop {
            var done = depth == 0;
            if done {
                break;
            }
            sem_require(vector_push(u8, &q.recovered, 125));
            depth--;
        }
    }
    sem_require(host_text_terminate(&q.recovered));
    completion_text(&q.output, "{\"from\":");
    sem_require(host_json_unsigned(&q.output, convert(u64, q.from)));
    completion_text(&q.output, ",\"to\":");
    sem_require(host_json_unsigned(&q.output, convert(u64, q.to)));
    completion_text(&q.output, ",\"options\":[");
    return q;
}

fn completion_name(node: void*): u8* {
    var name = sem_member(node, "name");
    loop {
        var single = sem_child_count(name) == 1;
        if !single {
            break;
        }
        name = sem_child(name, 0);
    }
    return sem_label(name);
}

fn completion_fold(byte: u8): u8 {
    var upper = byte >= 65;
    upper &&= byte <= 90;
    if upper {
        byte = byte + 32;
    }
    return byte;
}

export fn completion_offer(q: CompletionQuery*, name: u8*, kind: u8*, detail: u8*, category: u32): void {
    if q.hidden {
        return;
    }
    var editor_condition11 = name == null;
    if editor_condition11 {
        return;
    }
    var keyword = sem_equal(kind, "keyword");
    if !syntax_completion_accepts(q.active, name, keyword) {
        return;
    }
    if sem_equal(kind, "function") {
        if !syntax_completion_callable(q.active) {
            return;
        }
    }
    if keyword {
        var value_literal = sem_equal(name, "true");
        if sem_equal(name, "false") {
            value_literal = true;
        }
        if sem_equal(name, "null") {
            value_literal = true;
        }
        if value_literal {
            if !q.editor.found {
                return;
            }
            var editor_guard_1 = q.editor.kind == 2;
            if editor_guard_1 {
                return;
            }
            if q.editor.require_pointer {
                if !sem_equal(name, "null") {
                    return;
                }
            }
        }
        if q.editor.found {
            var loop_control = sem_equal(name, "break");
            if sem_equal(name, "continue") {
                loop_control = true;
            }
            if loop_control {
                var editor_guard_2 = q.editor.loops == 0;
                if editor_guard_2 {
                    return;
                }
            }
            var module = q.editor.current == q.program.root;
            if !module {
                if sem_equal(name, "fn") {
                    return;
                }
                if sem_equal(name, "struct") {
                    return;
                }
                if sem_equal(name, "enum") {
                    return;
                }
                if sem_equal(name, "export") {
                    return;
                }
                if sem_equal(name, "extern") {
                    return;
                }
            }
        }
        // LR legality is necessary; literal values also obey the expected type.
        if q.editor.found {
            if q.editor.has_expected {
                var boolean = sem_equal(name, "true");
                if sem_equal(name, "false") {
                    boolean = true;
                }
                if boolean {
                    var editor_condition12 = q.editor.type.scalar != SBool();
                    if editor_condition12 {
                        return;
                    }
                    var editor_condition13 = q.editor.type.pointers != 0;
                    if editor_condition13 {
                        return;
                    }
                }
                if sem_equal(name, "null") {
                    var editor_condition14 = q.editor.type.pointers == 0;
                    if editor_condition14 {
                        return;
                    }
                }
            }
        }
    } else {
        var editor_condition15 = category != 2;
        if editor_condition15 {
            if !q.editor.found {
                return;
            }
        }
    }
    var mode = q.mode;
    if keyword {
        mode = 4;
    }
    if q.editor.found {
        if !keyword {
            mode = 0;
            var editor_condition16 = q.editor.kind == 2;
            if editor_condition16 {
                mode = 1;
            }
            var editor_condition17 = q.editor.kind == 3;
            var enum_members = q.editor.kind == EditorEnumMembers();
            if enum_members {
                editor_condition17 = true;
            }
            if editor_condition17 {
                mode = 3;
            }
        }
    }
    var field = mode == 3;
    if field {
        var wrong = category != 3;
        if wrong {
            return;
        }
    }
    var grammar = mode == 2;
    if grammar {
        var wrong = category != 2;
        if wrong {
            return;
        }
    }
    var typed = mode == 1;
    if typed {
        var wrong = category != 1;
        if wrong {
            return;
        }
    }
    var ordinary = mode == 0;
    if ordinary {
        var wrong = category == 2;
        var member = category == 3;
        if member {
            wrong = true;
        }
        var editor_condition18 = category == 1;
        if editor_condition18 {
            wrong = true;
        }
        if wrong {
            return;
        }
    }
    var size = sem_length(name);
    var empty = size == 0;
    if empty {
        return;
    }
    var prefix = q.cursor - q.from;
    var short = size < prefix;
    if short {
        return;
    }
    var i: usize = 0;
    loop {
        var done = i == prefix;
        if done {
            break;
        }
        var at = q.from + i;
        var same = completion_fold(name[i]) == completion_fold(q.source[at]);
        if !same {
            return;
        }
        i++;
    }
    i = 0;
    loop {
        var done = i == q.names.length;
        if done {
            break;
        }
        var duplicate = sem_equal(name, q.names.data[i]);
        if duplicate {
            return;
        }
        i++;
    }
    var limit = q.count >= 128;
    if limit {
        return;
    }
    sem_require(vector_push(u8*, &q.names, name));
    var comma = q.count != 0;
    if comma {
        completion_text(&q.output, ",");
    }
    completion_text(&q.output, "{\"label\":");
    sem_require(host_json_quote(&q.output, name, size));
    completion_text(&q.output, ",\"type\":");
    sem_require(host_json_quote(&q.output, kind, sem_length(kind)));
    completion_text(&q.output, ",\"detail\":");
    sem_require(host_json_quote(&q.output, detail, sem_length(detail)));
    completion_text(&q.output, "}");
    q.count++;
}

fn completion_semantic_node(q: CompletionQuery*, node: void*, kind: u8*, category: u32): void {
    var value = sem_get(node);
    var editor_condition19 = value == null;
    if editor_condition19 {
        return;
    }
    if sem_equal(kind, "variable") {
        var name = sem_name(value);
        var i: usize = 0;
        loop {
            var editor_guard_3 = i == q.bindings.length;
            if editor_guard_3 {
                break;
            }
            if sem_equal(name, q.bindings.data[i]) {
                return;
            }
            i++;
        }
        sem_require(vector_push(u8*, &q.bindings, name));
    }
    var editor_condition20 = category != 1;
    if editor_condition20 {
        if q.editor.value_required {
            var editor_guard_4 = value.type.pointers == 0;
            if editor_guard_4 {
                var editor_guard_5 = value.type.scalar == SVoid();
                if editor_guard_5 {
                    return;
                }
            }
        }
        if q.editor.require_pointer {
            var editor_guard_6 = value.type.pointers == 0;
            if editor_guard_6 {
                return;
            }
        }
        if q.editor.require_integer {
            if !semantic_integer(&value.type) {
                return;
            }
            if semantic_enum(&value.type) {
                return;
            }
        }
        if q.editor.has_expected {
            if !semantic_type_equal(&value.type, &q.editor.type) {
                return;
            }
        }
    }
    var name = sem_name(value);
    // Source identifiers keep their compilable quoted spelling when present.
    var syntax_name = completion_name(node);
    var editor_condition21 = syntax_name != null;
    if editor_condition21 {
        var editor_condition22 = syntax_name[0] != 0;
        if editor_condition22 {
            name = syntax_name;
        }
    }
    completion_offer(q, name, kind, sem_type_name(&q.context, &value.type), category);
}

fn completion_table(q: CompletionQuery*, table: SemanticTable*, kind: u8*, category: u32): void {
    var scope: SemanticScope;
    scope.parent = null;
    scope.names = table;
    var nodes: vector(void*);
    vector_init(void*, &nodes);
    sem_scope_locals(&q.context, &scope, &nodes);
    var i: usize = 0;
    loop {
        var editor_condition23 = i == nodes.length;
        if editor_condition23 {
            break;
        }
        var candidate = nodes.data[i];
        var lexical = table == q.context.functions;
        lexical ||= table == q.context.globals;
        lexical ||= table == q.context.types;
        var visible = true;
        if lexical {
            visible = sem_completion_visible(&q.context, &q.editor, table, candidate);
        }
        if visible {
            completion_semantic_node(q, candidate, kind, category);
        }
        i++;
    }
    vector_dispose(void*, &nodes);
}

fn completion_templates(q: CompletionQuery*, table: SemanticTable*, kind: u8*, detail: u8*, category: u32): void {
    var scope: SemanticScope;
    scope.parent = null;
    scope.names = table;
    var nodes: vector(void*);
    vector_init(void*, &nodes);
    sem_scope_locals(&q.context, &scope, &nodes);
    var i: usize = 0;
    loop {
        var done = i == nodes.length;
        if done {
            break;
        }
        var node = nodes.data[i];
        var eligible = sem_completion_visible(&q.context, &q.editor, table, node);
        var function = category == 0;
        if function {
            // Resolve return annotations with the ordinary type resolver when
            // possible. An unbound type parameter remains unknown, never guessed.
            q.program.error.length = 0;
            var result = sem_type(&q.context, sem_member(node, "type"));
            var known = sem_ok(&q.context);
            q.program.error.length = 0;
            if known {
                if q.editor.value_required {
                    var is_void = result.scalar == SVoid();
                    is_void &&= result.pointers == 0;
                    if is_void {
                        eligible = false;
                    }
                }
                if q.editor.has_expected {
                    eligible &&= semantic_type_equal(result, &q.editor.type);
                }
                if q.editor.require_pointer {
                    var pointer = result.pointers != 0;
                    if !pointer {
                        eligible = false;
                    }
                }
            }
        }
        if eligible {
            completion_offer(q, completion_name(node), kind, detail, category);
        }
        i++;
    }
    vector_dispose(void*, &nodes);
}

export fn completion_symbols(q: CompletionQuery*): void {
    if !q.editor.found {
        return;
    }
    var qualified_namespace = q.editor.module != null;
    if !qualified_namespace {
        var owner = sem_owner(&q.context, q.editor.node);
        var imports = sem_child_count(owner);
        var i: usize = 0;
        var category: u32 = 0;
        var types = q.editor.kind == 2;
        if types {
            category = 1;
        }
        while i < imports {
            var name = sem_import_alias(owner, i);
            var named = name[0] != 0;
            if named {
                completion_offer(q, name, "namespace", "module", category);
            }
            i++;
        }
    }
    var editor_condition24 = q.editor.kind == 2;
    if editor_condition24 {
        completion_table(q, q.context.types, "type", 1);
        completion_templates(q, q.context.type_functions, "type", "type function", 1);
        return;
    }
    var editor_condition25 = q.editor.kind == 3;
    var enum_members = q.editor.kind == EditorEnumMembers();
    if enum_members {
        editor_condition25 = true;
    }
    if editor_condition25 {
        var editor_condition26 = q.editor.receiver.scalar != SStruct();
        if enum_members {
            editor_condition26 = semantic_enum(&q.editor.receiver) == false;
        }
        if editor_condition26 {
            return;
        }
        var editor_condition27 = q.editor.receiver.pointers > 1;
        if editor_condition27 {
            return;
        }
        var record = sem_get(q.editor.receiver.record);
        var editor_condition28 = record == null;
        if editor_condition28 {
            return;
        }
        var i: usize = 0;
        loop {
            var editor_condition29 = i == record.items.length;
            if editor_condition29 {
                break;
            }
            completion_semantic_node(q, record.items.data[i], "property", 3);
            i++;
        }
        return;
    }
    var editor_condition30 = q.editor.kind != 4;
    var qualified = q.editor.module != null;
    if editor_condition30 {
        var scope = q.editor.scope;
        if qualified {
            scope = null;
        }
        loop {
            var editor_condition31 = scope == null;
            if editor_condition31 {
                break;
            }
            completion_table(q, scope.names, "variable", 0);
            scope = scope.parent;
        }
        completion_table(q, q.context.globals, "variable", 0);
    }
    completion_table(q, q.context.functions, "function", 0);
    completion_templates(q, q.context.templates, "function", "generic function", 0);
    if qualified {
        return;
    }
    var i: usize = 0;
    loop {
        var builtin = semantic_builtin_at(i);
        var editor_condition32 = builtin == 0;
        if editor_condition32 {
            break;
        }
        var eligible: bool = true;
        if q.editor.value_required {
            var editor_guard_7 = builtin == KPrint();
            if editor_guard_7 {
                eligible = false;
            }
            var editor_guard_8 = builtin == KFree();
            if editor_guard_8 {
                eligible = false;
            }
            var editor_guard_9 = builtin == KCopy();
            if editor_guard_9 {
                eligible = false;
            }
            var editor_guard_10 = builtin == KFill();
            if editor_guard_10 {
                eligible = false;
            }
        }
        if q.editor.require_pointer {
            eligible = builtin == KAllocate();
            var editor_guard_11 = builtin == KReallocate();
            if editor_guard_11 {
                eligible = true;
            }
            var editor_guard_12 = builtin == KBits();
            if editor_guard_12 {
                eligible = true;
            }
        }
        if q.editor.has_expected {
            // Void operations cannot supply a required value. Polymorphic
            // operations retain their normal semantic checks after insertion.
            var editor_condition33 = builtin == KPrint();
            if editor_condition33 {
                eligible = false;
            }
            var editor_condition34 = builtin == KFree();
            if editor_condition34 {
                eligible = false;
            }
            var editor_condition35 = builtin == KCopy();
            if editor_condition35 {
                eligible = false;
            }
            var editor_condition36 = builtin == KFill();
            if editor_condition36 {
                eligible = false;
            }
            var editor_condition37 = builtin == KSizeOf();
            if editor_condition37 {
                eligible = q.editor.type.scalar == SUSize();
                var editor_condition38 = q.editor.type.pointers != 0;
                if editor_condition38 {
                    eligible = false;
                }
            }
            var editor_condition39 = builtin == KAlignOf();
            if editor_condition39 {
                eligible = q.editor.type.scalar == SUSize();
                var editor_condition40 = q.editor.type.pointers != 0;
                if editor_condition40 {
                    eligible = false;
                }
            }
            var editor_condition41 = builtin == KAllocate();
            if editor_condition41 {
                eligible = q.editor.type.pointers != 0;
            }
            var editor_condition42 = builtin == KReallocate();
            if editor_condition42 {
                eligible = q.editor.type.pointers != 0;
            }
        }
        var label = builtin == KLabel();
        var jump = builtin == KJump();
        var control = label;
        if jump {
            control = true;
        }
        if control {
            var module_scope = q.editor.current == q.program.root;
            if module_scope {
                eligible = false;
            }
            if label {
                var nested = q.editor.blocks != 1;
                if nested {
                    eligible = false;
                }
            }
            if jump {
                var missing = q.context.labels == null;
                if missing {
                    eligible = false;
                } else {
                    var empty = q.context.labels.count == 0;
                    if empty {
                        eligible = false;
                    }
                }
            }
        }
        var no_value = control;
        var trapping = builtin == KTrap();
        if trapping {
            no_value = true;
        }
        if no_value {
            if q.editor.value_required {
                eligible = false;
            }
            if q.editor.has_expected {
                eligible = false;
            }
        }
        if eligible {
            completion_offer(q, semantic_builtin_name(builtin), "function", "foundation operation", 0);
        }
        i++;
    }
}

export fn completion_end(q: CompletionQuery*): u8* {
    completion_text(&q.output, "]}");
    sem_require(host_text_terminate(&q.output));
    return q.output.data;
}

export fn completion_dispose(q: CompletionQuery*): void {
    language_grammar_dispose(q);
    if q.analyzed {
        sem_context_dispose(&q.context);
    }
    if q.semantic {
        semantic_program_dispose(&q.program);
        entity_release(q.program.root);
    }
    var retained = q.inspection_session != null;
    if retained {
        syntax_destroy(q.inspection_session);
    }
    vector_dispose(void*, &q.comment_modules);
    vector_dispose(usize, &q.comment_bases);
    vector_dispose(u8, &q.input);
    vector_dispose(void*, &q.roots);
    vector_dispose(usize, &q.bases);
    vector_dispose(u8, &q.recovered);
    vector_dispose(u8*, &q.names);
    vector_dispose(u8*, &q.bindings);
    vector_dispose(u8, &q.output);
    free(q);
}
