// Lexical mutation/escape facts do not require storage layout or initializer
// values. The proof binds syntax to declaration identities, including shadows,
// before a type consumer can require an immutable initializer from its own body.


extern fn entity_query_count(kind: void*): usize;
extern fn entity_query_at(kind: void*, index: usize): void*;

export fn sem_source_binding(c: SemanticContext*, subject: void*): SemanticSourceBinding* {
    var result = c.source_bindings == null ? null : bits(SemanticSourceBinding*,
        entity_component_data(entity_component_get(subject, c.source_bindings)));
    return result != null && result.query != 0 ? result : null;
}

fn sem_source_place(c: SemanticContext*, node: void*): void* {
    node = sem_surface_unwrap(node);
    while node != null {
        var module = sem_namespace(c, node);
        if module != null {
            return sem_owned(c.globals, module, sem_identifier(c, sem_member(node, "field")));
        }
        var base = sem_member(node, "base");
        if base != null { node = sem_surface_unwrap(base); continue; }
        var name = sem_member(node, "name");
        if name != null { node = name; continue; }
        if sem_child_count(node) == 0 {
            var text = sem_identifier(c, node);
            var scope = c.scope;
            while scope != null {
                var entry = sem_find(scope.names, text, null);
                if entry != null { return entry.value; }
                scope = scope.parent;
            }
            return sem_resolve(c, c.globals, node, text);
        }
        if sem_child_count(node) != 1 { return null; }
        node = sem_surface_unwrap(sem_child(node, 0));
    }
    return null;
}

fn sem_source_write(c: SemanticContext*, job: SemanticKnownWork*, place: void*): void {
    var declaration = sem_source_place(c, place);
    if declaration != null { sem_push(&job.mutations, declaration); return; }
    // Composite places can select a binding or expose it through an address.
    // Conservatively retain every possible written/escaped declaration.
    for(var i: usize = 0; i < sem_child_count(place); i++) {
        sem_source_write(c, job, sem_child(place, i));
    }
}

fn sem_source_bind(c: SemanticContext*, node: void*): void {
    var name = sem_member(node, "name");
    if name == null { return; }
    // Ordinary checking retains responsibility for duplicate-name diagnostics.
    // Retain the first lexical identity just as its declaration would bind.
    sem_put(c, c.scope.names, sem_identifier(c, name), node);
}

fn sem_source_scan(c: SemanticContext*, job: SemanticKnownWork*, node: void*, depth: usize): void {
    if node == null { return; }
    if depth > SourceBindingDepthLimit { job.binding_incomplete = true; return; }
    if sem_is(node, "Statement") {
        node = sem_unwrap(node);
        if sem_function_syntax(node) { return; }
        // Extension statements need an explicit binding/effect contract before
        // they can establish early immutability. Preserve the local-proof
        // admission rule even though global and local captures share this scan.
        if !sem_is(node, "CoreBlock") && !sem_is(node, "CoreDeclare")
            && !sem_is(node, "CoreIf") && !sem_is(node, "CoreLoop")
            && !sem_is(node, "TowerWhile") && !sem_is(node, "TowerFor")
            && !sem_is(node, "TowerForeach") && !sem_is(node, "TowerMatch")
            && !sem_is(node, "TowerDefer") && !sem_is(node, "CoreAssign")
            && !sem_is(node, "TowerExpressionStatement") && !sem_is(node, "CoreCallStatement")
            && !sem_is(node, "CoreReturn") && !sem_is(node, "CoreBreak")
            && !sem_is(node, "CoreContinue") && !sem_is(node, "CoreStruct")
            && !sem_is(node, "CoreEnum") {
            job.binding_incomplete = true;
        }
    }
    if sem_is(node, "CoreFunction") || sem_is(node, "CoreExport") || sem_is(node, "CoreExternal") { return; }
    if sem_is(node, "CoreBlock") || sem_is(node, "TowerFor") || sem_is(node, "TowerForeach") {
        var previous = c.scope;
        c.scope = sem_scope(c, previous);
        if sem_is(node, "TowerForeach") {
            sem_source_scan(c, job, sem_member(node, "source"), depth + 1);
            sem_source_bind(c, node);
            sem_source_scan(c, job, sem_member(node, "body"), depth + 1);
        } else {
            if sem_is(node, "TowerFor") {
                sem_source_scan(c, job, sem_member(node, "initial"), depth + 1);
                sem_source_scan(c, job, sem_member(node, "condition"), depth + 1);
                sem_source_scan(c, job, sem_member(node, "step"), depth + 1);
                sem_source_scan(c, job, sem_member(node, "body"), depth + 1);
            } else {
                for(var i: usize = 0; i < sem_child_count(node); i++) {
                    sem_source_scan(c, job, sem_child(node, i), depth + 1);
                }
            }
        }
        c.scope = previous;
        return;
    }
    if sem_is(node, "CoreDeclare") {
        if job.owner != null { sem_source_bind(c, node); }
        var candidate: SemanticKnownCandidate = { subject: node, ordinal: job.source_ordinal++ };
        sem_require(vector_push(&job.candidates, candidate));
    }
    if sem_is(node, "CoreAssign") { sem_source_write(c, job, sem_member(node, "target")); }
    if sem_is(node, "CoreAddress") { sem_source_write(c, job, sem_member(node, "name")); }
    if sem_is(node, "TowerExpression") {
        var left = sem_member(node, "left");
        var right = sem_member(node, "right");
        if left != null || right != null {
            var operation = sem_surface_operator(c, node, left);
            if sem_equal(operation, "++") || sem_equal(operation, "--")
                || left == null && sem_equal(operation, "&") {
                sem_source_write(c, job, left ?? right);
            } else {
                if left != null && (sem_equal(operation, "=") || sem_surface_compound(operation)) {
                    sem_source_write(c, job, left);
                }
            }
        }
    }
    for(var i: usize = 0; i < sem_child_count(node); i++) {
        sem_source_scan(c, job, sem_child(node, i), depth + 1);
    }
}

// This bounds analysis scratch consistently with the compiler's accepted tree
// nesting. A truncated proof never establishes immutability.
var SourceBindingDepthLimit: usize = 1024;

fn semantic_source_binding_kernel(job: SemanticKnownWork*): void {
    var context: SemanticContext;
    sem_context_snapshot(&context, job.context);
    var program = *context.program;
    context.program = &program;
    program.error = default;
    context.allocations = default;
    context.lists = default;
    context.token_text = default;
    context.scan = default;
    context.query_reads = &job.query_reads;
    context.scope = sem_scope(&context, null);
    if job.owner != null {
        var parameters = sem_collect(&context, sem_member(job.owner, "params"), "CoreParameter");
        foreach(var parameter in parameters) { sem_source_bind(&context, parameter); }
        sem_source_scan(&context, job, sem_member(job.owner, "body"), 0);
    } else {
        var pipeline = bits(SemanticSourceBindingPipeline*, entity_component_data(
            entity_component_get(job.root, context.source_binding_pipeline)));
        sem_require(pipeline != null && pipeline.roots_ready);
        foreach(var node in &pipeline.source_roots) { sem_source_scan(&context, job, node, 0); }
    }
    job.binding_incomplete ||= !sem_ok(&context);
    if job.resource_error == WorkBudgetError.None { job.resource_error = program.resource.error; }
    vector_dispose(&program.error);
    stack_dispose(&context.scan);
    vector_dispose(&context.token_text);
    foreach(var list in &context.lists) { vector_dispose(bits(vector(void*)*, list)); }
    vector_dispose(&context.lists);
    foreach(var allocation in &context.allocations) { compiler_buffer_free(allocation); }
    vector_dispose(&context.allocations);
}

fn sem_source_bindings_prepare(c: SemanticContext*, jobs: vector(SemanticKnownWork*)*, extension: bool): void {
    // Reserve every payload before publishing any immutable fact. Default
    // components carry no query and are invisible to proof consumers.
    foreach(var job in jobs) {
        foreach(var &candidate in &job.candidates) {
            if entity_component_get(candidate.subject, c.source_bindings) != null { continue; }
            var error: WorkBudgetError;
            var binding = bits(SemanticSourceBinding*, entity_component_data(entity_component_add_result(candidate.subject, c.source_bindings, &error)));
            if binding == null { sem_known_admission_error(c, candidate.subject, error); return; }
            *binding = default;
        }
    }
    foreach(var job in jobs) {
        foreach(var declaration in &job.mutations) {
            var binding = sem_source_binding(c, declaration);
            if binding != null && binding.immutable && extension && binding.owner != job.owner {
                // A specialization must not invalidate a completed proof which
                // a preceding staged result may already have consumed.
                sem_fail(c, declaration, "Specialization invalidates a published binding proof");
                return;
            }
        }
    }
}

fn sem_source_bindings_publish(c: SemanticContext*, jobs: vector(SemanticKnownWork*)*): void {
    var complete = true;
    foreach(var job in jobs) { complete &&= !job.binding_incomplete; }
    foreach(var job in jobs) {
        var query = work_find(&c.queries, job.subject, convert(u32, SemanticQuery.SourceBindings), 0);
        foreach(var &candidate in &job.candidates) {
            var binding = bits(SemanticSourceBinding*, entity_component_data(entity_component_get(candidate.subject, c.source_bindings)));
            *binding = { owner: job.owner, query: query, ordinal: candidate.ordinal, immutable: complete };
        }
    }
    foreach(var job in jobs) {
        foreach(var declaration in &job.mutations) {
            var binding = sem_source_binding(c, declaration);
            if binding != null { binding.immutable = false; }
        }
    }
}

// Runtime lowering may remove effect statements from its executable item list.
// Retain their original ordered syntax identities before that list can change;
// the program owns every referenced tree until this derived index is disposed.
fn sem_source_binding_roots(c: SemanticContext*): void {
    if !sem_ok(c) { return; }
    if c.source_bindings == null {
        var error: WorkBudgetError;
        var kind = sem_kind_result(c.program.root, sizeof(SemanticSourceBinding), alignof(SemanticSourceBinding), &error);
        if kind == null { sem_known_admission_error(c, c.program.root, error); return; }
        var pipeline_kind = sem_kind_result(c.program.root, sizeof(SemanticSourceBindingPipeline), alignof(SemanticSourceBindingPipeline), &error);
        if pipeline_kind == null {
            sem_require(entity_attach_result(kind, null, null) == WorkBudgetError.None);
            sem_known_admission_error(c, c.program.root, error); return;
        }
        c.source_bindings = kind;
        c.source_binding_pipeline = pipeline_kind;
    }
    var pipeline = bits(SemanticSourceBindingPipeline*, entity_component_data(entity_component_get(c.program.root, c.source_binding_pipeline)));
    if pipeline != null { return; }
    var error: WorkBudgetError;
    pipeline = bits(SemanticSourceBindingPipeline*, entity_component_data(entity_component_add_result(c.program.root, c.source_binding_pipeline, &error)));
    if pipeline == null { sem_known_admission_error(c, c.program.root, error); return; }
    *pipeline = default;
    if !vector_reserve(&pipeline.source_roots, sem_get(c.program.root).items.length) {
        sem_known_admission_error(c, c.program.root, WorkBudgetError.Memory); return;
    }
    foreach(var node in &sem_get(c.program.root).items) { sem_push(&pipeline.source_roots, node); }
    pipeline.roots_ready = true;
}

fn sem_source_bindings_begin(c: SemanticContext*, owner: void*): usize {
    var subject = owner ?? c.program.root;
    var existing = work_find(&c.queries, subject, convert(u32, SemanticQuery.SourceBindingProof), 0);
    if existing != 0 { return existing; }
    sem_source_binding_roots(c);
    if !sem_ok(c) { return 0; }
    var pipeline = bits(SemanticSourceBindingPipeline*, entity_component_data(entity_component_get(subject, c.source_binding_pipeline)));
    if pipeline == null {
        var error: WorkBudgetError;
        pipeline = bits(SemanticSourceBindingPipeline*, entity_component_data(entity_component_add_result(subject, c.source_binding_pipeline, &error)));
        if pipeline == null { sem_known_admission_error(c, subject, error); return 0; }
        *pipeline = default;
    }
    pipeline.extension = owner != null;
    var kind = sem_known_kind(c);
    var count: usize = 0;
    if owner != null {
        sem_known_job(c, kind, owner, owner, owner, count++, SemanticKnownAction.Bind);
    } else {
        foreach(var function in &c.program.functions) {
            sem_known_job(c, kind, function, function, function == c.program.root ? null : function, count++, SemanticKnownAction.Bind);
        }
        foreach(var function in &c.template_nodes) {
            sem_known_job(c, kind, function, function, function, count++, SemanticKnownAction.Bind);
        }
    }
    pipeline.jobs = sem_known_jobs_begin(c, kind, count, SemanticQuery.SourceBindings);
    if !sem_ok(c) { return 0; }
    pipeline.query = work_request(&c.queries, subject, convert(u32, SemanticQuery.SourceBindingProof), 0);
    if !sem_known_query_check(c, subject, pipeline.query != 0) { return 0; }
    foreach(var job in &pipeline.jobs) {
        if !sem_known_query_check(c, subject, work_depend(&c.queries, pipeline.query,
            work_find(&c.queries, job.subject, convert(u32, SemanticQuery.SourceBindings), 0))) { return 0; }
    }
    if !sem_known_query_check(c, subject, work_seal(&c.queries, pipeline.query)) { return 0; }
    if owner == null { c.source_binding_proof = pipeline.query; }
    return pipeline.query;
}

export fn sem_source_binding_request(c: SemanticContext*, subject: void*): usize {
    if !sem_ok(c) || !work_ok(&c.queries) { return 0; }
    if c.source_binding_proof == 0 { return sem_source_bindings_begin(c, null); }
    if work_task(&c.queries, c.source_binding_proof).state != WorkState.Succeeded { return c.source_binding_proof; }
    var binding = sem_source_binding(c, subject);
    if binding != null || sem_get(subject).global { return c.source_binding_proof; }
    foreach(var function in &c.program.functions) {
        foreach(var local in &sem_get(function).locals) {
            if local == subject {
                if work_find(&c.queries, function, convert(u32, SemanticQuery.SourceBindings), 0) != 0 {
                    var query = work_find(&c.queries, function, convert(u32, SemanticQuery.SourceBindingProof), 0);
                    return query == 0 ? c.source_binding_proof : query;
                }
                return sem_source_bindings_begin(c, function);
            }
        }
    }
    return c.source_binding_proof;
}

export fn sem_source_bindings_pump(c: SemanticContext*): SemanticPumpResult {
    if !sem_ok(c) || !work_ok(&c.queries) { return SemanticPumpResult.Failed; }
    if c.source_binding_pipeline == null { return SemanticPumpResult.Complete; }
    var waiting = false;
    for(var index: usize = 0; index < entity_query_count(c.source_binding_pipeline); index++) {
        var pipeline = bits(SemanticSourceBindingPipeline*, entity_component_data(entity_query_at(c.source_binding_pipeline, index)));
        if pipeline.query == 0 || pipeline.published || !work_task(&c.queries, pipeline.query).demanded { continue; }
        var state = sem_known_jobs_pump(c, &pipeline.jobs, SemanticQuery.SourceBindings, &pipeline.first);
        if state == SemanticPumpResult.Progress || state == SemanticPumpResult.Failed { return state; }
        if state == SemanticPumpResult.Waiting { waiting = true; continue; }
        var ticket: WorkTicket;
        var subject = work_task(&c.queries, pipeline.query).subject;
        if !work_take_task(&c.queries, &ticket, pipeline.query) {
            if !sem_known_query_check(c, subject, work_ok(&c.queries)) { return SemanticPumpResult.Failed; }
            waiting = true;
            continue;
        }
        sem_source_bindings_prepare(c, &pipeline.jobs, pipeline.extension);
        var finished = work_finish(&c.queries, &ticket, sem_ok(c));
        if finished && sem_ok(c) { sem_source_bindings_publish(c, &pipeline.jobs); }
        // Retire joined owners even if completing the proof cannot enqueue its
        // consumers. No immutable fact precedes that terminal graph receipt.
        pipeline.published = true;
        sem_known_jobs_dispose(&pipeline.jobs);
        if !sem_known_query_check(c, subject, finished) { return SemanticPumpResult.Failed; }
        return sem_ok(c) ? SemanticPumpResult.Progress : SemanticPumpResult.Failed;
    }
    return waiting ? SemanticPumpResult.Waiting : SemanticPumpResult.Complete;
}

fn sem_source_bindings_dispose(c: SemanticContext*): void {
    if c.source_binding_pipeline == null { return; }
    for(var index: usize = 0; index < entity_query_count(c.source_binding_pipeline); index++) {
        var pipeline = bits(SemanticSourceBindingPipeline*, entity_component_data(entity_query_at(c.source_binding_pipeline, index)));
        sem_known_jobs_dispose(&pipeline.jobs);
        vector_dispose(&pipeline.source_roots);
    }
}
