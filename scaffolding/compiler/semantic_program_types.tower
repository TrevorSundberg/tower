import tower;
import .library.vector;
import .library.work_budget_types;

struct SemanticModules {
    root: void*;
    owner_kind: void*;
    import_kind: void*;
    scopes: void*;
}

struct FrontendSource {
    data: u8*;
    length: usize;
}

// A fixed receipt survives optional diagnostic recovery. The owning pipeline
// selects source order; clearing presentation text never clears this failure.
struct SemanticResourceFailure { error: WorkBudgetError; offset: usize; }

struct SemanticProgram {
    pointer_bytes: u32;
    root: void*;
    functions: vector(void*);
    types: vector(void*);
    error: vector(u8);
    error_offset: usize;
    modules: SemanticModules*;
    resource: SemanticResourceFailure;
    test_mode: bool;
    test_count: usize;
}
