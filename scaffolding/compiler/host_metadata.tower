import tower;
import host_parser_components;
import host_provenance;
import component_kinds;
import entity_require;
import host_world;
import parser_types;
import world;
import .library.entities;
import .library.entity_types;
import .library.entity_stage;
import syntax_provenance;
import .library.vector;
import .library.work_budget_types;

extern fn syntax_identifier_decode_in_place(text: u8*, length: usize): usize;

export fn sem_match(node: Entity*): ParserMatchData* {
    return bits(ParserMatchData*, compiler_node_get(node, CompilerParserMatch));
}

fn metadata_text_equal(left: u8*, right: u8*): bool {
    var index: usize = 0;
    loop {
        if left[index] != right[index] {
            return false;
        }
        if left[index] == 0 {
            return true;
        }
        index++;
    }
}

// The usual identifier is a single terminal beneath wrappers. Compare its
// borrowed spelling directly; quoted or composite names use the shared decoder.
fn metadata_plain_name(node: Entity*): u8* {
    loop {
        if node == null {
            return "";
        }
        var span = sem_match(node);
        if span != null {
            var invalid: usize = 0;
            invalid--;
            if span.rule == invalid {
                var label = parser_match_get_label(span);
                if label[0] == 96 {
                    return null;
                }
                return label;
            }
        }
        if entity_child_count(node) == 1 {
            node = entity_child_at(node, 0);
        } else {
            return null;
        }
    }
}

fn metadata_name(node: Entity*, text: vector(u8)*): void {
    var pending: vector(Entity*);
    vector_init(&pending);
    vector_init(text);
    if node != null {
        compiler_entity_require(vector_push(&pending, node));
    }
    while pending.length != 0 {
        pending.length--;
        var current = pending.data[pending.length];
        var span = sem_match(current);
        var terminal = span != null;
        if terminal {
            var invalid: usize = 0;
            invalid--;
            terminal = span.rule == invalid;
        }
        if terminal {
            var label = parser_match_get_label(span);
            for(var index: usize = 0; label[index] != 0; index++) {
                compiler_entity_require(vector_push(text, label[index]));
            }
        } else {
            var count = entity_child_count(current);
            while count != 0 {
                count--;
                compiler_entity_require(vector_push(&pending, entity_child_at(current, count)));
            }
        }
    }
    vector_dispose(&pending);
    var length = text.length;
    compiler_entity_require(vector_push(text, 0));
    text.length = syntax_identifier_decode_in_place(text.data, length);
}

export fn compiler_node_label(node: Entity*, label: u8*): bool {
    var span = sem_match(node);
    if span == null {
        return false;
    }
    return metadata_text_equal(parser_match_get_label(span), label);
}

export fn compiler_name_is(node: Entity*, name: u8*): bool {
    var plain = metadata_plain_name(node);
    if plain != null {
        return metadata_text_equal(plain, name);
    }
    var text: vector(u8);
    metadata_name(node, &text);
    var equal = metadata_text_equal(text.data, name);
    vector_dispose(&text);
    return equal;
}

export fn compiler_name_equal(left: Entity*, right: Entity*): bool {
    var a = metadata_plain_name(left);
    var b = metadata_plain_name(right);
    var plain = a != null;
    plain &&= b != null;
    if plain {
        return metadata_text_equal(a, b);
    }
    var x: vector(u8);
    var y: vector(u8);
    metadata_name(left, &x);
    metadata_name(right, &y);
    var equal = x.length == y.length;
    for(var index: usize = 0; index < x.length; index++) {
        equal &&= x.data[index] == y.data[index];
    }
    vector_dispose(&x);
    vector_dispose(&y);
    return equal;
}

export fn compiler_node_copy_metadata(source: Entity*, destination: Entity*): void {
    compiler_entity_require(compiler_node_copy_metadata_result(source, destination) == WorkBudgetError.None);
}

// Callers discard an incomplete destination on failure. Successful component
// admission may remain cached; the result is private to this copy operation.
export fn compiler_node_copy_metadata_result(source: Entity*, destination: Entity*): WorkBudgetError {
    if source == null || destination == null || source.store != destination.store { return WorkBudgetError.Invalid; }
    var world = compiler_node_world(source);
    // Standalone entity cloning has no compiler metadata to copy.
    if world == null || source == destination { return WorkBudgetError.None; }
    if source.stage != null || destination.stage != null || world.store.views != 0 { return WorkBudgetError.Busy; }
    var span = sem_match(source);
    if span != null {
        var error = WorkBudgetError.None;
        var target = bits(ParserMatchData*, compiler_world_component_result(world, destination, CompilerParserMatch, &error));
        if target == null { return error; }
        if !node_match_set_label(target, parser_match_get_label(span)) { return WorkBudgetError.Memory; }
        target.id = span.id;
        target.start = span.start;
        target.length = span.length;
        target.rule = span.rule;
    }
    return syntax_origin_copy_result(world, source, destination);
}


// Fallible worker copy into a new staged syntax node. The source guarantees its
// component types already exist in this explicit world; no registration occurs.
export fn compiler_node_copy_metadata_staged(source: Entity*, destination: Entity*, stage: EntityStage*): bool {
    return compiler_node_copy_metadata_staged_result(source, destination, stage) == WorkBudgetError.None;
}

export fn compiler_node_copy_metadata_staged_result(source: Entity*, destination: Entity*, stage: EntityStage*): WorkBudgetError {
    var world = compiler_node_world(source);
    if world == null || destination == null || stage == null || stage.anchor == null
        || stage.anchor.store != world.store || destination.store != world.store
        || destination.stage != bits(void*, stage) || destination.id != 0 { return WorkBudgetError.Invalid; }
    var span = sem_match(source);
    if span != null {
        var error = WorkBudgetError.None;
        var target = bits(ParserMatchData*, compiler_world_component_result(world, destination, CompilerParserMatch, &error));
        if target == null { return error; }
        if !node_match_set_label(target, parser_match_get_label(span)) { return WorkBudgetError.Memory; }
        target.id = span.id;
        target.start = span.start;
        target.length = span.length;
        target.rule = span.rule;
    }
    return syntax_origin_copy_staged_result(world, source, destination, stage);
}
