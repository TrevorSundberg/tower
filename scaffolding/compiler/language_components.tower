extern fn entity_component_at(node: void*, index: usize): void*;

extern fn entity_component_type(component: void*): void*;

// Explain the concept using checked metadata, without repeating the signature.
fn language_function_description(value: FoundationNode*): u8* {
    var inputs = value.parameters.length != 0;
    var no_result = value.type.scalar == SVoid;
    no_result &&= value.type.pointers == 0;
    if inputs {
        if no_result {
            return "Reusable code you run by calling its name. Parameters are the named inputs you supply; void means it finishes without returning a value.";
        }
        return "Reusable code you run by calling its name. Parameters are the named inputs you supply; return sends a result back to the code that called it.";
    }
    if no_result {
        return "Reusable code you run by calling its name. It takes no inputs; void means it finishes without returning a value.";
    }
    return "Reusable code you run by calling its name. It takes no inputs; return sends a result back to the code that called it.";
}

fn language_declaration_description(value: FoundationNode*): u8* {
    var selected = value.kind == KFunction;
    if selected {
        return language_function_description(value);
    }
    selected = value.kind == KDeclare;
    if selected {
        return "A named place to store a value. You can read it or change it later by assigning a new value.";
    }
    selected = value.kind == KParameter;
    if selected {
        return "A named input to the function. Each call supplies a value for this parameter; the function uses this name to read that value.";
    }
    selected = value.kind == KFieldDeclaration;
    if selected {
        return "A named part of a struct. Each value of that struct has its own copy of this field, which you access with a dot.";
    }
    selected = value.kind == KType;
    if selected {
        return language_type_description(value);
    }
    return null;
}

// Component presenters consume resolved compiler data. They never inspect the
// hovered token's spelling or decide which source positions get a tree query.
// Foundation operation tags customize presentation within that component.
fn language_foundation_present(node: void*, candidate: LanguageCandidate*): void {
    var value = sem_get(node);
    candidate.description = language_declaration_description(value);
    if value.binding != null {
        candidate.subject = value.binding;
        var declaration = sem_get(value.binding);
        if declaration != null {
            candidate.description = language_declaration_description(declaration);
        }
    }
    var kind = value.kind;
    if kind == KTypeConstruct {
        candidate.description = language_type_construction_description(value.op);
    }
    var selected = kind == KProgram;
    if selected {
        candidate.structural = true;
        candidate.description = "Top-level code defines names for the file. Statements outside functions run in source order.";
    }
    selected = kind == KAssign;
    if selected {
        candidate.subject = value.target;
        var target = sem_get(value.target);
        var resolved = target != null;
        resolved &&= target.binding != null;
        if resolved {
            candidate.subject = target.binding;
        }
        candidate.description = "Changes the value on the left to the value on the right. The previous value is overwritten.";
    }
    selected = kind == KLoad;
    if selected {
        candidate.description = "A pointer holds a memory address. This reads the value stored at that address.";
        var owner = sem_get(sem_parent(node));
        var destination = owner != null;
        destination &&= owner.target == node;
        if destination {
            candidate.description = "A pointer holds a memory address. This changes the value at that address, not the address held by the pointer.";
        }
    }
    selected = kind == KAddress;
    if selected {
        candidate.description = "Produces a pointer: the memory address of this value. Other code can use that address to read or change the value.";
    }
    selected = kind == KReturn;
    if selected {
        candidate.structural = true;
        candidate.description = "Ends this function call and goes back to the code that called it.";
        if value.value != null {
            candidate.description = "Ends this function call and sends this value back to the code that called it.";
        }
        var ancestor = sem_parent(node);
        loop {
            if ancestor == null {
                break;
            }
            var owner = sem_get(ancestor);
            var function = owner != null;
            function &&= owner.kind == KFunction;
            if function {
                candidate.subject = ancestor;
                candidate.structural = false;
                break;
            }
            ancestor = sem_parent(ancestor);
        }
    }
    selected = kind == KBlock;
    if selected {
        candidate.structural = true;
        candidate.description = "Groups statements together. Names declared inside this block can be used here, but not outside it.";
        var parent = sem_parent(node);
        var owner = sem_get(parent);
        var body = owner != null;
        body &&= owner.kind == KFunction;
        body &&= owner.body == node;
        if body {
            candidate.subject = parent;
            candidate.structural = false;
            candidate.description = "Contains the statements run when this function is called. Variables created here belong to this call.";
        }
    }
    selected = kind == KCall;
    if selected {
        candidate.description = "Runs the function's code. Values supplied in parentheses become its inputs; when it finishes, execution continues here.";
    }
    selected = kind == KIf;
    if selected {
        candidate.structural = true;
        candidate.description = "Uses a true/false condition to choose which block runs. The else block, if present, runs when the condition is false.";
    }
    selected = kind == KLoop;
    if selected {
        candidate.structural = true;
        candidate.description = "Runs this block repeatedly. break leaves the loop; continue starts its next repetition.";
    }
    selected = kind == KBreak;
    if selected {
        candidate.structural = true;
        candidate.description = "Stops the nearest loop and continues with the code after it.";
    }
    selected = kind == KContinue;
    if selected {
        candidate.structural = true;
        candidate.description = "Skips the rest of the nearest loop's current repetition and starts the next one.";
    }
    selected = kind == KLabel;
    if selected {
        candidate.structural = true;
        candidate.description = "Marks a place in this function that jump can continue from.";
    }
    selected = kind == KJump;
    if selected {
        candidate.structural = true;
        candidate.description = "Continues at the named label instead of running the next statement.";
    }
}

fn language_type_description(value: FoundationNode*): u8* {
    if value.type.pointers != 0 {
        return "A memory address that can be used to access a value.";
    }
    if value.type.scalar == SBool {
        return "A true or false value.";
    }
    if semantic_integer(&value.type) {
        if semantic_signed(&value.type) {
            return "A whole number that can be positive, zero or negative.";
        }
        return "A whole number that is zero or positive.";
    }
    if value.type.scalar == SStruct {
        return "A type that groups named fields.";
    }
    if value.type.scalar == SArray {
        return "A fixed number of elements stored next to each other.";
    }
    return "No value; used for functions that return no result.";
}

// Dispatch by the actual ECS component type. Priority is explicit so storage
// order cannot change the result: checked Foundation, symbolic generic metadata,
// grammar, then resolved type uses. Unsupported metadata leaves the inherited view.
fn language_component_present(q: CompletionQuery*, node: void*, component: void*, checked: bool, candidate: LanguageCandidate*): LanguagePresentation {
    candidate.node = node;
    candidate.subject = node;
    candidate.grammar = false;
    candidate.generic = null;
    candidate.description = null;
    candidate.structural = false;
    var type = entity_component_type(component);
    if type == q.context.type_uses {
        var use = bits(SemanticTypeUse*, entity_component_data(component));
        var target = sem_get(use.target);
        var usable = target != null;
        if usable {
            if !checked {
                usable = target.type.record == null;
            }
        }
        if usable {
            candidate.subject = use.target;
            candidate.description = language_type_description(target);
            return LanguagePresentation.TypeUse;
        }
        return LanguagePresentation.None;
    }
    if type == q.generic_info {
        language_generic_present(q, node, candidate);
        return LanguagePresentation.Generic;
    }
    var data = entity_component_data(component);
    if data is not null && data == compiler_node_get(node, CompilerFoundation) {
        if checked {
            language_foundation_present(node, candidate);
            return LanguagePresentation.Foundation;
        }
        return LanguagePresentation.None;
    }
    var grammar = data is not null && data == compiler_node_get(node, CompilerSyntax);
    if grammar {
        candidate.grammar = true;
        return LanguagePresentation.Grammar;
    }
    return LanguagePresentation.None;
}

fn language_kind(value: FoundationNode*): u8* {
    if value == null {
        return "syntax";
    }
    if value.kind == SurfaceSelect {
        return "conditional expression";
    }
    if value.kind == SurfaceAnd || value.kind == SurfaceOr {
        return "logical expression";
    }
    if value.kind == SurfaceAssign {
        return "assignment";
    }
    if value.kind == SurfaceModify {
        return "increment or decrement";
    }
    if value.kind == SurfaceComma {
        return "comma expression";
    }
    if value.kind == SurfaceShift {
        return "shift";
    }
    if value.kind == SurfaceCompare {
        return "three-way comparison";
    }
    if value.kind == SurfaceCoalesce {
        return "null coalescing";
    }
    if sem_surface_optional(value) {
        return "null-conditional access";
    }
    if value.kind == KFunction {
        return "function";
    }
    if value.kind == KParameter {
        return "parameter";
    }
    if value.kind == KDeclare {
        if value.global {
            return "global variable";
        }
        return "local variable";
    }
    if value.kind == KFieldDeclaration {
        return "field";
    }
    if value.kind == KType {
        return "type";
    }
    if value.kind == KCall {
        return "call";
    }
    if value.kind == KTypeConstruct {
        return "primitive type constructor";
    }
    if value.kind == KOperand {
        var member = value.constant;
        member &&= value.type.pointers == 0;
        member &&= semantic_enum(&value.type);
        if member {
            return "enum member";
        }
        return "value";
    }
    if value.kind == KField {
        return "field access";
    }
    if value.kind == KIndex {
        return "index";
    }
    if value.kind == KLoad {
        return "pointer dereference";
    }
    if value.kind == KAddress {
        return "address of";
    }
    return "foundation operation";
}
