import tower;
import format_storage;
import inspection_policy;
import format;
import format_types;
import parser_types;
import syntax_reader;
import regex_lowering;
import .library.vector;

// Canonical display fragments for declarations whose types still contain
// parameters. Consume the same named parser relationships as semantic checking.
fn format_dependent_member(entity: void*, role: u8*): void* {
    if entity == null {
        return null;
    }
    return entity_child_at(entity, entity_member_index(entity, role));
}

fn format_dependent_is(f: FormatEngine*, entity: void*, label: u8*): bool {
    var span = format_match(f, entity);
    if span == null {
        return false;
    }
    return format_name_is(&span.label, label);
}

fn format_dependent_tokens(f: FormatEngine*, entity: void*, text: FormatResult*, depth: usize): void {
    var next = depth + 1;
    if entity == null {
        return;
    }
    if depth == InspectionDepthLimit {
        f.result.failed = true;
        return;
    }
    var span = format_match(f, entity);
    if span != null {
        var terminal: usize = 0;
        terminal--;
        if span.rule == terminal {
            format_storage_append(text, span.label.data, span.label.length);
            format_storage_fail(f.result, format_storage_error(text));
            return;
        }
    }
    for(var i: usize = 0; i < entity_child_count(entity); i++) {
        format_dependent_tokens(f, entity_child_at(entity, i), text, next);
    }
}

fn format_dependent_name(f: FormatEngine*, entity: void*): void {
    var name: FormatResult = default;
    format_storage_child(&name, f.result);
    format_dependent_tokens(f, entity, &name, 0);
    name.text.length = syntax_identifier_decode_in_place(name.text.data, name.text.length);
    format_identifier(f, &name.text);
    format_dispose(&name);
}

fn format_dependent_list(f: FormatEngine*, entity: void*, label: u8*, separator: u8*, count: usize*, depth: usize): void {
    var next = depth + 1;
    if entity == null {
        return;
    }
    if depth == InspectionDepthLimit {
        f.result.failed = true;
        return;
    }
    if format_dependent_is(f, entity, label) {
        if *count != 0 {
            format_text(f, separator);
        }
        format_dependent(f, entity, next);
        *count = *count + 1;
        return;
    }
    for(var i: usize = 0; i < entity_child_count(entity); i++) {
        format_dependent_list(f, entity_child_at(entity, i), label, separator, count, next);
    }
}

fn format_dependent(f: FormatEngine*, entity: void*, depth: usize): void {
    var next = depth + 1;
    if entity == null {
        return;
    }
    if depth == InspectionDepthLimit {
        f.result.failed = true;
        return;
    }
    var substitution = f.substitutions;
    while substitution != null {
        if substitution.node == entity {
            var saved = f.substitutions;
            f.substitutions = substitution.nested;
            format_dependent(f, substitution.replacement, next);
            f.substitutions = saved;
            return;
        }
        substitution = substitution.next;
    }
    var name = format_dependent_member(entity, "name");
    var annotation = format_dependent_member(entity, "type");
    if entity == f.dependent_subject {
        annotation = f.dependent_annotation;
    }
    if format_dependent_is(f, entity, "CoreFunction") {
        format_text(f, "fn ");
        format_dependent_name(f, name);
        format_text(f, "(");
        var count: usize = 0;
        format_dependent_list(f, format_dependent_member(entity, "params"), "CoreParameter", ", ", &count, next);
        format_text(f, "): ");
        format_dependent(f, annotation, next);
        return;
    }
    if format_dependent_is(f, entity, "CoreStruct") {
        format_text(f, "struct ");
        format_dependent_name(f, name);
        format_text(f, " { ");
        var count: usize = 0;
        format_dependent_list(f, format_dependent_member(entity, "fields"), "CoreField", "; ", &count, next);
        if count != 0 {
            format_text(f, "; ");
        }
        format_text(f, "}");
        return;
    }
    var declared = format_dependent_is(f, entity, "CoreDeclare");
    var named = declared;
    if format_dependent_is(f, entity, "CoreParameter") {
        named = true;
    }
    if format_dependent_is(f, entity, "CoreField") {
        named = true;
    }
    if named {
        if declared {
            format_text(f, "var ");
        }
        format_dependent_name(f, name);
        if annotation != null {
            format_text(f, ": ");
            format_dependent(f, annotation, next);
        }
        return;
    }
    if format_dependent_is(f, entity, "CoreType") {
        var base = format_dependent_member(entity, "base");
        if base != null {
            format_dependent(f, base, next);
            var count = format_dependent_member(entity, "count");
            if count != null {
                format_text(f, "[");
                format_dependent(f, count, next);
                format_text(f, "]");
            } else {
                format_text(f, "*");
            }
        } else {
            format_dependent(f, name, next);
            // A type application has delimiter children even with zero args.
            if entity_child_count(entity) > 1 {
                format_text(f, "(");
                var count: usize = 0;
                format_dependent_list(f, format_dependent_member(entity, "args"), "CoreTypeArgument", ", ", &count, next);
                format_text(f, ")");
            }
        }
        return;
    }
    if format_dependent_is(f, entity, "CoreTypeName") {
        var base = format_dependent_member(entity, "base");
        if base != null {
            format_dependent(f, base, next);
            format_text(f, ".");
            format_dependent_name(f, format_dependent_member(entity, "field"));
        } else {
            format_dependent_name(f, name);
        }
        return;
    }
    if format_dependent_is(f, entity, "TowerExpression") || format_dependent_is(f, entity, "TowerComma") {
        var left = format_dependent_member(entity, "left");
        var right = format_dependent_member(entity, "right");
        if left != null && right != null {
            format_dependent(f, left, next);
            format_text(f, " ");
            format_dependent(f, entity_child_at(entity, 1), next);
            format_text(f, " ");
            format_dependent(f, right, next);
            return;
        }
        var condition = format_dependent_member(entity, "condition");
        if condition != null {
            format_dependent(f, condition, next);
            format_text(f, " ? ");
            format_dependent(f, format_dependent_member(entity, "body"), next);
            format_text(f, " : ");
            format_dependent(f, format_dependent_member(entity, "otherwise"), next);
            return;
        }
    }
    if format_dependent_is(f, entity, "CoreBinary") {
        format_dependent(f, format_dependent_member(entity, "left"), next);
        format_text(f, " ");
        format_dependent(f, format_dependent_member(entity, "op"), next);
        format_text(f, " ");
        format_dependent(f, format_dependent_member(entity, "right"), next);
        return;
    }
    if format_dependent_is(f, entity, "CoreAssign") {
        format_dependent(f, format_dependent_member(entity, "target"), next);
        format_text(f, " = ");
        format_dependent(f, format_dependent_member(entity, "value"), next);
        format_text(f, ";");
        return;
    }
    if format_dependent_is(f, entity, "Identifier") {
        format_dependent_name(f, entity);
        return;
    }
    var span = format_match(f, entity);
    if span != null {
        var terminal: usize = 0;
        terminal--;
        if span.rule == terminal {
            format_bytes(f, &span.label);
            return;
        }
    }
    for(var i: usize = 0; i < entity_child_count(entity); i++) {
        format_dependent(f, entity_child_at(entity, i), next);
    }
}

export fn format_dependent_summary(result: FormatResult*, entity: void*, match_kind: void*): void {
    format_dependent_view(result, entity, null, null, match_kind, null);
}

export fn format_dependent_view(result: FormatResult*, entity: void*, subject: void*, annotation: void*, match_kind: void*, substitutions: FormatSubstitution*): void {
    var f: FormatEngine = {
        result: result, match_kind: match_kind, substitutions: substitutions,
        dependent_subject: subject, dependent_annotation: annotation, ..default
    };
    format_dependent(&f, entity, 0);
}
