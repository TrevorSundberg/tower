import tower;
import lr_types;
import lr_analysis;
import .library.vector;
import .library.work_vector;
import .library.work_vector_types;
import .library.work_buffer;
import .library.work_buffer_types;
import .library.work_arena_api;
import .library.work_arena_types;

// LR(0) state construction and kernel interning. The same item operations handle
// character ranges and token IDs; all records are disposable grammar indexes.
struct LRState {
    memory: WorkArena*;
    actions_owned: bool;
    items: LRItems*;
    symbols: work_vector(usize);
    edges: work_vector(LRTransition);
    actions: work_vector(LRAction);
    base: usize;
    origin: usize;
    hash: usize;
    next: usize;
    initial_symbols: usize[WorkBufferInitialElements];
    initial_edges: LRTransition[WorkBufferInitialElements];
    initial_actions: LRAction[WorkBufferInitialElements];
}

fn lr_state_initial(state: LRState*, memory: WorkArena*): void {
    state.memory = memory;
    state.symbols.data = &state.initial_symbols[0];
    state.symbols.capacity = sizeof(decltype(state.initial_symbols)) / sizeof(usize);
    state.edges.data = &state.initial_edges[0];
    state.edges.capacity = sizeof(decltype(state.initial_edges)) / sizeof(LRTransition);
    state.actions.data = &state.initial_actions[0];
    state.actions.capacity = sizeof(decltype(state.initial_actions)) / sizeof(LRAction);
}

fn lr_state_vectors_dispose(state: LRState*): void {
    if state.actions_owned { work_vector_dispose(&state.actions); }
}

struct LRStates {
    storage: WorkBuffer;
    records: WorkArena;
    action_storage: WorkArena;
    analysis: LRAnalysis*;
    states: work_vector(LRState*);
    pending: work_vector(usize);
    buckets: work_vector(usize);
}

// Private to one state-building coordinator; reused only after its transitions
// finish. Entries refer to the frozen item vector, never to grammar ownership.
struct LRShiftIndex {
    heads: work_vector(usize);
    next: work_vector(usize);
}

fn lr_shift_index_dispose(index: LRShiftIndex*): void {
    work_vector_dispose(&index.heads);
    work_vector_dispose(&index.next);
}

fn lr_shift_index_result(index: LRShiftIndex*, analysis: LRAnalysis*, state: LRState*): WorkBudgetError {
    index.heads.length = 0;
    // One binary lookup per item must save work over scanning it for each edge.
    var steps: usize = 1;
    for(var count = state.symbols.length; count != 0; count /= 2) { steps++; }
    if state.symbols.length <= steps { return WorkBudgetError.None; }
    for(var i: usize = 1; i < state.symbols.length; i++) {
        var left = &analysis.symbols[state.symbols.data[i - 1]];
        var right = &analysis.symbols[state.symbols.data[i]];
        // A contained terminal can belong to several transitions. Keep the
        // ordinary range-matching path rather than treating it as an exact key.
        if left.nonterminal == lr_none() && right.nonterminal == lr_none() && left.last >= right.first {
            return WorkBudgetError.None;
        }
    }
    var error = lr_reserve_result(&index.heads, state.symbols.length, analysis.budget);
    if error == WorkBudgetError.None { error = lr_reserve_result(&index.next, state.items.values.length, analysis.budget); }
    if error != WorkBudgetError.None { return error; }
    index.heads.length = state.symbols.length;
    index.next.length = state.items.values.length;
    for(var i: usize = 0; i < index.heads.length; i++) { index.heads.data[i] = lr_none(); }
    // Prepending in reverse preserves the exact original sorted item order.
    for(var i = state.items.values.length; i != 0; i--) {
        var item = &state.items.values.data[i - 1];
        var rule = &analysis.rules[item.rule];
        if item.position >= rule.count { continue; }
        var symbol = rule.begin + item.position;
        var low: usize = 0; var high = state.symbols.length;
        while low < high {
            var middle = low + (high - low) / 2;
            if lr_symbol_less(analysis, state.symbols.data[middle], symbol) { low = middle + 1; }
            else { high = middle; }
        }
        if low == state.symbols.length || lr_symbol_less(analysis, symbol, state.symbols.data[low]) {
            return WorkBudgetError.Invalid;
        }
        // Ordering is not identity. An API client can assign equal ordering
        // keys to distinct nonterminals; preserve ordinary matching in that case.
        if analysis.symbols[symbol].nonterminal != analysis.symbols[state.symbols.data[low]].nonterminal {
            index.heads.length = 0;
            return WorkBudgetError.None;
        }
        index.next.data[i - 1] = index.heads.data[low];
        index.heads.data[low] = i - 1;
    }
    return WorkBudgetError.None;
}

export fn lr_kernel(analysis: LRAnalysis*, item: LRItem*): bool {
    if item.position != 0 {
        return true;
    }
    if item.rule == 0 {
        return true;
    }
    var empty = analysis.rules[item.rule].count == 0;
    return empty;
}

// State identity uses the shifted core only. Closure adds dot-zero items,
// including nullable reductions and (in recursive grammars) the start rule.
// Those remain LALR kernels via lr_kernel, but are derived from this core and
// must not require expansion before lookup. The initial state is distinguished
// separately by its absent origin. All keys are local to one frozen analysis.
fn lr_state_hash(items: LRItems*): usize {
    var hash: usize = 2166136261;
    var index: usize = 0;
    loop {
        if index == items.values.length {
            return hash;
        }
        var item = &items.values.data[index];
        if item.position != 0 {
            hash = hash ^ item.rule;
            hash = hash * 16777619;
            hash = hash ^ item.position;
            hash = hash * 16777619;
        }
        index++;
    }
}

fn lr_state_equal(a: LRItems*, b: LRItems*): bool {
    var left: usize = 0;
    var right: usize = 0;
    loop {
        for(; left != a.values.length; left++) {
            var kernel = a.values.data[left].position != 0;
            if kernel {
                break;
            }
        }
        for(; right != b.values.length; right++) {
            var kernel = b.values.data[right].position != 0;
            if kernel {
                break;
            }
        }
        var end = left == a.values.length;
        if end {
            var same = right == b.values.length;
            return same;
        }
        end = right == b.values.length;
        if end {
            return false;
        }
        var different = a.values.data[left].rule != b.values.data[right].rule;
        if different {
            return false;
        }
        different = a.values.data[left].position != b.values.data[right].position;
        if different {
            return false;
        }
        left++;
        right++;
    }
}

fn lr_symbol_less(analysis: LRAnalysis*, a: usize, b: usize): bool {
    var left = &analysis.symbols[a];
    var right = &analysis.symbols[b];
    var left_terminal = left.nonterminal == lr_none();
    var right_terminal = right.nonterminal == lr_none();
    var different = left_terminal != right_terminal;
    if different {
        return right_terminal;
    }
    if left_terminal {
        different = left.first != right.first;
        if different {
            var less = left.first < right.first;
            return less;
        }
        var less = left.last < right.last;
        return less;
    }
    var less = analysis.nonterminals[left.nonterminal].order < analysis.nonterminals[right.nonterminal].order;
    return less;
}

fn lr_state_symbol_result(analysis: LRAnalysis*, state: LRState*, symbol: usize): WorkBudgetError {
    if symbol >= analysis.symbol_count { return WorkBudgetError.Invalid; }
    var name = analysis.symbols[symbol].nonterminal;
    if name != lr_none() && name >= analysis.nonterminal_count { return WorkBudgetError.Invalid; }
    var low: usize = 0;
    var high = state.symbols.length;
    loop {
        if low == high {
            break;
        }
        var middle = high -low;
        middle = middle / 2;
        middle = middle + low;
        if lr_symbol_less(analysis, state.symbols.data[middle], symbol) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if low < state.symbols.length {
        if !lr_symbol_less(analysis, symbol, state.symbols.data[low]) {
            return WorkBudgetError.None;
        }
    }
    var count = state.symbols.length + 1;
    if count == 0 { return WorkBudgetError.Invalid; }
    var error = lr_reserve_arena_result(&state.symbols, count, state.memory, null);
    if error != WorkBudgetError.None { return error; }
    var moved = state.symbols.length -low;
    var bytes = moved *sizeof(usize);
    var next = low + 1;
    copy(&state.symbols.data[next], &state.symbols.data[low], bytes);
    state.symbols.data[low] = symbol;
    state.symbols.length = count;
    return WorkBudgetError.None;
}

fn lr_state_destroy(state: LRState*): void {
    lr_items_destroy(state.items);
    lr_state_vectors_dispose(state);
}

export fn lr_states_destroy(value: LRStates*): void {
    if value == null {
        return;
    }
    foreach(var & state in &value.states) {
        lr_state_destroy(*state);
    }
    work_arena_dispose(&value.action_storage);
    work_arena_dispose(&value.records);
    var storage = value.storage;
    work_buffer_dispose(&storage);
}

var LRStateBucketGrowth: usize = 2;
var LRStateBucketSeed: usize = 17;

fn lr_states_rehash_result(value: LRStates*): WorkBudgetError {
    if value.states.length > ~convert(usize, 0) / LRStateBucketGrowth { return WorkBudgetError.Invalid; }
    var needed = value.states.length * LRStateBucketGrowth;
    if value.buckets.length > needed {
        return WorkBudgetError.None;
    }
    if value.buckets.length > (~convert(usize, 0) - LRStateBucketSeed) / LRStateBucketGrowth { return WorkBudgetError.Invalid; }
    needed = value.buckets.length * LRStateBucketGrowth + LRStateBucketSeed;
    var error = lr_reserve_arena_result(&value.buckets, needed, &value.records, null);
    if error != WorkBudgetError.None { return error; }
    value.buckets.length = needed;
    var index: usize = 0;
    for(; index != needed; index++) {
        value.buckets.data[index] = lr_none();
    }
    index = 0;
    loop {
        if index == value.states.length {
            return WorkBudgetError.None;
        }
        var state = value.states.data[index];
        var bucket = state.hash % needed;
        state.next = value.buckets.data[bucket];
        value.buckets.data[bucket] = index;
        index++;
    }
}

// Takes ownership of items on every path, including an existing kernel match.
fn lr_states_intern_result(value: LRStates*, items: LRItems*, origin: usize, closed: bool, error: WorkBudgetError*): usize {
    defer lr_items_destroy(items);
    *error = lr_states_rehash_result(value);
    if *error != WorkBudgetError.None {
        return lr_none();
    }
    var hash = lr_state_hash(items);
    var bucket_count = value.buckets.length;
    if bucket_count == 0 {
        *error = WorkBudgetError.Invalid;
        return lr_none();
    }
    var bucket = hash % bucket_count;
    var index = value.buckets.data[bucket];
    loop {
        if index == lr_none() {
            break;
        }
        var state = value.states.data[index];
        var same = hash == state.hash && (origin == lr_none()) == (state.origin == lr_none());
        if same {
            same = lr_state_equal(items, state.items);
            if same {
                return index;
            }
        }
        index = state.next;
    }
    // Only a new serial state needs closure. Worker results are already closed
    // before their ordered join; never repeat that work or publish partial items.
    if !closed && !lr_items_close(value.analysis, items, false) {
        *error = lr_items_error(items);
        return lr_none();
    }
    var data: u8* = null;
    *error = work_arena_allocate_result(&value.records, sizeof(LRState), alignof(LRState), &data);
    if *error != WorkBudgetError.None { return lr_none(); }
    var state = bits(LRState*, data);
    *state = default;
    lr_state_initial(state, &value.records);
    state.items = items;
    items = null; // Ownership moved to the state.
    state.origin = origin;
    state.hash = hash;
    state.next = value.buckets.data[bucket];
    index = value.states.length;
    *error = lr_push_arena_result(&value.pending, index, &value.records, null);
    if *error == WorkBudgetError.None { *error = lr_push_arena_result(&value.states, state, &value.records, null); }
    if *error != WorkBudgetError.None {
        lr_state_destroy(state);
        return lr_none();
    }
    value.buckets.data[bucket] = index;
    return index;
}

fn lr_states_begin_result(analysis: LRAnalysis*, error: WorkBudgetError*): LRStates* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if analysis == null || analysis.failed || analysis.rule_count == 0 { return null; }
    var storage: WorkBuffer = default;
    *error = work_buffer_resize(&storage, analysis.budget, sizeof(LRStates), 0);
    if *error != WorkBudgetError.None { return null; }
    var value = bits(LRStates*, storage.data);
    *value = default;
    value.storage = storage;
    defer lr_states_destroy(value);
    value.analysis = analysis;
    var chunk_bytes = sizeof(WorkArenaChunk) + WorkBufferInitialElements * (sizeof(LRState) + sizeof(LRItems));
    if !work_arena_init(&value.records, analysis.budget, chunk_bytes) { *error = WorkBudgetError.Invalid; return null; }
    var items = lr_items_arena_result(&value.records, error);
    var missing = items == null;
    if missing {
        return null;
    }
    var seed: LRItem = default;
    var ok = lr_items_insert(items, &seed);
    if !ok {
        *error = lr_items_error(items);
        lr_items_destroy(items);
        return null;
    }
    var start = lr_states_intern_result(value, items, lr_none(), false, error);
    missing = start == lr_none();
    if missing {
        return null;
    }
    var result = value;
    value = null;
    return result;
}

fn lr_state_symbols_result(analysis: LRAnalysis*, state: LRState*): WorkBudgetError {
    var done = false;
    // Kernel items precede closure items, as in the ordinary LR builder.
    var pass: usize = 0;
    loop {
        done = pass == 2;
        if done {
            break;
        }
        var position: usize = 0;
        loop {
            done = position == state.items.values.length;
            if done {
                break;
            }
            var item = &state.items.values.data[position];
            var kernel = lr_kernel(analysis, item);
            var want_kernel = pass == 0;
            var include = kernel == want_kernel;
            var rule = &analysis.rules[item.rule];
            var present = item.position < rule.count;
            if include {
                if present {
                    var symbol = rule.begin + item.position;
                    var error = lr_state_symbol_result(analysis, state, symbol);
                    if error != WorkBudgetError.None { return error; }
                }
            }
            position++;
        }
        pass++;
    }
    return WorkBudgetError.None;
}

fn lr_state_transition_result(value: LRStates*, state: LRState*, position: usize, index: LRShiftIndex*): WorkBudgetError {
    var analysis = value.analysis;
    var symbol = state.symbols.data[position];
    var ok = true;
    var missing = false;
    var error = WorkBudgetError.None;
    var next = lr_items_arena_result(&value.records, &error);
    missing = next == null;
    if missing {
        return error;
    }
    if index.heads.length == 0 {
        ok = lr_items_shift(analysis, state.items, &analysis.symbols[symbol], next);
    } else {
        for(var at = index.heads.data[position]; at != lr_none() && ok; at = index.next.data[at]) {
            var item = state.items.values.data[at];
            item.position++;
            ok = lr_items_insert(next, &item);
        }
        if !ok { analysis.failed = true; }
    }
    if !ok {
        error = lr_items_error(next);
        lr_items_destroy(next);
        return error;
    }
    var edge: LRTransition;
    edge.symbol = symbol;
    edge.state = lr_states_intern_result(value, next, symbol, false, &error);
    missing = edge.state == lr_none();
    if missing {
        return error;
    }
    return lr_push_arena_result(&state.edges, edge, state.memory, null);
}

export fn lr_states_create(analysis: LRAnalysis*): LRStates* {
    var error = WorkBudgetError.None;
    return lr_states_create_result(analysis, &error);
}

export fn lr_states_create_result(analysis: LRAnalysis*, error: WorkBudgetError*): LRStates* {
    defer { if analysis != null { lr_analysis_scratch_dispose(analysis); } }
    var value = lr_states_begin_result(analysis, error);
    if value == null { return null; }
    defer lr_states_destroy(value);
    var shifts: LRShiftIndex = default;
    defer lr_shift_index_dispose(&shifts);
    loop {
        var done = value.pending.length == 0;
        if done {
            var result = value;
            value = null; // Transfer ownership to the caller.
            return result;
        }
        value.pending.length--;
        var index = value.pending.data[value.pending.length];
        var state = value.states.data[index];
        *error = lr_state_symbols_result(analysis, state);
        if *error == WorkBudgetError.None { *error = lr_shift_index_result(&shifts, analysis, state); }
        if *error != WorkBudgetError.None { return null; }
        var position: usize = 0;
        loop {
            done = position == state.symbols.length;
            if done {
                break;
            }
            *error = lr_state_transition_result(value, state, position, &shifts);
            if *error != WorkBudgetError.None { return null; }
            position++;
        }
    }
}

export fn lr_states_count(value: LRStates*): usize {
    return value.states.length;
}

export fn lr_states_items(value: LRStates*, index: usize): LRItems* {
    return value.states.data[index].items;
}

export fn lr_states_origin(value: LRStates*, index: usize): usize {
    return value.states.data[index].origin;
}

export fn lr_states_edge_count(value: LRStates*, index: usize): usize {
    return value.states.data[index].edges.length;
}

export fn lr_states_edges(value: LRStates*, index: usize): LRTransition* {
    return value.states.data[index].edges.data;
}
