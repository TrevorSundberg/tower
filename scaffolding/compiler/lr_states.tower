import tower;
import lr_types;
import lr_analysis;
import .library.vector;

// LR(0) state construction and kernel interning. The same item operations handle
// character ranges and token IDs; all records are disposable grammar indexes.
struct LRState {
    items: LRItems*;
    symbols: vector(usize);
    edges: vector(LRTransition);
    actions: vector(LRAction);
    base: usize;
    origin: usize;
    hash: usize;
    next: usize;
}

struct LRStates {
    analysis: LRAnalysis*;
    states: vector(LRState*);
    pending: vector(usize);
    buckets: vector(usize);
}

export fn lr_kernel(analysis: LRAnalysis*, item: LRItem*): bool {
    if item.position != 0 {
        return true;
    }
    if item.rule == 0 {
        return true;
    }
    var empty = analysis.rules[item.rule].count == 0;
    return empty;
}

fn lr_state_hash(analysis: LRAnalysis*, items: LRItems*): usize {
    var hash: usize = 2166136261;
    var index: usize = 0;
    loop {
        if index == items.values.length {
            return hash;
        }
        var item = &items.values.data[index];
        if lr_kernel(analysis, item) {
            hash = hash ^ item.rule;
            hash = hash * 16777619;
            hash = hash ^ item.position;
            hash = hash * 16777619;
        }
        index++;
    }
}

fn lr_state_equal(analysis: LRAnalysis*, a: LRItems*, b: LRItems*): bool {
    var left: usize = 0;
    var right: usize = 0;
    loop {
        for(; left != a.values.length; left++) {
            var kernel = lr_kernel(analysis, &a.values.data[left]);
            if kernel {
                break;
            }
        }
        for(; right != b.values.length; right++) {
            var kernel = lr_kernel(analysis, &b.values.data[right]);
            if kernel {
                break;
            }
        }
        var end = left == a.values.length;
        if end {
            var same = right == b.values.length;
            return same;
        }
        end = right == b.values.length;
        if end {
            return false;
        }
        var different = a.values.data[left].rule != b.values.data[right].rule;
        if different {
            return false;
        }
        different = a.values.data[left].position != b.values.data[right].position;
        if different {
            return false;
        }
        left++;
        right++;
    }
}

fn lr_symbol_less(analysis: LRAnalysis*, a: usize, b: usize): bool {
    var left = &analysis.symbols[a];
    var right = &analysis.symbols[b];
    var left_terminal = left.nonterminal == lr_none();
    var right_terminal = right.nonterminal == lr_none();
    var different = left_terminal != right_terminal;
    if different {
        return right_terminal;
    }
    if left_terminal {
        different = left.first != right.first;
        if different {
            var less = left.first < right.first;
            return less;
        }
        var less = left.last < right.last;
        return less;
    }
    var less = analysis.nonterminals[left.nonterminal].order < analysis.nonterminals[right.nonterminal].order;
    return less;
}

fn lr_state_symbol_result(analysis: LRAnalysis*, state: LRState*, symbol: usize): WorkBudgetError {
    if symbol >= analysis.symbol_count { return WorkBudgetError.Invalid; }
    var name = analysis.symbols[symbol].nonterminal;
    if name != lr_none() && name >= analysis.nonterminal_count { return WorkBudgetError.Invalid; }
    var low: usize = 0;
    var high = state.symbols.length;
    loop {
        if low == high {
            break;
        }
        var middle = high -low;
        middle = middle / 2;
        middle = middle + low;
        if lr_symbol_less(analysis, state.symbols.data[middle], symbol) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if low < state.symbols.length {
        if !lr_symbol_less(analysis, symbol, state.symbols.data[low]) {
            return WorkBudgetError.None;
        }
    }
    var count = state.symbols.length + 1;
    if count == 0 { return WorkBudgetError.Invalid; }
    var error = lr_reserve_result(&state.symbols, count);
    if error != WorkBudgetError.None { return error; }
    var moved = state.symbols.length -low;
    var bytes = moved *sizeof(usize);
    var next = low + 1;
    copy(&state.symbols.data[next], &state.symbols.data[low], bytes);
    state.symbols.data[low] = symbol;
    state.symbols.length = count;
    return WorkBudgetError.None;
}

fn lr_state_destroy(state: LRState*): void {
    lr_items_destroy(state.items);
    vector_dispose(&state.symbols);
    vector_dispose(&state.edges);
    vector_dispose(&state.actions);
    free(state);
}

export fn lr_states_destroy(value: LRStates*): void {
    if value == null {
        return;
    }
    foreach(var & state in &value.states) {
        lr_state_destroy(*state);
    }
    vector_dispose(&value.states);
    vector_dispose(&value.pending);
    vector_dispose(&value.buckets);
    free(value);
}

var LRStateBucketGrowth: usize = 2;
var LRStateBucketSeed: usize = 17;

fn lr_states_rehash_result(value: LRStates*): WorkBudgetError {
    if value.states.length > ~convert(usize, 0) / LRStateBucketGrowth { return WorkBudgetError.Invalid; }
    var needed = value.states.length * LRStateBucketGrowth;
    if value.buckets.length > needed {
        return WorkBudgetError.None;
    }
    if value.buckets.length > (~convert(usize, 0) - LRStateBucketSeed) / LRStateBucketGrowth { return WorkBudgetError.Invalid; }
    needed = value.buckets.length * LRStateBucketGrowth + LRStateBucketSeed;
    var error = lr_reserve_result(&value.buckets, needed);
    if error != WorkBudgetError.None { return error; }
    value.buckets.length = needed;
    var index: usize = 0;
    for(; index != needed; index++) {
        value.buckets.data[index] = lr_none();
    }
    index = 0;
    loop {
        if index == value.states.length {
            return WorkBudgetError.None;
        }
        var state = value.states.data[index];
        var bucket = state.hash % needed;
        state.next = value.buckets.data[bucket];
        value.buckets.data[bucket] = index;
        index++;
    }
}

// Takes ownership of items on every path, including an existing kernel match.
fn lr_states_intern_result(value: LRStates*, items: LRItems*, origin: usize, error: WorkBudgetError*): usize {
    defer lr_items_destroy(items);
    *error = lr_states_rehash_result(value);
    if *error != WorkBudgetError.None {
        return lr_none();
    }
    var hash = lr_state_hash(value.analysis, items);
    var bucket_count = value.buckets.length;
    if bucket_count == 0 {
        *error = WorkBudgetError.Invalid;
        return lr_none();
    }
    var bucket = hash % bucket_count;
    var index = value.buckets.data[bucket];
    loop {
        if index == lr_none() {
            break;
        }
        var state = value.states.data[index];
        var same = hash == state.hash;
        if same {
            same = lr_state_equal(value.analysis, items, state.items);
            if same {
                return index;
            }
        }
        index = state.next;
    }
    var state = alloc(LRState, 1);
    if state == null {
        *error = WorkBudgetError.Memory;
        return lr_none();
    }
    fill(state, 0, sizeof(LRState));
    state.items = items;
    items = null; // Ownership moved to the state.
    state.origin = origin;
    state.hash = hash;
    state.next = value.buckets.data[bucket];
    index = value.states.length;
    *error = lr_push_result(&value.pending, index);
    if *error == WorkBudgetError.None { *error = lr_push_result(&value.states, state); }
    if *error != WorkBudgetError.None {
        lr_state_destroy(state);
        return lr_none();
    }
    value.buckets.data[bucket] = index;
    return index;
}

fn lr_states_begin_result(analysis: LRAnalysis*, error: WorkBudgetError*): LRStates* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if analysis == null || analysis.failed || analysis.rule_count == 0 { return null; }
    *error = WorkBudgetError.Memory;
    var value = alloc(LRStates, 1);
    var missing = value == null;
    if missing {
        return null;
    }
    *value = default;
    defer lr_states_destroy(value);
    value.analysis = analysis;
    var items = lr_items_create();
    missing = items == null;
    if missing {
        return null;
    }
    var seed: LRItem = default;
    var ok = lr_items_insert(items, &seed);
    ok &&= lr_items_close(analysis, items, false);
    if !ok {
        *error = lr_items_error(items);
        lr_items_destroy(items);
        return null;
    }
    var start = lr_states_intern_result(value, items, lr_none(), error);
    missing = start == lr_none();
    if missing {
        return null;
    }
    var result = value;
    value = null;
    return result;
}

fn lr_state_symbols_result(analysis: LRAnalysis*, state: LRState*): WorkBudgetError {
    var done = false;
    // Kernel items precede closure items, as in the ordinary LR builder.
    var pass: usize = 0;
    loop {
        done = pass == 2;
        if done {
            break;
        }
        var position: usize = 0;
        loop {
            done = position == state.items.values.length;
            if done {
                break;
            }
            var item = &state.items.values.data[position];
            var kernel = lr_kernel(analysis, item);
            var want_kernel = pass == 0;
            var include = kernel == want_kernel;
            var rule = &analysis.rules[item.rule];
            var present = item.position < rule.count;
            if include {
                if present {
                    var symbol = rule.begin + item.position;
                    var error = lr_state_symbol_result(analysis, state, symbol);
                    if error != WorkBudgetError.None { return error; }
                }
            }
            position++;
        }
        pass++;
    }
    return WorkBudgetError.None;
}

fn lr_state_transition_result(value: LRStates*, state: LRState*, symbol: usize): WorkBudgetError {
    var analysis = value.analysis;
    var ok = true;
    var missing = false;
    var next = lr_items_create();
    missing = next == null;
    if missing {
        return WorkBudgetError.Memory;
    }
    ok = lr_items_goto(analysis, state.items, &analysis.symbols[symbol], next, false);
    if !ok {
        var error = lr_items_error(next);
        lr_items_destroy(next);
        return error;
    }
    var edge: LRTransition;
    edge.symbol = symbol;
    var error = WorkBudgetError.None;
    edge.state = lr_states_intern_result(value, next, symbol, &error);
    missing = edge.state == lr_none();
    if missing {
        return error;
    }
    return lr_push_result(&state.edges, edge);
}

export fn lr_states_create(analysis: LRAnalysis*): LRStates* {
    var error = WorkBudgetError.None;
    return lr_states_create_result(analysis, &error);
}

export fn lr_states_create_result(analysis: LRAnalysis*, error: WorkBudgetError*): LRStates* {
    var value = lr_states_begin_result(analysis, error);
    if value == null { return null; }
    defer lr_states_destroy(value);
    loop {
        var done = value.pending.length == 0;
        if done {
            var result = value;
            value = null; // Transfer ownership to the caller.
            return result;
        }
        value.pending.length--;
        var index = value.pending.data[value.pending.length];
        var state = value.states.data[index];
        *error = lr_state_symbols_result(analysis, state);
        if *error != WorkBudgetError.None { return null; }
        var position: usize = 0;
        loop {
            done = position == state.symbols.length;
            if done {
                break;
            }
            *error = lr_state_transition_result(value, state, state.symbols.data[position]);
            if *error != WorkBudgetError.None { return null; }
            position++;
        }
    }
}

export fn lr_states_count(value: LRStates*): usize {
    return value.states.length;
}

export fn lr_states_items(value: LRStates*, index: usize): LRItems* {
    return value.states.data[index].items;
}

export fn lr_states_origin(value: LRStates*, index: usize): usize {
    return value.states.data[index].origin;
}

export fn lr_states_edge_count(value: LRStates*, index: usize): usize {
    return value.states.data[index].edges.length;
}

export fn lr_states_edges(value: LRStates*, index: usize): LRTransition* {
    return value.states.data[index].edges.data;
}
