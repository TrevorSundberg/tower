import tower;
import 'lr-analysis';
import 'lr-states';
import '../library/vector';

// Build LALR lookahead dependencies from LR(1) closures of LR(0) kernels.
// Grammar order determines indices, never conflict priority or a shift bias.
fn lr_lalr_index(value: LRStates*, state_index: usize, item: LRItem*): usize {
    var state = value.states.data[state_index];
    var key: LRItem;
    key.rule = item.rule;
    key.position = item.position;
    key.first = 0;
    key.last = 0;
    var low: usize = 0;
    var high = state.items.values.length;
    loop {
        var done = low == high;
        if done {
            break;
        }
        var middle = high - low;
        middle = middle / 2;
        middle = middle + low;
        var less = lr_item_less(&state.items.values.data[middle], &key);
        if less {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    var missing = low == state.items.values.length;
    if missing {
        return lr_none();
    }
    missing = lr_item_less(&key, &state.items.values.data[low]);
    if missing {
        return lr_none();
    }
    var result = state.base + low;
    return result;
}

fn lr_lalr_link(value: LRStates*, graph: LRPropagation*, source: usize, state: usize, item: LRItem*): bool {
    var destination = lr_lalr_index(value, state, item);
    var missing = destination == lr_none();
    if missing {
        return false;
    }
    var propagate = item.first == 4294967293;
    if propagate {
        return lr_propagation_edge(graph, source, destination);
    }
    return lr_propagation_seed(graph, destination, item.first, item.last);
}

fn lr_lalr_destination(value: LRStates*, state: LRState*, symbol: usize): usize {
    var low: usize = 0;
    var high = state.edges.length;
    loop {
        var done = low == high;
        if done {
            break;
        }
        var middle = high - low;
        middle = middle / 2;
        middle = middle + low;
        var less = lr_symbol_less(value.analysis, state.edges.data[middle].symbol, symbol);
        if less {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    var missing = low == state.edges.length;
    if missing {
        return lr_none();
    }
    missing = lr_symbol_less(value.analysis, symbol, state.edges.data[low].symbol);
    if missing {
        return lr_none();
    }
    return state.edges.data[low].state;
}

fn lr_lalr_transitions(value: LRStates*, graph: LRPropagation*, state: LRState*, source: usize, closure: LRState*): bool {
    var symbol_index: usize = 0;
    loop {
        var done = symbol_index == closure.symbols.length;
        if done {
            return true;
        }
        var symbol = closure.symbols.data[symbol_index];
        var destination = lr_lalr_destination(value, state, symbol);
        var missing = destination == lr_none();
        if missing {
            return false;
        }
        var next = lr_items_create();
        missing = next == null;
        if missing {
            return false;
        }
        var ok = lr_items_goto(value.analysis, closure.items, &value.analysis.symbols[symbol], next, true);
        var index: usize = 0;
        loop {
            if ok {} else {
                break;
            }
            done = index == next.values.length;
            if done {
                break;
            }
            var item = &next.values.data[index];
            var kernel = lr_kernel(value.analysis, item);
            if kernel {
                ok = lr_lalr_link(value, graph, source, destination, item);
            }
            index = index + 1;
        }
        lr_items_destroy(next);
        if ok {} else {
            return false;
        }
        symbol_index = symbol_index + 1;
    }
}

fn lr_lalr_kernel(value: LRStates*, graph: LRPropagation*, state_index: usize, source: usize, kernel: LRItem*): bool {
    var state = value.states.data[state_index];
    var closure: LRState;
    fill(&closure, 0, sizeof(LRState));
    closure.items = lr_items_create();
    var missing = closure.items == null;
    if missing {
        return false;
    }
    var seed: LRItem;
    copy(&seed, kernel, sizeof(LRItem));
    seed.first = 4294967293;
    seed.last = 4294967293;
    var ok = lr_items_insert(closure.items, &seed);
    if ok {
        ok = lr_items_close(value.analysis, closure.items, true);
    }
    var index: usize = 0;
    loop {
        if ok {} else {
            break;
        }
        var done = index == closure.items.values.length;
        if done {
            break;
        }
        var item = &closure.items.values.data[index];
        var rule = &value.analysis.rules[item.rule];
        var empty = rule.count == 0;
        if empty {
            ok = lr_lalr_link(value, graph, source, state_index, item);
        }
        var present = item.position < rule.count;
        if present {
            var symbol = rule.begin + item.position;
            if ok {
                ok = lr_state_symbol(value.analysis, &closure, symbol);
            }
        }
        index = index + 1;
    }
    if ok {
        ok = lr_lalr_transitions(value, graph, state, source, &closure);
    }
    vector_dispose(usize, &closure.symbols);
    lr_items_destroy(closure.items);
    return ok;
}

fn lr_lalr_actions(value: LRStates*, graph: LRPropagation*): bool {
    var state_index: usize = 0;
    loop {
        var done = state_index == value.states.length;
        if done {
            return true;
        }
        var state = value.states.data[state_index];
        state.actions.length = 0;
        var index: usize = 0;
        loop {
            done = index == state.edges.length;
            if done {
                break;
            }
            var edge = &state.edges.data[index];
            var symbol = &value.analysis.symbols[edge.symbol];
            var terminal = symbol.nonterminal == lr_none();
            if terminal {
                var action: LRAction;
                action.first = symbol.first;
                action.last = symbol.last;
                action.rule = lr_none();
                action.state = edge.state;
                var ok = lr_append(LRAction, &state.actions, &action);
                if ok {} else {
                    return false;
                }
            }
            index = index + 1;
        }
        index = 0;
        loop {
            done = index == state.items.values.length;
            if done {
                break;
            }
            var item = &state.items.values.data[index];
            var reduction = item.position == value.analysis.rules[item.rule].count;
            if reduction {
                var vertex = state.base + index;
                var ranges = &graph.nodes[vertex].ranges;
                var range_index: usize = 0;
                loop {
                    done = range_index == ranges.length;
                    if done {
                        break;
                    }
                    var range = &ranges.data[range_index];
                    var action: LRAction;
                    action.first = range.first;
                    action.last = range.last;
                    action.rule = item.rule;
                    action.state = lr_none();
                    var ok = lr_append(LRAction, &state.actions, &action);
                    if ok {} else {
                        return false;
                    }
                    range_index = range_index + 1;
                }
            }
            index = index + 1;
        }
        state_index = state_index + 1;
    }
}

fn lr_lalr_seed(value: LRStates*, graph: LRPropagation*, constructs: bool): bool {
    var seed: LRItem;
    fill(&seed, 0, sizeof(LRItem));
    var start = lr_lalr_index(value, 0, &seed);
    var missing = start == lr_none();
    if missing {
        return false;
    }
    var ok = lr_propagation_seed(graph, start, 4294967294, 4294967294);
    if ok {} else {
        return false;
    }
    if constructs {
        var owner = value.analysis.rules[0].owner;
        var first = &value.analysis.nonterminals[owner].first;
        var index: usize = 0;
        loop {
            var done = index == first.length;
            if done {
                break;
            }
            var range = &first.data[index];
            ok = lr_propagation_seed(graph, start, range.first, range.last);
            if ok {} else {
                return false;
            }
            index = index + 1;
        }
    }
    return true;
}

export fn lr_states_lalr(value: LRStates*, constructs: bool): bool {
    var count: usize = 0;
    var index: usize = 0;
    loop {
        var done = index == value.states.length;
        if done {
            break;
        }
        var state = value.states.data[index];
        state.base = count;
        count = count + state.items.values.length;
        index = index + 1;
    }
    var graph = lr_propagation_create(count);
    var missing = graph == null;
    if missing {
        return false;
    }
    var ok = lr_lalr_seed(value, graph, constructs);
    var state_index: usize = 0;
    loop {
        if ok {} else {
            break;
        }
        var done = state_index == value.states.length;
        if done {
            break;
        }
        var state = value.states.data[state_index];
        index = 0;
        loop {
            if ok {} else {
                break;
            }
            done = index == state.items.values.length;
            if done {
                break;
            }
            var item = &state.items.values.data[index];
            var kernel = lr_kernel(value.analysis, item);
            if kernel {
                var source = state.base + index;
                ok = lr_lalr_kernel(value, graph, state_index, source, item);
            }
            index = index + 1;
        }
        state_index = state_index + 1;
    }
    if ok {
        ok = lr_propagation_solve(graph);
    }
    if ok {
        ok = lr_lalr_actions(value, graph);
    }
    lr_propagation_destroy(graph);
    return ok;
}

export fn lr_states_action_count(value: LRStates*, index: usize): usize {
    return value.states.data[index].actions.length;
}

export fn lr_states_actions(value: LRStates*, index: usize): LRAction* {
    return value.states.data[index].actions.data;
}
