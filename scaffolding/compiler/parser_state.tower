extern fn tower_utf8_decode(source: u8*, length: usize, value: u32*): usize;

extern fn parser_stream_read(stream: ParserStream*, id: u32*, start: usize*, length: usize*): void*;

extern fn abort(): void;

extern fn parse_forest_visits(forest: void*): usize;
extern fn parse_forest_create_result(budget: WorkBudget*, error: WorkBudgetError*): void*;

struct ParserRequestWork {
    reads: usize;
    actions: usize;
    shifts: usize;
    reductions: usize;
    popped: usize;
    forest_visits: usize;
}

struct ParserRequestLookahead {
    runtime: LRRuntime*;
    state: usize;
}

// Request-owned mutable state. Runtime/diagnostic context/stream are borrowed;
// LR control, completion, forest and unread node references are owned here.
struct ParserRequest {
    storage: WorkBuffer;
    resource_error: WorkBudgetError;
    capture_completion: bool;
    completion: LRCompletion*;
    control: LRParser*;
    forest: void*;
    stream: ParserStream*;
    table: ParserHostTable*;
    match_kind: void*;
    runtime: LRRuntime*;
    read_node_or_null: void*;
    read_id: u32;
    read_start: usize;
    read_length: usize;
    complete: bool;
    has_lookahead: bool;
    prefix: bool;
    lookahead_error: work_vector(u8);
    error: work_vector(u8);
    work: ParserRequestWork;
}

export fn parser_recognizer_destroy(request: ParserRequest*): void {
    if request == null {
        return;
    }
    lr_completion_destroy(request.completion);
    var forest = request.forest != null;
    if forest {
        parse_forest_destroy(request.forest);
    }
    lr_parser_destroy(request.control);
    if request.read_node_or_null != null {
        entity_release(request.read_node_or_null);
    }
    work_vector_dispose(&request.lookahead_error);
    work_vector_dispose(&request.error);
    var storage = request.storage;
    work_buffer_dispose(&storage);
}

// Low-level LR request constructor. A null table supports clients driving the
// existing step/tree APIs themselves; full recognizers use the constructor below.
export fn parser_request_create(runtime: LRRuntime*, context: void*, stream: ParserStream*, prefix: bool, specialize: bool): ParserRequest* {
    var error = WorkBudgetError.None;
    return parser_request_create_result(runtime, context, stream, prefix, specialize, &error);
}

fn parser_request_create_result(runtime: LRRuntime*, context: void*, stream: ParserStream*, prefix: bool,
    specialize: bool, error: WorkBudgetError*): ParserRequest* {
    *error = WorkBudgetError.Invalid;
    var missing = runtime == null;
    if missing {
        return null;
    }
    missing = stream == null;
    if missing {
        return null;
    }
    var storage: WorkBuffer = default;
    *error = work_buffer_resize(&storage, runtime.budget, sizeof(ParserRequest), 0);
    if *error != WorkBudgetError.None { return null; }
    var request = bits(ParserRequest*, storage.data);
    *request = {storage: storage, ..default};
    request.stream = stream;
    request.table = bits(ParserHostTable*, context);
    request.runtime = runtime;
    request.read_id = ParserStreamEnd;
    request.prefix = prefix;
    request.forest = parse_forest_create_result(runtime.budget, error);
    if request.forest == null {
        parser_recognizer_destroy(request);
        return null;
    }
    request.control = lr_parser_create_result(runtime, prefix, specialize, error);
    if request.control == null {
        parser_recognizer_destroy(request);
        return null;
    }
    return request;
}

export fn parser_recognizer_capture_completion(request: ParserRequest*): void {
    request.capture_completion = true;
}

export fn parser_recognizer_take_completion(request: ParserRequest*): LRCompletion* {
    var result = request.completion;
    request.completion = null;
    return result;
}

export fn parser_recognizer_get_error(opaque: void*): u8* {
    var request = bits(ParserRequest*, opaque);
    if request.error.length == 0 && request.resource_error != WorkBudgetError.None {
        return "Unable to acquire parser resources";
    }
    return request.error.data ?? "";
}

fn parser_request_error_assign(request: ParserRequest*, output: work_vector(u8)*, text: u8*): WorkBudgetError {
    if text == null { return WorkBudgetError.Invalid; }
    var length: usize = 0;
    while text[length] != 0 { length++; }
    if length == 0 {
        output.length = 0;
        if output.data != null { output.data[0] = 0; }
        return WorkBudgetError.None;
    }
    var bytes = length + 1;
    if bytes == 0 { return WorkBudgetError.Invalid; }
    var error = work_vector_reserve_result(output, request.runtime.budget, bytes);
    if error != WorkBudgetError.None { return error; }
    copy(output.data, text, bytes);
    output.length = length;
    return WorkBudgetError.None;
}

export fn parser_recognizer_read_id(request: ParserRequest*): void {
    var empty = request.read_node_or_null == null;
    parser_state_require(empty);
    request.work.reads++;
    request.read_node_or_null = parser_stream_read(request.stream, &request.read_id, &request.read_start, &request.read_length);
    request.resource_error = parser_stream_resource_error(request.stream);
    if request.resource_error != WorkBudgetError.None { return; }
    var end = request.read_id == ParserStreamEnd;
    if end {
        var gap = request.read_start == convert(usize, ParserStreamEnd);
        gap ||= request.read_start == lr_none();
        if gap {
            request.read_start = lr_parser_consumed(request.control);
        }
        request.read_length = 0;
    }
    request.resource_error = parser_request_error_assign(request, &request.lookahead_error, parser_stream_get_error(request.stream));
    if request.resource_error != WorkBudgetError.None { return; }
    var capture = request.capture_completion;
    capture &&= end;
    capture &&= request.lookahead_error.length == 0;
    if capture {
        lr_completion_destroy(request.completion);
        request.completion = lr_completion_create_result(request.control, &request.resource_error);
    }
    request.has_lookahead = true;
}

export fn parser_return_lookahead(request: ParserRequest*): void {
    if !request.has_lookahead {
        return;
    }
    parser_stream_return_owned(request.stream, &request.read_node_or_null, request.read_id, request.read_start, request.read_length, &request.lookahead_error);
    request.has_lookahead = false;
}

// Advance ordinary LR control, requesting at most one stream token per step.
fn parser_request_advance(request: ParserRequest*, step: LRStep*, polling: bool): u32 {
    if request.resource_error != WorkBudgetError.None { return convert(u32, ParserAction.Invalid); }
    var error = request.lookahead_error.length != 0;
    var kind = lr_parser_step(request.control, request.has_lookahead, request.read_id,
    error, request.read_start, request.read_length, step);
    if kind == convert(u32, ParserAction.NeedInput) {
        var waiting = polling;
        waiting &&= request.stream.kind == ParserInputService.Empty;
        waiting &&= request.stream.buffered == false;
        if waiting {
            return kind;
        }
        parser_recognizer_read_id(request);
        if request.resource_error != WorkBudgetError.None { return convert(u32, ParserAction.Invalid); }
        error = request.lookahead_error.length != 0;
        kind = lr_parser_step(request.control, request.has_lookahead, request.read_id,
        error, request.read_start, request.read_length, step);
    }
    return kind;
}

export fn parser_request_next(request: ParserRequest*, step: LRStep*): u32 {
    return parser_request_advance(request, step, false);
}

export fn parser_request_work(request: ParserRequest*, result: ParserRequestWork*): void {
    copy(result, &request.work, sizeof(ParserRequestWork));
    var work: LRWork;
    lr_parser_work(request.control, &work);
    result.actions = result.actions + work.actions;
    result.shifts = result.shifts + work.shifts;
    result.reductions = result.reductions + work.reductions;
    result.popped = result.popped + work.popped;
    result.forest_visits = parse_forest_visits(request.forest);
}

export fn parser_request_lookahead(request: ParserRequest*, result: ParserRequestLookahead*): void {
    result.runtime = null;
    result.state = lr_none();
    if request == null {
        return;
    }
    var count = lr_parser_frame_count(request.control);
    if count == 0 {
        return;
    }
    var frame: LRFrame;
    var last = count -1;
    lr_parser_frame(request.control, last, &frame);
    result.runtime = request.runtime;
    result.state = frame.state;
}

export fn parser_recognizer_account_lookahead(request: ParserRequest*, checks: usize): void {
    if request != null {
        request.work.actions = request.work.actions + checks;
    }
}

export fn parser_recognizer_accepts(request: ParserRequest*, id: u32): bool {
    var context: ParserRequestLookahead;
    parser_request_lookahead(request, &context);
    if context.runtime == null {
        return false;
    }
    parser_recognizer_account_lookahead(request, 1);
    var action: LRAction;
    return lr_runtime_action(context.runtime, context.state, id, &action);
}

extern fn parser_presentation_text(table: ParserHostTable*, kind: ParserFormatKind, first: usize, second: usize): u8*;

extern fn parser_trace_step(table: ParserHostTable*, rule: usize, state: usize, offset: usize): void;

extern fn syntax_parser_diagnostic_read(source: void*, position: usize*, context: ParserRequestLookahead*, id: u32*): bool;

export fn parser_table_completion(table: ParserHostTable*): LRCompletion* {
    var error = WorkBudgetError.None;
    return parser_table_completion_result(table, &error);
}

export fn parser_table_completion_result(table: ParserHostTable*, error: WorkBudgetError*): LRCompletion* {
    var control = lr_parser_create_result(bits(LRRuntime*, table.runtime), true, false, error);
    if control == null {
        return null;
    }
    var result = lr_completion_create_result(control, error);
    lr_parser_destroy(control);
    return result;
}

fn parser_recognizer_create_mode(table: ParserHostTable*, stream: ParserStream*, prefix: bool): ParserRequest* {
    var error = WorkBudgetError.None;
    return parser_recognizer_create_mode_result(table, stream, prefix, &error);
}

fn parser_recognizer_create_mode_result(table: ParserHostTable*, stream: ParserStream*, prefix: bool,
    error: WorkBudgetError*): ParserRequest* {
    *error = WorkBudgetError.Invalid;
    var missing = table == null;
    if missing {
        return null;
    }
    var valid = table.built;
    valid &&= table.match_kind != null;
    if !valid {
        return null;
    }
    if prefix {
        valid = table.mode == convert(u32, ParserReadMode.Constructs);
        if !valid {
            return null;
        }
    }
    var specialize = table.trace == false;
    var request = parser_request_create_result(bits(LRRuntime*, table.runtime), bits(void*, table), stream, prefix, specialize, error);
    missing = request == null;
    if !missing {
        request.match_kind = table.match_kind;
    }
    return request;
}

export fn parser_recognizer_create(table: ParserHostTable*, stream: ParserStream*): ParserRequest* {
    return parser_recognizer_create_mode(table, stream, false);
}

export fn parser_recognizer_create_result(table: ParserHostTable*, stream: ParserStream*, error: WorkBudgetError*): ParserRequest* {
    return parser_recognizer_create_mode_result(table, stream, false, error);
}

export fn parser_recognizer_create_prefix(table: ParserHostTable*, stream: ParserStream*): ParserRequest* {
    return parser_recognizer_create_mode(table, stream, true);
}

export fn parser_recognizer_create_prefix_result(table: ParserHostTable*, stream: ParserStream*, error: WorkBudgetError*): ParserRequest* {
    return parser_recognizer_create_mode_result(table, stream, true, error);
}

export fn parser_recognizer_resource_error(request: ParserRequest*): WorkBudgetError {
    return request.resource_error;
}

fn parser_request_fail(request: ParserRequest*, message: u8*): void {
    if request.resource_error == WorkBudgetError.None {
        request.resource_error = parser_request_error_assign(request, &request.error, message);
    }
    request.complete = true;
}

fn parser_recognizer_advance(request: ParserRequest*, running: bool*, waiting: bool*, polling: bool): void* {
    *running = false;
    *waiting = false;
    if request.complete {
        return null;
    }
    var step: LRStep;
    var kind = parser_request_advance(request, &step, polling);
    if request.resource_error != WorkBudgetError.None {
        parser_request_fail(request, "Unable to allocate parser completion within its memory budget");
        return null;
    }
    var action = convert(ParserAction, kind);
    match action {
        ParserAction.Unexpected => {
            if request.lookahead_error.length != 0 {
                parser_request_fail(request, request.lookahead_error.data);
            } else {
                var message: WorkBuffer = default;
                defer work_buffer_dispose(&message);
                request.resource_error = parser_presentation_buffer_result(request.table, ParserFormatKind.Unexpected,
                    convert(usize, request.read_id), 0, request.runtime.budget, &message);
                if request.resource_error != WorkBudgetError.None {
                    parser_request_fail(request, "Unable to format unexpected parser input within its memory budget");
                } else {
                    work_vector_dispose(&request.error);
                    var length: usize = 0;
                    while message.data[length] != 0 { length++; }
                    request.error = {data: message.data, length: length, capacity: message.capacity, reservation: message.reservation};
                    message = default;
                    request.complete = true;
                }
            }
            return null;
        }
        ParserAction.EmptyPrefix => {
            parser_request_fail(request, "Prefix construct must consume input");
            return null;
        }
        ParserAction.Accept => {
            var root = lr_tree_accept(request.control, request.forest);
            var present = root != null;
            parser_state_require(present);
            if request.prefix {
                parser_return_lookahead(request);
            }
            request.complete = true;
            return root;
        }
        ParserAction.Invalid => {
            abort();
            return null;
        }
        ParserAction.NeedInput => {
            *waiting = true;
            return null;
        }
        _ => {}
    }
    var shift = action == ParserAction.Shift;
    shift ||= action == ParserAction.SequenceShift;
    // Disabled tracing never constructs a formatter request or debug string.
    if request.table.trace {
        var rule = step.rule;
        var state = lr_none();
        if shift {
            rule = lr_none();
            state = step.next;
        }
        parser_trace_step(request.table, rule, state, request.read_start);
    }
    var grammar = bits(LRGrammar*, request.table.grammar);
    if shift {
        var label: WorkBuffer = default;
        defer work_buffer_dispose(&label);
        if lr_tree_needs_label(request.read_node_or_null, request.match_kind) {
            request.resource_error = parser_presentation_buffer_result(request.table, ParserFormatKind.Scalar,
                convert(usize, step.id), 0, request.runtime.budget, &label);
            if request.resource_error != WorkBudgetError.None {
                parser_request_fail(request, "Unable to format parser label within its memory budget");
                return null;
            }
        }
        var status = lr_tree_shift(request.control, request.forest, grammar, request.match_kind, &step, &request.read_node_or_null, label.data);
        if status == 2 {
            parser_request_fail(request, "Stream returned an attached node");
            return null;
        }
        var ok = status != 0;
        if !ok {
            request.resource_error = request.control.storage_error != WorkBudgetError.None
                ? request.control.storage_error : WorkBudgetError.Memory;
            parser_request_fail(request, "Unable to allocate parser tree");
            return null;
        }
        request.has_lookahead = false;
    } else {
        var result: void* = null;
        var ok = lr_tree_reduce_kind(request.control, request.forest, grammar, request.match_kind, &step, &result);
        if !ok {
            request.resource_error = request.control.storage_error != WorkBudgetError.None
                ? request.control.storage_error : WorkBudgetError.Memory;
            parser_request_fail(request, "Unable to allocate parser tree");
            return null;
        }
        if result != null {
            request.complete = true;
            return result;
        }
    }
    *running = true;
    return null;
}

// Pull-driven external streams suspend at an empty slot; EOF is an explicit
// ParserStreamEnd token supplied through parser_stream_return. No callbacks or
// speculative reads are necessary. Exactly one coordinator owns the request.
export fn parser_recognizer_poll(request: ParserRequest*, running: bool*, waiting: bool*): void* {
    return parser_recognizer_advance(request, running, waiting, true);
}

// Existing UTF-8/syntax/recognizer streams provide their own EOF boundary.
export fn parser_recognizer_step(request: ParserRequest*, running: bool*): void* {
    var waiting: bool;
    return parser_recognizer_advance(request, running, &waiting, false);
}

export fn parser_diagnostic_destroy(result: ParserDiagnostic*): void {
    if result == null {
        return;
    }
    var owner = bits(ParserDiagnosticOwner*, result);
    foreach(var & label in &owner.labels) { work_buffer_dispose(label); }
    work_vector_dispose(&owner.labels);
    work_vector_dispose(&owner.options);
    frontend_diagnostic_destroy(bits(FrontendDiagnostic*, result.probe));
    var storage = owner.storage;
    work_buffer_dispose(&storage);
}

// The public view remains first and keeps its existing ABI. Only this owner
// destroys its option/label receipts; callers borrow the public vector view.
struct ParserDiagnosticOwner {
    value: ParserDiagnostic;
    storage: WorkBuffer;
    options: work_vector(SyntaxDiagnosticOption);
    labels: work_vector(WorkBuffer);
}

extern fn parser_presentation_buffer_result(table: ParserHostTable*, kind: ParserFormatKind,
    first: usize, second: usize, budget: WorkBudget*, output: WorkBuffer*): WorkBudgetError;

// Read-only with respect to table, recognizer, stream, entities and world.
// Probe stacks/format buffers are local to this diagnostic, never cached there.
export fn parser_recognizer_diagnostic(request: ParserRequest*, reader: ParserDiagnosticReader, source: void*): ParserDiagnostic* {
    var error = WorkBudgetError.None;
    return parser_recognizer_diagnostic_result(request, reader, source, &error);
}

export fn parser_recognizer_diagnostic_result(request: ParserRequest*, reader: ParserDiagnosticReader,
    source: void*, error: WorkBudgetError*): ParserDiagnostic* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if request == null || request.table == null || request.control == null
        || (reader != ParserDiagnosticReader.None && source == null) { return null; }
    *error = request.resource_error;
    if *error != WorkBudgetError.None { return null; }
    var budget = request.runtime.budget;
    var storage: WorkBuffer = default;
    *error = work_buffer_resize(&storage, budget, sizeof(ParserDiagnosticOwner), 0);
    if *error != WorkBudgetError.None { return null; }
    var owner = bits(ParserDiagnosticOwner*, storage.data);
    *owner = {storage: storage, ..default};
    var result = &owner.value;
    var ready = false;
    defer { if !ready { parser_diagnostic_destroy(result); } }
    result.offset = request.read_start;
    result.insertion_offset = lr_parser_consumed(request.control);
    result.at_start = lr_parser_shifted(request.control) == false;
    var input = reader != ParserDiagnosticReader.None;
    var bad_input = request.lookahead_error.length != 0;
    var probe = frontend_diagnostic_create_result(request.control, request.prefix, input, bad_input,
        request.read_id, request.read_start, error);
    result.probe = bits(void*, probe);
    if probe == null { return null; }
    loop {
        var need = frontend_diagnostic_next(probe);
        if need == 0 {
            break;
        }
        var state = frontend_diagnostic_state(probe);
        var contexts = need == 1;
        if contexts {
            var positions = &request.table.states.data[state].contexts;
            frontend_diagnostic_contexts(probe, positions.data, positions.length);
        } else {
            var position = frontend_diagnostic_position(probe);
            var id = ParserStreamEnd;
            var valid: bool = false;
            var context: ParserRequestLookahead;
            context.runtime = request.runtime;
            context.state = state;
            match reader {
                ParserDiagnosticReader.Syntax => {
                    valid = syntax_parser_diagnostic_read(source, &position, &context, &id);
                }
                ParserDiagnosticReader.Utf8 => {
                    var text = bits(ParserUtf8Stream*, source);
                    if position < text.source.length {
                        var at = text.source.data + position;
                        var remaining = text.source.length -position;
                        var read = tower_utf8_decode(at, remaining, &id);
                        valid = read != 0;
                        position = position + read;
                    } else {
                        valid = true;
                    }
                }
                _ => {}
            }
            frontend_diagnostic_feed(probe, valid, position, id);
        }
    }
    result.complete = frontend_diagnostic_complete(probe);
    *error = frontend_diagnostic_resource_error(probe);
    if *error != WorkBudgetError.None { return null; }
    var index: usize = 0;
    var count = frontend_diagnostic_count(probe);
    *error = work_vector_reserve_result(&owner.options, budget, count);
    if *error != WorkBudgetError.None { return null; }
    *error = work_vector_reserve_result(&owner.labels, budget, count);
    if *error != WorkBudgetError.None { return null; }
    while index < count {
        var value = frontend_diagnostic_expected(probe, index);
        var option = &owner.options.data[index];
        *option = default;
        option.id = value.id;
        var label = &owner.labels.data[owner.labels.length++];
        *label = default;
        *error = parser_presentation_buffer_result(request.table, ParserFormatKind.Expected,
            convert(usize, value.id), 0, budget, label);
        if *error != WorkBudgetError.None { return null; }
        option.label = label.data;
        option.insertion = value.insertion;
        option.completes = value.completes;
        option.contexts = value.contexts.data;
        option.count = value.contexts.length;
        owner.options.length++;
        index = index + 1;
    }
    result.options = {data: owner.options.data, length: owner.options.length, capacity: owner.options.capacity};
    // Returned contexts are numeric owned copies. No request/table/runtime
    // borrow is needed after the bounded probe has finished.
    lr_probe_destroy(probe.original);
    lr_probe_destroy(probe.stack);
    lr_probe_destroy(probe.continuation);
    probe.original = null;
    probe.stack = null;
    probe.continuation = null;
    probe.runtime = null;
    ready = true;
    return result;
}
