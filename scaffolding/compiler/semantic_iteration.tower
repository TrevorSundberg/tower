import tower;
import foundation_tags;
import foundation_types;
import semantic_context;
import semantic_control;
import semantic_defer;
import semantic_declarations;
import semantic_statements;
import semantic_support;
import semantic_types;
import semantic_values;
import semantic_modules;
import semantic_layout;
import semantic_call_inference;
import .library.vector;

var IterationSourceDepthLimit: u32 = 123;
var IterationParameterCount: usize = 2;
enum IterationRole: u32 { Begin, Next, Element, End }

// A continuation on the owning body-work component. These are ordinary
// function entities/signature receipts, never a second protocol representation.
struct SemanticIterationPlan {
    initial: void*;
    module: void*;
    prefix: u8*;
    begin: void*;
    next: void*;
    element: void*;
    end: void*;
    ready: bool;
    state_type: FoundationType;
    state_checked: bool;
    state_ready: bool;
}

fn sem_iteration_slot(plan: SemanticIterationPlan*, role: IterationRole): void** {
    match role {
        IterationRole.Begin => { return &plan.begin; }
        IterationRole.Next => { return &plan.next; }
        IterationRole.Element => { return &plan.element; }
        _ => { return &plan.end; }
    }
}

fn sem_iteration_suffix(role: IterationRole): u8* {
    match role {
        IterationRole.Begin => { return "begin"; }
        IterationRole.Next => { return "next"; }
        IterationRole.Element => { return "element"; }
        _ => { return "end"; }
    }
}

fn sem_iteration_plan(c: SemanticContext*, n: void*, initial: void*, plan: SemanticIterationPlan*): bool {
    *plan = default;
    var type = &sem_get(initial).type;
    if type.scalar != SStruct || type.pointers != 1 {
        sem_fail(c, n, "foreach requires a pointer to a nominal collection; use &collection");
        return false;
    }
    var declaration = generic_specialization(c.generics, type.record) ?? type.record;
    declaration = generic_definition(c.generics, declaration);
    plan.initial = initial;
    plan.module = sem_owner(c, declaration);
    plan.prefix = sem_cat(c, sem_identifier(c, sem_member(declaration, "name")), "_iterate_");
    return true;
}

// The source's nominal declaration owns a statically resolved iteration protocol
// in its module. Each compilation exclusively owns its scratch and ECS graph. These are ordinary functions, with no container-name cases or
// independent iterator opcodes. The source pointer is evaluated exactly once.
fn sem_iteration_function(c: SemanticContext*, module: void*, name: u8*, use: void*, source: void*): void* {
    return sem_iteration_resolve(c, module, name, use, source, false);
}

fn sem_iteration_resolve(c: SemanticContext*, module: void*, name: u8*, use: void*, source: void*, pending: bool): void* {
    var function = sem_owned(c.functions, module, name);
    var definition = sem_owned(c.templates, module, name);
    if definition != null {
        var count = generic_parameter_count(c.generics, definition);
        var runtime: usize = 0;
        for(var i: usize = 0; i < count; i++) {
            if !generic_type_parameter(c.generics, definition, i) {
                runtime++;
            }
        }
        if runtime != IterationParameterCount {
            sem_fail(c, use, "An iteration protocol function requires source and state pointer parameters");
            return null;
        }
        var values = sem_list(c);
        sem_push(values, source);
        sem_push(values, null);
        var arguments = sem_infer_arguments(c, definition, use, values);
        if !sem_ok(c) {
            return null;
        }
        function = pending ? sem_prepare_signature(c, definition, use, arguments)
            : sem_call_specialization(c, definition, use, arguments);
    }
    if function == null && sem_ok(c) {
        sem_fail(c, use, sem_cat(c, "Missing iteration protocol function '", sem_cat(c, name, "' in the source type's module")));
    }
    if !sem_ok(c) {
        return null;
    }
    if !pending && sem_get(function).parameters.length != IterationParameterCount {
        sem_fail(c, use, "An iteration protocol function requires source and state pointer parameters");
        return null;
    }
    return function;
}

fn sem_iteration_address(c: SemanticContext*, parent: void*, local: void*): void* {
    var result = sem_control_node(c, parent, KAddress);
    var value = sem_get(result);
    value.value = sem_control_read(c, result, local);
    sem_set_type(&value.type, &sem_get(local).type);
    value.type.pointers++;
    return result;
}

fn sem_iteration_call(c: SemanticContext*, parent: void*, function: void*, source: void*, state: void*): void* {
    var result = sem_control_node(c, parent, KCall);
    var value = sem_get(result);
    var signature = sem_get(function);
    value.binding = function;
    sem_set_type(&value.type, &signature.type);
    sem_push(&value.items, sem_control_read(c, result, source));
    sem_push(&value.items, sem_iteration_address(c, result, state));
    for(var i: usize = 0; i < IterationParameterCount; i++) {
        if !semantic_type_equal(&sem_get(value.items.data[i]).type, &sem_get(signature.parameters.data[i]).type) {
            sem_fail(c, parent, "Iteration protocol source/state parameter types must agree exactly");
        }
    }
    return result;
}

struct SemanticIterationCursor {
    scope: SemanticScope*;
    deferred: void*;
    iteration: void*;
    cleanup: void*;
}

fn sem_iteration_begin(c: SemanticContext*, n: void*, depth: u32, cursor: SemanticIterationCursor*): bool {
    return sem_iteration_value(c, n, depth, cursor, null);
}

fn sem_iteration_value(c: SemanticContext*, n: void*, depth: u32, cursor: SemanticIterationCursor*, initial: void*): bool {
    return sem_iteration_prepared(c, n, depth, cursor, initial, null);
}

// Signature/layout preparation publishes immutable storage information before
// a body worker constructs its private loop, locals and cleanup. Immediate
// callers use this same path; no worker may discover a new shared layout.
fn sem_iteration_state(c: SemanticContext*, n: void*, plan: SemanticIterationPlan*): bool {
    if plan.state_checked { return true; }
    var state_type = &plan.state_type;
    *state_type = sem_get(sem_get(plan.begin).parameters.data[1]).type;
    if state_type.pointers != 1 {
        sem_fail(c, n, "iterate_begin requires a pointer to its local iterator state");
        return false;
    }
    state_type.pointers--;
    var nothing = sem_type_new(c, SVoid, 0, null);
    var boolean = sem_type_new(c, SBool, 0, null);
    if !semantic_type_equal(&sem_get(plan.begin).type, nothing) || !semantic_type_equal(&sem_get(plan.end).type, nothing) ||
    !semantic_type_equal(&sem_get(plan.next).type, boolean) || sem_get(plan.element).type.pointers == 0 ||
    (sem_get(plan.element).type.pointers == 1 && sem_get(plan.element).type.scalar == SVoid) ||
    (state_type.pointers == 0 && state_type.scalar == SVoid) {
        sem_fail(c, n, "Iteration requires begin/end: void, next: bool, element: pointer, and concrete state storage");
        return false;
    }
    plan.state_checked = true;
    return true;
}

fn sem_iteration_storage(c: SemanticContext*, n: void*, plan: SemanticIterationPlan*): bool {
    if plan.state_ready { return true; }
    if !sem_iteration_state(c, n, plan) { return false; }
    if semantic_aggregate(&plan.state_type) { sem_layout(c, plan.state_type.record); }
    plan.state_ready = sem_ok(c);
    return plan.state_ready;
}

fn sem_iteration_prepared(c: SemanticContext*, n: void*, depth: u32, cursor: SemanticIterationCursor*, initial: void*, prepared: SemanticIterationPlan*): bool {
    *cursor = default;
    if depth > IterationSourceDepthLimit {
        sem_fail(c, n, "foreach lowering exceeds Foundation block nesting limit of 128");
        return false;
    }
    if c.labels != null && c.labels.count != 0 {
        sem_fail(c, n, "foreach cleanup cannot be combined with explicit function labels or jumps");
        return false;
    }
    initial ??= sem_operand(c, sem_member(n, "source"), null);
    if !sem_ok(c) {
        return false;
    }
    var local: SemanticIterationPlan = default;
    if prepared == null || !prepared.ready {
        if !sem_iteration_plan(c, n, initial, &local) { return false; }
        local.begin = sem_iteration_function(c, local.module, sem_cat(c, local.prefix, "begin"), n, initial);
        local.next = sem_iteration_function(c, local.module, sem_cat(c, local.prefix, "next"), n, initial);
        local.element = sem_iteration_function(c, local.module, sem_cat(c, local.prefix, "element"), n, initial);
        local.end = sem_iteration_function(c, local.module, sem_cat(c, local.prefix, "end"), n, initial);
        prepared = &local;
    }
    var begin = prepared.begin;
    var next = prepared.next;
    var element = prepared.element;
    var end = prepared.end;
    if !sem_ok(c) {
        return false;
    }
    if !sem_iteration_storage(c, n, prepared) { return false; }
    var state_type = &prepared.state_type;
    var value = sem_node(c, n, KBlock);
    var source = sem_control_local(c, n, initial);
    var state = sem_control_node(c, n, KDeclare);
    sem_set_name(sem_get(state), sem_control_name(c));
    sem_set_type(&sem_get(state).type, state_type);
    sem_add_local(c, state);
    sem_push(&value.locals, state);
    sem_push(&value.items, state);
    sem_push(&value.items, sem_iteration_call(c, n, begin, source, state));
    var cleanup = sem_control_node(c, n, KBlock);
    sem_push(&sem_get(cleanup).items, sem_iteration_call(c, cleanup, end, source, state));
    if !sem_ok(c) {
        return false;
    }
    var saved = c.deferred;
    var pending = bits(SemanticDeferred*, sem_allocate(c, sizeof(SemanticDeferred)));
    pending.previous = bits(SemanticDeferred*, saved);
    pending.body = cleanup;
    pending.loops = c.loops;
    pending.flow = FlowNext;
    c.deferred = bits(void*, pending);
    c.has_defer = true;

    var loop_node = sem_control_node(c, n, KLoop);
    var loop_body = sem_control_node(c, loop_node, KBlock);
    sem_get(loop_node).body = loop_body;
    sem_push(&value.items, loop_node);
    var test = sem_iteration_call(c, loop_body, next, source, state);
    var condition = sem_control_read(c, loop_body, sem_control_local(c, loop_body, test));
    var iteration = sem_control_node(c, loop_body, KBlock);
    var otherwise = sem_control_branch(c, loop_body, condition, iteration);
    sem_push(&sem_get(otherwise).items, sem_control_node(c, otherwise, KBreak));
    var address = sem_iteration_call(c, iteration, element, source, state);
    var initializer = address;
    if sem_tokens(c, sem_member(n, "borrow"))[0] == 0 {
        initializer = sem_control_node(c, iteration, KLoad);
        sem_get(initializer).value = address;
        sem_set_type(&sem_get(initializer).type, &sem_get(address).type);
        sem_get(initializer).type.pointers--;
        if semantic_aggregate(&sem_get(initializer).type) {
            sem_fail(c, n, "Aggregate iteration requires an explicit borrow: foreach (var &item in &collection)");
        }
    }
    var item = sem_control_local(c, iteration, initializer);
    // A generated declaration has a checked initializer but no source type/value
    // capture. Publish its resolved type before exposing the lexical binding.
    sem_declaration_state(c, item).number = 2;
    var name = sem_identifier(c, sem_member(n, "name"));
    if name[0] == 0 {
        sem_fail(c, n, "foreach requires a nonempty item name");
    }
    sem_set_name(sem_get(item), name);
    var scope = c.scope;
    c.scope = sem_scope(c, scope);
    sem_put(c, c.scope.names, name, item);
    cursor.scope = scope;
    cursor.deferred = saved;
    cursor.iteration = iteration;
    cursor.cleanup = cleanup;
    return true;
}

fn sem_iteration_finish(c: SemanticContext*, n: void*, cursor: SemanticIterationCursor*, flow: u32): u32 {
    c.scope = cursor.scope;
    c.deferred = cursor.deferred;
    sem_push(&sem_get(cursor.iteration).items, sem_member(n, "body"));
    sem_push(&sem_get(n).items, cursor.cleanup);
    return FlowNext |(flow &FlowReturn);
}

fn sem_iteration(c: SemanticContext*, n: void*, depth: u32): u32 {
    var cursor: SemanticIterationCursor;
    if !sem_iteration_begin(c, n, depth, &cursor) { return FlowNext; }
    c.loops++;
    var flow = sem_block(c, sem_member(n, "body"), depth + 3);
    c.loops--;
    return sem_iteration_finish(c, n, &cursor, flow);
}
