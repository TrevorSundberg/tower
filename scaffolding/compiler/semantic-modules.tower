import tower;
import 'foundation-tags';
import 'frontend-compilation';
import 'semantic-context';
import 'semantic-definitions';
import 'semantic-support';

// Ownership/import components live on the same retained parse entities. The
// registry and lookup tables are compilation-local indexes, not another IR.
// Text is owned by ordinary entity relationship names; no context allocation
// escapes into a retained component. Foundation output encodes resolved bindings.
import 'semantic-program-types';

struct SemanticModuleLink {
    module: void*;
    base: usize;
}

extern fn frontend_module_name(module: void*): u8*;

extern fn frontend_module_import_count(module: void*): usize;

extern fn frontend_module_import_at(module: void*, index: usize): void*;

extern fn frontend_module_dependency_at(module: void*, index: usize): void*;

extern fn frontend_module_alias(module: void*, index: usize): u8*;

extern fn entity_child_name(node: void*, index: usize): u8*;

fn sem_module_kind(parent: void*, size: usize, alignment: usize): void* {
    var kind = sem_create(parent);
    sem_require(entity_register(kind, size, alignment, 0));
    return kind;
}

fn sem_modules_begin(program: SemanticProgram*): SemanticModules* {
    var existing = program.modules != null;
    if existing {
        return program.modules;
    }
    var registry = tower_node_create();
    sem_require(entity_register(registry, sizeof(SemanticModules), alignof(SemanticModules), 0));
    var component = entity_component_add(program.root, registry);
    var modules = bits(SemanticModules*, entity_component_data(component));
    var present = modules != null;
    sem_require(present);
    fill(modules, 0, sizeof(SemanticModules));
    modules.root = registry;
    modules.owner_kind = sem_module_kind(registry, sizeof(SemanticModuleLink), alignof(SemanticModuleLink));
    modules.import_kind = sem_module_kind(registry, sizeof(SemanticModuleLink), alignof(SemanticModuleLink));
    modules.scopes = sem_create(registry);
    program.modules = modules;
    entity_release(registry);
    return modules;
}

fn sem_module_scope(program: SemanticProgram*, module: void*): void* {
    var registry = sem_modules_begin(program);
    var path = frontend_module_name(module);
    var scope = sem_member(registry.scopes, path);
    var missing = scope == null;
    if missing {
        scope = tower_node_create();
        sem_require(entity_attach(scope, registry.scopes, path));
        entity_release(scope);
    }
    return scope;
}

fn sem_module_link(node: void*, kind: void*, scope: void*): void {
    var component = entity_component_add(node, kind);
    var link = bits(SemanticModuleLink*, entity_component_data(component));
    var present = link != null;
    sem_require(present);
    link.module = scope;
    link.base = 0;
}

fn sem_module_position(program: SemanticProgram*, module: void*, base: usize): void {
    var scope = sem_module_scope(program, module);
    sem_module_link(scope, program.modules.owner_kind, scope);
    var component = entity_component_get(scope, program.modules.owner_kind);
    var link = bits(SemanticModuleLink*, entity_component_data(component));
    link.base = base;
}

fn sem_module_record(program: SemanticProgram*, module: void*): void {
    var registry = sem_modules_begin(program);
    var scope = sem_module_scope(program, module);
    var count = frontend_module_roots(module);
    var i: usize = 0;
    while i < count {
        sem_module_link(frontend_module_tree(module, i), registry.owner_kind, scope);
        i = i + 1;
    }
    count = frontend_module_import_count(module);
    i = 0;
    while i < count {
        var declaration = frontend_module_import_at(module, i);
        // Recovered editor parses may contribute a second source snapshot.
        // Each actual declaration keeps its own components and source spans.
        var present = entity_component_get(declaration, registry.import_kind) != null;
        if present {} else {
            var dependency = frontend_module_dependency_at(module, i);
            var target = sem_module_scope(program, dependency);
            var alias = frontend_module_alias(module, i);
            // Inspection retains the source wrapper too. Move the complete
            // tree so its children, roles and hover spans stay intact.
            var tree = sem_parent(declaration);
            var unwrapped = tree == null;
            if unwrapped {
                tree = declaration;
            }
            sem_require(entity_attach(tree, scope, alias));
            sem_module_link(tree, registry.import_kind, target);
            sem_module_link(declaration, registry.import_kind, target);
            sem_module_link(declaration, registry.owner_kind, scope);
        }
        i = i + 1;
    }
}

fn sem_module_graph(program: SemanticProgram*, module: void*): void {
    sem_module_record(program, module);
    var count = frontend_module_count(module);
    var i: usize = 0;
    while i < count {
        var dependency = frontend_module_at(module, i);
        sem_module_record(program, dependency);
        i = i + 1;
    }
}

fn sem_owner(c: SemanticContext*, node: void*): void* {
    var registry = c.program.modules;
    var absent = registry == null;
    if absent {
        return null;
    }
    while node != null {
        var component = entity_component_get(node, registry.owner_kind);
        var link = bits(SemanticModuleLink*, entity_component_data(component));
        var present = link != null;
        if present {
            return link.module;
        }
        var generic = c.generics != null;
        if generic {
            var original = generic_definition(c.generics, node);
            var generated = original != node;
            if generated {
                node = original;
                continue;
            }
        }
        node = sem_parent(node);
    }
    return null;
}

fn sem_module_path(c: SemanticContext*, module: void*): u8* {
    var scopes = c.program.modules.scopes;
    var count = sem_child_count(scopes);
    var i: usize = 0;
    while i < count {
        var found = sem_child(scopes, i) == module;
        if found {
            return entity_child_name(scopes, i);
        }
        i = i + 1;
    }
    return "";
}

fn sem_owned(table: SemanticTable*, module: void*, name: u8*): void* {
    var entry = sem_find(table, name, module);
    var found = entry != null;
    if found {
        return entry.value;
    }
    return null;
}

fn sem_define(c: SemanticContext*, table: SemanticTable*, node: void*, name: u8*): bool {
    var owner = sem_owner(c, node);
    var entry = sem_entry(c, table, name, owner);
    var duplicate = entry.value != null;
    if duplicate {
        return false;
    }
    entry.value = node;
    return true;
}

fn sem_local(c: SemanticContext*, name: u8*): void* {
    var scope = c.scope;
    while scope != null {
        var found = sem_lookup_table(scope.names, name);
        var present = found != null;
        if present {
            return found;
        }
        scope = scope.parent;
    }
    return null;
}

fn sem_import_target(c: SemanticContext*, edge: void*): void* {
    var component = entity_component_get(edge, c.program.modules.import_kind);
    var link = bits(SemanticModuleLink*, entity_component_data(component));
    var present = link != null;
    if present {
        return link.module;
    }
    return null;
}

fn sem_import_alias(owner: void*, index: usize): u8* {
    var name = entity_child_name(owner, index);
    var unnamed = name == null;
    if unnamed {
        return "";
    }
    return name;
}

fn sem_alias(c: SemanticContext*, owner: void*, name: u8*): void* {
    var i: usize = 0;
    var count = sem_child_count(owner);
    while i < count {
        var alias = sem_import_alias(owner, i);
        var matches = sem_equal(alias, name);
        if matches {
            return sem_import_target(c, sem_child(owner, i));
        }
        i = i + 1;
    }
    return null;
}

fn sem_visible(c: SemanticContext*, table: SemanticTable*, node: void*, owner: void*, name: u8*): void* {
    var found = sem_owned(table, owner, name);
    var local = found != null;
    if local {
        return found;
    }
    var legacy = owner == null;
    if legacy {
        return null;
    }
    var count = sem_child_count(owner);
    var i: usize = 0;
    while i < count {
        var alias = sem_import_alias(owner, i);
        var open = alias[0] == 0;
        if open {
            var target = sem_import_target(c, sem_child(owner, i));
            var candidate = sem_owned(table, target, name);
            var present = candidate != null;
            if present {
                var different = found != null;
                if different {
                    different = found != candidate;
                }
                if different {
                    sem_fail(c, node, sem_cat(c, "Ambiguous imported name '", sem_cat(c, name, "'; use an import alias")));
                    return null;
                }
                found = candidate;
            }
        }
        i = i + 1;
    }
    var missing = found == null;
    if missing {
        // Only the reflected Foundation primitive types are ownerless.
        var types = table == c.types;
        if types {
            found = sem_owned(table, null, name);
        }
    }
    return found;
}

fn sem_name_node(node: void*): void* {
    loop {
        var base = sem_member(node, "base");
        var qualified = base != null;
        if qualified {
            return node;
        }
        var name = sem_member(node, "name");
        var wrapper = name != null;
        if wrapper {
            node = name;
        } else {
            return node;
        }
    }
}

fn sem_callable_owned(c: SemanticContext*, owner: void*, name: u8*): void* {
    var found = sem_owned(c.functions, owner, name);
    var missing = found == null;
    if missing {
        found = sem_owned(c.templates, owner, name);
    }
    missing = found == null;
    if missing {
        found = sem_owned(c.type_functions, owner, name);
    }
    return found;
}

fn sem_callable_visible(c: SemanticContext*, table: SemanticTable*, node: void*, owner: void*, name: u8*): void* {
    var local = sem_callable_owned(c, owner, name);
    var present = local != null;
    if present {
        return sem_owned(table, owner, name);
    }
    var selected: void* = null;
    var found: void* = null;
    var i: usize = 0;
    var count = sem_child_count(owner);
    while i < count {
        var alias = sem_import_alias(owner, i);
        var open = alias[0] == 0;
        if open {
            var dependency = sem_import_target(c, sem_child(owner, i));
            var candidate = sem_callable_owned(c, dependency, name);
            present = candidate != null;
            if present {
                var different = found != null;
                if different {
                    different = found != candidate;
                }
                if different {
                    sem_fail(c, node, sem_cat(c, "Ambiguous imported name '", sem_cat(c, name, "'; use an import alias")));
                    return null;
                }
                found = candidate;
                selected = dependency;
            }
        }
        i = i + 1;
    }
    return sem_owned(table, selected, name);
}

fn sem_resolve(c: SemanticContext*, table: SemanticTable*, node: void*, spelling: u8*): void* {
    return sem_resolve_from(c, table, node, spelling, sem_owner(c, node));
}

fn sem_resolve_from(c: SemanticContext*, table: SemanticTable*, node: void*, spelling: u8*, owner: void*): void* {
    var name = sem_name_node(node);
    var indexed = sem_member(name, "index") != null;
    if indexed {
        return null;
    }
    var base = sem_member(name, "base");
    var field = sem_member(name, "field");
    var qualified = base != null;
    if qualified {
        qualified = field != null;
    }
    if qualified {
        var target = sem_namespace_from(c, name, owner);
        var present = target != null;
        if present {
            return sem_owned(table, target, sem_identifier(c, field));
        }
        return null;
    }
    var callable = table == c.functions;
    if callable {} else {
        callable = table == c.templates;
    }
    if callable {} else {
        callable = table == c.type_functions;
    }
    if callable {
        return sem_callable_visible(c, table, node, owner, spelling);
    }
    return sem_visible(c, table, node, owner, spelling);
}

fn sem_namespace(c: SemanticContext*, node: void*): void* {
    return sem_namespace_from(c, node, sem_owner(c, node));
}

fn sem_namespace_from(c: SemanticContext*, node: void*, owner: void*): void* {
    node = sem_name_node(node);
    var base = sem_member(node, "base");
    var field = sem_member(node, "field");
    var possible = base != null;
    if possible {
        possible = field != null;
    }
    if possible {} else {
        return null;
    }
    base = sem_name_node(base);
    var nested = sem_member(base, "base") != null;
    if nested {
        return null;
    }
    var name = sem_identifier(c, base);
    var shadowed = sem_local(c, name) != null;
    var generic = c.generics != null;
    if generic {
        var parameter = generic_lookup(c.generics, base, base);
        var bound = parameter != null;
        if bound {
            shadowed = true;
        }
    }
    if shadowed {
        return null;
    }
    return sem_alias(c, owner, name);
}

fn sem_editor_symbol(c: SemanticContext*, node: void*, kind: u32): bool {
    var name = sem_name_node(node);
    var field = sem_member(name, "field");
    var qualified = field != null;
    var target = name;
    if qualified {
        target = field;
    }
    var captured = sem_editor_capture(c, target, kind, null);
    if captured {
        c.editor.node = node;
        c.editor.module = sem_namespace(c, name);
    }
    return captured;
}

fn sem_completion_visible(c: SemanticContext*, editor: SemanticEditor*, table: SemanticTable*, node: void*): bool {
    var name = sem_identifier(c, sem_member(node, "name"));
    var value = sem_get(node);
    var builtin = name[0] == 0;
    if builtin {
        var present = value != null;
        if present {
            name = sem_name(value);
        }
    }
    var found: void* = null;
    var qualified = editor.module != null;
    if qualified {
        found = sem_owned(table, editor.module, name);
    } else {
        var callable = table == c.functions;
        if callable {} else {
            callable = table == c.templates;
        }
        if callable {} else {
            callable = table == c.type_functions;
        }
        if callable {
            found = sem_callable_visible(c, table, editor.node, sem_owner(c, editor.node), name);
        } else {
            found = sem_visible(c, table, editor.node, sem_owner(c, editor.node), name);
        }
    }
    var clean = sem_ok(c);
    c.program.error.length = 0;
    if clean {
        var same = found == node;
        return same;
    }
    return false;
}

// Keep familiar names when unique. Colliding module-local declarations get a
// deterministic, escaped Foundation spelling; bindings still point to entities.
fn sem_output_name(c: SemanticContext*, node: void*, name: u8*): u8* {
    var saved = sem_find(c.output_names, null, node);
    var present = saved != null;
    if present {
        return bits(u8*, saved.value);
    }
    var spelling = name;
    var original = sem_find(c.source_names, name, null);
    var collision = original != null;
    if collision {
        collision = original.number != 0;
    }
    if collision {
        var owner = sem_owner(c, node);
        var scoped = owner != null;
        if scoped {
            spelling = sem_cat(c, name, sem_cat(c, "@", sem_module_path(c, owner)));
        }
    }
    var candidate = spelling;
    var suffix: u64 = 1;
    loop {
        var taken = sem_lookup_table(c.output_names, candidate);
        var available = taken == null;
        var generated = sem_equal(candidate, name) == false;
        if generated {
            var reserved = sem_find(c.source_names, candidate, null) != null;
            if reserved {
                available = false;
            }
        }
        if available {
            break;
        }
        suffix = suffix + 1;
        candidate = sem_cat(c, spelling, sem_cat(c, "_", sem_decimal(c, suffix)));
    }
    sem_put(c, c.output_names, candidate, node);
    saved = sem_state(c, c.output_names, node);
    saved.value = bits(void*, candidate);
    return candidate;
}

fn sem_validate_aliases(c: SemanticContext*): void {
    var registry = c.program.modules;
    var absent = registry == null;
    if absent {
        return;
    }
    var root = sem_get(c.program.root);
    var count = sem_child_count(registry.scopes);
    var i: usize = 0;
    while i < count {
        var scope = sem_child(registry.scopes, i);
        var imports = sem_child_count(scope);
        var edge: usize = 0;
        while edge < imports {
            var alias = sem_import_alias(scope, edge);
            var named = alias[0] != 0;
            if named {
                var conflict = semantic_builtin_kind(alias) != 0;
                if conflict {} else {
                    conflict = sem_owned(c.types, null, alias) != null;
                }
                var n: usize = 0;
                while n < root.items.length {
                    var declaration = root.items.data[n];
                    var own = sem_owner(c, declaration) == scope;
                    if own {
                        var name = sem_member(declaration, "name");
                        var present = name != null;
                        if present {
                            var same = sem_equal(alias, sem_identifier(c, name));
                            if same {
                                conflict = true;
                            }
                        }
                    }
                    n = n + 1;
                }
                if conflict {
                    sem_fail(c, sem_child(scope, edge), sem_cat(c, "Import alias conflicts with declaration: ", alias));
                    return;
                }
            }
            edge = edge + 1;
        }
        i = i + 1;
    }
}

// Foreign declarations still denote explicit link symbols. Merge identical
// declarations (and their Tower export, if supplied) after checked signatures
// exist. Local Tower names never acquire foreign visibility from this step.
fn sem_link_functions(c: SemanticContext*): void {
    if sem_ok(c) {} else {
        return;
    }
    var symbols = sem_table(c);
    var i: usize = 1;
    while i < c.program.functions.length {
        var node = c.program.functions.data[i];
        var function = sem_get(node);
        var foreign = function.external;
        if function.exported {
            foreign = true;
        }
        if foreign {
            var name = sem_name(function);
            var entry = sem_entry(c, symbols, name, null);
            var previous = entry.value;
            var duplicate = previous != null;
            if duplicate {
                var old = sem_get(previous);
                var compatible = semantic_type_equal(&function.type, &old.type);
                if compatible {
                    compatible = function.parameters.length == old.parameters.length;
                }
                var p: usize = 0;
                while p < function.parameters.length {
                    if compatible {
                        var left = sem_get(function.parameters.data[p]);
                        var right = sem_get(old.parameters.data[p]);
                        compatible = semantic_type_equal(&left.type, &right.type);
                    }
                    p = p + 1;
                }
                if compatible {} else {
                    sem_fail(c, node, sem_cat(c, "Incompatible declarations of foreign symbol '", sem_cat(c, name, "'")));
                    return;
                }
                var definitions = old.exported;
                if definitions {
                    definitions = function.exported;
                }
                if definitions {
                    sem_fail(c, node, sem_cat(c, "Duplicate foreign export '", sem_cat(c, name, "'")));
                    return;
                }
                if function.exported {
                    old.binding = node;
                    entry.value = node;
                } else {
                    function.binding = previous;
                }
            } else {
                entry.value = node;
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < c.functions.capacity {
        var entry = c.functions.entries[i];
        var present = entry != null;
        if present {
            var node = sem_get(entry.value);
            while node.binding != null {
                entry.value = node.binding;
                node = sem_get(entry.value);
            }
        }
        i = i + 1;
    }
    var count: usize = 0;
    i = 0;
    while i < c.program.functions.length {
        var node = c.program.functions.data[i];
        var value = sem_get(node);
        var unique = value.binding == null;
        if unique {
            value.index = count;
            c.program.functions.data[count] = node;
            count = count + 1;
        }
        i = i + 1;
    }
    c.program.functions.length = count;
    var root = sem_get(c.program.root);
    count = 0;
    i = 0;
    while i < root.items.length {
        var node = root.items.data[i];
        var value = sem_get(node);
        var duplicate = value != null;
        if duplicate {
            duplicate = value.kind == KFunction();
        }
        if duplicate {
            duplicate = value.binding != null;
        }
        if duplicate {} else {
            root.items.data[count] = node;
            count = count + 1;
        }
        i = i + 1;
    }
    root.items.length = count;
}
