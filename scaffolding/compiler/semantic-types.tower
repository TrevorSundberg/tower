import tower;
import 'semantic-enums';
import 'semantic-layout';

// Semantic compiler over shared Foundation components.
// Temporary indexes and scratch allocations are scoped to one compilation.

fn sem_type_entity(c: SemanticContext*, t: FoundationType*): void* {
    var i: usize = 0;
    loop {
        var step1 = i < c.program.types.length;
        var step2 = step1 == false;
        if step2 {
            break;
        }
        var n: void* = c.program.types.data[i];
        var step3 = sem_get(n);
        var step4 = semantic_type_equal(&step3.type, t);
        if step4 {
            return n;
        }
        i = i + 1;
    }
    i = 0;
    loop {
        var step5 = i < c.type_arguments.length;
        var step6 = step5 == false;
        if step6 {
            break;
        }
        var n: void* = c.type_arguments.data[i];
        var step7 = sem_get(n);
        var step8 = semantic_type_equal(&step7.type, t);
        if step8 {
            return n;
        }
        i = i + 1;
    }
    var step9 = sem_create(c.program.root);
    var n: void* = step9;
    var step10 = sem_attach(n, KType());
    var value: FoundationNode* = step10;
    sem_set_type(&value.type, t);
    var step11 = sem_type_name(c, t);
    sem_set_name(value, step11);
    sem_push(&c.type_arguments, n);
    return n;
}

fn sem_constant_argument(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    loop {
        var step1 = sem_is(n, "CoreTypeArgument");
        var step2 = step1;
        var step3 = step2 == false;
        if step3 {
            var step4 = sem_is(n, "CoreCallArgument");
            step2 = step4;
        }
        var step5 = step2 == false;
        if step5 {
            var step6 = sem_is(n, "CoreOperand");
            step2 = step6;
        }
        var step7 = step2 == false;
        if step7 {
            var step8 = sem_is(n, "CoreArrayCount");
            step2 = step8;
        }
        var step9 = step2;
        if step9 {
            var step10 = sem_child_count(n);
            var step11 = step10 == 1;
            step9 = step11;
        }
        var step12 = step9 == false;
        if step12 {
            break;
        }
        var step13 = sem_child(n, 0);
        n = step13;
    }
    var step14 = generic_lookup(c.generics, n, n);
    var value: void* = step14;
    var step15 = value == null;
    if step15 {
        var step16 = sem_tokens(c, n);
        var text: u8* = step16;
        var step17 = text[0] == 0;
        var step18 = step17;
        var step19 = step18 == false;
        if step19 {
            var step20 = text[0] != 45;
            var step21 = step20;
            if step21 {
                var step22 = text[0] < 48;
                var step23 = step22;
                var step24 = step23 == false;
                if step24 {
                    var step25 = text[0] > 57;
                    step23 = step25;
                }
                step21 = step23;
            }
            step18 = step21;
        }
        if step18 {
            sem_fail(c, n, "Expected a compile-time integer argument (an integer literal or a bound template value)");
            return null;
        }
        var step26 = sem_type_new(c, SUSize(), 0, null);
        var size: FoundationType* = step26;
        var step27 = expected_type != null;
        if step27 {
            size = expected_type;
        }
        var step28 = sem_operand(c, n, size);
        value = step28;
        var step29 = sem_ok(c);
        var step30 = step29 == false;
        if step30 {
            return null;
        }
    }
    var step31 = sem_get(value);
    var constant: FoundationNode* = step31;
    var step32 = constant.constant == false;
    var step33 = step32;
    var step34 = step33 == false;
    if step34 {
        var step35 = semantic_integer(&constant.type);
        var step36 = step35 == false;
        step33 = step36;
    }
    if step33 {
        sem_fail(c, n, "Expected a compile-time integer argument");
        return null;
    }
    var step37 = expected_type != null;
    var step38 = step37;
    if step38 {
        var step39 = semantic_type_equal(&constant.type, expected_type);
        var step40 = step39 == false;
        step38 = step40;
    }
    if step38 {
        var step41 = sem_type_name(c, expected_type);
        var step42 = sem_cat(c, "Expected ", step41);
        var step43 = sem_type_name(c, &constant.type);
        var step44 = sem_cat(c, " compile-time argument, got ", step43);
        var step45 = sem_cat(c, step42, step44);
        sem_fail(c, n, step45);
        return null;
    }
    var i: usize = 0;
    loop {
        var step46 = i < c.constant_arguments.length;
        var step47 = step46 == false;
        if step47 {
            break;
        }
        var existing: void* = c.constant_arguments.data[i];
        var step48 = sem_get(existing);
        var e: FoundationNode* = step48;
        var step49 = semantic_type_equal(&e.type, &constant.type);
        var step50 = step49;
        if step50 {
            var step51 = e.bits == constant.bits;
            step50 = step51;
        }
        if step50 {
            return existing;
        }
        i = i + 1;
    }
    var step52 = sem_create(c.program.root);
    var result: void* = step52;
    var step53 = sem_attach(result, KOperand());
    var out: FoundationNode* = step53;
    out.constant = true;
    sem_set_type(&out.type, &constant.type);
    out.bits = constant.bits;
    sem_push(&c.constant_arguments, result);
    return result;
}

fn sem_instance_name(c: SemanticContext*, definition: void*, arguments: vector(void*)*): u8* {
    var step1 = sem_member(definition, "name");
    var step2 = sem_identifier(c, step1);
    var step3 = sem_cat(c, step2, "(");
    var name: u8* = step3;
    var i: usize = 0;
    loop {
        var step4 = i < arguments.length;
        var step5 = step4 == false;
        if step5 {
            break;
        }
        var step6 = i != 0;
        if step6 {
            var step7 = sem_cat(c, name, ", ");
            name = step7;
        }
        var step8 = sem_get(arguments.data[i]);
        var arg: FoundationNode* = step8;
        if arg.constant {
            var step9 = sem_number(c, arg.bits, &arg.type);
            var step10 = sem_cat(c, name, step9);
            name = step10;
        } else {
            var step11 = sem_type_name(c, &arg.type);
            var step12 = sem_cat(c, name, step11);
            name = step12;
        }
        i = i + 1;
    }
    var step13 = sem_cat(c, name, ")");
    name = step13;
    var unique: u8* = name;
    var suffix: u64 = 1;
    loop {
        var step14 = sem_lookup_table(c.source_names, unique);
        var step15 = step14 != null;
        var step16 = step15;
        var step17 = step16 == false;
        if step17 {
            var step18 = sem_lookup_table(c.types, unique);
            var step19 = step18 != null;
            step16 = step19;
        }
        var step20 = step16 == false;
        if step20 {
            var step21 = sem_lookup_table(c.functions, unique);
            var step22 = step21 != null;
            step16 = step22;
        }
        var step23 = step16 == false;
        if step23 {
            break;
        }
        suffix = suffix + 1;
        var step24 = sem_cat(c, name, "_");
        var step25 = sem_decimal(c, suffix);
        var step26 = sem_cat(c, step24, step25);
        unique = step26;
    }
    return unique;
}

fn sem_register_template(c: SemanticContext*, n: void*): void {
    var step1 = generic_register(c.generics, n);
    var kind: u32 = step1;
    var step2 = sem_generic_ok(c, n);
    var step3 = step2 == false;
    var step4 = step3;
    var step5 = step4 == false;
    if step5 {
        var step6 = kind == KProgram();
        step4 = step6;
    }
    if step4 {
        return;
    }
    var step7 = sem_member(n, "name");
    var step8 = sem_identifier(c, step7);
    var name: u8* = step8;
    var step9 = sem_is(n, "CoreFunction");
    var step10 = step9 == false;
    if step10 {
        sem_fail(c, n, "Templates cannot be extern or export declarations; export a concrete wrapper");
        return;
    }
    var step11 = sem_table(c);
    var names: SemanticTable* = step11;
    var step12 = sem_member(n, "params");
    var step13 = sem_collect(c, step12, "CoreParameter");
    var parameters: vector(void*)* = step13;
    var i: usize = 0;
    loop {
        var step14 = i < parameters.length;
        var step15 = step14 == false;
        if step15 {
            break;
        }
        var p: void* = parameters.data[i];
        var step16 = sem_member(p, "name");
        var step17 = sem_identifier(c, step16);
        var value: u8* = step17;
        var step18 = sem_put(c, names, value, p);
        var step19 = step18 == false;
        if step19 {
            var step20 = sem_cat(c, "Duplicate template parameter '", value);
            var step21 = sem_cat(c, step20, "'");
            sem_fail(c, p, step21);
            return;
        }
        i = i + 1;
    }
    var registry: SemanticTable* = c.templates;
    var step22 = kind == KParameter();
    if step22 {
        registry = c.type_functions;
    }
    var step23 = sem_put(c, registry, name, n);
    var step24 = step23 == false;
    if step24 {
        var step25 = sem_cat(c, "Duplicate template '", name);
        var step26 = sem_cat(c, step25, "'");
        sem_fail(c, n, step26);
        return;
    }
    var step27 = semantic_builtin_kind(name);
    var step28 = step27 != 0;
    if step28 {
        var step29 = sem_cat(c, "Template name '", name);
        var step30 = sem_cat(c, step29, "' already names a foundation builtin");
        sem_fail(c, n, step30);
    }
    sem_push(&c.template_nodes, n);
}

fn sem_type_call(c: SemanticContext*, n: void*): FoundationType* {
    var step1 = sem_member(n, "name");
    var step2 = sem_identifier(c, step1);
    var name: u8* = step2;
    var step3 = sem_lookup_table(c.type_functions, name);
    var definition: void* = step3;
    var step4 = sem_type_new(c, SI32(), 0, null);
    var invalid: FoundationType* = step4;
    var step5 = definition == null;
    if step5 {
        var step6 = sem_cat(c, "Unknown type constructor '", name);
        var step7 = sem_cat(c, step6, "'");
        sem_fail(c, n, step7);
        return invalid;
    }
    var wanted: u8* = "CoreTypeArgument";
    var step8 = sem_is(n, "CoreCall");
    if step8 {
        wanted = "CoreCallArgument";
    }
    var step9 = sem_member(n, "args");
    var step10 = sem_collect(c, step9, wanted);
    var args: vector(void*)* = step10;
    var step11 = args.length == 0;
    var step12 = step11;
    if step12 {
        var step13 = sem_is(n, "CoreCall");
        var step14 = step13 == false;
        step12 = step14;
    }
    if step12 {
        var step15 = sem_member(n, "args");
        var step16 = sem_collect(c, step15, "CoreType");
        args = step16;
    }
    var step17 = generic_parameter_count(c.generics, definition);
    var step18 = args.length != step17;
    if step18 {
        var step19 = sem_cat(c, "Wrong argument count for type constructor '", name);
        var step20 = sem_cat(c, step19, "'");
        sem_fail(c, n, step20);
        return invalid;
    }
    var step21 = sem_list(c);
    var arguments: vector(void*)* = step21;
    var step22 = sem_member(definition, "params");
    var step23 = sem_collect(c, step22, "CoreParameter");
    var parameters: vector(void*)* = step23;
    var i: usize = 0;
    loop {
        var step24 = i < args.length;
        var step25 = step24 == false;
        if step25 {
            break;
        }
        var step26 = generic_type_parameter(c.generics, definition, i);
        if step26 {
            var step27 = sem_type(c, args.data[i]);
            var step28 = sem_type_entity(c, step27);
            sem_push(arguments, step28);
        } else {
            var step29 = sem_member(parameters.data[i], "type");
            var step30 = sem_type(c, step29);
            var expected_type: FoundationType* = step30;
            var step31 = semantic_integer(expected_type);
            var step32 = step31 == false;
            if step32 {
                sem_fail(c, parameters.data[i], "Compile-time value parameters currently require an integer type");
                return invalid;
            }
            var step33 = sem_constant_argument(c, args.data[i], expected_type);
            sem_push(arguments, step33);
        }
        var step34 = sem_ok(c);
        var step35 = step34 == false;
        if step35 {
            return invalid;
        }
        i = i + 1;
    }
    var step36 = generic_instantiate(c.generics, definition, n, arguments.data, arguments.length);
    var instance: void* = step36;
    var step37 = sem_generic_ok(c, n);
    var step38 = step37 == false;
    var step39 = step38;
    var step40 = step39 == false;
    if step40 {
        var step41 = instance == null;
        step39 = step41;
    }
    if step39 {
        return invalid;
    }
    var step42 = sem_state(c, c.source_bases, instance);
    var step43 = sem_source_base(c, definition);
    step42.number = step43;
    var step44 = sem_state(c, c.type_results, instance);
    var entry: SemanticEntry* = step44;
    var step45 = entry.value != null;
    if step45 {
        var step46 = bits(FoundationType*, entry.value);
        return step46;
    }
    var step47 = entry.number != 0;
    if step47 {
        var step48 = sem_cat(c, "Recursive type constructor '", name);
        var step49 = sem_cat(c, step48, "' has no concrete struct to resolve");
        sem_fail(c, n, step49);
        return invalid;
    }
    entry.number = 1;
    var step50 = generic_type_result(c.generics, instance);
    var result: void* = step50;
    var step51 = sem_generic_ok(c, n);
    var step52 = step51 == false;
    var step53 = step52;
    var step54 = step53 == false;
    if step54 {
        var step55 = result == null;
        step53 = step55;
    }
    if step53 {
        return invalid;
    }
    var step56 = sem_state(c, c.source_bases, result);
    var step57 = sem_source_base(c, definition);
    step56.number = step57;
    var step58 = sem_is(result, "CoreStruct");
    if step58 {
        var step59 = sem_instance_name(c, definition, arguments);
        sem_type_header(c, result, step59);
        var step60 = sem_ok(c);
        var step61 = step60 == false;
        if step61 {
            return invalid;
        }
        var step62 = sem_get(result);
        var t: FoundationType* = &step62.type;
        var step63 = bits(void*, t);
        entry.value = step63;
        sem_push(&c.generated, result);
        sem_type_fields(c, result);
        entry.number = 0;
        return t;
    }
    var step64 = sem_type(c, result);
    var t: FoundationType* = step64;
    var step65 = bits(void*, t);
    entry.value = step65;
    entry.number = 0;
    return t;
}

fn sem_type(c: SemanticContext*, n: void*): FoundationType* {
    if sem_editor_capture(c, n, 2, null) {
        return sem_type_new(c, SI32(), 0, null);
    }
    c.type_depth = c.type_depth + 1;
    var step1 = sem_type_impl(c, n);
    var result: FoundationType* = step1;
    c.type_depth = c.type_depth - 1;
    return result;
}

fn sem_type_impl(c: SemanticContext*, n: void*): FoundationType* {
    var step1 = sem_type_new(c, SI32(), 0, null);
    var invalid: FoundationType* = step1;
    var step2 = c.type_depth > 128;
    if step2 {
        sem_fail(c, n, "Type construction nesting exceeds 128; check recursive type arguments");
        return invalid;
    }
    loop {
        var step3 = sem_is(n, "CoreTypeArgument");
        var step4 = step3;
        var step5 = step4 == false;
        if step5 {
            var step6 = sem_is(n, "CoreCallArgument");
            step4 = step6;
        }
        var step7 = step4 == false;
        if step7 {
            var step8 = sem_is(n, "CoreOperand");
            step4 = step8;
        }
        var step9 = step4;
        if step9 {
            var step10 = sem_child_count(n);
            var step11 = step10 == 1;
            step9 = step11;
        }
        var step12 = step9 == false;
        if step12 {
            break;
        }
        var step13 = sem_child(n, 0);
        n = step13;
    }
    var step14 = sem_is(n, "CoreType");
    var step15 = step14;
    var step16 = step15 == false;
    if step16 {
        var step17 = sem_is(n, "CoreCall");
        step15 = step17;
    }
    var step18 = step15;
    if step18 {
        var step19 = sem_member(n, "args");
        var step20 = step19 != null;
        step18 = step20;
    }
    if step18 {
        var step21 = sem_type_call(c, n);
        return step21;
    }
    var step22 = sem_member(n, "base");
    var base: void* = step22;
    var step23 = base != null;
    if step23 {
        var step24 = sem_type(c, base);
        var step25 = sem_type_copy(c, step24);
        var t: FoundationType* = step25;
        var step26 = sem_member(n, "count");
        var count: void* = step26;
        var step27 = count == null;
        if step27 {
            var step28 = sem_member(n, "index");
            count = step28;
        }
        var step29 = count != null;
        if step29 {
            var step30 = sem_constant_argument(c, count, null);
            var value: void* = step30;
            var step31 = value == null;
            if step31 {
                return t;
            }
            var step32 = sem_get(value);
            var v: FoundationNode* = step32;
            var length: u64 = v.bits;
            var step33 = semantic_mask(&v.type);
            var step34 = step33 / 2;
            var sign: u64 = step34;
            sign = sign + 1;
            var step35 = semantic_signed(&v.type);
            var step36 = step35;
            if step36 {
                var step37 = length & sign;
                var step38 = step37 != 0;
                step36 = step38;
            }
            if step36 {
                length = 0;
            }
            var step39 = length == 0;
            var step40 = step39;
            var step41 = step40 == false;
            if step41 {
                var step42 = length > 1048576;
                step40 = step42;
            }
            if step40 {
                sem_fail(c, n, "Array length must be between 1 and 1,048,576");
                return t;
            }
            var step43 = t.pointers == 0;
            var step44 = step43;
            if step44 {
                var step45 = t.scalar == SVoid();
                step44 = step45;
            }
            if step44 {
                sem_fail(c, n, "An array cannot have void elements");
                return t;
            }
            var step46 = sem_type_name(c, t);
            var step47 = sem_cat(c, step46, "[");
            var step48 = sem_decimal(c, length);
            var step49 = sem_cat(c, step47, step48);
            var step50 = sem_cat(c, step49, "]");
            var name: u8* = step50;
            var i: usize = 0;
            loop {
                var step51 = i < c.program.types.length;
                var step52 = step51 == false;
                if step52 {
                    break;
                }
                var step53 = sem_get(c.program.types.data[i]);
                var a: FoundationNode* = step53;
                var step54 = a.type.scalar == SArray();
                var step55 = step54;
                if step55 {
                    var step56 = semantic_type_equal(&a.element, t);
                    step55 = step56;
                }
                if step55 {
                    var step57 = convert(u64, a.length);
                    var step58 = step57 == length;
                    step55 = step58;
                }
                if step55 {
                    return &a.type;
                }
                i = i + 1;
            }
            var step59 = sem_create(c.program.root);
            var entity: void* = step59;
            var step60 = sem_attach(entity, KType());
            var a: FoundationNode* = step60;
            sem_set_name(a, name);
            sem_set_type(&a.element, t);
            var step61 = convert(usize, length);
            a.length = step61;
            var step62 = sem_type_new(c, SArray(), 0, entity);
            sem_set_type(&a.type, step62);
            sem_push(&c.program.types, entity);
            return &a.type;
        }
        var step63 = sem_member(n, "field");
        var step64 = step63 != null;
        if step64 {
            sem_fail(c, n, "Expected a type name, not field access");
            return t;
        }
        t.pointers = t.pointers + 1;
        var step65 = t.pointers > 16;
        if step65 {
            sem_fail(c, n, "Foundation pointer nesting limit is 16");
        }
        return t;
    }
    var step66 = sem_identifier(c, n);
    var text: u8* = step66;
    var step67 = generic_origin(c.generics, n);
    var step68 = step67 != null;
    if step68 {
        var step69 = sem_parent(n);
        var parent: void* = step69;
        loop {
            var step70 = parent != null;
            var step71 = step70 == false;
            if step71 {
                break;
            }
            var step72 = sem_is(parent, "CoreStruct");
            var step73 = step72;
            if step73 {
                var step74 = sem_get(parent);
                var step75 = step74 != null;
                step73 = step75;
            }
            if step73 {
                var step76 = sem_member(parent, "name");
                var step77 = sem_identifier(c, step76);
                var step78 = sem_equal(text, step77);
                step73 = step78;
            }
            if step73 {
                var step79 = sem_get(parent);
                return &step79.type;
            }
            var step80 = sem_parent(parent);
            parent = step80;
        }
    }
    var step81 = generic_lookup(c.generics, n, n);
    var bound: void* = step81;
    var step82 = bound != null;
    if step82 {
        var step83 = sem_get(bound);
        var step84 = step83.kind != KType();
        if step84 {
            sem_fail(c, n, "Expected a type, got a compile-time integer value");
        }
        var step85 = sem_get(bound);
        return &step85.type;
    }
    var step86 = sem_equal(text, "type");
    if step86 {
        sem_fail(c, n, "Type values currently require a template parameter or a type-constructor result");
        return invalid;
    }
    var step87 = sem_lookup_table(c.types, text);
    var found: void* = step87;
    var step88 = found == null;
    if step88 {
        var step89 = sem_cat(c, "Unknown type '", text);
        var step90 = sem_cat(c, step89, "'");
        sem_fail(c, n, step90);
        return invalid;
    }
    var step91 = sem_get(found);
    return &step91.type;
}

fn sem_type_header(c: SemanticContext*, n: void*, name: u8*): void {
    var step1 = sem_shape(c, n, "name");
    var step2 = step1 == false;
    var step3 = step2;
    var step4 = step3 == false;
    if step4 {
        var step5 = sem_shape(c, n, "fields");
        var step6 = step5 == false;
        step3 = step6;
    }
    if step3 {
        return;
    }
    var step7 = sem_node(c, n, 19);
    var t: FoundationNode* = step7;
    var step8 = name[0] == 0;
    if step8 {
        var step9 = sem_member(n, "name");
        var step10 = sem_identifier(c, step9);
        name = step10;
    }
    sem_set_name(t, name);
    var step11 = name[0] == 0;
    var step12 = step11;
    var step13 = step12 == false;
    if step13 {
        var step14 = sem_equal(name, "type");
        step12 = step14;
    }
    var step15 = step12 == false;
    if step15 {
        var step16 = sem_lookup_table(c.types, name);
        var step17 = step16 != null;
        step12 = step17;
    }
    var step18 = step12 == false;
    if step18 {
        var step19 = sem_lookup_table(c.type_functions, name);
        var step20 = step19 != null;
        step12 = step20;
    }
    if step12 {
        var step21 = sem_cat(c, "Missing or duplicate type '", name);
        var step22 = sem_cat(c, step21, "'");
        sem_fail(c, n, step22);
        return;
    }
    // Names use the shared hash index; layouts use the iterative work graph.
    // The compilation node/storage budgets apply instead of a 256-type cap.
    var step24 = sem_type_new(c, SStruct(), 0, n);
    sem_set_type(&t.type, step24);
    sem_put(c, c.types, name, n);
    sem_push(&c.program.types, n);
}

fn sem_type_fields(c: SemanticContext*, n: void*): void {
    var step1 = sem_state(c, c.fields_done, n);
    var state: SemanticEntry* = step1;
    var step2 = state.number != 0;
    if step2 {
        return;
    }
    state.number = 1;
    var step3 = sem_get(n);
    var t: FoundationNode* = step3;
    var step4 = sem_table(c);
    var names: SemanticTable* = step4;
    var step5 = sem_member(n, "fields");
    var step6 = sem_collect(c, step5, "CoreField");
    var fields: vector(void*)* = step6;
    var i: usize = 0;
    loop {
        var step7 = i < fields.length;
        var step8 = step7 == false;
        if step8 {
            break;
        }
        var field: void* = fields.data[i];
        var step9 = sem_shape(c, field, "name");
        var step10 = step9 == false;
        var step11 = step10;
        var step12 = step11 == false;
        if step12 {
            var step13 = sem_shape(c, field, "type");
            var step14 = step13 == false;
            step11 = step14;
        }
        if step11 {
            return;
        }
        var step15 = sem_node(c, field, 20);
        var f: FoundationNode* = step15;
        var step16 = sem_member(field, "name");
        var step17 = sem_identifier(c, step16);
        var name: u8* = step17;
        sem_set_name(f, name);
        var step18 = sem_member(field, "type");
        var step19 = sem_type(c, step18);
        sem_set_type(&f.type, step19);
        var step20 = name[0] == 0;
        var step21 = step20;
        var step22 = step21 == false;
        if step22 {
            var step23 = sem_put(c, names, name, field);
            var step24 = step23 == false;
            step21 = step24;
        }
        if step21 {
            var step25 = sem_cat(c, "Missing or duplicate field '", name);
            var step26 = sem_cat(c, step25, "'");
            sem_fail(c, field, step26);
        }
        var step27 = f.type.pointers == 0;
        var step28 = step27;
        if step28 {
            var step29 = f.type.scalar == SVoid();
            step28 = step29;
        }
        if step28 {
            sem_fail(c, field, "A field cannot have void type");
        }
        sem_push(&t.items, field);
        i = i + 1;
    }
}

fn sem_round(size: usize, alignment: usize): usize {
    var step1 = size + alignment;
    var step2 = step1 - 1;
    var step3 = step2 / alignment;
    var step4 = step3 * alignment;
    return step4;
}

fn sem_add_local(c: SemanticContext*, n: void*): void {
    var step1 = sem_get(n);
    var local: FoundationNode* = step1;
    var step2 = sem_get(c.current);
    var function: FoundationNode* = step2;
    var step3 = semantic_aggregate(&local.type);
    if step3 {
        sem_layout(c, local.type.record);
    }
    var step4 = semantic_alignment(&local.type);
    var alignment: usize = step4;
    local.index = function.locals.length;
    var step5 = sem_round(function.frame_size, alignment);
    local.byte_offset = step5;
    var step6 = semantic_size(&local.type);
    var step7 = local.byte_offset + step6;
    function.frame_size = step7;
    var step8 = function.frame_size > 4194304;
    if step8 {
        sem_fail(c, n, "Foundation local storage exceeds 4 MiB");
    }
    sem_push(&function.locals, n);
}

fn sem_lookup(c: SemanticContext*, n: void*): void* {
    if sem_editor_capture(c, n, 1, null) {
        return null;
    }
    var step1 = sem_identifier(c, n);
    var name: u8* = step1;
    var scope: SemanticScope* = c.scope;
    loop {
        var step2 = scope != null;
        var step3 = step2 == false;
        if step3 {
            break;
        }
        var step4 = sem_lookup_table(scope.names, name);
        var found: void* = step4;
        var step5 = found != null;
        if step5 {
            var step6 = sem_declaration_type(c, found);
            if step6 {
                return found;
            }
            return null;
        }
        scope = scope.parent;
    }
    var step7 = sem_lookup_table(c.globals, name);
    var found: void* = step7;
    var step8 = found != null;
    if step8 {
        var step9 = sem_declaration_type(c, found);
        if step9 {
            return found;
        }
        return null;
    }
    var step10 = sem_cat(c, "Unknown local '", name);
    var step11 = sem_cat(c, step10, "'");
    sem_fail(c, n, step11);
    return null;
}

fn sem_declaration_type(c: SemanticContext*, n: void*): bool {
    var step1 = sem_get(n);
    var value: FoundationNode* = step1;
    var step2 = sem_state(c, c.declaration_state, n);
    var state: SemanticEntry* = step2;
    var step3 = value.kind != KDeclare();
    var step4 = step3;
    var step5 = step4 == false;
    if step5 {
        var step6 = state.number == 2;
        step4 = step6;
    }
    if step4 {
        return true;
    }
    var step7 = state.number == 1;
    if step7 {
        var chain: u8* = "";
        var i: usize = 0;
        loop {
            var step8 = i < c.inferring.length;
            var step9 = step8;
            if step9 {
                var step10 = c.inferring.data[i] != n;
                step9 = step10;
            }
            var step11 = step9 == false;
            if step11 {
                break;
            }
            i = i + 1;
        }
        loop {
            var step12 = i < c.inferring.length;
            var step13 = step12 == false;
            if step13 {
                break;
            }
            var step14 = sem_get(c.inferring.data[i]);
            var step15 = sem_name(step14);
            var step16 = sem_cat(c, step15, " -> ");
            var step17 = sem_cat(c, chain, step16);
            chain = step17;
            i = i + 1;
        }
        var step18 = sem_name(value);
        var step19 = sem_cat(c, "Cannot infer the type of '", step18);
        var step20 = sem_cat(c, step19, "': initializer dependency cycle ");
        var step21 = sem_name(value);
        var step22 = sem_cat(c, chain, step21);
        var step23 = sem_cat(c, step22, "; add an explicit type annotation");
        var step24 = sem_cat(c, step20, step23);
        sem_fail(c, n, step24);
        return false;
    }
    var step25 = sem_member(n, "type");
    var annotation: void* = step25;
    var step26 = annotation != null;
    if step26 {
        var step27 = sem_type(c, annotation);
        sem_set_type(&value.type, step27);
    } else {
        var step28 = sem_member(n, "value");
        var initial: void* = step28;
        var step29 = initial == null;
        if step29 {
            var step30 = sem_name(value);
            var step31 = sem_cat(c, "Variable '", step30);
            var step32 = sem_cat(c, step31, "' requires a type annotation or an initializer");
            sem_fail(c, n, step32);
            return false;
        }
        var step33 = c.inferring.length >= 128;
        if step33 {
            sem_fail(c, n, "Foundation inferred-type dependency limit is 128");
            return false;
        }
        state.number = 1;
        sem_push(&c.inferring, n);
        var step34 = sem_expression(c, initial, null);
        value.value = step34;
        c.inferring.length = c.inferring.length - 1;
        var step35 = sem_ok(c);
        var step36 = step35 == false;
        var step37 = step36;
        var step38 = step37 == false;
        if step38 {
            var step39 = value.value == null;
            step37 = step39;
        }
        if step37 {
            return false;
        }
        var step40 = sem_get(value.value);
        sem_set_type(&value.type, &step40.type);
        value.type.pointer_bytes = c.program.pointer_bytes;
    }
    var step41 = value.type.pointers == 0;
    var step42 = step41;
    if step42 {
        var step43 = value.type.scalar == SVoid();
        step42 = step43;
    }
    if step42 {
        sem_fail(c, n, "A variable cannot have void type");
    }
    var step44 = sem_ok(c);
    var step45 = step44 == false;
    if step45 {
        return false;
    }
    state.number = 2;
    return true;
}
