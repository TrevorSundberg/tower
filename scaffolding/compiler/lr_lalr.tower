import tower;
import lr_analysis;
import lr_states;
import .library.vector;
import .library.work_vector;
import .library.work_vector_types;
import lr_types;
import .library.work_buffer;
import .library.work_buffer_types;
import .library.work_arena_api;
import .library.work_arena_types;

// Build LALR lookahead dependencies from LR(1) closures of LR(0) kernels.
// Grammar order determines indices, never conflict priority or a shift bias.
fn lr_lalr_index(value: LRStates*, state_index: usize, item: LRItem*): usize {
    var state = value.states.data[state_index];
    var key: LRItem = { rule: item.rule, position: item.position, first: 0, last: 0 };
    var low: usize = 0;
    var high = state.items.values.length;
    loop {
        if low == high {
            break;
        }
        var middle = high -low;
        middle = middle / 2;
        middle = middle + low;
        if lr_item_less(&state.items.values.data[middle], &key) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    var missing = low == state.items.values.length;
    if missing {
        return lr_none();
    }
    missing = lr_item_less(&key, &state.items.values.data[low]);
    if missing {
        return lr_none();
    }
    var result = state.base + low;
    return result;
}

// Transient publication records for the existing derived lookahead graph.
// A worker owns its ordered vector; serial construction writes the same link
// directly. Neither representation adds grammar or Foundation semantics.
struct LRPropagationLink {
    source: usize;
    destination: usize;
    first: u32;
    last: u32;
}

struct LRLinkOutput {
    graph: LRPropagation*;
    links: work_vector(LRPropagationLink)*;
}

fn lr_lalr_apply_result(graph: LRPropagation*, link: LRPropagationLink*): WorkBudgetError {
    if link.first == LRTokenPropagation {
        return lr_propagation_edge_result(graph, link.source, link.destination);
    }
    return lr_propagation_seed_result(graph, link.destination, link.first, link.last);
}

fn lr_lalr_link_result(value: LRStates*, output: LRLinkOutput*, source: usize, state: usize, item: LRItem*): WorkBudgetError {
    var destination = lr_lalr_index(value, state, item);
    if destination == lr_none() {
        return WorkBudgetError.Invalid;
    }
    var link: LRPropagationLink = { source: source, destination: destination, first: item.first, last: item.last };
    if output.links != null {
        return lr_push_result(output.links, link, value.analysis.budget);
    }
    return lr_lalr_apply_result(output.graph, &link);
}

fn lr_lalr_destination(value: LRStates*, state: LRState*, symbol: usize): usize {
    var low: usize = 0;
    var high = state.edges.length;
    loop {
        if low == high {
            break;
        }
        var middle = high -low;
        middle = middle / 2;
        middle = middle + low;
        if lr_symbol_less(value.analysis, state.edges.data[middle].symbol, symbol) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    var missing = low == state.edges.length;
    if missing {
        return lr_none();
    }
    missing = lr_symbol_less(value.analysis, symbol, state.edges.data[low].symbol);
    if missing {
        return lr_none();
    }
    return state.edges.data[low].state;
}

// Closure and goto sets depend on a dotted production, not its LR state.
// Memoize them only while building this table; shared grammar nodes remain the
// authority. This avoids repeating wide operator closures in every state.
struct LRKernelClosure {
    storage: WorkBuffer;
    records: WorkArena;
    state: LRState;
    next: work_vector(LRItems*);
}

fn lr_kernel_closure_destroy(value: LRKernelClosure*): void {
    if value == null {
        return;
    }
    foreach(var & next_item in &value.next) {
        lr_items_destroy(*next_item);
    }
    work_vector_dispose(&value.next);
    lr_state_vectors_dispose(&value.state);
    lr_items_destroy(value.state.items);
    work_arena_dispose(&value.records);
    var storage = value.storage;
    work_buffer_dispose(&storage);
}

// Scatter the sorted closure into its outgoing kernels once. Rescanning the
// entire closure for every symbol makes wide expression grammars quadratic.
// Range containment matches lr_items_shift, including overlapping terminals.
// Advancing a dotted position preserves item order and cannot create duplicates.
fn lr_kernel_shift_result(analysis: LRAnalysis*, cached: LRKernelClosure*): WorkBudgetError {
    var closure = &cached.state;
    foreach (var &item in &closure.items.values) {
        var rule = &analysis.rules[item.rule];
        if item.position >= rule.count { continue; }
        var symbol_index = rule.begin + item.position;
        var symbol = &analysis.symbols[symbol_index];
        var terminal = symbol.nonterminal == lr_none();
        var low: usize = 0;
        var high = closure.symbols.length;
        while low < high {
            var middle = low + (high - low) / 2;
            var candidate = &analysis.symbols[closure.symbols.data[middle]];
            var before = terminal ? candidate.nonterminal != lr_none() || candidate.first < symbol.first
                : lr_symbol_less(analysis, closure.symbols.data[middle], symbol_index);
            if before { low = middle + 1; } else { high = middle; }
        }
        var advanced = *item;
        ++advanced.position;
        for (var i = low; i < closure.symbols.length; ++i) {
            var candidate = &analysis.symbols[closure.symbols.data[i]];
            if terminal {
                if candidate.nonterminal != lr_none() || candidate.first > symbol.last { break; }
                if candidate.last > symbol.last { continue; }
            } else {
                if candidate.nonterminal != symbol.nonterminal { break; }
            }
            // These immutable kernels are consumed by propagation, never closed
            // again. They need neither sorted insertion nor a pending work copy.
            var next = cached.next.data[i];
            var error = lr_push_arena_result(&next.values, advanced, next.memory, null);
            if error != WorkBudgetError.None { return error; }
        }
    }
    return WorkBudgetError.None;
}

fn lr_kernel_closure_result(analysis: LRAnalysis*, kernel: LRItem*, error: WorkBudgetError*): LRKernelClosure* {
    *error = WorkBudgetError.Invalid;
    if analysis == null || kernel == null || kernel.rule >= analysis.rule_count
        || kernel.position > analysis.rules[kernel.rule].count { return null; }
    var storage: WorkBuffer = default;
    *error = work_buffer_resize(&storage, analysis.budget, sizeof(LRKernelClosure), 0);
    if *error != WorkBudgetError.None { return null; }
    var cached = bits(LRKernelClosure*, storage.data);
    *cached = default;
    cached.storage = storage;
    var closure = &cached.state;
    if !work_arena_init(&cached.records, analysis.budget, sizeof(WorkArenaChunk) + WorkBufferInitialElements * sizeof(LRState)) {
        *error = WorkBudgetError.Invalid; lr_kernel_closure_destroy(cached); return null;
    }
    lr_state_initial(closure, &cached.records);
    closure.items = lr_items_create_result(analysis.budget, error);
    var missing = closure.items == null;
    if missing {
        lr_kernel_closure_destroy(cached);
        return null;
    }
    var seed = *kernel;
    seed.first = LRTokenPropagation;
    seed.last = LRTokenPropagation;
    var ok = lr_items_insert(closure.items, &seed);
    ok &&= lr_items_close(analysis, closure.items, true);
    *error = ok ? WorkBudgetError.None : lr_items_error(closure.items);
    var index: usize = 0;
    loop {
        if !ok {
            break;
        }
        var done = index == closure.items.values.length;
        if done {
            break;
        }
        var item = &closure.items.values.data[index];
        var rule = &analysis.rules[item.rule];
        if item.position < rule.count {
            var symbol = rule.begin + item.position;
            *error = lr_state_symbol_result(analysis, closure, symbol);
            ok = *error == WorkBudgetError.None;
        }
        index++;
    }
    index = 0;
    loop {
        if !ok {
            break;
        }
        var done = index == closure.symbols.length;
        if done {
            break;
        }
        var next = lr_items_create_result(analysis.budget, error);
        missing = next == null;
        if missing {
            ok = false;
            break;
        }
        *error = lr_push_result(&cached.next, next, analysis.budget);
        ok = *error == WorkBudgetError.None;
        if !ok {
            lr_items_destroy(next);
            break;
        }
        index++;
    }
    if ok { *error = lr_kernel_shift_result(analysis, cached); ok = *error == WorkBudgetError.None; }
    if ok {
        return cached;
    }
    lr_kernel_closure_destroy(cached);
    return null;
}

// All closures and state bases are immutable before a worker enters here.
// Cache construction is deliberately outside this helper.
fn lr_lalr_kernel_cached_result(value: LRStates*, output: LRLinkOutput*, state_index: usize,
source: usize, cached: LRKernelClosure*): WorkBudgetError {
    var closure = &cached.state;
    var state = value.states.data[state_index];
    var index: usize = 0;
    for(; index != closure.items.values.length; index++) {
        var item = &closure.items.values.data[index];
        if value.analysis.rules[item.rule].count == 0 {
            var error = lr_lalr_link_result(value, output, source, state_index, item);
            if error != WorkBudgetError.None { return error; }
        }
    }
    index = 0;
    loop {
        var done = index == closure.symbols.length;
        if done {
            return WorkBudgetError.None;
        }
        var symbol = closure.symbols.data[index];
        var destination = lr_lalr_destination(value, state, symbol);
        var missing = destination == lr_none();
        if missing {
            return WorkBudgetError.Invalid;
        }
        var next = cached.next.data[index];
        var position: usize = 0;
        loop {
            done = position == next.values.length;
            if done {
                break;
            }
            var item = &next.values.data[position];
            if lr_kernel(value.analysis, item) {
                var error = lr_lalr_link_result(value, output, source, destination, item);
                if error != WorkBudgetError.None { return error; }
            }
            position++;
        }
        index++;
    }
}

fn lr_lalr_kernel_result(value: LRStates*, graph: LRPropagation*, state_index: usize, source: usize,
kernel: LRItem*, cache: LRKernelClosure**, count: usize): WorkBudgetError {
    var key = value.analysis.rules[kernel.rule].begin + kernel.rule + kernel.position;
    if key >= count { return WorkBudgetError.Invalid; }
    if cache[key] == null {
        var error = WorkBudgetError.None;
        cache[key] = lr_kernel_closure_result(value.analysis, kernel, &error);
        if cache[key] == null { return error; }
    }
    var output: LRLinkOutput = default;
    output.graph = graph;
    return lr_lalr_kernel_cached_result(value, &output, state_index, source, cache[key]);
}

fn lr_lalr_state_links_result(value: LRStates*, cache: LRKernelClosure**, count: usize, state_index: usize,
links: work_vector(LRPropagationLink)*): WorkBudgetError {
    var state = value.states.data[state_index];
    var output: LRLinkOutput = default;
    output.links = links;
    for(var i: usize = 0; i < state.items.values.length; i++) {
        var item = &state.items.values.data[i];
        if !lr_kernel(value.analysis, item) {
            continue;
        }
        var key = value.analysis.rules[item.rule].begin + item.rule + item.position;
        // Missing immutable input is a failed job, never lazy cache mutation.
        if key >= count || cache[key] == null { return WorkBudgetError.Invalid; }
        var error = lr_lalr_kernel_cached_result(value, &output, state_index, state.base + i, cache[key]);
        if error != WorkBudgetError.None { return error; }
    }
    return WorkBudgetError.None;
}

// The same ordered algorithm serves serial construction and private worker output.
fn lr_lalr_state_actions_result(value: LRStates*, graph: LRPropagation*, state_index: usize,
actions: work_vector(LRAction)*): WorkBudgetError {
    return lr_lalr_state_actions_arena_result(value, graph, state_index, actions, null);
}

fn lr_lalr_state_actions_arena_result(value: LRStates*, graph: LRPropagation*, state_index: usize,
actions: work_vector(LRAction)*, scratch: WorkArena*): WorkBudgetError {
    var state = value.states.data[state_index];
    // A worker borrows only its private arena until the coordinator joins and
    // transfers its chunks. Standalone output keeps its independent owner.
    var local = actions == &state.actions;
    var memory = local ? state.memory : scratch;
    var owned = local ? &state.actions_owned : null;
    actions.length = 0;
    foreach(var & edge in &state.edges) {
        var symbol = &value.analysis.symbols[edge.symbol];
        if symbol.nonterminal == lr_none() {
            var action: LRAction = { first: symbol.first, last: symbol.last, rule: lr_none(), state: edge.state };
            var error = memory != null ? lr_push_arena_result(actions, action, memory, owned)
                : lr_push_result(actions, action, value.analysis.budget);
            if error != WorkBudgetError.None { return error; }
        }
    }
    for(var index: usize = 0; index < state.items.values.length; index++) {
        var item = &state.items.values.data[index];
        if item.position == value.analysis.rules[item.rule].count {
            var ranges = &graph.nodes[state.base + index].ranges;
            foreach(var & range in ranges) {
                var action: LRAction = { first: range.first, last: range.last, rule: item.rule, state: lr_none() };
                var error = memory != null ? lr_push_arena_result(actions, action, memory, owned)
                    : lr_push_result(actions, action, value.analysis.budget);
                if error != WorkBudgetError.None { return error; }
            }
        }
    }
    return WorkBudgetError.None;
}

struct LRActionGrowth { state: LRState*; row: work_vector(LRAction); }

// A serial rebuild can follow parallel publication with a different lookahead.
// Reserve only rows that must grow, before overwriting any published action.
fn lr_lalr_prepare_action_growth(value: LRStates*, graph: LRPropagation*): WorkBudgetError {
    var extra: WorkArena = default;
    if !work_arena_init(&extra, value.analysis.budget, value.action_storage.chunk_bytes) { return WorkBudgetError.Invalid; }
    defer work_arena_dispose(&extra);
    var changes: work_vector(LRActionGrowth) = default;
    defer work_vector_dispose(&changes);
    foreach(var state in &value.states) {
        var needed: usize = 0;
        foreach(var &edge in &state.edges) {
            if value.analysis.symbols[edge.symbol].nonterminal == lr_none() { needed++; }
        }
        for(var i: usize = 0; i < state.items.values.length; i++) {
            var item = &state.items.values.data[i];
            if item.position != value.analysis.rules[item.rule].count { continue; }
            var count = graph.nodes[state.base + i].ranges.length;
            if count > ~convert(usize, 0) - needed { return WorkBudgetError.Invalid; }
            needed += count;
        }
        if needed <= state.actions.capacity { continue; }
        var change: LRActionGrowth = {state: state, ..default};
        var error = lr_reserve_arena_result(&change.row, needed, &extra, null);
        if error == WorkBudgetError.None { error = lr_push_result(&changes, change, value.analysis.budget); }
        if error != WorkBudgetError.None { return error; }
    }
    if !work_arena_append(&value.action_storage, &extra) { return WorkBudgetError.Invalid; }
    foreach(var &change in &changes) {
        if change.state.actions_owned { work_vector_dispose(&change.state.actions); }
        change.state.actions = change.row;
        change.state.actions_owned = false;
    }
    return WorkBudgetError.None;
}

fn lr_lalr_actions_result(value: LRStates*, graph: LRPropagation*): WorkBudgetError {
    if value.action_storage.chunk_bytes != 0 {
        var error = lr_lalr_prepare_action_growth(value, graph);
        if error != WorkBudgetError.None { return error; }
    }
    for(var i: usize = 0; i < value.states.length; i++) {
        var error = lr_lalr_state_actions_result(value, graph, i, &value.states.data[i].actions);
        if error != WorkBudgetError.None { return error; }
    }
    return WorkBudgetError.None;
}

fn lr_lalr_seed_result(value: LRStates*, graph: LRPropagation*, constructs: bool): WorkBudgetError {
    var seed: LRItem = default;
    var start = lr_lalr_index(value, 0, &seed);
    if start == lr_none() {
        return WorkBudgetError.Invalid;
    }
    var error = lr_propagation_seed_result(graph, start, LRTokenEnd, LRTokenEnd);
    if error != WorkBudgetError.None { return error; }
    if constructs {
        var owner = value.analysis.rules[0].owner;
        var first = &value.analysis.nonterminals[owner].first;
        foreach(var & range in first) {
            error = lr_propagation_seed_result(graph, start, range.first, range.last);
            if error != WorkBudgetError.None { return error; }
        }
    }
    return WorkBudgetError.None;
}

fn lr_states_propagation_begin_result(value: LRStates*, constructs: bool, error: WorkBudgetError*): LRPropagation* {
    *error = WorkBudgetError.Invalid;
    if value == null || value.analysis == null || value.states.length == 0 || value.analysis.rule_count == 0 { return null; }
    var count: usize = 0;
    foreach(var state in &value.states) {
        state.base = count;
        if state.items.values.length > ~convert(usize, 0) - count { return null; }
        count += state.items.values.length;
    }
    var graph = lr_propagation_create_budget_result(count, value.analysis.budget, error);
    if graph == null {
        return null;
    }
    *error = lr_lalr_seed_result(value, graph, constructs);
    if *error != WorkBudgetError.None {
        lr_propagation_destroy(graph);
        return null;
    }
    return graph;
}

fn lr_states_propagation_cached(value: LRStates*, constructs: bool, cache: LRKernelClosure**): LRPropagation* {
    var error = WorkBudgetError.None;
    var count = lr_lalr_cache_count(value, &error);
    if error != WorkBudgetError.None { return null; }
    return lr_states_propagation_cached_result(value, constructs, cache, count, &error);
}

fn lr_states_propagation_cached_result(value: LRStates*, constructs: bool, cache: LRKernelClosure**,
count: usize, error: WorkBudgetError*): LRPropagation* {
    if cache == null { *error = WorkBudgetError.Invalid; return null; }
    var graph = lr_states_propagation_begin_result(value, constructs, error);
    if graph == null {
        return null;
    }
    var ok = true;
    var index: usize = 0;
    var state_index: usize = 0;
    loop {
        if !ok {
            break;
        }
        var done = state_index == value.states.length;
        if done {
            break;
        }
        var state = value.states.data[state_index];
        index = 0;
        loop {
            if !ok {
                break;
            }
            done = index == state.items.values.length;
            if done {
                break;
            }
            var item = &state.items.values.data[index];
            if lr_kernel(value.analysis, item) {
                var source = state.base + index;
                *error = lr_lalr_kernel_result(value, graph, state_index, source, item, cache, count);
                ok = *error == WorkBudgetError.None;
            }
            index++;
        }
        state_index++;
    }
    if !ok {
        lr_propagation_destroy(graph);
        return null;
    }
    return graph;
}

export fn lr_states_lalr_cached(value: LRStates*, constructs: bool, cache: LRKernelClosure**): bool {
    var error = WorkBudgetError.None;
    var count = lr_lalr_cache_count(value, &error);
    return error == WorkBudgetError.None && lr_states_lalr_cached_result(value, constructs, cache, count) == WorkBudgetError.None;
}

fn lr_states_lalr_cached_result(value: LRStates*, constructs: bool, cache: LRKernelClosure**, count: usize): WorkBudgetError {
    var error = WorkBudgetError.None;
    var graph = lr_states_propagation_cached_result(value, constructs, cache, count, &error);
    if graph == null { return error; }
    defer lr_propagation_destroy(graph);
    error = lr_propagation_solve_result(graph);
    return error != WorkBudgetError.None ? error : lr_lalr_actions_result(value, graph);
}

fn lr_lalr_cache_count(value: LRStates*, error: WorkBudgetError*): usize {
    *error = WorkBudgetError.Invalid;
    if value == null || value.analysis == null || value.analysis.failed || value.states.length == 0
        || value.analysis.rule_count == 0
        || value.analysis.symbol_count > ~convert(usize, 0) - value.analysis.rule_count { return 0; }
    var count = value.analysis.symbol_count + value.analysis.rule_count;
    if count > ~convert(usize, 0) / sizeof(LRKernelClosure*) { return 0; }
    *error = WorkBudgetError.None;
    return count;
}

export fn lr_states_lalr(value: LRStates*, constructs: bool): bool {
    return lr_states_lalr_result(value, constructs) == WorkBudgetError.None;
}

export fn lr_states_lalr_result(value: LRStates*, constructs: bool): WorkBudgetError {
    return lr_states_lalr_owned_result(value, constructs, value == null ? null : value.analysis.budget);
}

fn lr_lalr_item_graph_safe(value: LRStates*): bool {
    if !value.analysis.suffix_ready { return false; }
    // The established range parser shifts through the symbols present in each
    // individual kernel closure. With overlapping labels, merging those
    // contexts first can add a contained-label path. Keep that exact algorithm
    // for range states; disjoint labels have a unique, context-independent goto.
    foreach(var state in &value.states) {
        var present = false;
        var last: u32 = 0;
        foreach(var &edge in &state.edges) {
            var symbol = &value.analysis.symbols[edge.symbol];
            if symbol.nonterminal != lr_none() { continue; }
            if present && symbol.first <= last { return false; }
            present = true;
            last = symbol.last;
        }
    }
    return true;
}

// LR(0) already contains each dotted production once per state. Build the same
// lookahead fixed point through these items instead of reconstructing an LR(1)
// closure for every kernel and flattening its transitive links. Reachability is
// separate from lookahead: every kernel is a source, but an empty, nonnullable
// FIRST suffix must not activate otherwise unreachable dot-zero productions.
var LRPredictionExpanded: u8 = 2;
fn lr_states_propagation_items_result(value: LRStates*, constructs: bool, budget: WorkBudget*, error: WorkBudgetError*): LRPropagation* {
    var count = lr_lalr_cache_count(value, error);
    if *error != WorkBudgetError.None { return null; }
    var graph = lr_states_propagation_begin_result(value, constructs, error);
    if graph == null { return null; }
    var unpublished = graph;
    defer lr_propagation_destroy(unpublished);
    var maximum: usize = 0;
    foreach(var state in &value.states) {
        if state.items.values.length > maximum { maximum = state.items.values.length; }
    }
    var stride = sizeof(usize) + sizeof(u8);
    var rules = value.analysis.rule_count;
    if rules > ~convert(usize, 0) / sizeof(usize) { *error = WorkBudgetError.Invalid; return null; }
    var index_bytes = rules * sizeof(usize);
    if maximum > (~convert(usize, 0) - index_bytes) / stride { *error = WorkBudgetError.Invalid; return null; }
    var scratch: WorkBuffer = default;
    defer work_buffer_dispose(&scratch);
    *error = work_buffer_resize(&scratch, budget, maximum * stride + index_bytes, 0);
    if *error != WorkBudgetError.None { return null; }
    var pending = bits(usize*, scratch.data);
    var predictions = pending + maximum;
    var active = bits(u8*, predictions + rules);
    for(var state_index: usize = 0; state_index < value.states.length; state_index++) {
        var state = value.states.data[state_index];
        fill(active, 0, state.items.values.length * sizeof(u8));
        // Each frozen LR(0) state contains at most one dot-zero item for a
        // production. Rebuild this private derived index for the current state;
        // prediction visits need no repeated binary search or retained pointers.
        fill(predictions, ~convert(u8, 0), index_bytes);
        var queued: usize = 0;
        for(var i: usize = 0; i < state.items.values.length; i++) {
            var item = &state.items.values.data[i];
            if item.position == 0 { predictions[item.rule] = i; }
            if lr_kernel(value.analysis, &state.items.values.data[i]) { active[i] = 1; pending[queued++] = i; }
        }
        for(var at: usize = 0; at < queued; at++) {
            var index = pending[at];
            var item = state.items.values.data[index];
            var source = state.base + index;
            var rule = &value.analysis.rules[item.rule];
            if item.position >= rule.count { continue; }
            var symbol_index = rule.begin + item.position;
            var symbol = &value.analysis.symbols[symbol_index];
            var terminal = symbol.nonterminal == lr_none();
            var low: usize = 0;
            var high = state.edges.length;
            while low < high {
                var middle = low + (high - low) / 2;
                var candidate = &value.analysis.symbols[state.edges.data[middle].symbol];
                var before = terminal ? candidate.nonterminal != lr_none() || candidate.first < symbol.first
                    : lr_symbol_less(value.analysis, state.edges.data[middle].symbol, symbol_index);
                if before { low = middle + 1; } else { high = middle; }
            }
            var advanced = item; advanced.position++;
            for(var i = low; i < state.edges.length; i++) {
                var edge = &state.edges.data[i];
                var candidate = &value.analysis.symbols[edge.symbol];
                if terminal {
                    if candidate.nonterminal != lr_none() || candidate.first > symbol.last { break; }
                    if candidate.last > symbol.last { continue; }
                } else { if candidate.nonterminal != symbol.nonterminal { break; } }
                var destination = lr_lalr_index(value, edge.state, &advanced);
                *error = lr_propagation_edge_result(graph, source, destination);
                if *error != WorkBudgetError.None { return null; }
            }
            if terminal { continue; }
            var suffix: LRSuffix = default;
            suffix.nullable = true;
            if item.position + 1 < rule.count {
                suffix = value.analysis.suffix.entries[value.analysis.suffix.bases[item.rule] + item.position];
            }
            if suffix.error != WorkBudgetError.None { *error = suffix.error; return null; }
            if suffix.count == 0 && !suffix.nullable { continue; }
            var productions = &value.analysis.nonterminals[symbol.nonterminal].productions;
            // All dot-zero alternatives of this nonterminal receive the same
            // closure inputs. Route them through one existing item, then fan
            // out once per state, rather than repeating every suffix seed and
            // nullable edge for every alternative. The initial start item has
            // an independent EOF/construct seed, so keep that group separate.
            var grouped = productions.length > 1 && !(state_index == 0 && productions.data[0] == 0);
            if grouped {
                var first = predictions[productions.data[0]];
                if first == lr_none() { *error = WorkBudgetError.Invalid; return null; }
                if (active[first] & LRPredictionExpanded) == 0 {
                    foreach(var production in productions) {
                        var local = predictions[production];
                        if local == lr_none() { *error = WorkBudgetError.Invalid; return null; }
                        if local != first {
                            *error = lr_propagation_edge_result(graph, state.base + first, state.base + local);
                            if *error != WorkBudgetError.None { return null; }
                        }
                        if active[local] == 0 { active[local] = 1; pending[queued++] = local; }
                    }
                    active[first] |= LRPredictionExpanded;
                }
            }
            var targets = grouped ? 1 : productions.length;
            for(var target: usize = 0; target < targets; target++) {
                var production = productions.data[target];
                var local = predictions[production];
                if local == lr_none() { *error = WorkBudgetError.Invalid; return null; }
                var destination = state.base + local;
                if suffix.nullable {
                    *error = lr_propagation_edge_result(graph, source, destination);
                    if *error != WorkBudgetError.None { return null; }
                }
                for(var i: usize = 0; i < suffix.count; i++) {
                    var range = &value.analysis.suffix.ranges.data[suffix.begin + i];
                    *error = range.first == LRTokenPropagation ? lr_propagation_edge_result(graph, source, destination)
                        : lr_propagation_seed_result(graph, destination, range.first, range.last);
                    if *error != WorkBudgetError.None { return null; }
                }
                if active[local] == 0 { active[local] = 1; pending[queued++] = local; }
            }
        }
    }
    unpublished = null;
    return graph;
}

fn lr_states_lalr_owned_result(value: LRStates*, constructs: bool, budget: WorkBudget*): WorkBudgetError {
    defer { if value != null && value.analysis != null { lr_analysis_scratch_dispose(value.analysis); } }
    var error = WorkBudgetError.None;
    var count = lr_lalr_cache_count(value, &error);
    if error != WorkBudgetError.None { return error; }
    // Preserve standalone incomplete analysis and context-dependent range goto.
    if !lr_lalr_item_graph_safe(value) {
        var storage: WorkBuffer = default;
        error = work_buffer_resize(&storage, budget, count * sizeof(LRKernelClosure*), 0);
        if error != WorkBudgetError.None { return error; }
        defer work_buffer_dispose(&storage);
        var cache = bits(LRKernelClosure**, storage.data);
        fill(cache, 0, count * sizeof(LRKernelClosure*));
        error = lr_states_lalr_cached_result(value, constructs, cache, count);
        for(var i: usize = 0; i < count; i++) { lr_kernel_closure_destroy(cache[i]); }
        return error;
    }
    var graph = lr_states_propagation_items_result(value, constructs, budget, &error);
    if graph == null { return error; }
    defer lr_propagation_destroy(graph);
    error = lr_propagation_solve_components_result(graph, budget);
    return error != WorkBudgetError.None ? error : lr_lalr_actions_result(value, graph);
}

export fn lr_states_action_count(value: LRStates*, index: usize): usize {
    return value.states.data[index].actions.length;
}

export fn lr_states_actions(value: LRStates*, index: usize): LRAction* {
    return value.states.data[index].actions.data;
}
