import tower;

// Shared SyntaxNode tags; the native view retains this exact ABI during migration.
var SyntaxDocument: u32 = 0;
var SyntaxRule: u32 = 1;
var SyntaxToken: u32 = 2;
var SyntaxSkip: u32 = 3;
var SyntaxAlternative: u32 = 4;
var SyntaxTerm: u32 = 5;
var SyntaxTemplate: u32 = 6;
var SyntaxImport: u32 = 7;
