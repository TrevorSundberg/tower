import tower;

// Transitional parser token sentinels shared by table construction and runtime.
// These are table indexes, not Foundation program instructions.
const LRTokenEnd: u32 = 4294967294;
const LRTokenPropagation: u32 = 4294967293;

// Shared disposable LR index records, never a separate semantic graph.
struct SymbolRange {
    first: u32;
    last: u32;
}

// Frames borrow forest handles; the entity forest owns the syntax nodes.
struct LRFrame {
    state: usize;
    first: usize;
    last: usize;
    start: usize;
    length: usize;
}

struct LRStep {
    rule: usize;
    next: usize;
    pop: usize;
    start: usize;
    end: usize;
    id: u32;
    kind: u32;
}

struct LRWork {
    actions: usize;
    shifts: usize;
    reductions: usize;
    popped: usize;
}

struct LRProbeFrame {
    state: usize;
    consumed: bool;
}

struct LRProbeBudget {
    remaining: usize;
    complete: bool;
}

struct LRProduction {
    owner: usize;
    begin: usize;
    count: usize;
    precedence: u32;
    associativity: u32;
}

struct LRSymbol {
    nonterminal: usize;
    first: u32;
    last: u32;
}

struct LRItem {
    rule: usize;
    position: usize;
    first: u32;
    last: u32;
}

struct LRTransition {
    symbol: usize;
    state: usize;
}

struct LRAction {
    first: u32;
    last: u32;
    rule: usize;
    state: usize;
}

struct LRGoto {
    nonterminal: usize;
    state: usize;
}

struct LRConflict {
    state: usize;
    left: LRAction;
    right: LRAction;
}
