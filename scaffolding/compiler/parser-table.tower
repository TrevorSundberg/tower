import tower;
import 'parser-table-types';
import 'grammar-types';
import 'lr-api';
import 'lr-types';
import 'frontend-diagnostic-types';
import '../library/vector';
import 'parser-markers';

extern fn entity_child_count(root: void*): usize;

extern fn tower_memory_allocate(size: usize): void*;

extern fn tower_memory_free(memory: void*): void;

extern fn abort(): void;

extern fn parser_rule_get_type(): void*;

extern fn parser_reference_get_type(): void*;

extern fn parser_string_get_type(): void*;

extern fn parser_range_get_type(): void*;

extern fn parser_match_get_type(): void*;

fn parser_table_none(): usize {
    var result: usize = 0;
    result--;
    return result;
}

fn parser_table_clear_runtime(table: ParserHostTable*): void {
    lr_runtime_destroy(table.runtime);
    table.runtime = null;
    var index: usize = 0;
    while index < table.states.length {
        vector_dispose(FrontendContextPosition, &table.states.data[index].contexts);
        index++;
    }
    vector_dispose(ParserHostState, &table.states);
    table.built = false;
}

export fn parser_table_destroy(table: ParserHostTable*): void {
    var absent = table == null;
    if absent {
        return;
    }
    parser_table_clear_runtime(table);
    lr_grammar_destroy(table.grammar);
    tower_memory_free(bits(void*, table));
}

// Input entities/kinds are borrowed for construction. LRGrammar owns immutable
// name/capture snapshots; successful build releases its source-node indexes.
export fn parser_table_open(root: void*, kinds: FrontendKinds*, userdata: void*, presentation: ParserPresentation, mode: u32): ParserHostTable* {
    var table = bits(ParserHostTable*, tower_memory_allocate(sizeof(ParserHostTable)));
    var missing = table == null;
    if missing {
        return null;
    }
    fill(table, 0, sizeof(ParserHostTable));
    table.userdata = userdata;
    table.presentation = presentation;
    table.match_kind = kinds.`match`;
    table.mode = mode;
    var empty = root == null;
    empty ||= entity_child_count(root) == 0;
    if empty {
        table.error = "Empty grammar";
        return table;
    }
    table.grammar = lr_grammar_create(root, kinds.rule, kinds.reference, kinds.string, kinds.range);
    missing = table.grammar == null;
    if missing {
        table.error = "Unable to allocate grammar indexes";
    }
    return table;
}

// Existing default-world transport API. Empty grammars do not create kind nodes.
export fn parser_table_open_host(root: void*, userdata: void*, presentation: ParserPresentation, mode: u32): ParserHostTable* {
    var kinds: FrontendKinds;
    fill(&kinds, 0, sizeof(FrontendKinds));
    var present = root != null;
    present &&= entity_child_count(root) != 0;
    if present {
        kinds.rule = parser_rule_get_type();
        kinds.reference = parser_reference_get_type();
        kinds.string = parser_string_get_type();
        kinds.range = parser_range_get_type();
        kinds.`match` = parser_match_get_type();
    }
    return parser_table_open(root, &kinds, userdata, presentation, mode);
}

fn parser_table_contexts(table: ParserHostTable*, analysis: void*, states: void*): bool {
    var count = lr_states_count(states);
    var ok = vector_reserve(ParserHostState, &table.states, count);
    if !ok {
        return false;
    }
    var state_size = sizeof(ParserHostState);
    var bytes = count * state_size;
    fill(table.states.data, 0, bytes);
    table.states.length = count;
    var rules = lr_grammar_rule_data(table.grammar);
    var symbols = lr_grammar_symbol_data(table.grammar);
    var index: usize = 0;
    while index < count {
        var state = &table.states.data[index];
        state.origin = lr_states_origin(states, index);
        var items = lr_states_items(states, index);
        var values = lr_items_data(items);
        var size = lr_items_count(items);
        ok = vector_reserve(FrontendContextPosition, &state.contexts, size);
        if !ok {
            return false;
        }
        var kernel: bool = true;
        loop {
            var position: usize = 0;
            while position < size {
                var item = &values[position];
                var selected = lr_kernel(analysis, item) == kernel;
                if selected {
                    var context = &state.contexts.data[state.contexts.length];
                    fill(context, 0, sizeof(FrontendContextPosition));
                    context.production = item.rule;
                    context.term = item.position;
                    var rule = &rules[item.rule];
                    var inside = item.position < rule.count;
                    if inside {
                        var symbol_index = rule.begin + item.position;
                        var symbol = &symbols[symbol_index];
                        context.terminal = symbol.nonterminal == parser_table_none();
                        if context.terminal {
                            context.first = symbol.first;
                            context.last = symbol.last;
                        }
                    }
                    state.contexts.length++;
                }
                position++;
            }
            if kernel {
                state.kernels = state.contexts.length;
                kernel = false;
            } else {
                break;
            }
        }
        index++;
    }
    return true;
}

// Hosts resolve missing grammar names before building. This never calls a host
// callback. A failure leaves the grammar available for retry and owns no runtime.
// Conflicts retain their runtime for diagnostics; they are never specialized.
export fn parser_table_build(table: ParserHostTable*, specialize: bool): bool {
    if table.built {
        return true;
    }
    var grammar = table.grammar;
    var missing = grammar == null;
    if missing {
        return false;
    }
    parser_table_clear_runtime(table);
    table.error = null;
    var unresolved = lr_grammar_pending(grammar) != parser_table_none();
    if unresolved {
        table.error = "Unresolved grammar rule";
        return false;
    }
    var analysis = lr_analysis_create(lr_grammar_rule_data(grammar), lr_grammar_rule_count(grammar),
    lr_grammar_symbol_data(grammar), lr_grammar_symbol_count(grammar), lr_grammar_name_count(grammar));
    missing = analysis == null;
    if missing {
        table.error = "Unable to allocate LR grammar analysis";
        return false;
    }
    var names = lr_grammar_name_count(grammar);
    var index: usize = 0;
    while index < names {
        lr_analysis_order(analysis, index, lr_grammar_name_order(grammar, index));
        index++;
    }
    var ok = lr_analysis_compute(analysis);
    var states: void* = null;
    if ok {
        table.error = "Unable to construct LR parser tables";
        states = lr_states_create(analysis);
        ok = states != null;
        if ok {
            var constructs = table.mode == convert(u32, ParserReadMode.Constructs);
            ok = lr_states_lalr(states, constructs);
        }
    } else {
        table.error = "Unable to allocate LR grammar analysis";
    }
    ok &&= parser_table_contexts(table, analysis, states);
    if ok {
        table.error = "Unable to allocate LR runtime tables";
        table.runtime = lr_runtime_create(states);
        ok = table.runtime != null;
    }
    if ok {
        var conflict: LRConflict;
        var ambiguous = lr_runtime_conflict(table.runtime, &conflict);
        if !ambiguous {
            if specialize {
                lr_runtime_specialize(table.runtime, states);
            }
        }
        lr_grammar_detach(grammar);
        table.built = true;
        table.error = null;
    }
    lr_states_destroy(states);
    lr_analysis_destroy(analysis);
    if !ok {
        parser_table_clear_runtime(table);
    }
    return ok;
}

export fn parser_table_uses_dfa(table: ParserHostTable*): bool {
    var absent = table == null;
    if absent {
        return false;
    }
    absent = table.runtime == null;
    if absent {
        return false;
    }
    var specialized = lr_runtime_sequence(table.runtime) != parser_table_none();
    return specialized;
}

export fn parser_table_grammar(table: ParserHostTable*): void* {
    var absent = table == null;
    if absent {
        return null;
    }
    return table.grammar;
}

// Iterate production ownership directly; debug-only queries need no copied
// nonterminal/rule lists. The returned index belongs to this table revision.
export fn parser_table_rule_next(table: ParserHostTable*, owner: usize, begin: usize): usize {
    var count = lr_grammar_rule_count(table.grammar);
    var rules = lr_grammar_rule_data(table.grammar);
    var index = begin;
    while index < count {
        var same = rules[index].owner == owner;
        if same {
            return index;
        }
        index++;
    }
    return parser_table_none();
}

fn parser_table_require(table: ParserHostTable*): void {
    var valid = table != null;
    valid &&= table.built;
    if !valid {
        abort();
    }
}

export fn parser_table_non_terminal_resolve_reference(userdata: void*, name: u8*): u32 {
    var table = bits(ParserHostTable*, userdata);
    parser_table_require(table);
    var count = lr_grammar_name_count(table.grammar);
    var index: usize = 0;
    while index < count {
        var candidate = lr_grammar_name(table.grammar, index);
        var position: usize = 0;
        loop {
            var different = candidate[position] != name[position];
            if different {
                break;
            }
            var end = candidate[position] == 0;
            if end {
                return convert(u32, index);
            }
            position++;
        }
        index++;
    }
    return ParserStreamEnd();
}

export fn parser_table_non_terminal_id_to_string(userdata: void*, id: u32): u8* {
    var table = bits(ParserHostTable*, userdata);
    parser_table_require(table);
    var index = convert(usize, id);
    var outside = index >= lr_grammar_name_count(table.grammar);
    if outside {
        return null;
    }
    var source = lr_grammar_name(table.grammar, index);
    var length: usize = 0;
    while source[length] != 0 {
        length++;
    }
    var size = length + 1;
    var text = bits(u8*, tower_memory_allocate(size));
    var missing = text == null;
    if missing {
        abort();
        return null;
    }
    copy(text, source, size);
    return text;
}
