import tower;
import lr_analysis;
import component_kinds;
import frontend_cache;
import frontend_revision_types;
import syntax_version;
import syntax_version_build;
import syntax_version_types;
import .library.vector;
import .library.work_budget_types;
import grammar_observer;

export fn syntax_version_cache_dispose(value: SyntaxVersionCache*): void {
    frontend_cache_dispose(&value.index);
    foreach(var & version in &value.versions) {
        syntax_version_release(*version);
    }
    vector_dispose(&value.versions);
}

// Clone recency and pins together; allocation failure preserves the destination.
export fn syntax_version_cache_copy(target: SyntaxVersionCache*, source: SyntaxVersionCache*): bool {
    if target == source {
        return true;
    }
    var prepared: SyntaxVersionCache = default;
    defer syntax_version_cache_dispose(&prepared);
    if !vector_reserve(&prepared.versions, source.versions.length) ||
    !frontend_cache_copy(&prepared.index, &source.index) {
        return false;
    }
    for(var i: usize = 0; i < source.versions.length; ++i) {
        prepared.versions.data[i] = syntax_version_retain(source.versions.data[i]);
    }
    prepared.versions.length = source.versions.length;
    syntax_version_cache_dispose(target);
    copy(target, &prepared, sizeof(SyntaxVersionCache));
    prepared = default;
    return true;
}

// Returns an owning pin. A successful uncached build remains usable if either
// slot storage or snapshot publication fails; no cache entry can lack its owner.
export fn syntax_version_cached(value: SyntaxVersionCache*, world: void*, definitions: FrontendRevision*, bedrock: FrontendRevision*, diagnostic: SyntaxVersionDiagnostic*): SyntaxVersion* {
    diagnostic.resource_error = WorkBudgetError.None;
    diagnostic.text.length = 0;
    diagnostic.fallback = "Unable to allocate grammar revision";
    if definitions is null {
        diagnostic.resource_error = WorkBudgetError.Invalid;
        return null;
    }
    var kind = compiler_world_type_result(world, CompilerSyntax, &diagnostic.resource_error);
    if kind is null {
        return null;
    }
    grammar_observe(world, GrammarPhase.Lookup, true, definitions.rules.length, definitions.tokens.length);
    var slot = frontend_cache_find(&value.index, definitions.rules.data, definitions.rules.length,
    definitions.tokens.data, definitions.tokens.length, kind);
    grammar_observe(world, GrammarPhase.Lookup, false, definitions.rules.length, definitions.tokens.length);
    if slot != lr_none() {
        diagnostic.fallback = "";
        return syntax_version_retain(value.versions.data[slot]);
    }
    grammar_observe(world, GrammarPhase.Build, true, definitions.rules.length, definitions.tokens.length);
    var version = syntax_version_build(world, definitions, bedrock, diagnostic);
    grammar_observe(world, GrammarPhase.Build, false, definitions.rules.length, definitions.tokens.length);
    if version is null {
        return null;
    }
    if !vector_reserve(&value.versions, FrontendCacheLimit) {
        return version;
    }
    if value.versions.length == 0 {
        fill(value.versions.data, 0, FrontendCacheLimit *sizeof(SyntaxVersion*));
        value.versions.length = FrontendCacheLimit;
    }
    slot = frontend_cache_store(&value.index, definitions.rules.data, definitions.rules.length,
    definitions.tokens.data, definitions.tokens.length);
    if slot != lr_none() {
        syntax_version_release(value.versions.data[slot]);
        value.versions.data[slot] = syntax_version_retain(version);
    }
    return version;
}
