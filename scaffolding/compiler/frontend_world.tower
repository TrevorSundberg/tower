extern fn compiler_host_world(): void*;

extern fn compiler_world_grammar(world: void*): CompilerGrammarCache*;

extern fn compiler_world_type(world: void*, kind: u32): void*;
extern fn compiler_world_type_result(world: void*, kind: u32, error: WorkBudgetError*): void*;

extern fn compiler_world_pinned(world: void*): bool;
extern fn syntax_host_clear(world: void*): bool;

fn frontend_world_kinds(world: void*, kinds: FrontendKinds*): bool {
    var error = WorkBudgetError.None;
    return frontend_world_kinds_result(world, kinds, &error);
}

fn frontend_world_kinds_result(world: void*, kinds: FrontendKinds*, error: WorkBudgetError*): bool {
    kinds.rule = compiler_world_type_result(world, CompilerParserRule, error);
    if kinds.rule == null { return false; }
    kinds.reference = compiler_world_type_result(world, CompilerParserReference, error);
    if kinds.reference == null { return false; }
    kinds.string = compiler_world_type_result(world, CompilerParserString, error);
    if kinds.string == null { return false; }
    kinds.range = compiler_world_type_result(world, CompilerParserRange, error);
    if kinds.range == null { return false; }
    kinds.`match` = compiler_world_type_result(world, CompilerParserMatch, error);
    if kinds.`match` == null { return false; }
    kinds.syntax = compiler_world_type_result(world, CompilerSyntax, error);
    return kinds.syntax != null;
}

// Borrowed immutable baseline. Retain it to outlive cache reset. A failed
// construction publishes nothing, so callers can retry after resource recovery.
export fn frontend_world_bedrock(world: void*): void* {
    var cache = compiler_world_grammar(world);
    if cache.bedrock != null {
        return cache.bedrock;
    }
    var kinds: FrontendKinds;
    if frontend_world_kinds(world, &kinds) {
        cache.bedrock = frontend_bedrock_create(&kinds);
    }
    return cache.bedrock;
}

// Result owns its ordinary parse entities independently of the cached reader.
export fn frontend_world_pattern(world: void*, source: u8*, length: usize, error: FormatResult*): SyntaxPattern* {
    var resource_error = WorkBudgetError.None;
    return frontend_world_pattern_result(world, source, length, error, &resource_error);
}

export fn frontend_world_pattern_result(world: void*, source: u8*, length: usize, error: FormatResult*,
    resource_error: WorkBudgetError*): SyntaxPattern* {
    if resource_error == null { return null; }
    *resource_error = WorkBudgetError.Invalid;
    if world == null || error == null || (source == null && length != 0) { return null; }
    format_storage_begin(error, compiler_world_work_budget(world));
    if error.failed { *resource_error = format_storage_error(error); return null; }
    var cache = compiler_world_grammar(world);
    if cache.patterns == null {
        var kinds: FrontendKinds = default;
        if frontend_world_kinds_result(world, &kinds, resource_error) {
            cache.patterns = bits(void*, frontend_pattern_create_result(&kinds, resource_error));
        }
        if cache.patterns == null {
            var formatter: FormatEngine = default;
            formatter.result = error;
            format_text(&formatter, "Unable to construct token pattern grammar");
            if error.failed && *resource_error == WorkBudgetError.None { *resource_error = format_storage_error(error); }
            return null;
        }
    }
    return frontend_pattern_read_result(bits(FrontendPatternCompiler*, cache.patterns), source, length, error, resource_error);
}

// Coordinator operation after requests join. A pin rejects reset without
// changing either cache. Retained outputs remain valid and block world disposal.
export fn frontend_world_clear(world: void*): bool {
    if compiler_world_pinned(world) {
        return false;
    }
    var cache = compiler_world_grammar(world);
    if cache.workers_busy { return false; }
    if !syntax_host_clear(world) { return false; }
    work_pool_close(&cache.workers);
    syntax_baselines_clear(world);
    frontend_pattern_destroy(bits(FrontendPatternCompiler*, cache.patterns));
    cache.patterns = null;
    if cache.bedrock != null {
        entity_release(cache.bedrock);
    }
    cache.bedrock = null;
    return true;
}

// Existing host ABI, implemented entirely in Tower. The native default-world
// handle remains until host transport/session ownership is migrated.
export fn syntax_native_bedrock(): void* {
    var document = frontend_world_bedrock(compiler_host_world());
    if document == null {
        abort();
    }
    return document;
}

export fn frontend_host_pattern_read(source: u8*, length: usize, error: FormatResult*): SyntaxPattern* {
    return frontend_world_pattern(compiler_host_world(), source, length, error);
}
