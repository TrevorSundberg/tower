import tower;
import grammar_types;
import component_kinds;
import format_types;
import frontend_bedrock;
import frontend_modules;
import frontend_pattern;
import lr_tree;
import syntax_types;
import syntax_baselines;
import syntax_session_inputs;
import syntax_replacement_owner;
import syntax_version;
import syntax_version_build;
import syntax_version_presentation;
import syntax_version_cache;
import syntax_session_pins;
import syntax_session_state;
import syntax_session_format;

extern fn compiler_host_world(): void*;

extern fn compiler_world_grammar(world: void*): CompilerGrammarCache*;

extern fn compiler_world_type(world: void*, kind: u32): void*;

extern fn compiler_world_pinned(world: void*): bool;

fn frontend_world_kinds(world: void*, kinds: FrontendKinds*): bool {
    kinds.rule = compiler_world_type(world, CompilerParserRule());
    kinds.reference = compiler_world_type(world, CompilerParserReference());
    kinds.string = compiler_world_type(world, CompilerParserString());
    kinds.range = compiler_world_type(world, CompilerParserRange());
    kinds.`match` = compiler_world_type(world, CompilerParserMatch());
    kinds.syntax = compiler_world_type(world, CompilerSyntax());
    var missing = kinds.rule == null;
    if missing {
        return false;
    }
    missing = kinds.reference == null;
    if missing {
        return false;
    }
    missing = kinds.string == null;
    if missing {
        return false;
    }
    missing = kinds.range == null;
    if missing {
        return false;
    }
    missing = kinds.`match` == null;
    if missing {
        return false;
    }
    var ready = kinds.syntax != null;
    return ready;
}

// Borrowed immutable baseline. Retain it to outlive cache reset. A failed
// construction publishes nothing, so callers can retry after resource recovery.
export fn frontend_world_bedrock(world: void*): void* {
    var cache = compiler_world_grammar(world);
    if cache.bedrock != null {
        return cache.bedrock;
    }
    var kinds: FrontendKinds;
    if frontend_world_kinds(world, &kinds) {
        cache.bedrock = frontend_bedrock_create(&kinds);
    }
    return cache.bedrock;
}

// Result owns its ordinary parse entities independently of the cached reader.
export fn frontend_world_pattern(world: void*, source: u8*, length: usize, error: FormatResult*): SyntaxPattern* {
    var cache = compiler_world_grammar(world);
    if cache.patterns == null {
        var kinds: FrontendKinds;
        if frontend_world_kinds(world, &kinds) {
            cache.patterns = bits(void*, frontend_pattern_create(&kinds));
        }
    }
    return frontend_pattern_read(bits(FrontendPatternCompiler*, cache.patterns), source, length, error);
}

// Coordinator operation after requests join. A pin rejects reset without
// changing either cache. Retained outputs remain valid and block world disposal.
export fn frontend_world_clear(world: void*): bool {
    if compiler_world_pinned(world) {
        return false;
    }
    var cache = compiler_world_grammar(world);
    syntax_baselines_clear(world);
    frontend_pattern_destroy(bits(FrontendPatternCompiler*, cache.patterns));
    cache.patterns = null;
    if cache.bedrock != null {
        entity_release(cache.bedrock);
    }
    cache.bedrock = null;
    return true;
}

// Existing host ABI, implemented entirely in Tower. The native default-world
// handle remains until host transport/session ownership is migrated.
export fn syntax_native_bedrock(): void* {
    var document = frontend_world_bedrock(compiler_host_world());
    if document == null {
        abort();
    }
    return document;
}

export fn frontend_host_pattern_read(source: u8*, length: usize, error: FormatResult*): SyntaxPattern* {
    return frontend_world_pattern(compiler_host_world(), source, length, error);
}
