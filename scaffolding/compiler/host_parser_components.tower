extern fn node_string_length(value: ParserStringData*): usize;

extern fn node_string_data(value: ParserStringData*): u32*;

extern fn node_string_resize(value: ParserStringData*, length: usize): bool;

extern fn node_string_set(value: ParserStringData*, index: usize, id: u32): bool;

extern fn node_string_append(value: ParserStringData*, source: u8*, length: usize): bool;

export fn parser_string_get_length(value: ParserStringData*): usize {
    var present = value != null;
    compiler_entity_require(present);
    return node_string_length(value);
}

export fn parser_string_get_data(value: ParserStringData*): u32* {
    var present = value != null;
    compiler_entity_require(present);
    return node_string_data(value);
}

export fn parser_string_get_id(value: ParserStringData*, index: usize): u32 {
    var present = value != null;
    compiler_entity_require(present);
    var in_range = index < node_string_length(value);
    compiler_entity_require(in_range);
    var data = node_string_data(value);
    return data[index];
}

export fn parser_string_set_length(value: ParserStringData*, length: usize): void {
    var present = value != null;
    compiler_entity_require(present);
    compiler_entity_require(node_string_resize(value, length));
}

export fn parser_string_set_id(value: ParserStringData*, index: usize, id: u32): void {
    var present = value != null;
    compiler_entity_require(present);
    compiler_entity_require(node_string_set(value, index, id));
}

export fn parser_string_append_utf8(value: ParserStringData*, begin: u8*, end: u8*): void {
    var present = value != null;
    compiler_entity_require(present);
    var first = bits(usize, begin);
    var last = bits(usize, end);
    var ordered = last >= first;
    compiler_entity_require(ordered);
    var length = last -first;
    compiler_entity_require(node_string_append(value, begin, length));
}
