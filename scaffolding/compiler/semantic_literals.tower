import tower;
import foundation_types;
import semantic_context_types;
import .library.float_text;
import .library.float_bits;

// This linked leaf uses the same numeric implementation as the interpreter.
// Its caller owns the context and token scratch for the complete call.
extern fn sem_literal(c: SemanticContext*, node: void*): bool;
extern fn sem_token_text(c: SemanticContext*, node: void*): u8*;
extern fn semantic_width(t: FoundationType*): u32;
extern fn sem_fail(c: SemanticContext*, node: void*, text: u8*): void;

export fn sem_float_one(type: FoundationType*): u64 {
    return tower_float_from_integer(1, Float32Width, false, semantic_width(type));
}

export fn sem_float_literal(c: SemanticContext*, node: void*): bool {
    if !sem_literal(c, node) { return false; }
    var text = sem_token_text(c, node);
    var start: usize = text[0] == FloatDecimalMinus ? 1 : 0;
    if !float_decimal_digit(text[start]) { return false; }
    for (var i: usize = 0; text[i] != 0; i++) {
        if text[i] == FloatDecimalPoint || text[i] == FloatDecimalExponent || text[i] == FloatDecimalUpperExponent { return true; }
    }
    return false;
}

export fn sem_float_parse(c: SemanticContext*, node: void*, text: u8*, value: FoundationNode*): void {
    var status: FloatParseStatus;
    value.bits = float_parse(text, semantic_width(&value.type), &status);
    if status != FloatParseStatus.Valid {
        sem_fail(c, node, status == FloatParseStatus.Overflow ? "Floating literal out of range" :
            (status == FloatParseStatus.DigitLimit ? "Floating literal exceeds decimal digit budget" : "Invalid floating literal"));
    }
}
