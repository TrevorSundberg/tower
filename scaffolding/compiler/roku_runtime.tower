import tower;
import roku_emitter;

// Platform runtime text. Full-width integers retain exact bit patterns; masked
// limb extraction uses only exactly representable powers-of-two scaling.
fn re_runtime(r: RokuEmitter*): void {
    re_text(r, "function tr_clz(x as longinteger, width as integer) as longinteger\n");
    re_text(r, "    count = 0&\n");
    re_text(r, "    for i = width - 1 to 0 step -1\n");
    re_text(r, "        digit% = tr_limb(x, i \\ 16)\n");
    re_text(r, "        if (digit% and (1 << (i mod 16))) <> 0 then return count\n");
    re_text(r, "        count = count + 1&\n");
    re_text(r, "    end for\n");
    re_text(r, "    return count\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_ctz(x as longinteger, width as integer) as longinteger\n");
    re_text(r, "    count = 0&\n");
    re_text(r, "    for i = 0 to width - 1\n");
    re_text(r, "        digit% = tr_limb(x, i \\ 16)\n");
    re_text(r, "        if (digit% and (1 << (i mod 16))) <> 0 then return count\n");
    re_text(r, "        count = count + 1&\n");
    re_text(r, "    end for\n");
    re_text(r, "    return count\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_popcnt(x as longinteger, width as integer) as longinteger\n");
    re_text(r, "    count = 0&\n");
    re_text(r, "    for i = 0 to width \\ 16 - 1\n");
    re_text(r, "        digit% = tr_limb(x, i)\n");
    re_text(r, "        while digit% <> 0\n");
    re_text(r, "            digit% = digit% and (digit% - 1)\n");
    re_text(r, "            count = count + 1&\n");
    re_text(r, "        end while\n");
    re_text(r, "    end for\n");
    re_text(r, "    return count\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "' Masked powers-of-two scaling of 16 significant bits is exact in Double.\n");
    re_text(r, "' No full-width value is ever converted to floating point.\n");
    re_text(r, "function tr_limb(x as longinteger, index as integer) as longinteger\n");
    re_text(r, "    if index = 0 then return x and &hffff&\n");
    re_text(r, "    if index = 1 then return (x and &hffff0000&) / 65536#\n");
    re_text(r, "    if index = 2 then return (x and &hffff00000000&) / 4294967296#\n");
    re_text(r, "    if index = 3 then\n");
    re_text(r, "        part& = (x and &h7fff000000000000&) / 281474976710656#\n");
    re_text(r, "        if x < 0& then part& = part& + 32768&\n");
    re_text(r, "        return part&\n");
    re_text(r, "    end if\n");
    re_text(r, "    return 0&\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_pack(parts as object) as longinteger\n");
    re_text(r, "    x = parts[0] or (parts[1] * 65536&) or (parts[2] * 4294967296&) or ((parts[3] and 32767&) * 281474976710656&)\n");
    re_text(r, "    if (parts[3] and 32768&) <> 0& then x = x or &h8000000000000000&\n");
    re_text(r, "    return x\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_shr(x as longinteger, count as longinteger) as longinteger\n");
    re_text(r, "    count = count and 63&\n");
    re_text(r, "    words = count \\ 16&\n");
    re_text(r, "    bits = count and 15&\n");
    re_text(r, "    factor& = 1 << bits\n");
    re_text(r, "    parts = []\n");
    re_text(r, "    for i = 0 to 3\n");
    re_text(r, "        part& = tr_limb(x, i + words) \\ factor&\n");
    re_text(r, "        if bits <> 0& then part& = part& + (tr_limb(x, i + words + 1) and (factor& - 1&)) * (65536& \\ factor&)\n");
    re_text(r, "        parts.push(part&)\n");
    re_text(r, "    end for\n");
    re_text(r, "    return tr_pack(parts)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_shl(x as longinteger, count as longinteger) as longinteger\n");
    re_text(r, "    count = count and 63&\n");
    re_text(r, "    words = count \\ 16&\n");
    re_text(r, "    bits = count and 15&\n");
    re_text(r, "    factor& = 1 << bits\n");
    re_text(r, "    parts = []\n");
    re_text(r, "    for i = 0 to 3\n");
    re_text(r, "        part& = (tr_limb(x, i - words) * factor&) and 65535&\n");
    re_text(r, "        if bits <> 0& then part& = part& + tr_limb(x, i - words - 1) \\ (65536& \\ factor&)\n");
    re_text(r, "        parts.push(part&)\n");
    re_text(r, "    end for\n");
    re_text(r, "    return tr_pack(parts)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_shrs(x as longinteger, count as longinteger, width as longinteger) as longinteger\n");
    re_text(r, "    count = count and (width - 1&)\n");
    re_text(r, "    x = tr_signed(x, width)\n");
    re_text(r, "    if count = 0& then return tr_mask(x, width)\n");
    re_text(r, "    result = tr_shr(x, count)\n");
    re_text(r, "    if x < 0& then result = result or tr_shl(not 0&, 64& - count)\n");
    re_text(r, "    return tr_mask(result, width)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_rotl(x as longinteger, count as longinteger, width as longinteger) as longinteger\n");
    re_text(r, "    count = count and (width - 1&)\n");
    re_text(r, "    x = tr_mask(x, width)\n");
    re_text(r, "    if count = 0& then return x\n");
    re_text(r, "    return tr_mask(tr_shl(x, count) or tr_shr(x, width - count), width)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_rotr(x as longinteger, count as longinteger, width as longinteger) as longinteger\n");
    re_text(r, "    return tr_rotl(x, width - (count and (width - 1&)), width)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "' LongInteger holds bits, including unsigned values with the high bit set.\n");
    re_text(r, "' Arithmetic never passes through Float/Double or overflowing signed addition.\n");
    re_text(r, "function tr_mask(x as longinteger, w as longinteger) as longinteger\n");
    re_text(r, "    if w = 64 then return x\n");
    re_text(r, "    if w = 32 then return x and &hffffffff&\n");
    re_text(r, "    if w = 16 then return x and &hffff&\n");
    re_text(r, "    if w = 8 then return x and &hff&\n");
    re_text(r, "    if w = 1 then return x and 1&\n");
    re_text(r, "    return x and ((tr_shl(1&, w)) - 1&)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_signed(x as longinteger, w as longinteger) as longinteger\n");
    re_text(r, "    x = tr_mask(x, w)\n");
    re_text(r, "    if w = 64 then return x\n");
    re_text(r, "    if (x and (tr_shl(1&, w - 1))) <> 0 then return x - (tr_shl(1&, w))\n");
    re_text(r, "    return x\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_bool(x as boolean) as longinteger\n");
    re_text(r, "    if x then return 1&\n");
    re_text(r, "    return 0&\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_add(a as longinteger, b as longinteger, w = 64 as longinteger, signed = false as boolean) as longinteger\n");
    re_text(r, "    parts = []\n");
    re_text(r, "    carry = 0&\n");
    re_text(r, "    for i = 0 to 3\n");
    re_text(r, "        sum = tr_limb(a, i) + tr_limb(b, i) + carry\n");
    re_text(r, "        parts.push(sum and 65535&)\n");
    re_text(r, "        carry = sum \\ 65536&\n");
    re_text(r, "    end for\n");
    re_text(r, "    return tr_mask(tr_pack(parts), w)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_neg(a as longinteger) as longinteger\n");
    re_text(r, "    return tr_add(not a, 1&)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_sub(a as longinteger, b as longinteger, w as longinteger, signed as boolean) as longinteger\n");
    re_text(r, "    return tr_mask(tr_add(a, tr_neg(b)), w)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_mul(a as longinteger, b as longinteger, w as longinteger, signed as boolean) as longinteger\n");
    re_text(r, "    result = 0&\n");
    re_text(r, "    carry = 0&\n");
    re_text(r, "    for i = 0 to 3\n");
    re_text(r, "        sum = carry\n");
    re_text(r, "        for j = 0 to i\n");
    re_text(r, "            sum = sum + tr_limb(a, j) * tr_limb(b, i - j)\n");
    re_text(r, "        end for\n");
    re_text(r, "        result = result or (tr_shl(sum and &hffff&, 16& * i))\n");
    re_text(r, "        carry = tr_shr(sum, 16&)\n");
    re_text(r, "    end for\n");
    re_text(r, "    return tr_mask(result, w)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_and(a as longinteger, b as longinteger, w as longinteger, signed as boolean) as longinteger\n");
    re_text(r, "    return tr_mask(a and b, w)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_or(a as longinteger, b as longinteger, w as longinteger, signed as boolean) as longinteger\n");
    re_text(r, "    return tr_mask(a or b, w)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_xor(a as longinteger, b as longinteger, w as longinteger, signed as boolean) as longinteger\n");
    re_text(r, "    return tr_mask((a or b) and not (a and b), w)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_compare(a as longinteger, b as longinteger, w as longinteger, signed as boolean) as integer\n");
    re_text(r, "    a = tr_mask(a, w)\n");
    re_text(r, "    b = tr_mask(b, w)\n");
    re_text(r, "    if signed then\n");
    re_text(r, "        a = tr_signed(a, w)\n");
    re_text(r, "        b = tr_signed(b, w)\n");
    re_text(r, "    else if w = 64 then\n");
    re_text(r, "        ' Flip the sign bit so signed comparison orders unsigned bit patterns.\n");
    re_text(r, "        a = tr_xor(a, &h8000000000000000&, 64, false)\n");
    re_text(r, "        b = tr_xor(b, &h8000000000000000&, 64, false)\n");
    re_text(r, "    end if\n");
    re_text(r, "    if a < b then return -1\n");
    re_text(r, "    if a > b then return 1\n");
    re_text(r, "    return 0\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_udiv(a as longinteger, b as longinteger) as object\n");
    re_text(r, "    if b = 0& then tr_trap(\"Division by zero\")\n");
    re_text(r, "    if tr_compare(a, b, 64, false) < 0 then return [0&, a]\n");
    re_text(r, "    if b = 1& then return [a, 0&]\n");
    re_text(r, "    if b > 0& and b < 65536& then\n");
    re_text(r, "        parts = [0&, 0&, 0&, 0&]\n");
    re_text(r, "        r = 0&\n");
    re_text(r, "        for i = 3 to 0 step -1\n");
    re_text(r, "            chunk = r * 65536& + tr_limb(a, i)\n");
    re_text(r, "            digit& = chunk \\ b\n");
    re_text(r, "            r = chunk - digit& * b\n");
    re_text(r, "            parts[i] = digit&\n");
    re_text(r, "        end for\n");
    re_text(r, "        return [tr_pack(parts), r]\n");
    re_text(r, "    end if\n");
    re_text(r, "    q = [0&, 0&, 0&, 0&]\n");
    re_text(r, "    r = 0&\n");
    re_text(r, "    for bit = 63& to 0& step -1&\n");
    re_text(r, "        carry = r < 0&\n");
    re_text(r, "        word% = bit \\ 16&\n");
    re_text(r, "        bitIndex% = bit and 15&\n");
    re_text(r, "        digit% = tr_limb(a, word%)\n");
    re_text(r, "        r = tr_add(r, r) or ((digit% >> bitIndex%) and 1&)\n");
    re_text(r, "        if carry or tr_compare(r, b, 64, false) >= 0 then\n");
    re_text(r, "            r = tr_sub(r, b, 64, false)\n");
    re_text(r, "            q[word%] = q[word%] or (1 << bitIndex%)\n");
    re_text(r, "        end if\n");
    re_text(r, "    end for\n");
    re_text(r, "    return [tr_pack(q), r]\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_divide(a as longinteger, b as longinteger, w as longinteger, signed as boolean, remainder as boolean) as longinteger\n");
    re_text(r, "    a = tr_mask(a, w)\n");
    re_text(r, "    b = tr_mask(b, w)\n");
    re_text(r, "    if b = 0& then tr_trap(\"Division by zero\")\n");
    re_text(r, "    negativeA = false\n");
    re_text(r, "    negativeB = false\n");
    re_text(r, "    if signed then\n");
    re_text(r, "        a = tr_signed(a, w)\n");
    re_text(r, "        b = tr_signed(b, w)\n");
    re_text(r, "        negativeA = a < 0&\n");
    re_text(r, "        negativeB = b < 0&\n");
    re_text(r, "        if a = (&h8000000000000000&) and b = -1& and not remainder then tr_trap(\"Signed division overflow\")\n");
    re_text(r, "        if w < 64 and a = -(tr_shl(1&, w - 1)) and b = -1& and not remainder then tr_trap(\"Signed division overflow\")\n");
    re_text(r, "        if negativeA then a = tr_neg(a)\n");
    re_text(r, "        if negativeB then b = tr_neg(b)\n");
    re_text(r, "    end if\n");
    re_text(r, "    parts = tr_udiv(a, b)\n");
    re_text(r, "    if remainder then\n");
    re_text(r, "        result = parts[1]\n");
    re_text(r, "        if negativeA then result = tr_neg(result)\n");
    re_text(r, "    else\n");
    re_text(r, "        result = parts[0]\n");
    re_text(r, "        if negativeA <> negativeB then result = tr_neg(result)\n");
    re_text(r, "    end if\n");
    re_text(r, "    return tr_mask(result, w)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_div(a as longinteger, b as longinteger, w as longinteger, signed as boolean) as longinteger\n");
    re_text(r, "    return tr_divide(a, b, w, signed, false)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_rem(a as longinteger, b as longinteger, w as longinteger, signed as boolean) as longinteger\n");
    re_text(r, "    return tr_divide(a, b, w, signed, true)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_convert(x as longinteger, fromWidth as longinteger, fromSigned as boolean, toWidth as longinteger, toSigned as boolean, checked as boolean) as longinteger\n");
    re_text(r, "    if toWidth = 1 then return tr_bool(x <> 0&)\n");
    re_text(r, "    x = tr_mask(x, fromWidth)\n");
    re_text(r, "    negative = false\n");
    re_text(r, "    if fromSigned then\n");
    re_text(r, "        x = tr_signed(x, fromWidth)\n");
    re_text(r, "        negative = x < 0&\n");
    re_text(r, "    end if\n");
    re_text(r, "    if checked then\n");
    re_text(r, "        if negative then\n");
    re_text(r, "            if not toSigned then tr_trap(\"Conversion out of range\")\n");
    re_text(r, "            if toWidth < 64 then\n");
    re_text(r, "                if x < -(tr_shl(1&, toWidth - 1)) then tr_trap(\"Conversion out of range\")\n");
    re_text(r, "            end if\n");
    re_text(r, "        else\n");
    re_text(r, "            maximum = not 0&\n");
    re_text(r, "            if toWidth < 64 then maximum = (tr_shl(1&, toWidth)) - 1&\n");
    re_text(r, "            if toSigned then maximum = tr_shr(maximum, 1&)\n");
    re_text(r, "            if tr_compare(x, maximum, 64, false) > 0 then tr_trap(\"Conversion out of range\")\n");
    re_text(r, "        end if\n");
    re_text(r, "    end if\n");
    re_text(r, "    return tr_mask(x, toWidth)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_decimal(x as longinteger) as string\n");
    re_text(r, "    result = \"\"\n");
    re_text(r, "    while true\n");
    re_text(r, "        parts = tr_udiv(x, 10&)\n");
    re_text(r, "        result = chr(48 + parts[1]) + result\n");
    re_text(r, "        x = parts[0]\n");
    re_text(r, "        if x = 0& then return result\n");
    re_text(r, "    end while\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "sub tr_trap(message as string)\n");
    re_text(r, "    ' Unwind the complete guest call stack. The caller may catch and display it.\n");
    re_text(r, "    throw \"Tower: \" + message\n");
    re_text(r, "end sub\n");
    re_text(r, "\n");
    re_text(r, "function tr_state(output as dynamic, memoryLimit as integer) as object\n");
    re_text(r, "    if memoryLimit < 8 then tr_trap(\"Memory limit must be at least 8 bytes\")\n");
    re_text(r, "    return {mem: createobject(\"roByteArray\"), next: 8&, allocations: {}, available: [], g: [], output: output, limit: memoryLimit}\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_count(n as longinteger, size as longinteger) as longinteger\n");
    re_text(r, "    if n < 0& or n > &hffffffff& or size < 0& or size > &hffffffff& then tr_trap(\"Allocation size overflow\")\n");
    re_text(r, "    bytes = tr_mul(n, size, 64, false)\n");
    re_text(r, "    if bytes < 0& or bytes > &h7ffffff0& then tr_trap(\"Allocation size exceeds Roku profile\")\n");
    re_text(r, "    return bytes\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_alloc(s as object, count as longinteger) as longinteger\n");
    re_text(r, "    if count < 0& or count > &h7ffffff0& then tr_trap(\"Allocation size exceeds Roku profile\")\n");
    re_text(r, "    count = (count + 7&) and not 7&\n");
    re_text(r, "    if count = 0& then count = 8&\n");
    re_text(r, "    p = 0&\n");
    re_text(r, "    for i = 0 to s.available.count() - 1\n");
    re_text(r, "        block = s.available[i]\n");
    re_text(r, "        if block.size >= count then\n");
    re_text(r, "            p = block.p\n");
    re_text(r, "            block.p = block.p + count\n");
    re_text(r, "            block.size = block.size - count\n");
    re_text(r, "            if block.size = 0& then s.available.delete(i)\n");
    re_text(r, "            exit for\n");
    re_text(r, "        end if\n");
    re_text(r, "    end for\n");
    re_text(r, "    if p = 0& then\n");
    re_text(r, "        p = s.next\n");
    re_text(r, "        if p + count > s.limit then tr_trap(\"Roku memory limit exceeded\")\n");
    re_text(r, "        s.next = p + count\n");
    re_text(r, "        ' roByteArray extends and fills intervening bytes with zero.\n");
    re_text(r, "        s.mem[s.next - 1&] = 0\n");
    re_text(r, "    end if\n");
    re_text(r, "    s.allocations[p.tostr()] = count\n");
    re_text(r, "    tr_fill(s, p, 0&, count)\n");
    re_text(r, "    return p\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "sub tr_free(s as object, p as longinteger)\n");
    re_text(r, "    if p = 0& then return\n");
    re_text(r, "    count = s.allocations[p.tostr()]\n");
    re_text(r, "    if count = invalid then tr_trap(\"Invalid free\")\n");
    re_text(r, "    s.allocations.delete(p.tostr())\n");
    re_text(r, "    ' Coalesce adjacent free ranges; addresses remain plain target byte values.\n");
    re_text(r, "    i = 0\n");
    re_text(r, "    while i < s.available.count()\n");
    re_text(r, "        block = s.available[i]\n");
    re_text(r, "        if block.p + block.size = p then\n");
    re_text(r, "            p = block.p\n");
    re_text(r, "            count = count + block.size\n");
    re_text(r, "            s.available.delete(i)\n");
    re_text(r, "            i = 0\n");
    re_text(r, "        else if p + count = block.p then\n");
    re_text(r, "            count = count + block.size\n");
    re_text(r, "            s.available.delete(i)\n");
    re_text(r, "            i = 0\n");
    re_text(r, "        else\n");
    re_text(r, "            i = i + 1\n");
    re_text(r, "        end if\n");
    re_text(r, "    end while\n");
    re_text(r, "    s.available.push({p: p, size: count})\n");
    re_text(r, "end sub\n");
    re_text(r, "\n");
    re_text(r, "function tr_realloc(s as object, p as longinteger, count as longinteger) as longinteger\n");
    re_text(r, "    if p = 0& then return tr_alloc(s, count)\n");
    re_text(r, "    oldSize = s.allocations[p.tostr()]\n");
    re_text(r, "    if oldSize = invalid then tr_trap(\"Invalid realloc\")\n");
    re_text(r, "    result = tr_alloc(s, count)\n");
    re_text(r, "    if oldSize < count then count = oldSize\n");
    re_text(r, "    tr_copy(s, result, p, count)\n");
    re_text(r, "    tr_free(s, p)\n");
    re_text(r, "    return result\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "function tr_offset(p as longinteger, index as longinteger, size as longinteger) as longinteger\n");
    re_text(r, "    return tr_mask(tr_add(p, tr_mul(index, size, 64, false)), 32)\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "sub tr_range(s as object, p as longinteger, count as longinteger)\n");
    re_text(r, "    ' VM containment, not a Tower allocation/lifetime/initialization guarantee.\n");
    re_text(r, "    if count = 0& then return\n");
    re_text(r, "    if p < 8& or count < 0& or p > s.next or count > s.next - p then tr_trap(\"Invalid raw memory access\")\n");
    re_text(r, "end sub\n");
    re_text(r, "\n");
    re_text(r, "function tr_load(s as object, p as longinteger, count as integer) as longinteger\n");
    re_text(r, "    tr_range(s, p, count)\n");
    re_text(r, "    result = 0&\n");
    re_text(r, "    for i = 0 to count - 1\n");
    re_text(r, "        byte = s.mem[p + i]\n");
    re_text(r, "        value& = byte\n");
    re_text(r, "        result = result or (tr_shl(value&, 8& * i))\n");
    re_text(r, "    end for\n");
    re_text(r, "    return result\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "sub tr_store(s as object, p as longinteger, value as longinteger, count as integer)\n");
    re_text(r, "    tr_range(s, p, count)\n");
    re_text(r, "    for i = 0 to count - 1\n");
    re_text(r, "        byte% = tr_shr(value, 8& * i) and 255&\n");
    re_text(r, "        s.mem[p + i] = byte%\n");
    re_text(r, "    end for\n");
    re_text(r, "end sub\n");
    re_text(r, "\n");
    re_text(r, "sub tr_fill(s as object, p as longinteger, value as longinteger, count as longinteger)\n");
    re_text(r, "    tr_range(s, p, count)\n");
    re_text(r, "    byte% = value and 255&\n");
    re_text(r, "    for i = 0& to count - 1&\n");
    re_text(r, "        s.mem[p + i] = byte%\n");
    re_text(r, "    end for\n");
    re_text(r, "end sub\n");
    re_text(r, "\n");
    re_text(r, "sub tr_copy(s as object, destination as longinteger, source as longinteger, count as longinteger)\n");
    re_text(r, "    tr_range(s, destination, count)\n");
    re_text(r, "    tr_range(s, source, count)\n");
    re_text(r, "    if destination > source then\n");
    re_text(r, "        for i = count - 1& to 0& step -1&\n");
    re_text(r, "            s.mem[destination + i] = s.mem[source + i]\n");
    re_text(r, "        end for\n");
    re_text(r, "    else\n");
    re_text(r, "        for i = 0& to count - 1&\n");
    re_text(r, "            s.mem[destination + i] = s.mem[source + i]\n");
    re_text(r, "        end for\n");
    re_text(r, "    end if\n");
    re_text(r, "end sub\n");
    re_text(r, "\n");
    re_text(r, "function tr_string(s as object, p as longinteger, count as longinteger) as string\n");
    re_text(r, "    tr_range(s, p, count)\n");
    re_text(r, "    bytes = createobject(\"roByteArray\")\n");
    re_text(r, "    for i = 0& to count - 1&\n");
    re_text(r, "        bytes.push(s.mem[p + i])\n");
    re_text(r, "    end for\n");
    re_text(r, "    return bytes.toasciistring()\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "sub tr_output(s as object, text as string)\n");
    re_text(r, "    if s.output <> invalid then\n");
    re_text(r, "        s.output(text)\n");
    re_text(r, "    else\n");
    re_text(r, "        print text;\n");
    re_text(r, "    end if\n");
    re_text(r, "end sub\n");
    re_text(r, "\n");
    re_text(r, "function tr_write(s as object, args as object) as longinteger\n");
    re_text(r, "    ' Foundation platform_write(stream, data, length).\n");
    re_text(r, "    if args[0] <> 1& and args[0] <> 2& then return -1&\n");
    re_text(r, "    text = tr_string(s, args[1], args[2])\n");
    re_text(r, "    tr_output(s, text)\n");
    re_text(r, "    return args[2]\n");
    re_text(r, "end function\n");
    re_text(r, "\n");
    re_text(r, "sub tr_print(s as object, x as longinteger, w as longinteger, signed as boolean, pointer as boolean)\n");
    re_text(r, "    if pointer then\n");
    re_text(r, "        text = \"0x\"\n");
    re_text(r, "        alphabet = \"0123456789abcdef\"\n");
    re_text(r, "        for digit = 7 to 0 step -1\n");
    re_text(r, "            nibble% = tr_shr(x, digit * 4&) and 15&\n");
    re_text(r, "            text = text + mid(alphabet, nibble% + 1, 1)\n");
    re_text(r, "        end for\n");
    re_text(r, "    else if w = 1 then\n");
    re_text(r, "        if x = 0& then\n");
    re_text(r, "            text = \"false\"\n");
    re_text(r, "        else\n");
    re_text(r, "            text = \"true\"\n");
    re_text(r, "        end if\n");
    re_text(r, "    else\n");
    re_text(r, "        x = tr_mask(x, w)\n");
    re_text(r, "        negative = false\n");
    re_text(r, "        if signed then\n");
    re_text(r, "            x = tr_signed(x, w)\n");
    re_text(r, "            negative = x < 0&\n");
    re_text(r, "            if negative then x = tr_neg(x)\n");
    re_text(r, "        end if\n");
    re_text(r, "        text = tr_decimal(x)\n");
    re_text(r, "        if negative then text = \"-\" + text\n");
    re_text(r, "    end if\n");
    re_text(r, "    tr_output(s, text + chr(10))\n");
    re_text(r, "end sub\n");
}
