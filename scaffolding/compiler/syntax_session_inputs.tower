import tower;
import .library.work_budget_types;
import component_kinds;
import frontend_modules;
import frontend_revision_types;
import lr_tree;
import parser_nodes;
import syntax_nodes;
import syntax_reader;
import syntax_session_types;
import syntax_source;
import syntax_tags;
import syntax_types;
import syntax_validation;

extern fn compiler_world_store(world: void*): void*;
extern fn compiler_world_component_result(world: void*, entity: void*, kind: u32, error: WorkBudgetError*): void*;
extern fn entity_create_result(store: void*, error: WorkBudgetError*): void*;

export fn syntax_session_inputs_dispose(value: SyntaxSessionInputs*): void {
    if value.owns_module { frontend_module_destroy(bits(FrontendModule*, value.module)); }
    syntax_source_release(value.source);
    if value.document is not null { entity_release(value.document); }
    *value = default;
}

export fn syntax_session_inputs_module(value: SyntaxSessionInputs*, source: u8*, module: FrontendModule*): void {
    if value.module is not null { return; }
    if module is not null && frontend_module_world(module) != value.world { return; }
    if !frontend_modules_bind_world(bits(ModuleEnvironment*, value.environment), value.world) { return; }
    if module is not null {
        value.module = bits(void*, module);
        value.owns_module = false;
    } else {
        value.module = bits(void*, frontend_module_root_world(value.world, source, bits(ModuleEnvironment*, value.environment)));
        value.owns_module = true;
    }
}

export fn syntax_session_inputs_source(value: SyntaxSessionInputs*, source: u8*, length: usize, name: u8*): bool {
    var prepared = syntax_source_create(name, source, length);
    if prepared is null { return false; }
    syntax_source_release(value.source);
    value.source = prepared;
    return true;
}

export fn syntax_session_inputs_reset(value: SyntaxSessionInputs*, source: u8*, length: usize,
mode: u32, module: FrontendModule*): bool {
    return syntax_session_inputs_reset_result(value, source, length, mode, module) == WorkBudgetError.None;
}

// Prepare the replacement before retiring old source/document/module ownership.
// The caller carries this per-call cause across progress reset and diagnostics.
export fn syntax_session_inputs_reset_result(value: SyntaxSessionInputs*, source: u8*, length: usize,
mode: u32, module: FrontendModule*): WorkBudgetError {
    if value == null || value.world == null || (source == null && length != 0)
        || length == ~convert(usize, 0) { return WorkBudgetError.Invalid; }
    if module is not null && frontend_module_world(module) != value.world { return WorkBudgetError.Invalid; }
    var environment = bits(ModuleEnvironment*, value.environment);
    var error = frontend_modules_bind_world_result(environment, value.world);
    if error != WorkBudgetError.None { return error; }
    var selected = module ?? bits(FrontendModule*, value.module);
    var replace_owned = value.owns_module && value.source != null
        && (module == null || bits(void*, module) == value.module);
    var name = mode == SyntaxSeedBaseline ? "bedrock.tower" : mode == SyntaxBedrockBaseline ? "foundation.tower" : "this file";
    if selected is not null { name = frontend_module_name(selected); }
    // Root creation uses this same immutable coordinator-owned entry name.
    // Prepare its bytes before publishing the replacement graph.
    if replace_owned { name = environment != null && environment.entry.length != 0 ? environment.entry.data : "input.tower"; }
    var prepared = syntax_source_create(name, source, length);
    if prepared is null { return WorkBudgetError.Memory; }
    defer syntax_source_release(prepared);
    var document = entity_create_result(compiler_world_store(value.world), &error);
    if document == null { return error; }
    defer { if document is not null { entity_release(document); } }
    var node = bits(SyntaxNode*, compiler_world_component_result(value.world, document, CompilerSyntax, &error));
    if node is null { return error; }
    node.kind = SyntaxDocument;
    var owns = value.owns_module;
    if module != null && bits(void*, module) != value.module { owns = false; }
    if replace_owned {
        selected = frontend_module_root_world_size_result(value.world, prepared.text.data, length, environment, &error);
        if selected == null { return error; }
    }
    if value.owns_module && value.module != bits(void*, selected) { frontend_module_destroy(bits(FrontendModule*, value.module)); }
    value.module = bits(void*, selected);
    value.owns_module = owns;
    syntax_source_release(value.source);
    value.source = prepared;
    prepared = null;
    if value.document is not null { entity_release(value.document); }
    value.document = document;
    document = null;
    return WorkBudgetError.None;
}
