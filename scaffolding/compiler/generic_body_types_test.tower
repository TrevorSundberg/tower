import library.testing;
import generic_body_types as copies;
import generic_registry_types as registry;
import .library.entity_types as entities;
import .library.entity_stage_types as stages;

// Clone requests and their fixtures share these nominal type declarations.
test() {
    var instance: registry.GenericInstance = default;
    var context: registry.GenericContext = { first: &instance, ..default };
    var node: entities.Entity = default;
    var stage: stages.EntityStage = { anchor: &node, ..default };
    var request: copies.GenericBodyCopy = { context: &context, node: &node, stage: &stage, ..default };
    assert(request.context.first == &instance, "Generic body copy lost its registry instance");
    assert(request.node == request.stage.anchor, "Generic body copy lost its stage anchor");
}
