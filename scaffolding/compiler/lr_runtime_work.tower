import tower;
import worker_policy;
import compiler_kernel;
import lr_runtime;
import lr_states;
import lr_analysis;
import lr_types;
import lr_work;
import parser_workers;
import .library.vector;
import .library.work_buffer;
import .library.work_buffer_types;
import .library.work_budget_types;
import .library.work_vector;
import .library.work_vector_types;
import .library.work_graph;
import .library.work_pool;

// Private derived table rows. Grammar entities remain authoritative; worker
// results publish in source-state order, including the first conflict.
struct LRRuntimeResult {
    row: LRRow*;
    state: LRRuntimeState;
    conflict: LRConflict;
    resource_error: WorkBudgetError;
    success: bool;
}

struct LRRuntimeTask {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    source: LRStates*;
    budget: WorkBudget*;
    results: LRRuntimeResult*;
    begin: usize;
    count: usize;
    success: bool;
}

var LRRuntimeGrain: usize = 128;

export fn compiler_lr_runtime_kernel(payload: void*): void {
    var task = bits(LRRuntimeTask*, payload);
    task.success = false;
    for(var i = task.begin; i < task.begin + task.count; i++) {
        var result = &task.results[i];
        var row = lr_row_create(task.budget, &result.resource_error);
        if row == null { return; }
        result.row = row;
        result.conflict.state = lr_none();
        var input = task.source.states.data[i];
        foreach(var &action in &input.actions) {
            if !lr_action_insert(&row.actions, task.budget, action, &result.resource_error) { return; }
        }
        lr_row_normalize(row, &result.conflict, i, task.source);
        if result.conflict.state == lr_none() {
            row.hash = lr_row_hash(row);
            if !lr_runtime_gotos(&result.state, input, task.source.analysis, task.budget, &result.resource_error) { return; }
        }
        result.success = true;
    }
    task.success = true;
}

// Hash interning is deterministic publication. Sorting, precedence/conflict
// checks and goto construction use private workers. Build direct lookup indexes
// only for retained unique rows, just as the serial constructor does.
export fn lr_runtime_create_parallel(source: LRStates*, anchor: void*): LRRuntime* {
    var error = WorkBudgetError.None;
    return lr_runtime_create_parallel_result(source, anchor, &error);
}

export fn lr_runtime_create_parallel_result(source: LRStates*, anchor: void*, error: WorkBudgetError*): LRRuntime* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if source == null || source.analysis == null { return null; }
    var capacity = compiler_worker_capacity(anchor);
    var count = source.states.length / LRRuntimeGrain;
    if count > capacity { count = capacity; }
    var budget = compiler_world_work_budget(compiler_node_world(anchor));
    if count < 2 || anchor == null { return lr_runtime_create_owned_result(source, budget, error); }
    return lr_runtime_create_work_result(source, anchor, count, error);
}

// Explicit executor width also exercises this ownership path with the serial
// instrumented transport. Production admission keeps its measured-size policy.
export fn lr_runtime_create_work(source: LRStates*, anchor: void*, count: usize): LRRuntime* {
    var error = WorkBudgetError.None;
    return lr_runtime_create_work_result(source, anchor, count, &error);
}

export fn lr_runtime_create_work_result(source: LRStates*, anchor: void*, count: usize, error: WorkBudgetError*): LRRuntime* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if source == null || source.analysis == null { return null; }
    var jobs: LRRuntimeTask*[WorkPoolMaximumCapacity];
    if count == 0 || count > sizeof(decltype(jobs)) / sizeof(LRRuntimeTask*)
        || count > source.states.length || anchor == null { return null; }
    var graph: WorkGraph;
    work_init(&graph, 1, 0);
    defer work_dispose(&graph);
    var admission: ParserAdmission = default;
    *error = parser_admission_open_result(&admission, anchor, count);
    if *error != WorkBudgetError.None { return null; }
    defer parser_admission_close(&admission, &graph);
    var budget = compiler_world_work_budget(compiler_node_world(anchor));
    var value = lr_runtime_open(budget, error);
    if value == null { return null; }
    defer lr_runtime_destroy(value);
    *error = work_vector_reserve_result(&value.rules, budget, source.analysis.rule_count);
    if *error == WorkBudgetError.None { *error = work_vector_reserve_result(&value.states, budget, source.states.length); }
    if *error == WorkBudgetError.None { *error = work_vector_reserve_result(&value.rows, budget, source.states.length); }
    if *error != WorkBudgetError.None { return null; }
    copy(value.rules.data, source.analysis.rules, source.analysis.rule_count * sizeof(LRProduction));
    value.rules.length = source.analysis.rule_count;
    fill(value.states.data, 0, source.states.length * sizeof(LRRuntimeState));
    value.states.length = source.states.length;
    // The result count is frozen before dispatch; this owner never grows.
    if source.states.length > ~convert(usize, 0) / sizeof(LRRuntimeResult) { *error = WorkBudgetError.Invalid; return null; }
    var result_bytes = source.states.length * sizeof(LRRuntimeResult);
    var result_storage: WorkBuffer = default;
    defer work_buffer_dispose(&result_storage);
    *error = work_buffer_resize(&result_storage, budget, result_bytes, 0);
    if *error != WorkBudgetError.None { return null; }
    var results = bits(LRRuntimeResult*, result_storage.data);
    fill(results, 0, result_bytes);
    defer {
        for(var i: usize = 0; i < source.states.length; i++) {
            if results[i].row != null { lr_row_destroy(results[i].row); }
            work_vector_dispose(&results[i].state.gotos);
        }
    }
    var buckets: work_vector(usize) = default;
    defer work_vector_dispose(&buckets);
    if source.states.length > (~convert(usize, 0) - 1) / 2 { *error = WorkBudgetError.Invalid; return null; }
    var bucket_count = source.states.length * 2 + 1;
    *error = work_vector_reserve_result(&buckets, budget, bucket_count);
    if *error != WorkBudgetError.None { return null; }
    buckets.length = bucket_count;
    fill(buckets.data, 255, buckets.length * sizeof(usize));
    var owner = entity_create_related_result(anchor, error);
    if owner == null { return null; }
    defer entity_release(owner);
    var kind = lr_work_node_result(owner, error);
    if kind == null { return null; }
    if !entity_register(kind, sizeof(LRRuntimeTask), alignof(LRRuntimeTask), 0) { *error = WorkBudgetError.Invalid; return null; }
    var workers: ParserWorkers = default;
    *error = parser_workers_open_result(&workers, anchor, count);
    if *error != WorkBudgetError.None { return null; }
    defer parser_workers_close(&workers);
    if count > workers.pool.count { count = workers.pool.count; }
    var position: usize = 0;
    for(var i: usize = 0; i < count; i++) {
        var node = lr_work_node_result(owner, error);
        if node == null { return null; }
        var job = bits(LRRuntimeTask*, entity_component_data(entity_component_add_result(node, kind, error)));
        if job == null { return null; }
        *job = default;
        job.kernel.kind = CompilerKernelKind.LRRuntime;
        job.kernel.payload = bits(void*, job);
        job.source = source;
        job.budget = budget;
        job.results = results;
        job.begin = position;
        job.count = source.states.length / count + (i < source.states.length % count ? 1 : 0);
        position += job.count;
        jobs[i] = job;
        var id = work_request(&graph, node, 1, convert(u64, job.begin));
        var ok = id != 0;
        ok &&= work_access(&graph, id, 1, 1, job.begin, job.count, WorkAccessMode.Write);
        ok &&= work_access(&graph, id, 1, 2, 0, 1, WorkAccessMode.Read);
        ok &&= work_seal(&graph, id);
        ok &&= work_demand(&graph, id);
        ok &&= work_take(&graph, &job.ticket);
        if !ok {
            *error = graph.resource_error != WorkBudgetError.None ? graph.resource_error : WorkBudgetError.Invalid;
            return null;
        }
    }
    var view = entity_view_open_result(owner, error);
    if view == null { return null; }
    *error = compiler_kernel_dispatch_admitted_result(workers.pool, &jobs[0], count, admission.extra);
    entity_view_close(view);
    if *error != WorkBudgetError.None { return null; }
    var ok = true;
    for(var i: usize = 0; i < count; i++) {
        if !work_finish(&graph, &jobs[i].ticket, jobs[i].success) { ok = false; }
    }
    if !ok { *error = graph.resource_error != WorkBudgetError.None ? graph.resource_error : WorkBudgetError.Invalid; return null; }
    // Consume each result in serial order. A later allocation failure cannot
    // replace an earlier grammar conflict; no partially built table escapes.
    for(var i: usize = 0; i < source.states.length; i++) {
        var result = &results[i];
        if !result.success {
            *error = result.resource_error != WorkBudgetError.None ? result.resource_error : WorkBudgetError.Invalid;
            return null;
        }
        if result.conflict.state != lr_none() {
            copy(&value.conflict, &result.conflict, sizeof(LRConflict));
            var published = value;
            value = null;
            return published;
        }
        var row = result.row;
        var bucket = row.hash % buckets.length;
        var existing = buckets.data[bucket];
        while existing != lr_none() {
            var other = value.rows.data[existing];
            if lr_row_equal(row, other) {
                lr_row_destroy(row);
                row = other;
                break;
            }
            existing = other.next;
        }
        if existing == lr_none() {
            if !lr_row_index(row, error) { return null; }
            *error = work_vector_push_result(&value.rows, budget, row);
            if *error != WorkBudgetError.None { return null; }
            row.next = buckets.data[bucket];
            buckets.data[bucket] = value.rows.length - 1;
        }
        result.row = null;
        var state = &value.states.data[i];
        state.row = row;
        work_vector_move(&state.gotos, &result.state.gotos);
    }
    var published = value;
    value = null;
    return published;
}
