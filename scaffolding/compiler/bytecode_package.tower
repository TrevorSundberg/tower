import tower;
import fast_interpreter;
import fast_interpreter_types;
import interpreter;
import .library.work_vector;
import .library.work_vector_types;
import .library.work_budget_types;

var BytecodeContainerVersion: u64 = 1;
var BytecodeSemanticsVersion: u64 = 9;
var BytecodeExecutionCacheVersion: u64 = 6;
var BytecodeHeaderSize: usize = 56;
var BytecodeSourceLimit: usize = 8388608;
var BytecodePackageLimit: usize = 268435456;

// .towerbc v1: portable, versioned distribution envelope. Canonical Foundation
// is the semantic authority; packed words/constants are a verified execution
// cache. A loader rebuilds the graph and checks the cache before any execution.
// This makes reconstruction exact without inventing a second type/binding ABI.
// All integer fields and payload words are little endian, regardless of host.
fn bc_read(data: u8*, at: usize, size: usize): u64 {
    var result: u64 = 0;
    var factor: u64 = 1;
    var i: usize = 0;
    loop {
        if i == size {
            return result;
        }
        var index = at + i;
        var byte = convert(u64, data[index]);
        byte = byte * factor;
        result = result | byte;
        factor = factor * 256;
        i++;
    }
}

fn bc_write(data: u8*, at: usize, value: u64, size: usize): void {
    var i: usize = 0;
    loop {
        if i == size {
            return;
        }
        var index = at + i;
        data[index] = im_byte(value);
        value = value / 256;
        i++;
    }
}

fn bc_checksum(data: u8*, length: usize): u64 {
    // FNV-1a detects corruption; it is not authentication. The cache comparison
    // against freshly checked Foundation, not this hash, validates instructions.
    var hash: u64 = 14695981039346656037;
    var i: usize = 0;
    loop {
        if i == length {
            return hash;
        }
        var byte: u64 = 0;
        var prefix = i < 48;
        var payload = i >= 56;
        if im_or(prefix, payload) {
            byte = convert(u64, data[i]);
        }
        hash = hash ^ byte;
        hash = hash * 1099511628211;
        i++;
    }
}

export fn bytecode_validate(data: u8*, length: usize): u32 {
    if data == null || length < BytecodeHeaderSize {
        return 1;
    }
    if length > BytecodePackageLimit {
        return 1;
    }
    var magic = "TOWERBC";
    for(var i: usize = 0; i != 8; i++) {
        if data[i] != magic[i] {
            return 2;
        }
    }
    var version = bc_read(data, 8, 4) != BytecodeContainerVersion;
    if version {
        return 3;
    }
    version = bc_read(data, 12, 4) != BytecodeSemanticsVersion;
    if version {
        return 4;
    }
    version = bc_read(data, 16, 4) != BytecodeExecutionCacheVersion;
    if version {
        return 5;
    }
    var width = bc_read(data, 20, 4);
    var invalid = width != 4;
    var not64 = width != 8;
    invalid = im_and(invalid, not64);
    if invalid {
        return 6;
    }
    invalid = bc_read(data, 24, 4) > 2;
    if invalid {
        return 7;
    }
    invalid = bc_read(data, 44, 4) != 0;
    if invalid {
        return 7;
    }
    var source = bc_read(data, 28, 4);
    invalid = source > 8388608;
    if invalid {
        return 1;
    }
    var words = bc_read(data, 32, 4);
    words = words * 4;
    var constants = bc_read(data, 36, 4);
    constants = constants * 8;
    var total = source + words;
    total = total + constants;
    total = total + 56;
    invalid = total != convert(u64, length);
    if invalid {
        return 1;
    }
    invalid = bc_read(data, 40, 4) != total;
    if invalid {
        return 1;
    }
    var checksum = bc_checksum(data, length);
    invalid = bc_read(data, 48, 8) != checksum;
    if invalid {
        return 8;
    }
    return 0;
}

export fn bytecode_error(code: u32): u8* {
    var selected = code == 1;
    if selected {
        return "Invalid .towerbc length or section bounds";
    }
    selected = code == 2;
    if selected {
        return "Invalid .towerbc magic";
    }
    selected = code == 3;
    if selected {
        return "Unsupported .towerbc container version";
    }
    selected = code == 4;
    if selected {
        return "Unsupported .towerbc semantics version";
    }
    selected = code == 5;
    if selected {
        return "Unsupported .towerbc cache version";
    }
    selected = code == 6;
    if selected {
        return "Unsupported .towerbc target layout";
    }
    selected = code == 7;
    if selected {
        return "Unsupported .towerbc optimization profile or flags";
    }
    selected = code == 8;
    if selected {
        return ".towerbc checksum mismatch";
    }
    return ".towerbc cache disagrees with checked Foundation";
}

export fn bytecode_source_size(data: u8*): usize {
    return convert(usize, bc_read(data, 28, 4));
}

export fn bytecode_pointer_bytes(data: u8*): usize {
    return convert(usize, bc_read(data, 20, 4));
}

export fn bytecode_encode(f: FMState*, source: u8*, source_size: usize, width: usize, profile: u32, output: work_vector(u8)*): WorkBudgetError {

    if f == null || output == null || (source_size != 0 && source == null) || profile > 2 || (width != 4 && width != 8) || source_size > BytecodeSourceLimit {
        return WorkBudgetError.Invalid;
    }
    if f.error != WorkBudgetError.None { return f.error; }
    if f.pointer_bytes != width {
        return WorkBudgetError.Invalid;
    }
    // Bound each section before multiplying or adding, including on 32-bit hosts.
    var remaining = BytecodePackageLimit - BytecodeHeaderSize - source_size;
    if f.words.length > remaining / 4 { return WorkBudgetError.Invalid; }
    var words = f.words.length *4;
    remaining -= words;
    if f.constants.length > remaining / 8 { return WorkBudgetError.Invalid; }
    var constants = f.constants.length *8;
    var total = source_size + words;
    total = total + constants;
    total += BytecodeHeaderSize;
    var next: work_vector(u8) = default;
    defer work_vector_dispose(&next);
    var result = work_vector_reserve_result(&next, f.budget, total);
    if result != WorkBudgetError.None { return result; }
    var data = next.data;
    fill(data, 0, BytecodeHeaderSize);
    copy(data, "TOWERBC", 8);
    bc_write(data, 8, BytecodeContainerVersion, 4);
    bc_write(data, 12, BytecodeSemanticsVersion, 4);
    bc_write(data, 16, BytecodeExecutionCacheVersion, 4);
    bc_write(data, 20, convert(u64, width), 4);
    bc_write(data, 24, convert(u64, profile), 4);
    bc_write(data, 28, convert(u64, source_size), 4);
    bc_write(data, 32, convert(u64, f.words.length), 4);
    bc_write(data, 36, convert(u64, f.constants.length), 4);
    bc_write(data, 40, convert(u64, total), 4);
    if source_size != 0 { copy(data + BytecodeHeaderSize, source, source_size); }
    var at = source_size + BytecodeHeaderSize;
    var i: usize = 0;
    for(; i != f.words.length; i++) {
        bc_write(data, at, convert(u64, f.words.data[i]), 4);
        at = at + 4;
    }
    i = 0;
    for(; i != f.constants.length; i++) {
        bc_write(data, at, f.constants.data[i], 8);
        at = at + 8;
    }
    bc_write(data, 48, bc_checksum(data, total), 8);
    next.length = total;
    if bytecode_validate(data, total) != 0 || bytecode_pointer_bytes(data) != width
        || bc_read(data, 24, 4) != convert(u64, profile) || !bytecode_matches(f, data) {
        return WorkBudgetError.Invalid;
    }
    work_vector_move(output, &next);
    return WorkBudgetError.None;
}

export fn bytecode_matches(f: FMState*, data: u8*): bool {
    var different = bc_read(data, 32, 4) != convert(u64, f.words.length);
    if different {
        return false;
    }
    different = bc_read(data, 36, 4) != convert(u64, f.constants.length);
    if different {
        return false;
    }
    var at = bytecode_source_size(data);
    at = at + 56;
    var i: usize = 0;
    for(; i != f.words.length; i++) {
        different = bc_read(data, at, 4) != convert(u64, f.words.data[i]);
        if different {
            return false;
        }
        at = at + 4;
    }
    i = 0;
    loop {
        if i == f.constants.length {
            return true;
        }
        different = bc_read(data, at, 8) != f.constants.data[i];
        if different {
            return false;
        }
        at = at + 8;
        i++;
    }
}
