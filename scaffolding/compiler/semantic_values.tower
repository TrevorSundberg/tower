import tower;
import foundation_tags;
import foundation_types;
import semantic_context;
import semantic_definitions;
import semantic_enums;
import semantic_layout;
import semantic_modules;
import semantic_statements;
import semantic_support;
import semantic_types;
import semantic_expressions;
import semantic_call_inference;
import semantic_evaluation;
import semantic_declarations;
import .library.vector;
import .library.work_graph;

// Semantic compiler over shared Foundation components.
// Temporary indexes and scratch allocations are scoped to one compilation.

fn sem_location_base(c: SemanticContext*, n: void*, depth: u32): void* {
    n = sem_surface_unwrap(n);
    if sem_is(n, "CoreLocation") {
        return sem_location(c, n, depth);
    }
    if sem_is(n, "TowerExpression") && sem_member(n, "left") == null
    && sem_member(n, "right") != null && sem_equal(sem_tokens(c, sem_child(n, 0)), "*") {
        return sem_surface_place(c, n);
    }
    return sem_operand(c, n, null);
}

fn sem_location(c: SemanticContext*, n: void*, depth: u32): void* {
    loop {
        if !((sem_is(n, "CoreCallArgument") || sem_is(n, "CoreOperand")) && sem_child_count(n) == 1) {
            break;
        }
        n = sem_child(n, 0);
    }
    if sem_is(n, "CorePointerArgument") {
        sem_node(c, n, KOperand());
        sem_fail(c, n, "Expected a value argument, got a type spelling");
        return n;
    }
    if depth > 128 {
        sem_node(c, n, KOperand());
        sem_fail(c, n, "Foundation field path limit is 128");
        return n;
    }
    if sem_get(n) != null {
        return n;
    }
    var module = sem_namespace(c, n);
    if module != null {
        if sem_editor_symbol(c, n, 1) {
            sem_node(c, n, KOperand());
            return n;
        }
        var name = sem_identifier(c, sem_member(n, "field"));
        var value = sem_node(c, n, KOperand());
        value.binding = sem_owned(c.globals, module, name);
        if value.binding != null {
            sem_declaration_type(c, value.binding);
            var declaration = sem_get(value.binding);
            sem_set_type(&value.type, &declaration.type);
        } else {
            sem_fail(c, n, sem_cat(c, "Unknown module variable '", sem_cat(c, name, "'")));
        }
        return n;
    }
    if sem_enum_operand(c, n) {
        sem_fail(c, n, "An enum member is a value, not an addressable location");
        return n;
    }
    if !(sem_is(n, "CoreLocation") || sem_is(n, "TowerNullAccess")) || sem_member(n, "base") == null {
        var name: void* = n;
        if sem_is(n, "CoreLocation") {
            name = sem_member(n, "name");
        }
        if name == null {
            sem_fail(c, n, "Malformed CoreLocation tree: missing capture 'name'");
            return n;
        }
        var value: FoundationNode* = sem_node(c, n, KOperand());
        var step24 = sem_lookup(c, name);
        value.binding = step24;
        if value.binding != null {
            var step26 = sem_get(value.binding);
            sem_set_type(&value.type, &step26.type);
        }
        return n;
    }
    var index: void* = sem_member(n, "index");
    if index != null {
        var value: FoundationNode* = sem_node(c, n, KIndex());
        var step30 = sem_member(n, "base");
        var step31 = depth + 1;
        var step32: void* = null;
        if sem_is(n, "TowerNullAccess") {
            step32 = sem_surface_nullable(c, step30, null);
        }
        else {
            step32 = sem_location_base(c, step30, step31);
        }
        value.left = step32;
        if !sem_ok(c) {
            return n;
        }
        var step35 = sem_get(value.left);
        var parent: FoundationType* = sem_type_copy(c, &step35.type);
        var step37 = parent.pointers != 0;
        value.indirect = step37;
        if parent.pointers != 0 {
            parent.pointers--;
            sem_set_type(&value.type, parent);
        } else {
            if parent.scalar == SArray() {
                var step40 = sem_get(parent.record);
                sem_set_type(&value.type, &step40.element);
            } else {
                sem_fail(c, n, "Indexing requires a pointer or an array");
                return n;
            }
        }
        // Index scaling consumes the published layout during lowering/execution.
        // Type checking needs only to reject void; aggregates always have storage.
        if !semantic_aggregate(&value.type) && semantic_size(&value.type) == 0 {
            sem_fail(c, n, "Cannot index a void pointer");
            return n;
        }
        var expected_type: FoundationType* = null;
        if sem_editor_contains(c, index) {
            c.editor.require_integer = true;
        }
        if sem_literal(c, index) {
            expected_type = sem_type_new(c, SUSize(), 0, null);
        }
        var step46 = sem_operand(c, index, expected_type);
        value.right = step46;
        if !sem_ok(c) {
            return n;
        }
        var step49 = sem_get(value.right);
        var step50 = semantic_integer(&step49.type);
        if semantic_enum(&step49.type) {
            step50 = false;
        }
        if !step50 {
            sem_fail(c, index, "An index must be an integer");
        }
        return n;
    }
    if !sem_shape(c, n, "base") || !sem_shape(c, n, "field") {
        return n;
    }
    var value: FoundationNode* = sem_node(c, n, KField());
    var step59 = sem_member(n, "base");
    var step60 = depth + 1;
    var step61: void* = null;
    if sem_is(n, "TowerNullAccess") {
        step61 = sem_surface_nullable(c, step59, null);
    }
    else {
        step61 = sem_location_base(c, step59, step60);
    }
    value.left = step61;
    if !sem_ok(c) {
        return n;
    }
    var step64 = sem_get(value.left);
    var parent: FoundationType* = &step64.type;
    var step65 = sem_member(n, "field");
    if sem_editor_capture(c, step65, 3, parent) {
        return n;
    }
    var step66 = sem_identifier(c, step65);
    sem_set_name(value, step66);
    var step67 = parent.pointers == 1;
    value.indirect = step67;
    if parent.scalar != SStruct() || parent.pointers > 1 {
        sem_fail(c, n, "Field access requires a struct or a single pointer to a struct");
        return n;
    }
    sem_layout(c, parent.record);
    if !sem_ok(c) {
        return n;
    }
    var step74 = sem_get(parent.record);
    var fields: vector(void*)* = &step74.items;
    foreach(var field in fields) {
        if sem_equal(sem_name(sem_get(field)), sem_name(value)) {
            value.binding = field;
        }
    }
    if value.binding == null {
        var step82 = sem_name(value);
        var step84 = sem_cat(c, sem_cat(c, "Unknown field '", step82), "' in '");
        var step87 = sem_cat(c, sem_name(sem_get(parent.record)), "'");
        sem_fail(c, n, sem_cat(c, step84, step87));
        return n;
    }
    var step89 = sem_get(value.binding);
    sem_set_type(&value.type, &step89.type);
    var step90 = sem_get(value.binding);
    value.byte_offset = step90.byte_offset;
    return n;
}

fn sem_operand(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    if sem_editor_contains(c, n) {
        c.editor.value_required = true;
        c.editor.has_expected = expected_type != null;
        if c.editor.has_expected {
            sem_set_type(&c.editor.type, expected_type);
        }
    }
    if n == null {
        sem_fail(c, n, "Missing operand");
        return null;
    }
    c.value_depth++;
    var result: void* = sem_operand_impl(c, n, expected_type);
    c.value_depth--;
    return result;
}

// A decltype place borrows its existing type; it does not copy aggregate storage.
// Only the query's complete operand receives this allowance. An aggregate
// nested inside an operator/call still passes the ordinary value restrictions.
fn sem_type_place(c: SemanticContext*, node: void*, value: FoundationNode*): bool {
    if !c.unevaluated || c.type_query_operand != node { return false; }
    return value.kind == KOperand() || value.kind == KField()
        || value.kind == KIndex() || value.kind == KLoad();
}

fn sem_operand_impl(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    if c.value_depth > 128 {
        sem_fail(c, n, "Foundation expression nesting limit is 128");
        return n;
    }
    n = sem_surface_unwrap(n);
    if sem_is(n, "TowerComptime") { return sem_comptime(c, n, expected_type); }
    if sem_is(n, "TowerNullAccess") {
        var result = sem_surface_nullable(c, n, expected_type);
        if sem_ok(c) {
            var value = sem_get(result);
            if value.type.pointers == 0 {
                sem_fail(c, n, "A null-conditional scalar result must be consumed with ??; nullable scalar storage is not supported");
            } else {
                sem_surface_expected(c, result, expected_type);
            }
        }
        return result;
    }
    var surface = sem_is(n, "TowerExpression");
    surface ||= sem_is(n, "TowerComma");
    if surface {
        var result = sem_surface(c, n, expected_type);
        if sem_ok(c) {
            var value = sem_get(result);
            if semantic_aggregate(&value.type) && !sem_type_place(c, result, value) {
                sem_fail(c, n, "Struct values require field access or a pointer; aggregate copies are not implemented");
            }
        }
        return result;
    }
    return sem_operand_leaf(c, n, expected_type);
}

fn sem_operand_leaf(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    if c.value_depth > 128 {
        sem_fail(c, n, "Foundation expression nesting limit is 128");
        return n;
    }
    loop {
        if !((sem_is(n, "CoreCallArgument") || sem_is(n, "CoreOperand")) && sem_child_count(n) == 1) {
            break;
        }
        n = sem_child(n, 0);
    }
    var step11 = sem_is(n, "CoreCall");
    if sem_editor_contains(c, n) {
        if c.editor.has_expected {
            if sem_is(n, "CoreAddress") {
                if c.editor.type.pointers != 0 {
                    c.editor.type.pointers--;
                }
            }
            if sem_is(n, "CoreLoad") {
                c.editor.type.pointers++;
            }
        }
    }
    if step11 {
        if sem_get(n) == null && sem_call(c, n) == null || !sem_ok(c) {
            return n;
        }
        var v: FoundationNode* = sem_get(n);
        if v.type.pointers == 0 && v.type.scalar == SVoid() {
            sem_fail(c, n, "A void call cannot be used as a value");
            return n;
        }
    } else {
        if sem_is(n, "CoreAddress") || sem_is(n, "CoreLoad") {
            if !sem_shape(c, n, "name") {
                return n;
            }
            var address: bool = sem_is(n, "CoreAddress");
            var kind: u32 = 8;
            if address {
                kind = KAddress();
            }
            var value: FoundationNode* = sem_node(c, n, kind);
            if address {
                var step33 = sem_member(n, "name");
                var step34 = sem_location(c, step33, 0);
                value.value = step34;
            } else {
                var step35 = sem_member(n, "name");
                var load_expected: FoundationType* = null;
                if sem_editor_contains(c, step35) {
                    c.editor.require_pointer = true;
                    if c.editor.has_expected {
                        load_expected = &c.editor.type;
                    }
                }
                var step36 = sem_operand(c, step35, load_expected);
                value.value = step36;
            }
            if !sem_ok(c) {
                return n;
            }
            var step39 = sem_get(value.value);
            sem_set_type(&value.type, &step39.type);
            if address {
                value.type.pointers++;
            } else {
                if value.type.pointers == 0 {
                    sem_fail(c, n, "Load requires a pointer");
                    return n;
                } else {
                    value.type.pointers--;
                }
            }
        } else {
            if !sem_literal(c, n) {
                if !sem_enum_operand(c, n) {
                    n = sem_location(c, n, 0);
                }
            }
        }
    }
    if !sem_ok(c) {
        return n;
    }
    var value: FoundationNode* = sem_get(n);
    if value == null {
        value = sem_node(c, n, KOperand());
    }
    var text: u8* = sem_tokens(c, n);
    if sem_literal(c, n) {
        var nominal = expected_type != null;
        nominal &&= expected_type.pointers == 0;
        nominal &&= semantic_enum(expected_type);
        if nominal {
            sem_fail(c, n, "Enum values require a named member or an explicit conversion");
            return n;
        }
        value.constant = true;
        if sem_equal(text, "true") || sem_equal(text, "false") {
            var step55 = sem_type_new(c, SBool(), 0, null);
            sem_set_type(&value.type, step55);
            var step56 = sem_equal(text, "true");
            var step57 = convert(u64, step56);
            value.bits = step57;
        } else {
            if sem_equal(text, "null") {
                if expected_type != null {
                    sem_set_type(&value.type, expected_type);
                } else {
                    var step60 = sem_type_new(c, SVoid(), 1, null);
                    sem_set_type(&value.type, step60);
                }
                value.bits = 0;
                if value.type.pointers == 0 {
                    sem_fail(c, n, "null requires a pointer type");
                }
            } else {
                if text[0] == 39 || text[0] == 34 {
                    value.kind = KString();
                    var step66 = sem_type_new(c, SU8(), 1, null);
                    sem_set_type(&value.type, step66);
                    var i: usize = 1;
                    var length: usize = sem_length(text);
                    loop {
                        if !(i + 1 < length) {
                            break;
                        }
                        var byte: u8 = text[i];
                        if byte == 92 && i + 2 < length {
                            i++;
                            byte = text[i];
                            if byte == 110 {
                                byte = 10;
                            } else {
                                if byte == 114 {
                                    byte = 13;
                                } else {
                                    if byte == 116 {
                                        byte = 9;
                                    }
                                }
                            }
                        }
                        sem_require(foundation_name_append(&value.name, byte));
                        i++;
                    }
                } else {
                    if expected_type != null {
                        sem_set_type(&value.type, expected_type);
                    } else {
                        var step80 = sem_type_new(c, SI32(), 0, null);
                        sem_set_type(&value.type, step80);
                    }
                    if !semantic_integer(&value.type) {
                        sem_fail(c, n, "An integer literal needs an integer type");
                        return n;
                    }
                    var negative: bool = text[0] == 45;
                    var number: u64 = 0;
                    var i: usize = 0;
                    if negative {
                        i = 1;
                    }
                    var length: usize = sem_length(text);
                    var maximum: u64 = 0;
                    maximum--;
                    for(; i < length; i++) {
                        var digit: u64 = convert(u64, text[i]);
                        digit = digit - 48;
                        var step89 = digit > 9;
                        if !step89 {
                            var step92 =(maximum -digit) / 10;
                            step89 = number > step92;
                        }
                        if step89 {
                            sem_fail(c, n, "Integer literal out of range");
                            break;
                        }
                        number = number * 10 + digit;
                    }
                    var mask: u64 = semantic_mask(&value.type);
                    var limit: u64 = mask;
                    var signed: bool = semantic_signed(&value.type);
                    if signed {
                        limit = mask / 2;
                        if negative {
                            limit++;
                        }
                    }
                    if number > limit || negative && !signed {
                        var step104 = sem_type_name(c, &value.type);
                        var step105 = sem_cat(c, "Integer literal out of range for ", step104);
                        sem_fail(c, n, step105);
                    }
                    if negative {
                        var negated: u64 = 0;
                        number = negated - number;
                    }
                    var step107 = number &mask;
                    value.bits = step107;
                }
            }
        }
    }
    if semantic_aggregate(&value.type) && !sem_type_place(c, n, value) {
        sem_fail(c, n, "Struct values require field access or a pointer; aggregate copies are not implemented");
    }
    if expected_type != null && !semantic_type_equal(&value.type, expected_type) {
        var step113 = sem_type_name(c, expected_type);
        var step114 = sem_cat(c, "Expected ", step113);
        var step115 = sem_cat(c, step114, ", got ");
        var step116 = sem_type_name(c, &value.type);
        var step117 = sem_cat(c, step116, "; use an explicit conversion");
        var step118 = sem_cat(c, step115, step117);
        sem_fail(c, n, step118);
    }
    return n;
}

fn sem_builtin(c: SemanticContext*, n: void*, kind: u32, args: vector(void*)*): void* {
    var label = kind == 31;
    var jump = kind == 32;
    if label {
        sem_fail(c, n, "label is only valid as a function-body statement");
        return n;
    }
    if jump {
        sem_fail(c, n, "jump is only valid as a function-body statement");
        return n;
    }
    var value: FoundationNode* = sem_node(c, n, kind);
    var step2 = sem_type_new(c, SVoid(), 0, null);
    sem_set_type(&value.type, step2);
    // Observe the argument at the editor hole even when later arguments have
    // not been written. Resolution still uses the ordinary type/value helpers.
    if sem_editor_contains(c, n) {
        for(var index: usize = 0; index != args.length; index++) {
            var argument = args.data[index];
            if sem_editor_contains(c, argument) {
                var type_argument = semantic_builtin_type_argument(kind, index);
                if type_argument {
                    sem_type(c, argument);
                } else {
                    var expected_type: FoundationType* = null;
                    var last = semantic_builtin_arity(kind);
                    last--;
                    var size_argument = kind == KAllocate();
                    if kind == KReallocate() {
                        size_argument = true;
                    }
                    if kind == KCopy() {
                        size_argument = true;
                    }
                    if kind == KFill() {
                        size_argument = true;
                    }
                    if index != last {
                        size_argument = false;
                    }
                    if size_argument {
                        expected_type = sem_type_new(c, SUSize(), 0, null);
                    }
                    if kind == KFree() {
                        c.editor.require_pointer = true;
                    }
                    if kind == KCopy() {
                        if index < 2 {
                            c.editor.require_pointer = true;
                        }
                    }
                    if kind == KFill() {
                        if index == 0 {
                            c.editor.require_pointer = true;
                        }
                        if index == 1 {
                            expected_type = sem_type_new(c, SU8(), 0, null);
                        }
                    }
                    if kind == KReallocate() {
                        if index == 1 {
                            expected_type = sem_type(c, args.data[0]);
                            expected_type.pointers++;
                        }
                    }
                    if kind == KTrap() {
                        if index == 0 {
                            expected_type = sem_type_new(c, SU8(), 1, null);
                        } else {
                            expected_type = sem_type_new(c, SU32(), 0, null);
                        }
                    }
                    sem_operand(c, argument, expected_type);
                }
                return n;
            }
        }
    }
    var count: usize = semantic_builtin_arity(kind);
    if args.length != count {
        var step5 = semantic_builtin_name(kind);
        var step7 = sem_cat(c, sem_cat(c, "Wrong argument count for '", step5), "': expected ");
        var step9 = sem_decimal(c, convert(u64, count));
        sem_fail(c, n, sem_cat(c, step7, step9));
        return n;
    }
    var step11 = sem_type_new(c, SUSize(), 0, null);
    if kind == KTrap() {
        value.left = sem_operand(c, args.data[0], sem_type_new(c, SU8(), 1, null));
        value.right = sem_operand(c, args.data[1], sem_type_new(c, SU32(), 0, null));
        return n;
    }
    var size: FoundationType* = step11;
    var byte: FoundationType* = sem_type_new(c, SU8(), 0, null);
    if kind == KPrint() {
        var step14 = sem_operand(c, args.data[0], null);
        value.value = step14;
    } else {
        if kind == KFree() || kind == KCopy() || kind == KFill() {
            var step21 = sem_operand(c, args.data[0], null);
            value.left = step21;
            if !sem_ok(c) {
                return n;
            }
            var step24 = sem_get(value.left);
            if step24.type.pointers == 0 {
                sem_fail(c, n, "Memory operations require a pointer");
            }
            if kind != KFree() {
                var step27 = sem_operand(c, args.data[2], size);
                value.value = step27;
                var expected_type: FoundationType* = null;
                if kind == KFill() {
                    expected_type = byte;
                }
                var step29 = sem_operand(c, args.data[1], expected_type);
                value.right = step29;
                if !sem_ok(c) {
                    return n;
                }
                var step33 = kind == KCopy();
                if step33 {
                    var step34 = sem_get(value.right);
                    step33 = step34.type.pointers == 0;
                }
                if step33 {
                    sem_fail(c, n, "copy requires source and destination pointers");
                }
            }
        } else {
            if kind == KSizeOf() || kind == KAlignOf() {
                var step40 = sem_type(c, args.data[0]);
                sem_set_type(&value.element, step40);
                // The result type is usize without consulting the operand's
                // byte layout. Layout queries run after declarations publish;
                // the ordinary interpreter/backend reads that result later.
                sem_set_type(&value.type, size);
            } else {
                if kind == KAllocate() || kind == KReallocate() {
                    var step46 = sem_type(c, args.data[0]);
                    sem_set_type(&value.element, step46);
                    if !semantic_aggregate(&value.element) && semantic_size(&value.element) == 0 {
                        sem_fail(c, n, "Cannot allocate void elements");
                        return n;
                    }
                    sem_set_type(&value.type, &value.element);
                    value.type.pointers++;
                    var step50 = args.length -1;
                    var step51 = sem_operand(c, args.data[step50], size);
                    value.right = step51;
                    if kind == KReallocate() {
                        var step53 = sem_operand(c, args.data[1], &value.type);
                        value.left = step53;
                    }
                } else {
                    if kind == KConvert() || kind == KBits() {
                        var step58 = sem_type(c, args.data[0]);
                        sem_set_type(&value.type, step58);
                        var step59 = sem_operand(c, args.data[1], null);
                        value.value = step59;
                        if !sem_ok(c) {
                            return n;
                        }
                        var step62 = sem_get(value.value);
                        var source: FoundationType* = &step62.type;
                        if semantic_aggregate(&value.type) || value.type.pointers == 0 && value.type.scalar == SVoid() {
                            sem_fail(c, n, "Conversion requires scalar values");
                        }
                        if kind == KConvert() &&(value.type.pointers != 0 || source.pointers != 0) {
                            sem_fail(c, n, "Pointer reinterpretation requires bits");
                        }
                        var step76 = kind == KBits();
                        if step76 {
                            var step77 = semantic_width(&value.type);
                            var step78 = semantic_width(source);
                            step76 = step77 != step78 || !semantic_integer(&value.type) && value.type.pointers == 0 || !semantic_integer(source) && source.pointers == 0;
                        }
                        if step76 {
                            sem_fail(c, n, "bits requires equal-width integers or pointers");
                        }
                    } else {
                        sem_fail(c, n, "Unsupported foundation builtin");
                    }
                }
            }
        }
    }
    return n;
}

// Prepared generic calls retain their ordinary instance and argument syntax on
// the call entity. They are compilation-local continuations, not another IR.
struct SemanticPreparedCall {
    instance: void*;
    values: vector(void*)*;
}

fn sem_prepared_call(c: SemanticContext*, node: void*): SemanticPreparedCall* {
    if c.prepared_calls == null { return null; }
    return bits(SemanticPreparedCall*, entity_component_data(entity_component_get(node, c.prepared_calls)));
}

fn sem_call_arguments(c: SemanticContext*, definition: void*, use: void*, args: vector(void*)*, values: vector(void*)*): vector(void*)* {
    var count = generic_parameter_count(c.generics, definition);
    var runtime: usize = 0;
    for(var i: usize = 0; i < count; i++) {
        if !generic_type_parameter(c.generics, definition, i) { runtime++; }
    }
    var arguments = sem_list(c);
    if args.length == count {
        for(var i: usize = 0; i < count && sem_ok(c); i++) {
            if generic_type_parameter(c.generics, definition, i) {
                sem_push(arguments, sem_type_entity(c, sem_type(c, args.data[i])));
            } else { sem_push(values, args.data[i]); }
        }
    } else {
        if args.length == runtime {
            foreach(var argument in args) { sem_push(values, argument); }
            arguments = sem_infer_arguments(c, definition, use, values);
        } else {
            var name = sem_identifier(c, sem_member(use, "name"));
            sem_fail(c, use, sem_cat(c, "Wrong argument count for template '", sem_cat(c, name, "'")));
        }
    }
    return arguments;
}

fn sem_call_instance(c: SemanticContext*, definition: void*, use: void*, arguments: vector(void*)*): void* {
    var instance = generic_instantiate(c.generics, definition, use, arguments.data, arguments.length);
    if !sem_generic_ok(c, use) || instance == null {
        return null;
    }
    sem_state(c, c.source_bases, instance).number = sem_source_base(c, definition);
    return instance;
}

fn sem_call_specialization(c: SemanticContext*, definition: void*, use: void*, arguments: vector(void*)*): void* {
    var instance = sem_call_instance(c, definition, use, arguments);
    if instance == null { return null; }
    if sem_get(instance) == null {
        sem_header(c, instance, sem_instance_name(c, definition, arguments), definition);
        if !sem_ok(c) {
            return null;
        }
        sem_push(&c.generated, instance);
    }
    return instance;
}

// The coordinator publishes a nominal instance and parameter scopes, then
// requests their existing declaration queries. No return/parameter type is
// forced here; the consumer suspends until the signature receipt is ready.
fn sem_prepare_call(c: SemanticContext*, use: void*): SemanticPreparedCall* {
    var prepared = sem_prepared_call(c, use);
    if prepared != null { return prepared; }
    var name = sem_member(use, "name");
    var definition = sem_resolve(c, c.templates, name, sem_identifier(c, name));
    sem_require(definition != null && c.declaration_subjects != null);
    var values = sem_list(c);
    var arguments = sem_call_arguments(c, definition, use, sem_collect(c, sem_member(use, "args"), "CoreCallArgument"), values);
    if !sem_ok(c) { return null; }
    var instance = sem_call_instance(c, definition, use, arguments);
    if instance == null { return null; }
    if sem_get(instance) == null {
        sem_function_declare(c, instance, sem_instance_name(c, definition, arguments));
        if !sem_ok(c) { return null; }
        sem_parameters(c, instance, definition);
        if !sem_ok(c) { return null; }
        sem_push(&c.generated, instance);
        sem_declaration_add(c, instance);
        foreach(var parameter in &sem_get(instance).parameters) { sem_declaration_add(c, parameter); }
        sem_declaration_discover(c);
        if !sem_ok(c) { return null; }
    }
    if c.prepared_calls == null {
        c.prepared_calls = sem_create(c.program.root);
        sem_require(entity_register(c.prepared_calls, sizeof(SemanticPreparedCall), alignof(SemanticPreparedCall), 0));
    }
    prepared = bits(SemanticPreparedCall*, entity_component_data(entity_component_add(use, c.prepared_calls)));
    sem_require(prepared != null);
    prepared.instance = instance;
    prepared.values = values;
    return prepared;
}

fn sem_call(c: SemanticContext*, n: void*): void* {
    if sem_editor_symbol(c, sem_member(n, "name"), 4) {
        sem_node(c, n, KCall());
        return n;
    }
    if !sem_shape(c, n, "name") {
        return null;
    }
    var step3 = sem_member(n, "name");
    var name: u8* = sem_identifier(c, step3);
    var step5 = sem_member(n, "args");
    var args: vector(void*)* = sem_collect(c, step5, "CoreCallArgument");
    var builtin: u32 = semantic_builtin_kind(name);
    if builtin != 0 {
        return sem_builtin(c, n, builtin, args);
    }
    if sem_resolve(c, c.type_functions, step3, name) != null {
        var step12 = sem_cat(c, "Type constructor '", name);
        var step13 = sem_cat(c, step12, "' produces a type, not a runtime value");
        sem_fail(c, n, step13);
        return n;
    }
    var definition: void* = sem_resolve(c, c.templates, step3, name);
    if definition != null {
        var prepared = sem_prepared_call(c, n);
        var values = sem_list(c);
        var instance: void* = null;
        if prepared != null {
            instance = prepared.instance;
            values = prepared.values;
            var query = sem_declaration_query(c, instance);
            sem_require(query == 0 || work_task(&c.queries, query).state == WorkState.Succeeded);
        } else {
            var arguments = sem_call_arguments(c, definition, n, args, values);
            if !sem_ok(c) { return n; }
            instance = sem_call_specialization(c, definition, n, arguments);
        }
        if !sem_ok(c) || instance == null {
            return n;
        }
        var value: FoundationNode* = sem_node(c, n, KCall());
        var callee: FoundationNode* = sem_get(instance);
        value.binding = instance;
        sem_set_type(&value.type, &callee.type);
        for(var i: usize = 0; i < values.length && sem_ok(c); i++) {
            sem_push(&value.items, sem_operand(c, values.data[i], &sem_get(callee.parameters.data[i]).type));
        }
        return n;
    }
    var value: FoundationNode* = sem_node(c, n, KCall());
    var step49 = sem_resolve(c, c.functions, step3, name);
    value.binding = step49;
    if value.binding == null {
        var step51 = sem_cat(c, "Unknown function '", name);
        var step52 = sem_cat(c, step51, "'");
        sem_fail(c, n, step52);
        return n;
    }
    var callee: FoundationNode* = sem_get(value.binding);
    sem_set_type(&value.type, &callee.type);
    var step54 = args.length != callee.parameters.length;
    // A completion snapshot may end before later arguments have been written.
    // Resolve every present argument using the real signature nonetheless.
    if sem_editor_contains(c, n) {
        step54 = args.length > callee.parameters.length;
    }
    if step54 {
        var step55 = sem_cat(c, "Wrong argument count for '", name);
        var step56 = sem_cat(c, step55, "'");
        sem_fail(c, n, step56);
        return n;
    }
    var i: usize = 0;
    for(; i < args.length; i++) {
        var step59 = sem_get(callee.parameters.data[i]);
        var step60 = sem_operand(c, args.data[i], &step59.type);
        sem_push(&value.items, step60);
    }
    return n;
}

fn sem_expression(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    if sem_is(n, "CoreValue") && sem_child_count(n) == 1 {
        n = sem_child(n, 0);
    }
    var kind: u8* = sem_label(n);
    if sem_equal(kind, "CoreOperand") || sem_equal(kind, "CoreAddress") || sem_equal(kind, "CoreLoad") {
        return sem_operand(c, n, expected_type);
    }
    if n == null {
        sem_fail(c, n, "Missing expression");
        return null;
    }
    if sem_equal(kind, "CoreCall") {
        if sem_call(c, n) == null {
            return null;
        }
    } else {
        if sem_equal(kind, "CoreBinary") {
            if !sem_shape(c, n, "left") || !sem_shape(c, n, "op") || !sem_shape(c, n, "right") {
                return null;
            }
            var value: FoundationNode* = sem_node(c, n, KBinary());
            var op: u8* = sem_tokens(c, sem_member(n, "op"));
            var found: bool = false;
            for(var i: u32 = 0; i <= 13; i++) {
                if sem_equal(op, semantic_operator(i)) {
                    value.op = i;
                    found = true;
                    break;
                }
            }
            if !found {
                sem_fail(c, n, "Unknown foundation binary operation");
            }
            var input: FoundationType* = sem_type_new(c, SI32(), 0, null);
            if expected_type != null {
                input = expected_type;
            }
            var comparison: bool = value.op >= OEq();
            var left: void* = sem_member(n, "left");
            var right: void* = sem_member(n, "right");
            if comparison || expected_type == null {
                var anchor: void* = left;
                if sem_literal(c, left) && !sem_literal(c, right) {
                    anchor = right;
                }
                var known: void* = sem_operand(c, anchor, null);
                if !sem_ok(c) || known == null {
                    return n;
                }
                var step54 = sem_get(known);
                input = &step54.type;
            }
            var step55 = sem_operand(c, left, input);
            value.left = step55;
            var nominal = input.pointers == 0;
            nominal &&= semantic_enum(input);
            if nominal {
                var equality = value.op == OEq();
                if value.op == ONe() {
                    equality = true;
                }
                if !equality {
                    sem_fail(c, n, "Enum operations require equality or an explicit integer conversion");
                }
            }
            if !sem_ok(c) {
                return n;
            }
            var pointer_offset: bool = input.pointers != 0 &&(value.op == OAdd() || value.op == OSub());
            var right_type: FoundationType* = input;
            if pointer_offset {
                right_type = null;
                if sem_literal(c, right) {
                    right_type = sem_type_new(c, SUSize(), 0, null);
                }
            }
            var step66 = sem_operand(c, right, right_type);
            value.right = step66;
            if !sem_ok(c) {
                return n;
            }
            if comparison {
                var step69 = sem_type_new(c, SBool(), 0, null);
                sem_set_type(&value.type, step69);
            } else {
                sem_set_type(&value.type, input);
            }
            if pointer_offset {
                var step70 = sem_get(value.right);
                var step71 = semantic_integer(&step70.type);
                if semantic_enum(&step70.type) {
                    step71 = false;
                }
                if !step71 {
                    sem_fail(c, n, "A pointer offset must be an integer");
                }
                var element: FoundationType* = sem_type_copy(c, input);
                element.pointers--;
                if !semantic_aggregate(element) && semantic_size(element) == 0 {
                    sem_fail(c, n, "Cannot offset a void pointer");
                }
            } else {
                if !semantic_integer(input) && value.op != OEq() && value.op != ONe() {
                    sem_fail(c, n, "This operation requires integer operands");
                }
            }
        } else {
            var step82 = sem_cat(c, "Unsupported foundation expression '", kind);
            sem_fail(c, n, sem_cat(c, step82, "'"));
            return null;
        }
    }
    var value: FoundationNode* = sem_get(n);
    if value == null {
        return n;
    }
    if semantic_aggregate(&value.type) {
        sem_fail(c, n, "Struct values require field access or a pointer; aggregate copies are not implemented");
    }
    if expected_type != null && !semantic_type_equal(&value.type, expected_type) {
        var step91 = sem_type_name(c, expected_type);
        var step93 = sem_cat(c, sem_cat(c, "Expected ", step91), ", got ");
        var step94 = sem_type_name(c, &value.type);
        sem_fail(c, n, sem_cat(c, step93, step94));
    }
    return n;
}
