import tower;
import completion;
import language_query;
import semantic_generic_info;
import semantic_generic_values;
import semantic_context;
import semantic_support;
import semantic_types;
import format_types;
import foundation_types;
import frontend_compilation;
import inspection_policy;
import source_comments;
import .library.vector;

extern fn format_dependent_summary(result: FormatResult*, entity: void*, match_kind: void*): void;

extern fn format_dependent_view(result: FormatResult*, entity: void*, subject: void*, annotation: void*, match_kind: void*, substitutions: FormatSubstitution*): void;

fn language_generic_kind(info: GenericInfo*): u8* {
    if info.kind == GenericInfoKind.Member {
        return "member access";
    }
    if info.kind == GenericInfoKind.Index {
        return "indexed element";
    }
    if info.kind == GenericInfoKind.Binary {
        return "binary operation";
    }
    if info.kind == GenericInfoKind.Value {
        return "value";
    }
    if info.kind == GenericInfoKind.Load {
        return "pointer dereference";
    }
    if info.kind == GenericInfoKind.Assignment {
        return "assignment";
    }
    if info.kind == GenericInfoKind.Function {
        return "function template";
    }
    if info.kind == GenericInfoKind.Constructor {
        return "type function";
    }
    if info.kind == GenericInfoKind.TypeParameter {
        return "type parameter";
    }
    if info.kind == GenericInfoKind.ConstantParameter {
        return "compile-time parameter";
    }
    if info.kind == GenericInfoKind.Parameter {
        return "parameter";
    }
    if info.kind == GenericInfoKind.Structure {
        return "struct type";
    }
    if info.kind == GenericInfoKind.Field {
        return "field";
    }
    if info.kind == GenericInfoKind.Variable {
        return "local variable";
    }
    if info.kind == GenericInfoKind.TypeExpression {
        return "type";
    }
    return "";
}

fn language_generic_description(info: GenericInfo*): u8* {
    if info.kind == GenericInfoKind.Member {
        return "Accesses a named field. Its type is not yet known for this template.";
    }
    if info.kind == GenericInfoKind.Index {
        return "Selects one element using its index. The first element has index zero.";
    }
    if info.kind == GenericInfoKind.Binary {
        if info.resolved == null {
            return "A valid result type has not been established for this expression.";
        }
        return "Uses the two operands to compute a new value.";
    }
    if info.kind == GenericInfoKind.Value {
        return "A value used by this expression.";
    }
    if info.kind == GenericInfoKind.Load {
        return "A pointer holds a memory address. This reads the value stored at that address.";
    }
    if info.kind == GenericInfoKind.Assignment {
        return "Changes the value on the left to the value on the right. The previous value is overwritten.";
    }
    if info.kind == GenericInfoKind.Function {
        return "Reusable code that accepts types as inputs. Each set of type arguments is checked separately; the remaining parameters receive values when the function runs.";
    }
    if info.kind == GenericInfoKind.Constructor {
        return "Runs during compilation to produce a type. Its arguments choose the types and sizes used in the result.";
    }
    if info.kind == GenericInfoKind.TypeParameter {
        return "A type you supply when calling this function. Uses of this name refer to that supplied type.";
    }
    if info.kind == GenericInfoKind.ConstantParameter {
        return "A value supplied during compilation. It can determine the shape or size of the resulting type.";
    }
    if info.kind == GenericInfoKind.Parameter {
        return "A named input to the function. Each call supplies a value; its type can depend on the type arguments.";
    }
    if info.kind == GenericInfoKind.Structure {
        return "Groups named fields into a type. The field types and memory layout are determined for each set of arguments.";
    }
    if info.kind == GenericInfoKind.Field {
        return "A named part of this struct. Each value of the struct has its own copy of the field.";
    }
    if info.kind == GenericInfoKind.Variable {
        return "A named place to store a value. You can read it or change it later by assigning a new value.";
    }
    if info.kind == GenericInfoKind.Return {
        return "Ends this function and gives its result back to the code that called it.";
    }
    if info.dependent {
        return "Describes a type using this function's parameters. Supplying the arguments determines the concrete type.";
    }
    return "Describes which values can be stored here.";
}

fn language_generic_present(q: CompletionQuery*, node: void*, candidate: LanguageCandidate*): void {
    var info = generic_info(node, q.generic_info);
    candidate.generic = info;
    candidate.subject = info.declaration;
    candidate.description = language_generic_description(info);
    candidate.structural = false;
}

fn language_generic_space(text: u8*, first: usize, last: usize): bool {
    for(; first < last; first++) {
        var byte = text[first];
        var space = byte == TriviaSpace();
        if byte == TriviaTab() {
            space = true;
        }
        if byte == TriviaNewline() {
            space = true;
        }
        if byte == TriviaCarriageReturn() {
            space = true;
        }
        if !space {
            return false;
        }
    }
    return true;
}

// Reuse captured lexer trivia and Foundation comment normalization. No browser
// source parsing and no need to instantiate a template just to read its docs.
fn language_generic_documentation(q: CompletionQuery*, declaration: void*): void {
    var span = sem_match(declaration);
    if span == null {
        return;
    }
    var base = sem_source_base(&q.context, declaration);
    var m: usize = 0;
    for(; m < q.comment_modules.length; m++) {
        if q.comment_bases.data[m] == base {
            var module = q.comment_modules.data[m];
            var count: usize = 0;
            var comments = frontend_module_comments(module, &count);
            var total = count;
            var source = frontend_module_source(module);
            var end = span.start;
            var first = count;
            while first != 0 {
                var before = first -2;
                var after = before + 1;
                var last = comments[after];
                if last <= end {
                    if !language_generic_space(source, last, end) {
                        break;
                    }
                    end = comments[before];
                    count = first;
                }
                first = before;
            }
            if end != span.start {
                // Find the first attached comment after skipping later trivia.
                first = 0;
                while first < count {
                    if comments[first] == end {
                        break;
                    }
                    first = first + 2;
                }
                var docs: FoundationNode = default;
                while first < total {
                    var after = first + 1;
                    var last = comments[after];
                    if last > span.start {
                        break;
                    }
                    source_comment_append(&docs, source, comments[first], last);
                    first = first + 2;
                }
                language_documentation(q, &docs);
                vector_dispose(&docs.comments);
            }
            return;
        }
    }
}

fn language_generic_format(q: CompletionQuery*, info: GenericInfo*, formatted: FormatResult*, signature: bool): void {
    var a: GenericAnalysis = default;
    a.context = &q.context;
    a.component = q.generic_info;
    a.budget = InspectionNodeLimit();
    var substitutions = generic_format_substitutions(&a, info.annotation, info.bindings, 0);
    if a.truncated {
        q.truncated = true;
    }
    var node = info.annotation;
    var subject: void* = null;
    if signature {
        node = info.declaration;
        subject = node;
    }
    format_dependent_view(formatted, node, subject, info.annotation, parser_match_get_type(), substitutions);
    if info.annotation == null {
        if info.resolved != null {
            var append = !signature;
            if signature {
                append = info.kind == GenericInfoKind.Variable;
                if append {
                    sem_require(bytes_append(&formatted.text, ": ", 2));
                }
            }
            if append {
                var resolved = sem_get(info.resolved);
                var text = sem_type_name(&q.context, &resolved.type);
                sem_require(bytes_append(&formatted.text, text, sem_length(text)));
            }
        }
    }
}

fn language_generic_details(q: CompletionQuery*, info: GenericInfo*): void {
    var annotation = info.annotation;
    var generic_check28 = annotation != null;
    if info.resolved != null {
        generic_check28 = true;
    }
    if generic_check28 {
        var formatted: FormatResult = default;
        language_generic_format(q, info, &formatted, false);
        var formatted_ok = !formatted.failed;
        formatted_ok &&= formatted.text.length != 0;
        if formatted_ok {
            completion_text(&q.output, ",\"type\":");
            language_quote(q, formatted.text.data, formatted.text.length);
        }
        format_dispose(&formatted);
    }
    if info.dependent {
        language_string(q, "resolution", "Depends on the arguments supplied to this function.");
    }
    if info.resolved != null {
        var resolved = sem_get(info.resolved);
        language_number(q, "size", semantic_size(&resolved.type));
        language_number(q, "alignment", semantic_alignment(&resolved.type));
    }
    language_number(q, "binding", entity_id(info.declaration));
    language_declaration_location(q, info.declaration);
    language_generic_documentation(q, info.declaration);
}
