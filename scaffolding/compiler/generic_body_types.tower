import tower;
import .library.work_budget_types;

// Internal worker arguments, borrowing canonical entities from one compiler world.
struct GenericBodyCopy {
    context: void*;
    node: void*;
    stage: void*;
    limit: usize;
    copied: usize;
    success: bool;
    // Frozen by the coordinator; the world budget outlives the dispatched job.
    budget: WorkBudget*;
    storage_error: WorkBudgetError;
}
