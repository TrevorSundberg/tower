import tower;
import .library.work_budget_types;
import .library.entity_types;
import .library.entity_stage_types as stages;
import generic_registry_types as registry;

// Internal clone storage layout, shared with exact allocation-boundary checks.
struct CloneFrame {
    source: Entity*;
    destination: Entity*;
    next: usize;
}

var CloneInitialFrames: usize = 16;

// Null clone with no storage error means the cumulative GenericNodeLimit
// policy was exhausted. Static text needs no allocation on either failure path.
fn generic_clone_diagnostic(error: WorkBudgetError): u8* {
    if error == WorkBudgetError.None {
        return "Template expansion exceeds 65536 nodes (cumulative GenericNodeLimit)";
    }
    if error == WorkBudgetError.Capacity { return "Template clone storage exceeds its memory budget"; }
    if error == WorkBudgetError.Memory { return "Cannot allocate template clone storage"; }
    return "Cannot prepare template clone storage";
}

// Internal worker arguments, borrowing canonical entities from one compiler world.
struct GenericBodyCopy {
    context: registry.GenericContext*;
    node: Entity*;
    stage: stages.EntityStage*;
    limit: usize;
    copied: usize;
    success: bool;
    // Frozen by the coordinator; the world budget outlives the dispatched job.
    budget: WorkBudget*;
    storage_error: WorkBudgetError;
}
