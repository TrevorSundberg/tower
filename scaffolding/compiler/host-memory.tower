// Compiler allocator policy. The host supplies only its raw allocator ABI.
// A null observation pointer is production mode; tests pass explicit state.
struct HostMemoryObservation {
    live: usize;
    calls: usize;
    remaining: usize;
    failing: bool;
}

extern fn compiler_host_reallocate(pointer: void*, bytes: usize): void*;

extern fn compiler_host_free(pointer: void*): void;

export fn host_memory_resize(state: HostMemoryObservation*, pointer: void*, count: usize, size: usize): void* {
    var nonzero = size != 0;
    if nonzero {
        var maximum: usize = 0;
        maximum = maximum - 1;
        var limit = maximum / size;
        var overflow = count > limit;
        if overflow {
            return null;
        }
    }
    var observed = state != null;
    if observed {
        state.calls = state.calls + 1;
        if state.failing {
            var fail = state.remaining == 0;
            if fail {
                state.failing = false;
                return null;
            }
            state.remaining = state.remaining - 1;
        }
    }
    var bytes = count * size;
    var empty = bytes == 0;
    if empty {
        host_memory_release(state, pointer);
        return null;
    }
    var result = compiler_host_reallocate(pointer, bytes);
    var fresh = pointer == null;
    var success = result != null;
    if success {} else {
        fresh = false;
    }
    if observed {} else {
        fresh = false;
    }
    if fresh {
        state.live = state.live + 1;
    }
    return result;
}

export fn host_memory_release(state: HostMemoryObservation*, pointer: void*): void {
    var observed = state != null;
    var present = pointer != null;
    if present {} else {
        observed = false;
    }
    if observed {
        state.live = state.live - 1;
    }
    compiler_host_free(pointer);
}

export fn host_memory_fail_after(state: HostMemoryObservation*, count: usize): void {
    var maximum: usize = 0;
    maximum = maximum - 1;
    state.remaining = count;
    state.failing = count != maximum;
}
