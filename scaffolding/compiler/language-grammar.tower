import tower;
import 'language-components';
import 'syntax-types';
import 'syntax-tags';
import 'format-types';
import 'completion';
import 'frontend-compilation';
import 'language-query';
import 'semantic-context';
import 'semantic-modules';
import 'semantic-support';
import '../library/vector';

// Disposable references into the shared grammar entities, captured at each
// declaration boundary. Later overrides cannot rewrite an earlier hover.
// A template retains its actual compiled tree followed by its ordered holes.
struct LanguageGrammar {
    node: void*;
    targets: vector(void*);
    total: usize;
    category: vector(u8);
    matched: bool;
}

extern fn syntax_inspection_match(session: void*, node: void*): void*;

extern fn tower_node_get_parent_member_name(node: void*): u8*;

extern fn syntax_inspection_reference(session: void*, text: u8*, length: usize, index: usize, count: usize*): void*;

extern fn syntax_inspection_template(session: void*, body: void*, category: u8**, count: usize*): void*;

extern fn syntax_inspection_capture(session: void*, body: void*, index: usize): void*;

extern fn entity_retain(node: void*): usize;

extern fn format_grammar_preview(result: FormatResult*, entity: void*, syntax: void*): void;

fn language_syntax(node: void*): SyntaxNode* {
    var grammar_condition1 = node == null;
    if grammar_condition1 {
        return null;
    }
    var component = entity_component_get(node, syntax_component_type());
    return bits(SyntaxNode*, entity_component_data(component));
}

fn language_grammar_keep(entry: LanguageGrammar*, node: void*): void {
    var grammar_condition2 = node == null;
    if grammar_condition2 {
        return;
    }
    entity_retain(node);
    sem_push(&entry.targets, node);
}

// Snapshot the actual production before the next declaration swaps its table.
// These are references to shared grammar entities, not a second syntax model.
fn language_match_snapshot(q: CompletionQuery*, node: void*, session: void*, depth: usize): void {
    var exhausted = depth == 256;
    var full = q.grammar.length >= 100000;
    if full {
        exhausted = true;
    }
    if exhausted {
        q.truncated = true;
        return;
    }
    var target = syntax_inspection_match(session, node);
    var present = target != null;
    if present {
        var entry: LanguageGrammar;
        fill(&entry, 0, sizeof(LanguageGrammar));
        entry.node = node;
        entry.matched = true;
        entry.total = 1;
        language_grammar_keep(&entry, target);
        var needed = q.grammar.length + 1;
        sem_require(vector_reserve(LanguageGrammar, &q.grammar, needed));
        copy(&q.grammar.data[q.grammar.length], &entry, sizeof(LanguageGrammar));
        q.grammar.length = needed;
    }
    var i: usize = 0;
    var count = sem_child_count(node);
    loop {
        var done = i == count;
        if done {
            break;
        }
        var next = depth + 1;
        language_match_snapshot(q, sem_child(node, i), session, next);
        i++;
    }
}

fn language_grammar_index(q: CompletionQuery*): void {
    q.grammar_index = sem_table(&q.context);
    var i: usize = 0;
    loop {
        var done = i == q.grammar.length;
        if done {
            break;
        }
        var entry = &q.grammar.data[i];
        var indexed = sem_state(&q.context, q.grammar_index, entry.node);
        indexed.value = bits(void*, entry);
        i++;
    }
}

fn language_match_candidate(q: CompletionQuery*, node: void*, candidate: LanguageCandidate*): void {
    // The LR assembler flattens generated capture/repetition rules into named
    // relationships. Follow those actual ECS edges back to the source term.
    var parent = language_grammar_find(q, sem_parent(node));
    var named = parent != null;
    named &&= parent.matched;
    if named {
        var name = tower_node_get_parent_member_name(node);
        var alternative = language_syntax(parent.targets.data[0]);
        var i: usize = 0;
        loop {
            var done = i == alternative.items.length;
            if done {
                break;
            }
            var term = alternative.items.data[i];
            var syntax = language_syntax(term);
            var captured = syntax.capture.length != 0;
            captured &&= name != null;
            captured &&= sem_equal(syntax.capture.data, name);
            if captured {
                candidate.capture = term;
                candidate.capture_node = node;
                break;
            }
            i++;
        }
    }
    var entry = language_grammar_find(q, node);
    var present = entry != null;
    present &&= entry.matched;
    if !present {
        return;
    }
    candidate.matched = entry;
    var captured = candidate.capture != null;
    if captured {
        var a = sem_match(candidate.capture_node);
        var b = sem_match(node);
        var same = a.start == b.start;
        same &&= a.length == b.length;
        if !same {
            candidate.capture = null;
        }
    }
}

fn language_match_details(q: CompletionQuery*, candidate: LanguageCandidate*): void {
    var entry = candidate.matched;
    var present = entry != null;
    if !present {
        return;
    }
    var kind: u8* = "matched syntax";
    language_string(q, "matchedRule", sem_label(entry.node));
    language_string(q, "description", "This code matches the pattern shown below.");
    language_grammar_targets(q, entry, false);
    var documentation = entry.targets.data[0];
    var captured = candidate.capture != null;
    if captured {
        var binding = candidate.capture;
        var syntax = language_syntax(binding);
        kind = "captured syntax";
        language_string(q, "capture", syntax.capture.data);
        language_string(q, "category", syntax.text.data);
        var owner = language_ancestor(binding, "GrammarDeclaration");
        var declared = owner != null;
        if declared {
            var declaration = language_syntax(owner);
            language_string(q, "capturedBy", declaration.name.data);
        }
        documentation = binding;
    }
    language_string(q, "kind", kind);
    language_grammar_docs(q, documentation);
}

fn language_snapshot(q: CompletionQuery*, node: void*, session: void*, depth: usize): void {
    var grammar_condition3 = depth == 256;
    if grammar_condition3 {
        q.truncated = true;
        return;
    }
    var syntax = language_syntax(node);
    var grammar_condition4 = syntax != null;
    if grammar_condition4 {
        // Import path terms are names, not grammar references.
        var grammar_condition5 = syntax.kind == SyntaxImport();
        if grammar_condition5 {
            return;
        }
        var entry: LanguageGrammar;
        fill(&entry, 0, sizeof(LanguageGrammar));
        entry.node = node;
        var reference = syntax.kind == SyntaxRule();
        var text = &syntax.name;
        var grammar_condition6 = syntax.kind == SyntaxTerm();
        if grammar_condition6 {
            text = &syntax.text;
            reference = !syntax.literal;
            if syntax.terminal_set {
                reference = false;
            }
        }
        if reference {
            var i: usize = 0;
            loop {
                var grammar_condition7 = i == 3;
                if grammar_condition7 {
                    break;
                }
                var target = syntax_inspection_reference(session, text.data, text.length, i, &entry.total);
                var grammar_condition8 = target == null;
                if grammar_condition8 {
                    break;
                }
                language_grammar_keep(&entry, target);
                i++;
            }
        }
        var grammar_condition12 = entry.targets.length != 0;
        var template = syntax.kind == SyntaxTemplate();
        if template {
            grammar_condition12 = true;
        }
        if grammar_condition12 {
            var needed = q.grammar.length + 1;
            sem_require(vector_reserve(LanguageGrammar, &q.grammar, needed));
            copy(&q.grammar.data[q.grammar.length], &entry, sizeof(LanguageGrammar));
            q.grammar.length = needed;
        }
    }
    var i: usize = 0;
    var count = sem_child_count(node);
    loop {
        var grammar_condition13 = i == count;
        if grammar_condition13 {
            break;
        }
        var next = depth + 1;
        language_snapshot(q, sem_child(node, i), session, next);
        i++;
    }
}

// Some rules are deliberately unreachable until a later declaration activates
// them. Capture their real compiled template at first activation, then freeze it.
fn language_templates_refresh(q: CompletionQuery*, session: void*): void {
    var i: usize = 0;
    loop {
        var done = i == q.grammar.length;
        if done {
            break;
        }
        var entry = &q.grammar.data[i];
        var pending = entry.targets.length == 0;
        if pending {
            var category: u8* = null;
            var tree = syntax_inspection_template(session, entry.node, &category, &entry.total);
            var compiled = tree != null;
            if compiled {
                sem_require(bytes_append(&entry.category, category, sem_length(category)));
                sem_require(host_text_terminate(&entry.category));
                language_grammar_keep(entry, tree);
                var j: usize = 0;
                loop {
                    done = j == entry.total;
                    if done {
                        break;
                    }
                    language_grammar_keep(entry, syntax_inspection_capture(session, entry.node, j));
                    j++;
                }
            }
        }
        i++;
    }
}

fn language_grammar_dispose(q: CompletionQuery*): void {
    var i: usize = 0;
    loop {
        var grammar_condition14 = i == q.grammar.length;
        if grammar_condition14 {
            break;
        }
        var entry = &q.grammar.data[i];
        var j: usize = 0;
        loop {
            var grammar_condition15 = j == entry.targets.length;
            if grammar_condition15 {
                break;
            }
            entity_release(entry.targets.data[j]);
            j++;
        }
        vector_dispose(void*, &entry.targets);
        vector_dispose(u8, &entry.category);
        i++;
    }
    vector_dispose(LanguageGrammar, &q.grammar);
}

fn language_grammar_find(q: CompletionQuery*, node: void*): LanguageGrammar* {
    var indexed = q.grammar_index != null;
    if indexed {
        var found = sem_find(q.grammar_index, null, node);
        var present = found != null;
        if present {
            return bits(LanguageGrammar*, found.value);
        }
        return null;
    }
    var i: usize = 0;
    loop {
        var grammar_condition16 = i == q.grammar.length;
        if grammar_condition16 {
            return null;
        }
        var entry = &q.grammar.data[i];
        var grammar_condition17 = entry.node == node;
        if grammar_condition17 {
            return entry;
        }
        i++;
    }
    return null;
}

fn language_inside(leaf: void*, node: void*): bool {
    var grammar_condition18 = node == null;
    if grammar_condition18 {
        return false;
    }
    var a = sem_match(leaf);
    var b = sem_match(node);
    var grammar_condition19 = a == null;
    if grammar_condition19 {
        return false;
    }
    var grammar_condition20 = b == null;
    if grammar_condition20 {
        return false;
    }
    var grammar_condition21 = a.start < b.start;
    if grammar_condition21 {
        return false;
    }
    var end = a.start + a.length;
    var limit = b.start + b.length;
    var grammar_condition73 = end <= limit;
    return grammar_condition73;
}

fn language_member_at(leaf: void*, node: void*, member: u8*): bool {
    return language_inside(leaf, sem_member(node, member));
}

fn language_ancestor(node: void*, label: u8*): void* {
    var depth: usize = 0;
    loop {
        var grammar_condition22 = node == null;
        if grammar_condition22 {
            return null;
        }
        var grammar_condition23 = depth == 256;
        if grammar_condition23 {
            return null;
        }
        if sem_is(node, label) {
            return node;
        }
        node = sem_parent(node);
        depth++;
    }
    return null;
}

fn language_grammar_docs(q: CompletionQuery*, node: void*): void {
    var depth: usize = 0;
    loop {
        var grammar_condition24 = node == null;
        if grammar_condition24 {
            return;
        }
        var grammar_condition25 = depth == 256;
        if grammar_condition25 {
            return;
        }
        var syntax = language_syntax(node);
        var grammar_condition26 = syntax != null;
        if grammar_condition26 {
            var grammar_condition27 = syntax.comments.length != 0;
            if grammar_condition27 {
                var text: vector(u8);
                vector_init(u8, &text);
                var i: usize = 0;
                loop {
                    var grammar_condition28 = i == syntax.comments.length;
                    if grammar_condition28 {
                        break;
                    }
                    var comment = &syntax.comments.data[i];
                    var first: usize = 0;
                    var last = comment.length;
                    var grammar_condition29 = last >= 2;
                    if grammar_condition29 {
                        var grammar_condition30 = comment.data[0] == 47;
                        if grammar_condition30 {
                            var grammar_condition31 = comment.data[1] == 47;
                            if grammar_condition31 {
                                first = 2;
                            }
                            var grammar_condition32 = comment.data[1] == 42;
                            if grammar_condition32 {
                                first = 2;
                                last = last - 2;
                            }
                        }
                    }
                    loop {
                        var grammar_condition33 = first >= last;
                        if grammar_condition33 {
                            break;
                        }
                        var grammar_condition34 = comment.data[first] != 32;
                        if grammar_condition34 {
                            break;
                        }
                        first++;
                    }
                    var grammar_condition35 = i != 0;
                    if grammar_condition35 {
                        completion_text(&text, "\n");
                    }
                    var length = last - first;
                    sem_require(bytes_append(&text, &comment.data[first], length));
                    i++;
                }
                completion_text(&q.output, ",\"documentation\":");
                language_quote(q, text.data, text.length);
                vector_dispose(u8, &text);
                return;
            }
        }
        node = sem_parent(node);
        depth++;
    }
}

fn language_grammar_location(q: CompletionQuery*, node: void*): void {
    var syntax = language_syntax(node);
    var grammar_condition36 = syntax == null;
    if grammar_condition36 {
        return;
    }
    var grammar_condition37 = syntax.source == null;
    if grammar_condition37 {
        return;
    }
    var source = syntax.source;
    language_string(q, "definedIn", source.name.data);
    var line: usize = 1;
    var column: usize = 1;
    syntax_source_location(source, syntax.start, &line, &column);
    language_number(q, "definitionLine", line);
    language_number(q, "definitionColumn", column);
}

fn language_grammar_targets(q: CompletionQuery*, entry: LanguageGrammar*, documentation: bool): void {
    var grammar_condition41 = entry == null;
    if grammar_condition41 {
        return;
    }
    language_number(q, "alternatives", entry.total);
    var text: vector(u8);
    vector_init(u8, &text);
    var i: usize = 0;
    loop {
        var grammar_condition42 = i == entry.targets.length;
        if grammar_condition42 {
            break;
        }
        var preview: FormatResult;
        fill(&preview, 0, sizeof(FormatResult));
        format_grammar_preview(&preview, entry.targets.data[i], syntax_component_type());
        var grammar_condition43 = i != 0;
        if grammar_condition43 {
            completion_text(&text, " | ");
        }
        var grammar_condition44 = preview.text.length == 0;
        if grammar_condition44 {
            completion_text(&text, "(empty)");
        }
        else {
            sem_require(bytes_append(&text, preview.text.data, preview.text.length));
        }
        format_dispose(&preview);
        i++;
    }
    var grammar_condition45 = entry.total > entry.targets.length;
    if grammar_condition45 {
        completion_text(&text, " | ...");
    }
    completion_text(&q.output, ",\"definition\":");
    language_quote(q, text.data, text.length);
    vector_dispose(u8, &text);
    language_grammar_location(q, entry.targets.data[0]);
    if documentation {
        language_grammar_docs(q, entry.targets.data[0]);
    }
}

fn language_grammar_details(q: CompletionQuery*, leaf: void*, node: void*): void {
    var syntax = language_syntax(node);
    var grammar_condition46 = syntax == null;
    if grammar_condition46 {
        return;
    }
    var imported = language_ancestor(node, "ImportDeclaration");
    var is_import = imported != null;
    if is_import {
        var module = language_syntax(imported);
        language_string(q, "kind", "module import");
        language_string(q, "module", module.name.data);
        language_string(q, "description", "Imports this file's grammar and declarations, optionally through a module alias.");
        language_grammar_docs(q, imported);
        return;
    }
    var kind: u8* = "grammar declaration";
    var description: u8* = "Defines syntax for subsequent source after the terminating semicolon.";
    var reference = false;
    var docs = true;
    var grammar_condition47 = syntax.kind == SyntaxRule();
    if grammar_condition47 {
        kind = "parse rule";
        description = "Defines how to write this part of the language.";
        if syntax.append {
            description = "Adds another way to write this part of the language. Applies to the code below.";
        }
        else {
            description = "Sets how to write this part of the language, replacing any earlier version. Applies to the code below.";
        }
        if language_member_at(leaf, node, "name") {
            reference = true;
        }
        if language_member_at(leaf, node, "op") {
            kind = "grammar assignment";
        }
        if language_member_at(leaf, node, "replacement") {
            kind = "replacement";
            description = "Replaces a matched alternative with this parsed template; captured nodes are substituted before type checking.";
        }
        if sem_is(sem_parent(leaf), "GrammarAlternatives") {
            kind = "alternative separator";
            description = "Separates alternative sequences accepted by this rule; order is not silent conflict priority.";
        }
    }
    var grammar_condition48 = syntax.kind == SyntaxAlternative();
    if grammar_condition48 {
        kind = "alternative";
        description = "Matches this ordered sequence of grammar terms.";
    }
    var grammar_condition49 = syntax.kind == SyntaxTerm();
    if grammar_condition49 {
        kind = "grammar reference";
        description = "Matches this category using the grammar active at this declaration.";
        reference = true;
        docs = false;
        var atom = sem_member(node, "atom");
        var grammar_condition50 = syntax.capture.length != 0;
        if grammar_condition50 {
            if !language_member_at(leaf, atom, "reference") {
                kind = "capture binding";
                description = "Binds the matched syntax subtree for use in this alternative's replacement. Its category is grammar, not a runtime type.";
                language_string(q, "capture", syntax.capture.data);
            }
        }
        if syntax.literal {
            reference = false;
            kind = "literal token";
            description = "Matches this exact token spelling.";
            var parent = sem_parent(node);
            var grammar_condition51 = language_ancestor(parent, "GrammarTokenSet") != null;
            if grammar_condition51 {
                kind = "excluded token";
                description = "Excludes this exact token from the surrounding token set.";
            }
        }
        if syntax.terminal_set {
            reference = false;
            kind = "token exclusion set";
            description = "Matches one token except the listed spellings.";
        }
        if language_member_at(leaf, node, "suffix") {
            reference = false;
            kind = "repetition";
            var grammar_condition52 = syntax.repetition == 42;
            if grammar_condition52 {
                description = "Matches zero or more occurrences of the preceding term.";
            }
            var grammar_condition53 = syntax.repetition == 43;
            if grammar_condition53 {
                description = "Matches one or more occurrences of the preceding term.";
            }
            var grammar_condition54 = syntax.repetition == 63;
            if grammar_condition54 {
                description = "Matches zero or one occurrence of the preceding term.";
            }
        }
        if reference {
            language_string(q, "category", syntax.text.data);
        }
    }
    var lexical = syntax.kind == SyntaxToken();
    var grammar_condition55 = syntax.kind == SyntaxSkip();
    if grammar_condition55 {
        lexical = true;
    }
    if lexical {
        kind = "token declaration";
        description = "Recognizes a token using this lexical pattern.";
        var grammar_condition56 = syntax.kind == SyntaxSkip();
        if grammar_condition56 {
            kind = "skip declaration";
            description = "Consumes matching text as trivia instead of passing a token to the parser.";
        }
        if language_member_at(leaf, node, "pattern") {
            kind = "lexical pattern";
            description = "Compiled to the lexer table; matches the longest eligible prefix of source text.";
        }
        if language_member_at(leaf, node, "mode") {
            kind = "contextual token";
            description = "Recognized only when the current parser state expects this token.";
        }
        if language_member_at(leaf, node, "style") {
            kind = "highlight style";
            description = "Controls syntax highlighting only; it does not declare a semantic type.";
        }
    }
    var grammar_condition57 = syntax.kind == SyntaxTemplate();
    if grammar_condition57 {
        kind = "replacement template";
        description = "Parsed using the destination grammar when this rule becomes reachable; capture types are checked after substitution.";
    }
    language_string(q, "kind", kind);
    language_string(q, "description", description);
    if reference {
        var entry = language_grammar_find(q, node);
        var grammar_condition59 = entry == null;
        if grammar_condition59 {
            language_string(q, "resolution", "Not resolved at this declaration; forward grammar dependencies may be resolved before activation.");
        }
        else {
            var referenced_docs = !docs;
            language_grammar_targets(q, entry, referenced_docs);
        }
    }
    if docs {
        language_grammar_docs(q, node);
    }
}

fn language_template_capture(leaf: void*, template: LanguageGrammar*): void* {
    var span = sem_match(leaf);
    var grammar_condition60 = span == null;
    if grammar_condition60 {
        return null;
    }
    var grammar_condition61 = span.id < 3145728;
    if grammar_condition61 {
        return null;
    }
    var index = convert(usize, span.id) - 3145728;
    index++;
    var grammar_condition62 = index >= template.targets.length;
    if grammar_condition62 {
        return null;
    }
    return template.targets.data[index];
}

fn language_capture_categories(q: CompletionQuery*, declaration: SyntaxNode*, capture: SyntaxNode*): void {
    var categories: vector(u8*);
    vector_init(u8*, &categories);
    var i: usize = 0;
    var grammar_condition1 = declaration != null;
    if grammar_condition1 {
        loop {
            var grammar_condition2 = i == declaration.items.length;
            if grammar_condition2 {
                break;
            }
            var alternative = language_syntax(declaration.items.data[i]);
            var j: usize = 0;
            loop {
                var grammar_condition3 = j == alternative.items.length;
                if grammar_condition3 {
                    break;
                }
                var term = language_syntax(alternative.items.data[j]);
                var same = term.capture.length != 0;
                same &&= sem_equal(term.capture.data, capture.capture.data);
                if same {
                    var known = false;
                    var k: usize = 0;
                    loop {
                        var grammar_condition4 = k == categories.length;
                        if grammar_condition4 {
                            break;
                        }
                        if sem_equal(categories.data[k], term.text.data) {
                            known = true;
                        }
                        k++;
                    }
                    if !known {
                        sem_require(vector_push(u8*, &categories, term.text.data));
                    }
                }
                j++;
            }
            i++;
        }
    }
    var grammar_condition5 = categories.length == 0;
    if grammar_condition5 {
        sem_require(vector_push(u8*, &categories, capture.text.data));
    }
    var text: vector(u8);
    vector_init(u8, &text);
    i = 0;
    loop {
        var grammar_condition6 = i == categories.length;
        if grammar_condition6 {
            break;
        }
        var grammar_condition7 = i != 0;
        if grammar_condition7 {
            completion_text(&text, " | ");
        }
        completion_text(&text, categories.data[i]);
        i++;
    }
    completion_text(&q.output, ",\"category\":");
    language_quote(q, text.data, text.length);
    vector_dispose(u8, &text);
    vector_dispose(u8*, &categories);
}

fn language_template_role(node: void*, kind: u8**, description: u8**): bool {
    if sem_is(node, "CoreAddress") {
        *kind = "address of";
        *description = "Takes the address of the substituted location. The result is a pointer to that location's resolved type.";
        return true;
    }
    if sem_is(node, "CoreLoad") {
        *kind = "pointer dereference";
        *description = "Loads the value at this pointer; its pointee type is resolved after capture substitution.";
        return true;
    }
    if sem_is(node, "CoreCall") {
        *kind = "replacement call";
        *description = "Calls this function after captured arguments are substituted. Specialization and parameter types are checked in the expanded code.";
        return true;
    }
    if sem_is(node, "CoreLocation") {
        *kind = "replacement location";
        *description = "Resolves a variable, field or indexed location in the expanded code's lexical scope.";
        return true;
    }
    if sem_is(node, "CoreType") {
        *kind = "replacement type";
        *description = "Resolves this type name in the expanded code's scope after substitution.";
        return true;
    }
    if sem_is(node, "CoreDeclare") {
        *kind = "replacement declaration";
        *description = "Declares a variable in the expanded code's scope; its type and initializer are checked after substitution.";
        return true;
    }
    if sem_is(node, "CoreReturn") {
        *kind = "replacement return";
        *description = "Returns from the containing function after expansion; its value must match that function's return type.";
        return true;
    }
    if sem_is(node, "CoreIf") {
        *kind = "replacement conditional";
        *description = "Branches on a bool value after capture substitution and ordinary type checking.";
        return true;
    }
    if sem_is(node, "CoreLoop") {
        *kind = "replacement loop";
        *description = "Repeats this expanded block until control leaves it.";
        return true;
    }
    if sem_is(node, "CoreBlock") {
        *kind = "replacement block";
        *description = "Groups expanded statements in a lexical scope, preserving statement order.";
        return true;
    }
    if sem_is(node, "CoreAssign") {
        *kind = "replacement assignment";
        *description = "Stores into the resolved location after substitution; source and destination types must be compatible.";
        return true;
    }
    if sem_is(node, "CoreOperand") {
        *kind = "replacement value";
        *description = "A value in the replacement; its type is checked in the expanded code.";
        return true;
    }
    if sem_is(node, "CoreBinary") {
        *kind = "replacement binary operation";
        *description = "Applies this operator to the substituted operands, with ordinary type checking and operation semantics.";
        return true;
    }
    if sem_is(node, "CoreTarget") {
        *kind = "assignment destination";
        *description = "Selects the location to store into after capture substitution.";
        return true;
    }
    if sem_is(node, "CoreParameter") {
        *kind = "replacement parameter";
        *description = "Declares a typed parameter on the generated function.";
        return true;
    }
    if sem_is(node, "CoreFunction") {
        *kind = "replacement function";
        *description = "Declares a function; its parameters, result type and body are checked after substitution.";
        return true;
    }
    if sem_is(node, "CoreExternal") {
        *kind = "replacement external function";
        *description = "Declares an external function with an explicit parameter and result signature.";
        return true;
    }
    if sem_is(node, "CoreExport") {
        *kind = "replacement exported function";
        *description = "Declares an exported function with an explicit parameter and result signature.";
        return true;
    }
    if sem_is(node, "CoreStruct") {
        *kind = "replacement struct";
        *description = "Declares a nominal struct; field types and target layout are resolved after substitution.";
        return true;
    }
    if sem_is(node, "CoreField") {
        *kind = "replacement field";
        *description = "Declares a struct field with a type resolved after substitution.";
        return true;
    }
    if sem_is(node, "CoreEnum") {
        *kind = "replacement enum";
        *description = "Declares a nominal integer enum; representation and members are checked after substitution.";
        return true;
    }
    if sem_is(node, "CoreEnumMember") {
        *kind = "replacement enum member";
        *description = "Declares a member of the generated enum with a checked discriminant.";
        return true;
    }
    if sem_is(node, "CoreBreak") {
        *kind = "replacement break";
        *description = "Leaves the enclosing loop in the expanded code.";
        return true;
    }
    if sem_is(node, "CoreContinue") {
        *kind = "replacement continue";
        *description = "Continues the enclosing loop in the expanded code.";
        return true;
    }
    if sem_is(node, "CoreCallStatement") {
        *kind = "replacement call statement";
        *description = "Evaluates this call in statement order after capture substitution.";
        return true;
    }
    if sem_is(node, "CorePointerArgument") {
        *kind = "replacement type argument";
        *description = "Forms a pointer or array argument; its role is resolved by the called function after substitution.";
        return true;
    }
    return false;
}

fn language_template_details(q: CompletionQuery*, leaf: void*, candidate: LanguageCandidate*): void {
    var template = candidate.template;
    language_string(q, "replacementCategory", template.category.data);
    var declaration = language_syntax(language_ancestor(template.node, "GrammarDeclaration"));
    var shared = declaration != null;
    shared &&= declaration.items.length > 1;
    if shared {
        language_number(q, "replacementAlternatives", declaration.items.length);
    }
    var capture = language_template_capture(leaf, template);
    var grammar_condition63 = capture != null;
    if grammar_condition63 {
        var syntax = language_syntax(capture);
        language_string(q, "kind", "capture substitution");
        language_string(q, "capture", syntax.capture.data);
        language_capture_categories(q, declaration, syntax);
        language_string(q, "description", "Inserts the captured syntax subtree here. Its runtime type is resolved from the matched code after substitution.");
        language_grammar_location(q, capture);
        return;
    }
    var grammar_condition64 = candidate.subject != null;
    if grammar_condition64 {
        language_string(q, "kind", language_kind(sem_get(candidate.subject)));
        language_string(q, "description", "Function referenced by the replacement. This is its declared signature; substituted arguments are type-checked when the rule is used.");
        return;
    }
    var node = candidate.node;
    var kind: u8* = "replacement syntax";
    var description: u8* = "Part of the parsed replacement tree; binding and types are resolved after captured nodes are substituted.";
    language_template_role(node, &kind, &description);
    language_string(q, "kind", kind);
    language_string(q, "description", description);
    language_string(q, "category", sem_label(node));
}

fn language_template_walk(q: CompletionQuery*, node: void*, template: LanguageGrammar*, inherited: void*, checked: bool, depth: usize, budget: usize*): void {
    var grammar_condition65 = depth >= 256;
    if grammar_condition65 {
        q.truncated = true;
        return;
    }
    var grammar_condition66 = *budget == 0;
    if grammar_condition66 {
        q.truncated = true;
        return;
    }
    *budget = *budget - 1;
    var selected = inherited;
    // Select constructs from the actual tree, crossing only parser wrappers.
    var kind: u8* = null;
    var description: u8* = null;
    if language_template_role(node, &kind, &description) {
        selected = node;
    }
    var grammar_condition67 = selected == null;
    if grammar_condition67 {
        selected = node;
    }
    var count = sem_child_count(node);
    var grammar_condition68 = count == 0;
    if grammar_condition68 {
        var candidate: LanguageCandidate;
        fill(&candidate, 0, sizeof(LanguageCandidate));
        candidate.node = selected;
        candidate.template = template;
        var span = sem_match(node);
        var grammar_condition69 = span == null;
        if grammar_condition69 {
            return;
        }
        candidate.from = span.start;
        candidate.to = span.start + span.length;
        var capture = language_template_capture(node, template);
        var grammar_condition70 = capture == null;
        if grammar_condition70 {
            if checked {
                var call = language_ancestor(node, "CoreCall");
                var grammar_condition71 = call != null;
                if grammar_condition71 {
                    if language_member_at(node, call, "name") {
                        var name = sem_identifier(&q.context, sem_member(call, "name"));
                        candidate.subject = sem_resolve_from(&q.context, q.context.functions, sem_member(call, "name"), name, sem_owner(&q.context, template.node));
                    }
                }
            }
        }
        language_leaf(q, node, &candidate);
        return;
    }
    var i: usize = 0;
    loop {
        var grammar_condition72 = i == count;
        if grammar_condition72 {
            break;
        }
        var next = depth + 1;
        language_template_walk(q, sem_child(node, i), template, selected, checked, next, budget);
        i++;
    }
}
