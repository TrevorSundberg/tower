import tower;
import lr_analysis;
import parser_nodes;
import parser_types;
import regex_lowering;
import .library.work_buffer;
import .library.work_buffer_types;
import .library.work_arena_api;
import .library.work_arena_types;
import .library.work_budget_types;
import .library.work_vector;
import .library.work_vector_types;
import lr_types;

extern fn compiler_node_world(node: void*): void*;
extern fn compiler_world_work_budget(world: void*): WorkBudget*;

// Derived indexes over ordinary grammar entities. Names/captures are snapshots
// for this table revision; source entities and declaration order remain intact.
struct LRGrammarName {
    text: u8*;
    hash: usize;
    next: usize;
    order: usize;
}

struct LRGrammarRule {
    node: void*;
    generated: bool;
}

struct LRGrammarSymbol {
    node: void*;
    capture: u8*;
}

struct LRUnresolved {
    name: u8*;
    symbol: usize;
}

struct LRGrammar {
    storage: WorkBuffer;
    budget: WorkBudget*;
    // Names and capture strings share this immutable grammar lifetime. The
    // arena keeps their addresses stable while derived index vectors grow.
    snapshots: WorkArena;
    names: work_vector(LRGrammarName*);
    buckets: work_vector(usize);
    rule_storage: WorkBuffer;
    rules: LRProduction*;
    rule_metadata_storage: WorkBuffer;
    rule_metadata: LRGrammarRule*;
    symbols: work_vector(LRSymbol);
    symbol_metadata: work_vector(LRGrammarSymbol);
    unresolved: work_vector(LRUnresolved);
}

// Each snapshot is copied once and remains immutable until grammar retirement.
fn lr_grammar_text(arena: WorkArena*, source: u8*): u8* {
    var length: usize = 0;
    while source[length] != 0 { length++; }
    var bytes = length + 1;
    if bytes == 0 { return null; }
    var text = work_arena_allocate(arena, bytes, alignof(u8));
    if text != null { copy(text, source, bytes); }
    return text;
}

fn lr_name_hash(text: u8*): usize {
    var hash: usize = 2166136261;
    var index: usize = 0;
    loop {
        if text[index] == 0 {
            return hash;
        }
        var byte = convert(usize, text[index]);
        hash = hash ^ byte;
        hash = hash * 16777619;
        index++;
    }
}

fn lr_name_equal(left: u8*, right: u8*): bool {
    var index: usize = 0;
    loop {
        if left[index] != right[index] {
            return false;
        }
        if left[index] == 0 {
            return true;
        }
        index++;
    }
}

fn lr_grammar_lookup(value: LRGrammar*, name: u8*, hash: usize): usize {
    var size = value.buckets.length;
    if size == 0 {
        return lr_none();
    }
    var bucket = hash % size;
    var index = value.buckets.data[bucket];
    loop {
        if index == lr_none() {
            return index;
        }
        var entry = value.names.data[index];
        var same = entry.hash == hash;
        if same {
            same = lr_name_equal(name, entry.text);
            if same {
                return index;
            }
        }
        index = entry.next;
    }
}

fn lr_grammar_name_add(value: LRGrammar*, name: u8*, index: usize*): bool {
    var hash = lr_name_hash(name);
    *index = lr_grammar_lookup(value, name, hash);
    if *index != lr_none() {
        return true;
    }
    var entry = bits(LRGrammarName*, work_arena_allocate(&value.snapshots, sizeof(LRGrammarName), alignof(LRGrammarName)));
    if entry == null { return false; }
    *entry = {text: lr_grammar_text(&value.snapshots, name), hash: hash, ..default};
    var ok = entry.text != null;
    ok &&= work_vector_push(&value.names, value.budget, entry);
    if !ok {
        return false;
    }
    *index = value.names.length - 1;
    // The augmented start name is diagnostic text, not a source-name binding.
    if *index == 0 {
        return true;
    }
    var size = value.buckets.length;
    if size == 0 {
        return false;
    }
    var bucket = hash % size;
    value.names.data[*index].next = value.buckets.data[bucket];
    value.buckets.data[bucket] = *index;
    return true;
}

fn lr_grammar_name_less(value: LRGrammar*, a: usize, b: usize): bool {
    var left = value.names.data[a].text;
    var right = value.names.data[b].text;
    var index: usize = 0;
    loop {
        if left[index] != right[index] {
            var less = left[index] < right[index];
            return less;
        }
        if left[index] == 0 {
            var less = a < b;
            return less;
        }
        index++;
    }
}

fn lr_grammar_name_sift(value: LRGrammar*, order: usize*, count: usize, start: usize): void {
    var root = start;
    loop {
        var child = root *2;
        child++;
        if child >= count {
            return;
        }
        var next = child + 1;
        if next < count {
            var less = lr_grammar_name_less(value, order[child], order[next]);
            if less {
                child = next;
            }
        }
        var less = lr_grammar_name_less(value, order[root], order[child]);
        if !less {
            return;
        }
        var swap = order[root];
        order[root] = order[child];
        order[child] = swap;
        root = child;
    }
}

fn lr_grammar_order(value: LRGrammar*): bool {
    var count = value.names.length;
    if count > ~convert(usize, 0) / sizeof(usize) { return false; }
    var storage: WorkBuffer = default;
    defer work_buffer_dispose(&storage);
    if work_buffer_resize(&storage, value.budget, count * sizeof(usize), 0) != WorkBudgetError.None { return false; }
    var order = bits(usize*, storage.data);
    var index: usize = 0;
    for(; index != count; index++) {
        order[index] = index;
    }
    var start = count / 2;
    loop {
        var end = start == 0;
        if end {
            break;
        }
        start--;
        lr_grammar_name_sift(value, order, count, start);
    }
    var remaining = count;
    loop {
        var end = remaining <= 1;
        if end {
            break;
        }
        remaining--;
        var swap = order[0];
        order[0] = order[remaining];
        order[remaining] = swap;
        lr_grammar_name_sift(value, order, remaining, 0);
    }
    index = 0;
    for(; index != count; index++) {
        var original = order[index];
        value.names.data[original].order = index;
    }
    return true;
}

export fn lr_grammar_destroy(value: LRGrammar*): void {
    if value == null {
        return;
    }
    work_vector_dispose(&value.names);
    work_vector_dispose(&value.buckets);
    work_buffer_dispose(&value.rule_storage);
    work_buffer_dispose(&value.rule_metadata_storage);
    work_vector_dispose(&value.symbols);
    work_vector_dispose(&value.symbol_metadata);
    work_vector_dispose(&value.unresolved);
    work_arena_dispose(&value.snapshots);
    var storage = value.storage;
    work_buffer_dispose(&storage);
}

fn lr_grammar_payload(node: void*, kind: void*): void* {
    var component = entity_component_get(node, kind);
    return entity_component_data(component);
}

fn lr_grammar_add_symbol(value: LRGrammar*, symbol: LRSymbol*, node: void*, capture: u8*): bool {
    var metadata: LRGrammarSymbol = default;
    metadata.node = node;
    var ok = true;
    if *capture != 0 {
        metadata.capture = lr_grammar_text(&value.snapshots, capture);
        ok = metadata.capture != null;
    }
    ok &&= work_vector_push(&value.symbol_metadata, value.budget, metadata);
    if !ok {
        return false;
    }
    return work_vector_push(&value.symbols, value.budget, *symbol);
}

fn lr_grammar_rules(value: LRGrammar*, root: void*, kind: void*): bool {
    var count = entity_child_count(root);
    if count > (~convert(usize, 0) - 1) / 2 { return false; }
    // Every source rule contributes exactly one record, plus the augmented
    // start rule. These frozen columns never need vector growth or spare slots.
    var rule_count = count + 1;
    if rule_count > ~convert(usize, 0) / sizeof(LRProduction)
        || rule_count > ~convert(usize, 0) / sizeof(LRGrammarRule) { return false; }
    if work_buffer_resize(&value.rule_storage, value.budget, rule_count * sizeof(LRProduction), 0) != WorkBudgetError.None
        || work_buffer_resize(&value.rule_metadata_storage, value.budget,
            rule_count * sizeof(LRGrammarRule), 0) != WorkBudgetError.None { return false; }
    value.rules = bits(LRProduction*, value.rule_storage.data);
    value.rule_metadata = bits(LRGrammarRule*, value.rule_metadata_storage.data);
    var size = count *2;
    size++;
    var ok = work_vector_reserve(&value.buckets, value.budget, size);
    if !ok {
        return false;
    }
    value.buckets.length = size;
    var bytes = size *sizeof(usize);
    fill(value.buckets.data, 255, bytes);
    var index: usize;
    ok = lr_grammar_name_add(value, "S'", &index);
    if !ok {
        return false;
    }
    var rule: LRProduction = default;
    var metadata: LRGrammarRule = default;
    value.rules[0] = rule;
    value.rule_metadata[0] = metadata;
    index = 0;
    loop {
        if index == count {
            return lr_grammar_order(value);
        }
        metadata.node = entity_child_at(root, index);
        var data = lr_grammar_payload(metadata.node, kind);
        var source = bits(ParserRuleData*, data);
        if source == null {
            return false;
        }
        metadata.generated = source.generated;
        rule.precedence = source.precedence;
        rule.associativity = source.associativity;
        ok = lr_grammar_name_add(value, node_rule_name(source), &rule.owner);
        if !ok {
            return false;
        }
        value.rules[index + 1] = rule;
        value.rule_metadata[index + 1] = metadata;
        index++;
    }
}

fn lr_grammar_symbols(value: LRGrammar*, reference_kind: void*, string_kind: void*, range_kind: void*): bool {
    var symbol: LRSymbol = { first: LRTokenEnd, last: LRTokenEnd, nonterminal: 1 };
    var present = value.names.length > 1;
    if present {
        var ok = lr_grammar_add_symbol(value, &symbol, null, "");
        if !ok {
            return false;
        }
        value.rules[0].count = 1;
    }
    var rule_index: usize = 1;
    loop {
        var done = rule_index == lr_grammar_rule_count(value);
        if done {
            return true;
        }
        var rule = &value.rules[rule_index];
        var source = value.rule_metadata[rule_index].node;
        rule.begin = value.symbols.length;
        var count = entity_child_count(source);
        var index: usize = 0;
        loop {
            done = index == count;
            if done {
                break;
            }
            var node = entity_child_at(source, index);
            var data = lr_grammar_payload(node, reference_kind);
            var reference = bits(ParserReferenceData*, data);
            present = reference != null;
            if present {
                var name = node_reference_name(reference);
                var hash = lr_name_hash(name);
                symbol.nonterminal = lr_grammar_lookup(value, name, hash);
                symbol.first = LRTokenEnd;
                symbol.last = LRTokenEnd;
                var unresolved = symbol.nonterminal == lr_none();
                if unresolved {
                    var pending: LRUnresolved;
                    pending.name = name;
                    pending.symbol = value.symbols.length;
                    var ok = work_vector_push(&value.unresolved, value.budget, pending);
                    if !ok {
                        return false;
                    }
                }
                var capture = node_reference_capture(reference);
                var ok = lr_grammar_add_symbol(value, &symbol, node, capture);
                if !ok {
                    return false;
                }
            }
            data = lr_grammar_payload(node, string_kind);
            var string = bits(ParserStringData*, data);
            present = string != null;
            if present {
                var position: usize = 0;
                loop {
                    done = position == string.ids.length;
                    if done {
                        break;
                    }
                    symbol.nonterminal = lr_none();
                    symbol.first = string.ids.data[position];
                    symbol.last = symbol.first;
                    var ok = lr_grammar_add_symbol(value, &symbol, node, "");
                    if !ok {
                        return false;
                    }
                    position++;
                }
            }
            data = lr_grammar_payload(node, range_kind);
            var range = bits(ParserRangeData*, data);
            present = range != null;
            if present {
                symbol.nonterminal = lr_none();
                symbol.first = range.start;
                symbol.last = range.end;
                if symbol.first > symbol.last {
                    symbol.first = range.end;
                    symbol.last = range.start;
                }
                var ok = lr_grammar_add_symbol(value, &symbol, node, "");
                if !ok {
                    return false;
                }
            }
            index++;
        }
        rule.count = value.symbols.length - rule.begin;
        rule_index++;
    }
}

export fn lr_grammar_create(root: void*, rule_kind: void*, reference_kind: void*, string_kind: void*, range_kind: void*): LRGrammar* {
    var budget = compiler_world_work_budget(compiler_node_world(root));
    var storage: WorkBuffer = default;
    if work_buffer_resize(&storage, budget, sizeof(LRGrammar), 0) != WorkBudgetError.None { return null; }
    var value = bits(LRGrammar*, storage.data);
    *value = {storage: storage, budget: budget, ..default};
    var chunk_bytes = sizeof(WorkArenaChunk) + WorkBufferInitialElements * sizeof(LRGrammarName);
    if !work_arena_init(&value.snapshots, budget, chunk_bytes) {
        lr_grammar_destroy(value);
        return null;
    }
    var ok = lr_grammar_rules(value, root, rule_kind);
    ok &&= lr_grammar_symbols(value, reference_kind, string_kind, range_kind);
    if ok {
        // Name lookup is finished. Runtime tables only need the ordered names.
        work_vector_dispose(&value.buckets);
        return value;
    }
    lr_grammar_destroy(value);
    return null;
}

export fn lr_grammar_rule_count(value: LRGrammar*): usize {
    return value.rule_storage.capacity / sizeof(LRProduction);
}

export fn lr_grammar_rule_data(value: LRGrammar*): LRProduction* {
    return value.rules;
}

export fn lr_grammar_rule_node(value: LRGrammar*, index: usize): void* {
    return value.rule_metadata[index].node;
}

export fn lr_grammar_generated(value: LRGrammar*, index: usize): bool {
    return value.rule_metadata[index].generated;
}

export fn lr_grammar_symbol_count(value: LRGrammar*): usize {
    return value.symbols.length;
}

export fn lr_grammar_symbol_data(value: LRGrammar*): LRSymbol* {
    return value.symbols.data;
}

export fn lr_grammar_symbol_node(value: LRGrammar*, index: usize): void* {
    return value.symbol_metadata.data[index].node;
}

export fn lr_grammar_capture(value: LRGrammar*, index: usize): u8* {
    var capture = value.symbol_metadata.data[index].capture;
    return capture == null ? "" : capture;
}

export fn lr_grammar_name_count(value: LRGrammar*): usize {
    return value.names.length;
}

export fn lr_grammar_name(value: LRGrammar*, index: usize): u8* {
    return value.names.data[index].text;
}

export fn lr_grammar_name_order(value: LRGrammar*, index: usize): usize {
    return value.names.data[index].order;
}

export fn lr_grammar_missing_count(value: LRGrammar*): usize {
    return value.unresolved.length;
}

export fn lr_grammar_missing_name(value: LRGrammar*, index: usize): u8* {
    return value.unresolved.data[index].name;
}

export fn lr_grammar_resolve(value: LRGrammar*, index: usize, id: u32): bool {
    var invalid = index >= value.unresolved.length;
    if invalid {
        return false;
    }
    invalid = id == LRTokenEnd;
    if invalid {
        return false;
    }
    var position = value.unresolved.data[index].symbol;
    value.symbols.data[position].first = id;
    value.symbols.data[position].last = id;
    return true;
}

// First unresolved name, or lr_none(). Share this check across table owners.
export fn lr_grammar_pending(value: LRGrammar*): usize {
    for(var index: usize = 0; index < value.unresolved.length; index++) {
        var symbol = value.unresolved.data[index].symbol;
        if value.symbols.data[symbol].first == LRTokenEnd {
            return index;
        }
    }
    return lr_none();
}

// Source-node addresses are construction-only. Keep numeric records when the
// table's diagnostics/trace views still consume them; never rebuild native copies.
export fn lr_grammar_detach(value: LRGrammar*): void {
    work_vector_dispose(&value.unresolved);
    var index: usize = 0;
    for(; index != value.rule_metadata_storage.capacity / sizeof(LRGrammarRule); index++) {
        value.rule_metadata[index].node = null;
    }
    index = 0;
    for(; index != value.symbol_metadata.length; index++) {
        value.symbol_metadata.data[index].node = null;
    }
}

// Compact readers only need generated flags, labels and captures after build.
export fn lr_grammar_finish(value: LRGrammar*): void {
    lr_grammar_detach(value);
    work_buffer_dispose(&value.rule_storage);
    value.rules = null;
    work_vector_dispose(&value.symbols);
}
