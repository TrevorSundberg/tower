import library.testing;

// A null label requests the total count. Otherwise count that label in the real IDE response.
extern fn defer_completion_count(fixture: u8*, cursor: usize, label: u8*): usize;

test() {
    assert(defer_completion_count("complete_cleanup", 45, "cleanup") == 1);
    assert(defer_completion_count("complete_local", 55, "local") == 1);
    assert(defer_completion_count("complete_private", 59, "private") == 0);
    assert(defer_completion_count("complete_shadow", 116, null) == 0);
    assert(defer_completion_count("complete_return", 40, "return") == 0);
    assert(defer_completion_count("complete_outer_break", 31, "break") == 0);
    assert(defer_completion_count("complete_inner_break", 31, "break") == 1);
}
