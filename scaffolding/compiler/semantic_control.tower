import tower;
import foundation_tags;
import semantic_context;
import semantic_expressions;
import semantic_statements;
import semantic_support;
import semantic_types;
import semantic_values;
import semantic_flow;
import .library.vector;

// Control-flow outcomes are a private analysis bit set, not program opcodes.
var FlowNext: u32 = 1;
var FlowBreak: u32 = 2;
var FlowContinue: u32 = 4;
var FlowReturn: u32 = 8;
var MatchArmLimit: usize = 128;

// Capture every spelling, including quoted/free uses, before generating names.
// Bind operands directly; unique serialized names also preserve reparse hygiene.
fn sem_control_names(c: SemanticContext*): void {
    var missing = c.control_names == null;
    if missing {
        c.control_names = sem_table(c);
        var pending = sem_list(c);
        sem_push(pending, c.program.root);
        loop {
            var done = pending.length == 0;
            if done {
                break;
            }
            pending.length--;
            var node = pending.data[pending.length];
            var terminal = sem_match(node);
            var leaf = terminal != null;
            leaf &&= terminal.rule == sem_maximum();
            if leaf {
                // Token leaves store their spelling, not the label Identifier.
                // Including other terminals is conservative and also supports
                // local Identifier overrides without duplicating terminal rules.
                var name = sem_text(c, terminal.label.data, terminal.label.length);
                sem_decode_identifier(name);
                sem_put(c, c.control_names, name, node);
            } else {
                var i: usize = 0;
                var count = sem_child_count(node);
                loop {
                    done = i == count;
                    if done {
                        break;
                    }
                    sem_push(pending, sem_child(node, i));
                    i++;
                }
            }
        }
    }
}

fn sem_control_name(c: SemanticContext*): u8* {
    if c.control_reserved == null {
        sem_control_names(c);
    }
    else {
        if c.control_names == null {
            c.control_names = sem_table(c);
        }
    }
    var prefix = c.control_prefix == null ? "control value ": c.control_prefix;
    var index = c.control_names.count;
    loop {
        var name = sem_cat(c, prefix, sem_decimal(c, convert(u64, index)));
        var exists = sem_lookup_table(c.control_names, name) != null;
        if !exists && c.control_reserved != null {
            exists = sem_lookup_table(c.control_reserved, name) != null;
        }
        if !exists {
            sem_put(c, c.control_names, name, c.program.root);
            return name;
        }
        index++;
    }
}

fn sem_control_node(c: SemanticContext*, parent: void*, kind: u32): void* {
    var entity = c.entity_stage == null ? sem_create(parent): entity_stage_create(c.entity_stage, parent);
    sem_require(entity != null);
    sem_node(c, entity, kind);
    return entity;
}

fn sem_control_read(c: SemanticContext*, parent: void*, local: void*): void* {
    var entity = sem_control_node(c, parent, KOperand);
    var value = sem_get(entity);
    value.binding = local;
    var binding = sem_get(local);
    sem_set_type(&value.type, &binding.type);
    return entity;
}

fn sem_control_literal(c: SemanticContext*, parent: void*, bit: u64): void* {
    var entity = sem_control_node(c, parent, KOperand);
    var value = sem_get(entity);
    sem_set_type(&value.type, sem_type_new(c, SBool, 0, null));
    value.constant = true;
    value.bits = bit;
    return entity;
}

fn sem_control_local(c: SemanticContext*, block: void*, initial: void*): void* {
    var initializer = sem_get(initial);
    if initializer.kind == KConvert && initializer.type.pointers == 0 && semantic_enum(&initializer.type) {
        var operand = sem_get(initializer.value);
        if operand != null && operand.constant {
            // Keep the source literal's exact type in compilable Foundation,
            // including u64 values that cannot use the default i32 context.
            var source = sem_control_local(c, block, initializer.value);
            initializer.value = sem_control_read(c, initial, source);
        }
    }
    var entity = sem_control_node(c, block, KDeclare);
    var value = sem_get(entity);
    sem_set_name(value, sem_control_name(c));
    sem_set_type(&value.type, &initializer.type);
    value.value = initial;
    sem_add_local(c, entity);
    var owner = sem_get(block);
    if block != c.current {
        sem_push(&owner.locals, entity);
    }
    var global = block == c.program.root;
    if global {
        value.global = true;
    }
    sem_push(&owner.items, entity);
    return entity;
}

fn sem_control_branch(c: SemanticContext*, block: void*, condition: void*, body: void*): void* {
    var entity = sem_control_node(c, block, KIf);
    var value = sem_get(entity);
    value.value = condition;
    value.body = body;
    value.otherwise = sem_control_node(c, entity, KBlock);
    var owner = sem_get(block);
    sem_push(&owner.items, entity);
    return value.otherwise;
}

fn sem_control_equal(c: SemanticContext*, block: void*, subject: void*, pattern: void*): void* {
    var entity = sem_control_node(c, block, KBinary);
    var value = sem_get(entity);
    value.op = OEq;
    value.left = sem_control_read(c, entity, subject);
    value.right = pattern;
    sem_set_type(&value.type, sem_type_new(c, SBool, 0, null));
    var local = sem_control_local(c, block, entity);
    return sem_control_read(c, block, local);
}

// Private checking state only. Arm operations remain on their Foundation nodes.
// Prepare each pattern immediately before its body to preserve diagnostic order.
struct SemanticMatchCursor {
    arms: vector(void*)*;
    patterns: vector(void*)*;
    subject: void*;
    fallback: void*;
    block: void*;
    condition: void*;
    body: void*;
    depth: u32;
    index: usize;
    flow: u32;
}

fn sem_control_match_arm(c: SemanticContext*, state: SemanticMatchCursor*): bool {
    if state.index == state.arms.length {
        state.body = sem_member(state.fallback, "body");
        return true;
    }
    var arm = state.arms.data[state.index];
    var choices = sem_collect(c, sem_member(arm, "patterns"), "TowerMatchLiteral");
    if choices.length == 0 {
        sem_fail(c, arm, "A match arm needs a literal pattern");
        return false;
    }
    var block = state.block;
    var type = &sem_get(state.subject).type;
    var multiple = choices.length > 1;
    var selected: void* = null;
    if multiple {
        selected = sem_control_local(c, block, sem_control_literal(c, block, 0));
    }
    var condition: void* = null;
    for(var j: usize = 0; j < choices.length; j++) {
        var syntax = choices.data[j];
        if sem_child_count(syntax) == 1 {
            syntax = sem_child(syntax, 0);
        }
        var pattern = sem_operand(c, syntax, type);
        if !sem_ok(c) {
            return false;
        }
        var literal = sem_get(pattern);
        if !literal.constant {
            sem_fail(c, syntax, "Match patterns must be literals or enum members");
            return false;
        }
        foreach(var prior in state.patterns) {
            if literal.bits == sem_get(prior).bits {
                sem_fail(c, choices.data[j], "Duplicate match pattern");
                return false;
            }
        }
        sem_push(state.patterns, pattern);
        condition = sem_control_equal(c, block, state.subject, pattern);
        if multiple {
            var hit = sem_control_node(c, block, KBlock);
            var store = sem_control_node(c, hit, KAssign);
            var assignment = sem_get(store);
            assignment.target = sem_control_read(c, store, selected);
            assignment.value = sem_control_literal(c, store, 1);
            sem_push(&sem_get(hit).items, store);
            sem_control_branch(c, block, condition, hit);
        }
    }
    state.condition = multiple ? sem_control_read(c, block, selected) : condition;
    state.body = sem_member(arm, "body");
    return true;
}

fn sem_control_match_begin(c: SemanticContext*, n: void*, depth: u32, state: SemanticMatchCursor*): bool {
    *state = default;
    var initial = sem_expression(c, sem_member(n, "value"), null);
    if !sem_ok(c) {
        return false;
    }
    var initializer = sem_get(initial);
    var type = &initializer.type;
    var eligible = semantic_integer(type);
    var boolean = type.scalar == SBool;
    var scalar = type.pointers == 0;
    if boolean {
        eligible = scalar;
    }
    if !eligible {
        sem_fail(c, n, "match requires an integer or bool subject");
        return false;
    }
    var arms = sem_collect(c, sem_member(n, "arms"), "TowerMatchArm");
    if arms.length > MatchArmLimit {
        sem_fail(c, n, "match supports at most 128 arms");
        return false;
    }
    var lowered_depth = convert(usize, depth) + arms.length;
    lowered_depth = lowered_depth + 3;
    if lowered_depth > 128 {
        sem_fail(c, n, "match lowering exceeds Foundation block nesting limit of 128");
        return false;
    }
    var fallback = sem_member(n, "fallback");
    if !sem_shape(c, fallback, "body") {
        return false;
    }
    sem_node(c, n, KBlock);
    state.arms = arms;
    state.patterns = sem_list(c);
    state.subject = sem_control_local(c, n, initial);
    state.fallback = fallback;
    state.block = n;
    state.depth = depth;
    return sem_control_match_arm(c, state);
}

fn sem_control_match_advance(c: SemanticContext*, state: SemanticMatchCursor*, flow: u32): bool {
    state.flow |= flow;
    if state.index == state.arms.length {
        sem_push(&sem_get(state.block).items, state.body);
        return false;
    }
    if !sem_ok(c) {
        state.flow = FlowNext;
        return false;
    }
    state.block = sem_control_branch(c, state.block, state.condition, state.body);
    state.index++;
    if !sem_control_match_arm(c, state) {
        state.flow = FlowNext;
        return false;
    }
    return true;
}

fn sem_control_match(c: SemanticContext*, n: void*, depth: u32): u32 {
    var state: SemanticMatchCursor;
    if !sem_control_match_begin(c, n, depth, &state) {
        return FlowNext;
    }
    loop {
        var flow = sem_block(c, state.body, state.depth + convert(u32, state.index) + 1);
        if !sem_control_match_advance(c, &state, flow) {
            return state.flow;
        }
    }
}

// Shared checking continuation for surface loops. The Foundation entities keep
// the operations; this record retains header bindings across a body suspension.
struct SemanticLoopCursor {
    condition: void*;
    update: void*;
    block: void*;
    guard: void*;
    saved: SemanticScope*;
    initial_flow: u32;
}

fn sem_control_while_begin(c: SemanticContext*, n: void*, state: SemanticLoopCursor*): bool {
    *state = default;
    var condition = sem_expression(c, sem_member(n, "condition"), sem_type_new(c, SBool, 0, null));
    if !sem_ok(c) {
        return false;
    }
    var value = sem_node(c, n, KLoop);
    var block = sem_control_node(c, n, KBlock);
    value.body = block;
    var known = sem_get(condition);
    var guard = condition;
    // Keep literal conditions visible to Foundation's definite-return analysis.
    // Nonliteral values need a local so a binary condition has a legal spelling.
    if !known.constant {
        var local = sem_control_local(c, block, condition);
        guard = sem_control_read(c, block, local);
    }
    state.condition = condition;
    state.block = block;
    state.guard = guard;
    return true;
}

fn sem_control_while_finish(c: SemanticContext*, n: void*, state: SemanticLoopCursor*, flow: u32): u32 {
    var condition = state.condition;
    var known = sem_get(condition);
    var block = state.block;
    var guard = state.guard;
    var body = sem_member(n, "body");
    var otherwise = sem_control_branch(c, block, guard, body);
    var stop = sem_control_node(c, otherwise, KBreak);
    var failure = sem_get(otherwise);
    sem_push(&failure.items, stop);
    var result = flow &FlowReturn;
    if sem_flow_known(c, condition) {
        var never = known.bits == 0;
        if never {
            return FlowNext;
        }
        var exits = flow &FlowBreak;
        if exits != 0 {
            result = result | FlowNext;
        }
        return result;
    }
    result = result | FlowNext;
    return result;
}

fn sem_control_while(c: SemanticContext*, n: void*, depth: u32): u32 {
    var state: SemanticLoopCursor;
    if !sem_control_while_begin(c, n, &state) {
        return FlowNext;
    }
    c.loops++;
    var flow = sem_block(c, sem_member(n, "body"), depth + 1);
    c.loops--;
    return sem_control_while_finish(c, n, &state, flow);
}

// The header owns a scope; body locals never affect binding of the test/update.
// Only existing Foundation nodes survive lowering. Most counted loops append the
// update directly. A reachable continue requires moving it to the next loop head,
// guarded on the first entry; this preserves effects without duplicating updates
// or rewriting continues belonging to nested loops.
fn sem_control_for_begin(c: SemanticContext*, n: void*, depth: u32, state: SemanticLoopCursor*): bool {
    *state = default;
    if depth > 125 {
        sem_fail(c, n, "for lowering exceeds Foundation block nesting limit of 128");
        return false;
    }
    var value = sem_node(c, n, KBlock);
    var saved = c.scope;
    c.scope = sem_scope(c, saved);
    var initial = sem_child(sem_member(n, "initial"), 0);
    var initial_flow = FlowNext;
    if !sem_is(initial, ";") {
        initial_flow = sem_statement(c, initial, depth + 1);
        // The statement checker attaches jump semantics to its call entity,
        // exactly as ordinary block statements do.
        var jump = sem_control_call(c, initial, "jump");
        if jump != null {
            initial = jump;
        }
        sem_push(&value.items, initial);
    }
    var condition_syntax = sem_member(n, "condition");
    var condition: void* = null;
    if sem_child_count(condition_syntax) == 0 {
        condition = sem_control_literal(c, n, 1);
    } else {
        condition = sem_operand(c, sem_child(condition_syntax, 0), sem_type_new(c, SBool, 0, null));
    }
    var step_syntax = sem_member(n, "step");
    var update: void* = null;
    if sem_child_count(step_syntax) != 0 && sem_ok(c) {
        c.surface_expressions = true;
        update = sem_control_node(c, n, SurfaceDiscard);
        sem_get(update).value = sem_surface_discard(c, sem_child(step_syntax, 0));
    }
    state.saved = saved;
    state.condition = condition;
    state.update = update;
    state.initial_flow = initial_flow;
    return true;
}

fn sem_control_for_finish(c: SemanticContext*, n: void*, state: SemanticLoopCursor*, flow: u32): u32 {
    var value = sem_get(n);
    var saved = state.saved;
    var condition = state.condition;
    var update = state.update;
    var initial_flow = state.initial_flow;
    var body = sem_member(n, "body");
    sem_scope_locals(c, c.scope, &value.locals);
    c.scope = saved;
    if !sem_ok(c) {
        return FlowNext;
    }

    var loop_node = sem_control_node(c, n, KLoop);
    var block = sem_control_node(c, loop_node, KBlock);
    sem_get(loop_node).body = block;
    var repeats = flow &FlowContinue;
    if update != null && repeats != 0 {
        var first = sem_control_local(c, n, sem_control_literal(c, n, 1));
        var start = sem_control_node(c, block, KBlock);
        var store = sem_control_node(c, start, KAssign);
        sem_get(store).target = sem_control_read(c, store, first);
        sem_get(store).value = sem_control_literal(c, store, 0);
        sem_push(&sem_get(start).items, store);
        var next = sem_control_branch(c, block, sem_control_read(c, block, first), start);
        sem_push(&sem_get(next).items, update);
    }
    sem_push(&value.items, loop_node);
    var known = sem_get(condition);
    var guard = condition;
    if !known.constant {
        guard = sem_control_read(c, block, sem_control_local(c, block, condition));
    }
    var otherwise = sem_control_branch(c, block, guard, body);
    sem_push(&sem_get(otherwise).items, sem_control_node(c, otherwise, KBreak));
    if update != null && repeats == 0 {
        sem_push(&sem_get(block).items, update);
    }
    if(initial_flow &FlowNext) == 0 {
        return initial_flow;
    }
    var result = flow &FlowReturn;
    if sem_flow_known(c, condition) {
        if known.bits == 0 {
            return FlowNext;
        }
        if(flow &FlowBreak) != 0 {
            result |= FlowNext;
        }
        return result;
    }
    return result | FlowNext;
}

fn sem_control_for(c: SemanticContext*, n: void*, depth: u32): u32 {
    var state: SemanticLoopCursor;
    if !sem_control_for_begin(c, n, depth, &state) {
        return FlowNext;
    }
    c.loops++;
    var flow = sem_block(c, sem_member(n, "body"), depth + 2);
    c.loops--;
    return sem_control_for_finish(c, n, &state, flow);
}
