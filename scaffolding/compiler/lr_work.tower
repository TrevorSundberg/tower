extern fn entity_create_related(anchor: void*): void*;
extern fn entity_create_related_result(anchor: void*, error: WorkBudgetError*): void*;

extern fn entity_attach(child: void*, parent: void*, name: u8*): bool;
extern fn entity_attach_result(child: void*, parent: void*, name: u8*): WorkBudgetError;

extern fn entity_release(entity: void*): usize;

extern fn entity_register_stage_result(type: void*, size: usize, alignment: usize, lifecycle: usize, stage_rows: u8): WorkBudgetError;

extern fn entity_component_add(node: void*, type: void*): void*;
extern fn entity_component_add_result(node: void*, type: void*, error: WorkBudgetError*): void*;

extern fn entity_component_data(component: void*): void*;

extern fn entity_view_open(anchor: void*): void*;
extern fn entity_view_open_result(anchor: void*, error: WorkBudgetError*): void*;

extern fn entity_view_close(view: void*): void;

struct LRClosureTask {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    analysis: LRAnalysis*;
    items: LRItem*;
    needed: u8*;
    closures: LRKernelClosure**;
    begin: usize;
    count: usize;
    resource_error: WorkBudgetError;
}

struct LRActionTask {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    states: LRStates*;
    lookahead: LRPropagation*;
    results: work_vector(LRAction)*;
    begin: usize;
    count: usize;
    resource_error: WorkBudgetError;
    observer: GrammarObserver;
    ordinal: usize;
}

export fn compiler_lr_action_kernel(payload: void*): void {
    var task = bits(LRActionTask*, payload);
    if task.observer.event != null { task.observer.event(task.observer.context, GrammarPhase.LookaheadKernel, true, task.ordinal, task.count); }
    defer { if task.observer.event != null { task.observer.event(task.observer.context, GrammarPhase.LookaheadKernel, false, task.ordinal, task.count); } }
    task.resource_error = WorkBudgetError.None;
    for(var i = task.begin; i < task.begin + task.count; i++) {
        task.resource_error = lr_lalr_state_actions_result(task.states, task.lookahead, i, &task.results[i]);
        if task.resource_error != WorkBudgetError.None { return; }
    }
}

// Scheduling grain only, not a grammar or semantic limit. A job amortizes its
// ECS/query/semaphore handoff over a contiguous set of dotted productions.
var LRClosureGrain: usize = 512;
var LRLookaheadStateGrain: usize = 128;
// Item-graph frontiers have cheap range unions: the former 64 destinations
// dispatched621 waves/173ms in the cold16-body trace, despite cached pools.
// Amortize private-vector/ticket/lease/signal joins over512 ready destinations
// per lane; narrow frontiers retain the existing in-place worklist fallback.
// This is a measured scheduling grain, never a grammar or worker-count limit.
var LRPropagationGrain: usize = 512;

// Only immutable grammar/FIRST data are shared. LRAnalysis.failed is private:
// the ordinary closure routines may set it on allocation failure.
export fn compiler_lr_kernel(payload: void*): void {
    var task = bits(LRClosureTask*, payload);
    var analysis: LRAnalysis;
    copy(&analysis, task.analysis, sizeof(LRAnalysis));
    analysis.closure_scratch = null;
    defer lr_analysis_scratch_dispose(&analysis);
    task.resource_error = WorkBudgetError.None;
    for(var i = task.begin; i < task.begin + task.count; i++) {
        if task.needed[i] == 0 {
            continue;
        }
        task.closures[i] = lr_kernel_closure_result(&analysis, &task.items[i], &task.resource_error);
        if task.closures[i] == null { return; }
    }
}

fn lr_work_node(parent: void*): void* {
    var error = WorkBudgetError.None;
    return lr_work_node_result(parent, &error);
}

fn lr_work_node_result(parent: void*, error: WorkBudgetError*): void* {
    var node = entity_create_related_result(parent, error);
    if node == null {
        return null;
    }
    *error = entity_attach_result(node, parent, null);
    if *error != WorkBudgetError.None {
        entity_release(node);
        return null;
    }
    entity_release(node);
    return node;
}

fn lr_work_error(graph: WorkGraph*): WorkBudgetError {
    // Logical ticket/reset/cancellation failures do not imply an allocation.
    return graph.resource_error != WorkBudgetError.None ? graph.resource_error : WorkBudgetError.Invalid;
}

// Lookahead has reached its fixed point before admission. Workers read those
// immutable ranges and state inputs; each owns a contiguous range of private
// vectors. Keep the existing closure pool alive across this phase boundary.
fn lr_lalr_actions_parallel_result(value: LRStates*, lookahead: LRPropagation*, owner: void*,
graph: WorkGraph*, pool: WorkPool*): WorkBudgetError {
    var world = compiler_node_world(owner);
    var observer: GrammarObserver = default;
    if world != null { observer = compiler_world_grammar(world).observer; }
    var count = value.states.length / LRLookaheadStateGrain;
    if count > pool.count {
        count = pool.count;
    }
    if count < 2 {
        return lr_lalr_actions_result(value, lookahead);
    }
    var admission: ParserAdmission = default;
    var error = parser_admission_open_result(&admission, owner, count);
    if error != WorkBudgetError.None { return error; }
    defer parser_admission_close(&admission, graph);
    if admission.extra == 0 { return lr_lalr_actions_result(value, lookahead); }
    if !work_reset(graph, graph.revision + 1, graph.profile) {
        return lr_work_error(graph);
    }
    if value.states.length > ~convert(usize, 0) / sizeof(work_vector(LRAction)) { return WorkBudgetError.Invalid; }
    var storage: WorkBuffer = default;
    error = work_buffer_resize(&storage, value.analysis.budget, value.states.length * sizeof(work_vector(LRAction)), 0);
    if error != WorkBudgetError.None { return error; }
    defer work_buffer_dispose(&storage);
    var results = bits(work_vector(LRAction)*, storage.data);
    fill(results, 0, value.states.length *sizeof(work_vector(LRAction)));
    defer {
        for(var i: usize = 0; i < value.states.length; i++) {
            work_vector_dispose(&results[i]);
        }
    }
    var kind = lr_work_node_result(owner, &error);
    if kind == null { return error; }
    var registered = entity_register_stage_result(kind, sizeof(LRActionTask), alignof(LRActionTask), 0, 0);
    if registered != WorkBudgetError.None { return registered; }
    var jobs: LRActionTask*[WorkPoolMaximumCapacity];
    var position: usize = 0;
    for(var i: usize = 0; i < count; i++) {
        var node = lr_work_node_result(owner, &error);
        if node == null {
            return error;
        }
        var job = bits(LRActionTask*, entity_component_data(entity_component_add_result(node, kind, &error)));
        if job == null {
            return error;
        }
        fill(job, 0, sizeof(LRActionTask));
        job.kernel.kind = CompilerKernelKind.LRAction;
        job.kernel.payload = bits(void*, job);
        job.states = value;
        job.lookahead = lookahead;
        job.results = results;
        job.observer = observer;
        job.ordinal = i;
        job.begin = position;
        job.count = value.states.length / count +(i < value.states.length % count ? 1: 0);
        position += job.count;
        jobs[i] = job;
        var id = work_request(graph, node, 2, convert(u64, job.begin));
        var ok = id != 0;
        ok &&= work_access(graph, id, 1, 3, job.begin, job.count, WorkAccessMode.Write);
        ok &&= work_access(graph, id, 1, 2, 0, 1, WorkAccessMode.Read);
        ok &&= work_seal(graph, id);
        ok &&= work_demand(graph, id);
        ok &&= work_take(graph, &job.ticket);
        if !ok {
            return lr_work_error(graph);
        }
    }
    var view = entity_view_open_result(owner, &error);
    if view == null {
        return error;
    }
    if observer.event != null { observer.event(observer.context, GrammarPhase.ActionWave, true, count, value.states.length); }
    error = compiler_kernel_dispatch_admitted_result(pool, &jobs[0], count, admission.extra);
    if observer.event != null { observer.event(observer.context, GrammarPhase.ActionWave, false, count, value.states.length); }
    entity_view_close(view);
    if error != WorkBudgetError.None { return error; }
    var ok = true;
    for(var i: usize = 0; i < count; i++) {
        if !work_finish(graph, &jobs[i].ticket, jobs[i].resource_error == WorkBudgetError.None) {
            ok = false;
        }
    }
    if !ok {
        return lr_work_error(graph);
    }
    for(var i: usize = 0; i < count; i++) {
        if jobs[i].resource_error != WorkBudgetError.None { return jobs[i].resource_error; }
    }
    for(var i: usize = 0; i < value.states.length; i++) {
        var state = value.states.data[i];
        var actions = &state.actions;
        if !state.actions_owned {
            *actions = results[i];
            state.actions_owned = true;
            results[i] = default;
        } else { work_vector_move(actions, &results[i]); }
    }
    return WorkBudgetError.None;
}

struct LRLinkTask {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    states: LRStates*;
    cache: LRKernelClosure**;
    cache_count: usize;
    links: work_vector(LRPropagationLink);
    begin: usize;
    count: usize;
    resource_error: WorkBudgetError;
}

export fn compiler_lr_link_kernel(payload: void*): void {
    var task = bits(LRLinkTask*, payload);
    task.resource_error = WorkBudgetError.None;
    for(var i = task.begin; i < task.begin + task.count; i++) {
        task.resource_error = lr_lalr_state_links_result(task.states, task.cache, task.cache_count, i, &task.links);
        if task.resource_error != WorkBudgetError.None { return; }
    }
}

// Link lookup/closure traversal runs independently for each state range. Only
// after every job joins, replay its ordered publication records into the same
// graph used by serial construction. No worker changes pending queues, state
// bases, caches, grammar entities or another job's allocation headers.
fn lr_states_propagation_parallel_result(value: LRStates*, constructs: bool, cache: LRKernelClosure**, cache_count: usize,
owner: void*, graph: WorkGraph*, pool: WorkPool*, error: WorkBudgetError*): LRPropagation* {
    var count = value.states.length / LRLookaheadStateGrain;
    if count > pool.count {
        count = pool.count;
    }
    if count < 2 {
        return lr_states_propagation_cached_result(value, constructs, cache, cache_count, error);
    }
    return lr_states_propagation_work_result(value, constructs, cache, cache_count, owner, graph, pool, count, error);
}

// Explicit width exercises the same private-output ownership with the serial
// instrumented transport. Normal admission retains its measured-size policy.
fn lr_states_propagation_work(value: LRStates*, constructs: bool, cache: LRKernelClosure**,
owner: void*, graph: WorkGraph*, pool: WorkPool*, count: usize): LRPropagation* {
    var error = WorkBudgetError.None;
    var cache_count = lr_lalr_cache_count(value, &error);
    if error != WorkBudgetError.None { return null; }
    return lr_states_propagation_work_result(value, constructs, cache, cache_count, owner, graph, pool, count, &error);
}

fn lr_states_propagation_work_result(value: LRStates*, constructs: bool, cache: LRKernelClosure**, cache_count: usize,
owner: void*, graph: WorkGraph*, pool: WorkPool*, count: usize, error: WorkBudgetError*): LRPropagation* {
    *error = WorkBudgetError.Invalid;
    var jobs: LRLinkTask*[WorkPoolMaximumCapacity];
    if value == null || cache == null || pool == null || graph == null || count == 0
        || count > pool.count || count > sizeof(decltype(jobs)) / sizeof(LRLinkTask*)
        || count > value.states.length || owner == null {
        return null;
    }
    var admission: ParserAdmission = default;
    *error = parser_admission_open_result(&admission, owner, count);
    if *error != WorkBudgetError.None { return null; }
    defer parser_admission_close(&admission, graph);
    var result = lr_states_propagation_begin_result(value, constructs, error);
    if result == null {
        return null;
    }
    defer lr_propagation_destroy(result);
    if !work_reset(graph, graph.revision + 1, graph.profile) {
        *error = lr_work_error(graph);
        return null;
    }
    var kind = lr_work_node_result(owner, error);
    if kind == null { return null; }
    *error = entity_register_stage_result(kind, sizeof(LRLinkTask), alignof(LRLinkTask), 0, 0);
    if *error != WorkBudgetError.None { return null; }
    var initialized: usize = 0;
    defer {
        for(var i: usize = 0; i < initialized; i++) {
            work_vector_dispose(&jobs[i].links);
        }
    }
    var position: usize = 0;
    for(var i: usize = 0; i < count; i++) {
        var node = lr_work_node_result(owner, error);
        if node == null {
            return null;
        }
        var job = bits(LRLinkTask*, entity_component_data(entity_component_add_result(node, kind, error)));
        if job == null {
            return null;
        }
        *job = default;
        jobs[initialized++] = job;
        job.kernel.kind = CompilerKernelKind.LRLink;
        job.kernel.payload = bits(void*, job);
        job.states = value;
        job.cache = cache;
        job.cache_count = cache_count;
        job.begin = position;
        job.count = value.states.length / count +(i < value.states.length % count ? 1: 0);
        position += job.count;
        var id = work_request(graph, node, 4, convert(u64, job.begin));
        var ok = id != 0;
        ok &&= work_access(graph, id, 1, 5, job.begin, job.count, WorkAccessMode.Write);
        ok &&= work_access(graph, id, 1, 2, 0, 1, WorkAccessMode.Read);
        ok &&= work_seal(graph, id);
        ok &&= work_demand(graph, id);
        ok &&= work_take_task(graph, &job.ticket, id);
        if !ok {
            *error = lr_work_error(graph);
            return null;
        }
    }
    var view = entity_view_open_result(owner, error);
    if view == null {
        return null;
    }
    *error = compiler_kernel_dispatch_admitted_result(pool, &jobs[0], count, admission.extra);
    entity_view_close(view);
    if *error != WorkBudgetError.None { return null; }
    var ok = true;
    for(var i: usize = 0; i < count; i++) {
        if !work_finish(graph, &jobs[i].ticket, jobs[i].resource_error == WorkBudgetError.None) {
            ok = false;
        }
    }
    if !ok {
        *error = lr_work_error(graph);
        return null;
    }
    for(var i: usize = 0; i < count; i++) {
        if jobs[i].resource_error != WorkBudgetError.None { *error = jobs[i].resource_error; return null; }
    }
    for(var i: usize = 0; i < count; i++) {
        foreach(var & link in &jobs[i].links) {
            *error = lr_lalr_apply_result(result, link);
            if *error != WorkBudgetError.None { return null; }
        }
    }
    var published = result;
    result = null;
    return published;
}

struct LRPropagationTask {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    propagation: LRPropagation*;
    incoming: work_vector(usize)*;
    targets: usize*;
    results: work_vector(SymbolRange)*;
    changed: bool*;
    begin: usize;
    count: usize;
    resource_error: WorkBudgetError;
    observer: GrammarObserver;
    ordinal: usize;
}

export fn compiler_lr_propagation_kernel(payload: void*): void {
    var task = bits(LRPropagationTask*, payload);
    if task.observer.event != null { task.observer.event(task.observer.context, GrammarPhase.LookaheadKernel, true, task.ordinal, task.count); }
    defer { if task.observer.event != null { task.observer.event(task.observer.context, GrammarPhase.LookaheadKernel, false, task.ordinal, task.count); } }
    task.resource_error = WorkBudgetError.None;
    for(var i = task.begin; i < task.begin + task.count; i++) {
        var node = task.targets[i];
        var source = &task.propagation.nodes[node].ranges;
        var result = &task.results[node];
        result.length = 0;
        task.resource_error = lr_reserve_result(result, source.length, task.propagation.budget);
        if task.resource_error != WorkBudgetError.None { return; }
        if source.length != 0 {
            copy(result.data, source.data, source.length *sizeof(SymbolRange));
        }
        result.length = source.length;
        task.changed[node] = false;
        foreach(var input in &task.incoming[node]) {
            task.resource_error = lr_range_merge_result(result, &task.propagation.nodes[input].ranges, &task.changed[node], task.propagation.budget);
            if task.resource_error != WorkBudgetError.None { return; }
        }
    }
}

// Ordinary monotone lookahead union, grouped by destination. Each joined wave
// reads the previous ranges and writes private vectors. Grammar cycles are legal
// fixed points; they are not cycles in the acyclic work graph for one wave.
fn lr_propagation_solve_parallel(value: LRPropagation*, owner: void*, graph: WorkGraph*, pool: WorkPool*): bool {
    return lr_propagation_solve_parallel_result(value, owner, graph, pool) == WorkBudgetError.None;
}

fn lr_propagation_solve_parallel_result(value: LRPropagation*, owner: void*, graph: WorkGraph*, pool: WorkPool*): WorkBudgetError {
    if value == null || pool == null || graph == null { return WorkBudgetError.Invalid; }
    var world = compiler_node_world(owner);
    if graph.budget != value.budget || (world != null && compiler_world_work_budget(world) != value.budget) { return WorkBudgetError.Invalid; }
    var observer: GrammarObserver = default;
    if world != null { observer = compiler_world_grammar(world).observer; }
    if pool.count < 2 || value.count < 2 * LRPropagationGrain {
        return lr_propagation_solve_components_result(value, graph.budget);
    }
    if value.count > ~convert(usize, 0) / sizeof(work_vector(usize))
        || value.count > ~convert(usize, 0) / sizeof(work_vector(SymbolRange)) { return WorkBudgetError.Invalid; }
    var incoming_storage: WorkBuffer = default;
    var result_storage: WorkBuffer = default;
    var changed_storage: WorkBuffer = default;
    defer { work_buffer_dispose(&incoming_storage); work_buffer_dispose(&result_storage); work_buffer_dispose(&changed_storage); }
    var error = work_buffer_resize(&incoming_storage, value.budget, value.count * sizeof(work_vector(usize)), 0);
    if error == WorkBudgetError.None { error = work_buffer_resize(&result_storage, value.budget, value.count * sizeof(work_vector(SymbolRange)), 0); }
    if error == WorkBudgetError.None { error = work_buffer_resize(&changed_storage, value.budget, value.count * sizeof(bool), 0); }
    if error != WorkBudgetError.None { return error; }
    var incoming = bits(work_vector(usize)*, incoming_storage.data);
    var results = bits(work_vector(SymbolRange)*, result_storage.data);
    var changed = bits(bool*, changed_storage.data);
    fill(incoming, 0, value.count *sizeof(work_vector(usize)));
    fill(results, 0, value.count *sizeof(work_vector(SymbolRange)));
    defer {
        for(var i: usize = 0; i < value.count; i++) {
            work_vector_dispose(&incoming[i]);
            work_vector_dispose(&results[i]);
        }
    }
    var targets: work_vector(usize);
    work_vector_init(&targets);
    defer work_vector_dispose(&targets);
    var kind: void* = null;
    var nodes: void*[WorkPoolMaximumCapacity];
    var jobs: LRPropagationTask*[WorkPoolMaximumCapacity];
    if pool.count > sizeof(decltype(jobs)) / sizeof(LRPropagationTask*) { return WorkBudgetError.Invalid; }
    while value.pending.length != 0 {
        targets.length = 0;
        // Keep the original pending queue intact until parallel admission is
        // useful. Narrow frontiers use the same ordinary worklist to completion.
        foreach(var index in &value.pending) {
            var source = &value.nodes[index];
            if source.ranges.length == 0 {
                continue;
            }
            foreach(var destination in &source.edges) {
                if incoming[destination].length == 0 {
                    error = lr_push_result(&targets, destination, value.budget);
                    if error != WorkBudgetError.None { return error; }
                }
                error = lr_push_result(&incoming[destination], index, value.budget);
                if error != WorkBudgetError.None { return error; }
            }
        }
        var count = targets.length / LRPropagationGrain;
        if count > pool.count {
            count = pool.count;
        }
        if count < 2 {
            return lr_propagation_solve_components_result(value, graph.budget);
        }
        var admission: ParserAdmission = default;
        error = parser_admission_open_result(&admission, owner, count);
        if error != WorkBudgetError.None { return error; }
        defer parser_admission_close(&admission, graph);
        if admission.extra == 0 { return lr_propagation_solve_components_result(value, graph.budget); }
        if kind == null {
            kind = lr_work_node_result(owner, &error);
            if kind == null { return error; }
            var registered = entity_register_stage_result(kind, sizeof(LRPropagationTask), alignof(LRPropagationTask), 0, 0);
            if registered != WorkBudgetError.None { return registered; }
            for(var i: usize = 0; i < pool.count; i++) {
                nodes[i] = lr_work_node_result(owner, &error);
                if nodes[i] == null {
                    return error;
                }
                var job = bits(LRPropagationTask*, entity_component_data(entity_component_add_result(nodes[i], kind, &error)));
                if job == null {
                    return error;
                }
                fill(job, 0, sizeof(LRPropagationTask));
                job.kernel.kind = CompilerKernelKind.LRPropagation;
                job.kernel.payload = bits(void*, job);
                job.propagation = value;
                job.incoming = incoming;
                job.results = results;
                job.changed = changed;
                job.observer = observer;
                job.ordinal = i;
                jobs[i] = job;
            }
        }
        if !work_reset(graph, graph.revision + 1, graph.profile) {
            return lr_work_error(graph);
        }
        var position: usize = 0;
        for(var i: usize = 0; i < count; i++) {
            var job = jobs[i];
            job.targets = targets.data;
            job.begin = position;
            job.count = targets.length / count +(i < targets.length % count ? 1: 0);
            position += job.count;
            var id = work_request(graph, nodes[i], 3, convert(u64, job.begin));
            var ok = id != 0;
            // Destination rows are unique in this frontier; these ranges map
            // through the immutable targets index to disjoint output headers.
            ok &&= work_access(graph, id, 1, 4, job.begin, job.count, WorkAccessMode.Write);
            ok &&= work_access(graph, id, 1, 2, 0, 1, WorkAccessMode.Read);
            ok &&= work_seal(graph, id);
            ok &&= work_demand(graph, id);
            ok &&= work_take(graph, &job.ticket);
            if !ok {
                return lr_work_error(graph);
            }
        }
        var view = entity_view_open_result(owner, &error);
        if view == null {
            return error;
        }
        if observer.event != null { observer.event(observer.context, GrammarPhase.PropagationWave, true, count, targets.length); }
        error = compiler_kernel_dispatch_admitted_result(pool, &jobs[0], count, admission.extra);
        if observer.event != null { observer.event(observer.context, GrammarPhase.PropagationWave, false, count, targets.length); }
        entity_view_close(view);
        if error != WorkBudgetError.None { return error; }
        var ok = true;
        for(var i: usize = 0; i < count; i++) {
            if !work_finish(graph, &jobs[i].ticket, jobs[i].resource_error == WorkBudgetError.None) {
                ok = false;
            }
        }
        if !ok {
            return lr_work_error(graph);
        }
        for(var i: usize = 0; i < count; i++) {
            if jobs[i].resource_error != WorkBudgetError.None { return jobs[i].resource_error; }
        }
        foreach(var index in &value.pending) {
            value.nodes[index].queued = false;
        }
        value.pending.length = 0;
        foreach(var index in &targets) {
            incoming[index].length = 0;
            if !changed[index] {
                continue;
            }
            var row = &value.nodes[index];
            if !row.range_owned {
                // Retire the borrow without freeing inline storage; transfer
                // the worker's single owned receipt after every reader joins.
                row.ranges = results[index];
                row.range_owned = true;
                results[index] = default;
            } else { work_vector_swap(&row.ranges, &results[index]); }
            lr_propagation_queue(value, index);
        }
    }
    return WorkBudgetError.None;
}

// The result components are transient analysis jobs on ordinary entities in the
// grammar's world. The grammar remains authoritative; closure/index objects are
// private derived data. No grammar update is published from a worker.
export fn lr_states_lalr_parallel(value: LRStates*, constructs: bool, anchor: void*): bool {
    return lr_states_lalr_parallel_result(value, constructs, anchor) == WorkBudgetError.None;
}

export fn lr_states_lalr_parallel_result(value: LRStates*, constructs: bool, anchor: void*): WorkBudgetError {
    if value == null || value.analysis == null { return WorkBudgetError.Invalid; }
    defer lr_analysis_scratch_dispose(value.analysis);
    var world = compiler_node_world(anchor);
    if anchor != null && value.analysis.budget != compiler_world_work_budget(world) { return WorkBudgetError.Invalid; }
    if world != null { grammar_observe(world, GrammarPhase.Lookahead, true, value.states.length, 0); }
    defer { if world != null { grammar_observe(world, GrammarPhase.Lookahead, false, value.states.length, 0); } }
    var error = WorkBudgetError.None;
    var count = lr_lalr_cache_count(value, &error);
    if error != WorkBudgetError.None { return error; }
    if !lr_lalr_item_graph_safe(value) { return lr_states_lalr_closure_parallel_result(value, constructs, anchor); }
    var budget = value.analysis.budget;
    var capacity = compiler_worker_capacity(anchor);
    if capacity <= 1 || anchor == null || !value.analysis.suffix_ready {
        return lr_states_lalr_owned_result(value, constructs, budget);
    }
    if count < 2 * LRClosureGrain && value.states.length < 2 * LRLookaheadStateGrain {
        return lr_states_lalr_owned_result(value, constructs, budget);
    }
    var lanes = value.states.length / LRLookaheadStateGrain;
    var closures = count / LRClosureGrain;
    if lanes < closures { lanes = closures; }
    if capacity > lanes { capacity = lanes; }
    var owner = entity_create_related_result(anchor, &error);
    if owner == null { return error; }
    defer entity_release(owner);
    var graph: WorkGraph;
    if !work_init_budget(&graph, 1, 0, budget) { return lr_work_error(&graph); }
    defer work_dispose(&graph);
    var workers: ParserWorkers = default;
    error = parser_workers_open_result(&workers, anchor, capacity);
    if error != WorkBudgetError.None { return error; }
    defer parser_workers_close(&workers);
    // Coordinator builds the derived graph before any worker borrows it. The
    // existing solver/action phases retain their private outputs and ordered joins.
    if world != null { grammar_observe(world, GrammarPhase.LookaheadGraph, true, value.states.length, 0); }
    var lookahead = lr_states_propagation_items_result(value, constructs, budget, &error);
    if world != null { grammar_observe(world, GrammarPhase.LookaheadGraph, false, value.states.length, 0); }
    if lookahead == null { return error; }
    defer lr_propagation_destroy(lookahead);
    if world != null { grammar_observe(world, GrammarPhase.LookaheadSolve, true, lookahead.count, lookahead.pending.length); }
    error = lr_propagation_solve_parallel_result(lookahead, owner, &graph, workers.pool);
    if world != null { grammar_observe(world, GrammarPhase.LookaheadSolve, false, lookahead.count, lookahead.pending.length); }
    if error != WorkBudgetError.None { return error; }
    if world != null { grammar_observe(world, GrammarPhase.LookaheadActions, true, value.states.length, 0); }
    error = lr_lalr_actions_parallel_result(value, lookahead, owner, &graph, workers.pool);
    if world != null { grammar_observe(world, GrammarPhase.LookaheadActions, false, value.states.length, 0); }
    return error;
}

fn lr_states_lalr_closure_parallel_result(value: LRStates*, constructs: bool, anchor: void*): WorkBudgetError {
    var error = WorkBudgetError.None;
    var count = lr_lalr_cache_count(value, &error);
    if error != WorkBudgetError.None { return error; }
    var capacity = compiler_worker_capacity(anchor);
    if capacity <= 1 || anchor == null {
        return lr_states_lalr_result(value, constructs);
    }
    if count < 2 * LRClosureGrain && value.states.length < 2 * LRLookaheadStateGrain {
        return lr_states_lalr_result(value, constructs);
    }
    var jobs: LRClosureTask*[WorkPoolMaximumCapacity];
    if capacity > sizeof(decltype(jobs)) / sizeof(LRClosureTask*)
        || count > ~convert(usize, 0) / sizeof(LRItem) { return WorkBudgetError.Invalid; }
    var batches = count / LRClosureGrain;
    if batches == 0 {
        batches = 1;
    }
    var lanes = value.states.length / LRLookaheadStateGrain;
    if lanes < batches {
        lanes = batches;
    }
    if capacity > lanes {
        capacity = lanes;
    }
    if batches > capacity {
        batches = capacity;
    }
    var cache_storage: WorkBuffer = default;
    var item_storage: WorkBuffer = default;
    var needed_storage: WorkBuffer = default;
    defer { work_buffer_dispose(&cache_storage); work_buffer_dispose(&item_storage); work_buffer_dispose(&needed_storage); }
    error = work_buffer_resize(&cache_storage, value.analysis.budget, count * sizeof(LRKernelClosure*), 0);
    if error == WorkBudgetError.None { error = work_buffer_resize(&item_storage, value.analysis.budget, count * sizeof(LRItem), 0); }
    if error == WorkBudgetError.None { error = work_buffer_resize(&needed_storage, value.analysis.budget, count, 0); }
    if error != WorkBudgetError.None { return error; }
    var cache = bits(LRKernelClosure**, cache_storage.data);
    var items = bits(LRItem*, item_storage.data);
    var needed = needed_storage.data;
    fill(cache, 0, count *sizeof(LRKernelClosure*));
    fill(needed, 0, count);
    defer {
        for(var i: usize = 0; i < count; i++) { lr_kernel_closure_destroy(cache[i]); }
    }
    var owner = entity_create_related_result(anchor, &error);
    if owner == null { return error; }
    defer entity_release(owner);
    var kind = lr_work_node_result(owner, &error);
    if kind == null { return error; }
    var registered = entity_register_stage_result(kind, sizeof(LRClosureTask), alignof(LRClosureTask), 0, 0);
    if registered != WorkBudgetError.None { return registered; }
    var graph: WorkGraph;
    if !work_init_budget(&graph, 1, 0, compiler_world_work_budget(compiler_node_world(anchor))) { return lr_work_error(&graph); }
    defer work_dispose(&graph);
    var admission: ParserAdmission = default;
    defer parser_admission_close(&admission, &graph);
    for(var i: usize = 0; i < value.states.length; ++i) {
        var state_items = &value.states.data[i].items.values;
        foreach(var & item in state_items) {
            if !lr_kernel(value.analysis, item) {
                continue;
            }
            var key = value.analysis.rules[item.rule].begin + item.rule + item.position;
            if key >= count { return WorkBudgetError.Invalid; }
            if needed[key] != 0 {
                continue;
            }
            copy(&items[key], item, sizeof(LRItem));
            needed[key] = 1;
        }
    }
    var position: usize = 0;
    for(var i: usize = 0; i < batches; i++) {
        var node = lr_work_node_result(owner, &error);
        if node == null { return error; }
        var result = bits(LRClosureTask*, entity_component_data(entity_component_add_result(node, kind, &error)));
        if result == null { return error; }
        fill(result, 0, sizeof(LRClosureTask));
        result.kernel.kind = CompilerKernelKind.LRClosure;
        result.kernel.payload = bits(void*, result);
        result.analysis = value.analysis;
        result.items = items;
        result.needed = needed;
        result.closures = cache;
        result.begin = position;
        result.count = count / batches +(i < count % batches ? 1: 0);
        position += result.count;
        jobs[i] = result;
        var query = work_request(&graph, node, 1, 0);
        var ok = query != 0;
        ok &&= work_access(&graph, query, 1, 1, result.begin, result.count, WorkAccessMode.Write);
        ok &&= work_access(&graph, query, 1, 2, 0, 1, WorkAccessMode.Read);
        ok &&= work_seal(&graph, query);
        ok &&= work_demand(&graph, query);
        ok &&= work_take_task(&graph, &result.ticket, query);
        if !ok { return lr_work_error(&graph); }
    }
    var workers: ParserWorkers = default;
    error = parser_workers_open_result(&workers, anchor, capacity);
    if error != WorkBudgetError.None { return error; }
    defer parser_workers_close(&workers);
    var pool = workers.pool;
    error = parser_admission_open_result(&admission, anchor, batches);
    if error != WorkBudgetError.None { return error; }
    var view = entity_view_open_result(owner, &error);
    if view == null { return error; }
    error = compiler_kernel_dispatch_admitted_result(pool, &jobs[0], batches, admission.extra);
    entity_view_close(view);
    if error != WorkBudgetError.None { return error; }
    var ok = true;
    for(var i: usize = 0; i < batches; ++i) {
        var result = jobs[i];
        if !work_finish(&graph, &result.ticket, result.resource_error == WorkBudgetError.None) { ok = false; }
    }
    if !ok { return lr_work_error(&graph); }
    for(var i: usize = 0; i < batches; ++i) {
        if jobs[i].resource_error != WorkBudgetError.None { return jobs[i].resource_error; }
    }
    parser_admission_close(&admission, &graph);
    var lookahead = lr_states_propagation_parallel_result(value, constructs, cache, count, owner, &graph, pool, &error);
    if lookahead == null { return error; }
    defer lr_propagation_destroy(lookahead);
    error = lr_propagation_solve_parallel_result(lookahead, owner, &graph, pool);
    return error != WorkBudgetError.None ? error : lr_lalr_actions_parallel_result(value, lookahead, owner, &graph, pool);
}
