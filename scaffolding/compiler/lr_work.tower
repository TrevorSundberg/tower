import tower;
import worker_policy;
import compiler_kernel;
import lr_analysis;
import lr_lalr;
import lr_states;
import lr_types;
import lexer_table;
import parser_workers;
import .library.vector;
import .library.work_graph_api;
import .library.work_graph_types;
import .library.work_pool_api;
import .library.work_pool_types;

extern fn entity_create_related(anchor: void*): void*;

extern fn entity_attach(child: void*, parent: void*, name: u8*): bool;

extern fn entity_release(entity: void*): usize;

extern fn entity_register(type: void*, size: usize, alignment: usize, lifecycle: usize): bool;

extern fn entity_component_add(node: void*, type: void*): void*;

extern fn entity_component_data(component: void*): void*;

extern fn entity_view_open(anchor: void*): void*;

extern fn entity_view_close(view: void*): void;

struct LRClosureTask {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    analysis: LRAnalysis*;
    items: LRItem*;
    needed: u8*;
    closures: LRKernelClosure**;
    begin: usize;
    count: usize;
    success: bool;
}

struct LRActionTask {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    states: LRStates*;
    lookahead: LRPropagation*;
    results: vector(LRAction)*;
    begin: usize;
    count: usize;
    success: bool;
}

export fn compiler_lr_action_kernel(payload: void*): void {
    var task = bits(LRActionTask*, payload);
    task.success = true;
    for(var i = task.begin; i < task.begin + task.count; i++) {
        if !lr_lalr_state_actions(task.states, task.lookahead, i, &task.results[i]) {
            task.success = false;
            return;
        }
    }
}

// Scheduling grain only, not a grammar or semantic limit. A job amortizes its
// ECS/query/semaphore handoff over a contiguous set of dotted productions.
var LRClosureGrain: usize = 512;

// Only immutable grammar/FIRST data are shared. LRAnalysis.failed is private:
// the ordinary closure routines may set it on allocation failure.
export fn compiler_lr_kernel(payload: void*): void {
    var task = bits(LRClosureTask*, payload);
    var analysis: LRAnalysis;
    copy(&analysis, task.analysis, sizeof(LRAnalysis));
    task.success = true;
    for(var i = task.begin; i < task.begin + task.count; i++) {
        if task.needed[i] == 0 {
            continue;
        }
        task.closures[i] = lr_kernel_closure(&analysis, &task.items[i]);
        if task.closures[i] == null {
            task.success = false;
            return;
        }
    }
}

fn lr_work_node(parent: void*): void* {
    var node = entity_create_related(parent);
    if node == null {
        return null;
    }
    if !entity_attach(node, parent, null) {
        entity_release(node);
        return null;
    }
    entity_release(node);
    return node;
}

// Lookahead has reached its fixed point before admission. Workers read those
// immutable ranges and state inputs; each owns a contiguous range of private
// vectors. Keep the existing closure pool alive across this phase boundary.
fn lr_lalr_actions_parallel(value: LRStates*, lookahead: LRPropagation*, owner: void*,
graph: WorkGraph*, pool: WorkPool*): bool {
    var count = value.states.length / 128;
    if count > pool.count {
        count = pool.count;
    }
    if count < 2 {
        return lr_lalr_actions(value, lookahead);
    }
    var admission: ParserAdmission = default;
    if !parser_admission_open(&admission, owner, count) { return false; }
    defer parser_admission_close(&admission, graph);
    if admission.extra == 0 { return lr_lalr_actions(value, lookahead); }
    if !work_reset(graph, graph.revision + 1, graph.profile) {
        return false;
    }
    var results = alloc(vector(LRAction), value.states.length);
    if results == null {
        return false;
    }
    fill(results, 0, value.states.length *sizeof(vector(LRAction)));
    defer {
        for(var i: usize = 0; i < value.states.length; i++) {
            vector_dispose(&results[i]);
        }
        free(results);
    }
    var kind = lr_work_node(owner);
    if kind == null || !entity_register(kind, sizeof(LRActionTask), alignof(LRActionTask), 0) {
        return false;
    }
    var jobs: LRActionTask*[WorkPoolMaximumCapacity];
    var position: usize = 0;
    for(var i: usize = 0; i < count; i++) {
        var node = lr_work_node(owner);
        if node == null {
            return false;
        }
        var job = bits(LRActionTask*, entity_component_data(entity_component_add(node, kind)));
        if job == null {
            return false;
        }
        fill(job, 0, sizeof(LRActionTask));
        job.kernel.kind = CompilerKernelKind.LRAction;
        job.kernel.payload = bits(void*, job);
        job.states = value;
        job.lookahead = lookahead;
        job.results = results;
        job.begin = position;
        job.count = value.states.length / count +(i < value.states.length % count ? 1: 0);
        position += job.count;
        jobs[i] = job;
        var id = work_request(graph, node, 2, convert(u64, job.begin));
        var ok = id != 0;
        ok &&= work_access(graph, id, 1, 3, job.begin, job.count, WorkAccessMode.Write);
        ok &&= work_access(graph, id, 1, 2, 0, 1, WorkAccessMode.Read);
        ok &&= work_seal(graph, id);
        ok &&= work_demand(graph, id);
        ok &&= work_take(graph, &job.ticket);
        if !ok {
            return false;
        }
    }
    var view = entity_view_open(owner);
    if view == null {
        return false;
    }
    var ok = compiler_kernel_dispatch_admitted(pool, &jobs[0], count, admission.extra);
    entity_view_close(view);
    if !ok { return false; }
    for(var i: usize = 0; i < count; i++) {
        if !work_finish(graph, &jobs[i].ticket, jobs[i].success) || !jobs[i].success {
            ok = false;
        }
    }
    if !ok {
        return false;
    }
    for(var i: usize = 0; i < value.states.length; i++) {
        var actions = &value.states.data[i].actions;
        vector_dispose(actions);
        copy(actions, &results[i], sizeof(vector(LRAction)));
        fill(&results[i], 0, sizeof(vector(LRAction)));
    }
    return true;
}

struct LRLinkTask {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    states: LRStates*;
    cache: LRKernelClosure**;
    links: vector(LRPropagationLink);
    begin: usize;
    count: usize;
    success: bool;
}

export fn compiler_lr_link_kernel(payload: void*): void {
    var task = bits(LRLinkTask*, payload);
    task.success = true;
    for(var i = task.begin; i < task.begin + task.count; i++) {
        if !lr_lalr_state_links(task.states, task.cache, i, &task.links) {
            task.success = false;
            return;
        }
    }
}

// Link lookup/closure traversal runs independently for each state range. Only
// after every job joins, replay its ordered publication records into the same
// graph used by serial construction. No worker changes pending queues, state
// bases, caches, grammar entities or another job's allocation headers.
fn lr_states_propagation_parallel(value: LRStates*, constructs: bool, cache: LRKernelClosure**,
owner: void*, graph: WorkGraph*, pool: WorkPool*): LRPropagation* {
    var count = value.states.length / 128;
    if count > pool.count {
        count = pool.count;
    }
    if count < 2 {
        return lr_states_propagation_cached(value, constructs, cache);
    }
    return lr_states_propagation_work(value, constructs, cache, owner, graph, pool, count);
}

// Explicit width exercises the same private-output ownership with the serial
// instrumented transport. Normal admission retains its measured-size policy.
fn lr_states_propagation_work(value: LRStates*, constructs: bool, cache: LRKernelClosure**,
owner: void*, graph: WorkGraph*, pool: WorkPool*, count: usize): LRPropagation* {
    var jobs: LRLinkTask*[WorkPoolMaximumCapacity];
    if count == 0 || count > pool.count || count > sizeof(decltype(jobs)) / sizeof(LRLinkTask*)
        || count > value.states.length || owner == null {
        return null;
    }
    var admission: ParserAdmission = default;
    if !parser_admission_open(&admission, owner, count) { return null; }
    defer parser_admission_close(&admission, graph);
    var result = lr_states_propagation_begin(value, constructs);
    if result == null {
        return null;
    }
    defer lr_propagation_destroy(result);
    if !work_reset(graph, graph.revision + 1, graph.profile) {
        return null;
    }
    var kind = lr_work_node(owner);
    if kind == null || !entity_register(kind, sizeof(LRLinkTask), alignof(LRLinkTask), 0) {
        return null;
    }
    var initialized: usize = 0;
    defer {
        for(var i: usize = 0; i < initialized; i++) {
            vector_dispose(&jobs[i].links);
        }
    }
    var position: usize = 0;
    for(var i: usize = 0; i < count; i++) {
        var node = lr_work_node(owner);
        if node == null {
            return null;
        }
        var job = bits(LRLinkTask*, entity_component_data(entity_component_add(node, kind)));
        if job == null {
            return null;
        }
        *job = default;
        jobs[initialized++] = job;
        job.kernel.kind = CompilerKernelKind.LRLink;
        job.kernel.payload = bits(void*, job);
        job.states = value;
        job.cache = cache;
        job.begin = position;
        job.count = value.states.length / count +(i < value.states.length % count ? 1: 0);
        position += job.count;
        var id = work_request(graph, node, 4, convert(u64, job.begin));
        var ok = id != 0;
        ok &&= work_access(graph, id, 1, 5, job.begin, job.count, WorkAccessMode.Write);
        ok &&= work_access(graph, id, 1, 2, 0, 1, WorkAccessMode.Read);
        ok &&= work_seal(graph, id);
        ok &&= work_demand(graph, id);
        ok &&= work_take_task(graph, &job.ticket, id);
        if !ok {
            return null;
        }
    }
    var view = entity_view_open(owner);
    if view == null {
        return null;
    }
    var ok = compiler_kernel_dispatch_admitted(pool, &jobs[0], count, admission.extra);
    entity_view_close(view);
    if !ok { return null; }
    for(var i: usize = 0; i < count; i++) {
        if !work_finish(graph, &jobs[i].ticket, jobs[i].success) || !jobs[i].success {
            ok = false;
        }
    }
    if !ok {
        return null;
    }
    for(var i: usize = 0; i < count; i++) {
        foreach(var & link in &jobs[i].links) {
            if !lr_lalr_apply(result, link) {
                return null;
            }
        }
    }
    var published = result;
    result = null;
    return published;
}

struct LRPropagationTask {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    propagation: LRPropagation*;
    incoming: vector(usize)*;
    targets: usize*;
    results: vector(SymbolRange)*;
    changed: bool*;
    begin: usize;
    count: usize;
    success: bool;
}

export fn compiler_lr_propagation_kernel(payload: void*): void {
    var task = bits(LRPropagationTask*, payload);
    task.success = true;
    for(var i = task.begin; i < task.begin + task.count; i++) {
        var node = task.targets[i];
        var source = &task.propagation.nodes[node].ranges;
        var result = &task.results[node];
        result.length = 0;
        if !vector_reserve(result, source.length) {
            task.success = false;
            return;
        }
        if source.length != 0 {
            copy(result.data, source.data, source.length *sizeof(SymbolRange));
        }
        result.length = source.length;
        task.changed[node] = false;
        foreach(var input in &task.incoming[node]) {
            if !lr_range_merge(result, &task.propagation.nodes[input].ranges, &task.changed[node]) {
                task.success = false;
                return;
            }
        }
    }
}

// Ordinary monotone lookahead union, grouped by destination. Each joined wave
// reads the previous ranges and writes private vectors. Grammar cycles are legal
// fixed points; they are not cycles in the acyclic work graph for one wave.
fn lr_propagation_solve_parallel(value: LRPropagation*, owner: void*, graph: WorkGraph*, pool: WorkPool*): bool {
    if pool.count < 2 || value.count < 128 {
        return lr_propagation_solve(value);
    }
    var incoming = alloc(vector(usize), value.count);
    var results = alloc(vector(SymbolRange), value.count);
    var changed = alloc(bool, value.count);
    if incoming == null || results == null || changed == null {
        free(incoming);
        free(results);
        free(changed);
        return false;
    }
    fill(incoming, 0, value.count *sizeof(vector(usize)));
    fill(results, 0, value.count *sizeof(vector(SymbolRange)));
    defer {
        for(var i: usize = 0; i < value.count; i++) {
            vector_dispose(&incoming[i]);
            vector_dispose(&results[i]);
        }
        free(incoming);
        free(results);
        free(changed);
    }
    var targets: vector(usize);
    vector_init(&targets);
    defer vector_dispose(&targets);
    var kind: void* = null;
    var nodes: void*[WorkPoolMaximumCapacity];
    var jobs: LRPropagationTask*[WorkPoolMaximumCapacity];
    while value.pending.length != 0 {
        targets.length = 0;
        // Keep the original pending queue intact until parallel admission is
        // useful. Narrow frontiers use the same ordinary worklist to completion.
        foreach(var index in &value.pending) {
            var source = &value.nodes[index];
            if source.ranges.length == 0 {
                continue;
            }
            foreach(var destination in &source.edges) {
                if incoming[destination].length == 0 && !vector_push(&targets, destination) {
                    return false;
                }
                if !vector_push(&incoming[destination], index) {
                    return false;
                }
            }
        }
        var count = targets.length / 64;
        if count > pool.count {
            count = pool.count;
        }
        if count < 2 {
            return lr_propagation_solve(value);
        }
        var admission: ParserAdmission = default;
        if !parser_admission_open(&admission, owner, count) { return false; }
        defer parser_admission_close(&admission, graph);
        if admission.extra == 0 { return lr_propagation_solve(value); }
        if kind == null {
            kind = lr_work_node(owner);
            if kind == null || !entity_register(kind, sizeof(LRPropagationTask), alignof(LRPropagationTask), 0) {
                return false;
            }
            for(var i: usize = 0; i < pool.count; i++) {
                nodes[i] = lr_work_node(owner);
                if nodes[i] == null {
                    return false;
                }
                var job = bits(LRPropagationTask*, entity_component_data(entity_component_add(nodes[i], kind)));
                if job == null {
                    return false;
                }
                fill(job, 0, sizeof(LRPropagationTask));
                job.kernel.kind = CompilerKernelKind.LRPropagation;
                job.kernel.payload = bits(void*, job);
                job.propagation = value;
                job.incoming = incoming;
                job.results = results;
                job.changed = changed;
                jobs[i] = job;
            }
        }
        if !work_reset(graph, graph.revision + 1, graph.profile) {
            return false;
        }
        var position: usize = 0;
        for(var i: usize = 0; i < count; i++) {
            var job = jobs[i];
            job.targets = targets.data;
            job.begin = position;
            job.count = targets.length / count +(i < targets.length % count ? 1: 0);
            position += job.count;
            var id = work_request(graph, nodes[i], 3, convert(u64, job.begin));
            var ok = id != 0;
            // Destination rows are unique in this frontier; these ranges map
            // through the immutable targets index to disjoint output headers.
            ok &&= work_access(graph, id, 1, 4, job.begin, job.count, WorkAccessMode.Write);
            ok &&= work_access(graph, id, 1, 2, 0, 1, WorkAccessMode.Read);
            ok &&= work_seal(graph, id);
            ok &&= work_demand(graph, id);
            ok &&= work_take(graph, &job.ticket);
            if !ok {
                return false;
            }
        }
        var view = entity_view_open(owner);
        if view == null {
            return false;
        }
        var ok = compiler_kernel_dispatch_admitted(pool, &jobs[0], count, admission.extra);
        entity_view_close(view);
        if !ok { return false; }
        for(var i: usize = 0; i < count; i++) {
            if !work_finish(graph, &jobs[i].ticket, jobs[i].success) || !jobs[i].success {
                ok = false;
            }
        }
        if !ok {
            return false;
        }
        foreach(var index in &value.pending) {
            value.nodes[index].queued = false;
        }
        value.pending.length = 0;
        foreach(var index in &targets) {
            incoming[index].length = 0;
            if !changed[index] {
                continue;
            }
            var previous: vector(SymbolRange);
            copy(&previous, &value.nodes[index].ranges, sizeof(vector(SymbolRange)));
            copy(&value.nodes[index].ranges, &results[index], sizeof(vector(SymbolRange)));
            copy(&results[index], &previous, sizeof(vector(SymbolRange)));
            lr_propagation_queue(value, index);
        }
    }
    return true;
}

// The result components are transient analysis jobs on ordinary entities in the
// grammar's world. The grammar remains authoritative; closure/index objects are
// private derived data. No grammar update is published from a worker.
export fn lr_states_lalr_parallel(value: LRStates*, constructs: bool, anchor: void*): bool {
    var capacity = compiler_worker_capacity(anchor);
    if capacity <= 1 || anchor == null {
        return lr_states_lalr(value, constructs);
    }
    var count = value.analysis.symbol_count + value.analysis.rule_count;
    if count < 2 *LRClosureGrain && value.states.length < 256 {
        return lr_states_lalr(value, constructs);
    }
    var batches = count / LRClosureGrain;
    if batches == 0 {
        batches = 1;
    }
    var lanes = value.states.length / 128;
    if lanes < batches {
        lanes = batches;
    }
    if capacity > lanes {
        capacity = lanes;
    }
    if batches > capacity {
        batches = capacity;
    }
    var cache = alloc(LRKernelClosure*, count);
    var items = alloc(LRItem, count);
    var needed = alloc(u8, count);
    if cache == null || items == null || needed == null {
        free(cache);
        free(items);
        free(needed);
        return false;
    }
    fill(cache, 0, count *sizeof(LRKernelClosure*));
    fill(needed, 0, count);
    var owner = entity_create_related(anchor);
    if owner == null {
        free(cache);
        free(items);
        free(needed);
        return false;
    }
    var kind = lr_work_node(owner);
    var ok = kind != null;
    if ok {
        ok = entity_register(kind, sizeof(LRClosureTask), alignof(LRClosureTask), 0);
    }
    var graph: WorkGraph;
    work_init(&graph, 1, 0);
    var jobs: LRClosureTask*[WorkPoolMaximumCapacity];
    for(var i: usize = 0; i < value.states.length && ok; ++i) {
        var state_items = &value.states.data[i].items.values;
        foreach(var & item in state_items) {
            if !lr_kernel(value.analysis, item) {
                continue;
            }
            var key = value.analysis.rules[item.rule].begin + item.rule + item.position;
            if needed[key] != 0 {
                continue;
            }
            copy(&items[key], item, sizeof(LRItem));
            needed[key] = 1;
        }
    }
    var position: usize = 0;
    for(var i: usize = 0; i < batches && ok; i++) {
        var node = lr_work_node(owner);
        if node == null {
            ok = false;
            break;
        }
        var result = bits(LRClosureTask*, entity_component_data(entity_component_add(node, kind)));
        if result == null {
            ok = false;
            break;
        }
        fill(result, 0, sizeof(LRClosureTask));
        result.kernel.kind = CompilerKernelKind.LRClosure;
        result.kernel.payload = bits(void*, result);
        result.analysis = value.analysis;
        result.items = items;
        result.needed = needed;
        result.closures = cache;
        result.begin = position;
        result.count = count / batches +(i < count % batches ? 1: 0);
        position += result.count;
        jobs[i] = result;
        var query = work_request(&graph, node, 1, 0);
        ok = query != 0;
        ok &&= work_access(&graph, query, 1, 1, result.begin, result.count, WorkAccessMode.Write);
        ok &&= work_access(&graph, query, 1, 2, 0, 1, WorkAccessMode.Read);
        ok &&= work_seal(&graph, query);
        ok &&= work_demand(&graph, query);
        ok &&= work_take_task(&graph, &result.ticket, query);
    }
    var workers: ParserWorkers = default;
    if ok && capacity != 0 {
        ok = parser_workers_open(&workers, anchor, capacity);
    }
    var pool = workers.pool;
    var admission: ParserAdmission = default;
    if ok { ok = parser_admission_open(&admission, anchor, batches); }
    var view: void* = null;
    if ok {
        view = entity_view_open(owner);
        ok = view != null;
    }
    if ok { ok = compiler_kernel_dispatch_admitted(pool, &jobs[0], batches, admission.extra); }
    if ok {
        for(var i: usize = 0; i < batches; ++i) {
            var result = jobs[i];
            if !work_finish(&graph, &result.ticket, result.success) || !result.success {
                ok = false;
            }
        }
    }
    if view != null {
        entity_view_close(view);
    }
    parser_admission_close(&admission, &graph);
    if ok {
        var lookahead = lr_states_propagation_parallel(value, constructs, cache, owner, &graph, pool);
        ok = lookahead != null;
        if ok {
            ok = lr_propagation_solve_parallel(lookahead, owner, &graph, pool);
        }
        if ok {
            ok = lr_lalr_actions_parallel(value, lookahead, owner, &graph, pool);
        }
        lr_propagation_destroy(lookahead);
    }
    parser_workers_close(&workers);
    for(var i: usize = 0; i < count; ++i) {
        lr_kernel_closure_destroy(cache[i]);
    }
    work_dispose(&graph);
    entity_release(owner);
    free(items);
    free(needed);
    free(cache);
    return ok;
}
