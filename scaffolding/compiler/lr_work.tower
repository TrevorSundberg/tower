import tower;
import compiler_kernel;
import lr_analysis;
import lr_lalr;
import lr_states;
import lr_types;
import .library.vector;
import .library.work_graph;
import .library.work_pool;

extern fn entity_create_related(anchor: void*): void*;
extern fn entity_attach(child: void*, parent: void*, name: u8*): bool;
extern fn entity_release(entity: void*): usize;
extern fn entity_register(type: void*, size: usize, alignment: usize, lifecycle: usize): bool;
extern fn entity_component_add(node: void*, type: void*): void*;
extern fn entity_component_data(component: void*): void*;
extern fn entity_view_open(anchor: void*): void*;
extern fn entity_view_close(view: void*): void;

struct LRClosureTask {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    analysis: LRAnalysis*;
    item: LRItem;
    closure: LRKernelClosure*;
    key: usize;
}

struct LRActionTask {
    kernel: CompilerKernel;
    ticket: WorkTicket;
    states: LRStates*;
    lookahead: LRPropagation*;
    results: vector(LRAction)*;
    begin: usize;
    count: usize;
    success: bool;
}

export fn compiler_lr_action_kernel(payload: void*): void {
    var task = bits(LRActionTask*, payload);
    task.success = true;
    for(var i = task.begin; i < task.begin + task.count; i++) {
        if !lr_lalr_state_actions(task.states, task.lookahead, i, &task.results[i]) {
            task.success = false;
            return;
        }
    }
}

// Only immutable grammar/FIRST data are shared. LRAnalysis.failed is private:
// the ordinary closure routines may set it on allocation failure.
export fn compiler_lr_kernel(payload: void*): void {
    var task = bits(LRClosureTask*, payload);
    var analysis: LRAnalysis;
    copy(&analysis, task.analysis, sizeof(LRAnalysis));
    task.closure = lr_kernel_closure(&analysis, &task.item);
}

fn lr_work_node(parent: void*): void* {
    var node = entity_create_related(parent);
    if node == null { return null; }
    if !entity_attach(node, parent, null) { entity_release(node); return null; }
    entity_release(node);
    return node;
}

// Lookahead has reached its fixed point before admission. Workers read those
// immutable ranges and state inputs; each owns a contiguous range of private
// vectors. Keep the existing closure pool alive across this phase boundary.
fn lr_lalr_actions_parallel(value: LRStates*, lookahead: LRPropagation*, owner: void*,
                             graph: WorkGraph*, pool: WorkPool*): bool {
    var count = value.states.length / 128;
    if count > pool.count { count = pool.count; }
    if count < 2 { return lr_lalr_actions(value, lookahead); }
    if !work_reset(graph, graph.revision + 1, graph.profile) { return false; }
    var results = alloc(vector(LRAction), value.states.length);
    if results == null { return false; }
    fill(results, 0, value.states.length * sizeof(vector(LRAction)));
    defer {
        for(var i: usize = 0; i < value.states.length; i++) { vector_dispose(&results[i]); }
        free(results);
    }
    var kind = lr_work_node(owner);
    if kind == null || !entity_register(kind, sizeof(LRActionTask), alignof(LRActionTask), 0) { return false; }
    var jobs: LRActionTask*[256];
    var position: usize = 0;
    for(var i: usize = 0; i < count; i++) {
        var node = lr_work_node(owner);
        if node == null { return false; }
        var job = bits(LRActionTask*, entity_component_data(entity_component_add(node, kind)));
        if job == null { return false; }
        fill(job, 0, sizeof(LRActionTask));
        job.kernel.kind = CompilerKernelKind.LRAction;
        job.kernel.payload = bits(void*, job);
        job.states = value;
        job.lookahead = lookahead;
        job.results = results;
        job.begin = position;
        job.count = value.states.length / count + (i < value.states.length % count ? 1 : 0);
        position += job.count;
        jobs[i] = job;
        var id = work_request(graph, node, 2, convert(u64, job.begin));
        var ok = id != 0;
        ok &&= work_access(graph, id, 1, 3, job.begin, job.count, WorkAccessMode.Write);
        ok &&= work_access(graph, id, 1, 2, 0, 1, WorkAccessMode.Read);
        ok &&= work_seal(graph, id);
        ok &&= work_demand(graph, id);
        ok &&= work_take(graph, &job.ticket);
        if !ok { return false; }
    }
    var view = entity_view_open(owner);
    if view == null { return false; }
    var ok = true;
    var admitted: usize = 0;
    for(; admitted < count; admitted++) {
        if !work_pool_submit(pool, bits(void*, &jobs[admitted].kernel)) { ok = false; break; }
    }
    // Even partial admission or a failed result must join before releasing the
    // view, private vectors or propagation graph. Never publish a partial table.
    for(var i: usize = 0; i < admitted; i++) {
        if work_pool_receive(pool, true) == null { ok = false; }
    }
    entity_view_close(view);
    for(var i: usize = 0; i < admitted; i++) {
        if !work_finish(graph, &jobs[i].ticket, jobs[i].success) || !jobs[i].success { ok = false; }
    }
    if !ok { return false; }
    for(var i: usize = 0; i < value.states.length; i++) {
        var actions = &value.states.data[i].actions;
        vector_dispose(actions);
        copy(actions, &results[i], sizeof(vector(LRAction)));
        fill(&results[i], 0, sizeof(vector(LRAction)));
    }
    return true;
}

// The result components are transient analysis jobs on ordinary entities in the
// grammar's world. The grammar remains authoritative; closure/index objects are
// private derived data. No grammar update is published from a worker.
export fn lr_states_lalr_parallel(value: LRStates*, constructs: bool, anchor: void*): bool {
    var capacity = work_thread_capacity();
    if capacity <= 1 || anchor == null { return lr_states_lalr(value, constructs); }
    var count = value.analysis.symbol_count + value.analysis.rule_count;
    // Tiny tables still use the same closure algorithm without pool startup.
    if count < 32 { return lr_states_lalr(value, constructs); }
    var cache = alloc(LRKernelClosure*, count);
    var tasks = alloc(LRClosureTask*, count);
    if cache == null || tasks == null { free(cache); free(tasks); return false; }
    fill(cache, 0, count * sizeof(LRKernelClosure*));
    fill(tasks, 0, count * sizeof(LRClosureTask*));
    var owner = entity_create_related(anchor);
    if owner == null { free(cache); free(tasks); return false; }
    var kind = lr_work_node(owner);
    var ok = kind != null;
    if ok { ok = entity_register(kind, sizeof(LRClosureTask), alignof(LRClosureTask), 0); }
    var graph: WorkGraph;
    work_init(&graph, 1, 0);
    var jobs: vector(LRClosureTask*);
    vector_init(LRClosureTask*, &jobs);
    for(var i: usize = 0; i < value.states.length && ok; ++i) {
        var items = &value.states.data[i].items.values;
        for(var j: usize = 0; j < items.length && ok; ++j) {
            var item = &items.data[j];
            if !lr_kernel(value.analysis, item) { continue; }
            var key = value.analysis.rules[item.rule].begin + item.rule + item.position;
            if tasks[key] != null { continue; }
            var node = lr_work_node(owner);
            if node == null { ok = false; break; }
            var result = bits(LRClosureTask*, entity_component_data(entity_component_add(node, kind)));
            if result == null { ok = false; break; }
            fill(result, 0, sizeof(LRClosureTask));
            result.kernel.kind = CompilerKernelKind.LRClosure;
            result.kernel.payload = bits(void*, result);
            result.analysis = value.analysis;
            copy(&result.item, item, sizeof(LRItem));
            result.key = key;
            tasks[key] = result;
            ok = vector_push(LRClosureTask*, &jobs, result);
            var query = work_request(&graph, node, 1, 0);
            ok &&= query != 0;
            ok &&= work_access(&graph, query, 1, 1, key, 1, WorkAccessMode.Write);
            ok &&= work_access(&graph, query, 1, 2, 0, 1, WorkAccessMode.Read);
            ok &&= work_seal(&graph, query);
            ok &&= work_demand(&graph, query);
        }
    }
    var pool: WorkPool;
    fill(&pool, 0, sizeof(WorkPool));
    if capacity > jobs.length { capacity = jobs.length; }
    if ok && capacity != 0 { ok = work_pool_open(&pool, capacity); }
    var view: void* = null;
    if ok { view = entity_view_open(owner); ok = view != null; }
    var batch: LRClosureTask*[256];
    var next: usize = 0;
    while ok && next < jobs.length {
        var admitted: usize = 0;
        var ticket: WorkTicket;
        while admitted < pool.count && work_take(&graph, &ticket) {
            // Demand/admission order equals the immutable job index here.
            var result = jobs.data[next];
            next++;
            copy(&result.ticket, &ticket, sizeof(WorkTicket));
            batch[admitted] = result;
            if !work_pool_submit(&pool, bits(void*, &result.kernel)) { ok = false; break; }
            admitted++;
        }
        if admitted == 0 { ok = false; break; }
        for(var i: usize = 0; i < admitted; ++i) {
            if work_pool_receive(&pool, true) == null { ok = false; }
        }
        for(var i: usize = 0; i < admitted; ++i) {
            var result = batch[i];
            var success = result.closure != null;
            cache[result.key] = result.closure;
            if !work_finish(&graph, &result.ticket, success) || !success { ok = false; }
        }
    }
    if view != null { entity_view_close(view); }
    if ok {
        var lookahead = lr_states_lookahead_cached(value, constructs, cache);
        ok = lookahead != null;
        if ok { ok = lr_lalr_actions_parallel(value, lookahead, owner, &graph, &pool); }
        lr_propagation_destroy(lookahead);
    }
    work_pool_close(&pool);
    for(var i: usize = 0; i < count; ++i) { lr_kernel_closure_destroy(cache[i]); }
    vector_dispose(LRClosureTask*, &jobs);
    work_dispose(&graph);
    entity_release(owner);
    free(tasks);
    free(cache);
    return ok;
}
