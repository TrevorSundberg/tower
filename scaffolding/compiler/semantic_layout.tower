import tower;
import .library.work_budget_types;
import semantic_context_types;
import foundation_tags;
import foundation_types;
import semantic_context;
import semantic_support;
import semantic_types;
import semantic_declarations;
import semantic_layout_kernel;
import semantic_work_ids;
import compiler_kernel;
import .library.vector;
import .library.work_graph;
import .library.work_pool;

extern fn entity_view_open(anchor: void*): void*;
extern fn entity_view_close(view: void*): void;
extern fn compiler_node_world(node: void*): void*;

// The native chain/fanout profile crosses dispatch overhead between 4096 and
// 8192 fields. Keep smaller layouts on the caller, including mixed frontiers.
var SemanticLayoutParallelFields: usize = 8192;

// Admit owned payload storage before exposing a query to its consumers. A
// partial failure stays on the context for disposal; no worker can receive it.
fn sem_layout_request(c: SemanticContext*, subject: void*): usize {
    var query = convert(u32, SemanticQuery.Layout);
    var known = work_find(&c.queries, subject, query, 0);
    if known != 0 { return known; }
    var type = sem_get(subject);
    if type == null || compiler_node_world(subject) != compiler_node_world(c.program.root) {
        sem_type_resource(c, subject, WorkBudgetError.Invalid);
        return 0;
    }
    var error: WorkBudgetError;
    if c.layout_results == null {
        var kind = sem_create_result(c.program.root, &error);
        if kind == null { sem_type_resource(c, subject, error); return 0; }
        error = entity_register_stage_result(kind, sizeof(SemanticLayoutWork), alignof(SemanticLayoutWork), 0, 0);
        if error != WorkBudgetError.None {
            sem_require(entity_attach_result(kind, null, null) == WorkBudgetError.None);
            sem_type_resource(c, subject, error);
            return 0;
        }
        c.layout_results = kind;
    }
    var component = entity_component_add_result(subject, c.layout_results, &error);
    if component == null { sem_type_resource(c, subject, error); return 0; }
    var result = bits(SemanticLayoutWork*, entity_component_data(component));
    *result = { subject: subject, ..default };
    result.kernel.kind = CompilerKernelKind.Layout;
    result.kernel.payload = bits(void*, result);
    if !vector_push(&c.layout_jobs, result) {
        sem_type_resource(c, subject, WorkBudgetError.Memory);
        return 0;
    }
    if type.type.scalar == SStruct && !semantic_enum(&type.type) {
        if !vector_reserve(&result.offsets, type.items.length) {
            sem_type_resource(c, subject, WorkBudgetError.Memory);
            return 0;
        }
        result.offsets.length = type.items.length;
    }
    var id = work_request(&c.queries, subject, query, 0);
    if id == 0 { sem_type_resource(c, subject, sem_query_error(c)); }
    return id;
}

fn sem_layout_dependency(c: SemanticContext*, consumer: usize, type: FoundationType*): bool {
    if semantic_aggregate(type) {
        var dependency = sem_layout_request(c, type.record);
        if dependency == 0 { return false; }
        if !work_depend(&c.queries, consumer, dependency)
            || !work_access(&c.queries, consumer, convert(u64, SemanticWorkDomain.Compiler), convert(u64, SemanticAccess.Layout), dependency, 1, WorkAccessMode.Read) {
            sem_type_resource(c, type.record, sem_query_error(c));
            return false;
        }
    }
    return true;
}

export fn sem_layout_discover(c: SemanticContext*, n: void*): usize {
    if !sem_ok(c) { return 0; }
    var graph = &c.queries;
    if !work_ok(graph) { sem_type_resource(c, n, sem_query_error(c)); return 0; }
    var first = graph.tasks.length;
    var root = sem_layout_request(c, n);
    if root == 0 { return 0; }
    var index = first;
    while index < graph.tasks.length {
        var id = index + 1;
        var task = work_task(graph, id);
        var subject = task.subject;
        var type = sem_get(subject);
        if !work_access(graph, id, convert(u64, SemanticWorkDomain.Compiler), convert(u64, SemanticAccess.Layout), id, 1, WorkAccessMode.Write) {
            sem_type_resource(c, subject, sem_query_error(c));
            return 0;
        }
        if type.type.scalar == SArray {
            if !sem_layout_dependency(c, id, &type.element) { return 0; }
        } else {
            if !semantic_enum(&type.type) {
                foreach(var & item in &type.items) {
                    var field = sem_get(*item);
                    if !sem_layout_dependency(c, id, &field.type) { return 0; }
                }
            }
        }
        if !work_seal(graph, id) { sem_type_resource(c, subject, sem_query_error(c)); return 0; }
        index++;
    }
    if !work_demand(graph, root) { sem_type_resource(c, n, sem_query_error(c)); return 0; }
    return root;
}

fn sem_layout_cycle(c: SemanticContext*, root: usize): void {
    var graph = &c.queries;
    var task = work_task(graph, root);
    if task.state == WorkState.Succeeded { return; }
    var subject = task.subject;
    var cycle: vector(usize);
    vector_init(&cycle);
    defer vector_dispose(&cycle);
    var found = work_cycle(graph, root, &cycle);
    sem_require(work_ok(graph));
    var chain: u8* = "";
    var index: usize = 0;
    while found && index < cycle.length {
        task = work_task(graph, cycle.data[index]);
        if index != 0 { chain = sem_cat(c, chain, " -> "); }
        chain = sem_cat(c, chain, sem_name(sem_get(task.subject)));
        if !sem_ok(c) { return; }
        index++;
    }
    sem_fail(c, subject, sem_cat(c, "Recursive by-value layout: ", sem_cat(c, chain, "; use a pointer")));
}

export fn sem_layout_execute(c: SemanticContext*): usize {
    if !sem_ok(c) || !work_ok(&c.queries) { return 0; }
    if c.workers.count == 0 && !sem_workers_open(c) { return 0; }
    var receipt: WorkReservation = default;
    var extra: usize = 0;
    defer sem_workers_release(c, &receipt);
    // All component allocation occurs before pinning. No worker performs an
    // entity mutation or uses the coordinator's semantic scratch/diagnostics.
    var view = entity_view_open(c.program.root);
    sem_require(view != null);
    var failed: SemanticLayoutWork* = null;
    var completed_count: usize = 0;
    loop {
        // A chain can release a profitable frontier after the initial grant.
        // Refresh only after every admitted result has joined and published;
        // no live job can lose its lane or retain a released receipt.
        if c.workers.threaded && c.workers.running == 0 {
            var ready: usize = 0;
            var inspected: usize = 0;
            for(var i = c.queries.head; i < c.queries.ready.length && inspected < c.workers.count; i++) {
                var id = c.queries.ready.data[i];
                if id == 0 { continue; }
                var task = work_task(&c.queries, id);
                if task.query != convert(u32, SemanticQuery.Layout) || task.state != WorkState.Ready { continue; }
                inspected++;
                var job = bits(SemanticLayoutWork*, entity_component_data(entity_component_get(task.subject, c.layout_results)));
                if job.offsets.length >= SemanticLayoutParallelFields { ready++; }
            }
            sem_workers_release(c, &receipt);
            extra = sem_workers_admit(c, ready, &receipt);
        }
        var result: SemanticLayoutWork* = null;
        var completed = bits(CompilerKernel*, work_pool_receive(&c.workers, false));
        if completed != null { result = bits(SemanticLayoutWork*, completed.payload); }
        var ticket: WorkTicket;
        while result == null && work_take_query(&c.queries, &ticket, convert(u32, SemanticQuery.Layout)) {
            var task = work_task(&c.queries, ticket.task);
            sem_require(task.query == convert(u32, SemanticQuery.Layout));
            var component = entity_component_get(task.subject, c.layout_results);
            var job = bits(SemanticLayoutWork*, entity_component_data(component));
            job.ticket = ticket;
            if job.offsets.length >= SemanticLayoutParallelFields && c.workers.running < extra {
                sem_require(work_pool_submit(&c.workers, bits(void*, &job.kernel)));
            } else {
                c.workers.execute(bits(void*, &job.kernel));
                result = job;
            }
        }
        if result == null {
            if c.workers.running == 0 { break; }
            completed = bits(CompilerKernel*, work_pool_receive(&c.workers, true));
            sem_require(completed != null);
            result = bits(SemanticLayoutWork*, completed.payload);
        }
        var success = result.error == null;
        if success {
            // The query owns this layout's write range. Its consumers cannot
            // run until these fields publish and work_finish releases them;
            // unrelated layouts can keep running under the same pinned view.
            var type = sem_get(result.subject);
            type.size = result.size;
            type.alignment = result.alignment;
            for(var field: usize = 0; field < result.offsets.length; field++) {
                sem_get(type.items.data[field]).byte_offset = result.offsets.data[field];
            }
        } else {
            // Completion order must not choose the diagnostic. Drain every
            // independent ready query and select the first discovery ordinal.
            if failed == null || result.ticket.task < failed.ticket.task { failed = result; }
        }
        sem_require(work_finish(&c.queries, &result.ticket, success));
        completed_count++;
    }
    entity_view_close(view);
    if failed != null { sem_fail(c, failed.error_node, failed.error); }
    return completed_count;
}

fn sem_layout(c: SemanticContext*, n: void*): void {
    if !sem_ok(c) { return; }
    // Body workers only consume completed layouts. Avoid touching the shared
    // demand scratch/index for an already-published result.
    var known = work_find(&c.queries, n, convert(u32, SemanticQuery.Layout), 0);
    if known != 0 && work_task(&c.queries, known).state == WorkState.Succeeded {
        sem_query_read(c, known);
        return;
    }
    // A worker can only consume a published layout. Structural construction
    // belongs to its coordinator continuation, including failed-type retries.
    sem_require(c.entity_stage == null);
    if known != 0 && sem_declaration_failure(c, known) { return; }
    // A cached aggregate may contain a nominal type whose fields failed in a
    // different producer. Never compute a layout from those partial fields.
    var fields = sem_declaration_layout_waiting(c, n);
    if fields != 0 && sem_declaration_failure(c, fields) { return; }
    var root = sem_layout_discover(c, n);
    if root == 0 { return; }
    if work_task(&c.queries, root).state == WorkState.Succeeded {
        sem_query_read(c, root);
        return;
    }
    sem_layout_execute(c);
    if sem_ok(c) { sem_layout_cycle(c, root); }
    if sem_ok(c) { sem_query_read(c, root); }
}

fn sem_layout_all(c: SemanticContext*): void {
    if !sem_ok(c) { return; }
    // The registry is append-only within a compilation. Inspect each new type
    // once, including queries discovered earlier by declarations. This is an
    // admission frontier, never a cross-revision/type-identity cache.
    var pending: vector(usize) = default;
    defer vector_dispose(&pending);
    var index = c.layout_checked;
    while index < c.program.types.length {
        var type = c.program.types.data[index];
        if sem_get(type).type.record != null && sem_get(type).type.scalar != SFunction {
            var query = sem_layout_discover(c, sem_get(type).type.record);
            if query == 0 { return; }
            if work_task(&c.queries, query).state != WorkState.Succeeded {
                if !vector_push(&pending, query) { sem_type_resource(c, type, WorkBudgetError.Memory); return; }
            }
        }
        index++;
    }
    if pending.length != 0 { sem_layout_execute(c); }
    foreach(var query in &pending) { if sem_ok(c) { sem_layout_cycle(c, query); } }
    if sem_ok(c) { c.layout_checked = index; }
}

fn sem_layout_dispose(c: SemanticContext*): void {
    work_pool_close(&c.workers);
    foreach(var result in &c.layout_jobs) {
        vector_dispose(&result.offsets);
    }
    vector_dispose(&c.layout_jobs);
}
