import tower;
import lexer_table;
import lr_analysis;
import lr_runtime;
import lr_states;
import .library.work_buffer;
import .library.work_buffer_types;
import .library.work_budget_types;
import .library.work_vector;
import .library.work_vector_types;
import lr_types;

// Query work limits are independent of the runtime world's physical byte ledger.
var LRProbeStepLimit: usize = 128;
var LRCompletionQuerySteps: usize = 8192;
var LRCompletionSuffixSteps: usize = 65536;
var LRCompletionMaximumPaths: usize = 512;

// LR and proven finite-sequence control over integer symbols. Frames borrow
// forest handles; the shared entity forest retains ownership of syntax nodes.
// A pull protocol keeps stream callbacks outside the deterministic control loop.
struct LRParser {
    storage: WorkBuffer;
    storage_error: WorkBudgetError;
    runtime: LRRuntime*;
    stack: work_vector(LRFrame);
    work: LRWork;
    prefix: bool;
    shifted: bool;
    finishing: bool;
    consumed: usize;
    sequence: bool;
    evidence: work_vector(u8);
    sequence_first: usize;
    sequence_last: usize;
    sequence_start: usize;
    sequence_end: usize;
}

export fn lr_parser_destroy(value: LRParser*): void {
    if value == null {
        return;
    }
    work_vector_dispose(&value.stack);
    work_vector_dispose(&value.evidence);
    var storage = value.storage;
    work_buffer_dispose(&storage);
}

export fn lr_parser_create(runtime: LRRuntime*, prefix: bool, specialize: bool): LRParser* {
    var error = WorkBudgetError.None;
    return lr_parser_create_result(runtime, prefix, specialize, &error);
}

export fn lr_parser_create_result(runtime: LRRuntime*, prefix: bool, specialize: bool, error: WorkBudgetError*): LRParser* {
    var storage: WorkBuffer = default;
    *error = work_buffer_resize(&storage, runtime.budget, sizeof(LRParser), 0);
    if *error != WorkBudgetError.None { return null; }
    var value = bits(LRParser*, storage.data);
    *value = {storage: storage, runtime: runtime, prefix: prefix, ..default};
    if specialize {
        value.sequence = runtime.sequence != null;
    }
    value.sequence_first = lr_none();
    value.sequence_last = lr_none();
    var frame: LRFrame = default;
    frame.first = lr_none();
    frame.last = lr_none();
    *error = work_vector_push_result(&value.stack, runtime.budget, frame);
    if *error == WorkBudgetError.None {
        return value;
    }
    lr_parser_destroy(value);
    return null;
}

// Statuses are the private host pull protocol, not Foundation instructions:
// input, shift, reduce, accept, unexpected, empty-prefix, DFA shift/reduce, invalid.
fn lr_parser_sequence_step(value: LRParser*, ready: bool, id: u32, error: bool, result: LRStep*): u32 {
    var runtime = value.runtime;
    var position = value.evidence.length;
    var rule = &runtime.rules.data[runtime.sequence_rule];
    var complete = position == rule.count;
    var needs_input = true;
    if complete {
        if value.prefix {
            needs_input = false;
        }
    }
    if needs_input {
        if !ready {
            return 0;
        }
    }
    value.work.actions++;
    result.rule = runtime.sequence_rule;
    if complete {
        if needs_input {
            if id != LRTokenEnd {
                return 4;
            }
            if error {
                return 4;
            }
        }
        result.next = lr_runtime_goto(runtime, 0, rule.owner);
        result.start = value.sequence_start;
        result.end = value.sequence_end;
        return 7;
    }
    if error {
        return 4;
    }
    if !symbol_sequence_accepts(runtime.sequence, position, id) {
        return 4;
    }
    var next = position + 1;
    result.next = runtime.sequence_states.data[next];
    result.pop = position;
    return 6;
}

fn lr_parser_decide(value: LRParser*, ready: bool, id: u32, error: bool, result: LRStep*): u32 {
    if value.sequence {
        return lr_parser_sequence_step(value, ready, id, error, result);
    }
    var top = value.stack.length -1;
    var state = value.stack.data[top].state;
    var action: LRAction;
    action.rule = lr_none();
    action.state = lr_none();
    var use_default = false;
    if value.prefix {
        if !ready {
            action.rule = lr_runtime_default(value.runtime, state);
            use_default = action.rule != lr_none();
        }
    }
    var found = use_default;
    if use_default {
        value.work.actions++;
    } else {
        if !ready {
            if !value.finishing {
                return 0;
            }
        }
        if value.finishing {
            id = LRTokenEnd;
            error = false;
        }
        if !error {
            value.work.actions++;
            found = lr_runtime_action(value.runtime, state, id, &action);
        }
        if !found {
            if value.prefix {
                if value.shifted {
                    if !value.finishing {
                        value.work.actions++;
                        found = lr_runtime_action(value.runtime, state, LRTokenEnd, &action);
                        if found {
                            value.finishing = true;
                            id = LRTokenEnd;
                        }
                    }
                }
            }
        }
    }
    if !found {
        return 4;
    }
    result.id = id;
    result.rule = action.rule;
    result.next = action.state;
    if action.state != lr_none() {
        return 1;
    }
    if action.rule == 0 {
        if value.prefix {
            if !value.shifted {
                return 5;
            }
        }
        return 3;
    }
    var rule = &value.runtime.rules.data[action.rule];
    var invalid = rule.count >= value.stack.length;
    if invalid {
        return 8;
    }
    result.pop = rule.count;
    if !ready {
        result.start = value.consumed;
    }
    if value.finishing {
        result.start = value.consumed;
    }
    result.end = result.start;
    var begin = value.stack.length -rule.count;
    if rule.count != 0 {
        result.start = value.stack.data[begin].start;
        result.end = result.start;
        var index = begin;
        for(; index != value.stack.length; index++) {
            var frame = &value.stack.data[index];
            var end = frame.start + frame.length;
            if end > result.end {
                result.end = end;
            }
        }
    }
    var previous = begin -1;
    result.next = lr_runtime_goto(value.runtime, value.stack.data[previous].state, rule.owner);
    invalid = result.next == lr_none();
    if invalid {
        return 8;
    }
    return 2;
}

export fn lr_parser_step(value: LRParser*, ready: bool, id: u32, error: bool, start: usize, length: usize, result: LRStep*): u32 {
    *result = default;
    result.rule = lr_none();
    result.next = lr_none();
    result.id = id;
    result.start = start;
    result.end = start + length;
    result.kind = lr_parser_decide(value, ready, id, error, result);
    return result.kind;
}

export fn lr_parser_commit(value: LRParser*, step: LRStep*, first: usize, last: usize): bool {
    if step.kind == 6 {
        var evidence = step.end != step.start;
        var byte = convert(u8, evidence);
        value.storage_error = work_vector_push_result(&value.evidence, value.runtime.budget, byte);
        if value.storage_error != WorkBudgetError.None {
            return false;
        }
        if value.evidence.length == 1 {
            value.sequence_start = step.start;
        }
        if step.end > value.sequence_end {
            value.sequence_end = step.end;
        }
        value.sequence_first = first;
        value.sequence_last = last;
        value.consumed = step.end;
        value.shifted = true;
        value.work.shifts++;
        return true;
    }
    var length = value.stack.length -step.pop;
    var count = length + 1;
    value.storage_error = count == 0 ? WorkBudgetError.Invalid
        : work_vector_reserve_result(&value.stack, value.runtime.budget, count);
    if value.storage_error != WorkBudgetError.None {
        return false;
    }
    var frame = &value.stack.data[length];
    frame.state = step.next;
    frame.first = first;
    frame.last = last;
    frame.start = step.start;
    frame.length = step.end - step.start;
    value.stack.length = count;
    if step.kind == 1 {
        value.consumed = step.end;
        value.shifted = true;
        value.work.shifts++;
    } else {
        value.work.reductions++;
        value.work.popped = value.work.popped + step.pop;
        value.sequence = false;
    }
    return true;
}

export fn lr_parser_frame_count(value: LRParser*): usize {
    if value.sequence {
        var count = value.evidence.length + 1;
        return count;
    }
    return value.stack.length;
}

export fn lr_parser_frame(value: LRParser*, index: usize, result: LRFrame*): void {
    if value.sequence {
        *result = default;
        result.first = lr_none();
        result.last = lr_none();
        result.state = value.runtime.sequence_states.data[index];
        if index != 0 {
            var previous = index -1;
            result.length = convert(usize, value.evidence.data[previous]);
        }
    } else {
        copy(result, &value.stack.data[index], sizeof(LRFrame));
    }
}

export fn lr_parser_frames(value: LRParser*): LRFrame* {
    return value.stack.data;
}

export fn lr_parser_sequence_forest(value: LRParser*, result: LRFrame*): void {
    *result = default;
    result.first = value.sequence_first;
    result.last = value.sequence_last;
    result.start = value.sequence_start;
    result.length = value.sequence_end - value.sequence_start;
}

export fn lr_parser_consumed(value: LRParser*): usize {
    return value.consumed;
}

export fn lr_parser_shifted(value: LRParser*): bool {
    return value.shifted;
}

export fn lr_parser_work(value: LRParser*, result: LRWork*): void {
    copy(result, &value.work, sizeof(LRWork));
}

// Error-path probes share an explicit operation quota and borrow their runtime's
// physical byte budget. They never execute semantic actions, consume a source
// stream, or mutate the real recognizer's stack. The runtime outlives its readers.
struct LRProbeFrames {
    storage: WorkBuffer;
    data: LRProbeFrame*;
    length: usize;
}

struct LRProbe {
    storage: WorkBuffer;
    runtime: LRRuntime*;
    budget: LRProbeBudget*;
    frames: LRProbeFrames;
}

fn lr_probe_failure(budget: LRProbeBudget*, error: WorkBudgetError): void {
    budget.complete = false;
    if budget.resource_error == WorkBudgetError.None { budget.resource_error = error; }
}

fn lr_probe_reserve(value: LRProbe*, needed: usize): bool {
    var frames = &value.frames;
    var capacity = frames.storage.capacity / sizeof(LRProbeFrame);
    if needed <= capacity { return true; }
    var error = work_buffer_grow_elements(&frames.storage, value.runtime.budget, frames.length,
        capacity, needed, sizeof(LRProbeFrame), alignof(LRProbeFrame));
    if error != WorkBudgetError.None { lr_probe_failure(value.budget, error); return false; }
    frames.data = bits(LRProbeFrame*, frames.storage.data);
    return true;
}

fn lr_probe_push(value: LRProbe*, frame: LRProbeFrame): bool {
    var needed = value.frames.length + 1;
    if needed == 0 { lr_probe_failure(value.budget, WorkBudgetError.Invalid); return false; }
    if !lr_probe_reserve(value, needed) { return false; }
    value.frames.data[value.frames.length++] = frame;
    return true;
}

export fn lr_probe_destroy(value: LRProbe*): void {
    if value == null {
        return;
    }
    work_buffer_dispose(&value.frames.storage);
    var storage = value.storage;
    work_buffer_dispose(&storage);
}

fn lr_probe_allocate(runtime: LRRuntime*, budget: LRProbeBudget*, count: usize): LRProbe* {
    var storage: WorkBuffer = default;
    var error = work_buffer_resize(&storage, runtime.budget, sizeof(LRProbe), 0);
    if error != WorkBudgetError.None {
        lr_probe_failure(budget, error);
        return null;
    }
    var value = bits(LRProbe*, storage.data);
    *value = {storage: storage, runtime: runtime, budget: budget, ..default};
    if lr_probe_reserve(value, count) {
        value.frames.length = count;
        return value;
    }
    budget.complete = false;
    lr_probe_destroy(value);
    return null;
}

export fn lr_probe_create(parser: LRParser*, budget: LRProbeBudget*): LRProbe* {
    budget.resource_error = WorkBudgetError.None;
    var count = lr_parser_frame_count(parser);
    var value = lr_probe_allocate(parser.runtime, budget, count);
    if value == null {
        return null;
    }
    var index: usize = 0;
    loop {
        if index == count {
            return value;
        }
        var frame: LRFrame;
        lr_parser_frame(parser, index, &frame);
        value.frames.data[index].state = frame.state;
        value.frames.data[index].consumed = frame.length != 0;
        index++;
    }
}

export fn lr_probe_clone(source: LRProbe*): LRProbe* {
    var count = source.frames.length;
    var value = lr_probe_allocate(source.runtime, source.budget, count);
    if value != null {
        var bytes = count *sizeof(LRProbeFrame);
        copy(value.frames.data, source.frames.data, bytes);
    }
    return value;
}

export fn lr_probe_reset(value: LRProbe*): void {
    value.frames.length = 1;
    value.frames.data[0].state = 0;
    value.frames.data[0].consumed = false;
}

export fn lr_probe_count(value: LRProbe*): usize {
    return value.frames.length;
}

export fn lr_probe_frames(value: LRProbe*): LRProbeFrame* {
    return value.frames.data;
}

export fn lr_probe_accepts(value: LRProbe*, id: u32): bool {
    var top = value.frames.length -1;
    var action: LRAction;
    return lr_runtime_action(value.runtime, value.frames.data[top].state, id, &action);
}

export fn lr_probe_step(value: LRProbe*, id: u32, before: usize*): u32 {
    *before = lr_none();
    if value.budget.resource_error != WorkBudgetError.None { return 0; }
    var steps: usize = 0;
    loop {
        var exhausted = steps == LRProbeStepLimit;
        if exhausted {
            break;
        }
        exhausted = value.budget.remaining == 0;
        if exhausted {
            break;
        }
        value.budget.remaining--;
        var top = value.frames.length -1;
        var state = value.frames.data[top].state;
        var action: LRAction;
        if !lr_runtime_action(value.runtime, state, id, &action) {
            return 0;
        }
        var frame: LRProbeFrame;
        frame.state = action.state;
        frame.consumed = false;
        if action.state != lr_none() {
            *before = state;
            var ok = lr_probe_push(value, frame);
            if ok {
                return 1;
            }
            break;
        }
        if action.rule == 0 {
            return 2;
        }
        var rule = &value.runtime.rules.data[action.rule];
        var invalid = rule.count >= value.frames.length;
        if invalid {
            return 0;
        }
        var begin = value.frames.length -rule.count;
        for(var index = begin; index != value.frames.length; index++) {
            if value.frames.data[index].consumed {
                frame.consumed = true;
            }
        }
        value.frames.length = begin;
        var previous = begin -1;
        frame.state = lr_runtime_goto(value.runtime, value.frames.data[previous].state, rule.owner);
        invalid = frame.state == lr_none();
        if invalid {
            return 0;
        }
        var ok = lr_probe_push(value, frame);
        if !ok {
            break;
        }
        steps++;
    }
    value.budget.complete = false;
    return 0;
}

// Editor lookahead snapshots are derived indexes over the live LR stack. They
// never run semantic actions or alter the recognizer. Every query is bounded.
struct LRCompletion {
    storage: WorkBuffer;
    budget: LRProbeBudget;
    original: LRProbe*;
}

struct LRCompletionPath {
    probe: LRProbe*;
    parent: usize;
    choice: usize;
    depth: usize;
}

// The bounded worklist uses the shared buffer growth operation directly. Its
// typed view adds no second owner or generic specialization to the parser unit.
struct LRCompletionPaths {
    storage: WorkBuffer;
    data: LRCompletionPath*;
    length: usize;
}

fn lr_completion_path_add(paths: LRCompletionPaths*, budget: WorkBudget*, value: LRCompletionPath): WorkBudgetError {
    var needed = paths.length + 1;
    if needed == 0 { return WorkBudgetError.Invalid; }
    var capacity = paths.storage.capacity / sizeof(LRCompletionPath);
    if needed > capacity {
        var error = work_buffer_grow_elements(&paths.storage, budget, paths.length,
            capacity, needed, sizeof(LRCompletionPath), alignof(LRCompletionPath));
        if error != WorkBudgetError.None { return error; }
        paths.data = bits(LRCompletionPath*, paths.storage.data);
    }
    paths.data[paths.length++] = value;
    return WorkBudgetError.None;
}

export fn lr_completion_create(parser: LRParser*): LRCompletion* {
    var error = WorkBudgetError.None;
    return lr_completion_create_result(parser, &error);
}

export fn lr_completion_create_result(parser: LRParser*, error: WorkBudgetError*): LRCompletion* {
    var storage: WorkBuffer = default;
    *error = work_buffer_resize(&storage, parser.runtime.budget, sizeof(LRCompletion), 0);
    if *error != WorkBudgetError.None { return null; }
    var c = bits(LRCompletion*, storage.data);
    *c = {storage: storage, ..default};
    c.budget.complete = true;
    c.original = lr_probe_create(parser, &c.budget);
    if c.original == null {
        *error = c.budget.resource_error;
        lr_completion_destroy(c);
        return null;
    }
    return c;
}

export fn lr_completion_resource_error(c: LRCompletion*): WorkBudgetError {
    return c.budget.resource_error;
}

export fn lr_completion_destroy(c: LRCompletion*): void {
    if c == null {
        return;
    }
    lr_probe_destroy(c.original);
    var storage = c.storage;
    work_buffer_dispose(&storage);
}

export fn lr_completion_runtime(c: LRCompletion*): LRRuntime* {
    return c.original.runtime;
}

export fn lr_completion_state(c: LRCompletion*): usize {
    var top = c.original.frames.length -1;
    return c.original.frames.data[top].state;
}

export fn lr_completion_accepts(c: LRCompletion*, id: u32): bool {
    if c == null {
        return false;
    }
    if c.original == null {
        return false;
    }
    c.budget.remaining = LRCompletionQuerySteps;
    c.budget.complete = true;
    c.budget.resource_error = WorkBudgetError.None;
    var probe = lr_probe_clone(c.original);
    if probe == null {
        return false;
    }
    var before: usize;
    var result = lr_probe_step(probe, id, &before);
    lr_probe_destroy(probe);
    var editor_result20 = result == 1;
    return editor_result20;
}

export fn lr_completion_follows(c: LRCompletion*, first: u32, second: u32): bool {
    if c == null {
        return false;
    }
    if c.original == null {
        return false;
    }
    c.budget.remaining = LRCompletionQuerySteps;
    c.budget.complete = true;
    c.budget.resource_error = WorkBudgetError.None;
    var probe = lr_probe_clone(c.original);
    if probe == null {
        return false;
    }
    var before: usize;
    var result = lr_probe_step(probe, first, &before);
    if result == 1 {
        result = lr_probe_step(probe, second, &before);
    }
    lr_probe_destroy(probe);
    var editor_value_5 = result == 1;
    return editor_value_5;
}

// Try a terminating continuation first. Every transition is checked against
// the full LR stack; this avoids spending the search budget on new statements
// while several enclosing blocks still need to close.
fn lr_completion_terminators(c: LRCompletion*, ids: u32*, count: usize, result: usize*, capacity: usize): usize {
    var current = lr_probe_clone(c.original);
    var missing = current == null;
    if missing {
        return lr_none();
    }
    var length: usize = 0;
    var answer = lr_none();
    loop {
        if c.budget.remaining == 0 || c.budget.resource_error != WorkBudgetError.None {
            break;
        }
        var before: usize;
        var trial = lr_probe_clone(current);
        missing = trial == null;
        if missing {
            break;
        }
        var status = lr_probe_step(trial, LRTokenEnd, &before);
        lr_probe_destroy(trial);
        if status == 2 {
            answer = length;
            break;
        }
        if length == capacity {
            break;
        }
        var found: bool = false;
        var i: usize = 0;
        for(; i != count; i++) {
            if c.budget.resource_error != WorkBudgetError.None { break; }
            trial = lr_probe_clone(current);
            missing = trial == null;
            if missing {
                break;
            }
            status = lr_probe_step(trial, ids[i], &before);
            if status == 1 {
                lr_probe_destroy(current);
                current = trial;
                result[length] = i;
                length++;
                found = true;
                break;
            }
            lr_probe_destroy(trial);
        }
        if !found {
            break;
        }
    }
    lr_probe_destroy(current);
    return answer;
}

// If closure preference fails, breadth-first search supplies a continuation.
// Token spellings come from the active grammar/lexer; output is scratch source.
export fn lr_completion_suffix(c: LRCompletion*, ids: u32*, count: usize, result: usize*, capacity: usize): usize {
    if c == null {
        return lr_none();
    }
    if c.original == null {
        return lr_none();
    }
    c.budget.remaining = LRCompletionSuffixSteps;
    c.budget.complete = true;
    c.budget.resource_error = WorkBudgetError.None;
    var terminated = lr_completion_terminators(c, ids, count, result, capacity);
    if c.budget.resource_error != WorkBudgetError.None { return lr_none(); }
    var complete = terminated != lr_none();
    if complete {
        return terminated;
    }
    var paths: LRCompletionPaths = default;
    defer work_buffer_dispose(&paths.storage);
    var first: LRCompletionPath = default;
    first.probe = lr_probe_clone(c.original);
    if first.probe == null {
        return lr_none();
    }
    var error = lr_completion_path_add(&paths, c.original.runtime.budget, first);
    var failed = error != WorkBudgetError.None;
    if failed {
        lr_probe_failure(&c.budget, error);
        lr_probe_destroy(first.probe);
        return lr_none();
    }
    var at: usize = 0;
    var length = lr_none();
    for(; at != paths.length; at++) {
        if c.budget.remaining == 0 || c.budget.resource_error != WorkBudgetError.None {
            break;
        }
        var path = &paths.data[at];
        var original = path.probe;
        var depth = path.depth;
        var probe = lr_probe_clone(original);
        if probe == null {
            break;
        }
        var before: usize;
        var status = lr_probe_step(probe, LRTokenEnd, &before);
        lr_probe_destroy(probe);
        if status == 2 {
            length = depth;
            var index = length;
            var parent = at;
            loop {
                if index == 0 {
                    break;
                }
                index--;
                result[index] = paths.data[parent].choice;
                parent = paths.data[parent].parent;
            }
            break;
        }
        if depth < capacity {
            var i: usize = 0;
            for(; i != count; i++) {
                if c.budget.resource_error != WorkBudgetError.None { break; }
                if paths.length >= LRCompletionMaximumPaths {
                    break;
                }
                probe = lr_probe_clone(original);
                if probe == null {
                    break;
                }
                status = lr_probe_step(probe, ids[i], &before);
                if status == 1 {
                    var next: LRCompletionPath = { probe: probe, parent: at, choice: i, depth: depth + 1 };
                    error = lr_completion_path_add(&paths, c.original.runtime.budget, next);
                    failed = error != WorkBudgetError.None;
                    if failed {
                        lr_probe_failure(&c.budget, error);
                        lr_probe_destroy(probe);
                        break;
                    }
                } else {
                    lr_probe_destroy(probe);
                }
            }
        }
    }
    at = 0;
    for(; at != paths.length; at++) {
        lr_probe_destroy(paths.data[at].probe);
    }
    return length;
}
