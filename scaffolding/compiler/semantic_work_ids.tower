import tower;

// Bound retained private stages independently of the host worker count.
// Workers refill within this window; structural publication ends the window.
var SemanticPreparationWindow: usize = 256;

// Stable scheduler identifiers; declarations have no module initialization effect.
enum SemanticQuery: u32 {
    Layout = 1, Evaluation, Declaration, DeclarationDiscovery, Lowering, Body,
    Flow, EvaluationPrepare, BodyPrepare, GenericBody, KnownScan, KnownOrder,
    KnownPublish, KnownProof, AggregatePrepare, KnownClone, KnownInputs, Expression,
    ArrayType, TypeConstruction, IterationResolution
}

enum SemanticWorkDomain: u64 { Compiler = 1 }

enum SemanticAccess: u64 {
    Layout = 1, Evaluation, Expression, Declaration, Discovery, Lowering, Body,
    Flow, TypeIndex, GenericBody, KnownAnalysis, KnownBinding, Aggregate, Iteration
}
