import tower;
import 'c-runtime';
import 'c-control';

// C89-style output over the shared Foundation entities. The vectors below are
// disposable name/storage indexes, not a second semantic representation.
struct CEmitter {
    text: vector(u8)*;
    error: vector(u8)*;
    nodes: vector(void*);
    owners: vector(void*);
    active: vector(bool);
    returning: vector(bool);
    changed: bool;
    owner: void*;
    depth: usize;
    pointer_bytes: u32;
    comments: bool;
}

fn ce_text(c: CEmitter*, text: u8*): void {
    sem_require(bytes_append(c.text, text, frontend_source_length(text)));
}

fn ce_number(c: CEmitter*, number: u64): void {
    var digits: u8[20];
    var at: usize = 20;
    loop {
        at = at - 1;
        var c_step1 = number % 10;
        digits[at] = convert(u8, c_step1) + 48;
        number = number / 10;
        var c_step2 = number == 0;
        if c_step2 {
            break;
        }
    }
    var c_step3 = 20 - at;
    sem_require(bytes_append(c.text, &digits[at], c_step3));
}

fn ce_fail(c: CEmitter*, message: u8*): void {
    var c_step4 = c.error.length == 0;
    if c_step4 {
        sem_require(bytes_append(c.error, message, frontend_source_length(message)));
    }
}

fn ce_indent(c: CEmitter*): void {
    var i: usize = 0;
    loop {
        var c_step5 = i == c.depth;
        if c_step5 {
            break;
        }
        ce_text(c, "    ");
        i = i + 1;
    }
}

fn ce_id(c: CEmitter*, node: void*): usize {
    var i: usize = 0;
    loop {
        var c_step6 = i == c.nodes.length;
        if c_step6 {
            return i;
        }
        var c_step7 = c.nodes.data[i] == node;
        if c_step7 {
            return i;
        }
        i = i + 1;
    }
}

fn ce_name(c: CEmitter*, node: void*, prefix: u8*): void {
    ce_text(c, prefix);
    ce_number(c, convert(u64, ce_id(c, node)));
}

fn ce_reserved(name: vector(u8)*): bool {
    var words = "auto break case char const continue default do double else enum extern float for goto if int long register return short signed sizeof static struct switch typedef union unsigned void volatile while asm bool catch class delete explicit export false friend inline mutable namespace new operator private protected public reinterpret_cast static_cast dynamic_cast const_cast template this throw true try typeid typename using virtual wchar_t and and_eq bitand bitor compl not not_eq or or_eq xor xor_eq alignas alignof char16_t char32_t constexpr decltype noexcept nullptr static_assert thread_local main uint8_t uint32_t uint64_t int32_t int64_t uintptr_t size_t NULL UINT64_C UINT64_MAX INT64_MAX INT64_MIN UINT32_MAX INT32_MAX INT32_MIN SIZE_MAX CHAR_BIT stdout stderr fputs fputc putchar puts printf exit memcpy memmove memset malloc realloc free fwrite _setmode _fileno";
    var at: usize = 0;
    loop {
        var end = words[at] == 0;
        if end {
            break;
        }
        var start = at;
        loop {
            var stop = words[at] == 0;
            var space = words[at] == 32;
            if space {
                stop = true;
            }
            if stop {
                break;
            }
            at = at + 1;
        }
        var length = at - start;
        var equal = length == name.length;
        var i: usize = 0;
        if equal {
            loop {
                var done = i == length;
                if done {
                    break;
                }
                var p = start + i;
                var mismatch = words[p] != name.data[i];
                if mismatch {
                    equal = false;
                    break;
                }
                i = i + 1;
            }
        }
        if equal {
            return true;
        }
        var space = words[at] == 32;
        if space {
            at = at + 1;
        }
    }
    var enough = name.length >= 3;
    if enough {
        var first = name.data[0] == 116;
        var upper_first = name.data[0] == 84;
        if upper_first {
            first = true;
        }
        if first {
            var second = name.data[1] == 99;
            var upper_second = name.data[1] == 67;
            if upper_second {
                second = true;
            }
            if second {
                var third = name.data[2] == 95;
                if third {
                    return true;
                }
            }
        }
    }
    var generated = name.length >= 2;
    if generated {
        var first = name.data[0] == 118;
        var temp = name.data[0] == 116;
        if temp {
            first = true;
        }
        if first {
            var digit = name.data[1] >= 48;
            if digit {
                digit = name.data[1] <= 57;
            }
            if digit {
                return true;
            }
        }
    }
    return false;
}

fn ce_function_name(c: CEmitter*, entity: void*): void {
    var n = sem_get(entity);
    if n.external {
        if sem_equal(sem_name(n), "platform_write") {
            ce_text(c, "tc_platform_write");
            return;
        }
    }
    var public = n.external;
    if n.exported {
        public = true;
    }
    if public {
        if ce_reserved(&n.name) {
            ce_fail(c, "C target external name conflicts with a reserved word or generated support symbol; use a C ABI wrapper");
        }
        var i: usize = 0;
        var c_step8 = n.name.length == 0;
        if c_step8 {
            ce_fail(c, "C target requires a nonempty foreign symbol");
        }
        loop {
            var c_step9 = i == n.name.length;
            if c_step9 {
                break;
            }
            var b = n.name.data[i];
            var valid = b >= 65;
            if valid {
                valid = b <= 90;
            }
            var c_step10 = b >= 97;
            if c_step10 {
                var c_step11 = b <= 122;
                if c_step11 {
                    valid = true;
                }
            }
            var c_step12 = b == 95;
            if c_step12 {
                valid = true;
            }
            var c_step13 = i != 0;
            if c_step13 {
                var c_step14 = b >= 48;
                if c_step14 {
                    var c_step15 = b <= 57;
                    if c_step15 {
                        valid = true;
                    }
                }
            }
            if valid {}
            else {
                ce_fail(c, "C target needs a plain C identifier for extern/export; namespace or member declarations require a C ABI wrapper");
            }
            i = i + 1;
        }
        // Preserve the explicit link name. C keywords/reserved names are rejected
        // below instead of silently changing an external ABI.
        if sem_equal(sem_name(n), "main") {
            ce_fail(c, "C target reserves main for the program entry point");
        }
        ce_text(c, sem_name(n));
        return;
    }
    ce_name(c, entity, "tc_fn_");
    ce_text(c, "_");
    var i: usize = 0;
    loop {
        var c_step16 = i == n.name.length;
        if c_step16 {
            break;
        }
        var b = n.name.data[i];
        var valid = b >= 65;
        if valid {
            valid = b <= 90;
        }
        var c_step17 = b >= 97;
        if c_step17 {
            var c_step18 = b <= 122;
            if c_step18 {
                valid = true;
            }
        }
        var c_step19 = b >= 48;
        if c_step19 {
            var c_step20 = b <= 57;
            if c_step20 {
                valid = true;
            }
        }
        if valid {
            sem_require(vector_push(u8, c.text, b));
        }
        else {
            ce_text(c, "_");
        }
        i = i + 1;
    }
}

fn ce_type(c: CEmitter*, t: FoundationType*): void {
    var c_step21 = t.pointers != 0;
    if c_step21 {
        ce_text(c, "unsigned char *");
        return;
    }
    var c_step22 = t.scalar == SVoid();
    if c_step22 {
        ce_text(c, "void");
        return;
    }
    var c_step23 = t.scalar == SBool();
    if c_step23 {
        ce_text(c, "uint8_t");
        return;
    }
    var c_step24 = t.scalar == SU8();
    if c_step24 {
        ce_text(c, "uint8_t");
        return;
    }
    var c_step25 = t.scalar == SI32();
    if c_step25 {
        ce_text(c, "uint32_t");
        return;
    }
    var c_step26 = t.scalar == SU32();
    if c_step26 {
        ce_text(c, "uint32_t");
        return;
    }
    var c_step27 = t.scalar == SUSize();
    if c_step27 {
        ce_text(c, "uintptr_t");
        return;
    }
    var c_step28 = t.scalar == SI64();
    if c_step28 {
        ce_text(c, "uint64_t");
        return;
    }
    var c_step29 = t.scalar == SU64();
    if c_step29 {
        ce_text(c, "uint64_t");
        return;
    }
    ce_fail(c, "C target does not pass aggregate values by value");
}

fn ce_abi_type(c: CEmitter*, t: FoundationType*): void {
    // Function declarations keep their signed C ABI types. Locals/temporaries
    // still store unsigned bits; calls and returns convert explicitly.
    if semantic_signed(t) {
        ce_text(c, "int");
        ce_number(c, convert(u64, semantic_width(t)));
        ce_text(c, "_t");
    } else {
        ce_type(c, t);
    }
}

fn ce_suffix(c: CEmitter*, t: FoundationType*): void {
    var c_step30 = t.pointers != 0;
    if c_step30 {
        ce_text(c, "ptr");
        return;
    }
    ce_number(c, convert(u64, semantic_width(t)));
}

fn ce_temp(c: CEmitter*, entity: void*): void {
    ce_name(c, entity, "t");
}

fn ce_value_kind(n: FoundationNode*): bool {
    if semantic_aggregate(&n.type) {
        return false;
    }
    var c_step31 = n.kind == KOperand();
    if c_step31 {
        return true;
    }
    var c_step32 = n.kind == KBinary();
    if c_step32 {
        return true;
    }
    var c_step33 = n.kind == KAddress();
    if c_step33 {
        return true;
    }
    var c_step34 = n.kind == KLoad();
    if c_step34 {
        return true;
    }
    var c_step35 = n.kind == KConvert();
    if c_step35 {
        return true;
    }
    var c_step36 = n.kind == KBits();
    if c_step36 {
        return true;
    }
    var c_step37 = n.kind == KCall();
    if c_step37 {
        var c_step38 = n.type.pointers != 0;
        if c_step38 {
            return true;
        }
        var c_step39 = n.type.scalar != SVoid();
        return c_step39;
    }
    var c_step40 = n.kind == KField();
    if c_step40 {
        return true;
    }
    var c_step41 = n.kind == KIndex();
    if c_step41 {
        return true;
    }
    var c_step42 = n.kind == KString();
    if c_step42 {
        return true;
    }
    var c_step43 = n.kind == KSizeOf();
    if c_step43 {
        return true;
    }
    var c_step44 = n.kind == KAlignOf();
    if c_step44 {
        return true;
    }
    var c_step45 = n.kind == KAllocate();
    if c_step45 {
        return true;
    }
    var c_step46 = n.kind == KReallocate();
    return c_step46;
}

fn ce_collect(c: CEmitter*, entity: void*, owner: void*): void {
    var c_step47 = entity == null;
    if c_step47 {
        return;
    }
    var c_step48 = ce_id(c, entity) < c.nodes.length;
    if c_step48 {
        return;
    }
    var n = sem_get(entity);
    var c_step49 = n == null;
    if c_step49 {
        return;
    }
    var c_step50 = n.kind == KFunction();
    if c_step50 {
        owner = entity;
    }
    sem_require(vector_push(void*, &c.nodes, entity));
    sem_require(vector_push(void*, &c.owners, owner));
    sem_require(vector_push(bool, &c.active, false));
    sem_require(vector_push(bool, &c.returning, true));
    // Labels point back to their block. Types contain recursive nominal edges.
    var c_step51 = n.kind == KLabel();
    if c_step51 {
        return;
    }
    var c_step52 = n.kind == KType();
    if c_step52 {
        return;
    }
    ce_collect(c, n.left, owner);
    ce_collect(c, n.right, owner);
    ce_collect(c, n.value, owner);
    ce_collect(c, n.target, owner);
    ce_collect(c, n.body, owner);
    ce_collect(c, n.otherwise, owner);
    var i: usize = 0;
    loop {
        var c_step53 = i == n.parameters.length;
        if c_step53 {
            break;
        }
        ce_collect(c, n.parameters.data[i], owner);
        i = i + 1;
    }
    i = 0;
    loop {
        var c_step54 = i == n.items.length;
        if c_step54 {
            break;
        }
        ce_collect(c, n.items.data[i], owner);
        i = i + 1;
    }
}

fn ce_comments(c: CEmitter*, n: FoundationNode*): void {
    if c.comments {}
    else {
        return;
    }
    var i: usize = 0;
    loop {
        var c_step55 = i == n.comments.length;
        if c_step55 {
            break;
        }
        var b = n.comments.data[i];
        var slash = b == 92;
        if slash {
            ce_text(c, "\\x5c");
        }
        else {
            sem_require(vector_push(u8, c.text, b));
        }
        // Prevent preprocessing trigraphs and backslash/newline splicing in C.
        var c_step56 = b == 63;
        if c_step56 {
            ce_text(c, " ");
        }
        i = i + 1;
    }
}

fn ce_quote(c: CEmitter*, text: vector(u8)*): void {
    // C89 only requires 509 characters after string literal concatenation.
    // Large constants use a byte initializer with short physical lines instead.
    var large = text.length > 96;
    if large {
        ce_text(c, "{\n    ");
        var at: usize = 0;
        loop {
            var done = at == text.length;
            if done {
                break;
            }
            ce_number(c, convert(u64, text.data[at]));
            ce_text(c, ", ");
            at = at + 1;
            var column = at % 16;
            var newline = column == 0;
            if newline {
                ce_text(c, "\n    ");
            }
        }
        ce_text(c, "0\n}");
        return;
    }
    ce_text(c, "\"");
    var i: usize = 0;
    loop {
        var c_step58 = i == text.length;
        if c_step58 {
            break;
        }
        // Fixed-width octal escapes avoid source encoding, trigraphs and hex
        // escape greediness. The C compiler adds the required terminating NUL.
        var b = convert(u32, text.data[i]);
        ce_text(c, "\\");
        var c_step59 = b / 64;
        ce_number(c, convert(u64, c_step59));
        var c_step60 = b / 8;
        var c_step61 = c_step60 % 8;
        ce_number(c, convert(u64, c_step61));
        var c_step62 = b % 8;
        ce_number(c, convert(u64, c_step62));
        i = i + 1;
    }
    ce_text(c, "\"");
}

fn ce_prepare_address(c: CEmitter*, entity: void*): void {
    var n = sem_get(entity);
    var c_step63 = n.kind == KLoad();
    if c_step63 {
        ce_prepare(c, n.value);
        return;
    }
    var place = n.kind == KField();
    var c_step64 = n.kind == KIndex();
    if c_step64 {
        place = true;
    }
    if place {
        if n.indirect {
            ce_prepare(c, n.left);
        }
        else {
            ce_prepare_address(c, n.left);
        }
        var c_step65 = n.kind == KIndex();
        if c_step65 {
            ce_prepare(c, n.right);
        }
    }
}

fn ce_signed_value(c: CEmitter*, entity: void*): void {
    var n = sem_get(entity);
    if semantic_signed(&n.type) {
        ce_text(c, "tc_s");
        ce_suffix(c, &n.type);
        ce_text(c, "(");
        ce_temp(c, entity);
        ce_text(c, ")");
    }
    else {
        ce_temp(c, entity);
    }
}

fn ce_address(c: CEmitter*, entity: void*): void {
    var n = sem_get(entity);
    var c_step66 = n.kind == KLoad();
    if c_step66 {
        ce_temp(c, n.value);
        return;
    }
    var place = n.kind == KField();
    var c_step67 = n.kind == KIndex();
    if c_step67 {
        place = true;
    }
    if place {
        ce_text(c, "tc_offset(");
        if n.indirect {
            ce_temp(c, n.left);
        }
        else {
            ce_address(c, n.left);
        }
        ce_text(c, ", ");
        var c_step68 = n.kind == KIndex();
        if c_step68 {
            ce_text(c, "(uintptr_t)(");
            ce_signed_value(c, n.right);
            ce_text(c, ") * ");
            ce_number(c, convert(u64, semantic_size(&n.type)));
        }
        else {
            ce_number(c, convert(u64, n.byte_offset));
        }
        ce_text(c, ")");
        return;
    }
    var binding = n.binding;
    var c_step69 = binding == null;
    if c_step69 {
        binding = entity;
    }
    ce_text(c, "(unsigned char *)&");
    ce_name(c, binding, "v");
}

fn ce_bit_value(c: CEmitter*, entity: void*, signed_extend: bool): void {
    var n = sem_get(entity);
    var c_step70 = n.type.pointers != 0;
    if c_step70 {
        ce_text(c, "(uintptr_t)");
    }
    if signed_extend {
        ce_signed_value(c, entity);
    }
    else {
        ce_temp(c, entity);
    }
}

fn ce_expression(c: CEmitter*, entity: void*): void {
    var n = sem_get(entity);
    var c_step71 = n.kind == KOperand();
    if c_step71 {
        if n.constant {
            var c_step72 = n.type.pointers != 0;
            if c_step72 {
                ce_text(c, "NULL");
            }
            else {
                ce_text(c, "UINT64_C(");
                var c_step73 = n.bits & semantic_mask(&n.type);
                ce_number(c, c_step73);
                ce_text(c, ")");
            }
        }
        else {
            ce_name(c, n.binding, "v");
        }
        return;
    }
    var c_step74 = n.kind == KString();
    if c_step74 {
        ce_name(c, entity, "tc_string_");
        return;
    }
    var c_step75 = n.kind == KAddress();
    if c_step75 {
        ce_address(c, n.value);
        return;
    }
    var load = n.kind == KLoad();
    var c_step76 = n.kind == KField();
    if c_step76 {
        load = true;
    }
    var c_step77 = n.kind == KIndex();
    if c_step77 {
        load = true;
    }
    if load {
        ce_text(c, "tc_load");
        ce_suffix(c, &n.type);
        ce_text(c, "(");
        ce_address(c, entity);
        ce_text(c, ")");
        return;
    }
    var c_step78 = n.kind == KCall();
    if c_step78 {
        ce_function_name(c, n.binding);
        ce_text(c, "(");
        var i: usize = 0;
        loop {
            var c_step79 = i == n.items.length;
            if c_step79 {
                break;
            }
            var c_step80 = i != 0;
            if c_step80 {
                ce_text(c, ", ");
            }
            ce_signed_value(c, n.items.data[i]);
            i = i + 1;
        }
        ce_text(c, ")");
        return;
    }
    var c_step81 = n.kind == KSizeOf();
    if c_step81 {
        ce_number(c, convert(u64, semantic_size(&n.element)));
        return;
    }
    var c_step82 = n.kind == KAlignOf();
    if c_step82 {
        ce_number(c, convert(u64, semantic_alignment(&n.element)));
        return;
    }
    var c_step83 = n.kind == KAllocate();
    if c_step83 {
        ce_text(c, "tc_alloc(");
        ce_temp(c, n.right);
        ce_text(c, ", ");
        ce_number(c, convert(u64, semantic_size(&n.element)));
        ce_text(c, ")");
        return;
    }
    var c_step84 = n.kind == KReallocate();
    if c_step84 {
        ce_text(c, "tc_realloc(");
        ce_temp(c, n.left);
        ce_text(c, ", ");
        ce_temp(c, n.right);
        ce_text(c, ", ");
        ce_number(c, convert(u64, semantic_size(&n.element)));
        ce_text(c, ")");
        return;
    }
    var c_step85 = n.kind == KBits();
    if c_step85 {
        ce_text(c, "(");
        ce_type(c, &n.type);
        ce_text(c, ")");
        var c_step86 = n.type.pointers != 0;
        if c_step86 {
            ce_text(c, "(uintptr_t)");
        }
        ce_bit_value(c, n.value, true);
        return;
    }
    var c_step87 = n.kind == KConvert();
    if c_step87 {
        var c_step88 = n.type.scalar == SBool();
        if c_step88 {
            ce_text(c, "(");
            ce_temp(c, n.value);
            ce_text(c, " != 0)");
            return;
        }
        var from = sem_get(n.value);
        ce_text(c, "(");
        ce_type(c, &n.type);
        ce_text(c, ")tc_convert(");
        ce_temp(c, n.value);
        ce_text(c, ", ");
        ce_number(c, convert(u64, semantic_width(&from.type)));
        ce_text(c, ", ");
        ce_number(c, convert(u64, semantic_signed(&from.type)));
        ce_text(c, ", ");
        ce_number(c, convert(u64, semantic_width(&n.type)));
        ce_text(c, ", ");
        ce_number(c, convert(u64, semantic_signed(&n.type)));
        ce_text(c, ")");
        return;
    }
    var c_step89 = n.kind == KBinary();
    if c_step89 {
        var from = sem_get(n.left);
        var c_step90 = from.type.pointers != 0;
        if c_step90 {
            var arithmetic = n.op == OAdd();
            var c_step91 = n.op == OSub();
            if c_step91 {
                arithmetic = true;
            }
            if arithmetic {
                var element: FoundationType;
                copy(&element, &from.type, sizeof(FoundationType));
                element.pointers = element.pointers - 1;
                ce_text(c, "tc_offset(");
                ce_temp(c, n.left);
                ce_text(c, ", ");
                var c_step92 = n.op == OSub();
                if c_step92 {
                    ce_text(c, "(uintptr_t)0 - ");
                }
                ce_text(c, "(uintptr_t)(");
                ce_signed_value(c, n.right);
                ce_text(c, ") * ");
                ce_number(c, convert(u64, semantic_size(&element)));
                ce_text(c, ")");
                return;
            }
            ce_text(c, "((uintptr_t)");
            ce_temp(c, n.left);
            ce_text(c, " ");
            ce_text(c, semantic_operator(n.op));
            ce_text(c, " (uintptr_t)");
            ce_temp(c, n.right);
            ce_text(c, ")");
            return;
        }
        var division = n.op == ODiv();
        var c_step93 = n.op == ORem();
        if c_step93 {
            division = true;
        }
        if division {
            ce_text(c, "tc_div(");
            ce_temp(c, n.left);
            ce_text(c, ", ");
            ce_temp(c, n.right);
            ce_text(c, ", ");
            ce_number(c, convert(u64, semantic_width(&from.type)));
            ce_text(c, ", ");
            ce_number(c, convert(u64, semantic_signed(&from.type)));
            ce_text(c, ", ");
            var c_step94 = n.op == ORem();
            ce_number(c, convert(u64, c_step94));
            ce_text(c, ")");
            return;
        }
        var c_step95 = n.op >= OEq();
        if c_step95 {
            ce_text(c, "(");
            ce_signed_value(c, n.left);
            ce_text(c, " ");
            ce_text(c, semantic_operator(n.op));
            ce_text(c, " ");
            ce_signed_value(c, n.right);
            ce_text(c, ")");
            return;
        }
        // Promote u8/bool before arithmetic to avoid signed-int multiplication.
        ce_text(c, "((uint64_t)");
        ce_temp(c, n.left);
        ce_text(c, " ");
        ce_text(c, semantic_operator(n.op));
        ce_text(c, " (uint64_t)");
        ce_temp(c, n.right);
        ce_text(c, ")");
        return;
    }
    ce_fail(c, "Unsupported Foundation value in C emitter");
    ce_text(c, "0");
}

fn ce_prepare(c: CEmitter*, entity: void*): void {
    var c_step96 = entity == null;
    if c_step96 {
        return;
    }
    var n = sem_get(entity);
    var c_step97 = n.kind == KAddress();
    if c_step97 {
        ce_prepare_address(c, n.value);
    }
    else {
        var place = n.kind == KField();
        var c_step98 = n.kind == KIndex();
        if c_step98 {
            place = true;
        }
        var c_step99 = n.kind == KLoad();
        if c_step99 {
            place = true;
        }
        if place {
            ce_prepare_address(c, entity);
        }
        else {
            ce_prepare(c, n.left);
            ce_prepare(c, n.right);
            ce_prepare(c, n.value);
            var i: usize = 0;
            loop {
                var c_step100 = i == n.items.length;
                if c_step100 {
                    break;
                }
                ce_prepare(c, n.items.data[i]);
                i = i + 1;
            }
        }
    }
    ce_indent(c);
    if ce_value_kind(n) {
        ce_temp(c, entity);
        ce_text(c, " = ");
        ce_text(c, "(");
        ce_type(c, &n.type);
        ce_text(c, ")(");
    }
    ce_expression(c, entity);
    if ce_value_kind(n) {
        ce_text(c, ")");
    }
    ce_text(c, ";\n");
}

fn ce_store(c: CEmitter*, target: void*, value: void*): void {
    var n = sem_get(target);
    ce_indent(c);
    ce_text(c, "tc_store");
    ce_suffix(c, &n.type);
    ce_text(c, "(");
    ce_address(c, target);
    ce_text(c, ", ");
    ce_temp(c, value);
    ce_text(c, ");\n");
}

fn ce_statement(c: CEmitter*, entity: void*): void {
    var c_step101 = entity == null;
    if c_step101 {
        return;
    }
    var n = sem_get(entity);
    var c_step102 = n.kind == KFunction();
    if c_step102 {
        return;
    }
    var c_step103 = n.kind == KType();
    if c_step103 {
        ce_comments(c, n);
        return;
    }
    ce_comments(c, n);
    var list = n.kind == KProgram();
    var c_step104 = n.kind == KBlock();
    if c_step104 {
        list = true;
    }
    if list {
        var i: usize = 0;
        loop {
            var c_step105 = i == n.items.length;
            if c_step105 {
                break;
            }
            var child = n.items.data[i];
            var index = ce_id(c, child);
            if c.active.data[index] {
                ce_statement(c, child);
            } else {
                ce_notes(c, child);
            }
            i = i + 1;
        }
        return;
    }
    var c_step106 = n.kind == KDeclare();
    if c_step106 {
        var c_step107 = n.value != null;
        if c_step107 {
            ce_prepare(c, n.value);
            ce_store(c, entity, n.value);
        }
        else {
            ce_indent(c);
            ce_text(c, "memset(&");
            ce_name(c, entity, "v");
            ce_text(c, ", 0, ");
            ce_number(c, convert(u64, semantic_size(&n.type)));
            ce_text(c, ");\n");
        }
        return;
    }
    var c_step108 = n.kind == KAssign();
    if c_step108 {
        ce_prepare_address(c, n.target);
        ce_prepare(c, n.value);
        ce_store(c, n.target, n.value);
        return;
    }
    var c_step109 = n.kind == KIf();
    if c_step109 {
        var condition = sem_get(n.value);
        if condition.constant {
            var yes = condition.bits != 0;
            if yes {
                ce_statement(c, n.body);
                ce_notes(c, n.otherwise);
            } else {
                ce_notes(c, n.body);
                ce_statement(c, n.otherwise);
            }
            return;
        }
        ce_prepare(c, n.value);
        ce_indent(c);
        ce_text(c, "if (");
        ce_temp(c, n.value);
        ce_text(c, ") {\n");
        c.depth = c.depth + 1;
        ce_statement(c, n.body);
        c.depth = c.depth - 1;
        ce_indent(c);
        ce_text(c, "}");
        var c_step110 = n.otherwise != null;
        if c_step110 {
            ce_text(c, " else {\n");
            c.depth = c.depth + 1;
            ce_statement(c, n.otherwise);
            c.depth = c.depth - 1;
            ce_indent(c);
            ce_text(c, "}");
        }
        ce_text(c, "\n");
        return;
    }
    var c_step111 = n.kind == KLoop();
    if c_step111 {
        ce_indent(c);
        ce_text(c, "for (;;) {\n");
        c.depth = c.depth + 1;
        ce_statement(c, n.body);
        c.depth = c.depth - 1;
        ce_indent(c);
        ce_text(c, "}\n");
        return;
    }
    var c_step112 = n.kind == KBreak();
    if c_step112 {
        ce_indent(c);
        ce_text(c, "break;\n");
        return;
    }
    var c_step113 = n.kind == KContinue();
    if c_step113 {
        ce_indent(c);
        ce_text(c, "continue;\n");
        return;
    }
    var c_step114 = n.kind == KReturn();
    if c_step114 {
        ce_prepare(c, n.value);
        ce_indent(c);
        ce_text(c, "return");
        var c_step115 = n.value != null;
        if c_step115 {
            ce_text(c, " ");
            ce_signed_value(c, n.value);
        }
        ce_text(c, ";\n");
        return;
    }
    var c_step116 = n.kind == KLabel();
    if c_step116 {
        var unused = ce_label_used(c, entity) == false;
        if unused {
            return;
        }
        ce_indent(c);
        ce_name(c, entity, "label_");
        ce_text(c, ":;\n");
        return;
    }
    var c_step117 = n.kind == KJump();
    if c_step117 {
        ce_indent(c);
        ce_text(c, "goto ");
        ce_name(c, n.binding, "label_");
        ce_text(c, ";\n");
        return;
    }
    var c_step118 = n.kind == KPrint();
    if c_step118 {
        ce_prepare(c, n.value);
        var value = sem_get(n.value);
        ce_indent(c);
        var c_step119 = value.type.pointers != 0;
        if c_step119 {
            ce_text(c, "tc_print_pointer((uintptr_t)");
            ce_temp(c, n.value);
            ce_text(c, ");\n");
            return;
        }
        var c_step120 = value.type.scalar == SBool();
        if c_step120 {
            ce_text(c, "puts(");
            ce_temp(c, n.value);
            ce_text(c, " ? \"true\" : \"false\");\n");
            return;
        }
        if semantic_signed(&value.type) {
            ce_text(c, "tc_print_signed((int64_t)");
            ce_signed_value(c, n.value);
        }
        else {
            ce_text(c, "tc_print_unsigned((uint64_t)");
            ce_temp(c, n.value);
        }
        ce_text(c, ");\n");
        return;
    }
    var c_step121 = n.kind == KFree();
    if c_step121 {
        ce_prepare(c, n.left);
        ce_indent(c);
        ce_text(c, "free(");
        ce_temp(c, n.left);
        ce_text(c, ");\n");
        return;
    }
    var memory = n.kind == KCopy();
    var c_step122 = n.kind == KFill();
    if c_step122 {
        memory = true;
    }
    if memory {
        ce_prepare(c, n.left);
        ce_prepare(c, n.right);
        ce_prepare(c, n.value);
        ce_indent(c);
        ce_text(c, "if (");
        ce_temp(c, n.value);
        ce_text(c, ") ");
        var c_step123 = n.kind == KCopy();
        if c_step123 {
            ce_text(c, "memmove(");
        }
        else {
            ce_text(c, "memset(");
        }
        ce_temp(c, n.left);
        ce_text(c, ", ");
        ce_temp(c, n.right);
        ce_text(c, ", ");
        ce_temp(c, n.value);
        ce_text(c, ");\n");
        return;
    }
    var c_step124 = n.kind == KTrap();
    if c_step124 {
        ce_prepare(c, n.left);
        ce_prepare(c, n.right);
        ce_indent(c);
        ce_text(c, "tc_trap((const char *)");
        ce_temp(c, n.left);
        ce_text(c, ");\n");
        return;
    }
    var c_step125 = n.kind == KCall();
    if c_step125 {
        ce_prepare(c, entity);
        return;
    }
    ce_fail(c, "Unsupported Foundation statement in C emitter");
}

fn ce_declaration(c: CEmitter*, entity: void*, variable: bool): void {
    var n = sem_get(entity);
    ce_indent(c);
    if semantic_aggregate(&n.type) {
        ce_text(c, "union { uint64_t alignment; unsigned char bytes[");
        var size = semantic_size(&n.type);
        var c_step126 = size == 0;
        if c_step126 {
            size = 1;
        }
        ce_number(c, convert(u64, size));
        ce_text(c, "]; } ");
    }
    else {
        ce_type(c, &n.type);
        ce_text(c, " ");
    }
    if variable {
        ce_name(c, entity, "v");
    }
    else {
        ce_temp(c, entity);
    }
    ce_text(c, ";\n");
}

fn ce_signature(c: CEmitter*, entity: void*): void {
    var n = sem_get(entity);
    var index = ce_id(c, entity);
    var terminal = c.returning.data[index] == false;
    if terminal {
        ce_text(c, "TC_NORETURN ");
    }
    ce_abi_type(c, &n.type);
    ce_text(c, " ");
    ce_function_name(c, entity);
    ce_text(c, "(");
    var c_step127 = n.parameters.length == 0;
    if c_step127 {
        ce_text(c, "void");
    }
    var i: usize = 0;
    loop {
        var c_step128 = i == n.parameters.length;
        if c_step128 {
            break;
        }
        var c_step129 = i != 0;
        if c_step129 {
            ce_text(c, ", ");
        }
        var parameter = sem_get(n.parameters.data[i]);
        ce_abi_type(c, &parameter.type);
        ce_text(c, " ");
        ce_name(c, n.parameters.data[i], "v");
        i = i + 1;
    }
    ce_text(c, ")");
}

fn ce_body(c: CEmitter*, entity: void*, program: bool): void {
    c.owner = entity;
    c.depth = 1;
    var i: usize = 0;
    loop {
        var c_step130 = i == c.nodes.length;
        if c_step130 {
            break;
        }
        var c_step131 = c.owners.data[i] == entity;
        if c_step131 {
            var item = c.nodes.data[i];
            var n = sem_get(item);
            var local = n.kind == KDeclare();
            if n.global {
                local = false;
            }
            if local {
                ce_declaration(c, item, true);
            }
            if ce_value_kind(n) {
                ce_declaration(c, item, false);
            }
        }
        i = i + 1;
    }
    i = 0;
    loop {
        var c_step132 = i == c.nodes.length;
        if c_step132 {
            break;
        }
        var c_step133 = c.owners.data[i] == entity;
        if c_step133 {
            var item = c.nodes.data[i];
            var n = sem_get(item);
            var variable = n.kind == KDeclare();
            var c_step134 = n.kind == KParameter();
            if c_step134 {
                variable = true;
            }
            var temp = ce_value_kind(n);
            var string = n.kind == KString();
            if string {
                ce_indent(c);
                ce_text(c, "(void)");
                ce_name(c, item, "tc_string_");
                ce_text(c, ";\n");
            }
            if variable {
                ce_indent(c);
                ce_text(c, "(void)&");
                ce_name(c, item, "v");
                ce_text(c, ";\n");
            }
            if temp {
                ce_indent(c);
                ce_text(c, "(void)&");
                ce_temp(c, item);
                ce_text(c, ";\n");
            }
        }
        i = i + 1;
    }
    if program {
        ce_text(c, "    tc_environment();\n");
        ce_text(c, "    { const uint32_t endian = 1; if (*(const unsigned char *)&endian != 1) tc_trap(\"C target requires little endian storage\"); }\n");
        ce_statement(c, entity);
        if ce_falls(c, entity) {
            ce_text(c, "    return 0;\n");
        } else {
            ce_text(c, "    TC_MAIN_END\n");
        }
    }
    else {
        var n = sem_get(entity);
        ce_statement(c, n.body);
    }
    ce_text(c, "}\n\n");
    c.depth = 0;
}

export fn c_emit(text: vector(u8)*, error: vector(u8)*, root: void*, pointer_bytes: u32, comments: bool): void {
    var c: CEmitter;
    fill(&c, 0, sizeof(CEmitter));
    c.text = text;
    c.error = error;
    c.pointer_bytes = pointer_bytes;
    c.comments = comments;
    ce_collect(&c, root, root);
    ce_reachable(&c, root);
    ce_text(&c, "/* Tower generated C. Compile: cc -std=c89 -pedantic -Wall -Wextra -O2 program.c */\n");
    ce_text(&c, "#define TC_POINTER_BYTES ");
    ce_number(&c, convert(u64, pointer_bytes));
    ce_text(&c, "\n");
    ce_runtime(&c);
    ce_text(&c, "typedef char tc_pointer_width[(sizeof(void *) == ");
    ce_number(&c, convert(u64, pointer_bytes));
    ce_text(&c, ") ? 1 : -1];\n\n");
    var i: usize = 0;
    loop {
        var c_step137 = i == c.nodes.length;
        if c_step137 {
            break;
        }
        var entity = c.nodes.data[i];
        var n = sem_get(entity);
        var c_step138 = n.kind == KString();
        if c_step138 {
            ce_text(&c, "static unsigned char ");
            ce_name(&c, entity, "tc_string_");
            ce_text(&c, "[] = ");
            ce_quote(&c, &n.name);
            ce_text(&c, ";\n");
        }
        var c_step139 = n.kind == KDeclare();
        if c_step139 {
            if n.global {
                ce_declaration(&c, entity, true);
            }
        }
        var c_step140 = n.kind == KFunction();
        if c_step140 {
            var platform = n.external;
            if platform {
                platform = sem_equal(sem_name(n), "platform_write");
            }
            if platform {}
            else {
                ce_signature(&c, entity);
                ce_text(&c, ";\n");
            }
            if n.external {
                ce_comments(&c, n);
            }
        }
        i = i + 1;
    }
    ce_text(&c, "\n");
    i = 0;
    loop {
        var c_step141 = i == c.nodes.length;
        if c_step141 {
            break;
        }
        var entity = c.nodes.data[i];
        var n = sem_get(entity);
        var c_step142 = n.kind == KFunction();
        if c_step142 {
            if n.external {}
            else {
                ce_comments(&c, n);
                ce_signature(&c, entity);
                ce_text(&c, "\n{\n");
                ce_body(&c, entity, false);
            }
        }
        i = i + 1;
    }
    ce_text(&c, "int main(void)\n{\n");
    ce_body(&c, root, true);
    ce_text(&c, "#ifdef __cplusplus\n}\n#endif\n");
    vector_dispose(void*, &c.nodes);
    vector_dispose(void*, &c.owners);
    vector_dispose(bool, &c.active);
    vector_dispose(bool, &c.returning);
    var c_step143 = error.length != 0;
    if c_step143 {
        text.length = 0;
    }
}
