// Canonical text and source mapping over the existing shared components.
// Composed after their definitions; these buffers are output, not another IR.
extern fn compiler_node_get(node: void*, kind: u32): void*;

fn format_syntax(f: FormatEngine*, entity: void*): SyntaxNode* {
    if f.syntax_kind is null {
        return bits(SyntaxNode*, compiler_node_get(entity, CompilerSyntax));
    }
    var component = entity_component_get(entity, f.syntax_kind);
    return bits(SyntaxNode*, entity_component_data(component));
}

fn format_foundation(f: FormatEngine*, entity: void*): FoundationNode* {
    if f.foundation_kind == null {
        // Formatting is a read-only query. Do not register a type or consult
        // the legacy host world when the caller leaves this kind implicit.
        return bits(FoundationNode*, compiler_node_get(entity, CompilerFoundation));
    }
    var component = entity_component_get(entity, f.foundation_kind);
    return bits(FoundationNode*, entity_component_data(component));
}

export fn format_match(f: FormatEngine*, entity: void*): ParserMatchData* {
    if f.match_kind is null {
        return bits(ParserMatchData*, compiler_node_get(entity, CompilerParserMatch));
    }
    var component = entity_component_get(entity, f.match_kind);
    return bits(ParserMatchData*, entity_component_data(component));
}

export fn format_write(f: FormatEngine*, bytes: u8*, count: usize): void {
    format_storage_append(f.result, bytes, count);
}

export fn format_text(f: FormatEngine*, text: u8*): void {
    format_write(f, text, syntax_text_length(text));
}

export fn format_bytes(f: FormatEngine*, text: vector(u8)*): void {
    format_write(f, text.data, text.length);
}

export fn format_char(f: FormatEngine*, byte: u8): void {
    format_write(f, &byte, 1);
}

export fn format_repeat(f: FormatEngine*, byte: u8, count: usize): void {
    if count == 0 {
        return;
    }
    var text = &f.result.text;
    var needed = text.length + count;
    if needed < text.length {
        format_storage_fail(f.result, WorkBudgetError.Invalid);
        return;
    }
    if format_storage_reserve(f.result, needed, false) {
        fill(&text.data[text.length], byte, count);
        text.length = needed;
    } else {
        f.result.failed = true;
    }
}

fn format_indent(f: FormatEngine*): void {
    var count = f.result.depth *4;
    format_repeat(f, 32, count);
}

fn format_newline(f: FormatEngine*, blank: bool): void {
    var text = &f.result.text;
    loop {
        if text.length == 0 {
            return;
        }
        var at = text.length -1;
        var c = text.data[at];
        var space = c == 32;
        var tab = c == 9;
        if !format_or(space, tab) {
            break;
        }
        text.length = at;
    }
    var wanted: usize = 1;
    if blank {
        wanted = 2;
    }
    var count: usize = 0;
    var at = text.length;
    loop {
        if at == 0 {
            break;
        }
        at--;
        if text.data[at] != 10 {
            break;
        }
        count++;
    }
    loop {
        if count >= wanted {
            break;
        }
        format_char(f, 10);
        count++;
    }
}

fn format_span(f: FormatEngine*, begin: usize, source: usize): void {
    var spans = &f.result.spans;
    var needed = spans.length + 1;
    if format_storage_reserve(f.result, needed, true) {
        var span = &spans.data[spans.length];
        span.begin = begin;
        span.end = f.result.text.length;
        span.source = source;
        spans.length = needed;
    } else {
        f.result.failed = true;
    }
}

fn format_equal(a: u8*, length: usize, b: u8*): bool {
    var i: usize = 0;
    loop {
        if i == length {
            var result = b[i] == 0;
            return result;
        }
        if b[i] == 0 {
            return false;
        }
        if a[i] != b[i] {
            return false;
        }
        i++;
    }
}

fn format_name_is(a: vector(u8)*, b: u8*): bool {
    return format_equal(a.data, a.length, b);
}

fn format_alpha(c: u8): bool {
    var lower = c >= 97;
    var upper = c <= 122;
    var letter = format_and(lower, upper);
    lower = c >= 65;
    upper = c <= 90;
    var capital = format_and(lower, upper);
    var underscore = c == 95;
    letter = format_or(letter, capital);
    letter = format_or(letter, underscore);
    return letter;
}

fn format_escape(f: FormatEngine*, bytes: u8*, length: usize, quote: u8): void {
    format_char(f, quote);
    var start: usize = 0;
    var i: usize = 0;
    loop {
        if i == length {
            break;
        }
        var c = bytes[i];
        var newline = c == 10;
        var carriage = c == 13;
        var tab = c == 9;
        var slash = c == 92;
        var delimiter = c == quote;
        var escape = format_or(newline, carriage);
        escape = format_or(escape, tab);
        escape = format_or(escape, slash);
        escape = format_or(escape, delimiter);
        if escape {
            var count = i -start;
            format_write(f, &bytes[start], count);
            format_char(f, 92);
            if newline {
                format_char(f, 110);
            }
            else {
                if carriage {
                    format_char(f, 114);
                }
                else {
                    if tab {
                        format_char(f, 116);
                    }
                    else {
                        format_char(f, c);
                    }
                }
            }
            start = i + 1;
        }
        i++;
    }
    var count = length -start;
    // Empty vector payloads may have a null data pointer.
    if count != 0 {
        format_write(f, &bytes[start], count);
    }
    format_char(f, quote);
}

fn format_reserved(name: vector(u8)*): bool {
    if name.length == 2 {
        if format_name_is(name, "fn") {
            return true;
        }
        if format_name_is(name, "if") {
            return true;
        }
        if format_name_is(name, "as") {
            return true;
        }
        return false;
    }
    if name.length == 3 {
        if format_name_is(name, "var") {
            return true;
        }
        return false;
    }
    if name.length == 4 {
        if format_name_is(name, "else") {
            return true;
        }
        if format_name_is(name, "loop") {
            return true;
        }
        if format_name_is(name, "true") {
            return true;
        }
        if format_name_is(name, "null") {
            return true;
        }
        if format_name_is(name, "skip") {
            return true;
        }
        if format_name_is(name, "when") {
            return true;
        }
        return false;
    }
    if name.length == 5 {
        if format_name_is(name, "break") {
            return true;
        }
        if format_name_is(name, "false") {
            return true;
        }
        if format_name_is(name, "parse") {
            return true;
        }
        if format_name_is(name, "token") {
            return true;
        }
        return false;
    }
    if name.length == 6 {
        if format_name_is(name, "return") {
            return true;
        }
        if format_name_is(name, "struct") {
            return true;
        }
        if format_name_is(name, "extern") {
            return true;
        }
        if format_name_is(name, "export") {
            return true;
        }
        return false;
    }
    if name.length == 7 {
        if format_name_is(name, "replace") {
            return true;
        }
        return false;
    }
    if name.length == 8 {
        if format_name_is(name, "continue") {
            return true;
        }
        if format_name_is(name, "expected") {
            return true;
        }
        return false;
    }
    return false;
}

fn format_identifier(f: FormatEngine*, name: vector(u8)*): void {
    var plain = name.length != 0;
    plain &&= format_alpha(name.data[0]);
    var i: usize = 0;
    loop {
        if i == name.length {
            break;
        }
        var c = name.data[i];
        var alpha = format_alpha(c);
        var lower = c >= 48;
        var upper = c <= 57;
        var digit = format_and(lower, upper);
        var valid = format_or(alpha, digit);
        plain = format_and(plain, valid);
        i++;
    }
    // Canonical reserved spellings, independent of editable lexer keywords.
    if plain {
        if format_reserved(name) {
            plain = false;
        }
    }
    if plain {
        format_bytes(f, name);
    }
    else {
        format_escape(f, name.data, name.length, 96);
    }
}

fn format_quote(f: FormatEngine*, value: vector(u8)*): void {
    format_escape(f, value.data, value.length, 39);
}

export fn format_unsigned(f: FormatEngine*, value: u64): void {
    var digits: u8[20];
    var at: usize = 20;
    loop {
        var digit = value % 10;
        digit = digit + 48;
        at--;
        digits[at] = convert(u8, digit);
        value = value / 10;
        if value == 0 {
            break;
        }
    }
    var count: usize = 20;
    count = count - at;
    format_write(f, &digits[at], count);
}

fn format_column(f: FormatEngine*): usize {
    var count: usize = 0;
    var at = f.result.text.length;
    loop {
        if at == 0 {
            return count;
        }
        at--;
        if f.result.text.data[at] == 10 {
            return count;
        }
        count++;
    }
}

export fn format_dispose(result: FormatResult*): void {
    if result.checked {
        work_buffer_dispose(&result.text_storage);
        work_buffer_dispose(&result.span_storage);
        result.text = default;
        result.spans = default;
    } else {
        vector_dispose(&result.text);
        vector_dispose(&result.spans);
    }
}

export fn format_entity(result: FormatResult*, entity: void*, syntax: void*, foundation: void*, `match`: void*): void {
    var f: FormatEngine = default;
    f.source_names = false;
    f.result = result;
    f.syntax_kind = syntax;
    f.foundation_kind = foundation;
    f.match_kind = `match`;
    format_node(&f, entity);
}

fn format_or(a: bool, b: bool): bool {
    if a {
        return true;
    }
    return b;
}

fn format_and(a: bool, b: bool): bool {
    if a {
        return b;
    }
    return false;
}
