import library.testing;

fn selected_array(items: i32[5]*, calls: usize*): i32[5]* {
    *calls += 1;
    return items;
}

fn first_even(items: i32[5]*, visits: usize*): i32 {
    foreach (var value in items) {
        defer { *visits += 1; }
        if value % 2 == 0 { return value; }
    }
    return -1;
}

test() {
    var items: i32[5] = {1, 2, 3, 4, 5};
    var calls: usize = 0;
    foreach (var &item in selected_array(&items, &calls)) {
        if *item == 2 { continue; }
        if *item == 4 { break; }
        *item += 10;
    }
    var digits: i32 = 0;
    foreach (var value in selected_array(&items, &calls)) {
        digits = digits * 100 + value;
        value = 0;
    }
    assert(calls == 2, "Each foreach evaluates its source once");
    assert(digits == 1102130405, "Borrowed writes respect continue and break");
    assert(items[0] == 11, "Assigning the copied item leaves the array unchanged");
    var visits: usize = 0;
    assert(first_even(&items, &visits) == 2, "Return the first even element");
    assert(visits == 2, "Run deferred cleanup for both visited elements");
}
