import '../library/vector';
import tower;

// Shared formatter result ABI. Editor previews use the same formatting engine.
struct FormatSpan {
    begin: usize;
    end: usize;
    source: usize;
}

struct FormatResult {
    text: vector(u8);
    spans: vector(FormatSpan);
    depth: usize;
    failed: bool;
}

struct FormatEngine {
    result: FormatResult*;
    syntax_kind: void*;
    foundation_kind: void*;
    match_kind: void*;
    source_names: bool;
}
