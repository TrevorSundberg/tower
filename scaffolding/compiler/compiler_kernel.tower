import tower;
import .library.work_pool;
import .library.work_budget_types;

enum CompilerKernelKind: u32 {
    Layout, Evaluate, Declaration, Lower, LRClosure, Body, LRState, Flow, LRAction, LRPropagation, LRFirst, PrepareEvaluation, DeclarationType, GenericBody, LRRuntime, CompileUnit, LRLink, KnownBinding, Iteration, BodyDiscovery, PrepareFunction
}

struct CompilerKernel {
    kind: CompilerKernelKind;
    payload: void*;
}

// Callers reserve query tickets/leases and freeze every job context before
// dispatch. T retains the concrete component type and embeds its kernel.
// This helper only refills transport slots and joins; graph/publication changes
// happen outside it. Finite isolated kernels need no semaphore trip when alone.
fn compiler_kernel_dispatch(T: type, pool: WorkPool*, jobs: T**, count: usize): bool {
    return compiler_kernel_dispatch_result(pool, jobs, count) == WorkBudgetError.None;
}

fn compiler_kernel_dispatch_result(T: type, pool: WorkPool*, jobs: T**, count: usize): WorkBudgetError {
    if count == 0 { return WorkBudgetError.None; }
    if pool == null { return WorkBudgetError.Invalid; }
    // The existing capacity is a total lane ceiling, including this caller.
    var extra = pool.count == 0 ? convert(usize, 0) : pool.count - 1;
    return compiler_kernel_dispatch_admitted_result(pool, jobs, count, extra);
}

// The caller already owns its executing lane and reserves extra_lanes before
// dispatch. Retained pool slots are capacity, not entitlement. This helper
// borrows the grant; its owner publishes stages/releases leases before returning
// the reservation. Zero extras keep finite work inline without waiting for a
// permit. Workers and caller use the same isolated pre-leased job components.
fn compiler_kernel_dispatch_admitted(T: type, pool: WorkPool*, jobs: T**, count: usize,
    extra_lanes: usize): bool {
    return compiler_kernel_dispatch_admitted_result(pool, jobs, count, extra_lanes) == WorkBudgetError.None;
}

// The result has work_pool_batch_result's ownership contract. In particular,
// Busy on entry does not join someone else's work or permit releasing its views.
fn compiler_kernel_dispatch_admitted_result(T: type, pool: WorkPool*, jobs: T**, count: usize,
    extra_lanes: usize): WorkBudgetError {
    if count == 0 { return WorkBudgetError.None; }
    if jobs == null || jobs[0] == null { return WorkBudgetError.Invalid; }
    // A concrete T has one fixed kernel member offset. Share the serial loop
    // as well as parallel transport across component types; the projection
    // adds neither a second pointer array nor an aliasing guarantee.
    var offset = bits(usize, &jobs[0].kernel) - bits(usize, jobs[0]);
    return work_pool_batch_result(pool, bits(void**, jobs), count, offset, extra_lanes);
}

fn compiler_kernel_join(pool: WorkPool*): bool {
    // A failed submission still owns all previously admitted inputs.
    var ok = true;
    while pool.running != 0 {
        if work_pool_receive(pool, true) == null { ok = false; }
    }
    return ok;
}
