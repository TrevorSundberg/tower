import tower;

enum CompilerKernelKind: u32 {
    Layout, Evaluate, Declaration, Lower, LRClosure, Body, LRState, Flow, LRAction, LRPropagation, LRFirst, PrepareEvaluation, DeclarationType, GenericBody, LRRuntime, CompileUnit, LRLink, KnownBinding
}

struct CompilerKernel {
    kind: CompilerKernelKind;
    payload: void*;
}
