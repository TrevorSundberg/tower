import tower;
import .library.work_pool;

enum CompilerKernelKind: u32 {
    Layout, Evaluate, Declaration, Lower, LRClosure, Body, LRState, Flow, LRAction, LRPropagation, LRFirst, PrepareEvaluation, DeclarationType, GenericBody, LRRuntime, CompileUnit, LRLink, KnownBinding, Iteration, BodyDiscovery, BindingProof
}

struct CompilerKernel {
    kind: CompilerKernelKind;
    payload: void*;
}

// Callers reserve query tickets/leases and freeze every job context before
// dispatch. T retains the concrete component type and embeds its kernel.
// This helper only refills transport slots and joins; graph/publication changes
// happen outside it. Finite isolated kernels need no semaphore trip when alone.
fn compiler_kernel_dispatch(T: type, pool: WorkPool*, jobs: T**, count: usize): bool {
    if count == 0 { return true; }
    if pool.running != 0 || pool.count == 0 { return false; }
    defer compiler_kernel_join(pool);
    for(var next: usize = 0; next < count; next++) {
        if !compiler_kernel_send(pool, &jobs[next].kernel, count == 1) { return false; }
    }
    return compiler_kernel_join(pool);
}

// Only typed component-to-kernel projection is generic. Keep the transport and
// failure draining shared instead of compiling them once for every job type.
fn compiler_kernel_send(pool: WorkPool*, kernel: CompilerKernel*, inline: bool): bool {
    if inline { pool.execute(bits(void*, kernel)); return true; }
    if pool.running == pool.count && work_pool_receive(pool, true) == null { return false; }
    return work_pool_submit(pool, bits(void*, kernel));
}

fn compiler_kernel_join(pool: WorkPool*): bool {
    // A failed submission still owns all previously admitted inputs.
    var ok = true;
    while pool.running != 0 {
        if work_pool_receive(pool, true) == null { ok = false; }
    }
    return ok;
}
