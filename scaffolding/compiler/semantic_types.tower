// Semantic compiler over shared Foundation components.
// Temporary indexes and scratch allocations are scoped to one compilation.
var ArrayTypeConstructorArity: usize = 2;
var IntegerTypeConstructorArity: usize = 2;
var FloatTypeConstructorArity: usize = 1;

// Type bindings have no runtime storage. They reuse declaration dependencies,
// nominal identities and the existing type-constructor application mechanism.
fn sem_type_binding(c: SemanticContext*, n: void*): bool {
    var value = sem_get(n);
    if value != null { return value.kind == KType && value.global; }
    if c.current != c.program.root { return false; }
    return sem_is(n, "CoreDeclare") && sem_member(n, "type") != null
        && sem_equal(sem_identifier(c, sem_member(n, "type")), "type");
}

fn sem_type_binding_header(c: SemanticContext*, n: void*): void {
    var name = sem_identifier(c, sem_member(n, "name"));
    if !sem_ok(c) { return; }
    var value = sem_node(c, n, KType);
    value.global = true;
    value.type.scalar = InvalidTypeScalar;
    value.type.pointer_bytes = c.program.pointer_bytes;
    if !sem_set_name(c, value, sem_output_name(c, n, name)) { return; }
    if sem_equal(name, "type") || !sem_define(c, c.types, n, name) {
        sem_fail(c, n, sem_cat(c, "Duplicate type binding '", sem_cat(c, name, "'")));
    }
    if !sem_push_checked(c, &c.program.types, n) { return; }
}

fn sem_type_representation_name(name: u8*): bool {
    return sem_equal(name, "integer_type") || sem_equal(name, "float_type")
        || sem_equal(name, "boolean_type") || sem_equal(name, "empty_type") || sem_equal(name, "address_type")
        || sem_equal(name, "pointer_type") || sem_equal(name, "array_type") || sem_equal(name, "type_type");
}

fn sem_type_primitive(c: SemanticContext*, n: void*, name: u8*): FoundationType* {
    var integer = sem_equal(name, "integer_type");
    var floating = sem_equal(name, "float_type");
    var boolean = sem_equal(name, "boolean_type");
    var empty = sem_equal(name, "empty_type");
    var address = sem_equal(name, "address_type");
    var metatype = sem_equal(name, "type_type");
    if !integer && !floating && !boolean && !empty && !address && !metatype { return null; }
    var arguments = sem_collect(c, sem_member(n, "args"), sem_is(n, "CoreCall") ? "CoreCallArgument" : "CoreTypeArgument");
    if !sem_ok(c) { return default; }
    var arity: usize = integer ? IntegerTypeConstructorArity : floating ? FloatTypeConstructorArity : 0;
    if arguments.length != arity {
        sem_fail(c, n, "Wrong argument count for primitive type constructor");
        return sem_type_new(c, SI32, 0, null);
    }
    var scalar = metatype ? SType : boolean ? SBool : empty ? SVoid : SUSize;
    if integer || floating {
        var width = sem_constant_value(c, arguments.data[0], null);
        if !sem_ok(c) { return sem_type_new(c, SI32, 0, null); }
        if integer {
            var sign = sem_constant_value(c, arguments.data[1], null);
            if !sem_ok(c) { return sem_type_new(c, SI32, 0, null); }
            if sem_get(sign).bits > 1 { sem_fail(c, n, "Integer signedness must be 0 (unsigned) or 1 (signed)"); }
            scalar = type_integer_scalar(sem_get(width).bits, sem_get(sign).bits != 0);
        } else { scalar = type_float_scalar(sem_get(width).bits); }
        if scalar == InvalidTypeScalar { sem_fail(c, n, "Unsupported primitive numeric width"); }
    }
    return sem_type_new(c, scalar, 0, null);
}

// Publish an index entry only after its entity and Foundation payload exist.
// A failed payload admission retires the new containment; cached world kinds
// may remain registered for another independent request.
fn sem_type_resource(c: SemanticContext*, subject: void*, error: WorkBudgetError): void {
    var operation = sem_get(subject);
    sem_resource_record(c.program, error, operation == null ? sem_offset(c, subject) : operation.start);
}

fn sem_type_node(c: SemanticContext*, subject: void*, kind: u32): void* {
    if !sem_ok(c) { return null; }
    var error: WorkBudgetError;
    var node = sem_create_result(c.program.root, &error);
    if node != null && sem_attach_result(node, kind, &error) == null {
        sem_require(entity_attach_result(node, null, null) == WorkBudgetError.None);
        node = null;
    }
    if error != WorkBudgetError.None { sem_type_resource(c, subject, error); }
    return node;
}

fn sem_type_entity(c: SemanticContext*, t: FoundationType*, subject: void*): void* {
    if !sem_ok(c) { return null; }
    var i: usize = 0;
    for(; i < c.program.types.length; i++) {
        var n: void* = c.program.types.data[i];
        var step3 = sem_get(n);
        // A binding is a producer, not the canonical identity of its result.
        // Other aliases can still be unresolved here (for example in an enum
        // header). Never intern a mutable declaration payload as a type value.
        if step3.global { continue; }
        if semantic_type_equal(&step3.type, t) {
            return n;
        }
    }
    i = 0;
    for(; i < c.type_arguments.length; i++) {
        var n: void* = c.type_arguments.data[i];
        var step7 = sem_get(n);
        if semantic_type_equal(&step7.type, t) {
            return n;
        }
    }
    var n = sem_type_node(c, subject, KType);
    if n == null { return null; }
    var value = sem_get(n);
    sem_set_type(&value.type, t);
    var step11 = sem_type_name(c, t);
    if !sem_set_name(c, value, step11) { return default; }
    if !vector_push(&c.type_arguments, n) {
        sem_type_resource(c, subject, WorkBudgetError.Memory);
        sem_require(entity_attach_result(n, null, null) == WorkBudgetError.None);
        return null;
    }
    return n;
}

fn sem_type_uses_begin(c: SemanticContext*): void {
    if !sem_ok(c) { return; }
    var error: WorkBudgetError;
    var kind = sem_create_result(c.program.root, &error);
    if kind != null && !entity_register(kind, sizeof(SemanticTypeUse), alignof(SemanticTypeUse), 0) {
        error = WorkBudgetError.Invalid;
    }
    if error != WorkBudgetError.None {
        sem_resource_record(c.program, error, 0);
        return;
    }
    c.type_uses = kind;
}

fn sem_type_use(c: SemanticContext*, node: void*, type: FoundationType*): void {
    if !sem_ok(c) { return; }
    if c.type_uses == null && type.scalar != SFunction {
        return;
    }
    if c.type_observations != null {
        var observation: SemanticTypeObservation = { node: node, type: *type };
        if !vector_push(c.type_observations, observation) {
            sem_type_resource(c, node, WorkBudgetError.Memory);
        }
        return;
    }
    if type.scalar == SFunction && !sem_has(&c.type_arguments, type.record)
        && !vector_push(&c.type_arguments, type.record) {
        sem_type_resource(c, node, WorkBudgetError.Memory);
        return;
    }
    if c.type_uses == null { return; }
    if node == null {
        sem_resource_record(c.program, WorkBudgetError.Invalid, 0);
        return;
    }
    var fresh = entity_component_get(node, c.type_uses) == null;
    var error: WorkBudgetError;
    var component = entity_component_add_result(node, c.type_uses, &error);
    if component == null {
        sem_type_resource(c, node, error);
        return;
    }
    var use = bits(SemanticTypeUse*, entity_component_data(component));
    if fresh { *use = default; }
    var target = sem_type_entity(c, type, node);
    if target != null { use.target = target; }
}

fn sem_type_observations_publish(c: SemanticContext*, observations: vector(SemanticTypeObservation)*): void {
    sem_require(c.entity_stage == null && c.type_observations == null);
    defer vector_dispose(observations);
    foreach(var &observation in observations) {
        if !sem_ok(c) { break; }
        // Keep each privately constructed signature reachable for the later
        // signature-lowering barrier, even when its type is structurally equal.
        if observation.type.scalar == SFunction && !sem_has(&c.type_arguments, observation.type.record) {
            if !vector_push(&c.type_arguments, observation.type.record) {
                sem_type_resource(c, observation.node, WorkBudgetError.Memory);
                break;
            }
        }
        sem_type_use(c, observation.node, &observation.type);
    }
}

// Resolve the ordinary checked value without mutating the shared argument
// interner. Primitive and array queries need a value, not an argument identity.
fn sem_constant_value(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    var prepared = sem_type_value_prepared(c, n);
    n = sem_surface_unwrap(n);
    loop {
        var step9 =(sem_is(n, "CoreTypeArgument") || sem_is(n, "CoreCallArgument") || sem_is(n, "CoreOperand") || sem_is(n, "CoreArrayCount")) && sem_child_count(n) == 1;
        if !step9 {
            break;
        }
        n = sem_child(n, 0);
    }
    var value: void* = prepared ?? generic_lookup(c.generics, n, n);
    if value == null {
        var text: u8* = sem_tokens(c, n);
        if !sem_ok(c) { return default; }
        if text[0] == 0 || text[0] != 45 &&(text[0] < 48 || text[0] > 57) {
            sem_fail(c, n, "Expected a compile-time integer argument (an integer literal or a bound template value)");
            return null;
        }
        var size: FoundationType* = sem_type_new(c, SUSize, 0, null);
        if !sem_ok(c) { return default; }
        if expected_type != null {
            size = expected_type;
        }
        value = sem_operand(c, n, size);
        if !sem_ok(c) {
            return null;
        }
    }
    var constant: FoundationNode* = sem_get(value);
    if !constant.constant || !semantic_integer(&constant.type) {
        sem_fail(c, n, "Expected a compile-time integer argument");
        return null;
    }
    if expected_type != null && !semantic_type_equal(&constant.type, expected_type) {
        var step41 = sem_type_name(c, expected_type);
        var step42 = sem_cat(c, "Expected ", step41);
        if !sem_ok(c) { return default; }
        var step43 = sem_type_name(c, &constant.type);
        var step44 = sem_cat(c, " compile-time argument, got ", step43);
        if !sem_ok(c) { return default; }
        var step45 = sem_cat(c, step42, step44);
        if !sem_ok(c) { return default; }
        sem_fail(c, n, step45);
        return null;
    }
    return value;
}

fn sem_constant_argument(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    var value = sem_constant_value(c, n, expected_type);
    if !sem_ok(c) || value == null { return null; }
    var constant = sem_get(value);
    foreach(var existing in &c.constant_arguments) {
        var e: FoundationNode* = sem_get(existing);
        if semantic_type_equal(&e.type, &constant.type) && e.bits == constant.bits {
            return existing;
        }
    }
    var result = sem_type_node(c, n, KOperand);
    if result == null { return null; }
    var out = sem_get(result);
    out.constant = true;
    sem_set_type(&out.type, &constant.type);
    out.bits = constant.bits;
    if !vector_push(&c.constant_arguments, result) {
        sem_type_resource(c, n, WorkBudgetError.Memory);
        sem_require(entity_attach_result(result, null, null) == WorkBudgetError.None);
        return null;
    }
    return result;
}

fn sem_instance_name(c: SemanticContext*, definition: void*, arguments: vector(void*)*): u8* {
    var name: u8* = sem_cat(c, sem_identifier(c, sem_member(definition, "name")), "(");
    if !sem_ok(c) { return default; }
    var i: usize = 0;
    for(; i < arguments.length; i++) {
        if i != 0 {
            name = sem_cat(c, name, ", ");
            if !sem_ok(c) { return default; }
        }
        var arg: FoundationNode* = sem_get(arguments.data[i]);
        if arg.constant {
            name = sem_cat(c, name, sem_number(c, arg.bits, &arg.type));
            if !sem_ok(c) { return default; }
        } else {
            name = sem_cat(c, name, sem_type_name(c, &arg.type));
            if !sem_ok(c) { return default; }
        }
    }
    name = sem_cat(c, name, ")");
    if !sem_ok(c) { return default; }
    var unique: u8* = name;
    var suffix: u64 = 1;
    loop {
        var step16 = sem_lookup_table(c.source_names, unique) != null || sem_lookup_table(c.output_names, unique) != null || sem_owned(c.functions, sem_owner(c, definition), unique) != null;
        if !step16 {
            break;
        }
        suffix++;
        unique = sem_cat(c, sem_cat(c, name, "_"), sem_decimal(c, suffix));
        if !sem_ok(c) { return default; }
    }
    return unique;
}

fn sem_register_template(c: SemanticContext*, n: void*): void {
    var resource_error = WorkBudgetError.None;
    var kind = generic_register_result(c.generics, n, &resource_error);
    if resource_error != WorkBudgetError.None {
        sem_resource_record(c.program, resource_error, sem_offset(c, n));
        return;
    }
    if !sem_generic_ok(c, n) || kind == KProgram {
        return;
    }
    var step7 = sem_member(n, "name");
    var name: u8* = sem_identifier(c, step7);
    if !sem_ok(c) { return; }
    if !sem_is(n, "CoreFunction") {
        sem_fail(c, n, "Templates cannot be extern or export declarations; export a concrete wrapper");
        return;
    }
    var names: SemanticTable* = sem_table(c);
    if !sem_ok(c) { return; }
    var step12 = sem_member(n, "params");
    var parameters: vector(void*)* = sem_collect(c, step12, "CoreParameter");
    if !sem_ok(c) { return; }
    foreach(var p in parameters) {
        var step16 = sem_member(p, "name");
        var value: u8* = sem_identifier(c, step16);
        if !sem_ok(c) { return; }
        if !sem_put(c, names, value, p) {
            var step20 = sem_cat(c, "Duplicate template parameter '", value);
            if !sem_ok(c) { return; }
            var step21 = sem_cat(c, step20, "'");
            if !sem_ok(c) { return; }
            sem_fail(c, p, step21);
            return;
        }
    }
    var registry: SemanticTable* = c.templates;
    if kind == KParameter {
        registry = c.type_functions;
    }
    var existing = sem_callable_owned(c, sem_owner(c, n), name);
    if existing != null {
        sem_fail(c, n, sem_cat(c, "Duplicate template '", sem_cat(c, name, "'")));
        return;
    }
    if !sem_define(c, registry, n, name) {
        var step25 = sem_cat(c, "Duplicate template '", name);
        if !sem_ok(c) { return; }
        var step26 = sem_cat(c, step25, "'");
        if !sem_ok(c) { return; }
        sem_fail(c, n, step26);
        return;
    }
    if semantic_builtin_kind(name) != 0 {
        var step29 = sem_cat(c, "Template name '", name);
        if !sem_ok(c) { return; }
        var step30 = sem_cat(c, step29, "' already names a foundation builtin");
        if !sem_ok(c) { return; }
        sem_fail(c, n, step30);
    }
    if !sem_push_checked(c, &c.template_nodes, n) { return; }
}

// Only a registered declaration's type annotation may publish a nominal
// identity before its fields. An expression may immediately inspect its result,
// so type spellings inside runtime calls retain ordinary synchronous checking.
fn sem_type_declaration_context(c: SemanticContext*, node: void*): bool {
    if c.declaration_subjects == null || !sem_is(node, "CoreType") { return false; }
    var annotation = node;
    var parent = sem_parent(annotation);
    while sem_is(parent, "CoreType") {
        annotation = parent;
        parent = sem_parent(annotation);
    }
    if parent == null || sem_member(parent, "type") != annotation { return false; }
    if sem_is(parent, "CoreField") {
        while parent != null && !sem_is(parent, "CoreStruct") { parent = sem_parent(parent); }
    }
    return sem_declaration_query(c, parent) != 0;
}

fn sem_constructor_arguments(c: SemanticContext*, n: void*, definition: void*): vector(void*)* {
    var name = sem_identifier(c, sem_member(n, "name"));
    if definition == null {
        var step6 = sem_cat(c, "Unknown type constructor '", name);
        if !sem_ok(c) { return default; }
        var step7 = sem_cat(c, step6, "'");
        if !sem_ok(c) { return default; }
        sem_fail(c, n, step7);
        return null;
    }
    var wanted: u8* = "CoreTypeArgument";
    if sem_is(n, "CoreCall") {
        wanted = "CoreCallArgument";
    }
    var step9 = sem_member(n, "args");
    var args: vector(void*)* = sem_collect(c, step9, wanted);
    if !sem_ok(c) { return default; }
    if args.length == 0 && !sem_is(n, "CoreCall") {
        var step15 = sem_member(n, "args");
        args = sem_collect(c, step15, "CoreType");
        if !sem_ok(c) { return default; }
    }
    var step17 = generic_parameter_count(c.generics, definition);
    if args.length != step17 {
        var step19 = sem_cat(c, "Wrong argument count for type constructor '", name);
        if !sem_ok(c) { return default; }
        var step20 = sem_cat(c, step19, "'");
        if !sem_ok(c) { return default; }
        sem_fail(c, n, step20);
        return null;
    }
    var arguments: vector(void*)* = sem_list(c);
    if !sem_ok(c) { return default; }
    var step22 = sem_member(definition, "params");
    var parameters: vector(void*)* = sem_collect(c, step22, "CoreParameter");
    if !sem_ok(c) { return default; }
    for(var i: usize = 0; i < args.length; i++) {
        if generic_type_parameter(c.generics, definition, i) {
            var step27 = sem_type(c, args.data[i]);
            var argument = sem_type_entity(c, step27, args.data[i]);
            if argument == null { return null; }
            if !sem_push_checked(c, arguments, argument) { return default; }
        } else {
            var step29 = sem_member(parameters.data[i], "type");
            var expected_type: FoundationType* = sem_type(c, step29);
            if !sem_ok(c) { return null; }
            if !semantic_integer(expected_type) {
                sem_fail(c, parameters.data[i], "Compile-time value parameters currently require an integer type");
                return null;
            }
            var argument = sem_constant_argument(c, args.data[i], expected_type);
            if argument == null { return null; }
            if !sem_push_checked(c, arguments, argument) { return default; }
        }
        if !sem_ok(c) {
            return null;
        }
    }
    return arguments;
}

fn sem_type_call(c: SemanticContext*, n: void*): FoundationType* {
    var prepared = sem_constructor_prepared(c, n);
    if prepared != null { return prepared; }
    var previous_defer = c.defer_type_fields;
    c.defer_type_fields ||= sem_type_declaration_context(c, n);
    defer { c.defer_type_fields = previous_defer; }
    var step1 = sem_member(n, "name");
    var name: u8* = sem_identifier(c, step1);
    if !sem_ok(c) { return default; }
    var primitive = sem_type_primitive(c, n, name);
    if primitive != null { return primitive; }
    if sem_equal(name, "pointer_type") || sem_equal(name, "array_type") {
        var pointer = sem_equal(name, "pointer_type");
        var args = sem_collect(c, sem_member(n, "args"), sem_is(n, "CoreCall") ? "CoreCallArgument" : "CoreTypeArgument");
        if !sem_ok(c) { return default; }
        var arity: usize = pointer ? 1 : ArrayTypeConstructorArity;
        if args.length != arity {
            sem_fail(c, n, "Wrong argument count for type constructor");
            return sem_type_new(c, SI32, 0, null);
        }
        var type = sem_type_copy(c, sem_type(c, args.data[0]));
        if !sem_ok(c) { return default; }
        if pointer {
            type.pointers++;
            if type.pointers > FoundationPointerDepthLimit { sem_fail(c, n, "Foundation pointer nesting limit is 16"); }
            return type;
        }
        var length = sem_array_length_value(c, n, type, sem_constant_value(c, args.data[1], null));
        return sem_ok(c) ? (sem_array_intern(c, type, length, n) ?? type) : type;
    }
    var definition: void* = sem_resolve(c, c.type_functions, step1, name);
    if definition == null && sem_equal(name, "function") && sem_type_identity_call(c, n) {
        var arguments = sem_collect(c, sem_member(n, "args"), sem_is(n, "CoreCall") ? "CoreCallArgument" : "CoreTypeArgument");
        if !sem_ok(c) { return default; }
        if arguments.length == 0 {
            sem_fail(c, n, "function requires a return type followed by its parameter types");
            return sem_type_new(c, SI32, 0, null);
        }
        var result = sem_type(c, arguments.data[0]);
        var parameters = sem_list(c);
        if !sem_ok(c) { return default; }
        for(var i: usize = 1; i < arguments.length && sem_ok(c); i++) {
            var type = sem_type(c, arguments.data[i]);
            if type.pointers == 0 && type.scalar == SVoid { sem_fail(c, arguments.data[i], "A function parameter cannot have void type"); }
            var parameter = sem_control_node(c, n, KParameter);
            sem_set_type(&sem_get(parameter).type, type);
            if !sem_push_checked(c, parameters, parameter) { return default; }
        }
        return sem_function_type(c, n, result, parameters);
    }
    var invalid = sem_type_new(c, SI32, 0, null);
    if !sem_ok(c) { return default; }
    var arguments = sem_constructor_arguments(c, n, definition);
    if !sem_ok(c) { return invalid; }
    var resource_error = WorkBudgetError.None;
    var instance = generic_instantiate_result(c.generics, definition, n, arguments.data, arguments.length, &resource_error);
    if resource_error != WorkBudgetError.None {
        sem_resource_record(c.program, resource_error, sem_offset(c, n));
        return invalid;
    }
    if !sem_generic_ok(c, n) || instance == null {
        return invalid;
    }
    var step42 = sem_state(c, c.source_bases, instance);
    if !sem_ok(c) { return default; }
    var step43 = sem_source_base(c, definition);
    step42.number = step43;
    if c.declaration_state != null {
        var component = entity_component_get(instance, c.declaration_state);
        var failure = bits(SemanticDeclaration*, entity_component_data(component));
        if sem_declaration_restore_error(c, failure) { return invalid; }
    }
    // Constructor aliases can fail before producing a record/field query. Keep
    // that diagnostic on the instantiated entity too, rather than caching an
    // invalid type or mistaking a later use for recursive construction.
    var retain_failure = sem_ok(c) && c.entity_stage == null;
    defer {
        if retain_failure && !sem_ok(c) {
            sem_declaration_capture_error(c, sem_declaration_state(c, instance));
        }
    }
    var entry: SemanticEntry* = sem_state(c, c.type_results, instance);
    if !sem_ok(c) { return default; }
    if entry.value != null {
        var result = bits(FoundationType*, entry.value);
        // Nominal publication precedes field checking. A cached identity must
        // retain a failed field producer's diagnostic when another body uses it.
        var query = result.record == null ? 0 : sem_declaration_layout_waiting(c, result.record);
        if query != 0 && sem_declaration_failure(c, query) {
            return invalid;
        }
        return result;
    }
    if entry.number != 0 {
        var step48 = sem_cat(c, "Recursive type constructor '", name);
        if !sem_ok(c) { return default; }
        var step49 = sem_cat(c, step48, "' has no concrete struct to resolve");
        if !sem_ok(c) { return default; }
        sem_fail(c, n, step49);
        return invalid;
    }
    entry.number = 1;
    var result: void* = generic_type_result(c.generics, instance);
    if !sem_generic_ok(c, n) || result == null {
        return invalid;
    }
    var step56 = sem_state(c, c.source_bases, result);
    if !sem_ok(c) { return default; }
    var step57 = sem_source_base(c, definition);
    step56.number = step57;
    if sem_is(result, "CoreStruct") {
        var step59 = sem_instance_name(c, definition, arguments);
        sem_type_header(c, result, step59);
        if !sem_ok(c) {
            return invalid;
        }
        var step62 = sem_get(result);
        var t: FoundationType* = &step62.type;
        var step63 = bits(void*, t);
        entry.value = step63;
        if !sem_push_checked(c, &c.generated, result) { return default; }
        if c.defer_type_fields {
            sem_require(c.declaration_subjects != null);
            sem_declaration_add(c, result);
            sem_declaration_discover(c);
            if sem_ok(c) && !work_demand(&c.queries, sem_declaration_query(c, result)) {
                sem_resource_record(c.program, sem_query_error(c), sem_offset(c, result));
            }
        } else { sem_type_fields(c, result); }
        entry.number = 0;
        return t;
    }
    var t: FoundationType* = sem_type(c, result);
    var step65 = bits(void*, t);
    entry.value = step65;
    entry.number = 0;
    return t;
}

fn sem_type(c: SemanticContext*, n: void*): FoundationType* {
    if sem_editor_symbol(c, n, 2) {
        return sem_type_new(c, SI32, 0, null);
    }
    c.type_depth++;
    var result = sem_array_type_prepared(c, n);
    if result == null { result = sem_constructor_prepared(c, n); }
    if result == null { result = sem_type_impl(c, n); }
    c.type_depth--;
    if sem_ok(c) {
        sem_type_use(c, n, result);
    }
    return result;
}

fn sem_array_count(node: void*): void* {
    return sem_member(node, "count") ?? sem_member(node, "index");
}

fn sem_array_syntax(node: void*): bool {
    return sem_member(node, "base") != null && sem_array_count(node) != null;
}

fn sem_array_length(c: SemanticContext*, node: void*, element: FoundationType*): usize {
    var value = sem_constant_value(c, sem_array_count(node), null);
    return sem_array_length_value(c, node, element, value);
}

fn sem_array_length_value(c: SemanticContext*, node: void*, element: FoundationType*, value: void*): usize {
    if !sem_ok(c) || value == null { return 0; }
    var constant = sem_get(value);
    var length = constant.bits;
    var sign = semantic_mask(&constant.type) / 2 + 1;
    if semantic_signed(&constant.type) && (length & sign) != 0 { length = 0; }
    if length == 0 || length > FoundationArrayLengthLimit {
        sem_fail(c, node, "Array length must be between 1 and 1,048,576");
        return 0;
    }
    if element.pointers == 0 && element.scalar == SVoid {
        sem_fail(c, node, "An array cannot have void elements");
        return 0;
    }
    return convert(usize, length);
}

// Canonical identity publication is coordinator-owned. Worker receipts carry
// the checked element type and extent; no private array identity escapes.
fn sem_array_intern(c: SemanticContext*, element: FoundationType*, length: usize, subject: void*): FoundationType* {
    sem_require(c.entity_stage == null && length != 0);
    if !sem_ok(c) { return null; }
    foreach(var entry in &c.program.types) {
        var array = sem_get(entry);
        if array.type.scalar == SArray && array.type.record == entry
            && semantic_type_equal(&array.element, element) && array.length == length {
            return &array.type;
        }
    }
    var entity = sem_type_node(c, subject, KType);
    if entity == null { return null; }
    var array = sem_get(entity);
    sem_set_name(c, array, sem_cat(c, sem_cat(c, sem_type_name(c, element), "["),
        sem_cat(c, sem_decimal(c, convert(u64, length)), "]")));
    array.element = *element;
    array.length = length;
    array.type = sem_type_value(c, SArray, 0, entity);
    if !vector_push(&c.program.types, entity) {
        sem_type_resource(c, subject, WorkBudgetError.Memory);
        sem_require(entity_attach_result(entity, null, null) == WorkBudgetError.None);
        return null;
    }
    return &array.type;
}

fn sem_type_impl(c: SemanticContext*, n: void*): FoundationType* {
    n = sem_surface_unwrap(n);
    var prepared = sem_constructor_prepared(c, n);
    if prepared != null { return prepared; }
    while sem_is(n, "CoreTypeArgument") && sem_child_count(n) == 1 {
        n = sem_surface_unwrap(sem_child(n, 0));
    }
    var query = n;
    while sem_is(query, "CoreType") && sem_child_count(query) == 1 {
        query = sem_child(query, 0);
    }
    if sem_is(query, "TowerDecltype") {
        var deferred_fields = c.defer_type_fields;
        c.defer_type_fields = false;
        defer { c.defer_type_fields = deferred_fields; }
        var previous_operand = c.type_query_operand;
        c.type_query_operand = sem_surface_unwrap(sem_member(query, "value"));
        defer { c.type_query_operand = previous_operand; }
        var previous = c.unevaluated;
        c.unevaluated = true;
        var expression = sem_operand(c, c.type_query_operand, null);
        c.unevaluated = previous;
        if !sem_ok(c) || expression == null {
            return sem_type_new(c, SI32, 0, null);
        }
        var type = sem_type_copy(c, &sem_get(expression).type);
        if !sem_ok(c) { return default; }
        sem_type_use(c, query, type);
        return type;
    }
    if sem_is(n, "TowerExpression") {
        var left = sem_member(n, "left");
        var present = left != null;
        if present {
            var op = sem_surface_operator(c, n, left);
            if sem_equal(op, "*") {
                var tail = sem_tokens(c, sem_member(n, "right"));
                if !sem_ok(c) { return default; }
                var count: u32 = 1;
                for(var index: usize = 0; !(tail[index] == 0); index++) {
                    if tail[index] == 42 {
                        count++;
                    }
                    else {
                        sem_fail(c, n, "Expected a type spelling");
                        break;
                    }
                }
                var type = sem_type_copy(c, sem_type(c, left));
                if !sem_ok(c) { return default; }
                type.pointers = type.pointers + count;
                if type.pointers > 16 {
                    sem_fail(c, n, "Foundation pointer nesting limit is 16");
                }
                return type;
            }
        }
    }
    var invalid: FoundationType* = sem_type_new(c, SI32, 0, null);
    if !sem_ok(c) { return default; }
    if c.type_depth > 128 {
        sem_fail(c, n, "Type construction nesting exceeds 128; check recursive type arguments");
        return invalid;
    }
    loop {
        if !((sem_is(n, "CoreTypeArgument") || sem_is(n, "CoreCallArgument") || sem_is(n, "CoreOperand")) && sem_child_count(n) == 1) {
            break;
        }
        n = sem_child(n, 0);
    }
    if(sem_is(n, "CoreType") || sem_is(n, "CoreCall")) && sem_member(n, "args") != null {
        return sem_type_call(c, n);
    }
    // A dotted type argument uses the ordinary location tree in call position.
    // Resolve its namespace before the pointer/array shape below.
    var qualified_name = sem_name_node(n);
    if sem_member(qualified_name, "field") != null {
        var spelling = sem_identifier(c, qualified_name);
        if !sem_ok(c) { return default; }
        var declaration = sem_resolve(c, c.types, qualified_name, spelling);
        var present = declaration != null;
        if present {
            sem_declaration_type(c, declaration);
            var value = sem_get(declaration);
            return &value.type;
        }
        sem_fail(c, n, sem_cat(c, "Unknown type '", sem_cat(c, spelling, "'")));
        return invalid;
    }
    var base: void* = sem_member(n, "base");
    if base != null {
        var step24 = sem_type(c, base);
        var t: FoundationType* = sem_type_copy(c, step24);
        if !sem_ok(c) { return default; }
        var count = sem_array_count(n);
        if count != null {
            var length = sem_array_length(c, n, t);
            return sem_ok(c) ? (sem_array_intern(c, t, length, n) ?? t) : t;
        }
        if sem_member(n, "field") != null {
            sem_fail(c, n, "Expected a type name, not field access");
            return t;
        }
        t.pointers++;
        if t.pointers > FoundationPointerDepthLimit {
            sem_fail(c, n, "Foundation pointer nesting limit is 16");
        }
        return t;
    }
    var text: u8* = sem_identifier(c, n);
    if !sem_ok(c) { return default; }
    if generic_origin(c.generics, n) != null {
        var parent: void* = sem_parent(n);
        loop {
            if parent == null {
                break;
            }
            var step73 = sem_is(parent, "CoreStruct") && sem_get(parent) != null;
            if step73 {
                var step76 = sem_member(parent, "name");
                step73 = sem_equal(text, sem_identifier(c, step76));
                if !sem_ok(c) { return default; }
            }
            if step73 {
                var step79 = sem_get(parent);
                return &step79.type;
            }
            parent = sem_parent(parent);
        }
    }
    var bound: void* = generic_lookup(c.generics, n, n);
    if bound != null {
        var step83 = sem_get(bound);
        if step83.kind != KType {
            sem_fail(c, n, "Expected a type, got a compile-time integer value");
        }
        var step85 = sem_get(bound);
        return &step85.type;
    }
    if sem_equal(text, "type") {
        return sem_type_new(c, SType, 0, null);
    }
    var found: void* = sem_resolve(c, c.types, n, text);
    if found == null {
        var step89 = sem_cat(c, "Unknown type '", text);
        if !sem_ok(c) { return default; }
        var step90 = sem_cat(c, step89, "'");
        if !sem_ok(c) { return default; }
        sem_fail(c, n, step90);
        return invalid;
    }
    sem_declaration_type(c, found);
    var step91 = sem_get(found);
    return &step91.type;
}

fn sem_type_header(c: SemanticContext*, n: void*, name: u8*): void {
    if !sem_shape(c, n, "name") || !sem_shape(c, n, "fields") {
        return;
    }
    var t: FoundationNode* = sem_node(c, n, KType);
    if name[0] == 0 {
        var step9 = sem_member(n, "name");
        name = sem_identifier(c, step9);
        if !sem_ok(c) { return; }
    }
    if !sem_set_name(c, t, sem_output_name(c, n, name)) { return; }
    var step12 = name[0] == 0 || sem_equal(name, "type");
    if !step12 {
        var step16 = sem_owned(c.types, sem_owner(c, n), name);
        if step16 == null {
            step16 = sem_owned(c.types, null, name);
        }
        step12 = step16 != null;
    }
    step12 ||= sem_owned(c.type_functions, sem_owner(c, n), name) != null;
    if step12 {
        var step21 = sem_cat(c, "Missing or duplicate type '", name);
        if !sem_ok(c) { return; }
        var step22 = sem_cat(c, step21, "'");
        if !sem_ok(c) { return; }
        sem_fail(c, n, step22);
        return;
    }
    // Names use the shared hash index; layouts use the iterative work graph.
    // The compilation node/storage budgets apply instead of a 256-type cap.
    var step24 = sem_type_new(c, SStruct, 0, n);
    if !sem_ok(c) { return; }
    sem_set_type(&t.type, step24);
    sem_define(c, c.types, n, name);
    if !sem_push_checked(c, &c.program.types, n) { return; }
}

fn sem_type_fields(c: SemanticContext*, n: void*): void {
    var state: SemanticEntry* = sem_state(c, c.fields_done, n);
    if !sem_ok(c) { return; }
    if state.number != 0 {
        return;
    }
    state.number = 1;
    var t: FoundationNode* = sem_get(n);
    var names: SemanticTable* = sem_table(c);
    if !sem_ok(c) { return; }
    var fields: vector(void*)* = sem_collect(c, sem_member(n, "fields"), "CoreField");
    if !sem_ok(c) { return; }
    foreach(var field in fields) {
        if !sem_shape(c, field, "name") || !sem_shape(c, field, "type") {
            return;
        }
        var f: FoundationNode* = sem_node(c, field, KFieldDeclaration);
        var name: u8* = sem_identifier(c, sem_member(field, "name"));
        if !sem_ok(c) { return; }
        if !sem_set_name(c, f, name) { return; }
        var step19 = sem_type(c, sem_member(field, "type"));
        sem_set_type(&f.type, step19);
        if name[0] == 0 || !sem_put(c, names, name, field) {
            var step25 = sem_cat(c, "Missing or duplicate field '", name);
            if !sem_ok(c) { return; }
            sem_fail(c, field, sem_cat(c, step25, "'"));
        }
        if f.type.pointers == 0 && f.type.scalar == SVoid {
            sem_fail(c, field, "A field cannot have void type");
        }
        if !sem_push_checked(c, &t.items, field) { return; }
    }
}

fn sem_round(size: usize, alignment: usize): usize {
    return(size + alignment -1) / alignment *alignment;
}

fn sem_add_local(c: SemanticContext*, n: void*): void {
    var local: FoundationNode* = sem_get(n);
    var function: FoundationNode* = sem_get(c.current);
    if semantic_aggregate(&local.type) {
        sem_layout(c, local.type.record);
    }
    if !sem_ok(c) { return; }
    var alignment: usize = semantic_alignment(&local.type);
    local.index = function.locals.length;
    var step5 = sem_round(function.frame_size, alignment);
    local.byte_offset = step5;
    var step6 = semantic_size(&local.type);
    var step7 = local.byte_offset + step6;
    function.frame_size = step7;
    if function.frame_size > 4194304 {
        sem_fail(c, n, "Foundation local storage exceeds 4 MiB");
    }
    if !sem_push_checked(c, &function.locals, n) { return; }
}

fn sem_value_binding(c: SemanticContext*, n: void*): void* {
    n = sem_surface_unwrap(n);
    var name = sem_identifier(c, n);
    if !sem_ok(c) { return default; }
    var module = sem_namespace(c, n);
    if module != null { return sem_owned(c.globals, module, sem_identifier(c, sem_member(n, "field"))); }
    if sem_member(n, "base") != null { return null; }
    var scope = c.scope;
    while scope != null {
        var found = sem_lookup_table(scope.names, name);
        if found != null { return found; }
        scope = scope.parent;
    }
    return sem_resolve(c, c.globals, n, name);
}

fn sem_named_type_value(c: SemanticContext*, node: void*): bool {
    if sem_value_binding(c, node) != null { return false; }
    var declaration = generic_lookup(c.generics, node, node);
    if declaration == null { declaration = sem_resolve(c, c.types, node, sem_identifier(c, node)); }
    if declaration == null || sem_get(declaration).kind != KType { return false; }
    // A bound type parameter already supplies an immutable canonical type.
    // It has no declaration job to attach, particularly on a body worker.
    if sem_get(declaration).global && !sem_declaration_type(c, declaration) { return true; }
    var value = sem_node(c, node, KTypeReference);
    value.type = sem_type_value(c, SType, 0, null);
    value.element = sem_get(declaration).type;
    return true;
}

// Preserve Foundation's existing distinct value/function namespaces: a scalar
// variable named like a function does not hide that function in call position.
// An already typed callable binding does take precedence for indirect calls.
fn sem_call_uses_value(c: SemanticContext*, name: void*): bool {
    var binding = sem_value_binding(c, name);
    if binding != null {
        var type = &sem_get(binding).type;
        if type.scalar == SFunction && type.pointers == 0 { return true; }
        return sem_resolve(c, c.functions, name, sem_identifier(c, name)) == null;
    }
    return sem_member(name, "base") != null && sem_namespace(c, name) == null;
}

// Signatures are structural type objects on the same ECS model. Workers may
// construct private equivalents; equality never depends on their allocation.
fn sem_function_type(c: SemanticContext*, owner: void*, result: FoundationType*, parameters: vector(void*)*): FoundationType* {
    if parameters.length > FoundationParameterLimit || semantic_aggregate(result) && parameters.length == FoundationParameterLimit {
        sem_fail(c, owner, "Function signature exceeds the Foundation parameter limit");
    }
    foreach(var entity in &c.type_arguments) {
        var signature = sem_get(entity);
        if signature.type.scalar != SFunction || signature.type.pointers != 0 || signature.type.record != entity
        || !semantic_type_equal(&signature.element, result)
        || signature.parameters.length != parameters.length { continue; }
        var same = true;
        for(var i: usize = 0; i < parameters.length; i++) {
            same &&= semantic_type_equal(&sem_get(signature.parameters.data[i]).type, &sem_get(parameters.data[i]).type);
        }
        if same { return &signature.type; }
    }
    var entity = sem_control_node(c, owner, KType);
    var signature = sem_get(entity);
    sem_set_type(&signature.type, sem_type_new(c, SFunction, 0, entity));
    sem_set_type(&signature.element, result);
    foreach(var source in parameters) {
        var parameter = sem_control_node(c, entity, KParameter);
        sem_set_type(&sem_get(parameter).type, &sem_get(source).type);
        if !sem_push_checked(c, &signature.parameters, parameter) { return default; }
    }
    if !sem_set_name(c, signature, sem_type_name(c, &signature.type)) { return default; }
    if !sem_push_checked(c, &c.type_arguments, entity) { return default; }
    return &signature.type;
}

fn sem_function_reference(c: SemanticContext*, source: void*, name: void*): bool {
    name = sem_surface_unwrap(name);
    if !sem_is(name, "CoreLocation") && !sem_is(name, "Identifier") { return false; }
    if sem_member(name, "base") != null && sem_namespace(c, name) == null { return false; }
    if sem_value_binding(c, name) != null { return false; }
    var function = sem_resolve(c, c.functions, name, sem_identifier(c, name));
    if function == null { return false; }
    sem_query_input(c, function, convert(u32, SemanticQuery.Declaration));
    var definition = sem_get(function);
    var value = sem_node(c, source, KFunctionReference);
    value.binding = function;
    sem_set_type(&value.type, sem_function_type(c, source, &definition.type, &definition.parameters));
    sem_type_use(c, source, &value.type);
    return true;
}

fn sem_lookup(c: SemanticContext*, n: void*): void* {
    if sem_editor_capture(c, n, 1, null) {
        return null;
    }
    var name: u8* = sem_identifier(c, n);
    if !sem_ok(c) { return default; }
    var scope: SemanticScope* = c.scope;
    loop {
        if scope == null {
            break;
        }
        var found: void* = sem_lookup_table(scope.names, name);
        if found != null {
            if sem_declaration_type(c, found) {
                return found;
            }
            return null;
        }
        scope = scope.parent;
    }
    var found: void* = sem_resolve(c, c.globals, n, name);
    if found != null {
        if sem_declaration_type(c, found) {
            return found;
        }
        return null;
    }
    var step10 = sem_cat(c, "Unknown local '", name);
    if !sem_ok(c) { return default; }
    sem_fail(c, n, sem_cat(c, step10, "'"));
    return null;
}

fn sem_declaration_type(c: SemanticContext*, n: void*): bool {
    var value: FoundationNode* = sem_get(n);
    var state = sem_declaration_state(c, n);
    var alias = value.kind == KType && value.global;
    var step4 = value.kind != KDeclare && value.kind != KParameter && !alias;
    if !step4 {
        var step6 = state.number == 2;
        step4 = step6;
    }
    if step4 {
        sem_query_input(c, n, convert(u32, SemanticQuery.Declaration));
        return true;
    }
    if state.number == 1 {
        var chain: u8* = "";
        var i: usize = 0;
        loop {
            if !(i < c.inferring.length && c.inferring.data[i] != n) {
                break;
            }
            i++;
        }
        for(; i < c.inferring.length; i++) {
            var step15 = sem_name(sem_get(c.inferring.data[i]));
            var step16 = sem_cat(c, step15, " -> ");
            if !sem_ok(c) { return default; }
            chain = sem_cat(c, chain, step16);
            if !sem_ok(c) { return default; }
        }
        var step18 = sem_name(value);
        var step19 = sem_cat(c, "Cannot infer the type of '", step18);
        if !sem_ok(c) { return default; }
        var step20 = sem_cat(c, step19, "': initializer dependency cycle ");
        if !sem_ok(c) { return default; }
        var step21 = sem_name(value);
        var step22 = sem_cat(c, chain, step21);
        if !sem_ok(c) { return default; }
        var step23 = sem_cat(c, step22, "; add an explicit type annotation");
        if !sem_ok(c) { return default; }
        var step24 = sem_cat(c, step20, step23);
        if !sem_ok(c) { return default; }
        sem_fail(c, n, step24);
        return false;
    }
    var annotation: void* = sem_member(n, alias ? "value" : "type");
    if alias && annotation == null {
        sem_fail(c, n, "A type binding requires an initializer");
        return false;
    }
    if annotation != null {
        state.number = 1;
        if !sem_push_checked(c, &c.inferring, n) { return default; }
        var step27 = sem_type(c, annotation);
        sem_set_type(&value.type, step27);
        c.inferring.length--;
    } else {
        var initial: void* = sem_member(n, "value");
        if initial == null {
            var step30 = sem_name(value);
            var step31 = sem_cat(c, "Variable '", step30);
            if !sem_ok(c) { return default; }
            var step32 = sem_cat(c, step31, "' requires a type annotation or an initializer");
            if !sem_ok(c) { return default; }
            sem_fail(c, n, step32);
            return false;
        }
        if c.inferring.length >= 128 {
            sem_fail(c, n, "Foundation inferred-type dependency limit is 128");
            return false;
        }
        state.number = 1;
        if !sem_push_checked(c, &c.inferring, n) { return default; }
        var step34 = sem_initial_value(c, initial, null);
        value.value = step34;
        c.inferring.length--;
        if !sem_ok(c) || value.value == null {
            return false;
        }
        var step40 = sem_get(value.value);
        sem_set_type(&value.type, &step40.type);
        value.type.pointer_bytes = c.program.pointer_bytes;
    }
    var step42 = value.type.pointers == 0;
    if step42 {
        var step43 = value.type.scalar == SVoid;
        step42 = step43;
    }
    if step42 && !alias {
        sem_fail(c, n, value.kind == KParameter ? "Invalid or duplicate function parameter" : "A variable cannot have void type");
    }
    if !sem_ok(c) {
        return false;
    }
    if alias && !semantic_aggregate(&value.type) {
        value.size = semantic_size(&value.type);
        value.alignment = semantic_alignment(&value.type);
    }
    state.number = 2;
    return true;
}
