import tower;
import semantic_enums;
import semantic_layout;
import foundation_tags;
import foundation_types;
import semantic_context;
import semantic_definitions;
import semantic_modules;
import semantic_support;
import semantic_values;
import semantic_expressions;
import .library.vector;

// Semantic compiler over shared Foundation components.
// Temporary indexes and scratch allocations are scoped to one compilation.

fn sem_type_entity(c: SemanticContext*, t: FoundationType*): void* {
    var i: usize = 0;
    for(; i < c.program.types.length; i++) {
        var n: void* = c.program.types.data[i];
        var step3 = sem_get(n);
        if semantic_type_equal(&step3.type, t) {
            return n;
        }
    }
    i = 0;
    for(; i < c.type_arguments.length; i++) {
        var n: void* = c.type_arguments.data[i];
        var step7 = sem_get(n);
        if semantic_type_equal(&step7.type, t) {
            return n;
        }
    }
    var n: void* = sem_create(c.program.root);
    var value: FoundationNode* = sem_attach(n, KType());
    sem_set_type(&value.type, t);
    var step11 = sem_type_name(c, t);
    sem_set_name(value, step11);
    sem_push(&c.type_arguments, n);
    return n;
}

fn sem_type_uses_begin(c: SemanticContext*): void {
    c.type_uses = sem_create(c.program.root);
    sem_require(entity_register(c.type_uses, sizeof(SemanticTypeUse), alignof(SemanticTypeUse), 0));
}

fn sem_type_use(c: SemanticContext*, node: void*, type: FoundationType*): void {
    var observing = c.type_uses != null;
    if observing {} else {
        return;
    }
    var component = entity_component_add(node, c.type_uses);
    var use = bits(SemanticTypeUse*, entity_component_data(component));
    var allocated = use != null;
    sem_require(allocated);
    use.target = sem_type_entity(c, type);
}

fn sem_constant_argument(c: SemanticContext*, n: void*, expected_type: FoundationType*): void* {
    n = sem_surface_unwrap(n);
    loop {
        var step2 = sem_is(n, "CoreTypeArgument");
        if !step2 {
            var step4 = sem_is(n, "CoreCallArgument");
            step2 = step4;
        }
        if !step2 {
            var step6 = sem_is(n, "CoreOperand");
            step2 = step6;
        }
        if !step2 {
            var step8 = sem_is(n, "CoreArrayCount");
            step2 = step8;
        }
        var step9 = step2;
        if step9 {
            var step10 = sem_child_count(n);
            var step11 = step10 == 1;
            step9 = step11;
        }
        if !step9 {
            break;
        }
        var step13 = sem_child(n, 0);
        n = step13;
    }
    var value: void* = generic_lookup(c.generics, n, n);
    if value == null {
        var text: u8* = sem_tokens(c, n);
        var step18 = text[0] == 0;
        if !step18 {
            var step21 = text[0] != 45;
            if step21 {
                var step23 = text[0] < 48;
                if !step23 {
                    var step25 = text[0] > 57;
                    step23 = step25;
                }
                step21 = step23;
            }
            step18 = step21;
        }
        if step18 {
            sem_fail(c, n, "Expected a compile-time integer argument (an integer literal or a bound template value)");
            return null;
        }
        var size: FoundationType* = sem_type_new(c, SUSize(), 0, null);
        if expected_type != null {
            size = expected_type;
        }
        var step28 = sem_operand(c, n, size);
        value = step28;
        var step29 = sem_ok(c);
        if !step29 {
            return null;
        }
    }
    var constant: FoundationNode* = sem_get(value);
    var step33 = !constant.constant;
    if !step33 {
        var step35 = semantic_integer(&constant.type);
        var step36 = !step35;
        step33 = step36;
    }
    if step33 {
        sem_fail(c, n, "Expected a compile-time integer argument");
        return null;
    }
    var step38 = expected_type != null;
    if step38 {
        var step39 = semantic_type_equal(&constant.type, expected_type);
        var step40 = !step39;
        step38 = step40;
    }
    if step38 {
        var step41 = sem_type_name(c, expected_type);
        var step42 = sem_cat(c, "Expected ", step41);
        var step43 = sem_type_name(c, &constant.type);
        var step44 = sem_cat(c, " compile-time argument, got ", step43);
        var step45 = sem_cat(c, step42, step44);
        sem_fail(c, n, step45);
        return null;
    }
    var i: usize = 0;
    for(; i < c.constant_arguments.length; i++) {
        var existing: void* = c.constant_arguments.data[i];
        var e: FoundationNode* = sem_get(existing);
        var step50 = semantic_type_equal(&e.type, &constant.type);
        if step50 {
            var step51 = e.bits == constant.bits;
            step50 = step51;
        }
        if step50 {
            return existing;
        }
    }
    var result: void* = sem_create(c.program.root);
    var out: FoundationNode* = sem_attach(result, KOperand());
    out.constant = true;
    sem_set_type(&out.type, &constant.type);
    out.bits = constant.bits;
    sem_push(&c.constant_arguments, result);
    return result;
}

fn sem_instance_name(c: SemanticContext*, definition: void*, arguments: vector(void*)*): u8* {
    var step1 = sem_member(definition, "name");
    var step2 = sem_identifier(c, step1);
    var name: u8* = sem_cat(c, step2, "(");
    var i: usize = 0;
    for(; i < arguments.length; i++) {
        if i != 0 {
            var step7 = sem_cat(c, name, ", ");
            name = step7;
        }
        var arg: FoundationNode* = sem_get(arguments.data[i]);
        if arg.constant {
            var step9 = sem_number(c, arg.bits, &arg.type);
            var step10 = sem_cat(c, name, step9);
            name = step10;
        } else {
            var step11 = sem_type_name(c, &arg.type);
            var step12 = sem_cat(c, name, step11);
            name = step12;
        }
    }
    var step13 = sem_cat(c, name, ")");
    name = step13;
    var unique: u8* = name;
    var suffix: u64 = 1;
    loop {
        var step14 = sem_lookup_table(c.source_names, unique);
        var step16 = step14 != null;
        if !step16 {
            var step18 = sem_lookup_table(c.output_names, unique);
            var step19 = step18 != null;
            step16 = step19;
        }
        if !step16 {
            var step21 = sem_owned(c.functions, sem_owner(c, definition), unique);
            var step22 = step21 != null;
            step16 = step22;
        }
        if !step16 {
            break;
        }
        suffix++;
        var step24 = sem_cat(c, name, "_");
        var step25 = sem_decimal(c, suffix);
        var step26 = sem_cat(c, step24, step25);
        unique = step26;
    }
    return unique;
}

fn sem_register_template(c: SemanticContext*, n: void*): void {
    var kind: u32 = generic_register(c.generics, n);
    var step2 = sem_generic_ok(c, n);
    var step4 = !step2;
    if !step4 {
        var step6 = kind == KProgram();
        step4 = step6;
    }
    if step4 {
        return;
    }
    var step7 = sem_member(n, "name");
    var name: u8* = sem_identifier(c, step7);
    var step9 = sem_is(n, "CoreFunction");
    if !step9 {
        sem_fail(c, n, "Templates cannot be extern or export declarations; export a concrete wrapper");
        return;
    }
    var names: SemanticTable* = sem_table(c);
    var step12 = sem_member(n, "params");
    var parameters: vector(void*)* = sem_collect(c, step12, "CoreParameter");
    for(var i: usize = 0; i < parameters.length; i++) {
        var p: void* = parameters.data[i];
        var step16 = sem_member(p, "name");
        var value: u8* = sem_identifier(c, step16);
        var step18 = sem_put(c, names, value, p);
        if !step18 {
            var step20 = sem_cat(c, "Duplicate template parameter '", value);
            var step21 = sem_cat(c, step20, "'");
            sem_fail(c, p, step21);
            return;
        }
    }
    var registry: SemanticTable* = c.templates;
    if kind == KParameter() {
        registry = c.type_functions;
    }
    var existing = sem_callable_owned(c, sem_owner(c, n), name);
    var duplicate = existing != null;
    if duplicate {
        sem_fail(c, n, sem_cat(c, "Duplicate template '", sem_cat(c, name, "'")));
        return;
    }
    var step23 = sem_define(c, registry, n, name);
    if !step23 {
        var step25 = sem_cat(c, "Duplicate template '", name);
        var step26 = sem_cat(c, step25, "'");
        sem_fail(c, n, step26);
        return;
    }
    var step27 = semantic_builtin_kind(name);
    if step27 != 0 {
        var step29 = sem_cat(c, "Template name '", name);
        var step30 = sem_cat(c, step29, "' already names a foundation builtin");
        sem_fail(c, n, step30);
    }
    sem_push(&c.template_nodes, n);
}

fn sem_type_call(c: SemanticContext*, n: void*): FoundationType* {
    var step1 = sem_member(n, "name");
    var name: u8* = sem_identifier(c, step1);
    var definition: void* = sem_resolve(c, c.type_functions, step1, name);
    var invalid: FoundationType* = sem_type_new(c, SI32(), 0, null);
    if definition == null {
        var step6 = sem_cat(c, "Unknown type constructor '", name);
        var step7 = sem_cat(c, step6, "'");
        sem_fail(c, n, step7);
        return invalid;
    }
    var wanted: u8* = "CoreTypeArgument";
    if sem_is(n, "CoreCall") {
        wanted = "CoreCallArgument";
    }
    var step9 = sem_member(n, "args");
    var args: vector(void*)* = sem_collect(c, step9, wanted);
    var step12 = args.length == 0;
    if step12 {
        var step13 = sem_is(n, "CoreCall");
        var step14 = !step13;
        step12 = step14;
    }
    if step12 {
        var step15 = sem_member(n, "args");
        var step16 = sem_collect(c, step15, "CoreType");
        args = step16;
    }
    var step17 = generic_parameter_count(c.generics, definition);
    if args.length != step17 {
        var step19 = sem_cat(c, "Wrong argument count for type constructor '", name);
        var step20 = sem_cat(c, step19, "'");
        sem_fail(c, n, step20);
        return invalid;
    }
    var arguments: vector(void*)* = sem_list(c);
    var step22 = sem_member(definition, "params");
    var parameters: vector(void*)* = sem_collect(c, step22, "CoreParameter");
    for(var i: usize = 0; i < args.length; i++) {
        if generic_type_parameter(c.generics, definition, i) {
            var step27 = sem_type(c, args.data[i]);
            var step28 = sem_type_entity(c, step27);
            sem_push(arguments, step28);
        } else {
            var step29 = sem_member(parameters.data[i], "type");
            var expected_type: FoundationType* = sem_type(c, step29);
            var step31 = semantic_integer(expected_type);
            if !step31 {
                sem_fail(c, parameters.data[i], "Compile-time value parameters currently require an integer type");
                return invalid;
            }
            var step33 = sem_constant_argument(c, args.data[i], expected_type);
            sem_push(arguments, step33);
        }
        var step34 = sem_ok(c);
        if !step34 {
            return invalid;
        }
    }
    var instance: void* = generic_instantiate(c.generics, definition, n, arguments.data, arguments.length);
    var step37 = sem_generic_ok(c, n);
    var step39 = !step37;
    if !step39 {
        var step41 = instance == null;
        step39 = step41;
    }
    if step39 {
        return invalid;
    }
    var step42 = sem_state(c, c.source_bases, instance);
    var step43 = sem_source_base(c, definition);
    step42.number = step43;
    var entry: SemanticEntry* = sem_state(c, c.type_results, instance);
    if entry.value != null {
        return bits(FoundationType*, entry.value);
    }
    if entry.number != 0 {
        var step48 = sem_cat(c, "Recursive type constructor '", name);
        var step49 = sem_cat(c, step48, "' has no concrete struct to resolve");
        sem_fail(c, n, step49);
        return invalid;
    }
    entry.number = 1;
    var result: void* = generic_type_result(c.generics, instance);
    var step51 = sem_generic_ok(c, n);
    var step53 = !step51;
    if !step53 {
        var step55 = result == null;
        step53 = step55;
    }
    if step53 {
        return invalid;
    }
    var step56 = sem_state(c, c.source_bases, result);
    var step57 = sem_source_base(c, definition);
    step56.number = step57;
    if sem_is(result, "CoreStruct") {
        var step59 = sem_instance_name(c, definition, arguments);
        sem_type_header(c, result, step59);
        var step60 = sem_ok(c);
        if !step60 {
            return invalid;
        }
        var step62 = sem_get(result);
        var t: FoundationType* = &step62.type;
        var step63 = bits(void*, t);
        entry.value = step63;
        sem_push(&c.generated, result);
        sem_type_fields(c, result);
        entry.number = 0;
        return t;
    }
    var t: FoundationType* = sem_type(c, result);
    var step65 = bits(void*, t);
    entry.value = step65;
    entry.number = 0;
    return t;
}

fn sem_type(c: SemanticContext*, n: void*): FoundationType* {
    if sem_editor_symbol(c, n, 2) {
        return sem_type_new(c, SI32(), 0, null);
    }
    c.type_depth++;
    var result: FoundationType* = sem_type_impl(c, n);
    c.type_depth--;
    if sem_ok(c) {
        sem_type_use(c, n, result);
    }
    return result;
}

fn sem_type_impl(c: SemanticContext*, n: void*): FoundationType* {
    n = sem_surface_unwrap(n);
    if sem_is(n, "TowerExpression") {
        var left = sem_member(n, "left");
        var present = left != null;
        if present {
            var op = sem_surface_operator(c, n, left);
            var pointer = sem_equal(op, "*");
            if pointer {
                var tail = sem_tokens(c, sem_member(n, "right"));
                var count: u32 = 1;
                for(var index: usize = 0; !(tail[index] == 0); index++) {
                    var star = tail[index] == 42;
                    if star {
                        count++;
                    }
                    else {
                        sem_fail(c, n, "Expected a type spelling");
                        break;
                    }
                }
                var type = sem_type_copy(c, sem_type(c, left));
                type.pointers = type.pointers + count;
                var excessive = type.pointers > 16;
                if excessive {
                    sem_fail(c, n, "Foundation pointer nesting limit is 16");
                }
                return type;
            }
        }
    }
    var invalid: FoundationType* = sem_type_new(c, SI32(), 0, null);
    if c.type_depth > 128 {
        sem_fail(c, n, "Type construction nesting exceeds 128; check recursive type arguments");
        return invalid;
    }
    loop {
        var step4 = sem_is(n, "CoreTypeArgument");
        if !step4 {
            var step6 = sem_is(n, "CoreCallArgument");
            step4 = step6;
        }
        if !step4 {
            var step8 = sem_is(n, "CoreOperand");
            step4 = step8;
        }
        var step9 = step4;
        if step9 {
            var step10 = sem_child_count(n);
            var step11 = step10 == 1;
            step9 = step11;
        }
        if !step9 {
            break;
        }
        var step13 = sem_child(n, 0);
        n = step13;
    }
    var step15 = sem_is(n, "CoreType");
    if !step15 {
        var step17 = sem_is(n, "CoreCall");
        step15 = step17;
    }
    var step18 = step15;
    if step18 {
        var step19 = sem_member(n, "args");
        var step20 = step19 != null;
        step18 = step20;
    }
    if step18 {
        return sem_type_call(c, n);
    }
    // A dotted type argument uses the ordinary location tree in call position.
    // Resolve its namespace before the pointer/array shape below.
    var qualified_name = sem_name_node(n);
    var qualified = sem_member(qualified_name, "field") != null;
    if qualified {
        var spelling = sem_identifier(c, qualified_name);
        var declaration = sem_resolve(c, c.types, qualified_name, spelling);
        var present = declaration != null;
        if present {
            var value = sem_get(declaration);
            return &value.type;
        }
        sem_fail(c, n, sem_cat(c, "Unknown type '", sem_cat(c, spelling, "'")));
        return invalid;
    }
    var base: void* = sem_member(n, "base");
    if base != null {
        var step24 = sem_type(c, base);
        var t: FoundationType* = sem_type_copy(c, step24);
        var count: void* = sem_member(n, "count");
        if count == null {
            var step28 = sem_member(n, "index");
            count = step28;
        }
        if count != null {
            var value: void* = sem_constant_argument(c, count, null);
            if value == null {
                return t;
            }
            var v: FoundationNode* = sem_get(value);
            var length: u64 = v.bits;
            var step33 = semantic_mask(&v.type);
            var sign: u64 = step33 / 2;
            sign++;
            var step36 = semantic_signed(&v.type);
            if step36 {
                var step37 = length &sign;
                var step38 = step37 != 0;
                step36 = step38;
            }
            if step36 {
                length = 0;
            }
            var step40 = length == 0;
            if !step40 {
                var step42 = length > 1048576;
                step40 = step42;
            }
            if step40 {
                sem_fail(c, n, "Array length must be between 1 and 1,048,576");
                return t;
            }
            var step44 = t.pointers == 0;
            if step44 {
                var step45 = t.scalar == SVoid();
                step44 = step45;
            }
            if step44 {
                sem_fail(c, n, "An array cannot have void elements");
                return t;
            }
            var step46 = sem_type_name(c, t);
            var step47 = sem_cat(c, step46, "[");
            var step48 = sem_decimal(c, length);
            var step49 = sem_cat(c, step47, step48);
            var name: u8* = sem_cat(c, step49, "]");
            var i: usize = 0;
            for(; i < c.program.types.length; i++) {
                var a: FoundationNode* = sem_get(c.program.types.data[i]);
                var step55 = a.type.scalar == SArray();
                if step55 {
                    var step56 = semantic_type_equal(&a.element, t);
                    step55 = step56;
                }
                if step55 {
                    var step57 = convert(u64, a.length);
                    var step58 = step57 == length;
                    step55 = step58;
                }
                if step55 {
                    return &a.type;
                }
            }
            var entity: void* = sem_create(c.program.root);
            var a: FoundationNode* = sem_attach(entity, KType());
            sem_set_name(a, name);
            sem_set_type(&a.element, t);
            var step61 = convert(usize, length);
            a.length = step61;
            var step62 = sem_type_new(c, SArray(), 0, entity);
            sem_set_type(&a.type, step62);
            sem_push(&c.program.types, entity);
            return &a.type;
        }
        var step63 = sem_member(n, "field");
        if step63 != null {
            sem_fail(c, n, "Expected a type name, not field access");
            return t;
        }
        t.pointers++;
        if t.pointers > 16 {
            sem_fail(c, n, "Foundation pointer nesting limit is 16");
        }
        return t;
    }
    var text: u8* = sem_identifier(c, n);
    var step67 = generic_origin(c.generics, n);
    if step67 != null {
        var parent: void* = sem_parent(n);
        loop {
            var step70 = parent != null;
            if !step70 {
                break;
            }
            var step73 = sem_is(parent, "CoreStruct");
            if step73 {
                var step74 = sem_get(parent);
                var step75 = step74 != null;
                step73 = step75;
            }
            if step73 {
                var step76 = sem_member(parent, "name");
                var step77 = sem_identifier(c, step76);
                var step78 = sem_equal(text, step77);
                step73 = step78;
            }
            if step73 {
                var step79 = sem_get(parent);
                return &step79.type;
            }
            var step80 = sem_parent(parent);
            parent = step80;
        }
    }
    var bound: void* = generic_lookup(c.generics, n, n);
    if bound != null {
        var step83 = sem_get(bound);
        if step83.kind != KType() {
            sem_fail(c, n, "Expected a type, got a compile-time integer value");
        }
        var step85 = sem_get(bound);
        return &step85.type;
    }
    if sem_equal(text, "type") {
        sem_fail(c, n, "Type values currently require a template parameter or a type-constructor result");
        return invalid;
    }
    var found: void* = sem_resolve(c, c.types, n, text);
    if found == null {
        var step89 = sem_cat(c, "Unknown type '", text);
        var step90 = sem_cat(c, step89, "'");
        sem_fail(c, n, step90);
        return invalid;
    }
    var step91 = sem_get(found);
    return &step91.type;
}

fn sem_type_header(c: SemanticContext*, n: void*, name: u8*): void {
    var step1 = sem_shape(c, n, "name");
    var step3 = !step1;
    if !step3 {
        var step5 = sem_shape(c, n, "fields");
        var step6 = !step5;
        step3 = step6;
    }
    if step3 {
        return;
    }
    var t: FoundationNode* = sem_node(c, n, KType());
    if name[0] == 0 {
        var step9 = sem_member(n, "name");
        var step10 = sem_identifier(c, step9);
        name = step10;
    }
    sem_set_name(t, sem_output_name(c, n, name));
    var step12 = name[0] == 0;
    if !step12 {
        var step14 = sem_equal(name, "type");
        step12 = step14;
    }
    if !step12 {
        var step16 = sem_owned(c.types, sem_owner(c, n), name);
        var builtin_fallback = step16 == null;
        if builtin_fallback {
            step16 = sem_owned(c.types, null, name);
        }
        var step17 = step16 != null;
        step12 = step17;
    }
    if !step12 {
        var step19 = sem_owned(c.type_functions, sem_owner(c, n), name);
        var step20 = step19 != null;
        step12 = step20;
    }
    if step12 {
        var step21 = sem_cat(c, "Missing or duplicate type '", name);
        var step22 = sem_cat(c, step21, "'");
        sem_fail(c, n, step22);
        return;
    }
    // Names use the shared hash index; layouts use the iterative work graph.
    // The compilation node/storage budgets apply instead of a 256-type cap.
    var step24 = sem_type_new(c, SStruct(), 0, n);
    sem_set_type(&t.type, step24);
    sem_define(c, c.types, n, name);
    sem_push(&c.program.types, n);
}

fn sem_type_fields(c: SemanticContext*, n: void*): void {
    var state: SemanticEntry* = sem_state(c, c.fields_done, n);
    if state.number != 0 {
        return;
    }
    state.number = 1;
    var t: FoundationNode* = sem_get(n);
    var names: SemanticTable* = sem_table(c);
    var step5 = sem_member(n, "fields");
    var fields: vector(void*)* = sem_collect(c, step5, "CoreField");
    var i: usize = 0;
    for(; i < fields.length; i++) {
        var field: void* = fields.data[i];
        var step9 = sem_shape(c, field, "name");
        var step11 = !step9;
        if !step11 {
            var step13 = sem_shape(c, field, "type");
            var step14 = !step13;
            step11 = step14;
        }
        if step11 {
            return;
        }
        var f: FoundationNode* = sem_node(c, field, KFieldDeclaration());
        var step16 = sem_member(field, "name");
        var name: u8* = sem_identifier(c, step16);
        sem_set_name(f, name);
        var step18 = sem_member(field, "type");
        var step19 = sem_type(c, step18);
        sem_set_type(&f.type, step19);
        var step21 = name[0] == 0;
        if !step21 {
            var step23 = sem_put(c, names, name, field);
            var step24 = !step23;
            step21 = step24;
        }
        if step21 {
            var step25 = sem_cat(c, "Missing or duplicate field '", name);
            var step26 = sem_cat(c, step25, "'");
            sem_fail(c, field, step26);
        }
        var step28 = f.type.pointers == 0;
        if step28 {
            var step29 = f.type.scalar == SVoid();
            step28 = step29;
        }
        if step28 {
            sem_fail(c, field, "A field cannot have void type");
        }
        sem_push(&t.items, field);
    }
}

fn sem_round(size: usize, alignment: usize): usize {
    var step1 = size + alignment;
    var step2 = step1 -1;
    var step3 = step2 / alignment;
    return step3 *alignment;
}

fn sem_add_local(c: SemanticContext*, n: void*): void {
    var local: FoundationNode* = sem_get(n);
    var function: FoundationNode* = sem_get(c.current);
    if semantic_aggregate(&local.type) {
        sem_layout(c, local.type.record);
    }
    var alignment: usize = semantic_alignment(&local.type);
    local.index = function.locals.length;
    var step5 = sem_round(function.frame_size, alignment);
    local.byte_offset = step5;
    var step6 = semantic_size(&local.type);
    var step7 = local.byte_offset + step6;
    function.frame_size = step7;
    if function.frame_size > 4194304 {
        sem_fail(c, n, "Foundation local storage exceeds 4 MiB");
    }
    sem_push(&function.locals, n);
}

fn sem_lookup(c: SemanticContext*, n: void*): void* {
    if sem_editor_capture(c, n, 1, null) {
        return null;
    }
    var name: u8* = sem_identifier(c, n);
    var scope: SemanticScope* = c.scope;
    loop {
        var step2 = scope != null;
        if !step2 {
            break;
        }
        var found: void* = sem_lookup_table(scope.names, name);
        if found != null {
            if sem_declaration_type(c, found) {
                return found;
            }
            return null;
        }
        scope = scope.parent;
    }
    var found: void* = sem_resolve(c, c.globals, n, name);
    if found != null {
        if sem_declaration_type(c, found) {
            return found;
        }
        return null;
    }
    var step10 = sem_cat(c, "Unknown local '", name);
    var step11 = sem_cat(c, step10, "'");
    sem_fail(c, n, step11);
    return null;
}

fn sem_declaration_type(c: SemanticContext*, n: void*): bool {
    var value: FoundationNode* = sem_get(n);
    var state: SemanticEntry* = sem_state(c, c.declaration_state, n);
    var step4 = value.kind != KDeclare();
    if !step4 {
        var step6 = state.number == 2;
        step4 = step6;
    }
    if step4 {
        return true;
    }
    if state.number == 1 {
        var chain: u8* = "";
        var i: usize = 0;
        loop {
            var step9 = i < c.inferring.length;
            if step9 {
                var step10 = c.inferring.data[i] != n;
                step9 = step10;
            }
            if !step9 {
                break;
            }
            i++;
        }
        for(; i < c.inferring.length; i++) {
            var step14 = sem_get(c.inferring.data[i]);
            var step15 = sem_name(step14);
            var step16 = sem_cat(c, step15, " -> ");
            var step17 = sem_cat(c, chain, step16);
            chain = step17;
        }
        var step18 = sem_name(value);
        var step19 = sem_cat(c, "Cannot infer the type of '", step18);
        var step20 = sem_cat(c, step19, "': initializer dependency cycle ");
        var step21 = sem_name(value);
        var step22 = sem_cat(c, chain, step21);
        var step23 = sem_cat(c, step22, "; add an explicit type annotation");
        var step24 = sem_cat(c, step20, step23);
        sem_fail(c, n, step24);
        return false;
    }
    var annotation: void* = sem_member(n, "type");
    if annotation != null {
        var step27 = sem_type(c, annotation);
        sem_set_type(&value.type, step27);
    } else {
        var initial: void* = sem_member(n, "value");
        if initial == null {
            var step30 = sem_name(value);
            var step31 = sem_cat(c, "Variable '", step30);
            var step32 = sem_cat(c, step31, "' requires a type annotation or an initializer");
            sem_fail(c, n, step32);
            return false;
        }
        if c.inferring.length >= 128 {
            sem_fail(c, n, "Foundation inferred-type dependency limit is 128");
            return false;
        }
        state.number = 1;
        sem_push(&c.inferring, n);
        var step34 = sem_expression(c, initial, null);
        value.value = step34;
        c.inferring.length--;
        var step35 = sem_ok(c);
        var step37 = !step35;
        if !step37 {
            var step39 = value.value == null;
            step37 = step39;
        }
        if step37 {
            return false;
        }
        var step40 = sem_get(value.value);
        sem_set_type(&value.type, &step40.type);
        value.type.pointer_bytes = c.program.pointer_bytes;
    }
    var step42 = value.type.pointers == 0;
    if step42 {
        var step43 = value.type.scalar == SVoid();
        step42 = step43;
    }
    if step42 {
        sem_fail(c, n, "A variable cannot have void type");
    }
    var step44 = sem_ok(c);
    if !step44 {
        return false;
    }
    state.number = 2;
    return true;
}
