                im_values_set(m, im_key(call), value);
            }
        }
    }
}

fn im_call(m: IMState*, node: void*, offset: usize): void {
    var n = im_cached_node(m, node);
    var function = im_cached_node(m, n.binding);
    var small_args: u64[16];
    var args = &small_args[0];
    var heap_args = n.items.length > 16;
    if heap_args {
        args = alloc(u64, n.items.length);
    }
    var i: usize = 0;
    loop {
        var condition_98 = i == n.items.length;
        if condition_98 {
            break;
        }
        args[i] = im_read(m, n.items.data[i], offset);
        i = i + 1;
    }
    var condition_99 = im_ok(m) == false;
    if condition_99 {
        if heap_args {
            free(args);
        }
        return;
    }
    var condition_100 = function.external;
    if condition_100 {
        var condition_101 = im_has_foreign(m) == false;
        if condition_101 {
            im_missing_foreign(m, n.binding, offset);
            if heap_args {
                free(args);
            }
            return;
        }
        var result = im_foreign(m, n.binding, args, n.items.length);
        var condition_102 = im_ok(m);
        if condition_102 {
            im_values_set(m, im_key(node), result);
        }
        if heap_args {
            free(args);
        }
        return;
    }
    var size = im_align(function.frame_size);
    var base = m.stack;
    var remaining: usize = 4194304;
    remaining = remaining - base;
    var exhausted = m.frame_count >= 128;
    var test = size > remaining;
    exhausted = im_or(exhausted, test);
    var condition_103 = exhausted;
    if condition_103 {
        im_fail(m, "Tower call stack limit exceeded", offset);
        if heap_args {
            free(args);
        }
        return;
    }
    var end = base + size;
    m.stack = end;
    i = 0;
    loop {
        var condition_104 = i == n.items.length;
        if condition_104 {
            break;
        }
        var parameter = im_cached_node(m, function.parameters.data[i]);
        var at = base + parameter.byte_offset;
        interpreter_write(m, convert(u64, at), args[i], &parameter.type, offset);
        i = i + 1;
    }
    if heap_args {
        free(args);
    }
    im_frame_push(m, n.binding, base, offset, node);
    im_enter(m, function.body);
}

fn im_needs(m: IMState*, node: void*): bool {
    var condition_105 = node == null;
    if condition_105 {
        return false;
    }
    var found = false;
    var cached = im_sequenced_get(m, im_key(node), &found);
    var condition_106 = found;
    if condition_106 {
        var returned_184 = cached != 0;
        return returned_184;
    }
    var n = im_cached_node(m, node);
    var result = n.kind == KCall();
    var test = n.kind == KAllocate();
    result = im_or(result, test);
    test = n.kind == KReallocate();
    result = im_or(result, test);
    result = im_or(result, im_needs(m, n.left));
    result = im_or(result, im_needs(m, n.right));
    result = im_or(result, im_needs(m, n.value));
    result = im_or(result, im_needs(m, n.target));
    im_sequenced_set(m, im_key(node), convert(u64, result));
    return result;
}

fn im_queue(m: IMState*, node: void*, phase: usize, offset: usize): void {
    var condition_107 = node != null;
    if condition_107 {
        im_task_push(m, node, false, phase, offset);
    }
}

export fn interpreter_init(m: IMState*): void {
    var condition_108 = m.done;
    if condition_108 {
        return;
    }
    var allocated = im_memory_resize(m, 4194304);
    if allocated {} else {
        im_fail(m, "Cannot allocate interpreter memory", 0);
        m.done = true;
        return;
    }
    var root = im_root(m);
    var n = im_cached_node(m, root);
    var base = m.stack;
    var size = im_align(n.frame_size);
    var end = base + size;
    m.stack = end;
    var condition_109 = end > 4194304;
    if condition_109 {
        im_fail(m, "Tower interpreter stack exhausted", 0);
        m.done = true;
        return;
    }
    im_frame_push(m, root, base, 0, null);
    im_enter(m, root);
}

// Output formatting is execution behavior; only appending bytes crosses the ABI.
fn im_print(m: IMState*, node: void*, offset: usize): void {
    var value = im_read(m, node, offset);
    var condition_110 = im_ok(m) == false;
    if condition_110 {
        return;
    }
    var n = im_cached_node(m, node);
    im_print_value(m, value, &n.type);
}

fn im_print_value(m: IMState*, value: u64, type: FoundationType*): void {
    var text: u8[80];
    var length: usize = 0;
    var condition_111 = type.pointers != 0;
    if condition_111 {
        text[0] = 48;
        text[1] = 120;
        length = 2;
        var digits = im_pointer_bytes(m) * 2;
        var hex = "0123456789abcdef";
        loop {
            var condition_112 = digits == 0;
            if condition_112 {
                break;
            }
            digits = digits - 1;
            var exponent = digits * 4;
            var digit = value / im_power(exponent);
            digit = digit & 15;
            text[length] = hex[convert(usize, digit)];
            length = length + 1;
        }
    } else {
        var condition_113 = type.scalar == SBool();
        if condition_113 {
            var condition_114 = value != 0;
            if condition_114 {
                copy(&text[0], "true", 4);
                length = 4;
            } else {
                copy(&text[0], "false", 5);
                length = 5;
            }
        } else {
            var mask = im_type_mask(type);
            value = value & mask;
            var condition_115 = im_type_signed(type);
            if condition_115 {
                var high = mask / 2;
                high = high + 1;
                var sign = value & high;
                var condition_116 = sign != 0;
                if condition_116 {
                    text[0] = 45;
                    length = 1;
                    value = 0 - value;
                    value = value & mask;
                }
            }
            var reversed: u8[24];
            var count: usize = 0;
            loop {
                var digit = value % 10;
                digit = digit + 48;
                reversed[count] = im_byte(digit);
                count = count + 1;
                value = value / 10;
                var condition_117 = value == 0;
                if condition_117 {
                    break;
                }
            }
            loop {
                var condition_118 = count == 0;
                if condition_118 {
                    break;
                }
                count = count - 1;
                text[length] = reversed[count];
                length = length + 1;
            }
        }
    }
    text[length] = 10;
    length = length + 1;
    var total = m.output_bytes + length;
    var condition_119 = total <= 65536;
    if condition_119 {
        im_append(m, &text[0], length);
    } else {
        m.output_truncated = true;
    }
}

export fn interpreter_step(m: IMState*, budget: usize): void {
    var condition_120 = m.done;
    if condition_120 {
        return;
    }
    var count: usize = 0;
    loop {
        var condition_121 = count == budget;
        if condition_121 {
            break;
        }
        var condition_122 = m.frame_count == 0;
        if condition_122 {
            break;
        }
        var condition_123 = im_ok(m) == false;
        if condition_123 {
            break;
        }
        count = count + 1;
        var steps = m.steps + 1;
        m.steps = steps;
        var condition_124 = m.task_count == 0;
        if condition_124 {
            im_returned(m, 0);
            continue;
        }
        var task: IMTask;
        im_task_pop(m, &task);
        // Ordinary statements clear both caches before evaluation. Only suspended
        // expression tasks can observe cached values or captured addresses.
        m.cached = task.phase != 0;
        var n = im_cached_node(m, task.node);
        var offset = task.offset;
        var condition_125 = task.phase == 0;
        if condition_125 {
            offset = n.start;
        }
        var condition_126 = task.phase == 0;
        if condition_126 {
            im_cache_clear(m);
            var condition_127 = im_needs(m, task.node);
            if condition_127 {
                var resume = task.loop_resume != 0;
                im_task_push(m, task.node, resume, 1, n.start);
                var assign = n.kind == KDeclare();
                var test = n.kind == KAssign();
                assign = im_or(assign, test);
                var unary = n.kind == KPrint();
                test = n.kind == KReturn();
                unary = im_or(unary, test);
                test = n.kind == KIf();
                unary = im_or(unary, test);
                var memory = n.kind == KCopy();
                var trapping = n.kind == KTrap();
                memory = im_or(memory, trapping);
                test = n.kind == KFill();
                memory = im_or(memory, test);
                var condition_128 = assign;
                if condition_128 {
                    im_queue(m, n.value, 2, offset);
                    var target = n.target;
                    var condition_129 = n.kind == KDeclare();
                    if condition_129 {
                        target = task.node;
                    }
                    im_queue(m, target, 3, offset);
                } else {
                    var condition_130 = unary;
                    if condition_130 {
                        im_queue(m, n.value, 2, offset);
                    }
                    else {
                        var condition_131 = n.kind == KFree();
                        if condition_131 {
                            im_queue(m, n.left, 2, offset);
                        }
                        else {
                            var condition_132 = memory;
                            if condition_132 {
                                im_queue(m, n.value, 2, offset);
                                im_queue(m, n.right, 2, offset);
                                im_queue(m, n.left, 2, offset);
                            }
                            else {
                                im_queue(m, task.node, 2, offset);
                            }
                        }
                    }
                }
                continue;
            }
        } else {
            var condition_133 = task.phase == 2;
            if condition_133 {
                var found = false;
                im_values_get(m, im_key(task.node), &found);
                var condition_134 = found;
                if condition_134 {
                    continue;
                }
                im_queue(m, task.node, 4, offset);
                var condition_135 = n.kind == KCall();
                if condition_135 {
                    var i = n.items.length;
                    loop {
                        var condition_136 = i == 0;
                        if condition_136 {
                            break;
                        }
                        i = i - 1;
                        im_queue(m, n.items.data[i], 2, offset);
                    }
                } else {
                    var condition_137 = n.kind == KAddress();
                    if condition_137 {
                        im_queue(m, n.value, 3, offset);
                    }
                    else {
                        var place = n.kind == KField();
                        var test = n.kind == KIndex();
                        place = im_or(place, test);
                        var condition_138 = n.kind == KOperand();
                        if condition_138 {
                            var condition_139 = n.constant == false;
                            if condition_139 {
                                place = true;
                            }
                        }
                        var condition_140 = place;
                        if condition_140 {
                            im_queue(m, task.node, 3, offset);
                        }
                        else {
                            im_queue(m, n.value, 2, offset);
                            im_queue(m, n.right, 2, offset);
                            im_queue(m, n.left, 2, offset);
                        }
                    }
                }
                continue;
            } else {
                var condition_141 = task.phase == 3;
                if condition_141 {
                    var found = false;
                    im_addresses_get(m, im_key(task.node), &found);
                    var condition_142 = found;
                    if condition_142 {
                        continue;
                    }
                    im_queue(m, task.node, 5, offset);
                    var condition_143 = n.kind == KLoad();
                    if condition_143 {
                        im_queue(m, n.value, 2, offset);
                    }
                    else {
                        var place = n.kind == KField();
                        var test = n.kind == KIndex();
                        place = im_or(place, test);
                        var condition_144 = place;
                        if condition_144 {
                            var condition_145 = n.kind == KIndex();
                            if condition_145 {
                                im_queue(m, n.right, 2, offset);
                            }
                            var phase: usize = 3;
                            var condition_146 = n.indirect;
                            if condition_146 {
                                phase = 2;
                            }
                            im_queue(m, n.left, phase, offset);
                        }
                    }
                    continue;
                } else {
                    var condition_147 = task.phase == 5;
                    if condition_147 {
                        var address = im_address(m, task.node, task.offset);
                        im_addresses_set(m, im_key(task.node), address);
                        continue;
                    } else {
                        var condition_148 = task.phase == 4;
                        if condition_148 {
                            var condition_149 = n.kind == KCall();
                            if condition_149 {
                                im_call(m, task.node, task.offset);
                            }
                            else {
                                // Value tasks already checked this node's cache before scheduling
                                // FinishValue; completing its children cannot evaluate the parent.
                                var result = im_evaluate_uncached(m, task.node, n, task.offset);
                                im_values_set(m, im_key(task.node), result);
                            }
                            continue;
                        }
                    }
                }
            }
        }
        im_statement(m, &task, n);
    }
    var done = im_ok(m) == false;
    var empty = m.frame_count == 0;
    done = im_or(done, empty);
    m.done = done;
}

fn im_statement(m: IMState*, task: IMTask*, n: FoundationNode*): void {
    var condition_150 = n.kind == KBlock();
    if condition_150 {
        im_enter(m, task.node);
        return;
    }
    var condition_151 = n.kind == KDeclare();
    if condition_151 {
        var condition_152 = n.value != null;
        if condition_152 {
            im_store(m, task.node, im_evaluate(m, n.value, n.start), n.start);
        }
        return;
    }
    var condition_153 = n.kind == KAssign();
    if condition_153 {
        im_store(m, n.target, im_evaluate(m, n.value, n.start), n.start);
        return;
    }
    var condition_154 = n.kind == KFree();
    if condition_154 {
        interpreter_deallocate(m, im_read(m, n.left, n.start));
        return;
    }
    var memory = n.kind == KCopy();
    var test = n.kind == KFill();
    memory = im_or(memory, test);
    var condition_155 = memory;
    if condition_155 {
        var dest = im_read(m, n.left, n.start);
        var source = im_read(m, n.right, n.start);
        var size = im_read(m, n.value, n.start);
        var fm_condition_0 = n.kind == KCopy();

        im_copy_values(m, dest, source, size, fm_condition_0, n.start);
        return;
    }
    var condition_160 = n.kind == KCall();
    if condition_160 {
        return;
    }
    var expression = n.kind == KAllocate();
    test = n.kind == KReallocate();
    expression = im_or(expression, test);
    test = n.kind == KSizeOf();
    expression = im_or(expression, test);
    test = n.kind == KAlignOf();
    expression = im_or(expression, test);
    test = n.kind == KConvert();
    expression = im_or(expression, test);
    test = n.kind == KBits();
    expression = im_or(expression, test);
    var condition_161 = expression;
    if condition_161 {
        im_evaluate(m, task.node, n.start);
        return;
    }
    var condition_162 = n.kind == KReturn();
    if condition_162 {
        var result: u64 = 0;
        var condition_163 = n.value != null;
        if condition_163 {
            result = im_read(m, n.value, n.start);
        }
        im_returned(m, result);
        return;
    }
    var condition_164 = n.kind == KIf();
    if condition_164 {
        var condition = im_read(m, n.value, n.start);
        var condition_165 = condition != 0;
        if condition_165 {
            im_enter(m, n.body);
        } else {
            var condition_166 = n.otherwise != null;
            if condition_166 {
                im_enter(m, n.otherwise);
            }
        }
        return;
    }
    var condition_167 = n.kind == KLoop();
    if condition_167 {
        im_task_push(m, task.node, true, 0, 0);
        im_enter(m, n.body);
        return;
    }
    var jump = n.kind == KBreak();
    test = n.kind == KContinue();
    jump = im_or(jump, test);
    var condition_168 = jump;
    if condition_168 {
        loop {
            var condition_169 = m.task_count == 0;
            if condition_169 {
                break;
            }
            var at: IMTask;
            im_task_pop(m, &at);
            var condition_170 = at.loop_resume != 0;
            if condition_170 {
                var condition_171 = n.kind == KContinue();
                if condition_171 {
                    im_task_push(m, at.node, true, at.phase, at.offset);
                }
                break;
            }
        }
        return;
    }
    var condition_172 = n.kind == KPrint();
    if condition_172 {
        im_print(m, n.value, n.start);
        return;
    }
    var trapping = n.kind == KTrap();
    if trapping {
        var message = im_read(m, n.left, n.start);
        var offset = im_read(m, n.right, n.start);
        im_raise(m, message, offset);
        return;
    }
    var label = n.kind == KLabel();
    if label {
        return;
    }
    var explicit_jump = n.kind == KJump();
    if explicit_jump {
        var discard: IMTask;
        loop {
            var empty = m.task_count == 0;
            if empty {
                break;
            }
            im_task_pop(m, &discard);
        }
        var destination = im_cached_node(m, n.binding);
        var body = im_cached_node(m, destination.body);
        var i = body.items.length;
        var begin = destination.index + 1;
        loop {
            var end = i == begin;
            if end {
                break;
            }
            i = i - 1;
            im_task_push(m, body.items.data[i], false, 0, 0);
        }
        return;
    }
    im_fail(m, "Invalid foundation statement", n.start);
}

fn im_raise(m: IMState*, message: u64, offset: u64): void {
    var at = convert(usize, offset);
    var bytes = interpreter_bytes(m, message, 1, at);
    var failed = bytes == null;
    if failed {
        return;
    }
    var empty_message = bytes[0] == 0;
    if empty_message {
        im_fail(m, "Tower trap", at);
        return;
    }
    var available = im_memory_size(m) - convert(usize, message);
    var i: usize = 0;
    loop {
        var end = i == available;
        if end {
            im_fail(m, "Unterminated trap message", at);
            return;
        }
        end = bytes[i] == 0;
        if end {
            im_fail(m, bytes, at);
            return;
        }
        i = i + 1;
    }
}

fn im_copy_values(m: IMState*, dest: u64, source: u64, size: u64, copying: bool, offset: usize): void {
    var limit = convert(u64, im_host_max());
    var condition_156 = size > limit;
    if condition_156 {
        im_fail(m, "Memory operation exceeds interpreter address space", offset);
        return;
    }
    var count = convert(usize, size);
    var p = interpreter_bytes(m, dest, count, offset);
    var q: u8* = null;
    var condition_157 = copying;
    if condition_157 {
        q = interpreter_bytes(m, source, count, offset);
    }
    var condition_158 = im_ok(m);
    if condition_158 {
        var condition_159 = q != null;
        if condition_159 {
            copy(p, q, count);
        } else {
            fill(p, im_byte(source), count);
        }
    }
}
