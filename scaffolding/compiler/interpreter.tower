import interpreter_types;
import tower;
import foundation_tags;
import foundation_types;
import interpreter_abi;
import interpreter_storage;

fn im_ok(m: IMState*): bool {
    var ok = !m.failed;
    return ok;
}

fn im_or(a: bool, b: bool): bool {
    if a {
        return true;
    }
    return b;
}

fn im_and(a: bool, b: bool): bool {
    if a {
        return b;
    }
    return false;
}

fn im_host_max(): usize {
    var result: usize = 0;
    result--;
    return result;
}

fn im_align_mask(): usize {
    var result: usize = 0;
    result = result - 16;
    return result;
}

fn im_byte(value: u64): u8 {
    value = value & 255;
    return convert(u8, value);
}

// Execution over the original shared foundation entities. Caches below are
// per-statement results and scheduling indexes, never a second program model.
fn im_key(node: void*): u64 {
    return convert(u64, bits(usize, node));
}

fn im_align(n: usize): usize {
    var v = n + 15;
    return v &im_align_mask();
}

fn im_power(n: usize): u64 {
    var result: u64 = 1;
    loop {
        if n == 0 {
            return result;
        }
        result = result * 2;
        n--;
    }
}

fn im_sign(value: u64, type: FoundationType*): i64 {
    return im_sign_mask(value, im_type_mask(type));
}

fn im_sign_mask(value: u64, mask: u64): i64 {
    var high = mask / 2;
    high++;
    var sign = value &high;
    if sign != 0 {
        value |= ~mask;
    }
    return bits(i64, value);
}

export fn interpreter_bytes(m: IMState*, address: u64, count: usize, offset: usize): u8* {
    var size = convert(u64, im_memory_size(m));
    if address > size {
        im_fail(m, "Address outside interpreter memory", offset);
        return null;
    }
    var remaining = size -address;
    if convert(u64, count) > remaining {
        im_fail(m, "Address outside interpreter memory", offset);
        return null;
    }
    var at = convert(usize, address);
    var memory = im_memory(m);
    return &memory[at];
}

export fn interpreter_load(m: IMState*, address: u64, type: FoundationType*, offset: usize): u64 {
    return im_load_size(m, address, im_type_size(type), offset);
}

// Explicit little-endian byte semantics, including unaligned guest addresses.
// Fixed-width paths let LLVM combine loads without inheriting host endianness.
fn im_load_size(m: IMState*, address: u64, size: usize, offset: usize): u64 {
    var p = interpreter_bytes(m, address, size, offset);
    if p == null {
        return 0;
    }
    if size == 1 {
        return convert(u64, p[0]);
    }
    var lo = convert(u64, p[0]);
    var lo_1 = convert(u64, p[1]);
    lo_1 = lo_1 * 256;
    lo = lo | lo_1;
    var lo_2 = convert(u64, p[2]);
    lo_2 = lo_2 * 65536;
    lo = lo | lo_2;
    var lo_3 = convert(u64, p[3]);
    lo_3 = lo_3 * 16777216;
    lo = lo | lo_3;
    if size == 4 {
        return lo;
    }
    var hi = convert(u64, p[4]);
    var hi_1 = convert(u64, p[5]);
    hi_1 = hi_1 * 256;
    hi = hi | hi_1;
    var hi_2 = convert(u64, p[6]);
    hi_2 = hi_2 * 65536;
    hi = hi | hi_2;
    var hi_3 = convert(u64, p[7]);
    hi_3 = hi_3 * 16777216;
    hi = hi | hi_3;
    hi = hi * 4294967296;
    var result = lo | hi;
    return result;
}

export fn interpreter_write(m: IMState*, address: u64, value: u64, type: FoundationType*, offset: usize): void {
    im_write_size(m, address, value, im_type_size(type), offset);
}

fn im_write_size(m: IMState*, address: u64, value: u64, size: usize, offset: usize): void {
    var p = interpreter_bytes(m, address, size, offset);
    if p == null {
        return;
    }
    p[0] = im_byte(value);
    if size == 1 {
        return;
    }
    value = value / 256;
    p[1] = im_byte(value);
    value = value / 256;
    p[2] = im_byte(value);
    value = value / 256;
    p[3] = im_byte(value);
    if size == 4 {
        return;
    }
    value = value / 256;
    p[4] = im_byte(value);
    value = value / 256;
    p[5] = im_byte(value);
    value = value / 256;
    p[6] = im_byte(value);
    value = value / 256;
    p[7] = im_byte(value);
}

export fn interpreter_allocate(m: IMState*, count: usize): u64 {
    if count > 268435456 {
        return 0;
    }
    if count == 0 {
        count = 1;
    }
    count = im_align(count);
    var available: u64 = 0;
    var at = im_free_first(m, &available);
    loop {
        if at == 0 {
            break;
        }
        if available >= convert(u64, count) {
            im_free_blocks_erase(m, at);
            if available > convert(u64, count) {
                var tail = at + convert(u64, count);
                var rest = available -convert(u64, count);
                im_free_blocks_set(m, tail, rest);
            }
            im_allocations_set(m, at, convert(u64, count));
            return at;
        }
        var next = at + 1;
        at = im_free_neighbor(m, next, false, &available);
    }
    var heap = m.heap;
    var remaining: usize = 268435456;
    remaining = remaining - heap;
    if count > remaining {
        return 0;
    }
    var end = heap + count;
    if !im_memory_resize(m, end) {
        return 0;
    }
    m.heap = end;
    at = convert(u64, heap);
    im_allocations_set(m, at, convert(u64, count));
    return at;
}

export fn interpreter_deallocate(m: IMState*, at: u64): void {
    if at == 0 {
        return;
    }
    var found = false;
    var count = im_allocations_take(m, at, &found);
    if !found {
        im_fail(m, "Invalid allocation passed to free", 0);
        return;
    }
    var neighbors: IMNeighbors;
    im_free_neighbors(m, at, &neighbors);
    var available = neighbors.next_count;
    var next = neighbors.next;
    var end = at + count;
    if next != 0 {
        if end == next {
            count = count + available;
            im_free_blocks_erase(m, next);
        }
    }
    var prev = neighbors.previous;
    available = neighbors.previous_count;
    if prev != 0 {
        end = prev + available;
        if end == at {
            at = prev;
            count = count + available;
            im_free_blocks_erase(m, prev);
        }
    }
    im_free_blocks_set(m, at, count);
}

export fn interpreter_reallocate(m: IMState*, at: u64, count: usize): u64 {
    if at == 0 {
        return interpreter_allocate(m, count);
    }
    if count == 0 {
        interpreter_deallocate(m, at);
        return 0;
    }
    var found = false;
    var previous = im_allocations_get(m, at, &found);
    if !found {
        im_fail(m, "Invalid allocation passed to realloc", 0);
        return 0;
    }
    if convert(u64, count) <= previous {
        return at;
    }
    var result = interpreter_allocate(m, count);
    if result == 0 {
        return 0;
    }
    var memory = im_memory(m);
    var to = convert(usize, result);
    var from = convert(usize, at);
    copy(&memory[to], &memory[from], convert(usize, previous));
    interpreter_deallocate(m, at);
    return result;
}

fn im_read(m: IMState*, node: void*, offset: usize): u64 {
    var found = false;
    var cached: u64 = 0;
    if m.cached {
        cached = im_values_get(m, im_key(node), &found);
        if found {
            return cached;
        }
    }
    return im_read_uncached(m, node, im_cached_node(m, node), offset);
}

fn im_read_uncached(m: IMState*, node: void*, n: FoundationNode*, offset: usize): u64 {
    var found = false;
    var cached: u64 = 0;
    if n.kind == KAddress() {
        return im_address(m, n.value, offset);
    }
    var direct = n.kind == KOperand();
    var test = n.kind == KString();
    direct = im_or(direct, test);
    test = n.kind == KField();
    direct = im_or(direct, test);
    test = n.kind == KIndex();
    direct = im_or(direct, test);
    if !direct {
        return im_evaluate(m, node, offset);
    }
    if n.kind == KString() {
        cached = im_strings_get(m, im_key(node), &found);
        if found {
            return cached;
        }
        var count = n.name.length + 1;
        var at = interpreter_allocate(m, count);
        if at == 0 {
            im_fail(m, "String allocation failed", offset);
            return 0;
        }
        var memory = im_memory(m);
        var index = convert(usize, at);
        if n.name.length != 0 {
            copy(&memory[index], n.name.data, n.name.length);
        }
        var terminator = index + n.name.length;
        memory[terminator] = 0;
        im_strings_set(m, im_key(node), at);
        return at;
    }
    if n.constant {
        return n.bits;
    }
    var address = im_address_component(m, node, n, offset);
    if im_ok(m) {
        return interpreter_load(m, address, &n.type, offset);
    }
    return 0;
}

fn im_address(m: IMState*, node: void*, offset: usize): u64 {
    var found = false;
    if m.cached {
        var cached = im_addresses_get(m, im_key(node), &found);
        if found {
            return cached;
        }
    }
    return im_address_uncached(m, node, im_cached_node(m, node), offset);
}

fn im_address_component(m: IMState*, node: void*, n: FoundationNode*, offset: usize): u64 {
    var found = false;
    var cached: u64 = 0;
    if m.cached {
        cached = im_addresses_get(m, im_key(node), &found);
        if found {
            return cached;
        }
    }
    return im_address_uncached(m, node, n, offset);
}

fn im_address_uncached(m: IMState*, node: void*, n: FoundationNode*, offset: usize): u64 {
    if n.kind == KLoad() {
        return im_read(m, n.value, offset);
    }
    var place = n.kind == KField();
    var test = n.kind == KIndex();
    place = im_or(place, test);
    if place {
        var pointer: u64 = 0;
        if n.indirect {
            pointer = im_read(m, n.left, offset);
        } else {
            pointer = im_address(m, n.left, offset);
        }
        if n.kind == KField() {
            pointer = pointer + convert(u64, n.byte_offset);
        }
        else {
            var index = im_read(m, n.right, offset);
            var right = im_cached_node(m, n.right);
            if im_type_signed(&right.type) {
                index = bits(u64, im_sign(index, &right.type));
            }
            var delta = index *convert(u64, im_type_size(&n.type));
            pointer = pointer + delta;
        }
        if im_pointer_bytes(m) == 4 {
            pointer = pointer & 4294967295;
        }
        return pointer;
    }
    var binding = n;
    if n.binding != null {
        binding = im_cached_node(m, n.binding);
    }
    var base: u64 = 16;
    if !binding.global {
        base = convert(u64, im_base(m));
    }
    return base + convert(u64, binding.byte_offset);
}

fn im_evaluate(m: IMState*, node: void*, offset: usize): u64 {
    var found = false;
    var cached: u64 = 0;
    if m.cached {
        cached = im_values_get(m, im_key(node), &found);
        if found {
            return cached;
        }
    }
    var n = im_cached_node(m, node);
    return im_evaluate_uncached(m, node, n, offset);
}

fn im_evaluate_uncached(m: IMState*, node: void*, n: FoundationNode*, offset: usize): u64 {
    if n.kind == KCall() {
        im_fail(m, "Missing suspended call result", offset);
        return 0;
    }
    var direct = n.kind == KOperand();
    var test = n.kind == KString();
    direct = im_or(direct, test);
    test = n.kind == KField();
    direct = im_or(direct, test);
    test = n.kind == KIndex();
    direct = im_or(direct, test);
    test = n.kind == KAddress();
    direct = im_or(direct, test);
    if direct {
        return im_read_uncached(m, node, n, offset);
    }
    if n.kind == KSizeOf() {
        return convert(u64, im_type_size(&n.element));
    }
    if n.kind == KAlignOf() {
        return convert(u64, im_type_alignment(&n.element));
    }
    var allocation = n.kind == KAllocate();
    test = n.kind == KReallocate();
    allocation = im_or(allocation, test);
    if allocation {
        var p: u64 = 0;
        if n.left != null {
            p = im_read(m, n.left, offset);
        }
        var count = im_read(m, n.right, offset);
        var size = convert(u64, im_type_size(&n.element));
        var limit: u64 = 18446744073709551615;
        if im_pointer_bytes(m) == 4 {
            limit = 4294967295;
        }
        limit = limit / size;
        if count > limit {
            return 0;
        }
        var host_limit = im_host_max();
        limit = convert(u64, host_limit);
        limit = limit / size;
        if count > limit {
            return 0;
        }
        count = count * size;
        if n.kind == KAllocate() {
            return interpreter_allocate(m, convert(usize, count));
        }
        return interpreter_reallocate(m, p, convert(usize, count));
    }
    var input_node = n.value;
    if n.kind == KBinary() {
        input_node = n.left;
    }
    var a = im_evaluate(m, input_node, offset);
    var result = a;
    if im_ok(m) == false {
        return result;
    }
    if n.kind == KLoad() {
        return interpreter_load(m, a, &n.type, offset);
    }
    if n.kind == KConvert() {
        var input = im_cached_node(m, n.value);
        result = im_convert_value(m, a, &input.type, &n.type, offset);
    } else {
        if n.kind == KBinary() {
            result = im_binary(m, n, a, offset);
        }
    }
    return result &im_type_mask(&n.type);
}

fn im_convert_value(m: IMState*, a: u64, input: FoundationType*, type: FoundationType*, offset: usize): u64 {
    if type.scalar == SBool() {
        var nonzero = a != 0;
        return convert(u64, nonzero);
    }
    var result = a;
    var mask = im_type_mask(input);
    var high = mask / 2;
    high++;
    var sign = a &high;
    var negative = sign != 0;
    negative = im_and(negative, im_type_signed(input));
    var magnitude = a;
    if negative {
        magnitude = 0 - a;
        magnitude = magnitude & mask;
    }
    var limit = im_type_mask(type);
    if im_type_signed(type) {
        limit = limit / 2;
        if negative {
            limit++;
        }
    }
    var invalid = im_type_signed(type) == false;
    invalid = im_and(invalid, negative);
    var test = magnitude > limit;
    invalid = im_or(invalid, test);
    if invalid {
        im_fail(m, "Numeric conversion out of range; use bits for bit reinterpretation", offset);
    }
    result = magnitude;
    if negative {
        result = 0 - magnitude;
    }
    return result;
}

fn im_binary(m: IMState*, n: FoundationNode*, x: u64, offset: usize): u64 {
    var y = im_evaluate(m, n.right, offset);
    var input = im_cached_node(m, n.left);
    var right_type = &input.type;
    if input.type.pointers != 0 {
        var right = im_cached_node(m, n.right);
        right_type = &right.type;
    }
    return im_binary_values(m, n.op, x, y, &input.type, right_type, offset);
}

fn im_binary_values(m: IMState*, op: u32, x: u64, y: u64, type: FoundationType*, right_type: FoundationType*, offset: usize): u64 {
    var arithmetic = op == OAdd();
    var test = op == OSub();
    arithmetic = im_or(arithmetic, test);
    if type.pointers != 0 {
        if arithmetic {
            if im_type_signed(right_type) {
                y = bits(u64, im_sign(y, right_type));
            }
            y = y * convert(u64, im_pointee_size(type));
        }
    }
    return im_binary_scalar(m, op, x, y, im_type_mask(type), im_type_signed(type), offset);
}

// Shared scalar semantics for graph evaluation and compact instruction dispatch.
fn im_binary_scalar(m: IMState*, op: u32, x: u64, y: u64, mask: u64, signed: bool, offset: usize): u64 {
    if op == OAdd() {
        return x + y;
    }
    if op == OSub() {
        return x -y;
    }
    if op == OMul() {
        return x *y;
    }
    var division = op == ODiv();
    var test = op == ORem();
    division = im_or(division, test);
    if division {
        if y == 0 {
            im_fail(m, "Division by zero", offset);
            return x;
        }
        if signed {
            var high = mask / 2;
            high++;
            if x == high {
                if y == mask {
                    im_fail(m, "Signed division overflow", offset);
                    return x;
                }
            }
            var sx = im_sign_mask(x, mask);
            var sy = im_sign_mask(y, mask);
            var signed_result: i64 = 0;
            if op == ODiv() {
                signed_result = sx / sy;
            } else {
                signed_result = sx % sy;
            }
            return bits(u64, signed_result);
        }
        if op == ODiv() {
            return x / y;
        }
        return x % y;
    }
    if op == OAnd() {
        return x &y;
    }
    if op == OOr() {
        return x | y;
    }
    if op == OXor() {
        return x ^ y;
    }
    var result = false;
    if op == OEq() {
        result = x == y;
    }
    if op == ONe() {
        result = x != y;
    }
    if signed {
        var sx = im_sign_mask(x, mask);
        var sy = im_sign_mask(y, mask);
        if op == OLt() {
            result = sx < sy;
        }
        if op == OLe() {
            result = sx <= sy;
        }
        if op == OGt() {
            result = sx > sy;
        }
        if op == OGe() {
            result = sx >= sy;
        }
    } else {
        if op == OLt() {
            result = x < y;
        }
        if op == OLe() {
            result = x <= y;
        }
        if op == OGt() {
            result = x > y;
        }
        if op == OGe() {
            result = x >= y;
        }
    }
    return convert(u64, result);
}

fn im_store(m: IMState*, target: void*, value: u64, offset: usize): void {
    if im_ok(m) == false {
        return;
    }
    var at = im_address(m, target, offset);
    var n = im_cached_node(m, target);
    if im_ok(m) {
        interpreter_write(m, at, value, &n.type, offset);
    }
}

fn im_enter(m: IMState*, node: void*): void {
    var n = im_cached_node(m, node);
    var i = n.items.length;
    loop {
        if i == 0 {
            break;
        }
        i--;
        var child = n.items.data[i];
        var c = im_cached_node(m, child);
        var omitted = c.kind == KFunction();
        var test = c.kind == KType();
        omitted = im_or(omitted, test);
        if !omitted {
            im_task_push(m, child, false, 0, 0);
        }
    }
}

fn im_returned(m: IMState*, value: u64): void {
    var call = im_frame_call(m);
    m.stack = im_base(m);
    im_frame_pop(m);
    if m.frame_count != 0 {
        if call != null {
            if im_ok(m) {
                im_values_set(m, im_key(call), value);
            }
        }
    }
}

fn im_call(m: IMState*, node: void*, offset: usize): void {
    var n = im_cached_node(m, node);
    var function = im_cached_node(m, n.binding);
    var base: usize = 0;
    {
        var small_args: u64[16];
        var args = &small_args[0];
        var heap_args = n.items.length > 16;
        if heap_args {
            args = alloc(u64, n.items.length);
        }
        defer {
            if heap_args {
                free(args);
            }
        }
        var i: usize = 0;
        loop {
            if i == n.items.length {
                break;
            }
            args[i] = im_read(m, n.items.data[i], offset);
            i++;
        }
        if im_ok(m) == false {
            return;
        }
        if function.external {
            if im_has_foreign(m) == false {
                im_missing_foreign(m, n.binding, offset);
                return;
            }
            var result = im_foreign(m, n.binding, args, n.items.length);
            if im_ok(m) {
                im_values_set(m, im_key(node), result);
            }
            return;
        }
        var size = im_align(function.frame_size);
        base = m.stack;
        var remaining: usize = 4194304;
        remaining = remaining - base;
        var exhausted = m.frame_count >= 128;
        var test = size > remaining;
        exhausted = im_or(exhausted, test);
        if exhausted {
            im_fail(m, "Tower call stack limit exceeded", offset);
            return;
        }
        var end = base + size;
        m.stack = end;
        i = 0;
        loop {
            if i == n.items.length {
                break;
            }
            var parameter = im_cached_node(m, function.parameters.data[i]);
            var at = base + parameter.byte_offset;
            interpreter_write(m, convert(u64, at), args[i], &parameter.type, offset);
            i++;
        }
    }
    im_frame_push(m, n.binding, base, offset, node);
    im_enter(m, function.body);
}

fn im_needs(m: IMState*, node: void*): bool {
    if node == null {
        return false;
    }
    var found = false;
    var cached = im_sequenced_get(m, im_key(node), &found);
    if found {
        return cached != 0;
    }
    var n = im_cached_node(m, node);
    var result = n.kind == KCall();
    var test = n.kind == KAllocate();
    result = im_or(result, test);
    test = n.kind == KReallocate();
    result = im_or(result, test);
    result = im_or(result, im_needs(m, n.left));
    result = im_or(result, im_needs(m, n.right));
    result = im_or(result, im_needs(m, n.value));
    result = im_or(result, im_needs(m, n.target));
    im_sequenced_set(m, im_key(node), convert(u64, result));
    return result;
}

fn im_queue(m: IMState*, node: void*, phase: usize, offset: usize): void {
    if node != null {
        im_task_push(m, node, false, phase, offset);
    }
}

export fn interpreter_init(m: IMState*): void {
    if m.done {
        return;
    }
    if !im_memory_resize(m, 4194304) {
        im_fail(m, "Cannot allocate interpreter memory", 0);
        m.done = true;
        return;
    }
    var root = im_root(m);
    var n = im_cached_node(m, root);
    var base = m.stack;
    var size = im_align(n.frame_size);
    var end = base + size;
    m.stack = end;
    if end > 4194304 {
        im_fail(m, "Tower interpreter stack exhausted", 0);
        m.done = true;
        return;
    }
    im_frame_push(m, root, base, 0, null);
    im_enter(m, root);
}

// Output formatting is execution behavior; only appending bytes crosses the ABI.
fn im_print(m: IMState*, node: void*, offset: usize): void {
    var value = im_read(m, node, offset);
    if im_ok(m) == false {
        return;
    }
    var n = im_cached_node(m, node);
    im_print_value(m, value, &n.type);
}

fn im_print_value(m: IMState*, value: u64, type: FoundationType*): void {
    var text: u8[80];
    var length: usize = 0;
    if type.pointers != 0 {
        text[0] = 48;
        text[1] = 120;
        length = 2;
        var digits = im_pointer_bytes(m) *2;
        var hex = "0123456789abcdef";
        loop {
            if digits == 0 {
                break;
            }
            digits--;
            var exponent = digits *4;
            var digit = value / im_power(exponent);
            digit = digit & 15;
            text[length] = hex[convert(usize, digit)];
            length++;
        }
    } else {
        if type.scalar == SBool() {
            if value != 0 {
                copy(&text[0], "true", 4);
                length = 4;
            } else {
                copy(&text[0], "false", 5);
                length = 5;
            }
        } else {
            var mask = im_type_mask(type);
            value = value & mask;
            if im_type_signed(type) {
                var high = mask / 2;
                high++;
                var sign = value &high;
                if sign != 0 {
                    text[0] = 45;
                    length = 1;
                    value = 0 - value;
                    value = value & mask;
                }
            }
            var reversed: u8[24];
            var count: usize = 0;
            loop {
                var digit = value % 10;
                digit = digit + 48;
                reversed[count] = im_byte(digit);
                count++;
                value = value / 10;
                if value == 0 {
                    break;
                }
            }
            loop {
                if count == 0 {
                    break;
                }
                count--;
                text[length] = reversed[count];
                length++;
            }
        }
    }
    text[length] = 10;
    length++;
    var total = m.output_bytes + length;
    if total <= 65536 {
        im_append(m, &text[0], length);
    } else {
        m.output_truncated = true;
    }
}

export fn interpreter_step(m: IMState*, budget: usize): void {
    if m.done {
        return;
    }
    var count: usize = 0;
    loop {
        if count == budget {
            break;
        }
        if m.frame_count == 0 {
            break;
        }
        if im_ok(m) == false {
            break;
        }
        count++;
        var steps = m.steps + 1;
        m.steps = steps;
        if m.task_count == 0 {
            im_returned(m, 0);
            continue;
        }
        var task: IMTask;
        im_task_pop(m, &task);
        // Ordinary statements clear both caches before evaluation. Only suspended
        // expression tasks can observe cached values or captured addresses.
        m.cached = task.phase != 0;
        var n = im_cached_node(m, task.node);
        var offset = task.offset;
        if task.phase == 0 {
            offset = n.start;
        }
        if task.phase == 0 {
            im_cache_clear(m);
            if im_needs(m, task.node) {
                var resume = task.loop_resume != 0;
                im_task_push(m, task.node, resume, 1, n.start);
                var assign = n.kind == KDeclare();
                var test = n.kind == KAssign();
                assign = im_or(assign, test);
                var unary = n.kind == KPrint();
                test = n.kind == KReturn();
                unary = im_or(unary, test);
                test = n.kind == KIf();
                unary = im_or(unary, test);
                var memory = n.kind == KCopy();
                var trapping = n.kind == KTrap();
                memory = im_or(memory, trapping);
                test = n.kind == KFill();
                memory = im_or(memory, test);
                if assign {
                    im_queue(m, n.value, 2, offset);
                    var target = n.target;
                    if n.kind == KDeclare() {
                        target = task.node;
                    }
                    im_queue(m, target, 3, offset);
                } else {
                    if unary {
                        im_queue(m, n.value, 2, offset);
                    }
                    else {
                        if n.kind == KFree() {
                            im_queue(m, n.left, 2, offset);
                        }
                        else {
                            if memory {
                                im_queue(m, n.value, 2, offset);
                                im_queue(m, n.right, 2, offset);
                                im_queue(m, n.left, 2, offset);
                            }
                            else {
                                im_queue(m, task.node, 2, offset);
                            }
                        }
                    }
                }
                continue;
            }
        } else {
            if task.phase == 2 {
                var found = false;
                im_values_get(m, im_key(task.node), &found);
                if found {
                    continue;
                }
                im_queue(m, task.node, 4, offset);
                if n.kind == KCall() {
                    var i = n.items.length;
                    loop {
                        if i == 0 {
                            break;
                        }
                        i--;
                        im_queue(m, n.items.data[i], 2, offset);
                    }
                } else {
                    if n.kind == KAddress() {
                        im_queue(m, n.value, 3, offset);
                    }
                    else {
                        var place = n.kind == KField();
                        var test = n.kind == KIndex();
                        place = im_or(place, test);
                        if n.kind == KOperand() {
                            if !n.constant {
                                place = true;
                            }
                        }
                        if place {
                            im_queue(m, task.node, 3, offset);
                        }
                        else {
                            im_queue(m, n.value, 2, offset);
                            im_queue(m, n.right, 2, offset);
                            im_queue(m, n.left, 2, offset);
                        }
                    }
                }
                continue;
            } else {
                if task.phase == 3 {
                    var found = false;
                    im_addresses_get(m, im_key(task.node), &found);
                    if found {
                        continue;
                    }
                    im_queue(m, task.node, 5, offset);
                    if n.kind == KLoad() {
                        im_queue(m, n.value, 2, offset);
                    }
                    else {
                        var place = n.kind == KField();
                        var test = n.kind == KIndex();
                        place = im_or(place, test);
                        if place {
                            if n.kind == KIndex() {
                                im_queue(m, n.right, 2, offset);
                            }
                            var phase: usize = 3;
                            if n.indirect {
                                phase = 2;
                            }
                            im_queue(m, n.left, phase, offset);
                        }
                    }
                    continue;
                } else {
                    if task.phase == 5 {
                        var address = im_address(m, task.node, task.offset);
                        im_addresses_set(m, im_key(task.node), address);
                        continue;
                    } else {
                        if task.phase == 4 {
                            if n.kind == KCall() {
                                im_call(m, task.node, task.offset);
                            }
                            else {
                                // Value tasks already checked this node's cache before scheduling
                                // FinishValue; completing its children cannot evaluate the parent.
                                var result = im_evaluate_uncached(m, task.node, n, task.offset);
                                im_values_set(m, im_key(task.node), result);
                            }
                            continue;
                        }
                    }
                }
            }
        }
        im_statement(m, &task, n);
    }
    var done = im_ok(m) == false;
    var empty = m.frame_count == 0;
    done = im_or(done, empty);
    m.done = done;
}

fn im_statement(m: IMState*, task: IMTask*, n: FoundationNode*): void {
    if n.kind == KBlock() {
        im_enter(m, task.node);
        return;
    }
    if n.kind == KDeclare() {
        if n.value != null {
            im_store(m, task.node, im_evaluate(m, n.value, n.start), n.start);
        }
        return;
    }
    if n.kind == KAssign() {
        im_store(m, n.target, im_evaluate(m, n.value, n.start), n.start);
        return;
    }
    if n.kind == KFree() {
        interpreter_deallocate(m, im_read(m, n.left, n.start));
        return;
    }
    var memory = n.kind == KCopy();
    var test = n.kind == KFill();
    memory = im_or(memory, test);
    if memory {
        var dest = im_read(m, n.left, n.start);
        var source = im_read(m, n.right, n.start);
        var size = im_read(m, n.value, n.start);
        var fm_condition_0 = n.kind == KCopy();

        im_copy_values(m, dest, source, size, fm_condition_0, n.start);
        return;
    }
    if n.kind == KCall() {
        return;
    }
    var expression = n.kind == KAllocate();
    test = n.kind == KReallocate();
    expression = im_or(expression, test);
    test = n.kind == KSizeOf();
    expression = im_or(expression, test);
    test = n.kind == KAlignOf();
    expression = im_or(expression, test);
    test = n.kind == KConvert();
    expression = im_or(expression, test);
    test = n.kind == KBits();
    expression = im_or(expression, test);
    if expression {
        im_evaluate(m, task.node, n.start);
        return;
    }
    if n.kind == KReturn() {
        var result: u64 = 0;
        if n.value != null {
            result = im_read(m, n.value, n.start);
        }
        im_returned(m, result);
        return;
    }
    if n.kind == KIf() {
        var condition = im_read(m, n.value, n.start);
        if condition != 0 {
            im_enter(m, n.body);
        } else {
            if n.otherwise != null {
                im_enter(m, n.otherwise);
            }
        }
        return;
    }
    if n.kind == KLoop() {
        im_task_push(m, task.node, true, 0, 0);
        im_enter(m, n.body);
        return;
    }
    var jump = n.kind == KBreak();
    test = n.kind == KContinue();
    jump = im_or(jump, test);
    if jump {
        loop {
            if m.task_count == 0 {
                break;
            }
            var at: IMTask;
            im_task_pop(m, &at);
            if at.loop_resume != 0 {
                if n.kind == KContinue() {
                    im_task_push(m, at.node, true, at.phase, at.offset);
                }
                break;
            }
        }
        return;
    }
    if n.kind == KPrint() {
        im_print(m, n.value, n.start);
        return;
    }
    if n.kind == KTrap() {
        var message = im_read(m, n.left, n.start);
        var offset = im_read(m, n.right, n.start);
        im_raise(m, message, offset);
        return;
    }
    if n.kind == KLabel() {
        return;
    }
    if n.kind == KJump() {
        var discard: IMTask;
        loop {
            if m.task_count == 0 {
                break;
            }
            im_task_pop(m, &discard);
        }
        var destination = im_cached_node(m, n.binding);
        var body = im_cached_node(m, destination.body);
        var i = body.items.length;
        var begin = destination.index + 1;
        loop {
            if i == begin {
                break;
            }
            i--;
            im_task_push(m, body.items.data[i], false, 0, 0);
        }
        return;
    }
    im_fail(m, "Invalid foundation statement", n.start);
}

fn im_raise(m: IMState*, message: u64, offset: u64): void {
    var at = convert(usize, offset);
    var bytes = interpreter_bytes(m, message, 1, at);
    if bytes == null {
        return;
    }
    if bytes[0] == 0 {
        im_fail(m, "Tower trap", at);
        return;
    }
    var available = im_memory_size(m) -convert(usize, message);
    var i: usize = 0;
    loop {
        var end = i == available;
        if end {
            im_fail(m, "Unterminated trap message", at);
            return;
        }
        end = bytes[i] == 0;
        if end {
            im_fail(m, bytes, at);
            return;
        }
        i++;
    }
}

fn im_copy_values(m: IMState*, dest: u64, source: u64, size: u64, copying: bool, offset: usize): void {
    var limit = convert(u64, im_host_max());
    if size > limit {
        im_fail(m, "Memory operation exceeds interpreter address space", offset);
        return;
    }
    var count = convert(usize, size);
    var p = interpreter_bytes(m, dest, count, offset);
    var q: u8* = null;
    if copying {
        q = interpreter_bytes(m, source, count, offset);
    }
    if im_ok(m) {
        if q != null {
            copy(p, q, count);
        } else {
            fill(p, im_byte(source), count);
        }
    }
}
