import interpreter_types;
import type_objects;
import tower;
import foundation_tags;
import foundation_types;
import interpreter_abi;
import interpreter_storage;
import interpreter_context;
import interpreter_context_types;
import .library.vector;
import .library.float_bits;
import .library.float_text;

var InterpreterFinishValuePhase: usize = 4;
var InterpreterInlineArgumentStorage: type = array_type(u64, 16);
var InterpreterStackBytes: usize = 4194304;
var InterpreterCallDepth: usize = 128;

fn ix_ok(m: IMExecution*): bool {
    var ok = !m.state.failed;
    return ok;
}

extern fn entity_component_get(node: void*, type: void*): void*;
extern fn entity_component_data(component: void*): void*;

fn ix_value_input(m: IMExecution*, n: FoundationNode*): void* {
    if m.context == null || m.context.value_inputs == null || n.kind != KOperand || n.binding == null { return null; }
    var input = bits(IMValueInput*, entity_component_data(entity_component_get(n.binding, m.context.value_inputs)));
    if input == null || input.owner != null && m.state.frames.length != 0 && im_frame(m.state).function == input.owner { return null; }
    if m.context.capture_order && input.owner == null && input.ordinal >= m.context.capture_ordinal {
        ix_fail(m, "Compile-time initializer reads a module binding before its initialization", n.start);
        return null;
    }
    return input.producer;
}

fn ix_local_binding(m: IMExecution*, binding: void*): bool {
    if binding == null || m.state.frames.length == 0 { return false; }
    var local = im_cached_node(m.state, binding);
    var function = im_cached_node(m.state, im_frame(m.state).function);
    return !local.global && local.index < function.locals.length
        && function.locals.data[local.index] == binding;
}

fn ix_pending(m: IMExecution*, node: void*): bool {
    if node == null { return false; }
    var component = entity_component_get(node, m.context.dependency_kind);
    if component != null {
        var dependency = bits(IMDependency*, entity_component_data(component));
        if dependency.source != null { dependency = dependency.source; }
        if !dependency.ready {
            m.context.waiting = dependency.subject;
            return true;
        }
        if dependency.failed {
            ix_fail(m, "Compile-time input failed", im_cached_node(m.state, node).start);
            return false;
        }
    }
    var n = im_cached_node(m.state, node);
    var input = ix_value_input(m, n);
    if !ix_ok(m) { return false; }
    if input == null && m.context.type_arguments && n.kind == KOperand && n.binding != null
        && !n.constant && !ix_local_binding(m, n.binding) {
        m.context.waiting = n.binding;
        m.context.waiting_binding = true;
        return true;
    }
    if input != null && ix_pending(m, input) { return true; }
    if ix_pending(m, n.value) || ix_pending(m, n.left) || ix_pending(m, n.right) || ix_pending(m, n.target) {
        return true;
    }
    if n.kind == KCall {
        var i: usize = 0;
        while i < n.items.length {
            if ix_pending(m, n.items.data[i]) { return true; }
            i++;
        }
    }
    return false;
}

// Stage eligibility constrains effects and storage, never arithmetic semantics.
// Eligible nodes execute through the same handlers as ordinary runtime code.
fn ix_strict_node(m: IMExecution*, n: FoundationNode*, offset: usize): bool {
    if !ix_strict(m) {
        return true;
    }
    if n.kind == KBits || n.kind == KConvert {
        var source = im_cached_node(m.state, n.value);
        var function = source.type.pointers == 0 && source.type.scalar == SFunction
            || n.type.pointers == 0 && n.type.scalar == SFunction;
        if function && !semantic_type_equal(&source.type, &n.type) {
            ix_fail(m, "Compile-time function values require relocatable typed references, not representation casts", offset);
            return false;
        }
    }
    // Optional source folding must not substitute an interpreter stack address
    // or an address comparison for a result obtained in another execution.
    // Explicit stages retain their existing target-address execution policy.
    if m.context.require_relocatable {
        var address_value = false;
        if n.kind == KBits || n.kind == KConvert {
            var source = im_cached_node(m.state, n.value);
            address_value = (source.type.pointers != 0) != (n.type.pointers != 0);
            address_value ||= (source.type.scalar == SFunction) != (n.type.scalar == SFunction);
        }
        if n.kind == KBinary && n.type.pointers == 0 {
            address_value ||= im_cached_node(m.state, n.left).type.pointers != 0;
            address_value ||= im_cached_node(m.state, n.right).type.pointers != 0;
        }
        if address_value {
            ix_fail(m, "Automatic compile-time value depends on an address representation", offset);
            return false;
        }
    }
    // Ordinary lowering captures places with local addresses, including scalar
    // compound assignments. Strict stack addresses use the same target-byte
    // representation and initialization checks; they never expose host memory.
    var unsupported = n.kind == KString;
    unsupported ||= n.kind == KAllocate || n.kind == KReallocate || n.kind == KFree;
    if unsupported {
        ix_fail(m, "This operation needs a compile-time storage or value capability", offset);
        return false;
    }
    var global = n.global;
    if n.binding != null && n.kind == KOperand {
        global ||= im_cached_node(m.state, n.binding).global;
    }
    if global {
        if ix_value_input(m, n) != null { return true; }
        if m.state.frames.length != 0 && im_frame(m.state).function == m.context.root {
            ix_fail(m, "Compile-time expression cannot capture runtime storage; pass explicit compile-time arguments", offset);
        } else {
            ix_fail(m, "Compile-time evaluation requires explicit inputs instead of global storage", offset);
        }
        return false;
    }
    // A lowered stage borrows declaration identities, never their caller's
    // frame offsets. Check only executed reads; an untaken arm has no capture.
    if n.kind == KOperand && n.binding != null && !n.constant
        && ix_value_input(m, n) == null && !ix_local_binding(m, n.binding) {
        ix_fail(m, "Compile-time expression cannot capture runtime storage; pass explicit compile-time arguments", offset);
        return false;
    }
    if n.kind == KPrint {
        ix_fail(m, "Compile-time output requires an explicit effect capability", offset);
        return false;
    }
    return true;
}

fn im_or(a: bool, b: bool): bool {
    if a {
        return true;
    }
    return b;
}

fn im_and(a: bool, b: bool): bool {
    if a {
        return b;
    }
    return false;
}

fn im_host_max(): usize {
    var result: usize = 0;
    result--;
    return result;
}

fn im_align_mask(): usize {
    var result: usize = 0;
    result = result - 16;
    return result;
}

fn im_byte(value: u64): u8 {
    value = value & 255;
    return convert(u8, value);
}

// Execution over the original shared foundation entities. Caches below are
// per-statement results and scheduling indexes, never a second program model.
fn im_key(node: void*): u64 {
    return convert(u64, bits(usize, node));
}

fn im_align(n: usize): usize {
    var v = n + 15;
    return v &im_align_mask();
}

fn im_power(n: usize): u64 {
    var result: u64 = 1;
    loop {
        if n == 0 {
            return result;
        }
        result = result * 2;
        n--;
    }
}

fn im_sign(value: u64, type: FoundationType*): i64 {
    return im_sign_mask(value, im_type_mask(type));
}

fn im_sign_mask(value: u64, mask: u64): i64 {
    var high = mask / 2;
    high++;
    var sign = value &high;
    if sign != 0 {
        value |= ~mask;
    }
    return bits(i64, value);
}

export fn ix_bytes(m: IMExecution*, address: u64, count: usize, offset: usize): u8* {
    var size = convert(u64, im_memory_size(m.state));
    if address > size {
        ix_fail(m, "Address outside interpreter memory", offset);
        return null;
    }
    var remaining = size -address;
    if convert(u64, count) > remaining {
        ix_fail(m, "Address outside interpreter memory", offset);
        return null;
    }
    var at = convert(usize, address);
    var memory = im_memory(m.state);
    return &memory[at];
}

export fn ix_load(m: IMExecution*, address: u64, type: FoundationType*, offset: usize): u64 {
    return ix_load_size(m, address, im_type_size(type), offset);
}

// Explicit little-endian byte semantics, including unaligned guest addresses.
// Fixed-width paths let LLVM combine loads without inheriting host endianness.
fn ix_load_size(m: IMExecution*, address: u64, size: usize, offset: usize): u64 {
    var p = ix_bytes(m, address, size, offset);
    var missing = p == null;
    if missing {
        return 0;
    }
    if !ix_initialized(m, address, size, false, offset) {
        return 0;
    }
    var byte = size == 1;
    if byte {
        return convert(u64, p[0]);
    }
    var lo = convert(u64, p[0]);
    var lo_1 = convert(u64, p[1]);
    lo_1 = lo_1 * 256;
    lo = lo | lo_1;
    if size == convert(usize, IntegerShortWidth / IntegerByteWidth) { return lo; }
    var lo_2 = convert(u64, p[2]);
    lo_2 = lo_2 * 65536;
    lo = lo | lo_2;
    var lo_3 = convert(u64, p[3]);
    lo_3 = lo_3 * 16777216;
    lo = lo | lo_3;
    if size == 4 {
        return lo;
    }
    var hi = convert(u64, p[4]);
    var hi_1 = convert(u64, p[5]);
    hi_1 = hi_1 * 256;
    hi = hi | hi_1;
    var hi_2 = convert(u64, p[6]);
    hi_2 = hi_2 * 65536;
    hi = hi | hi_2;
    var hi_3 = convert(u64, p[7]);
    hi_3 = hi_3 * 16777216;
    hi = hi | hi_3;
    hi = hi * 4294967296;
    var result = lo | hi;
    return result;
}

export fn ix_write(m: IMExecution*, address: u64, value: u64, type: FoundationType*, offset: usize): void {
    ix_write_size(m, address, value, im_type_size(type), offset);
}

fn ix_write_size(m: IMExecution*, address: u64, value: u64, size: usize, offset: usize): void {
    var p = ix_bytes(m, address, size, offset);
    var missing = p == null;
    if missing {
        return;
    }
    if !ix_initialized(m, address, size, true, offset) {
        return;
    }
    p[0] = im_byte(value);
    if size == 1 {
        return;
    }
    value = value / 256;
    p[1] = im_byte(value);
    if size == convert(usize, IntegerShortWidth / IntegerByteWidth) { return; }
    value = value / 256;
    p[2] = im_byte(value);
    value = value / 256;
    p[3] = im_byte(value);
    if size == 4 {
        return;
    }
    value = value / 256;
    p[4] = im_byte(value);
    value = value / 256;
    p[5] = im_byte(value);
    value = value / 256;
    p[6] = im_byte(value);
    value = value / 256;
    p[7] = im_byte(value);
}

export fn ix_allocate(m: IMExecution*, count: usize): u64 {
    if count > 268435456 {
        return 0;
    }
    if count == 0 {
        count = 1;
    }
    count = im_align(count);
    var available: u64 = 0;
    var at = im_free_first(m.state, &available);
    loop {
        if at == 0 {
            break;
        }
        if available >= convert(u64, count) {
            im_free_blocks_erase(m.state, at);
            if available > convert(u64, count) {
                var tail = at + convert(u64, count);
                var rest = available - convert(u64, count);
                im_free_blocks_set(m.state, tail, rest);
            }
            im_allocations_set(m.state, at, convert(u64, count));
            return at;
        }
        var next = at + 1;
        at = im_free_neighbor(m.state, next, false, &available);
    }
    var heap = m.state.heap;
    var remaining: usize = 268435456;
    remaining = remaining - heap;
    if count > remaining {
        return 0;
    }
    var end = heap + count;
    var grown = im_memory_resize(m.state, end);
    if !grown {
        return 0;
    }
    m.state.heap = end;
    at = convert(u64, heap);
    im_allocations_set(m.state, at, convert(u64, count));
    return at;
}

export fn ix_deallocate(m: IMExecution*, at: u64): void {
    ix_deallocate_at(m, at, 0);
}

fn ix_deallocate_at(m: IMExecution*, at: u64, offset: usize): void {
    if at == 0 {
        return;
    }
    var found = false;
    var count = im_allocations_take(m.state, at, &found);
    if !found {
        ix_fail(m, "Invalid allocation passed to free", offset);
        return;
    }
    var neighbors: IMNeighbors;
    im_free_neighbors(m.state, at, &neighbors);
    var available = neighbors.next_count;
    var next = neighbors.next;
    var end = at + count;
    if next != 0 {
        if end == next {
            count = count + available;
            im_free_blocks_erase(m.state, next);
        }
    }
    var prev = neighbors.previous;
    available = neighbors.previous_count;
    if prev != 0 {
        end = prev + available;
        if end == at {
            at = prev;
            count = count + available;
            im_free_blocks_erase(m.state, prev);
        }
    }
    im_free_blocks_set(m.state, at, count);
}

export fn ix_reallocate(m: IMExecution*, at: u64, count: usize): u64 {
    return ix_reallocate_at(m, at, count, 0);
}

fn ix_reallocate_at(m: IMExecution*, at: u64, count: usize, offset: usize): u64 {
    if at == 0 {
        return ix_allocate(m, count);
    }
    if count == 0 {
        ix_deallocate_at(m, at, offset);
        return 0;
    }
    var found = false;
    var previous = im_allocations_get(m.state, at, &found);
    if !found {
        ix_fail(m, "Invalid allocation passed to realloc", offset);
        return 0;
    }
    if convert(u64, count) <= previous {
        return at;
    }
    var result = ix_allocate(m, count);
    if result == 0 {
        return 0;
    }
    var memory = im_memory(m.state);
    var to = convert(usize, result);
    var from = convert(usize, at);
    copy(&memory[to], &memory[from], convert(usize, previous));
    ix_deallocate_at(m, at, offset);
    return result;
}

fn ix_read(m: IMExecution*, node: void*, offset: usize): u64 {
    var found = false;
    var cached: u64 = 0;
    if m.state.cached {
        cached = im_values_get(m.state, im_key(node), &found);
        if found {
            return cached;
        }
    }
    return ix_read_uncached(m, node, im_cached_node(m.state, node), offset);
}

fn ix_read_uncached(m: IMExecution*, node: void*, n: FoundationNode*, offset: usize): u64 {
    if !ix_strict_node(m, n, offset) {
        return 0;
    }
    var found = false;
    var cached: u64 = 0;
    if n.kind == KAddress {
        return ix_address(m, n.value, offset);
    }
    var direct = n.kind == KOperand;
    var test = n.kind == KString;
    direct = im_or(direct, test);
    test = n.kind == KField;
    direct = im_or(direct, test);
    test = n.kind == KIndex;
    direct = im_or(direct, test);
    if !direct {
        return ix_evaluate(m, node, offset);
    }
    if n.kind == KString {
        cached = im_strings_get(m.state, im_key(node), &found);
        if found {
            return cached;
        }
        var count = n.name.length + 1;
        var at = ix_allocate(m, count);
        if at == 0 {
            ix_fail(m, "String allocation failed", offset);
            return 0;
        }
        var memory = im_memory(m.state);
        var index = convert(usize, at);
        if n.name.length != 0 {
            copy(&memory[index], n.name.data, n.name.length);
        }
        var terminator = index + n.name.length;
        memory[terminator] = 0;
        im_strings_set(m.state, im_key(node), at);
        return at;
    }
    if n.constant {
        return n.bits;
    }
    var input = ix_value_input(m, n);
    // Published inputs can be relocated type/function references as well as
    // numeric literals. Read the ordinary Foundation value in this invocation;
    // another invocation's private reference index is not an input constant.
    if input != null { return ix_read(m, input, offset); }
    var address = ix_address_component(m, node, n, offset);
    if ix_ok(m) {
        return ix_load(m, address, &n.type, offset);
    }
    return 0;
}

fn ix_address(m: IMExecution*, node: void*, offset: usize): u64 {
    var found = false;
    if m.state.cached {
        var cached = im_addresses_get(m.state, im_key(node), &found);
        if found {
            return cached;
        }
    }
    return ix_address_uncached(m, node, im_cached_node(m.state, node), offset);
}

fn ix_address_component(m: IMExecution*, node: void*, n: FoundationNode*, offset: usize): u64 {
    if !ix_strict_node(m, n, offset) {
        return 0;
    }
    var found = false;
    var cached: u64 = 0;
    if m.state.cached {
        cached = im_addresses_get(m.state, im_key(node), &found);
        if found {
            return cached;
        }
    }
    return ix_address_uncached(m, node, n, offset);
}

fn ix_address_uncached(m: IMExecution*, node: void*, n: FoundationNode*, offset: usize): u64 {
    if !ix_strict_node(m, n, offset) { return 0; }
    // A published scalar input supplies a value, not storage in this invocation.
    // In particular, taking its address must not borrow a helper-frame slot.
    if ix_strict(m) && ix_value_input(m, n) != null {
        ix_fail(m, "Compile-time expression cannot capture runtime storage; pass explicit compile-time arguments", offset);
        return 0;
    }
    if n.kind == KLoad {
        return ix_read(m, n.value, offset);
    }
    var place = n.kind == KField;
    var test = n.kind == KIndex;
    place = im_or(place, test);
    if place {
        var pointer: u64 = 0;
        if n.indirect {
            pointer = ix_read(m, n.left, offset);
        } else {
            pointer = ix_address(m, n.left, offset);
        }
        if n.kind == KField {
            pointer = pointer + convert(u64, n.byte_offset);
        }
        else {
            var index = ix_read(m, n.right, offset);
            var right = im_cached_node(m.state, n.right);
            if im_type_signed(&right.type) {
                index = bits(u64, im_sign(index, &right.type));
            }
            var delta = index *convert(u64, im_type_size(&n.type));
            pointer = pointer + delta;
        }
        if ix_pointer_bytes(m) == 4 {
            pointer = pointer & 4294967295;
        }
        return pointer;
    }
    var binding = n;
    var bound = n.binding != null;
    if bound {
        binding = im_cached_node(m.state, n.binding);
    }
    var base: u64 = 16;
    if !binding.global {
        base = convert(u64, im_base(m.state));
    }
    return base + convert(u64, binding.byte_offset);
}

fn ix_evaluate(m: IMExecution*, node: void*, offset: usize): u64 {
    var found = false;
    var cached: u64 = 0;
    if m.state.cached {
        cached = im_values_get(m.state, im_key(node), &found);
        if found {
            return cached;
        }
    }
    var n = im_cached_node(m.state, node);
    return ix_evaluate_uncached(m, node, n, offset);
}

fn ix_evaluate_uncached(m: IMExecution*, node: void*, n: FoundationNode*, offset: usize): u64 {
    if !ix_strict_node(m, n, offset) {
        return 0;
    }
    if n.kind == KFunctionReference { return im_function_reference(m.state, n.binding); }
    if n.kind == KTypeReference {
        var reference = type_object_intern(&m.state.type_values, &n.element);
        im_storage_require(reference != 0);
        return reference;
    }
    if n.kind == KCall {
        ix_fail(m, "Missing suspended call result", offset);
        return 0;
    }
    var direct = n.kind == KOperand;
    var test = n.kind == KString;
    direct = im_or(direct, test);
    test = n.kind == KField;
    direct = im_or(direct, test);
    test = n.kind == KIndex;
    direct = im_or(direct, test);
    test = n.kind == KAddress;
    direct = im_or(direct, test);
    if direct {
        return ix_read_uncached(m, node, n, offset);
    }
    if n.kind == KSizeOf {
        return convert(u64, im_type_size(&n.element));
    }
    if n.kind == KAlignOf {
        return convert(u64, im_type_alignment(&n.element));
    }
    var allocation = n.kind == KAllocate;
    test = n.kind == KReallocate;
    allocation = im_or(allocation, test);
    if allocation {
        var p: u64 = 0;
        if n.left != null {
            p = ix_read(m, n.left, offset);
        }
        var count = ix_read(m, n.right, offset);
        var size = convert(u64, im_type_size(&n.element));
        var limit: u64 = 18446744073709551615;
        if ix_pointer_bytes(m) == 4 {
            limit = 4294967295;
        }
        limit = limit / size;
        if count > limit {
            return 0;
        }
        var host_limit = im_host_max();
        limit = convert(u64, host_limit);
        limit = limit / size;
        if count > limit {
            return 0;
        }
        count = count * size;
        if n.kind == KAllocate {
            return ix_allocate(m, convert(usize, count));
        }
        return ix_reallocate_at(m, p, convert(usize, count), offset);
    }
    var input_node = n.value;
    if n.kind == KBinary {
        input_node = n.left;
    }
    var a = ix_evaluate(m, input_node, offset);
    var result = a;
    if ix_ok(m) == false {
        return result;
    }
    if n.kind == KLoad {
        return ix_load(m, a, &n.type, offset);
    }
    if n.kind == KConvert {
        var input = im_cached_node(m.state, n.value);
        result = ix_convert_value(m, a, &input.type, &n.type, offset);
    } else {
        if n.kind == KBinary {
            result = ix_binary(m, n, a, offset);
        }
    }
    return result &im_type_mask(&n.type);
}

fn ix_convert_value(m: IMExecution*, a: u64, input: FoundationType*, type: FoundationType*, offset: usize): u64 {
    if semantic_float(input) {
        var width = semantic_width(input);
        if semantic_float(type) { return tower_float_convert(a, width, semantic_width(type)); }
        if type.scalar == SBool { return convert(u64, (a & (float_layout(width).sign - 1)) != 0); }
        var valid: bool;
        var result = tower_float_to_integer(a, width, semantic_width(type), im_type_signed(type), &valid);
        if !valid { ix_fail(m, "Numeric conversion out of range; use bits for bit reinterpretation", offset); }
        return result;
    }
    if semantic_float(type) { return tower_float_from_integer(a, semantic_width(input), im_type_signed(input), semantic_width(type)); }
    var boolean = type.scalar == SBool;
    if boolean {
        var nonzero = a != 0;
        return convert(u64, nonzero);
    }
    var result = a;
    var mask = im_type_mask(input);
    var high = mask / 2;
    high++;
    var sign = a &high;
    var negative = sign != 0;
    negative = im_and(negative, im_type_signed(input));
    var magnitude = a;
    if negative {
        magnitude = 0 - a;
        magnitude = magnitude & mask;
    }
    var limit = im_type_mask(type);
    if im_type_signed(type) {
        limit = limit / 2;
        if negative {
            limit++;
        }
    }
    var invalid = im_type_signed(type) == false;
    invalid = im_and(invalid, negative);
    var test = magnitude > limit;
    invalid = im_or(invalid, test);
    if invalid {
        ix_fail(m, "Numeric conversion out of range; use bits for bit reinterpretation", offset);
    }
    result = magnitude;
    if negative {
        result = 0 - magnitude;
    }
    return result;
}

fn ix_binary(m: IMExecution*, n: FoundationNode*, x: u64, offset: usize): u64 {
    var y = ix_evaluate(m, n.right, offset);
    var input = im_cached_node(m.state, n.left);
    var right_type = &input.type;
    var pointer = input.type.pointers != 0;
    if pointer {
        var right = im_cached_node(m.state, n.right);
        right_type = &right.type;
    }
    return ix_binary_values(m, n.op, x, y, &input.type, right_type, offset);
}

fn ix_binary_values(m: IMExecution*, op: u32, x: u64, y: u64, type: FoundationType*, right_type: FoundationType*, offset: usize): u64 {
    if semantic_float(type) { return tower_float_binary(x, y, op, semantic_width(type)); }
    var arithmetic = op == OAdd;
    var test = op == OSub;
    arithmetic = im_or(arithmetic, test);
    if type.pointers != 0 {
        if arithmetic {
            if im_type_signed(right_type) {
                y = bits(u64, im_sign(y, right_type));
            }
            y = y * convert(u64, im_pointee_size(type));
        }
    }
    return ix_binary_scalar(m, op, x, y, im_type_mask(type), im_type_signed(type), offset);
}

// Shared scalar semantics for graph evaluation and compact instruction dispatch.
fn ix_binary_scalar(m: IMExecution*, op: u32, x: u64, y: u64, mask: u64, signed: bool, offset: usize): u64 {
    if op == OAdd {
        return x + y;
    }
    if op == OSub {
        return x -y;
    }
    if op == OMul {
        return x *y;
    }
    var division = op == ODiv;
    var test = op == ORem;
    division = im_or(division, test);
    if division {
        if y == 0 {
            ix_fail(m, "Division by zero", offset);
            return x;
        }
        if signed {
            var high = mask / 2;
            high++;
            if x == high {
                if y == mask {
                    ix_fail(m, "Signed division overflow", offset);
                    return x;
                }
            }
            var sx = im_sign_mask(x, mask);
            var sy = im_sign_mask(y, mask);
            var signed_result: i64 = 0;
            if op == ODiv {
                signed_result = sx / sy;
            } else {
                signed_result = sx % sy;
            }
            return bits(u64, signed_result);
        }
        if op == ODiv {
            return x / y;
        }
        return x % y;
    }
    if op == OAnd {
        return x &y;
    }
    if op == OOr {
        return x | y;
    }
    if op == OXor {
        return x ^ y;
    }
    var result = false;
    if op == OEq {
        result = x == y;
    }
    if op == ONe {
        result = x != y;
    }
    if signed {
        var sx = im_sign_mask(x, mask);
        var sy = im_sign_mask(y, mask);
        if op == OLt {
            result = sx < sy;
        }
        if op == OLe {
            result = sx <= sy;
        }
        if op == OGt {
            result = sx > sy;
        }
        if op == OGe {
            result = sx >= sy;
        }
    } else {
        if op == OLt {
            result = x < y;
        }
        if op == OLe {
            result = x <= y;
        }
        if op == OGt {
            result = x > y;
        }
        if op == OGe {
            result = x >= y;
        }
    }
    return convert(u64, result);
}

fn ix_store(m: IMExecution*, target: void*, value: u64, offset: usize): void {
    if ix_ok(m) == false {
        return;
    }
    var at = ix_address(m, target, offset);
    var n = im_cached_node(m.state, target);
    if ix_ok(m) {
        ix_write(m, at, value, &n.type, offset);
    }
}

fn ix_enter(m: IMExecution*, node: void*): void {
    var n = im_cached_node(m.state, node);
    var i = n.items.length;
    loop {
        if i == 0 {
            break;
        }
        i--;
        var child = n.items.data[i];
        var c = im_cached_node(m.state, child);
        var omitted = c.kind == KFunction;
        var test = c.kind == KType;
        omitted = im_or(omitted, test);
        if !omitted {
            im_task_push(m.state, child, false, 0, 0);
        }
    }
}

fn ix_returned(m: IMExecution*, value: u64): void {
    var call = im_frame_call(m.state);
    // A staged aggregate producer owns its final frame until its fields have
    // been copied into relocatable Foundation values. Guest callers still pop
    // normally; this private result buffer never becomes a program pointer.
    var retained = m.context != null && m.context.retain_result_storage && m.state.frame_count == 1;
    if !retained {
        m.state.stack = im_base(m.state);
        if ix_strict(m) { m.context.initialized.length = m.state.stack; }
    }
    im_frame_pop(m.state);
    if m.state.frame_count == 0 && m.context != null {
        m.context.result = value;
        m.context.returned = true;
    }
    if m.state.frame_count != 0 {
        if call != null {
            if ix_ok(m) {
                im_values_set(m.state, im_key(call), value);
            }
        }
    }
}

fn ix_call(m: IMExecution*, node: void*, offset: usize): void {
    var n = im_cached_node(m.state, node);
    var binding = n.binding;
    if n.value != null {
        var reference = ix_read(m, n.value, offset);
        if !ix_ok(m) { return; }
        if reference == 0 { ix_fail(m, "Cannot call a null function", offset); return; }
        if reference > convert(u64, m.state.function_values.length) {
            ix_fail(m, "Invalid function reference", offset); return;
        }
        binding = m.state.function_values.data[convert(usize, reference - 1)];
        if binding == null || !im_function_matches(binding, &im_cached_node(m.state, n.value).type) {
            ix_fail(m, "Function reference signature mismatch", offset); return;
        }
    }
    if m.context != null && m.context.executable_functions != null && !im_cached_node(m.state, binding).external {
        var input = bits(IMFunctionInput*, entity_component_data(entity_component_get(binding, m.context.executable_functions)));
        if input == null || !input.ready {
            m.context.waiting = binding;
            m.context.waiting_function = true;
            return;
        }
        if input.failed || input.function == null {
            ix_fail(m, "Compile-time function input failed", offset);
            return;
        }
        binding = input.function;
    }
    var function = im_cached_node(m.state, binding);
    var base: usize = 0;
    {
        var small_args: InterpreterInlineArgumentStorage;
        var args = &small_args[0];
        var heap_args = n.items.length > sizeof(InterpreterInlineArgumentStorage) / sizeof(u64);
        if heap_args {
            args = alloc(u64, n.items.length);
            if args == null {
                ix_fail(m, "Cannot allocate interpreter call arguments", offset);
                return;
            }
        }
        defer {
            if heap_args {
                free(args);
            }
        }
        var i: usize = 0;
        loop {
            if i == n.items.length {
                break;
            }
            args[i] = ix_read(m, n.items.data[i], offset);
            i++;
        }
        if ix_ok(m) == false {
            return;
        }
        if function.external {
            if ix_has_foreign(m) == false {
                ix_missing_foreign(m, binding, offset);
                return;
            }
            var result = ix_foreign(m, binding, args, n.items.length);
            if ix_ok(m) {
                im_values_set(m.state, im_key(node), result);
            }
            return;
        }
        var size = im_align(function.frame_size);
        base = m.state.stack;
        var remaining = InterpreterStackBytes;
        remaining = remaining - base;
        var exhausted = m.state.frame_count >= InterpreterCallDepth;
        var test = size > remaining;
        exhausted = im_or(exhausted, test);
        if exhausted {
            ix_fail(m, "Tower call stack limit exceeded", offset);
            return;
        }
        var end = base + size;
        m.state.stack = end;
        if ix_strict(m) && !im_memory_resize(m.state, end) {
            ix_fail(m, "Cannot grow strict evaluation stack", offset);
            return;
        }
        if !ix_initialize_frame(m, base, size) { return; }
        i = 0;
        loop {
            if i == n.items.length {
                break;
            }
            var parameter = im_cached_node(m.state, function.parameters.data[i]);
            var at = base + parameter.byte_offset;
            ix_write(m, convert(u64, at), args[i], &parameter.type, offset);
            i++;
        }
    }
    im_frame_push(m.state, binding, base, offset, node);
    ix_enter(m, function.body);
}

fn ix_needs(m: IMExecution*, node: void*): bool {
    if node == null {
        return false;
    }
    var found = false;
    var cached = im_sequenced_get(m.state, im_key(node), &found);
    if found {
        return cached != 0;
    }
    var n = im_cached_node(m.state, node);
    var result = n.kind == KCall;
    var test = n.kind == KAllocate;
    result = im_or(result, test);
    test = n.kind == KReallocate;
    result = im_or(result, test);
    result = im_or(result, ix_needs(m, n.left));
    result = im_or(result, ix_needs(m, n.right));
    result = im_or(result, ix_needs(m, n.value));
    result = im_or(result, ix_needs(m, n.target));
    im_sequenced_set(m.state, im_key(node), convert(u64, result));
    return result;
}

fn ix_queue(m: IMExecution*, node: void*, phase: usize, offset: usize): void {
    if node != null {
        im_task_push(m.state, node, false, phase, offset);
    }
}

export fn ix_init(m: IMExecution*): void {
    if m.state.done {
        return;
    }
    var root = ix_root(m);
    var n = im_cached_node(m.state, root);
    var base = m.state.stack;
    var size = im_align(n.frame_size);
    var end = base + size;
    var memory_size: usize = 4194304;
    if ix_strict(m) { memory_size = end; }
    var allocated = im_memory_resize(m.state, memory_size);
    if !allocated {
        ix_fail(m, "Cannot allocate interpreter memory", 0);
        m.state.done = true;
        return;
    }
    m.state.stack = end;
    if end > 4194304 {
        ix_fail(m, "Tower interpreter stack exhausted", 0);
        m.state.done = true;
        return;
    }
    im_frame_push(m.state, root, base, 0, null);
    if !ix_initialize_frame(m, base, size) {
        return;
    }
    if n.kind == KFunction {
        ix_enter(m, n.body);
    } else {
        ix_enter(m, root);
    }
}

// Output formatting is execution behavior; only appending bytes crosses the ABI.
fn ix_print(m: IMExecution*, node: void*, offset: usize): void {
    var value = ix_read(m, node, offset);
    if ix_ok(m) == false {
        return;
    }
    var n = im_cached_node(m.state, node);
    ix_print_value(m, value, &n.type);
}

fn ix_print_value(m: IMExecution*, value: u64, type: FoundationType*): void {
    var text: u8[80];
    var length: usize = 0;
    if type.pointers != 0 {
        text[0] = 48;
        text[1] = 120;
        length = 2;
        var digits = ix_pointer_bytes(m) * 2;
        var hex = "0123456789abcdef";
        loop {
            if digits == 0 {
                break;
            }
            digits--;
            var exponent = digits *4;
            var digit = value / im_power(exponent);
            digit = digit & 15;
            text[length] = hex[convert(usize, digit)];
            length++;
        }
    } else {
        if semantic_float(type) {
            length = float_text(value, semantic_width(type), &text[0]);
        } else { if type.scalar == SBool {
            if value != 0 {
                copy(&text[0], "true", 4);
                length = 4;
            } else {
                copy(&text[0], "false", 5);
                length = 5;
            }
        } else {
            var mask = im_type_mask(type);
            value = value & mask;
            if im_type_signed(type) {
                var high = mask / 2;
                high++;
                var sign = value &high;
                if sign != 0 {
                    text[0] = 45;
                    length = 1;
                    value = 0 - value;
                    value = value & mask;
                }
            }
            var reversed: u8[24];
            var count: usize = 0;
            loop {
                var digit = value % 10;
                digit = digit + 48;
                reversed[count] = im_byte(digit);
                count++;
                value = value / 10;
                if value == 0 {
                    break;
                }
            }
            loop {
                if count == 0 {
                    break;
                }
                count--;
                text[length] = reversed[count];
                length++;
            }
        }
    }
    }
    text[length] = 10;
    length++;
    var total = m.state.output_bytes + length;
    if total <= 65536 {
        ix_append(m, &text[0], length);
    } else {
        m.state.output_truncated = true;
    }
}

export fn ix_step(m: IMExecution*, budget: usize): void {
    if m.state.done {
        return;
    }
    var count: usize = 0;
    loop {
        if count == budget {
            break;
        }
        if m.state.frame_count == 0 {
            break;
        }
        if ix_ok(m) == false {
            break;
        }
        if ix_strict(m) && m.state.steps >= m.context.fuel {
            ix_fail(m, "Compile-time evaluation fuel exhausted", 0);
            break;
        }
        count++;
        var steps = m.state.steps + 1;
        m.state.steps = steps;
        if m.state.task_count == 0 {
            ix_returned(m, 0);
            continue;
        }
        var task: IMTask;
        im_task_pop(m.state, &task);
        // Ordinary statements clear both caches before evaluation. Only suspended
        // expression tasks can observe cached values or captured addresses.
        m.state.cached = task.phase != 0;
        var n = im_cached_node(m.state, task.node);
        if m.context != null {
            m.context.waiting = null;
            m.context.waiting_function = false;
            m.context.waiting_binding = false;
        }
        if m.context != null && m.context.dependency_kind != null {
            if ix_pending(m, task.node) {
                im_task_push(m.state, task.node, task.loop_resume != 0, task.phase, task.offset);
                m.state.steps--;
                break;
            }
        }
        var offset = task.offset;
        if task.phase == 0 {
            offset = n.start;
        }
        if !ix_strict_node(m, n, offset) {
            break;
        }
        if task.phase == 0 {
            im_cache_clear(m.state);
            if ix_needs(m, task.node) {
                var resume = task.loop_resume != 0;
                im_task_push(m.state, task.node, resume, 1, n.start);
                var assign = n.kind == KDeclare;
                var test = n.kind == KAssign;
                assign = im_or(assign, test);
                var unary = n.kind == KPrint;
                test = n.kind == KReturn;
                unary = im_or(unary, test);
                test = n.kind == KIf;
                unary = im_or(unary, test);
                var memory = n.kind == KCopy;
                var trapping = n.kind == KTrap;
                memory = im_or(memory, trapping);
                test = n.kind == KFill;
                memory = im_or(memory, test);
                if assign {
                    ix_queue(m, n.value, 2, offset);
                    var target = n.target;
                    if n.kind == KDeclare {
                        target = task.node;
                    }
                    ix_queue(m, target, 3, offset);
                } else {
                    if unary {
                        ix_queue(m, n.value, 2, offset);
                    }
                    else {
                        if n.kind == KFree {
                            ix_queue(m, n.left, 2, offset);
                        }
                        else {
                            if memory {
                                ix_queue(m, n.value, 2, offset);
                                ix_queue(m, n.right, 2, offset);
                                ix_queue(m, n.left, 2, offset);
                            }
                            else {
                                ix_queue(m, task.node, 2, offset);
                            }
                        }
                    }
                }
                continue;
            }
        } else {
            if task.phase == 2 {
                var found = false;
                im_values_get(m.state, im_key(task.node), &found);
                if found {
                    continue;
                }
                ix_queue(m, task.node, InterpreterFinishValuePhase, offset);
                if n.kind == KCall {
                    var i = n.items.length;
                    loop {
                        if i == 0 {
                            break;
                        }
                        i--;
                        ix_queue(m, n.items.data[i], 2, offset);
                    }
                    ix_queue(m, n.value, 2, offset);
                } else {
                    if n.kind == KAddress {
                        ix_queue(m, n.value, 3, offset);
                    }
                    else {
                        var place = n.kind == KField;
                        var test = n.kind == KIndex;
                        place = im_or(place, test);
                        if n.kind == KOperand {
                            if !n.constant {
                                place = true;
                            }
                        }
                        if place {
                            ix_queue(m, task.node, 3, offset);
                        }
                        else {
                            ix_queue(m, n.value, 2, offset);
                            ix_queue(m, n.right, 2, offset);
                            ix_queue(m, n.left, 2, offset);
                        }
                    }
                }
                continue;
            } else {
                if task.phase == 3 {
                    var found = false;
                    im_addresses_get(m.state, im_key(task.node), &found);
                    if found {
                        continue;
                    }
                    ix_queue(m, task.node, 5, offset);
                    if n.kind == KLoad {
                        ix_queue(m, n.value, 2, offset);
                    }
                    else {
                        var place = n.kind == KField;
                        var test = n.kind == KIndex;
                        place = im_or(place, test);
                        if place {
                            if n.kind == KIndex {
                                ix_queue(m, n.right, 2, offset);
                            }
                            var phase: usize = 3;
                            if n.indirect {
                                phase = 2;
                            }
                            ix_queue(m, n.left, phase, offset);
                        }
                    }
                    continue;
                } else {
                    if task.phase == 5 {
                        var address = ix_address(m, task.node, task.offset);
                        im_addresses_set(m.state, im_key(task.node), address);
                        continue;
                    } else {
                        if task.phase == InterpreterFinishValuePhase {
                            if n.kind == KCall {
                                ix_call(m, task.node, task.offset);
                                if m.context != null && m.context.waiting_function {
                                    // Callee and arguments are already cached. Resume
                                    // this finish task, never their effects or statements.
                                    im_task_push(m.state, task.node, task.loop_resume != 0, task.phase, task.offset);
                                    m.state.steps--;
                                    break;
                                }
                            }
                            else {
                                // Value tasks already checked this node's cache before scheduling
                                // FinishValue; completing its children cannot evaluate the parent.
                                var result = ix_evaluate_uncached(m, task.node, n, task.offset);
                                im_values_set(m.state, im_key(task.node), result);
                            }
                            continue;
                        }
                    }
                }
            }
        }
        ix_statement(m, &task, n);
    }
    var done = ix_ok(m) == false;
    var empty = m.state.frame_count == 0;
    done = im_or(done, empty);
    m.state.done = done;
}

fn ix_statement(m: IMExecution*, task: IMTask*, n: FoundationNode*): void {
    if n.kind == KBlock {
        ix_enter(m, task.node);
        return;
    }
    if n.kind == KDeclare {
        if !ix_initialize_frame(m, im_base(m.state) + n.byte_offset, im_type_size(&n.type)) {
            return;
        }
        if n.value != null {
            ix_store(m, task.node, ix_evaluate(m, n.value, n.start), n.start);
        }
        return;
    }
    if n.kind == KAssign {
        ix_store(m, n.target, ix_evaluate(m, n.value, n.start), n.start);
        return;
    }
    if n.kind == KFree {
        ix_deallocate_at(m, ix_read(m, n.left, n.start), n.start);
        return;
    }
    var memory = n.kind == KCopy;
    var test = n.kind == KFill;
    memory = im_or(memory, test);
    if memory {
        var dest = ix_read(m, n.left, n.start);
        var source = ix_read(m, n.right, n.start);
        var size = ix_read(m, n.value, n.start);
        var fm_condition_0 = n.kind == KCopy;

        ix_copy_values(m, dest, source, size, fm_condition_0, n.start);
        return;
    }
    if n.kind == KCall {
        return;
    }
    var expression = n.kind == KAllocate;
    test = n.kind == KReallocate;
    expression = im_or(expression, test);
    test = n.kind == KSizeOf;
    expression = im_or(expression, test);
    test = n.kind == KAlignOf;
    expression = im_or(expression, test);
    test = n.kind == KConvert;
    expression = im_or(expression, test);
    test = n.kind == KBits;
    expression = im_or(expression, test);
    if expression {
        ix_evaluate(m, task.node, n.start);
        return;
    }
    if n.kind == KReturn {
        var result: u64 = 0;
        if n.value != null {
            result = ix_read(m, n.value, n.start);
        }
        ix_returned(m, result);
        return;
    }
    if n.kind == KIf {
        var condition = ix_read(m, n.value, n.start);
        if condition != 0 {
            ix_enter(m, n.body);
        } else {
            if n.otherwise != null {
                ix_enter(m, n.otherwise);
            }
        }
        return;
    }
    if n.kind == KLoop {
        im_task_push(m.state, task.node, true, 0, 0);
        ix_enter(m, n.body);
        return;
    }
    var jump = n.kind == KBreak;
    test = n.kind == KContinue;
    jump = im_or(jump, test);
    if jump {
        loop {
            if m.state.task_count == 0 {
                break;
            }
            var at: IMTask;
            im_task_pop(m.state, &at);
            if at.loop_resume != 0 {
                if n.kind == KContinue {
                    im_task_push(m.state, at.node, true, at.phase, at.offset);
                }
                break;
            }
        }
        return;
    }
    if n.kind == KPrint {
        ix_print(m, n.value, n.start);
        return;
    }
    var trapping = n.kind == KTrap;
    if trapping {
        var message = ix_read(m, n.left, n.start);
        var offset = ix_read(m, n.right, n.start);
        ix_raise(m, message, offset);
        return;
    }
    if n.kind == KLabel {
        return;
    }
    if n.kind == KJump {
        var discard: IMTask;
        loop {
            var empty = m.state.task_count == 0;
            if empty {
                break;
            }
            im_task_pop(m.state, &discard);
        }
        var destination = im_cached_node(m.state, n.binding);
        var body = im_cached_node(m.state, destination.body);
        var i = body.items.length;
        var begin = destination.index + 1;
        loop {
            if i == begin {
                break;
            }
            i--;
            im_task_push(m.state, body.items.data[i], false, 0, 0);
        }
        return;
    }
    ix_fail(m, "Invalid foundation statement", n.start);
}

fn ix_raise(m: IMExecution*, message: u64, offset: u64): void {
    var at = convert(usize, offset);
    var bytes = ix_bytes(m, message, 1, at);
    var failed = bytes == null;
    if failed {
        return;
    }
    var empty_message = bytes[0] == 0;
    if empty_message {
        ix_fail(m, "Tower trap", at);
        return;
    }
    var available = im_memory_size(m.state) - convert(usize, message);
    var i: usize = 0;
    loop {
        var end = i == available;
        if end {
            ix_fail(m, "Unterminated trap message", at);
            return;
        }
        end = bytes[i] == 0;
        if end {
            ix_fail(m, bytes, at);
            return;
        }
        i++;
    }
}

fn ix_copy_values(m: IMExecution*, dest: u64, source: u64, size: u64, copying: bool, offset: usize): void {
    var limit = convert(u64, im_host_max());
    if size > limit {
        ix_fail(m, "Memory operation exceeds interpreter address space", offset);
        return;
    }
    var count = convert(usize, size);
    // Strict stages may copy/fill their own live local storage. Validate the
    // complete source before marking any destination byte initialized.
    if copying && !ix_initialized(m, source, count, false, offset) { return; }
    if !ix_initialized(m, dest, count, true, offset) { return; }
    var p = ix_bytes(m, dest, count, offset);
    var q: u8* = null;
    if copying {
        q = ix_bytes(m, source, count, offset);
    }
    if ix_ok(m) {
        if q != null {
            copy(p, q, count);
        } else {
            fill(p, im_byte(source), count);
        }
    }
}

// Explicit Tower-owned invocation. Inputs and function nodes must remain pinned
// until disposal. This starts only the selected body, never module initialization.
// The caller supplies fresh storage or disposes a previous invocation first.
export fn interpreter_invocation_init(invocation: IMInvocation*, function: void*, pointer_bytes: usize, arguments: u64*, count: usize, strict: bool, fuel: u64): bool {
    *invocation = default;
    invocation.state.stack = 16;
    invocation.state.heap = 4194304;
    invocation.context.root = function;
    invocation.context.pointer_bytes = pointer_bytes;
    invocation.context.strict = strict;
    invocation.context.fuel = fuel;
    var execution: IMExecution;
    execution.state = &invocation.state;
    execution.context = &invocation.context;
    if function == null || (pointer_bytes != 4 && pointer_bytes != 8) {
        ix_fail(&execution, "Invalid evaluation function or target", 0);
        return false;
    }
    var definition = im_cached_node(&invocation.state, function);
    if convert(usize, definition.type.pointer_bytes) != pointer_bytes {
        ix_fail(&execution, "Evaluation target differs from the checked function target", definition.start);
        return false;
    }
    if definition.kind != KFunction || definition.external || definition.body == null {
        ix_fail(&execution, "Evaluation requires a checked ordinary function body", definition.start);
        return false;
    }
    if count != definition.parameters.length || (count != 0 && arguments == null) {
        ix_fail(&execution, "Evaluation argument count does not match the function", definition.start);
        return false;
    }
    if !ix_strict_node(&execution, definition, definition.start) {
        return false;
    }
    ix_init(&execution);
    var i: usize = 0;
    while i < count && ix_ok(&execution) {
        var parameter = im_cached_node(&invocation.state, definition.parameters.data[i]);
        if strict && (parameter.type.pointers != 0 || parameter.type.scalar == SStruct || parameter.type.scalar == SArray) {
            ix_fail(&execution, "Evaluation inputs require explicit scalar values", parameter.start);
            return false;
        }
        if !ix_strict_node(&execution, parameter, parameter.start) {
            return false;
        }
        ix_write(&execution, convert(u64, im_base(&invocation.state) + parameter.byte_offset), arguments[i], &parameter.type, parameter.start);
        i++;
    }
    return ix_ok(&execution);
}

export fn interpreter_invocation_step(invocation: IMInvocation*, budget: usize): void {
    var execution: IMExecution;
    execution.state = &invocation.state;
    execution.context = &invocation.context;
    ix_step(&execution, budget);
}

export fn interpreter_invocation_dispose(invocation: IMInvocation*): void {
    interpreter_storage_dispose(&invocation.state);
    vector_dispose(u8, &invocation.context.error);
    vector_dispose(u8, &invocation.context.output);
    vector_dispose(u8, &invocation.context.initialized);
    *invocation = default;
}

// Validate staged relocation through the ordinary function-reference table and
// exact source signature. Raw local memory casts can forge values: diagnose input,
// not an assertion about the interpreter's private reference table.
export fn interpreter_function_result(invocation: IMInvocation*, reference: u64, type: FoundationType*, offset: usize): void* {
    if reference == 0 { return null; }
    var execution: IMExecution = { state: &invocation.state, context: &invocation.context };
    if reference > convert(u64, invocation.state.function_values.length) {
        ix_fail(&execution, "Compile-time result contains an invalid function reference", offset);
        return null;
    }
    var binding = invocation.state.function_values.data[convert(usize, reference - 1)];
    if binding == null || !im_function_signature(binding, type, true) {
        ix_fail(&execution, "Compile-time function reference signature mismatch", offset);
        return null;
    }
    return binding;
}

export fn interpreter_type_result(invocation: IMInvocation*, reference: u64, type: FoundationType*, offset: usize): bool {
    if reference == 0 || reference > convert(u64, invocation.state.type_values.length) {
        var execution: IMExecution = { state: &invocation.state, context: &invocation.context };
        ix_fail(&execution, "Compile-time result contains an invalid type value", offset);
        return false;
    }
    *type = invocation.state.type_values.data[convert(usize, reference - 1)];
    return true;
}

// Compatibility entry points preserve the native and fast-interpreter ABI.
// Both paths call the same operation implementation through an explicit context.

fn im_ok(m: IMState*): bool {
    var execution: IMExecution;
    execution.state = m;
    execution.context = null;
    return ix_ok(&execution);
}

