    value = value / 256;
    p[1] = im_byte(value);
    value = value / 256;
    p[2] = im_byte(value);
    value = value / 256;
    p[3] = im_byte(value);
    var word = size == 4;
    if word {
        return;
    }
    value = value / 256;
    p[4] = im_byte(value);
    value = value / 256;
    p[5] = im_byte(value);
    value = value / 256;
    p[6] = im_byte(value);
    value = value / 256;
    p[7] = im_byte(value);
}

