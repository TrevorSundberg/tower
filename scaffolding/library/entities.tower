import tower;
import entity_types;
import work_buffer;
import work_buffer_types;
import work_budget_types;

var EntityComponentPageBytes: usize = 16384;
var EntityComponentPageRows: usize = 64;
var EntityOwnedPageRows: usize = 32;
var EntityOwnedPageBytes: usize = 4096;

// The owning Tower program supplies its lifecycle dispatch; zero means none.
// IDs belong to that program, not to a process-wide native callback registry.
extern fn tower_entity_finalize(lifecycle: usize, component: EntityComponent*, data: u8*): void;

export fn entity_store_create(): EntityStore* {
    var store: EntityStore* = null;
    entity_store_create_result(null, &store);
    return store;
}

// Reserve before the initial physical allocation. Failure never publishes a
// partial owner or changes output; callers must pass empty output storage.
export fn entity_store_create_result(budget: WorkBudget*, output: EntityStore**): WorkBudgetError {
    if output == null || *output != null { return WorkBudgetError.Invalid; }
    var allocation: WorkBuffer = default;
    var result = work_buffer_resize(&allocation, budget, sizeof(EntityStore), 0);
    if result != WorkBudgetError.None { return result; }
    var store = bits(EntityStore*, allocation.data);
    *store = default;
    store.allocation = allocation;
    store.budget = budget;
    *output = store;
    return WorkBudgetError.None;
}

export fn entity_store_set_context(store: EntityStore*, context: void*): bool {
    if store.entity_count != 0 || store.views != 0 || store.context != null { return false; }
    store.context = context;
    return true;
}

export fn entity_context(node: Entity*): void* {
    if node == null { return null; }
    return node.store.context;
}

// The store is borrowed by its entities and cannot be disposed while any live.
export fn entity_store_dispose(store: EntityStore*): bool {
    var occupied = store.entity_count != 0;
    occupied ||= store.views != 0;
    occupied ||= store.storage.owned != null || store.buffers.owned != null;
    if occupied {
        return false;
    }
    // The allocation receipt lives inside the memory it owns. Copy it before
    // freeing that memory, then release its grant from the local descriptor.
    var allocation = store.allocation;
    work_buffer_dispose(&allocation);
    return true;
}

export fn entity_create(store: EntityStore*): Entity* {
    var error: WorkBudgetError;
    return entity_create_result(store, &error);
}

// Coordinator-only structural mutation. The required receipt belongs to this
// call, not the store or its borrowed budget; success clears a previous error.
export fn entity_create_result(store: EntityStore*, error: WorkBudgetError*): Entity* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if store == null { return null; }
    if store.views != 0 {
        *error = WorkBudgetError.Busy;
        return null;
    }
    var next = store.next_id + 1;
    if next == 0 {
        *error = WorkBudgetError.Exhausted;
        return null;
    }
    var entity = entity_owned_allocate_result(Entity, &store.buffers, store.budget, 1, error);
    if entity == null { return null; }
    *entity = default;
    entity.store = store;
    entity.id = store.next_id;
    entity.references = 1;
    store.next_id = next;
    store.entity_count++;
    *error = WorkBudgetError.None;
    return entity;
}

export fn entity_retain(entity: Entity*): usize {
    if entity.stage != null { return 0; }
    entity.references++;
    return entity.references;
}

// Allocate an unattached entity in an existing entity's store.
export fn entity_create_related(entity: Entity*): Entity* {
    var error: WorkBudgetError;
    return entity_create_related_result(entity, &error);
}

export fn entity_create_related_result(entity: Entity*, error: WorkBudgetError*): Entity* {
    if entity == null { return entity_create_result(null, error); }
    return entity_create_result(entity.store, error);
}

// Ownership must be acyclic. Query cursors are invalidated by structural edits.
export fn entity_release(entity: Entity*): usize {
    if entity.stage != null { return 0; }
    entity.references--;
    var remaining = entity.references;
    if remaining != 0 {
        return remaining;
    }
    var pinned = entity.store.views != 0;
    pinned ||= entity.queued;
    if pinned {
        if !entity.queued {
            entity.deferred = entity.store.deferred;
            entity.store.deferred = entity;
            entity.queued = true;
        }
    } else {
        entity_reclaim(entity);
    }
    return 0;
}

fn entity_reclaim(entity: Entity*): void {
    var store = entity.store;
    store.reclaiming++;
    entity_table_remove_row(entity);
    var i: usize = 0;
    for(; i != entity.child_count; i++) {
        var child = entity.children[i].entity;
        child.parent = null;
        entity_owned_free(entity.children[i].name);
        entity_release(child);
    }
    i = 0;
    for(; i != entity.component_count; i++) {
        entity_component_dispose(entity.components[i]);
    }
    entity_buffer_free(entity.children);
    entity_components_free(entity);
    entity_buffer_free(entity.instances);
    entity_owned_free(entity.layout);
    store.entity_count--;
    entity_owned_free(entity);
    store.reclaiming--;
}

// Opening a view is an owning operation on the store's lifetime. The anchor
// need not be the root; every type index in this same store becomes stable.
// Close exactly once, after all borrowed queries/workers finish.
export fn entity_view_open(anchor: Entity*): EntityView* {
    var error: WorkBudgetError;
    return entity_view_open_result(anchor, &error);
}

export fn entity_view_open_result(anchor: Entity*, error: WorkBudgetError*): EntityView* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if anchor == null || anchor.stage != null { return null; }
    var store = anchor.store;
    if store.reclaiming != 0 {
        *error = WorkBudgetError.Busy;
        return null;
    }
    var next = store.views + 1;
    if next == 0 {
        *error = WorkBudgetError.Exhausted;
        return null;
    }
    var view = entity_owned_allocate_result(EntityView, &store.buffers, store.budget, 1, error);
    if view == null { return null; }
    view.store = store;
    view.queries = null;
    store.views = next;
    *error = WorkBudgetError.None;
    return view;
}

export fn entity_view_close(view: EntityView*): void {
    var store = view.store;
    while view.queries != null {
        var query = view.queries;
        view.queries = query.next;
        entity_table_query_dispose(query);
    }
    entity_owned_free(view);
    store.views--;
    if store.views != 0 {
        return;
    }
    while store.deferred != null {
        var entity = store.deferred;
        store.deferred = entity.deferred;
        entity.deferred = null;
        entity.queued = false;
        if entity.references == 0 {
            entity_reclaim(entity);
        }
    }
}

// A borrowed dense pointer range over the authoritative stable payloads.
// Empty/end batches succeed, invalid/cross-world ranges preserve the output.
export fn entity_view_query(view: EntityView*, type: Entity*, first: usize, count: usize, result: EntityQuery*): bool {
    var invalid = type.store != view.store;
    if invalid {
        return false;
    }
    invalid = first > type.instance_count;
    if invalid {
        return false;
    }
    var remaining = type.instance_count -first;
    invalid = count > remaining;
    if invalid {
        return false;
    }
    var data: EntityComponent** = null;
    if count != 0 {
        data = type.instances + first;
    }
    result.data = data;
    result.length = count;
    return true;
}

// Component types are ordinary entities with a consistent layout/lifecycle.
export fn entity_register(type: Entity*, size: usize, alignment: usize, lifecycle: usize): bool {
    if type == null { return false; }
    return entity_register_stage_result(type, size, alignment, lifecycle,
        type.registered ? type.stage_page_rows : convert(u8, 0)) == WorkBudgetError.None;
}

// Coordinator-only registration, before dispatch. Repeating the same contract
// is read-only; even an empty registered kind cannot change its page policy.
export fn entity_register_stage_result(type: Entity*, size: usize, alignment: usize,
    lifecycle: usize, stage_rows: u8): WorkBudgetError {
    if type == null || alignment == 0 || stage_rows == 1
        || convert(usize, stage_rows) > EntityComponentPageRows { return WorkBudgetError.Invalid; }
    if type.stage != null { return WorkBudgetError.Busy; }
    var mask = alignment -1;
    var bits = alignment &mask;
    if bits != 0 { return WorkBudgetError.Invalid; }
    if type.registered {
        var same = type.layout.data_size == size;
        same &&= type.layout.data_alignment == alignment;
        same &&= type.layout.lifecycle == lifecycle;
        same &&= type.stage_page_rows == stage_rows;
        return same ? WorkBudgetError.None : WorkBudgetError.Busy;
    }
    if type.store.views != 0 { return WorkBudgetError.Busy; }
    // Raw stable storage avoids recursive component/self-kind registration.
    // On denial neither the kind nor its registration flag is published.
    var error: WorkBudgetError;
    var layout = entity_owned_allocate_result(EntityLayout, &type.store.buffers, type.store.budget, 1, &error);
    if layout == null { return error; }
    *layout = { data_size: size, data_alignment: alignment, lifecycle: lifecycle };
    type.layout = layout;
    type.stage_page_rows = stage_rows;
    type.registered = true;
    return WorkBudgetError.None;
}

// Published membership only. This never reads a worker's mutable private
// component list. Borrow under a view across dispatch; payload access still
// requires the scheduler's declared permissions.
export fn entity_component_published(owner: Entity*, type: Entity*): EntityComponent* {
    if type == null || type.store != owner.store || type.stage != null { return null; }
    var table = owner.table;
    if table == null { return null; }
    var column = entity_table_column(table, type.id);
    if column == table.arity { return null; }
    return table.columns[column * table.capacity + owner.table_row];
}

export fn entity_component_get(owner: Entity*, type: Entity*): EntityComponent* {
    var published = entity_component_published(owner, type);
    if published != null || (owner.stage == null && owner.table != null) { return published; }
    // A stage can see its own additions before publication. Reclamation removes
    // the row before invoking finalizers; keep their existing local lookup path.
    var i: usize = 0;
    loop {
        if i == owner.component_count {
            return null;
        }
        var component = owner.components[i];
        if component.type == type {
            return component;
        }
        i++;
    }
}

// Reserve helpers keep indexes separate from component payloads.
fn entity_buffer_free(T: type, data: T*): void {
    if data == null { return; }
    var header = bits(EntityBufferAllocation*, bits(u8*, data) - sizeof(EntityBufferAllocation));
    var allocation = header.allocation;
    work_buffer_dispose(&allocation);
}

fn entity_components_free(owner: Entity*): void {
    if owner.components != &owner.inline_components[0] { entity_buffer_free(owner.components); }
}

fn entity_buffer_resize_result(T: type, budget: WorkBudget*, data: T*, count: usize,
    preserve: usize, error: WorkBudgetError*): T* {
    *error = WorkBudgetError.Invalid;
    var header = sizeof(EntityBufferAllocation);
    if preserve > count || count > (~convert(usize, 0) - header) / sizeof(T)
        || alignof(T) > compiler_buffer_alignment() || header % alignof(T) != 0 { return null; }
    if data == null && preserve != 0 { return null; }
    if data != null {
        var previous = bits(EntityBufferAllocation*, bits(u8*, data) - header);
        if previous.allocation.reservation.owner != budget
            || preserve * sizeof(T) > previous.allocation.capacity - header { return null; }
    }
    var allocation: WorkBuffer = default;
    *error = work_buffer_resize(&allocation, budget, header + count * sizeof(T), 0);
    if *error != WorkBudgetError.None { return null; }
    var result = bits(T*, allocation.data + header);
    if preserve != 0 { copy(result, data, preserve * sizeof(T)); }
    bits(EntityBufferAllocation*, allocation.data).allocation = allocation;
    entity_buffer_free(data);
    return result;
}

fn entity_reserve_components(budget: WorkBudget*, data: EntityComponent***, capacity: usize*, count: usize): WorkBudgetError {
    if count < *capacity {
        return WorkBudgetError.None;
    }
    var next = *capacity *2;
    if count > *capacity || next < *capacity {
        return WorkBudgetError.Invalid;
    }
    if next < 4 {
        next = 4;
    }
    if next > ~convert(usize, 0) / sizeof(EntityComponent*) { return WorkBudgetError.Invalid; }
    var error: WorkBudgetError;
    var memory = entity_buffer_resize_result(budget, *data, next, count, &error);
    if memory == null { return error; }
    *data = memory;
    *capacity = next;
    return WorkBudgetError.None;
}

fn entity_component_page_detach(page: EntityComponentPage*): void {
    if page.pool == null { return; }
    if page.previous != null { page.previous.next = page.next; }
    else { page.pool.first = page.next; }
    if page.next != null { page.next.previous = page.previous; }
    page.pool = null;
    page.previous = null;
    page.next = null;
}

fn entity_component_page_attach(page: EntityComponentPage*, pool: EntityComponentPool*): void {
    page.pool = pool;
    page.previous = null;
    page.next = pool.first;
    if pool.first != null { pool.first.previous = page; }
    pool.first = page;
}

fn entity_component_page_own(page: EntityComponentPage*, pool: EntityComponentPool*): void {
    page.owner = pool;
    page.owned_previous = null;
    page.owned_next = pool.owned;
    if pool.owned != null { pool.owned.owned_previous = page; }
    pool.owned = page;
}

fn entity_component_page_disown(page: EntityComponentPage*): void {
    if page.owned_previous != null { page.owned_previous.owned_next = page.owned_next; }
    else { page.owner.owned = page.owned_next; }
    if page.owned_next != null { page.owned_next.owned_previous = page.owned_previous; }
    page.owner = null;
    page.owned_previous = null;
    page.owned_next = null;
}

// Move full and partial physical owners after joins, as well as the available
// slot index. No page may retain a pointer to a destroyed private stage.
fn entity_component_pool_transfer(source: EntityComponentPool*, target: EntityComponentPool*): void {
    while source.owned != null {
        var page = source.owned;
        entity_component_page_detach(page);
        entity_component_page_disown(page);
        entity_component_page_own(page, target);
        if page.live < page.capacity { entity_component_page_attach(page, target); }
    }
}

fn entity_storage_allocate(pool: EntityComponentPool*, budget: WorkBudget*, id: usize,
    size: usize, alignment: usize, rows: usize, page_bytes: usize, error: WorkBudgetError*): EntityComponent* {
    *error = WorkBudgetError.Invalid;
    var pointer_size = sizeof(EntityComponent*);
    if alignment < pointer_size { alignment = pointer_size; }
    var mask = alignment - 1;
    var maximum = ~convert(usize, 0);
    if size > maximum - pointer_size { return null; }
    var bytes = size + pointer_size;
    if bytes > maximum - mask { return null; }
    var stride = (bytes + mask) & ~mask;
    if stride > maximum - sizeof(EntityComponent) { return null; }
    var slot = stride + sizeof(EntityComponent);
    var capacity = page_bytes / slot;
    if capacity > rows { capacity = rows; }
    var component: EntityComponent* = null;
    var data: u8* = null;
    if capacity >= 2 {
        var page = pool.first;
        while page != null && (page.type_id != id || page.stride != stride) { page = page.next; }
        if page == null {
            // capacity*slot is bounded by the page byte policy. Header/alignment
            // overhead is also bounded here because at least two slots fit.
            bytes = sizeof(EntityComponentPage) + capacity * slot + pointer_size + mask;
            var allocation: WorkBuffer = default;
            *error = work_buffer_resize(&allocation, budget, bytes, 0);
            if *error != WorkBudgetError.None { return null; }
            page = bits(EntityComponentPage*, allocation.data);
            *page = default;
            page.allocation = allocation; // Transfer this physical grant to the page.
            page.type_id = id;
            page.capacity = capacity;
            page.stride = stride;
            page.components = bits(EntityComponent*, allocation.data + sizeof(EntityComponentPage));
            var start = bits(usize, page.components + capacity) + pointer_size;
            page.data = bits(u8*, (start + mask) & ~mask);
            entity_component_page_own(page, pool);
            entity_component_page_attach(page, pool);
        }
        var index = page.used;
        if page.free_slot != 0 {
            index = page.free_slot - 1;
            page.free_slot = page.components[index].type_index;
        } else { page.used++; }
        component = &page.components[index];
        data = page.data + index * page.stride;
        component.allocation = bits(u8*, page);
        component.page = page;
        page.live++;
        if page.live == page.capacity { entity_component_page_detach(page); }
    } else {
        // Large or highly aligned payloads preserve the individually allocated
        // path; never reserve multiple large objects just to fill a page.
        if bytes + mask > maximum - sizeof(EntityComponentAllocation) { return null; }
        var allocation: WorkBuffer = default;
        *error = work_buffer_resize(&allocation, budget,
            bytes + mask + sizeof(EntityComponentAllocation), 0);
        if *error != WorkBudgetError.None { return null; }
        var owned = bits(EntityComponentAllocation*, allocation.data);
        owned.allocation = allocation;
        component = &owned.component;
        var start = bits(usize, allocation.data + sizeof(EntityComponentAllocation)) + pointer_size;
        data = bits(u8*, (start + mask) & ~mask);
        component.allocation = allocation.data;
        component.page = null;
    }
    var back = bits(EntityComponent**, data);
    back--;
    *back = component;
    component.owner = null;
    component.type = null;
    component.data = data;
    *error = WorkBudgetError.None;
    return component;
}

fn entity_component_allocate(owner: Entity*, type: Entity*, error: WorkBudgetError*): EntityComponent* {
    var pool = owner.storage;
    if owner.stage != null && pool == null { *error = WorkBudgetError.Invalid; return null; }
    if pool == null { pool = &owner.store.storage; }
    var rows = EntityComponentPageRows;
    if owner.stage != null && type.stage_page_rows != 0 { rows = convert(usize, type.stage_page_rows); }
    var component = entity_storage_allocate(pool, owner.store.budget, type.id, type.layout.data_size,
        type.layout.data_alignment, rows, EntityComponentPageBytes, error);
    if component != null { component.owner = owner; component.type = type; }
    return component;
}

// Separate nonsemantic pool: zero is a local size-class tag, never an entity ID.
// Use one alignment for these ordinary descriptor/name blocks so equal strides
// share slots safely. Oversized blocks keep the existing single-buffer owner.
fn entity_owned_allocate_result(T: type, pool: EntityComponentPool*, budget: WorkBudget*, count: usize,
    error: WorkBudgetError*): T* {
    if count > ~convert(usize, 0) / sizeof(T) || alignof(T) > compiler_buffer_alignment() {
        *error = WorkBudgetError.Invalid; return null;
    }
    var block = entity_storage_allocate(pool, budget, 0, count * sizeof(T), compiler_buffer_alignment(),
        EntityOwnedPageRows, EntityOwnedPageBytes, error);
    return block == null ? null : bits(T*, block.data);
}

fn entity_owned_free(T: type, data: T*): void {
    if data != null { entity_component_free(entity_component_from_data(bits(u8*, data))); }
}

// Called only by the coordinator, or when discarding a joined private stage.
// Active partial pages unlink before their last component frees the allocation.
fn entity_component_free(component: EntityComponent*): void {
    var page = component.page;
    if page == null {
        var allocation = bits(EntityComponentAllocation*, component.allocation).allocation;
        work_buffer_dispose(&allocation);
        return;
    }
    page.live--;
    if page.live == 0 {
        entity_component_page_detach(page);
        entity_component_page_disown(page);
        var allocation = page.allocation;
        work_buffer_dispose(&allocation);
        return;
    }
    // Index removal and finalization finish before this call. Only a dead
    // descriptor's type_index becomes a free link; surviving addresses stay put.
    var index = (bits(usize, component) - bits(usize, page.components)) / sizeof(EntityComponent);
    component.type_index = page.free_slot;
    page.free_slot = index + 1;
    if page.pool == null {
        entity_component_page_attach(page, page.owner);
    }
}

export fn entity_component_add(owner: Entity*, type: Entity*): EntityComponent* {
    var error: WorkBudgetError;
    return entity_component_add_result(owner, type, &error);
}

// A private stage owns its own mutation. Published owners require an unpinned
// store and coordinator access. The receipt never writes shared store state.
export fn entity_component_add_result(owner: Entity*, type: Entity*, error: WorkBudgetError*): EntityComponent* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if owner == null || type == null { return null; }
    var present = entity_component_get(owner, type);
    if present != null {
        *error = WorkBudgetError.None;
        return present;
    }
    var staged = owner.stage != null;
    var pinned = owner.store.views != 0 && !staged;
    if pinned {
        *error = WorkBudgetError.Busy;
        return null;
    }
    if owner.store != type.store {
        return null;
    }
    var unregistered = !type.registered || type.stage != null;
    if unregistered {
        return null;
    }
    if owner.components == null {
        owner.components = &owner.inline_components[0];
        owner.component_capacity = sizeof(decltype(owner.inline_components)) / sizeof(EntityComponent*);
    }
    // Keep the inline index intact until payload/table preparation succeeds.
    // The pending array owns a new receipt; inline storage is charged with its
    // stable descriptor page and must never enter the buffer resize/free path.
    var pending: EntityComponent** = null;
    var capacity: usize = 0;
    defer entity_buffer_free(pending);
    *error = WorkBudgetError.None;
    if owner.components == &owner.inline_components[0] {
        if owner.component_count == owner.component_capacity {
            *error = entity_reserve_components(owner.store.budget, &pending, &capacity, 0);
            if *error == WorkBudgetError.None {
                copy(pending, owner.components, owner.component_count * sizeof(EntityComponent*));
            }
        }
    } else {
        *error = entity_reserve_components(owner.store.budget, &owner.components, &owner.component_capacity, owner.component_count);
    }
    if *error == WorkBudgetError.None && !staged {
        *error = entity_reserve_components(owner.store.budget, &type.instances, &type.instance_capacity, type.instance_count);
    }
    if *error != WorkBudgetError.None { return null; }
    var component = entity_component_allocate(owner, type, error);
    if component == null { return null; }
    if !staged { *error = entity_table_prepare_result(owner, type, null); }
    if *error != WorkBudgetError.None {
        entity_component_free(component);
        return null;
    }
    if pending != null {
        owner.components = pending;
        owner.component_capacity = capacity;
        pending = null;
    }
    component.type_index = type.instance_count;
    if staged { component.type_index = ~convert(usize, 0); }
    owner.components[owner.component_count] = component;
    owner.component_count++;
    if !staged {
        type.instances[type.instance_count] = component;
        type.instance_count++;
        entity_retain(type);
        owner.store.component_count++;
        entity_table_publish(owner);
    }
    return component;
}

fn entity_component_dispose(component: EntityComponent*): void {
    var type = component.type;
    type.instance_count--;
    var last = type.instances[type.instance_count];
    type.instances[component.type_index] = last;
    last.type_index = component.type_index;
    if type.layout.lifecycle != 0 {
        tower_entity_finalize(type.layout.lifecycle, component, component.data);
    }
    var store = type.store;
    store.component_count--;
    entity_component_free(component);
    entity_release(type);
}

export fn entity_component_remove(owner: Entity*, type: Entity*): bool {
    return entity_component_remove_result(owner, type) == WorkBudgetError.None;
}

export fn entity_component_remove_result(owner: Entity*, type: Entity*): WorkBudgetError {
    if owner == null || type == null || owner.store != type.store { return WorkBudgetError.Invalid; }
    if owner.stage != null { return WorkBudgetError.Busy; }
    var pinned = owner.store.views != 0;
    if pinned {
        return WorkBudgetError.Busy;
    }
    var i: usize = 0;
    loop {
        if i == owner.component_count {
            return WorkBudgetError.Invalid;
        }
        var component = owner.components[i];
        if component.type == type {
            var error = entity_table_prepare_result(owner, null, type);
            if error != WorkBudgetError.None { return error; }
            owner.component_count--;
            var following = i + 1;
            var count = owner.component_count -i;
            var bytes = count *sizeof(EntityComponent*);
            copy(&owner.components[i], &owner.components[following], bytes);
            entity_table_publish(owner);
            entity_component_dispose(component);
            return WorkBudgetError.None;
        }
        i++;
    }
}

export fn entity_component_data(component: EntityComponent*): u8* {
    if component == null {
        return null;
    }
    return component.data;
}

export fn entity_component_from_data(data: u8*): EntityComponent* {
    if data == null {
        return null;
    }
    var back = bits(EntityComponent **, data);
    back--;
    return *back;
}

export fn entity_query_count(type: Entity*): usize {
    return type.instance_count;
}

export fn entity_query_at(type: Entity*, index: usize): EntityComponent* {
    if index >= type.instance_count {
        return null;
    }
    return type.instances[index];
}

fn entity_name_equal(left: u8*, right: u8*): bool {
    var missing = left == null;
    if missing {
        var both_missing = right == null;
        return both_missing;
    }
    missing = right == null;
    if missing {
        return false;
    }
    var i: usize = 0;
    loop {
        if left[i] != right[i] {
            return false;
        }
        if left[i] == 0 {
            return true;
        }
        i++;
    }
}

export fn entity_child_index(parent: Entity*, child: Entity*): usize {
    var i: usize = 0;
    loop {
        if i == parent.child_count {
            var invalid: usize = 0;
            invalid--;
            return invalid;
        }
        if parent.children[i].entity == child {
            return i;
        }
        i++;
    }
}

export fn entity_member_index(parent: Entity*, name: u8*): usize {
    var i: usize = 0;
    loop {
        if i == parent.child_count {
            var invalid: usize = 0;
            invalid--;
            return invalid;
        }
        if entity_name_equal(parent.children[i].name, name) {
            return i;
        }
        i++;
    }
}

fn entity_unlink(child: Entity*): void {
    var parent = child.parent;
    var index = parent.child_count - 1;
    if parent.children[index].entity != child { index = entity_child_index(parent, child); }
    entity_owned_free(parent.children[index].name);
    parent.child_count--;
    var following = index + 1;
    var count = parent.child_count -index;
    var bytes = count *sizeof(EntityChild);
    copy(&parent.children[index], &parent.children[following], bytes);
    child.parent = null;
}

// Ordered, named containment owns children. Other semantic links remain borrowed.
// Reserve/copy before changing ownership; a failed allocation leaves links intact.
export fn entity_attach(child: Entity*, parent: Entity*, name: u8*): bool {
    return entity_attach_result(child, parent, name) == WorkBudgetError.None;
}

export fn entity_attach_result(child: Entity*, parent: Entity*, name: u8*): WorkBudgetError {
    if child == null || child == parent { return WorkBudgetError.Invalid; }
    if parent != null && parent.store != child.store { return WorkBudgetError.Invalid; }
    if child.stage != null || (parent != null && parent.stage != null)
        || (child.parent != null && child.parent.stage != null)
        || child.store.views != 0 { return WorkBudgetError.Busy; }
    var attached = child.parent != null;
    var attaching = parent != null;
    var maximum = ~convert(usize, 0);
    if attaching && !attached && child.references == maximum { return WorkBudgetError.Exhausted; }
    var named: u8* = null;
    var replaced: Entity* = null;
    if attaching {
        if name != null && *name != 0 {
            var previous = entity_member_index(parent, name);
            if previous < parent.child_count {
                replaced = parent.children[previous].entity;
                if replaced.stage != null { return WorkBudgetError.Busy; }
            }
        }
        if parent.child_count == parent.child_capacity {
            var limit = maximum / sizeof(EntityChild);
            if parent.child_capacity > limit / 2 { return WorkBudgetError.Invalid; }
            var capacity = parent.child_capacity *2;
            if capacity < 4 {
                capacity = 4;
            }
            var error: WorkBudgetError;
            var next = entity_buffer_resize_result(parent.store.budget, parent.children, capacity, parent.child_count, &error);
            if next == null { return error; }
            parent.children = next;
            parent.child_capacity = capacity;
        }
        var has_name = name != null;
        has_name &&= *name != 0;
        if has_name {
            var length: usize = 0;
            for(; name[length] != 0; length++) {
                if length == maximum { return WorkBudgetError.Invalid; }
            }
            if length == maximum { return WorkBudgetError.Invalid; }
            length++;
            var error: WorkBudgetError;
            named = entity_owned_allocate_result(u8, &parent.store.buffers, parent.store.budget, length, &error);
            if named == null { return error; }
            copy(named, name, length);
        }
    }
    if attached {
        // Transfer the old parent's reference directly to the new relationship.
        entity_unlink(child);
    } else {
        if attaching {
            entity_retain(child);
        }
    }
    if attaching {
        if replaced != null && replaced != child {
            entity_unlink(replaced);
            entity_release(replaced);
        }
        parent.children[parent.child_count].entity = child;
        parent.children[parent.child_count].name = named;
        parent.child_count++;
        child.parent = parent;
    } else {
        if attached {
            entity_release(child);
        }
    }
    return WorkBudgetError.None;
}

export fn entity_replace_child(parent: Entity*, index: usize, replacement: Entity*): bool {
    return entity_replace_child_result(parent, index, replacement) == WorkBudgetError.None;
}

export fn entity_replace_child_result(parent: Entity*, index: usize, replacement: Entity*): WorkBudgetError {
    if parent == null || replacement == null || index >= parent.child_count
        || replacement.parent != null || replacement == parent
        || replacement.store != parent.store { return WorkBudgetError.Invalid; }
    var previous = parent.children[index].entity;
    if parent.stage != null || replacement.stage != null || previous.stage != null
        || parent.store.views != 0 { return WorkBudgetError.Busy; }
    if replacement.references == ~convert(usize, 0) { return WorkBudgetError.Exhausted; }
    entity_retain(replacement);
    replacement.parent = parent;
    parent.children[index].entity = replacement;
    previous.parent = null;
    entity_release(previous);
    return WorkBudgetError.None;
}

export fn entity_take_last_child(parent: Entity*): Entity* {
    var error: WorkBudgetError;
    return entity_take_last_child_result(parent, &error);
}

// Transfer the parent's existing reference; no allocation or retain is needed.
// None with a null result means a valid, empty parent.
export fn entity_take_last_child_result(parent: Entity*, error: WorkBudgetError*): Entity* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if parent == null { return null; }
    *error = WorkBudgetError.Busy;
    if parent.stage != null || parent.store.views != 0 { return null; }
    if parent.child_count == 0 { *error = WorkBudgetError.None; return null; }
    var child = parent.children[parent.child_count - 1].entity;
    if child.stage != null { return null; }
    parent.child_count--;
    entity_owned_free(parent.children[parent.child_count].name);
    child.parent = null;
    *error = WorkBudgetError.None;
    return child;
}

export fn entity_id(entity: Entity*): usize {
    return entity.id;
}

export fn entity_references(entity: Entity*): usize {
    return entity.references;
}

export fn entity_parent(entity: Entity*): Entity* {
    return entity.parent;
}

export fn entity_child_count(entity: Entity*): usize {
    return entity.child_count;
}

export fn entity_child_at(entity: Entity*, index: usize): Entity* {
    if index >= entity.child_count {
        return null;
    }
    return entity.children[index].entity;
}

export fn entity_child_name(entity: Entity*, index: usize): u8* {
    if index >= entity.child_count {
        return null;
    }
    return entity.children[index].name;
}

export fn entity_component_count(entity: Entity*): usize {
    return entity.component_count;
}

export fn entity_component_at(entity: Entity*, index: usize): EntityComponent* {
    if index >= entity.component_count {
        return null;
    }
    return entity.components[index];
}

export fn entity_component_owner(component: EntityComponent*): Entity* {
    return component.owner;
}

export fn entity_component_type(component: EntityComponent*): Entity* {
    return component.type;
}

export fn entity_store_count(store: EntityStore*): usize {
    return store.entity_count;
}

export fn entity_store_component_count(store: EntityStore*): usize {
    return store.component_count;
}

// Derived archetype membership. Columns point at stable canonical components;
// they do not copy payloads or introduce another semantic graph. Only published
// membership is indexed, and all table mutation happens without pinned views.
fn entity_table_column(table: EntityTable*, id: usize): usize {
    var low: usize = 0;
    var high = table.arity;
    while low < high {
        var middle = low + (high - low) / 2;
        if table.types[middle] < id { low = middle + 1; }
        else { high = middle; }
    }
    if low < table.arity && table.types[low] == id { return low; }
    return table.arity;
}

fn entity_table_hash(id: usize): usize {
    id ^= id >> 16;
    id *= 73244475;
    id ^= id >> 16;
    return id;
}

fn entity_table_prune(table: EntityTable*): void {
    if table == null || table.length != 0 || table.pending != 0 { return; }
    var store = table.store;
    var bucket = table.hash & 255;
    var link = &store.tables[bucket];
    while *link != table { link = &(*link).next; }
    *link = table.next;
    entity_buffer_free(table.rows);
    entity_owned_free(table.types);
    entity_owned_free(table);
}

fn entity_table_reserve(table: EntityTable*, count: usize): WorkBudgetError {
    if count <= table.capacity { return WorkBudgetError.None; }
    var maximum = ~convert(usize, 0);
    if table.arity == maximum { return WorkBudgetError.Invalid; }
    var columns = table.arity + 1;
    if columns > maximum / sizeof(void*) { return WorkBudgetError.Invalid; }
    var stride = columns * sizeof(void*);
    if count > maximum / stride { return WorkBudgetError.Invalid; }
    var capacity = table.capacity;
    if capacity < 4 { capacity = 4; }
    while capacity < count {
        if capacity > maximum / 2 { capacity = count; break; }
        capacity *= 2;
    }
    if capacity > maximum / stride { capacity = count; }
    var error: WorkBudgetError;
    var memory = entity_buffer_resize_result(u8, table.store.budget, null, capacity * stride, 0, &error);
    if memory == null { return error; }
    var rows = bits(Entity**, memory);
    var data = bits(EntityComponent**, rows + capacity);
    if table.length != 0 {
        copy(rows, table.rows, table.length * sizeof(Entity*));
        for(var i: usize = 0; i < table.arity; i++) {
            copy(data + i * capacity, table.columns + i * table.capacity,
                table.length * sizeof(EntityComponent*));
        }
    }
    entity_buffer_free(table.rows);
    table.rows = rows;
    table.columns = data;
    table.capacity = capacity;
    return WorkBudgetError.None;
}

fn entity_table_matches(table: EntityTable*, owner: Entity*, added: Entity*, removed: Entity*): bool {
    if added != null && entity_table_column(table, added.id) == table.arity { return false; }
    for(var i: usize = 0; i < owner.component_count; i++) {
        var type = owner.components[i].type;
        if type != removed && entity_table_column(table, type.id) == table.arity { return false; }
    }
    return true;
}

// Reserve a destination without changing published rows or canonical membership.
// Pending reservations protect empty destination tables throughout a stage batch.
fn entity_table_prepare(owner: Entity*, added: Entity*, removed: Entity*): bool {
    return entity_table_prepare_result(owner, added, removed) == WorkBudgetError.None;
}

fn entity_table_prepare_result(owner: Entity*, added: Entity*, removed: Entity*): WorkBudgetError {
    var count = owner.component_count;
    var maximum = ~convert(usize, 0);
    if (added != null && count == maximum) || (removed != null && count == 0) {
        return WorkBudgetError.Invalid;
    }
    if added != null { count++; }
    if removed != null { count--; }
    if count == 0 { owner.pending_table = null; return WorkBudgetError.None; }
    if count > maximum / sizeof(usize) { return WorkBudgetError.Invalid; }
    var hash: usize = 0;
    for(var i: usize = 0; i < owner.component_count; i++) {
        var type = owner.components[i].type;
        if type != removed { hash += entity_table_hash(type.id); }
    }
    if added != null { hash += entity_table_hash(added.id); }
    var store = owner.store;
    var bucket = hash & 255;
    var table = store.tables[bucket];
    while table != null {
        if table.hash == hash && table.arity == count && entity_table_matches(table, owner, added, removed) { break; }
        table = table.next;
    }
    if table == null {
        var error: WorkBudgetError;
        table = entity_owned_allocate_result(EntityTable, &store.buffers, store.budget, 1, &error);
        if table == null { return error; }
        *table = default;
        table.types = entity_owned_allocate_result(usize, &store.buffers, store.budget, count, &error);
        if table.types == null { entity_owned_free(table); return error; }
        table.store = store;
        table.hash = hash;
        table.arity = count;
        var next: usize = 0;
        for(var i: usize = 0; i < owner.component_count; i++) {
            var type = owner.components[i].type;
            if type != removed { table.types[next++] = type.id; }
        }
        if added != null { table.types[next] = added.id; }
        for(var i: usize = 1; i < count; i++) {
            var id = table.types[i];
            var j = i;
            while j != 0 && table.types[j - 1] > id {
                table.types[j] = table.types[j - 1];
                j--;
            }
            table.types[j] = id;
        }
        table.next = store.tables[bucket];
        store.tables[bucket] = table;
    }
    if table.pending == maximum || table.length > maximum - table.pending - 1 {
        entity_table_prune(table);
        return WorkBudgetError.Invalid;
    }
    var result = entity_table_reserve(table, table.length + table.pending + 1);
    if result != WorkBudgetError.None {
        entity_table_prune(table);
        return result;
    }
    table.pending++;
    owner.pending_table = table;
    return WorkBudgetError.None;
}

fn entity_table_unprepare(owner: Entity*): void {
    var table = owner.pending_table;
    owner.pending_table = null;
    if table != null { table.pending--; entity_table_prune(table); }
}

fn entity_table_remove_row(owner: Entity*): void {
    var table = owner.table;
    if table == null { return; }
    table.length--;
    var row = owner.table_row;
    if row != table.length {
        var moved = table.rows[table.length];
        table.rows[row] = moved;
        moved.table_row = row;
        for(var i: usize = 0; i < table.arity; i++) {
            var column = table.columns + i * table.capacity;
            column[row] = column[table.length];
        }
    }
    owner.table = null;
    owner.table_row = 0;
    entity_table_prune(table);
}

// Membership is committed only after every allocation succeeds. Empty entities
// have no table; nonempty entities have exactly one full component signature.
fn entity_table_publish(owner: Entity*): void {
    var table = owner.pending_table;
    if table == owner.table { entity_table_unprepare(owner); return; }
    entity_table_remove_row(owner);
    owner.pending_table = null;
    if table == null { return; }
    table.pending--;
    owner.table = table;
    owner.table_row = table.length;
    table.rows[table.length] = owner;
    for(var i: usize = 0; i < owner.component_count; i++) {
        var component = owner.components[i];
        var column = entity_table_column(table, component.type.id);
        table.columns[column * table.capacity + table.length] = component;
    }
    table.length++;
}
// Query plans are immutable once returned and cached only inside their owning
// pin. Closing the view releases every plan, so structural edits cannot leave
// dangling cached table pointers. The coordinator builds plans before dispatch.
fn entity_table_query_matches(table: EntityTable*, terms: Entity**, count: usize): bool {
    for(var i: usize = 0; i < count; i++) {
        if entity_table_column(table, terms[i].id) == table.arity { return false; }
    }
    return true;
}

fn entity_table_query_dispose(query: EntityTableQuery*): void {
    entity_owned_free(query.types);
    entity_owned_free(query.matches);
    entity_owned_free(query.columns);
    entity_owned_free(query);
}

export fn entity_view_tables(view: EntityView*, terms: Entity**, count: usize): EntityTableQuery* {
    var error: WorkBudgetError;
    return entity_view_tables_result(view, terms, count, &error);
}

export fn entity_view_tables_result(view: EntityView*, terms: Entity**, count: usize,
    error: WorkBudgetError*): EntityTableQuery* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if view == null { return null; }
    if count == 0 || count > ~convert(usize, 0) / sizeof(usize) || terms == null { return null; }
    for(var i: usize = 0; i < count; i++) {
        var type = terms[i];
        if type == null || type.store != view.store || !type.registered || type.stage != null { return null; }
        for(var j: usize = 0; j < i; j++) { if terms[j] == type { return null; } }
    }
    var query = view.queries;
    while query != null {
        var same = query.arity == count;
        for(var i: usize = 0; same && i < count; i++) { same = query.types[i] == terms[i].id; }
        if same { *error = WorkBudgetError.None; return query; }
        query = query.next;
    }
    query = entity_owned_allocate_result(EntityTableQuery, &view.store.buffers, view.store.budget, 1, error);
    if query == null { return null; }
    *query = default;
    query.arity = count;
    query.types = entity_owned_allocate_result(usize, &view.store.buffers, view.store.budget, count, error);
    if query.types == null { entity_table_query_dispose(query); return null; }
    for(var i: usize = 0; i < count; i++) { query.types[i] = terms[i].id; }
    var maximum = ~convert(usize, 0);
    for(var bucket: usize = 0; bucket < 256; bucket++) {
        var table = view.store.tables[bucket];
        while table != null {
            if table.length != 0 && entity_table_query_matches(table, terms, count) {
                if query.length > maximum - table.length || query.count == maximum {
                    *error = WorkBudgetError.Invalid;
                    entity_table_query_dispose(query); return null;
                }
                query.length += table.length;
                query.count++;
            }
            table = table.next;
        }
    }
    if query.count != 0 {
        if query.count > maximum / count / sizeof(usize) || query.count > maximum / sizeof(EntityTableMatch) {
            *error = WorkBudgetError.Invalid;
            entity_table_query_dispose(query); return null;
        }
        query.matches = entity_owned_allocate_result(EntityTableMatch, &view.store.buffers, view.store.budget, query.count, error);
        if query.matches == null { entity_table_query_dispose(query); return null; }
        query.columns = entity_owned_allocate_result(usize, &view.store.buffers, view.store.budget, query.count * count, error);
        if query.columns == null { entity_table_query_dispose(query); return null; }
    }
    var next: usize = 0;
    var first: usize = 0;
    for(var bucket: usize = 0; bucket < 256; bucket++) {
        var table = view.store.tables[bucket];
        while table != null {
            if table.length != 0 && entity_table_query_matches(table, terms, count) {
                var entry = &query.matches[next];
                entry.table = table;
                entry.first = first;
                entry.columns = query.columns + next * count;
                for(var i: usize = 0; i < count; i++) { entry.columns[i] = entity_table_column(table, terms[i].id); }
                first += table.length;
                next++;
            }
            table = table.next;
        }
    }
    query.next = view.queries;
    view.queries = query;
    *error = WorkBudgetError.None;
    return query;
}

export fn entity_table_query_count(query: EntityTableQuery*): usize { return query.length; }
export fn entity_table_query_ranges(query: EntityTableQuery*): usize { return query.count; }

export fn entity_table_query_range(query: EntityTableQuery*, index: usize, first: usize, count: usize,
    result: EntityTableRange*): bool {
    if index >= query.count { return false; }
    var entry = &query.matches[index];
    if first > entry.table.length || count > entry.table.length - first { return false; }
    result.table = entry.table;
    result.columns = entry.columns;
    result.arity = query.arity;
    result.first = first;
    result.length = count;
    return true;
}

export fn entity_table_range_column(range: EntityTableRange*, term: usize): EntityComponent** {
    if term >= range.arity || range.length == 0 { return null; }
    return range.table.columns + range.columns[term] * range.table.capacity + range.first;
}

export fn entity_table_range_rows(range: EntityTableRange*): Entity** {
    if range.length == 0 { return null; }
    return range.table.rows + range.first;
}

export fn entity_table_query_component(query: EntityTableQuery*, row: usize, term: usize): EntityComponent* {
    if row >= query.length || term >= query.arity { return null; }
    var low: usize = 0;
    var high = query.count;
    while low + 1 < high {
        var middle = low + (high - low) / 2;
        if query.matches[middle].first <= row { low = middle; }
        else { high = middle; }
    }
    var entry = &query.matches[low];
    return entry.table.columns[entry.columns[term] * entry.table.capacity + row - entry.first];
}

export fn entity_table_query_range_count(query: EntityTableQuery*, index: usize): usize {
    if index >= query.count { return 0; }
    return query.matches[index].table.length;
}

export fn entity_table_query_column(query: EntityTableQuery*, index: usize, term: usize): EntityComponent** {
    if index >= query.count || term >= query.arity { return null; }
    var entry = &query.matches[index];
    return entry.table.columns + entry.columns[term] * entry.table.capacity;
}
