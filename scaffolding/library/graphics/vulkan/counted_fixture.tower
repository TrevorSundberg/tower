import tower;
import counted_run;
import indexed_draw;
import readback_abi;
import .indexed_indirect;

fn counted_direct(draw: VkCmdDrawIndexedIndirectCountProc, cmd: VkCommandBufferHandle*,
    stream: VulkanIndirectBuffer, commands: IndexedIndirectRange, accept: bool): bool {
    return vk_record_indexed_indirect_count(draw, cmd, stream, commands, stream, 0) == accept;
}

export fn main(argc: i32, argv: u8**): i32 {
    return counted_main(argc, argv, counted_direct);
}
