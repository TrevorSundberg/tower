import tower;
import counted_run;
import counted_calls;
import shader_module;
import indexed_draw;
import command_begin;
import command_end;
import frame_submit;
import readback_oracle;

export fn main(argc: i32, argv: u8**): i32 {
    if argc < 2 { puts("usage: counted_fixture draw14 | counted-core13 compute.spv vertex.spv fragment.spv"); return 2; }
    var strict = strcmp(argv[1], "draw14") == 0;
    if strict {
        if argc != 2 { puts("draw14 takes no shader paths"); return 2; }
    } else {
        if strcmp(argv[1], "counted-core13") != 0 || argc != 5 {
            puts("expected counted-core13 compute.spv vertex.spv fragment.spv"); return 2;
        }
    }
    var calls: CountedCalls = { create_shader: vk_create_shader_module, record_draw: vk_record_indexed_indirect_count,
        begin: tower_vk_command_begin_v1, prepare: tower_vk_command_end_for_submit_v1, submit: tower_vk_queue_submit_one_v1 };
    return counted_run(&calls, strict, argv + 2);
}
