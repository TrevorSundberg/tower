import tower;
import readback_abi;
import counted_abi;

import synchronization2_abi;

export fn tower_vk_buffer_upload_record_v1(cmd: VkCommandBufferHandle*, staging: VkBufferHandle*,
    dst: VkBufferHandle*, size: u64): void {
    var region: VkBufferCopy = { size: size, ..default };
    vkCmdCopyBuffer(cmd, staging, dst, 1, &region);
    var memory: VkMemoryBarrier2 = { sType: VkMemoryBarrier2Tag,
        srcStageMask: VkStage2Transfer, srcAccessMask: VkAccess2TransferWrite,
        dstStageMask: VkStage2AllCommands, dstAccessMask: VkAccess2MemoryRead, ..default };
    var dependency: VkDependencyInfo = { sType: VkDependencyInfoTag,
        memoryBarrierCount: 1, pMemoryBarriers: &memory, ..default };
    vkCmdPipelineBarrier2(cmd, &dependency);
}
