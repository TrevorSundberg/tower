import tower;
import readback_abi;
import counted_abi;

// Vulkan 1.3 core ABI, from vulkan_core.h. See readback_abi_license.txt.
struct VkMemoryBarrier2 {
    sType: u32; pNext: void*;
    srcStageMask: u64; srcAccessMask: u64; dstStageMask: u64; dstAccessMask: u64;
}
struct VkBufferMemoryBarrier2 {}
struct VkImageMemoryBarrier2 {}
struct VkDependencyInfo {
    sType: u32; pNext: void*; dependencyFlags: u32;
    memoryBarrierCount: u32; pMemoryBarriers: VkMemoryBarrier2*;
    bufferMemoryBarrierCount: u32; pBufferMemoryBarriers: VkBufferMemoryBarrier2*;
    imageMemoryBarrierCount: u32; pImageMemoryBarriers: VkImageMemoryBarrier2*;
}
extern fn vkCmdPipelineBarrier2(cmd: VkCommandBufferHandle*, dependency: VkDependencyInfo*): void;

var VkMemoryBarrier2Tag: u32 = 1000314000;
var VkDependencyInfoTag: u32 = 1000314003;
var VkStage2Transfer: u64 = 4096;
var VkAccess2TransferWrite: u64 = 4096;
var VkStage2AllCommands: u64 = 65536;
var VkAccess2MemoryRead: u64 = 32768;

export fn tower_vk_buffer_upload_record_v1(cmd: VkCommandBufferHandle*, staging: VkBufferHandle*,
    dst: VkBufferHandle*, size: u64): void {
    var region: VkBufferCopy = { size: size, ..default };
    vkCmdCopyBuffer(cmd, staging, dst, 1, &region);
    var memory: VkMemoryBarrier2 = { sType: VkMemoryBarrier2Tag,
        srcStageMask: VkStage2Transfer, srcAccessMask: VkAccess2TransferWrite,
        dstStageMask: VkStage2AllCommands, dstAccessMask: VkAccess2MemoryRead, ..default };
    var dependency: VkDependencyInfo = { sType: VkDependencyInfoTag,
        memoryBarrierCount: 1, pMemoryBarriers: &memory, ..default };
    vkCmdPipelineBarrier2(cmd, &dependency);
}
