import tower;
import readback_abi;

extern fn puts(text: u8*): i32;
extern fn putchar(character: i32): i32;
extern fn abort(): void;
extern fn fflush(stream: void*): i32;

var VkDeviceLost: i32 = -4;

fn readback_label(label: u8*): void {
    while *label != 0 { putchar(convert(i32, *label)); label++; }
    putchar(convert(i32, *"="));
}
fn readback_decimal(value: u32): void {
    var text: u8[11];
    var end = sizeof(decltype(text)) - 1;
    text[end] = 0;
    loop {
        text[--end] = *"0" + convert(u8, value % 10);
        value /= 10; if value == 0 { break; }
    }
    puts(&text[end]);
}
fn readback_number(label: u8*, value: u32): void {
    readback_label(label); readback_decimal(value);
}
fn vk_ok(operation: u8*, result: i32): bool {
    if result == 0 { return true; }
    puts(operation); readback_label("VkResult");
    if result < 0 {
        putchar(convert(i32, *"-")); readback_decimal(convert(u32, -convert(i64, result)));
    } else { readback_decimal(convert(u32, result)); }
    return false;
}
fn vk_failure(reason: u8*): bool { puts(reason); return false; }

var VkApi13: u32 = 4206592;
var VkGraphicsQueue: u32 = 1;
var VkDriverPropertiesTag: u32 = 1000196000;
var VkDeviceIDTag: u32 = 1000071004;
var VkProperties2Tag: u32 = 1000059001;
var VkDynamicRenderingTag: u32 = 1000044003;
var VkFeatures2Tag: u32 = 1000059000;
var VkQueueCreateTag: u32 = 2;
var VkDeviceCreateTag: u32 = 3;
var VkRgba8Unorm: u32 = 37;
var VkImage2D: u32 = 1;
var VkImageCreateTag: u32 = 14;
var VkView2D: u32 = 1;
var VkColorAttachmentUsage: u32 = 16;
var VkTransferSrcUsage: u32 = 1;
var VkSample1: u32 = 1;
var ReadbackWidth: u32 = 2;
var ReadbackHeight: u32 = 2;

struct ReadbackDevice {
    device: VkDeviceHandle*; queue: VkQueueHandle*;
    family: u32; memory: VkPhysicalDeviceMemoryProperties;
}

fn vk_device_kind(kind: u32): u8* {
    match kind {
        1 => { return "integrated GPU (hardware)"; }
        2 => { return "discrete GPU (hardware)"; }
        3 => { return "virtual GPU"; }
        4 => { return "CPU (software)"; }
        _ => { return "other device"; }
    }
}

// The list is temporary. The selected handle is borrowed from the live instance.
fn readback_select_physical(instance: VkInstanceHandle*, index: u32, core: VkPhysicalDeviceProperties*,
    selected: VkPhysicalDeviceHandle**): bool {
    var count: u32 = 0;
    if !vk_ok("vkEnumeratePhysicalDevices/count", vkEnumeratePhysicalDevices(instance, &count, null)) { return false; }
    if index >= count { return vk_failure("Requested Vulkan physical device index unavailable"); }
    var physicals = alloc(VkPhysicalDeviceHandle*, convert(usize, count));
    if physicals == null { return vk_failure("Cannot allocate physical device list"); }
    defer free(physicals);
    if !vk_ok("vkEnumeratePhysicalDevices/list", vkEnumeratePhysicalDevices(instance, &count, physicals)) { return false; }
    if index >= count { return vk_failure("Requested physical device disappeared"); }
    var physical = physicals[index];
    vkGetPhysicalDeviceProperties(physical, core);
    puts("Vulkan selected physical device"); puts(&core.deviceName[0]); puts(vk_device_kind(core.deviceType));
    readback_number("physical_device_index", index); readback_number("api_version", core.apiVersion);
    readback_number("vendor_id", core.vendorID); readback_number("device_id", core.deviceID);
    readback_number("driver_version", core.driverVersion);
    if core.apiVersion < VkApi13 { return vk_failure("Core Vulkan 1.3 required"); }
    var id: VkPhysicalDeviceIDProperties = { sType: VkDeviceIDTag, ..default };
    var driver: VkPhysicalDeviceDriverProperties = { sType: VkDriverPropertiesTag, pNext: bits(void*, &id), ..default };
    var props: VkPhysicalDeviceProperties2 = { sType: VkProperties2Tag, pNext: bits(void*, &driver), ..default };
    vkGetPhysicalDeviceProperties2(physical, &props);
    readback_label("device_uuid");
    var digits = "0123456789abcdef";
    for (var at: usize = 0; at < sizeof(decltype(id.deviceUUID)); at++) {
        var byte = id.deviceUUID[at];
        putchar(convert(i32, digits[convert(usize, byte >> 4)]));
        putchar(convert(i32, digits[convert(usize, byte & 15)]));
    }
    puts("");
    readback_number("driver_id", driver.driverID); puts(&driver.driverName[0]); puts(&driver.driverInfo[0]);
    *selected = physical;
    return true;
}

fn readback_create_device(physical: VkPhysicalDeviceHandle*, required: u32, noFamily: u8*,
    enable: VkPhysicalDeviceDynamicRenderingFeatures*, out: ReadbackDevice*): bool {
    var count: u32 = 0;
    vkGetPhysicalDeviceQueueFamilyProperties(physical, &count, null);
    if count == 0 { return vk_failure("No queue families"); }
    var queues = alloc(VkQueueFamilyProperties, convert(usize, count));
    if queues == null { return vk_failure("Cannot allocate queue family list"); }
    defer free(queues);
    vkGetPhysicalDeviceQueueFamilyProperties(physical, &count, queues);
    for (var family: u32 = 0; family < count; family++) {
        if (queues[family].queueFlags & required) != required || queues[family].queueCount == 0 { continue; }
        var priority: f32 = 1.0;
        var queue_info: VkDeviceQueueCreateInfo = { sType: VkQueueCreateTag, queueFamilyIndex: family,
            queueCount: 1, pQueuePriorities: &priority, ..default };
        var info: VkDeviceCreateInfo = { sType: VkDeviceCreateTag, queueCreateInfoCount: 1,
            pQueueCreateInfos: &queue_info, pNext: bits(void*, enable), ..default };
        // A failed create can overwrite its output. Publish only an acquired handle.
        var device: VkDeviceHandle*;
        if !vk_ok("vkCreateDevice", vkCreateDevice(physical, &info, null, &device)) { return false; }
        out.device = device;
        out.family = family;
        vkGetDeviceQueue(out.device, family, 0, &out.queue);
        vkGetPhysicalDeviceMemoryProperties(physical, &out.memory);
        readback_number("graphics_queue_family", family); puts("queue_index=0");
        return true;
    }
    return vk_failure(noFamily);
}

// The caller owns the instance. On success it also owns out.device.
fn readback_open_device(instance: VkInstanceHandle*, index: u32, out: ReadbackDevice*): bool {
    var physical: VkPhysicalDeviceHandle*;
    var core: VkPhysicalDeviceProperties;
    if !readback_select_physical(instance, index, &core, &physical) { return false; }
    var format: VkImageFormatProperties;
    var usage = VkColorAttachmentUsage | VkTransferSrcUsage;
    if !vk_ok("vkGetPhysicalDeviceImageFormatProperties", vkGetPhysicalDeviceImageFormatProperties(
        physical, VkRgba8Unorm, VkImage2D, 0, usage, 0, &format)) { return false; }
    if format.maxExtent.width < ReadbackWidth || format.maxExtent.height < ReadbackHeight
        || (format.sampleCounts & VkSample1) == 0 { return vk_failure("Unsupported RGBA8 extent/sample count"); }
    var dynamic: VkPhysicalDeviceDynamicRenderingFeatures = { sType: VkDynamicRenderingTag, ..default };
    var features: VkPhysicalDeviceFeatures2 = { sType: VkFeatures2Tag, pNext: bits(void*, &dynamic), ..default };
    vkGetPhysicalDeviceFeatures2(physical, &features);
    if dynamic.dynamicRendering == 0 { return vk_failure("Dynamic rendering unavailable"); }
    return readback_create_device(physical, VkGraphicsQueue, "No graphics queue for the selected device", &dynamic, out);
}

fn vk_readback_allocate(ctx: ReadbackDevice*, req: VkMemoryRequirements*, required: u32,
    allocation: VkDeviceMemoryHandle**, flags: u32*): bool {
    for (var i: u32 = 0; i < ctx.memory.memoryTypeCount; i++) {
        var properties = ctx.memory.memoryTypes[i].propertyFlags;
        if (req.memoryTypeBits & (convert(u32, 1) << i)) == 0 || (properties & required) != required { continue; }
        var info: VkMemoryAllocateInfo = { sType: VkAllocateTag, allocationSize: req.size, memoryTypeIndex: i, ..default };
        var memory: VkDeviceMemoryHandle*;
        if !vk_ok("vkAllocateMemory", vkAllocateMemory(ctx.device, &info, null, &memory)) { return false; }
        *allocation = memory; *flags = properties; return true;
    }
    return vk_failure("No compatible Vulkan memory type");
}
