import tower;
import device_cases;
import retained;
import .readback_device;
import .upload_test_device;
import .readback_output as output;

fn run_selected(ctx: ReadbackDevice*): bool {
    if getenv("RETAINED_OSD") != null { return retained_inventory(ctx); }
    return run(ctx);
}
export fn main(): i32 {
    var warnings: u32 = 0;
    var ok = validated_upload(&warnings, true, run_selected);
    output.readback_number("validation_warnings_errors", warnings);
    if !ok || warnings != 0 { return 1; }
    return 0;
}
