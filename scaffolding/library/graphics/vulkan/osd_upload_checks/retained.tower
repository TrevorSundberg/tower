import tower;
import device_cases;
import pack;
import sampling;
import .readback_abi;
import .readback_device;
import .readback_clear;
import .readback_oracle;
import .counted_abi;
import .counted_capture;
import .counted_pipeline;
import .counted_record;
import .command_begin;
import .upload_test_device;
import .readback_output as output;

// Label each 256-texel block so distant rows or blocks of the font cannot alias the short color pattern.
fn retained_color(shape: Shape, texture: u32, layer: u32, mip: u32, x: u32, y: u32): Pixel {
    var p = color(shape, texture, layer, mip, x, y);
    var tag: u32;
    match x & 255 {
        0 => { tag = y & 255; }
        1 => { tag = y >> 8; }
        2 => { tag = layer; }
        3 => { tag = mip; }
        4 => { tag = texture; }
        5 => { tag = x >> 8; }
        _ => { return p; }
    }
    if shape.texel_bytes == 1 { p.r = convert(u8, tag); } else { p.a = convert(u8, tag); }
    return p;
}

extern fn tower_vk_create_bound_image_view_v1(device: VkDeviceHandle*, image: VkImageHandle*, view_type: u32,
    format: u32, range: VkImageSubresourceRange*, out: VkImageViewHandle**): i32;

struct TextureRecord { shape: Shape; payload_bytes: u64; view_type: u32; }

// Upload from one mapped allocation. The caller owns the new image across return.
fn upload_one(ctx: ReadbackDevice*, cmd: VkCommandBufferHandle*, record: TextureRecord, seed: u32, image: Image*): bool {
    var shape = record.shape; var bytes = record.payload_bytes;
    var copies: VkBufferImageCopy[8];
    var count = build_texture_regions(shape, &copies[0], convert(u32, sizeof(decltype(copies)) / sizeof(VkBufferImageCopy)), bytes);
    if count == 0 { return vk_failure("invalid retained upload regions"); }
    var staging: CountedBuffer = default; defer counted_release_buffer(ctx.device, &staging);
    if !counted_buffer(ctx, &staging, bytes, VkTransferSrcUsage, VkHostVisible | VkHostCoherent) { return false; }
    var mapped: void*;
    if !vk_ok("map retained upload", vkMapMemory(ctx.device, staging.memory, 0, VkWholeSize, 0, &mapped)) { return false; }
    defer vkUnmapMemory(ctx.device, staging.memory);
    var pixels = bits(u8*, mapped); var offset: usize = 0;
    for (var layer: u32 = 0; layer < shape.layers; layer++) {
        for (var mip: u32 = 0; mip < shape.mips; mip++) {
            for (var y: u32 = 0; y < shape.height >> mip; y++) {
                for (var x: u32 = 0; x < shape.width >> mip; x++) {
                    var p = retained_color(shape, seed, layer, mip, x, y);
                    copy(pixels + offset, bits(u8*, &p), convert(usize, shape.texel_bytes)); offset += convert(usize, shape.texel_bytes);
                }
            }
        }
    }
    if convert(u64, offset) != bytes { return vk_failure("staging size mismatch"); }
    var format = Rgba8Srgb; if shape.texel_bytes == 1 { format = R8Unorm; }
    if !bind_new_image(ctx, shape, format, SampledUsage | VkTransferSrcUsage | VkTransferDstUsage, image) { return false; }
    var range: VkImageSubresourceRange = {aspectMask: VkColorAspect, levelCount: shape.mips, layerCount: shape.layers, ..default};
    if !vk_ok("create view", tower_vk_create_bound_image_view_v1(ctx.device, image.handle, record.view_type, format, &range, &image.view)) { return false; }
    output.readback_number("texture", seed); output.readback_label("staged_bytes"); output.readback_decimal(bytes);
    output.readback_number("image_format", format); output.readback_number("image_memory_flags", image.flags);
    output.readback_number("staging_memory_flags", staging.flags);
    if getenv("OSD_LIFETIME_TRACE") != null {
        output.readback_size("owner_primary", bits(usize, cmd)); output.readback_size("owner_queue", bits(usize, ctx.queue));
        output.readback_size("owner_staging", bits(usize, staging.handle)); output.readback_size("owner_allocation", bits(usize, staging.memory));
        output.readback_size("owner_image", bits(usize, image.handle)); output.readback_size("owner_view", bits(usize, image.view));
        output.readback_size("owner_image_memory", bits(usize, image.memory));
        puts("upload_begin");
    }
    if !vk_ok("begin retained upload", tower_vk_command_begin_v1(cmd)) { return false; }
    var start = now();
    fixture_record(cmd, staging.handle, image.handle, shape.layers, shape.mips, count, &copies[0]);
    var elapsed = now() - start;
    output.readback_label("record_ns"); output.readback_decimal(elapsed);
    return retire(ctx.queue, cmd);
}

fn check_retained_pixels(shape: Shape, seed: u32, region: VkBufferImageCopy*, data: u8*, size: usize): bool {
    var guard: u8[4]; fill(&guard[0], ReadbackGuard, sizeof(decltype(guard)));
    if memcmp(data, &guard[0], OuterGuard) != 0 || memcmp(data + size - OuterGuard, &guard[0], OuterGuard) != 0 {
        return vk_failure("outer readback guard changed");
    }
    var sub = region.imageSubresource; var width = region.imageExtent.width;
    var pitch = convert(usize, width + PaddingTexels) * sizeof(Pixel);
    var row = alloc(u8, pitch); if row == null { return vk_failure("allocate expected row"); } defer free(row);
    fill(row, ReadbackGuard, pitch);
    for (var y: u32 = 0; y < region.imageExtent.height; y++) {
        for (var x: u32 = 0; x < width; x++) {
            var p = retained_color(shape, seed, sub.baseArrayLayer, sub.mipLevel, x, y);
            if shape.texel_bytes == 4 {
                if p.r == 128 { p.r = 55; }
                if p.g == 64 { p.g = 13; }
            }
            bits(Pixel*, row)[x] = p;
        }
        if memcmp(data + OuterGuard + convert(usize, y) * pitch, row, pitch) != 0 {
            output.readback_number("texture_mismatch", seed); output.readback_number("layer", sub.baseArrayLayer);
            output.readback_number("mip", sub.mipLevel); output.readback_number("row", y);
            return vk_failure("sampled texels or padding mismatch");
        }
    }
    return true;
}

// Read one subresource at a time so the font does not require six simultaneous readback allocations.
fn sample_retained(ctx: ReadbackDevice*, cmd: VkCommandBufferHandle*, record: TextureRecord, seed: u32, image: Image*): bool {
    var s = record.shape;
    var target: Image = default; defer release_image(ctx.device, &target);
    if !make_image(ctx, {width: s.width, height: s.height, layers: 1, mips: 1, texel_bytes: 4},
        VkRgba8Unorm, VkColorAttachmentUsage | VkTransferSrcUsage, &target) { return false; }
    var pipe: CountedPipelines = default; defer counted_destroy_pipelines(ctx.device, &pipe);
    var arrayed: u32 = 0; if record.view_type == View2DArray { arrayed = 1; }
    var vertex = getenv("OSD_VERTEX_SPV"); if vertex == null { return vk_failure("OSD_VERTEX_SPV is required"); }
    if !open_sampler_pipeline(ctx.device, &pipe, {width: s.width, height: s.height}, arrayed, vertex) { return false; }
    set_sample_image(ctx.device, pipe.set, image.view);
    var capacity = read_size(s.width, s.height);
    var host: CountedBuffer = default; defer counted_release_buffer(ctx.device, &host);
    if !counted_buffer(ctx, &host, convert(u64, capacity), VkTransferDstUsage, VkHostVisible | VkHostCoherent) { return false; }
    var mapped: void*;
    if !vk_ok("map retained readback", vkMapMemory(ctx.device, host.memory, 0, VkWholeSize, 0, &mapped)) { return false; }
    defer vkUnmapMemory(ctx.device, host.memory);
    var count = s.layers * s.mips; var regions = alloc(VkBufferImageCopy, convert(usize, count));
    if regions == null { return vk_failure("allocate sampling regions"); } defer free(regions);
    pack_regions(s, regions);
    var o: Owner = {ctx: ctx, cmd: cmd, pipeline: &pipe, target: &target, host: host.handle, count: 1, ..default};
    var capture = getenv("CAPTURE_IMAGE_BYTES") != null;
    for (var i: u32 = 0; i < count; i++) {
        var region = &regions[i]; var bytes = read_size(region.imageExtent.width, region.imageExtent.height);
        fill(bits(u8*, mapped), ReadbackGuard, bytes);
        if !vk_ok("begin retained sample", tower_vk_command_begin_v1(cmd)) { return false; }
        o.list = region; record_samples(&o);
        if !retire(ctx.queue, cmd) || !check_retained_pixels(s, seed, region, bits(u8*, mapped), bytes) { return false; }
        if capture && write(4, bits(u8*, mapped), bytes) != convert(i64, bytes) { return vk_failure("write retained pixels"); }
        output.readback_size("sampled_bytes", bytes);
    }
    return true;
}

fn retained_inventory(ctx: ReadbackDevice*): bool {
    var records: TextureRecord[5] = {
        {shape: {width: 2048, height: 2048, layers: 6, mips: 1, texel_bytes: 1}, payload_bytes: 25165824, view_type: View2DArray},
        {shape: {width: 256, height: 352, layers: 1, mips: 2, texel_bytes: 4}, payload_bytes: 450560, view_type: VkView2D},
        {shape: {width: 256, height: 352, layers: 1, mips: 2, texel_bytes: 4}, payload_bytes: 450560, view_type: VkView2D},
        {shape: {width: 256, height: 352, layers: 4, mips: 1, texel_bytes: 4}, payload_bytes: 1441792, view_type: View2DArray},
        {shape: {width: 64, height: 64, layers: 2, mips: 1, texel_bytes: 4}, payload_bytes: 32768, view_type: View2DArray}
    };
    var count = sizeof(decltype(records)) / sizeof(TextureRecord);
    var images = alloc(Image, count); if images == null { return vk_failure("allocate retained image owners"); }
    defer free(images); var live: usize = 0;
    defer { for (var i: usize = 0; i < live; i++) { release_image(ctx.device, &images[i]); } }
    var info: VkCommandPoolCreateInfo = {sType: VkCommandPoolTag, flags: VkPoolResetCommandBuffer, queueFamilyIndex: ctx.family, ..default};
    var pool: VkCommandPoolHandle*;
    if !vk_ok("create inventory pool", vkCreateCommandPool(ctx.device, &info, null, &pool)) { return false; }
    defer vkDestroyCommandPool(ctx.device, pool, null);
    var allocation: VkCommandBufferAllocateInfo = {sType: VkCommandAllocateTag, commandPool: pool, commandBufferCount: 1, ..default};
    var cmd: VkCommandBufferHandle*;
    if !vk_ok("allocate inventory primary", vkAllocateCommandBuffers(ctx.device, &allocation, &cmd)) { return false; }
    for (var i: usize = 0; i < count; i++) {
        images[i] = default; live++;
        if !upload_one(ctx, cmd, records[i], convert(u32, i), &images[i]) { return false; }
        puts("staging_released");
    }
    output.readback_size("retained_images", live);
    for (var i: usize = 0; i < count; i++) {
        if !sample_retained(ctx, cmd, records[i], convert(u32, i), &images[i]) { return false; }
    }
    puts("all_samples_retired");
    return true;
}
