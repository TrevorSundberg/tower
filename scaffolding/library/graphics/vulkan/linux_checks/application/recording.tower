import tower;
import private_shapes;

var QueryFailure: u32 = 1;
var ShortExtent: u32 = 2;
var CreateFailure: u32 = 3;
var EmptyPlan: u32 = 4;
var AllocationFailure: u32 = 5;
var BindFailure: u32 = 6;
var ViewFailure: u32 = 7;
var WideBytes: u64 = 4294983680;

struct Seen { image_info: AppImageInfo*; image_next: void*; allocation: AppAllocation*; allocation_next: void*; bytes: u64; at_bind: u64; }

struct Recording {
    fault: u32; events: u64;
    seen: Seen;
    image_token: u32; view_token: u32; memory_token: u32;
    info: AppImageInfo*; plan: AppAllocation*; chain: void*;
    charged: u64*; complete: bool*;
}

struct CaseRecord {
    fault: u32; status: i32; fits: u32; info: AppImageInfo*; next: void*; plan: AppAllocation*; seen: Seen; events: u64;
}
