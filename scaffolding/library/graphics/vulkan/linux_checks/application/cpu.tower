import tower;
import library.testing;
import private_owner;
import private_shapes;
import image_client;
import memory_client;
import recording;
import layout;

extern fn puts(message: u8*): i32;

fn check(fault: u32): void {
    var owner: AppOwner = default;
    var chain: u64 = 311;
    var info: AppImageInfo = {sType: 14, pNext: bits(void*, &chain), imageType: 1, format: 37,
        extent: {width: 5, height: 6, depth: 1}, mipLevels: 2, arrayLayers: 1,
        samples: 1, usage: 4, ..default};
    if fault == ShortExtent { info.extent.width++; }
    var plan: AppAllocation = {allocationSize: 23, ..default};
    var s: Recording = {fault: fault, info: &info, plan: &plan, chain: info.pNext,
        charged: &owner.bytes, complete: &owner.complete, ..default};
    var device = bits(void*, &s);
    var properties: AppLimits = {maxResourceSize: 17, ..default};
    var fits: u32 = 19;
    var r = sdk_preflight(device, &info, &properties, &fits);
    assert(s.events == 1);
    if fault == QueryFailure {
        assert(r == -11 && fits == 19 && properties.maxResourceSize == 17 && properties.maxExtent.width == 0);
        return;
    }
    assert(r == 0 && properties.maxResourceSize == WideBytes && properties.maxExtent.width == 5);
    if fault == ShortExtent { assert(fits == 0); return; }
    assert(fits == 1);
    r = sdk_create(device, &info, &owner.image);
    assert(s.events == 12);
    if fault == CreateFailure { assert(r == -2 && owner.image == null); return; }
    assert(r == 0 && owner.image == bits(void*, &s.image_token));
    var types: AppType[2];
    types[0] = default;
    types[1] = {propertyFlags: 1, heapIndex: 3};
    var count = convert(u32, sizeof(decltype(types)) / sizeof(AppType));
    if fault == EmptyPlan { count = 1; }
    var matched = osd_plan(device, owner.image, &types[0], count, 1, &plan);
    assert(s.events == 123);
    if fault == EmptyPlan {
        assert(matched == 0 && plan.allocationSize == 23);
    } else {
        assert(matched == 1 && plan.sType == 5 && plan.pNext == null && plan.allocationSize == WideBytes && plan.memoryTypeIndex == 1);
        plan.pNext = info.pNext;
        r = osd_allocate_memory(device, &plan, &owner.memory);
        assert(s.events == 1234);
        if fault == AllocationFailure { assert(r == -2 && owner.memory == null && owner.bytes == 0); }
        else {
            assert(r == 0 && owner.memory == bits(void*, &s.memory_token));
            owner.bytes = plan.allocationSize;
            r = osd_bind_memory(device, owner.image, owner.memory);
            assert(s.events == 12345);
            if fault == BindFailure { assert(r == -7 && owner.bytes == WideBytes); }
            else {
                assert(r == 0);
                var range: AppRange = {aspectMask: 1, levelCount: 2, layerCount: 1, ..default};
                r = sdk_view(device, owner.image, 1, info.format, &range, &owner.view);
                assert(s.events == 123456);
                if fault == ViewFailure { assert(r == -2 && owner.view == null); }
                else { assert(r == 0 && owner.view == bits(void*, &s.view_token)); }
            }
        }
    }
    // CPU cases have no submitted work. Mark completion before any release.
    owner.complete = true;
    var reference = s.events;
    if owner.view != null { reference = reference * 10 + 7; }
    reference = reference * 10 + 8;
    if owner.memory != null { reference = reference * 10 + 9; }
    osd_destroy_retired_image(device, owner.view, owner.image, owner.memory);
    owner = default;
    osd_destroy_retired_image(device, owner.view, owner.image, owner.memory);
    assert(s.events == reference && owner.bytes == 0 && !owner.complete);
}

export fn main(): i32 {
    check_layout();
    for (var fault: u32 = 0; fault <= ViewFailure; fault++) { check(fault); }
    puts("seven direct entries; eight recording cases passed");
    return 0;
}
