    size: u64;
}

struct VkImageMemoryBarrier {
    sType: u32;
    pNext: void*;
    srcAccessMask: u32;
    dstAccessMask: u32;
    oldLayout: u32;
    newLayout: u32;
    srcQueueFamilyIndex: u32;
    dstQueueFamilyIndex: u32;
    image: VkImageHandle*;
    subresourceRange: VkImageSubresourceRange;
}

