// Handles are opaque. This slice uses the float32 member of VkClearValue.
struct VkClearValue { float32: f32[4]; }

struct VkApplicationInfo {
    sType: u32;
    pNext: void*;
    pApplicationName: u8*;
    applicationVersion: u32;
    pEngineName: u8*;
    engineVersion: u32;
    apiVersion: u32;
}

struct VkInstanceCreateInfo {
    sType: u32;
    pNext: void*;
    flags: u32;
    pApplicationInfo: VkApplicationInfo*;
    enabledLayerCount: u32;
    ppEnabledLayerNames: u8**;
    enabledExtensionCount: u32;
    ppEnabledExtensionNames: u8**;
}

struct VkInstanceHandle {}

