import tower;
import readback_abi;
import readback_device;
import counted_abi;
import library.graphics.indexed_indirect;

var CountedCapacity: u32 = 16384;
var VkCore14: u32 = 4210688;
var VkCore12FeaturesTag: u32 = 51;
var VkComputeQueue: u32 = 2;

fn counted_bytes(): u64 {
    return convert(u64, sizeof(u32)) + convert(u64, CountedCapacity) * convert(u64, sizeof(IndexedIndirectArguments));
}

fn counted_open_device(instance: VkInstanceHandle*, strict: bool, out: ReadbackDevice*): bool {
    var physical: VkPhysicalDeviceHandle*;
    var core: VkPhysicalDeviceProperties;
    if !readback_select_physical(instance, 0, &core, &physical) { return false; }
    if strict {
        if core.apiVersion < VkCore14 { return vk_failure("strict Draw profile refused: device API below Vulkan 1.4"); }
        return vk_failure("strict Draw predicate requires original feature inventory; unsupported by this control");
    }
    var format: VkImageFormatProperties;
    var usage = VkColorAttachmentUsage | VkTransferSrcUsage;
    if !vk_ok("vkGetPhysicalDeviceImageFormatProperties", vkGetPhysicalDeviceImageFormatProperties(
        physical, VkRgba8Unorm, VkImage2D, 0, usage, 0, &format)) { return false; }
    if format.maxExtent.width < ReadbackWidth || format.maxExtent.height < ReadbackHeight
        || (format.sampleCounts & VkSample1) == 0 { return vk_failure("Unsupported RGBA8 extent/sample count"); }
    var dynamic: VkPhysicalDeviceDynamicRenderingFeatures = { sType: VkDynamicRenderingTag, ..default };
    var v12: VkPhysicalDeviceVulkan12Features = { sType: VkCore12FeaturesTag, ..default };
    dynamic.pNext = bits(void*, &v12);
    var features: VkPhysicalDeviceFeatures2 = { sType: VkFeatures2Tag, pNext: bits(void*, &dynamic), ..default };
    vkGetPhysicalDeviceFeatures2(physical, &features);
    readback_number("drawIndirectCount", v12.drawIndirectCount);
    readback_number("available_multiDrawIndirect", features.features.multiDrawIndirect);
    readback_number("dynamicRendering", dynamic.dynamicRendering);
    readback_number("maxDrawIndirectCount", core.limits.maxDrawIndirectCount);
    readback_number("maxStorageBufferRange", core.limits.maxStorageBufferRange);
    if v12.drawIndirectCount == 0
        || core.limits.maxDrawIndirectCount < CountedCapacity
        || convert(u64, core.limits.maxStorageBufferRange) < counted_bytes() {
        return vk_failure("counted-core13 requires the counted draw feature and advertised ranges");
    }
    var enable12: VkPhysicalDeviceVulkan12Features = { sType: VkCore12FeaturesTag, drawIndirectCount: 1, ..default };
    dynamic.pNext = bits(void*, &enable12);
    if dynamic.dynamicRendering == 0 { return vk_failure("Dynamic rendering unavailable"); }
    var count: u32 = 0;
    vkGetPhysicalDeviceQueueFamilyProperties(physical, &count, null);
    if count == 0 { return vk_failure("No queue families"); }
    var queues = alloc(VkQueueFamilyProperties, convert(usize, count));
    if queues == null { return vk_failure("Cannot allocate queue family list"); }
    defer free(queues);
    vkGetPhysicalDeviceQueueFamilyProperties(physical, &count, queues);
    var required = VkGraphicsQueue | VkComputeQueue;
    for (var family: u32 = 0; family < count; family++) {
        if (queues[family].queueFlags & required) != required || queues[family].queueCount == 0 { continue; }
        var priority: f32 = 1.0;
        var queue_info: VkDeviceQueueCreateInfo = { sType: VkQueueCreateTag, queueFamilyIndex: family,
            queueCount: 1, pQueuePriorities: &priority, ..default };
        var info: VkDeviceCreateInfo = { sType: VkDeviceCreateTag, queueCreateInfoCount: 1,
            pQueueCreateInfos: &queue_info, pNext: bits(void*, &dynamic), ..default };
        if !vk_ok("vkCreateDevice", vkCreateDevice(physical, &info, null, &out.device)) { return false; }
        out.family = family;
        vkGetDeviceQueue(out.device, family, 0, &out.queue);
        vkGetPhysicalDeviceMemoryProperties(physical, &out.memory);
        readback_number("graphics_queue_family", family); puts("queue_index=0");
        return true;
    }
    return vk_failure("No combined graphics/compute queue for the selected device");
}
