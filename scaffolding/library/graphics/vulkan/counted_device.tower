import tower;
import readback_abi;
import readback_device;
import counted_abi;
import counted_features;
import readback_validation;

var CountedCapacity: u32 = DrawMinDrawCount;
var VkApi10: u32 = 4194304;

fn counted_bytes(): u64 { return counted_stream_bytes(CountedCapacity); }

fn counted_check_loader(profile: CountedProfile): bool {
    var loader = VkApi10;
    var enumerate = bits(EnumerateInstanceVersion, vkGetInstanceProcAddr(null, "vkEnumerateInstanceVersion"));
    if enumerate != null && !vk_ok("vkEnumerateInstanceVersion", enumerate(&loader)) { return false; }
    readback_number("loader_api", loader);
    var refused = counted_loader_refusal(profile, loader);
    if refused != null { return vk_failure(refused); }
    return true;
}

fn counted_open_device(instance: VkInstanceHandle*, profile: CountedProfile, out: ReadbackDevice*): bool {
    var index: u32 = 0;
    var count: u32 = 0;
    if !vk_ok("vkEnumeratePhysicalDevices/count", vkEnumeratePhysicalDevices(instance, &count, null)) { return false; }
    if index >= count { return vk_failure("Requested Vulkan physical device index unavailable"); }
    var physicals = alloc(VkPhysicalDeviceHandle*, convert(usize, count));
    if physicals == null { return vk_failure("Cannot allocate physical device list"); }
    defer free(physicals);
    if !vk_ok("vkEnumeratePhysicalDevices/list", vkEnumeratePhysicalDevices(instance, &count, physicals)) { return false; }
    if index >= count { return vk_failure("Requested physical device disappeared"); }
    var physical = physicals[index];
    var core: VkPhysicalDeviceProperties;
    vkGetPhysicalDeviceProperties(physical, &core);
    puts("Vulkan selected physical device"); puts(&core.deviceName[0]); puts(vk_device_kind(core.deviceType));
    readback_number("physical_device_index", index); readback_number("api_version", core.apiVersion);
    readback_number("vendor_id", core.vendorID); readback_number("device_id", core.deviceID);
    readback_number("driver_version", core.driverVersion);
    var caps: CountedCapabilities = { device_api: core.apiVersion, family: VkNoFamily, ..default };
    // Pre-1.3 devices cannot supply the full core feature chain below.
    if core.apiVersion < VkApi13 { return vk_failure(counted_device_refusal(profile, &caps)); }
    var id: VkPhysicalDeviceIDProperties = { sType: VkDeviceIDTag, ..default };
    var driver: VkPhysicalDeviceDriverProperties = { sType: VkDriverPropertiesTag, pNext: bits(void*, &id), ..default };
    var props: VkPhysicalDeviceProperties2 = { sType: VkProperties2Tag, pNext: bits(void*, &driver), ..default };
    vkGetPhysicalDeviceProperties2(physical, &props);
    readback_label("device_uuid");
    var digits = "0123456789abcdef";
    for (var at: usize = 0; at < sizeof(decltype(id.deviceUUID)); at++) {
        var byte = id.deviceUUID[at];
        putchar(convert(i32, digits[convert(usize, byte >> 4)]));
        putchar(convert(i32, digits[convert(usize, byte & 15)]));
    }
    puts("");
    readback_number("driver_id", driver.driverID); puts(&driver.driverName[0]); puts(&driver.driverInfo[0]);
    caps.maxDrawIndirectCount = core.limits.maxDrawIndirectCount;
    caps.maxStorageBufferRange = core.limits.maxStorageBufferRange;
    var usage = VkColorAttachmentUsage | VkTransferSrcUsage;
    var result = vkGetPhysicalDeviceImageFormatProperties(physical, VkRgba8Unorm, VkImage2D, 0, usage, 0, &caps.image);
    if result != VkFormatNotSupported && !vk_ok("vkGetPhysicalDeviceImageFormatProperties", result) { return false; }
    caps.rgba8_supported = result == 0;

    counted_query_features(physical, &caps);

    vkGetPhysicalDeviceQueueFamilyProperties(physical, &count, null);
    if count != 0 {
        var queues = alloc(VkQueueFamilyProperties, convert(usize, count));
        if queues == null { return vk_failure("Cannot allocate queue family list"); }
        defer free(queues);
        vkGetPhysicalDeviceQueueFamilyProperties(physical, &count, queues);
        for (var family: u32 = 0; family < count; family++) {
            readback_number("query_queue_family", family);
            readback_number("queueFlags", queues[family].queueFlags);
            readback_number("queueCount", queues[family].queueCount);
            if counted_queue(queues[family].queueFlags, queues[family].queueCount) { caps.family = family; break; }
        }
    }
    readback_number("available_multiDrawIndirect", caps.multiDrawIndirect);
    readback_number("available_drawIndirectFirstInstance", caps.drawIndirectFirstInstance);
    readback_number("available_shaderDrawParameters", caps.shaderDrawParameters);
    readback_number("available_drawIndirectCount", caps.drawIndirectCount);
    readback_number("available_dynamicRendering", caps.dynamicRendering);
    readback_number("maxDrawIndirectCount", caps.maxDrawIndirectCount);
    readback_number("maxStorageBufferRange", caps.maxStorageBufferRange);
    readback_number("rgba8_color_transfer_src", convert(u32, caps.rgba8_supported));
    if caps.rgba8_supported {
        readback_number("rgba8_max_width", caps.image.maxExtent.width);
        readback_number("rgba8_max_height", caps.image.maxExtent.height);
        readback_number("rgba8_sample_counts", caps.image.sampleCounts);
    }
    var refused = counted_device_refusal(profile, &caps);
    if refused != null { return vk_failure(refused); }

    // Fresh create chain: only the requested bits survive from discovery.
    var strict_bit = convert(u32, profile == CountedProfile.Draw14);
    var parameters: VkPhysicalDeviceShaderDrawParametersFeatures = { sType: VkShaderDrawParametersTag, shaderDrawParameters: strict_bit, ..default };
    var v12: VkPhysicalDeviceVulkan12Features = { sType: VkCore12FeaturesTag, pNext: bits(void*, &parameters), drawIndirectCount: 1, ..default };
    var dynamic: VkPhysicalDeviceDynamicRenderingFeatures = { sType: VkDynamicRenderingTag, pNext: bits(void*, &v12), dynamicRendering: 1, ..default };
    var features: VkPhysicalDeviceFeatures2 = { sType: VkFeatures2Tag, pNext: bits(void*, &dynamic),
        features: { multiDrawIndirect: strict_bit, drawIndirectFirstInstance: strict_bit, ..default }, ..default };
    var priority: f32 = 1.0;
    var queue_info: VkDeviceQueueCreateInfo = { sType: VkQueueCreateTag, queueFamilyIndex: caps.family,
        queueCount: 1, pQueuePriorities: &priority, ..default };
    var info: VkDeviceCreateInfo = { sType: VkDeviceCreateTag, queueCreateInfoCount: 1,
        pQueueCreateInfos: &queue_info, pNext: bits(void*, &features), ..default };
    if !vk_ok("vkCreateDevice", vkCreateDevice(physical, &info, null, &out.device)) { return false; }
    if profile == CountedProfile.Draw14 { puts("selected_profile=draw14"); } else { puts("selected_profile=counted-core13"); }
    readback_number("enabled_multiDrawIndirect", features.features.multiDrawIndirect);
    readback_number("enabled_drawIndirectFirstInstance", features.features.drawIndirectFirstInstance);
    readback_number("enabled_shaderDrawParameters", parameters.shaderDrawParameters);
    readback_number("enabled_drawIndirectCount", v12.drawIndirectCount);
    readback_number("enabled_dynamicRendering", dynamic.dynamicRendering);
    out.family = caps.family;
    vkGetDeviceQueue(out.device, out.family, 0, &out.queue);
    vkGetPhysicalDeviceMemoryProperties(physical, &out.memory);
    readback_number("graphics_queue_family", out.family); puts("queue_index=0");
    return true;
}
