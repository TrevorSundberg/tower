import tower;
import counted_abi;
import counted_calls;
import readback_completion;
import counted_device;
import counted_pipeline;
import counted_record;
import indexed_draw;
import readback_clear;
import readback_device;
import readback_abi;
import readback_oracle;
import readback_rows;

var VkStorageBufferUsage: u32 = 32;
var VkIndexUsage: u32 = 64;
var VkIndirectUsage: u32 = 256;
var VkCountedResetCommandBuffer: u32 = 2;

struct CountedBuffer {
    handle: VkBufferHandle*;
    memory: VkDeviceMemoryHandle*;
    flags: u32;
}

fn counted_buffer(ctx: ReadbackDevice*, buffer: CountedBuffer*, size: u64, usage: u32, required: u32): bool {
    var info: VkBufferCreateInfo = { sType: VkBufferCreateTag, size: size, usage: usage, ..default };
    if !vk_ok("vkCreateBuffer", vkCreateBuffer(ctx.device, &info, null, &buffer.handle)) { buffer.handle = null; return false; }
    var req: VkMemoryRequirements;
    vkGetBufferMemoryRequirements(ctx.device, buffer.handle, &req);
    return vk_readback_allocate(ctx, &req, required, &buffer.memory, &buffer.flags)
        && vk_ok("vkBindBufferMemory", vkBindBufferMemory(ctx.device, buffer.handle, buffer.memory, 0));
}

fn counted_release_buffer(device: VkDeviceHandle*, buffer: CountedBuffer*): void {
    vkDestroyBuffer(device, buffer.handle, null);
    vkFreeMemory(device, buffer.memory, null);
}

fn counted_compare_sample(sample: u8*, prefix: u8*, pixels: u8*): bool {
    var header = convert(usize, counted_prefix_bytes());
    var command_ok = readback_compare("GPU count word and first command (LE)", sample, header, prefix);
    var caller: u8[32];
    var size = sizeof(decltype(caller));
    fill(&caller[0], ReadbackGuard, size);
    var dst: ReadbackDestination = { data: &caller[0], capacity: size, offset: 4, pitch: 12, span: 24 };
    if !readback_two_rows(&dst, sample + header, convert(usize, counted_sample_bytes()) - header, ReadbackRowBytes) {
        return vk_failure("Could not copy the stored attachment");
    }
    var image_ok = readback_compare("2x2 RGBA8, guarded caller", &caller[0], size, pixels);
    return command_ok && image_ok;
}

fn counted_capture(calls: CountedCalls*, ctx: ReadbackDevice*, paths: u8**): bool {
    var device = ctx.device;
    var draw = vk_load_indexed_indirect_count(device);
    if draw == null { return vk_failure("Core vkCmdDrawIndexedIndirectCount unavailable"); }
    var indirect: CountedBuffer = default;
    defer counted_release_buffer(device, &indirect);
    if !counted_buffer(ctx, &indirect, counted_bytes(), VkStorageBufferUsage | VkIndirectUsage | VkTransferSrcUsage, 0) {
        return false;
    }
    var stream: VulkanIndirectBuffer = { handle: indirect.handle, byte_size: counted_bytes() };
    readback_number("indirect_bytes", convert(u32, stream.byte_size));
    readback_number("max_draws", CountedCapacity);
    // vkCmdUpdateBuffer requires a multiple of four bytes. Only the first three indices are drawn.
    var indices: u16[4] = default;
    indices[1] = 1; indices[2] = 2;
    var index_bytes = convert(u64, sizeof(decltype(indices)));
    var indices_buffer: CountedBuffer = default;
    defer counted_release_buffer(device, &indices_buffer);
    if !counted_buffer(ctx, &indices_buffer, index_bytes, VkIndexUsage | VkTransferDstUsage, 0) { return false; }
    var pipelines: CountedPipelines = default;
    defer counted_destroy_pipelines(device, &pipelines);
    if !counted_descriptors(device, &pipelines, indirect.handle, stream.byte_size)
        || !counted_pipelines(calls, device, &pipelines, paths) { return false; }
    var staging: CountedBuffer = default;
    defer counted_release_buffer(device, &staging);
    if !counted_buffer(ctx, &staging, 2 * counted_sample_bytes(), VkTransferDstUsage, VkHostVisible) { return false; }
    var image_memory: VkDeviceMemoryHandle* = null;
    defer vkFreeMemory(device, image_memory, null);
    var info: VkImageCreateInfo = { sType: VkImageCreateTag, imageType: VkImage2D, format: VkRgba8Unorm,
        extent: { width: ReadbackWidth, height: ReadbackHeight, depth: 1 }, mipLevels: 1, arrayLayers: 1,
        samples: VkSample1, usage: VkColorAttachmentUsage | VkTransferSrcUsage, ..default };
    var image: VkImageHandle*;
    if !vk_ok("vkCreateImage", vkCreateImage(device, &info, null, &image)) { return false; }
    defer vkDestroyImage(device, image, null);
    var req: VkMemoryRequirements; var flags: u32;
    vkGetImageMemoryRequirements(device, image, &req);
    if !vk_readback_allocate(ctx, &req, 0, &image_memory, &flags)
        || !vk_ok("vkBindImageMemory", vkBindImageMemory(device, image, image_memory, 0)) { return false; }
    var range: VkImageSubresourceRange = { aspectMask: VkColorAspect, levelCount: 1, layerCount: 1, ..default };
    var view_info: VkImageViewCreateInfo = { sType: VkImageViewCreateTag, image: image, viewType: VkView2D,
        format: VkRgba8Unorm, subresourceRange: range, ..default };
    var view: VkImageViewHandle*;
    if !vk_ok("vkCreateImageView", vkCreateImageView(device, &view_info, null, &view)) { return false; }
    defer vkDestroyImageView(device, view, null);
    var pool_info: VkCommandPoolCreateInfo = { sType: VkCommandPoolTag, flags: VkCountedResetCommandBuffer, queueFamilyIndex: ctx.family, ..default };
    var pool: VkCommandPoolHandle*;
    if !vk_ok("vkCreateCommandPool", vkCreateCommandPool(device, &pool_info, null, &pool)) { return false; }
    defer vkDestroyCommandPool(device, pool, null);
    var cmd_info: VkCommandBufferAllocateInfo = { sType: VkCommandAllocateTag, commandPool: pool, commandBufferCount: 1, ..default };
    var cmd: VkCommandBufferHandle*;
    if !vk_ok("vkAllocateCommandBuffers", vkAllocateCommandBuffers(device, &cmd_info, &cmd)) { return false; }
    var submit: VkSubmitInfo;
    if !vk_ok("reset and begin command buffer", calls.begin(cmd))
        || !counted_record(calls, cmd, draw, &pipelines, stream, indices_buffer.handle, &indices[0], index_bytes,
            image, view, range, staging.handle)
        || !vk_ok("vkEndCommandBuffer", calls.prepare(&submit, &cmd, null, null, null)) { return false; }
    var fence_info: VkFenceCreateInfo = { sType: VkFenceTag, ..default };
    var fence: VkFenceHandle*;
    if !vk_ok("vkCreateFence", vkCreateFence(device, &fence_info, null, &fence)) { return false; }
    defer vkDestroyFence(device, fence, null);
    var result = calls.submit(ctx.queue, &submit, fence);
    if !vk_complete_submission(device, ctx.queue, fence, result,
        { submit: "vkQueueSubmit", submitted: "submitted=1 compute/count=0 -> raster/store/copy -> compute/count=1 -> raster/store/copy",
          wait: "vkWaitForFences", signaled: "fence=signaled" }) { return false; }
    var mapped: void*;
    if !vk_ok("vkMapMemory", vkMapMemory(device, staging.memory, 0, VkWholeSize, 0, &mapped)) { return false; }
    defer vkUnmapMemory(device, staging.memory);
    readback_number("staging_memory_flags", staging.flags);
    if (staging.flags & VkHostCoherent) == 0 {
        var mapped_range: VkMappedMemoryRange = { sType: VkMappedRangeTag, memory: staging.memory, size: VkWholeSize, ..default };
        if !vk_ok("vkInvalidateMappedMemoryRanges", vkInvalidateMappedMemoryRanges(device, 1, &mapped_range)) { return false; }
        puts("visibility=whole mapped allocation invalidated");
    } else { puts("visibility=host coherent"); }
    var data = bits(u8*, mapped);
    puts("control requested_count=0 expected_pixel=112233ff");
    var zero = counted_compare_sample(data, "000000000300000001000000000000000000000000000000", readback_gpu_hex());
    puts("raster requested_count=1 expected_pixel=4080bfff");
    var one = counted_compare_sample(data + convert(usize, counted_sample_bytes()),
        "010000000300000001000000000000000000000000000000",
        "a5a5a5a54080bfff4080bfffa5a5a5a54080bfff4080bfffa5a5a5a5a5a5a5a5");
    return zero && one;
}
