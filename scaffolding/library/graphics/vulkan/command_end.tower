import tower;
import readback_abi;
import frame_submit;

// Both arguments point into caller-owned storage. The command slot remains
// live and unchanged through the later submit. Failure leaves info untouched.
export fn tower_vk_command_end_for_submit_v1(command: VkCommandBufferHandle**, info: VkSubmitInfo*): i32 {
    var result = vkEndCommandBuffer(*command);
    if result == 0 { *info = vk_one_command_submit_info(command); }
    return result;
}
