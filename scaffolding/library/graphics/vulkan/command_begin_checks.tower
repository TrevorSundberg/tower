import tower;
import readback_abi;
import readback_output;

extern fn tower_vk_command_begin_v1(cmd: VkCommandBufferHandle*): i32;
extern fn begin_from_c(cmd: VkCommandBufferHandle*): i32;
extern fn begin_raw(cmd: VkCommandBufferHandle*): i32;
extern fn begin_info_matches(info: VkCommandBufferBeginInfo*): i32;
extern fn begin_layout_matches(info: VkCommandBufferBeginInfo*, size: usize, tag: void*, next: void*,
    flags: void*, inheritance: void*): i32;
extern fn exit(status: i32): void;

struct Recording {
    reset_result: i32; begin_result: i32; calls: u32;
}
fn require(ok: bool, msg: u8*): void { if !ok { puts(msg); exit(3); } }

export fn vkResetCommandBuffer(cmd: VkCommandBufferHandle*, flags: u32): i32 {
    var trace = bits(Recording*, cmd);
    require(trace.calls == 0 && flags == 0, "unexpected reset or flags");
    trace.calls++;
    return trace.reset_result;
}
export fn vkBeginCommandBuffer(cmd: VkCommandBufferHandle*, info: VkCommandBufferBeginInfo*): i32 {
    var trace = bits(Recording*, cmd);
    require(trace.calls == 1 && trace.reset_result == 0, "unexpected begin");
    require(begin_info_matches(info) == 1, "native begin info mismatch");
    trace.calls++;
    return trace.begin_result;
}
var Begin: type = function(i32, VkCommandBufferHandle*);
fn run(call: Begin, reset: i32, begin: i32): void {
    var trace: Recording = { reset_result: reset, begin_result: begin, ..default };
    var result = call(bits(VkCommandBufferHandle*, &trace));
    if reset != 0 {
        require(trace.calls == 1 && result == reset, "reset must stop at R and return its result");
        puts("R");
    } else {
        require(trace.calls == 2 && result == begin, "begin must complete RB and return its result");
        puts("RB");
    }
}
fn check(call: Begin): void {
    run(call, 0, 0);
    run(call, -1, -4);
    run(call, 0, -1);
    run(call, -4, -1);
    run(call, 0, -4);
}
export fn main(): i32 {
    var info: VkCommandBufferBeginInfo;
    require(begin_layout_matches(&info, sizeof(VkCommandBufferBeginInfo), bits(void*, &info.sType),
        bits(void*, &info.pNext), bits(void*, &info.flags), bits(void*, &info.pInheritanceInfo)) == 1,
        "VkCommandBufferBeginInfo field offsets differ from the native header");
    check(begin_raw); puts("raw reset/begin matrix passed");
    check(tower_vk_command_begin_v1); puts("external Tower reset/begin matrix passed");
    check(begin_from_c); puts("Vulkan-header C reset/begin matrix passed");
    return 0;
}
