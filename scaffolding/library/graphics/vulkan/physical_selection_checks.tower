import tower;
import counted_device;
import readback_device;
import readback_abi;
import counted_abi;

extern fn exit(status: i32): void;
extern fn strcmp(left: u8*, right: u8*): i32;

enum SelectionEntry: u32 { Select, Clear, Counted, Strict }

struct QueueCheck {
    available: u32;
    listed: u32;
    winner: u32;
    counted: bool;
    createResult: i32;
    dynamic: VkPhysicalDeviceDynamicRenderingFeatures*;
    liveDevice: bool;
}

struct SelectionCheck {
    queueCheck: QueueCheck*;
    events: u8*;
    index: u32;
    count: u32;
    listed: u32;
    countResult: i32;
    listResult: i32;
    api: u32;
    countSlot: u32*;
    coreSlot: VkPhysicalDeviceProperties*;
    devices: SelectionCheck*[2];
}

fn require_selection(ok: bool, reason: u8*): void {
    if !ok { puts(reason); exit(3); }
}

fn selection_event(state: SelectionCheck*, name: u8*): void {
    require_selection(*state.events == *name, name);
    state.events++;
}

export fn vkEnumeratePhysicalDevices(instance: VkInstanceHandle*, count: u32*, list: VkPhysicalDeviceHandle**): i32 {
    var state = bits(SelectionCheck*, instance);
    require_selection(count != null, "missing count slot");
    if list == null {
        selection_event(state, "Count");
        state.countSlot = count;
        *count = state.count;
        return state.countResult;
    }
    selection_event(state, "List");
    require_selection(count == state.countSlot && *count == state.count && state.listed <= *count, "list capacity");
    for (var i: u32 = 0; i < state.listed; i++) {
        list[i] = bits(VkPhysicalDeviceHandle*, &state.devices[i]);
    }
    *count = state.listed;
    return state.listResult;
}

fn selected_event(handle: VkPhysicalDeviceHandle*, name: u8*): SelectionCheck* {
    var slot = bits(SelectionCheck**, handle);
    var state = *slot;
    require_selection(slot == &state.devices[state.index], "wrong selected device");
    selection_event(state, name);
    return state;
}

export fn vkGetPhysicalDeviceProperties(handle: VkPhysicalDeviceHandle*, out: VkPhysicalDeviceProperties*): void {
    var state = selected_event(handle, "Properties");
    require_selection(out != null && (state.coreSlot == null || state.coreSlot == out), "core properties storage");
    *out = default;
    out.apiVersion = state.api;
    out.vendorID = 9029;
    out.deviceID = 200 + state.index;
    out.deviceType = 2;
    out.driverVersion = 932;
    out.deviceName[0] = *"A" + convert(u8, state.index);
    out.limits.maxDrawIndirectCount = 123;
    out.limits.maxStorageBufferRange = 456789;
    if state.queueCheck != null { out.limits.maxDrawIndirectCount = CountedCapacity; }
}

export fn vkGetPhysicalDeviceProperties2(handle: VkPhysicalDeviceHandle*, out: VkPhysicalDeviceProperties2*): void {
    selected_event(handle, "Identity");
    require_selection(out != null && out.sType == VkProperties2Tag && out.pNext != null, "properties2 header");
    var driver = bits(VkPhysicalDeviceDriverProperties*, out.pNext);
    require_selection(driver.sType == VkDriverPropertiesTag && driver.pNext != null, "driver header");
    var id = bits(VkPhysicalDeviceIDProperties*, driver.pNext);
    require_selection(id.sType == VkDeviceIDTag && id.pNext == null, "ID header");
    driver.driverID = 77;
    driver.driverName[0] = *"D";
    driver.driverInfo[0] = *"I";
    for (var i: usize = 0; i < sizeof(decltype(id.deviceUUID)); i++) {
        id.deviceUUID[i] = convert(u8, i * 17);
        id.driverUUID[i] = convert(u8, 255 - i);
    }
    out.properties = default;
}

export fn vkGetPhysicalDeviceImageFormatProperties(handle: VkPhysicalDeviceHandle*, format: u32, kind: u32,
    tiling: u32, usage: u32, flags: u32, out: VkImageFormatProperties*): i32 {
    selected_event(handle, "Format");
    require_selection(format == VkRgba8Unorm && kind == VkImage2D && tiling == 0
        && usage == (VkColorAttachmentUsage | VkTransferSrcUsage) && flags == 0 && out != null, "format arguments");
    *out = { maxExtent: { width: ReadbackWidth, height: ReadbackHeight, depth: 1 }, sampleCounts: VkSample1, ..default };
    return 0;
}

export fn vkGetPhysicalDeviceFeatures2(handle: VkPhysicalDeviceHandle*, out: VkPhysicalDeviceFeatures2*): void {
    var state = selected_event(handle, "Extensions");
    require_selection(out.sType == VkFeatures2Tag && out.pNext != null, "feature header");
    var dynamic = bits(VkPhysicalDeviceDynamicRenderingFeatures*, out.pNext);
    require_selection(dynamic.sType == VkDynamicRenderingTag, "dynamic features");
    if state.queueCheck != null {
        state.queueCheck.dynamic = dynamic;
        dynamic.dynamicRendering = 1;
        require_selection((dynamic.pNext != null) == state.queueCheck.counted, "feature query chain");
    }
    if dynamic.pNext != null {
        var v12 = bits(VkPhysicalDeviceVulkan12Features*, dynamic.pNext);
        require_selection(v12.sType == VkCore12FeaturesTag && v12.pNext == null, "counted features");
        v12.drawIndirectCount = 1;
        v12.timelineSemaphore = 1;
        dynamic.dynamicRendering = 1;
    }
}

fn check_selection(entry: SelectionEntry, index: u32, count: u32, listed: u32, countResult: i32,
    listResult: i32, api: u32, events: u8*): void {
    var state: SelectionCheck = { index: index, count: count, listed: listed, countResult: countResult,
        listResult: listResult, api: api, events: events, ..default };
    state.devices[0] = &state;
    state.devices[1] = &state;
    var instance = bits(VkInstanceHandle*, &state);
    var device: ReadbackDevice = default;
    if entry == SelectionEntry.Select {
        var core: VkPhysicalDeviceProperties;
        var physical: VkPhysicalDeviceHandle* = null;
        state.coreSlot = &core;
        require_selection(readback_select_physical(instance, index, &core, &physical), "selection failed");
        require_selection(physical == bits(VkPhysicalDeviceHandle*, &state.devices[index])
            && core.limits.maxDrawIndirectCount == 123 && core.limits.maxStorageBufferRange == 456789, "selected outputs");
    } else {
        var ok = entry == SelectionEntry.Clear ? readback_open_device(instance, index, &device)
            : counted_open_device(instance, entry == SelectionEntry.Strict, &device);
        require_selection(!ok && device.device == null && device.queue == null, "refusal published device");
    }
    require_selection(*state.events == 0, "missing query");
    puts(events);
}

export fn vkGetPhysicalDeviceQueueFamilyProperties(handle: VkPhysicalDeviceHandle*, count: u32*, list: VkQueueFamilyProperties*): void {
    var state = selected_event(handle, list == null ? "Families" : "Rows");
    var check = state.queueCheck;
    if list == null { *count = check.available; return; }
    require_selection(*count == check.available && check.listed <= *count, "family capacity");
    var combined = VkGraphicsQueue | VkComputeQueue;
    var flags: u32[5] = { combined, VkComputeQueue, VkGraphicsQueue, combined, combined };
    require_selection(convert(usize, check.listed) <= sizeof(decltype(flags)) / sizeof(u32), "fixture capacity");
    for (var i: u32 = 0; i < check.listed; i++) {
        list[i] = { queueFlags: flags[i], queueCount: i == 0 ? 0 : 2, ..default };
    }
    *count = check.listed;
}

export fn vkCreateDevice(handle: VkPhysicalDeviceHandle*, info: VkDeviceCreateInfo*, allocator: VkAllocationCallbacks*,
    output: VkDeviceHandle**): i32 {
    var state = selected_event(handle, "Device");
    var check = state.queueCheck;
    require_selection(allocator == null && output != null && info.sType == VkDeviceCreateTag && info.flags == 0
        && info.queueCreateInfoCount == 1 && info.enabledLayerCount == 0 && info.enabledExtensionCount == 0
        && info.pEnabledFeatures == null, "device arguments");
    var queue = info.pQueueCreateInfos;
    require_selection(queue != null && queue.sType == VkQueueCreateTag && queue.pNext == null && queue.flags == 0
        && queue.queueCount == 1 && queue.queueFamilyIndex == check.winner && queue.pQueuePriorities != null
        && *queue.pQueuePriorities == 1.0, "queue creation arguments");
    var dynamic = check.dynamic;
    require_selection(info.pNext == bits(void*, dynamic) && dynamic.sType == VkDynamicRenderingTag
        && dynamic.dynamicRendering == 1 && (dynamic.pNext != null) == check.counted, "enable chain");
    if check.counted {
        var enable = bits(VkPhysicalDeviceVulkan12Features*, dynamic.pNext);
        require_selection(enable.sType == VkCore12FeaturesTag && enable.pNext == null && enable.drawIndirectCount == 1
            && enable.timelineSemaphore == 0, "counted enabled unrequested features");
    }
    // Write even on error. Only a successful create transfers ownership.
    *output = bits(VkDeviceHandle*, state);
    check.liveDevice = check.createResult == 0;
    return check.createResult;
}

export fn vkGetDeviceQueue(device: VkDeviceHandle*, family: u32, index: u32, output: VkQueueHandle**): void {
    var state = bits(SelectionCheck*, device);
    selection_event(state, "Queue");
    require_selection(state.queueCheck.liveDevice && family == state.queueCheck.winner && index == 0, "queue lookup");
    *output = bits(VkQueueHandle*, state.queueCheck);
}

export fn vkGetPhysicalDeviceMemoryProperties(handle: VkPhysicalDeviceHandle*, out: VkPhysicalDeviceMemoryProperties*): void {
    var state = selected_event(handle, "Memory");
    require_selection(state.queueCheck.liveDevice, "memory lookup without device");
    *out = { memoryTypeCount: 2, memoryHeapCount: 1, ..default };
    out.memoryTypes[1].propertyFlags = 6;
    out.memoryHeaps[0].size = 987654;
}

export fn vkDestroyDevice(device: VkDeviceHandle*, allocator: VkAllocationCallbacks*): void {
    var state = bits(SelectionCheck*, device);
    selection_event(state, "Teardown");
    require_selection(allocator == null && state.queueCheck.liveDevice, "destroy without device");
    state.queueCheck.liveDevice = false;
}

fn check_queue(counted: bool, available: u32, listed: u32, result: i32, success: bool, events: u8*): void {
    var check: QueueCheck = { counted: counted, available: available, listed: listed,
        createResult: result, winner: counted ? 3 : 2, ..default };
    var state: SelectionCheck = { count: 2, listed: 2, api: VkApi13, index: counted ? 0 : 1,
        events: events, queueCheck: &check, ..default };
    state.devices[state.index] = &state;
    var instance = bits(VkInstanceHandle*, &state);
    var out: ReadbackDevice = default;
    var ok = counted ? counted_open_device(instance, false, &out) : readback_open_device(instance, state.index, &out);
    require_selection(ok == success, "open result");
    if ok {
        require_selection(out.device == bits(VkDeviceHandle*, &state) && out.queue == bits(VkQueueHandle*, &check)
            && out.family == check.winner && out.memory.memoryTypeCount == 2 && out.memory.memoryTypes[1].propertyFlags == 6
            && out.memory.memoryHeapCount == 1 && out.memory.memoryHeaps[0].size == 987654, "logical device outputs");
        vkDestroyDevice(out.device, null);
    } else {
        require_selection(out.device == null && out.queue == null && out.memory.memoryTypeCount == 0, "refusal published device");
    }
    require_selection(*state.events == 0 && !check.liveDevice, "unfinished device case");
    puts(events);
}

export fn main(argc: i32, argv: u8**): i32 {
    // The allocation-denial run interposes on the family list after the count query.
    if argc != 1 {
        require_selection(argc == 2 && strcmp(argv[1], "--deny-family-list") == 0, "expected --deny-family-list");
        check_queue(true, 5, 5, 0, false, "CLPIFEF");
        return 0;
    }
    check_selection(SelectionEntry.Clear, 0, 0, 0, 0, 0, VkApi13, "C");
    check_selection(SelectionEntry.Clear, 2, 2, 2, 0, 0, VkApi13, "C");
    check_selection(SelectionEntry.Clear, 1, 2, 1, 0, 0, VkApi13, "CL");
    check_selection(SelectionEntry.Clear, 1, 2, 2, -3, 0, VkApi13, "C");
    check_selection(SelectionEntry.Counted, 0, 2, 2, 0, -4, VkApi13, "CL");
    check_selection(SelectionEntry.Clear, 1, 2, 1, 0, 5, VkApi13, "CL");
    check_selection(SelectionEntry.Counted, 0, 2, 2, 5, 0, VkApi13, "C");
    check_selection(SelectionEntry.Clear, 1, 2, 2, 0, 0, VkApi13 - 1, "CLP");
    check_selection(SelectionEntry.Select, 0, 2, 1, 0, 0, VkApi13, "CLPI");
    check_selection(SelectionEntry.Select, 1, 2, 2, 0, 0, VkApi13, "CLPI");
    check_selection(SelectionEntry.Clear, 1, 2, 2, 0, 0, VkApi13, "CLPIFE");
    check_selection(SelectionEntry.Strict, 0, 2, 2, 0, 0, VkApi13, "CLPI");
    check_selection(SelectionEntry.Strict, 0, 2, 2, 0, 0, VkCore14, "CLPI");
    check_selection(SelectionEntry.Counted, 0, 2, 2, 0, 0, VkApi13, "CLPIFE");
    check_queue(false, 5, 5, 0, true, "CLPIFEFRDQMT");
    check_queue(true, 5, 5, 0, true, "CLPIFEFRDQMT");
    check_queue(true, 5, 3, 0, false, "CLPIFEFR");
    check_queue(false, 5, 2, 0, false, "CLPIFEFR");
    check_queue(false, 0, 0, 0, false, "CLPIFEF");
    check_queue(true, 5, 0, 0, false, "CLPIFEFR");
    check_queue(true, 5, 4, -7, false, "CLPIFEFRD");
    return 0;
}
