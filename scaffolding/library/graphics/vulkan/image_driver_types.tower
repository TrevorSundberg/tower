struct VkAllocationCallbacks {}

struct VkMemoryRequirements {
    size: u64;
    alignment: u64;
    memoryTypeBits: u32;
}

struct VkComponentMapping {
    r: u32;
    g: u32;
    b: u32;
    a: u32;
}

struct VkImageViewCreateInfo {
    sType: u32;
    pNext: void*;
    flags: u32;
    image: VkImageHandle*;
    viewType: u32;
    format: u32;
    components: VkComponentMapping;
    subresourceRange: VkImageSubresourceRange;
}
