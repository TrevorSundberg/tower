import tower;
import .readback_abi;

import allocation_observer;
extern fn osd_row(name: u8*, status: u32, out: VkMemoryAllocateInfo*): void;
extern fn memcmp(a: void*, b: void*, bytes: usize): i32;
struct Table { left: u64; types: VkMemoryType[32]; right: u64; }
struct Output { left: u64; info: VkMemoryAllocateInfo; right: u64; }
var NoMatch: u32 = 32;
var AllocateTag: u32 = 5;
fn run(name: u8*, req: VkMemoryRequirements, count: u32, required: u32, first: u32, last: u32, index: u32): void {
    var table: Table;
    fill(bits(u8*, &table), 90, sizeof(Table));
    for (var i: usize = 0; i < sizeof(decltype(table.types)) / sizeof(VkMemoryType); i++) {
        table.types[i] = {propertyFlags: 0, heapIndex: 31 - convert(u32, i)};
    }
    table.types[0].propertyFlags = first;
    table.types[31].propertyFlags = last;
    var snapshot = table;
    var out: Output; var before: Output;
    fill(bits(u8*, &out), 165, sizeof(Output));
    copy(bits(u8*, &before), bits(u8*, &out), sizeof(Output));
    var device = bits(VkDeviceHandle*, &table);
    var image = bits(VkImageHandle*, &out);
    osd_begin_query(device, image, &req, &out.info);
    var status = osd_check_allocation(device, image, &table.types[0], count, required, &out.info);
    check(osd_query_count() == 1, name, "query count");
    check(status == (index == NoMatch ? 0 : 1), name, "VkBool32 status");
    check(memcmp(bits(void*, &table), bits(void*, &snapshot), sizeof(Table)) == 0, name, "borrowed table or guards");
    check(out.left == before.left && out.right == before.right, name, "output guards");
    if index == NoMatch {
        check(memcmp(bits(void*, &out), bits(void*, &before), sizeof(Output)) == 0, name, "no-match output changed");
    } else {
        check(out.info.sType == AllocateTag && out.info.pNext == null && out.info.allocationSize == req.size
            && out.info.memoryTypeIndex == index, name, "published allocation fields");
    }
    osd_row(name, status, &out.info);
}
export fn record_suite(): i32 {
    var req: VkMemoryRequirements = {size: 16384, alignment: 512, memoryTypeBits: 2147483649};
    run("unsigned-31", req, 32, 1, 0, 1, 31);
    run("lowest-tie", req, 32, 1, 1, 1, 0);
    run("all-flags", req, 32, 3, 1, 7, 31);
    run("partial-flags", req, 32, 3, 1, 2, NoMatch);
    req.memoryTypeBits = 2147483648;
    run("count-truncation", req, 31, 1, 1, 1, NoMatch);
    run("empty-table", req, 0, 0, 0, 0, NoMatch);
    req.memoryTypeBits = 0;
    run("empty-mask", req, 32, 0, 1, 1, NoMatch);
    req.memoryTypeBits = 2147483652;
    run("zero-flags", req, 32, 0, 0, 1, 2);
    req.size = 4294983680;
    run("over-4GiB", req, 32, 1, 0, 1, 31);
    req.size += 7;
    run("unaligned-size", req, 32, 1, 0, 1, 31);
    return 0;
}
