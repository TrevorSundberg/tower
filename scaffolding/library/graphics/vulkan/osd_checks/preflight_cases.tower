import tower;

// Each C call constructs real SDK structs with these inputs, then a recording
// loader validates the ABI. Distinct maxima expose exchanged fields.
struct Limits { width: u32; height: u32; depth: u32; mips: u32; layers: u32; }
extern fn record_preflight(name: u8*, limits: Limits*, requested: Limits*, samples: u32,
    resource: u64, result: i32, supported: u32): void;

export fn record_suite(): i32 {
    var max: Limits = {47, 39, 13, 7, 23};
    var resource: u64 = 12379832408394012280;
    var fields: u8*[5] = {"width", "height", "depth", "mips", "layers"};
    for (var i: usize = 0; i < sizeof(decltype(fields)) / sizeof(u8*); i++) {
        var shape: Limits = {1, 1, 1, 1, 1};
        var values: u32*[5] = {&shape.width, &shape.height, &shape.depth, &shape.mips, &shape.layers};
        var maxima: u32[5] = {max.width, max.height, max.depth, max.mips, max.layers};
        *values[i] = maxima[i];
        record_preflight(fields[i], &max, &shape, 1, resource, 0, 1);
        *values[i] = 0;
        record_preflight(fields[i], &max, &shape, 1, resource, 0, 0);
        if i == 0 { record_preflight(fields[i], &max, &shape, 1, resource, -11, 0); }
        *values[i] = maxima[i] + 1;
        record_preflight(fields[i], &max, &shape, 1, resource, 0, 0);
    }
    // The driver returns the 1 and 4 bits. Only one bit need intersect.
    record_preflight("bit-4", &max, &max, 4, resource, 0, 1);
    record_preflight("mixed", &max, &max, 6, resource, 0, 1);
    record_preflight("disjoint", &max, &max, 10, resource, 0, 0);
    record_preflight("empty", &max, &max, 0, resource, 0, 0);
    record_preflight("resource", &max, &max, 6, 0, 0, 1);
    record_preflight("high-word", &max, &max, 6, 4294967296, 0, 1);
    record_preflight("resource", &max, &max, 6, 18446744073709551615, 0, 1);
    record_preflight("resource", &max, &max, 10, 18446744073709551615, 0, 0);
    record_preflight("positive", &max, &max, 1, resource, 5, 0);
    record_preflight("negative", &max, &max, 1, resource, -1000001004, 0);
    var wide: Limits = {4294967295, 2147483648, 13, 7, 23};
    record_preflight("unsigned-exact", &wide, &wide, 1, resource, 0, 1);
    var over = wide;
    over.height += 1;
    record_preflight("unsigned-over", &wide, &over, 1, resource, 0, 0);
    return 0;
}
