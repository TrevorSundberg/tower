import tower;
import shader_client;
import library.graphics.vulkan.shader_module_types;
import library.graphics.vulkan.image_lifecycle_types;

extern fn vkDestroyShaderModule(device: VkDeviceHandle*, module: VkShaderModuleHandle*, allocator: void*): void;

// The Win64 file loader validates the fixed SPIR-V length and digest before this call.
var SpirvHeaderWords: usize = 5;
struct VkShaderModuleResult { called: bool; result: i32; }

// counted_shader passes one live, initialized slot from its pipeline owner.
fn vk_create_shader_module(device: VkDeviceHandle*, words: u32*, count: usize,
        out: VkShaderModuleHandle**): VkShaderModuleResult {
    var owner: AppShader = { device: device, module: *out };
    var status: i32 = 0;
    var called = app_load_shader(&owner, words, count, &status);
    if called == 1 && status == 0 { *out = owner.module; }
    return { called: called == 1, result: status };
}
