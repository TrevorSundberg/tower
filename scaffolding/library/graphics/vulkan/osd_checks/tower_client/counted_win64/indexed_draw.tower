import tower;
import counted_client;
import library.graphics.vulkan.counted_draw;
import library.graphics.vulkan.image_lifecycle_types;
import library.graphics.indexed_indirect;

var VkCmdDrawIndexedIndirectCountProc: type = PFN_vkCmdDrawIndexedIndirectCount;
extern fn vkGetDeviceProcAddr(device: VkDeviceHandle*, name: u8*): function(void);

struct VulkanIndirectBuffer { handle: VkBufferHandle*; byte_size: u64; }

fn vk_load_indexed_indirect_count(device: VkDeviceHandle*): VkCmdDrawIndexedIndirectCountProc {
    if device == null { return null; }
    return bits(PFN_vkCmdDrawIndexedIndirectCount, vkGetDeviceProcAddr(device, "vkCmdDrawIndexedIndirectCount"));
}

fn vk_record_indexed_indirect_count(draw: VkCmdDrawIndexedIndirectCountProc, cmd: VkCommandBufferHandle*,
        commands: VulkanIndirectBuffer, range: IndexedIndirectRange, count: VulkanIndirectBuffer, count_offset: u64): bool {
    return record_counted(draw, cmd, commands.handle, commands.byte_size, range.command_offset,
        count.handle, count.byte_size, count_offset, range.max_draws, range.stride) == 1;
}
