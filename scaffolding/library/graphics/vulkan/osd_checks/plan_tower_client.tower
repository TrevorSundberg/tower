import tower;
import .readback_abi;

extern fn tower_vk_plan_image_allocation_v1(device: VkDeviceHandle*, image: VkImageHandle*,
    types: VkMemoryType*, count: u32, required: u32, out: VkMemoryAllocateInfo*): u32;

export fn osd_plan(device: VkDeviceHandle*, image: VkImageHandle*, types: VkMemoryType*,
    count: u32, required: u32, out: VkMemoryAllocateInfo*): u32 {
    return tower_vk_plan_image_allocation_v1(device, image, types, count, required, out);
}
