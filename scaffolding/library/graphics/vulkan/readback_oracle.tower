import readback_rows;
import readback_output;
import tower;

extern fn strcmp(left: u8*, right: u8*): i32;

var ReadbackGuard: u8 = 165;

// Literal whole-buffer oracles. These do not use pitches, copy offsets or clear values.
fn readback_guard_hex(): u8* {
    return "a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5";
}
fn readback_gpu_hex(): u8* {
    return "a5a5a5a5112233ff112233ffa5a5a5a5112233ff112233ffa5a5a5a5a5a5a5a5";
}
fn readback_marker_hex(): u8* {
    return "a5a5a5a53031323334353637a5a5a5a56162636465666768a5a5a5a5a5a5a5a5";
}

fn readback_compare(label: u8*, data: u8*, size: usize, wanted: u8*): bool {
    var hex: u8[65];
    if size > (sizeof(decltype(hex)) - 1) / 2 { return false; }
    var digits = "0123456789abcdef";
    for (var at: usize = 0; at < size; at++) {
        var byte = data[at];
        hex[2 * at] = digits[convert(usize, byte >> 4)];
        hex[2 * at + 1] = digits[convert(usize, byte & 15)];
    }
    hex[2 * size] = 0;
    puts(label); puts("expected"); puts(wanted); puts("actual"); puts(&hex[0]);
    return strcmp(wanted, &hex[0]) == 0;
}

fn readback_fixture_destination(data: u8*, capacity: usize): ReadbackDestination {
    return { data: data, capacity: capacity, offset: 4, span: 24, pitch: 12 };
}

fn readback_log_destination(dst: ReadbackDestination*): void {
    readback_size("capacity", dst.capacity); readback_size("offset", dst.offset);
    readback_size("span", dst.span); readback_size("pitch", dst.pitch);
}

fn readback_marker_case(label: u8*, dst: ReadbackDestination*, src: u8*, size: usize,
    pitch: usize, should_copy: bool): bool {
    puts(label); readback_log_destination(dst);
    readback_size("source_size", size); readback_size("source_pitch", pitch);
    fill(dst.data, ReadbackGuard, dst.capacity);
    if !readback_compare("CPU before", dst.data, dst.capacity, readback_guard_hex()) { return false; }
    var copied = readback_two_rows(dst, src, size, pitch);
    if copied { puts("copy=accepted"); } else { puts("copy=refused"); }
    var wanted = readback_guard_hex();
    if should_copy { wanted = readback_marker_hex(); }
    return readback_compare("CPU after", dst.data, dst.capacity, wanted) && copied == should_copy;
}

fn readback_controls(): bool {
    var stage: u8[264]; var guard: u8[32];
    var pitch: usize = 256;
    var size = sizeof(decltype(stage));
    fill(&stage[0], ReadbackGuard, size);
    copy(&stage[0], "01234567", ReadbackRowBytes);
    copy(&stage[pitch], "abcdefgh", ReadbackRowBytes);
    var dst = readback_fixture_destination(&guard[0], sizeof(decltype(guard)));
    if !readback_marker_case("CPU contractual loan", &dst, &stage[0], size, pitch, true)
        || !readback_marker_case("CPU short source", &dst, &stage[0], size - 1, pitch, false) { return false; }
    var control = dst;
    control.pitch = ReadbackRowBytes - 1;
    if !readback_marker_case("CPU short pitch", &control, &stage[0], size, pitch, false) { return false; }
    control = dst; control.span = dst.pitch + ReadbackRowBytes;
    if !readback_marker_case("CPU exact fit", &control, &stage[0], size, pitch, true) { return false; }
    control.span--;
    return readback_marker_case("CPU short span", &control, &stage[0], size, pitch, false);
}
