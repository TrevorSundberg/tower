import tower;
import readback_abi;
import readback_device;
import readback_clear;
import readback_rows;
import validation_instance;

struct ReadbackRequest { index: u32; dst: ReadbackDestination*; }

fn readback_with_instance(instance: VkInstanceHandle*, request: ReadbackRequest): bool {
    puts("backend=Vulkan requested_api=1.3 validation=Khronos+sync severity=warning,error");
    var ctx: ReadbackDevice = default;
    if !readback_open_device(instance, request.index, &ctx) { return false; }
    defer vkDestroyDevice(ctx.device, null);
    return vk_readback_clear(&ctx, request.dst);
}

fn readback_validated(index: u32, messages: u32*, dst: ReadbackDestination*): bool {
    var request: ReadbackRequest = { index: index, dst: dst };
    return with_validation_instance(ReadbackRequest, "draw-tower-rgba8/v1", false, messages, readback_validation_labels(),
        request, readback_with_instance);
}
