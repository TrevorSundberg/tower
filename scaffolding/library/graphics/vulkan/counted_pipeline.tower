import tower;
import counted_abi;
import counted_calls;
import shader_module;
import readback_abi;
import readback_device;
import readback_oracle;
import library.sha256;

// Linux LP64 fixture I/O. The library entry point only borrows in-memory words.
extern fn fopen(path: u8*, mode: u8*): void*;
extern fn fclose(file: void*): i32;
extern fn fseek(file: void*, offset: i64, origin: i32): i32;
extern fn ftell(file: void*): i64;
extern fn fread(data: u8*, size: usize, count: usize, file: void*): usize;

var VkShaderStageTag: u32 = 18;
var VkVertexInputTag: u32 = 19;
var VkAssemblyTag: u32 = 20;
var VkViewportTag: u32 = 22;
var VkRasterTag: u32 = 23;
var VkMultisampleTag: u32 = 24;
var VkColorBlendTag: u32 = 26;
var VkGraphicsPipelineTag: u32 = 28;
var VkComputePipelineTag: u32 = 29;
var VkPipelineLayoutTag: u32 = 30;
var VkSetLayoutTag: u32 = 32;
var VkDescriptorPoolTag: u32 = 33;
var VkSetAllocateTag: u32 = 34;
var VkWriteDescriptorTag: u32 = 35;
var VkPipelineRenderingTag: u32 = 1000044002;
var VkVertexShader: u32 = 1;
var VkFragmentShader: u32 = 16;
var VkComputeShader: u32 = 32;
var VkDescriptorStorageBuffer: u32 = 7;
var VkTriangleList: u32 = 3;
var VkWriteRGBA: u32 = 15;

struct CountedPipelines {
    bindings: VkDescriptorSetLayoutHandle*;
    layout: VkPipelineLayoutHandle*;
    pool: VkDescriptorPoolHandle*;
    set: VkDescriptorSetHandle*;
    compute: VkPipelineHandle*;
    raster: VkPipelineHandle*;
}

fn counted_destroy_pipelines(device: VkDeviceHandle*, p: CountedPipelines*): void {
    vkDestroyPipeline(device, p.raster, null);
    vkDestroyPipeline(device, p.compute, null);
    vkDestroyDescriptorPool(device, p.pool, null);
    vkDestroyPipelineLayout(device, p.layout, null);
    vkDestroyDescriptorSetLayout(device, p.bindings, null);
}

fn counted_shader(calls: CountedCalls*, device: VkDeviceHandle*, path: u8*, wanted: u8*, out: VkShaderModuleHandle**): bool {
    var file = fopen(path, "rb");
    if file == null { puts(path); return vk_failure("Cannot open control SPIR-V"); }
    defer fclose(file);
    if fseek(file, 0, 2) != 0 { return vk_failure("Cannot seek SPIR-V"); }
    var length = ftell(file);
    if length <= 0 || length % convert(i64, sizeof(u32)) != 0 || fseek(file, 0, 0) != 0 { return vk_failure("Invalid SPIR-V length"); }
    var size = convert(usize, length);
    var words = alloc(u32, size / sizeof(u32));
    if words == null { return vk_failure("Cannot allocate shader words"); }
    defer free(words);
    if fread(bits(u8*, words), 1, size, file) != size { return vk_failure("Short SPIR-V read"); }
    var hash: Sha256; sha256_init(&hash);
    if !sha256_update(&hash, bits(u8*, words), size) { return vk_failure("Cannot hash SPIR-V"); }
    var digest = sha256_finish(&hash);
    var hex: u8[65]; sha256_hex(&digest, &hex[0]);
    puts(path); puts(&hex[0]);
    if strcmp(wanted, &hex[0]) != 0 { return vk_failure("Unrecognized control shader digest"); }
    var created = calls.create_shader(device, words, size / sizeof(u32), out);
    if !created.called { return vk_failure("Invalid shader module arguments"); }
    return vk_ok("vkCreateShaderModule", created.result);
}

fn counted_descriptors(device: VkDeviceHandle*, p: CountedPipelines*, buffer: VkBufferHandle*, size: u64): bool {
    var binding: VkDescriptorSetLayoutBinding = { descriptorType: VkDescriptorStorageBuffer,
        descriptorCount: 1, stageFlags: VkComputeShader, ..default };
    var set_info: VkDescriptorSetLayoutCreateInfo = { sType: VkSetLayoutTag, bindingCount: 1, pBindings: &binding, ..default };
    if !vk_ok("vkCreateDescriptorSetLayout", vkCreateDescriptorSetLayout(device, &set_info, null, &p.bindings)) { p.bindings = null; return false; }
    var push: VkPushConstantRange = { stageFlags: VkComputeShader, size: convert(u32, sizeof(u32)), ..default };
    var info: VkPipelineLayoutCreateInfo = { sType: VkPipelineLayoutTag, setLayoutCount: 1, pSetLayouts: &p.bindings,
        pushConstantRangeCount: 1, pPushConstantRanges: &push, ..default };
    if !vk_ok("vkCreatePipelineLayout", vkCreatePipelineLayout(device, &info, null, &p.layout)) { p.layout = null; return false; }
    var counts: VkDescriptorPoolSize = { descriptorType: VkDescriptorStorageBuffer, descriptorCount: 1 };
    var pool: VkDescriptorPoolCreateInfo = { sType: VkDescriptorPoolTag, maxSets: 1, poolSizeCount: 1, pPoolSizes: &counts, ..default };
    if !vk_ok("vkCreateDescriptorPool", vkCreateDescriptorPool(device, &pool, null, &p.pool)) { p.pool = null; return false; }
    var alloc_info: VkDescriptorSetAllocateInfo = { sType: VkSetAllocateTag, descriptorPool: p.pool, descriptorSetCount: 1,
        pSetLayouts: &p.bindings, ..default };
    if !vk_ok("vkAllocateDescriptorSets", vkAllocateDescriptorSets(device, &alloc_info, &p.set)) { return false; }
    var span: VkDescriptorBufferInfo = { buffer: buffer, range: size, ..default };
    var write: VkWriteDescriptorSet = { sType: VkWriteDescriptorTag, dstSet: p.set, descriptorCount: 1,
        descriptorType: VkDescriptorStorageBuffer, pBufferInfo: &span, ..default };
    vkUpdateDescriptorSets(device, 1, &write, 0, null);
    return true;
}

fn counted_pipelines(calls: CountedCalls*, device: VkDeviceHandle*, p: CountedPipelines*, paths: u8**): bool {
    var modules: VkShaderModuleHandle*[3] = default;
    defer {
        for (var i: usize = 0; i < sizeof(decltype(modules)) / sizeof(VkShaderModuleHandle*); i++) {
            vkDestroyShaderModule(device, modules[i], null);
        }
    }
    if !counted_shader(calls, device, paths[0], "eec373ac834ace1f297927483269bb416255a7437c287a0e87aad32b7e654804", &modules[0])
        || !counted_shader(calls, device, paths[1], "7378f68edf277566a637921c002f755b56ab35fddf66ad20b45020f63e35b999", &modules[1])
        || !counted_shader(calls, device, paths[2], "2960fce4af43a503c2723f9b950890142b95bb561f67e5351941c1f9ad3a7517", &modules[2]) { return false; }
    var stage: VkPipelineShaderStageCreateInfo = { sType: VkShaderStageTag, stage: VkComputeShader,
        module: modules[0], pName: "main", ..default };
    var compute: VkComputePipelineCreateInfo = { sType: VkComputePipelineTag, stage: stage, layout: p.layout, ..default };
    if !vk_ok("vkCreateComputePipelines", vkCreateComputePipelines(device, null, 1, &compute, null, &p.compute)) { return false; }
    var stages: VkPipelineShaderStageCreateInfo[2];
    stage.stage = VkVertexShader; stage.module = modules[1]; stages[0] = stage;
    stage.stage = VkFragmentShader; stage.module = modules[2]; stages[1] = stage;
    var vertex: VkPipelineVertexInputStateCreateInfo = { sType: VkVertexInputTag, ..default };
    var assembly: VkPipelineInputAssemblyStateCreateInfo = { sType: VkAssemblyTag, topology: VkTriangleList, ..default };
    var viewport: VkViewport = { width: convert(f32, ReadbackWidth), height: convert(f32, ReadbackHeight), maxDepth: 1.0, ..default };
    var scissor: VkRect2D = { extent: { width: ReadbackWidth, height: ReadbackHeight }, ..default };
    var views: VkPipelineViewportStateCreateInfo = { sType: VkViewportTag, viewportCount: 1, pViewports: &viewport,
        scissorCount: 1, pScissors: &scissor, ..default };
    var raster: VkPipelineRasterizationStateCreateInfo = { sType: VkRasterTag, lineWidth: 1.0, ..default };
    var ms: VkPipelineMultisampleStateCreateInfo = { sType: VkMultisampleTag, rasterizationSamples: VkSample1, ..default };
    var channels: VkPipelineColorBlendAttachmentState = { colorWriteMask: VkWriteRGBA, ..default };
    var blend: VkPipelineColorBlendStateCreateInfo = { sType: VkColorBlendTag, attachmentCount: 1, pAttachments: &channels, ..default };
    var format = VkRgba8Unorm;
    var render: VkPipelineRenderingCreateInfo = { sType: VkPipelineRenderingTag, colorAttachmentCount: 1,
        pColorAttachmentFormats: &format, ..default };
    var graphics: VkGraphicsPipelineCreateInfo = { sType: VkGraphicsPipelineTag, layout: p.layout,
        pNext: bits(void*, &render), stageCount: convert(u32, sizeof(decltype(stages)) / sizeof(decltype(stage))),
        pStages: &stages[0], pVertexInputState: &vertex, pInputAssemblyState: &assembly, pViewportState: &views,
        pRasterizationState: &raster, pMultisampleState: &ms, pColorBlendState: &blend, ..default };
    return vk_ok("vkCreateGraphicsPipelines", vkCreateGraphicsPipelines(device, null, 1, &graphics, null, &p.raster));
}
