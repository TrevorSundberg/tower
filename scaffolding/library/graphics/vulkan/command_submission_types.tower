struct VkQueueHandle {}

struct VkCommandBufferHandle {}

struct VkFenceHandle {}

struct VkSemaphoreHandle {}

struct VkSubmitInfo {
    sType: u32;
    pNext: void*;
    waitSemaphoreCount: u32;
    pWaitSemaphores: VkSemaphoreHandle**;
    pWaitDstStageMask: u32*;
    commandBufferCount: u32;
    pCommandBuffers: VkCommandBufferHandle**;
    signalSemaphoreCount: u32;
    pSignalSemaphores: VkSemaphoreHandle**;
}
