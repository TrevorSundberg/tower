import tower;
import work_buffer;
import work_buffer_types;
import work_budget_types;
import work_pool_types as pool_types;

// The platform implements only thread and semaphore primitives. All admission,
// ownership and dispatch are Tower. Jobs borrow pinned component payloads. The
// coordinator owns busy/count; workers only access a slot between handoffs.
extern fn work_thread_available(): bool;
extern fn work_thread_capacity(): usize;
// True only when keeping idle threads cannot exhaust a fixed host worker set
// needed by another world or phase. This controls lifetime, not job semantics.
extern fn work_thread_retention(): bool;
extern fn work_thread_open(argument: void*): void*;
// Native services may select a separately linked Tower callback. The callback
// still uses this pool's slot handoff, completion and cancellation protocol.
extern fn work_thread_open_named(argument: void*, posix_entry: u8*, windows_entry: u8*): void*;
extern fn work_thread_close(thread: void*): void;
extern fn work_signal_open(): void*;
extern fn work_signal_close(signal: void*): void;
extern fn work_signal_post(signal: void*): void;
extern fn work_signal_wait(signal: void*): void;
extern fn work_signal_try(signal: void*): bool;

var WorkSlot: type = pool_types.WorkSlot;
var WorkPool: type = pool_types.WorkPool;

// A finite batch is only a transport view of already-ready, pre-leased jobs.
// The owner freezes the pointer array and payload layout through the final join.
// Only next is shared mutable state; the claim semaphore protects it.
struct WorkBatch {
    jobs: void**;
    count: usize;
    next: usize;
    offset: usize;
    claim: void*;
    execute: function(void, void*);
}

var WorkPoolMaximumCapacity: usize = pool_types.WorkPoolMaximumCapacity;

export fn work_pool_wait(slot: WorkSlot*): void* {
    work_signal_wait(slot.start);
    return slot.job;
}

export fn work_pool_complete(slot: WorkSlot*): void {
    work_signal_post(slot.finished);
    work_signal_post(slot.completion);
}

fn work_pool_entry(argument: void*): void* {
    var slot = bits(WorkSlot*, argument);
    loop {
        var job = work_pool_wait(slot);
        if job == null {
            return null;
        }
        slot.execute(job);
        // finished publishes this slot's payload; completion wakes the owner.
        // Never read job/busy again until the next start semaphore acquisition.
        work_pool_complete(slot);
    }
}

// Typed kernels share the ordinary platform entry and semaphore handoff. The
// callback is a noncapturing function; job owns/borrows its explicit context.
export fn work_pool_open_kernel(pool: WorkPool*, capacity: usize, execute: function(void, void*)): bool {
    return work_pool_open_kernel_budget(pool, capacity, execute, null);
}

export fn work_pool_open_kernel_budget(pool: WorkPool*, capacity: usize, execute: function(void, void*), budget: WorkBudget*): bool {
    return work_pool_open_impl(pool, capacity, null, null, execute, budget);
}

export fn work_pool_open_impl(pool: WorkPool*, capacity: usize, entry: u8*, windows_entry: u8*, execute: function(void, void*), budget: WorkBudget*): bool {
    *pool = default;
    pool.execute = execute;
    pool.custom_entry = entry != null || windows_entry != null;
    if execute == null || capacity == 0 || capacity > WorkPoolMaximumCapacity {
        pool.resource_error = WorkBudgetError.Invalid;
        return false;
    }
    // A caller's budget is an upper bound, not permission to exhaust a fixed
    // transport. Browser workers report one lane inside a worker so nested
    // phases execute inline instead of waiting on their occupied outer slots.
    var available = work_thread_capacity();
    if available == 0 { pool.resource_error = WorkBudgetError.Capacity; return false; }
    if capacity > available { capacity = available; }
    pool.threaded = work_thread_available() && capacity > 1;
    if !pool.threaded {
        capacity = 1;
    }
    // Reserve the actual clamped slot allocation before opening host handles.
    // These byte grants do not consume execution lanes a second time.
    pool.resource_error = work_buffer_resize(&pool.storage, budget, capacity * sizeof(WorkSlot), 0);
    if pool.resource_error != WorkBudgetError.None { return false; }
    pool.slots = bits(WorkSlot*, pool.storage.data);
    fill(pool.slots, 0, capacity * sizeof(WorkSlot));
    for (var at: usize = 0; at < capacity; at++) { pool.slots[at].execute = execute; }
    if !pool.threaded {
        pool.count = 1;
        return true;
    }
    pool.completion = work_signal_open();
    if pool.completion == null {
        pool.resource_error = WorkBudgetError.Memory;
        work_pool_close(pool);
        return false;
    }
    while pool.count < capacity {
        var slot = &pool.slots[pool.count];
        slot.completion = pool.completion;
        slot.start = work_signal_open();
        slot.finished = work_signal_open();
        pool.count++;
        if slot.start == null || slot.finished == null {
            pool.resource_error = WorkBudgetError.Memory;
            work_pool_close(pool);
            return false;
        }
        slot.thread = entry == null && windows_entry == null ? work_thread_open(bits(void*, slot))
            : work_thread_open_named(bits(void*, slot), entry, windows_entry);
        if slot.thread == null {
            pool.resource_error = WorkBudgetError.Memory;
            work_pool_close(pool);
            return false;
        }
    }
    return true;
}

// Admission only. A serial caller executes its own kernel before receiving;
// threaded slots execute through the callback selected when opening the pool.
export fn work_pool_admit(pool: WorkPool*, job: void*): bool {
    return work_pool_admit_execute(pool, job, pool.execute);
}

// Only ordinary entries read slot.execute. Named entries retain their own
// payload protocol and cannot accept a different per-admission callback.
export fn work_pool_admit_execute(pool: WorkPool*, job: void*, execute: function(void, void*)): bool {
    if execute == null || (pool.custom_entry && execute != pool.execute) { return false; }
    if job == null || pool.running == pool.count {
        return false;
    }
    var index: usize = 0;
    while index < pool.count {
        var slot = &pool.slots[index];
        if !slot.busy {
            slot.job = job;
            slot.execute = execute;
            slot.busy = true;
            pool.running++;
            if pool.running > pool.peak {
                pool.peak = pool.running;
            }
            if pool.threaded {
                work_signal_post(slot.start);
            }
            return true;
        }
        index++;
    }
    return false;
}

export fn work_pool_submit(pool: WorkPool*, job: void*): bool {
    if !work_pool_admit(pool, job) { return false; }
    if !pool.threaded { pool.execute(job); }
    return true;
}

fn work_batch_execute(payload: void*): void {
    var batch = bits(WorkBatch*, payload);
    loop {
        work_signal_wait(batch.claim);
        var next = batch.next;
        if next < batch.count { batch.next++; }
        work_signal_post(batch.claim);
        if next == batch.count { return; }
        var job = bits(void*, bits(u8*, batch.jobs[next]) + batch.offset);
        batch.execute(job);
    }
}

// Caller plus extra_lanes execute a finite batch; no graph/ticket/publication
// authority moves into this view. The caller already owns its lane. The pool
// must be drained, and all jobs, leases and contexts must survive this call.
export fn work_pool_batch(pool: WorkPool*, jobs: void**, count: usize, offset: usize, extra_lanes: usize): bool {
    return work_pool_batch_result(pool, jobs, count, offset, extra_lanes) == WorkBudgetError.None;
}

// Empty input leaves ownership and the previous receipt unchanged. Busy entry
// does NOT own or drain preexisting jobs. Invalid entry likewise changes no
// state. A valid drained entry resets its coordinator-owned failure receipt;
// once dispatch starts, every return joins this call's admitted peers. A failed
// batch may have executed jobs: discard their outputs, never replay the batch.
export fn work_pool_batch_result(pool: WorkPool*, jobs: void**, count: usize, offset: usize,
    extra_lanes: usize): WorkBudgetError {
    if count == 0 { return WorkBudgetError.None; }
    if pool == null { return WorkBudgetError.Invalid; }
    if pool.running != 0 { return WorkBudgetError.Busy; }
    if pool.count == 0 || pool.execute == null || jobs == null { return WorkBudgetError.Invalid; }
    var extra = extra_lanes < pool.count ? extra_lanes : pool.count;
    if extra >= count { extra = count - 1; }
    if !pool.threaded { extra = 0; }
    if extra != 0 && pool.custom_entry { return WorkBudgetError.Invalid; }
    pool.resource_error = WorkBudgetError.None;
    if extra == 0 {
        for(var i: usize = 0; i < count; i++) {
            pool.execute(bits(void*, bits(u8*, jobs[i]) + offset));
        }
        return WorkBudgetError.None;
    }
    if pool.claim == null {
        pool.claim = work_signal_open();
        if pool.claim == null {
            pool.resource_error = WorkBudgetError.Memory;
            return pool.resource_error;
        }
        work_signal_post(pool.claim);
    }
    var batch = init(WorkBatch) {
        jobs: jobs, count: count, next: 0, offset: offset,
        claim: pool.claim, execute: pool.execute
    };
    // This defer runs while batch is alive, including a partial submission
    // failure. No caller may reclaim the borrowed descriptor before the join.
    defer { while pool.running != 0 { work_pool_receive(pool, true); } }
    for(var lane: usize = 0; lane < extra; lane++) {
        if !work_pool_admit_execute(pool, bits(void*, &batch), work_batch_execute) {
            pool.resource_error = WorkBudgetError.Busy;
            return pool.resource_error;
        }
    }
    work_batch_execute(bits(void*, &batch));
    return WorkBudgetError.None;
}

// Exactly one consumed completion token accounts for one returned result. A
// worker may finish in any order; callers publish in semantic order if needed.
export fn work_pool_receive(pool: WorkPool*, wait: bool): void* {
    if pool.running == 0 {
        return null;
    }
    if pool.threaded {
        if wait {
            work_signal_wait(pool.completion);
        } else {
            if !work_signal_try(pool.completion) {
                return null;
            }
        }
    }
    var index: usize = 0;
    while index < pool.count {
        var slot = &pool.slots[index];
        if slot.busy && (!pool.threaded || work_signal_try(slot.finished)) {
            var job = slot.job;
            slot.job = null;
            slot.busy = false;
            pool.running--;
            return job;
        }
        index++;
    }
    trap("Worker completion has no owning slot", 0);
    return null;
}

export fn work_pool_close(pool: WorkPool*): void {
    // Cancellation drains already admitted finite kernels before reclaiming
    // their views. It must not kill threads or free a payload still in use.
    while pool.running != 0 {
        work_pool_receive(pool, true);
    }
    var index: usize = 0;
    while index < pool.count {
        var slot = &pool.slots[index];
        if slot.thread != null {
            slot.job = null;
            work_signal_post(slot.start);
            work_thread_close(slot.thread);
        }
        work_signal_close(slot.start);
        work_signal_close(slot.finished);
        index++;
    }
    work_signal_close(pool.completion);
    work_signal_close(pool.claim);
    work_buffer_dispose(&pool.storage);
    var resource_error = pool.resource_error;
    *pool = default;
    pool.resource_error = resource_error;
}
