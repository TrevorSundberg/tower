import tower;
import bytes;
import bytes_types;
import crc32;
import inflate;
import archive_decode;

var GzipHeaderBytes: usize = 10;
var GzipTrailerBytes: usize = 8;
var GzipWordBytes: usize = 4;
var GzipShortBytes: usize = 2;
enum GzipFlag: u8 { Text = 1, HeaderCrc = 2, Extra = 4, Name = 8, Comment = 16, Reserved = 224 }

fn gzip_read_little(data: u8*, count: usize): u32 {
    var value: u32 = 0; var byte_bits: u32 = 8;
    for (var at: usize = 0; at < count; at++) { value |= convert(u32, data[at]) << (convert(u32, at) * byte_bits); }
    return value;
}

// RFC 1952 members, optional header fields/CRC and concatenation. Rejects
// trailing garbage, corrupt checksum/size and incomplete streams. Caller picks
// the aggregate output limit. No filesystem or external library capabilities.
fn gzip_decode(data: u8*, length: usize, limit: usize, out: ByteBuffer*): ArchiveDecodeResult {
    if data == null || length == 0 { return ArchiveDecodeResult.Truncated; }
    var next: ByteBuffer = default; var member: ByteBuffer = default;
    defer bytes_dispose(&next); defer bytes_dispose(&member);
    var at: usize = 0;
    var identity_first: u8 = 31; var identity_second: u8 = 139; var deflate_method: u8 = 8;
    var method_offset: usize = 2; var flags_offset: usize = 3; var short_mask: u32 = 65535;
    while at < length {
        var start = at;
        if length - at < GzipHeaderBytes { return ArchiveDecodeResult.Truncated; }
        var flags = data[at + flags_offset];
        if data[at] != identity_first || data[at + 1] != identity_second || data[at + method_offset] != deflate_method
            || (flags & convert(u8, GzipFlag.Reserved)) != 0 { return ArchiveDecodeResult.InvalidHeader; }
        at += GzipHeaderBytes;
        if (flags & convert(u8, GzipFlag.Extra)) != 0 {
            if length - at < GzipShortBytes { return ArchiveDecodeResult.Truncated; }
            var size = convert(usize, gzip_read_little(data + at, GzipShortBytes)); at += GzipShortBytes;
            if size > length - at { return ArchiveDecodeResult.Truncated; }
            at += size;
        }
        var flag = convert(u8, GzipFlag.Name);
        while flag <= convert(u8, GzipFlag.Comment) {
            if (flags & flag) != 0 {
                while at < length && data[at] != 0 { at++; }
                if at == length { return ArchiveDecodeResult.Truncated; }
                at++;
            }
            flag <<= 1;
        }
        if (flags & convert(u8, GzipFlag.HeaderCrc)) != 0 {
            if length - at < GzipShortBytes { return ArchiveDecodeResult.Truncated; }
            if (crc32_update(0, data + start, at - start) & short_mask) != gzip_read_little(data + at, GzipShortBytes) {
                return ArchiveDecodeResult.Checksum;
            }
            at += GzipShortBytes;
        }
        var consumed: usize = 0;
        var result = inflate_decode(data + at, length - at, limit - next.length, &member, &consumed);
        if result != ArchiveDecodeResult.Ok { return result; }
        at += consumed;
        if length - at < GzipTrailerBytes { return ArchiveDecodeResult.Truncated; }
        var size = convert(u32, convert(u64, member.length) & convert(u64, ~convert(u32, 0)));
        if gzip_read_little(data + at, GzipWordBytes) != crc32_update(0, member.data, member.length)
            || gzip_read_little(data + at + GzipWordBytes, GzipWordBytes) != size { return ArchiveDecodeResult.Checksum; }
        if !bytes_append(&next, member.data, member.length) { return ArchiveDecodeResult.AllocationFailure; }
        at += GzipTrailerBytes;
    }
    bytes_dispose(out); *out = next; next = default;
    return ArchiveDecodeResult.Ok;
}
