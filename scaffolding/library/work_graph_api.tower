import tower;
import work_graph_types;
import work_budget_types;
import vector;

// One coordinator owns mutation. Import work_graph_types for the shared nominal
// descriptors; link one work_graph implementation. Tickets and borrowed views
// have exactly the implementation's lifetime/partial-failure contracts.
extern fn work_init(g: WorkGraph*, revision: u64, profile: u64): void;
extern fn work_init_budget(g: WorkGraph*, revision: u64, profile: u64, budget: WorkBudget*): bool;
extern fn work_dispose(g: WorkGraph*): void;
extern fn work_reset(g: WorkGraph*, revision: u64, profile: u64): bool;
extern fn work_ok(g: WorkGraph*): bool;
extern fn work_task(g: WorkGraph*, id: usize): WorkTask*;
extern fn work_find(g: WorkGraph*, subject: void*, query: u32, argument: u64): usize;
extern fn work_request(g: WorkGraph*, subject: void*, query: u32, argument: u64): usize;
extern fn work_depend(g: WorkGraph*, consumer: usize, dependency: usize): bool;
extern fn work_access(g: WorkGraph*, id: usize, domain: u64, component: u64, first: usize, count: usize, mode: WorkAccessMode): bool;
extern fn work_access_conflict(a: WorkAccess*, b: WorkAccess*): bool;
extern fn work_access_available(g: WorkGraph*, task: WorkTask*): bool;
extern fn work_seal(g: WorkGraph*, id: usize): bool;
extern fn work_demand(g: WorkGraph*, id: usize): bool;
extern fn work_take(g: WorkGraph*, output: WorkTicket*): bool;
extern fn work_take_query(g: WorkGraph*, output: WorkTicket*, query: u32): bool;
extern fn work_take_task(g: WorkGraph*, output: WorkTicket*, task: usize): bool;
extern fn work_order_ready(g: WorkGraph*): bool;
extern fn work_ticket_valid(g: WorkGraph*, ticket: WorkTicket*): bool;
extern fn work_observe(g: WorkGraph*, ticket: WorkTicket*, dependency: usize): bool;
extern fn work_suspend(g: WorkGraph*, ticket: WorkTicket*, dependency: usize): bool;
extern fn work_suspend_access(g: WorkGraph*, ticket: WorkTicket*, dependency: usize,
    domain: u64, component: u64, first: usize, count: usize, mode: WorkAccessMode): bool;
extern fn work_yield(g: WorkGraph*, ticket: WorkTicket*): bool;
extern fn work_finish(g: WorkGraph*, ticket: WorkTicket*, success: bool): bool;
extern fn work_fail(g: WorkGraph*, id: usize): bool;
extern fn work_cancel(g: WorkGraph*): void;
extern fn work_cycle(g: WorkGraph*, root: usize, output: vector(usize)*): bool;
