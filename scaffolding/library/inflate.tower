import tower;
import bytes;
import bytes_types;
import archive_decode;

// RFC 1951 raw DEFLATE reader. Explicit immutable input and output bound;
// stored, fixed and dynamic blocks, including overlapping/cross-block copies.
// No preset dictionary, host calls or external compression implementation.
var InflateByteBits: u32 = 8;
var InflateMaximumBits: u32 = 15;
var InflateLiteralCount: usize = 288;
var InflateDistanceCount: usize = 32;
var InflateCodeLengthCount: usize = 19;
var InflateEndCode: u32 = 256;
var InflateFirstLength: u32 = 257;
var InflateLastLength: u32 = 285;
var InflateValidDistances: u32 = 30;
var InflateInvalidSymbol: u32 = ~convert(u32, 0);

enum InflateAlphabet: i32 { CodeLengths, Literals, Distances }
enum InflateBlock: u32 { Stored = 0, Fixed = 1, Dynamic = 2, Reserved = 3 }
struct InflateReader {
    data: u8*; length: usize; at: usize; pending: u32; count: u32;
    result: ArchiveDecodeResult;
}
// Literal array bounds mirror the format dimensions above.
struct InflateTree { counts: u32[16]; symbols: u32[288]; maximum: u32; }

fn inflate_bits(reader: InflateReader*, width: u32): u32 {
    if reader.result != ArchiveDecodeResult.Ok { return 0; }
    while reader.count < width {
        if reader.at == reader.length { reader.result = ArchiveDecodeResult.Truncated; return 0; }
        reader.pending |= convert(u32, reader.data[reader.at]) << reader.count;
        reader.at++; reader.count += InflateByteBits;
    }
    var mask: u32 = (1 << width) - 1;
    var value = reader.pending & mask;
    reader.pending >>= width; reader.count -= width;
    return value;
}

fn inflate_tree(tree: InflateTree*, lengths: u32*, count: usize, alphabet: InflateAlphabet): bool {
    *tree = default;
    if count > InflateLiteralCount { return false; }
    for (var at: usize = 0; at < count; at++) {
        var width = lengths[at];
        if width > InflateMaximumBits { return false; }
        tree.counts[width]++;
        if width > tree.maximum { tree.maximum = width; }
    }
    if tree.maximum == 0 { return alphabet == InflateAlphabet.Distances; }
    var unused: i32 = 1;
    for (var width: u32 = 1; width <= InflateMaximumBits; width++) {
        unused = unused * 2 - convert(i32, tree.counts[width]);
        if unused < 0 { return false; }
    }
    // Incomplete literal/distance alphabets may contain one one-bit symbol.
    if unused != 0 && (alphabet == InflateAlphabet.CodeLengths || tree.maximum != 1 || tree.counts[1] != 1) { return false; }
    var positions: u32[16]; positions[0] = 0; positions[1] = 0;
    for (var width: u32 = 1; width < InflateMaximumBits; width++) {
        positions[width + 1] = positions[width] + tree.counts[width];
    }
    for (var at: usize = 0; at < count; at++) {
        var width = lengths[at];
        if width != 0 { tree.symbols[positions[width]] = convert(u32, at); positions[width]++; }
    }
    return true;
}

fn inflate_symbol(reader: InflateReader*, tree: InflateTree*): u32 {
    var code: u32 = 0; var first: u32 = 0; var position: u32 = 0;
    for (var width: u32 = 1; width <= tree.maximum; width++) {
        code = (code << 1) | inflate_bits(reader, 1);
        if reader.result != ArchiveDecodeResult.Ok { return InflateInvalidSymbol; }
        var count = tree.counts[width];
        if code >= first && code - first < count { return tree.symbols[position + code - first]; }
        first = (first + count) << 1;
        position += count;
    }
    reader.result = ArchiveDecodeResult.InvalidCode;
    return InflateInvalidSymbol;
}

fn inflate_fixed(literal: InflateTree*, distance: InflateTree*): bool {
    var lengths: u32[288];
    var high_literal: usize = 144; var high_length: usize = 280;
    var literal_width: u32 = 8; var high_literal_width: u32 = 9; var length_width: u32 = 7;
    var distance_width: u32 = 5;
    for (var at: usize = 0; at < InflateLiteralCount; at++) {
        lengths[at] = at < high_literal ? literal_width : at < convert(usize, InflateEndCode)
            ? high_literal_width : at < high_length ? length_width : literal_width;
    }
    if !inflate_tree(literal, &lengths[0], InflateLiteralCount, InflateAlphabet.Literals) { return false; }
    for (var at: usize = 0; at < InflateDistanceCount; at++) { lengths[at] = distance_width; }
    return inflate_tree(distance, &lengths[0], InflateDistanceCount, InflateAlphabet.Distances);
}

fn inflate_dynamic(reader: InflateReader*, literal: InflateTree*, distance: InflateTree*): bool {
    var count_bits: u32 = 5; var code_count_bits: u32 = 4; var code_width_bits: u32 = 3;
    var code_count_base: u32 = 4;
    var literal_count = inflate_bits(reader, count_bits) + InflateFirstLength;
    var distance_count = inflate_bits(reader, count_bits) + 1;
    var code_count = inflate_bits(reader, code_count_bits) + code_count_base;
    if reader.result != ArchiveDecodeResult.Ok { return false; }
    if literal_count > InflateLastLength + 1 { reader.result = ArchiveDecodeResult.InvalidTree; return false; }
    // The specified code-length alphabet permutation, as data rather than tags.
    var order: u32[19];
    order[0] = 16; order[1] = 17; order[2] = 18; order[3] = 0; order[4] = 8;
    order[5] = 7; order[6] = 9; order[7] = 6; order[8] = 10; order[9] = 5;
    order[10] = 11; order[11] = 4; order[12] = 12; order[13] = 3; order[14] = 13;
    order[15] = 2; order[16] = 14; order[17] = 1; order[18] = 15;
    var lengths: u32[320]; // Maximum literal and distance lengths together.
    for (var at: usize = 0; at < InflateCodeLengthCount; at++) { lengths[at] = 0; }
    for (var at: u32 = 0; at < code_count; at++) { lengths[order[at]] = inflate_bits(reader, code_width_bits); }
    if reader.result != ArchiveDecodeResult.Ok { return false; }
    var codes: InflateTree = default;
    if !inflate_tree(&codes, &lengths[0], InflateCodeLengthCount, InflateAlphabet.CodeLengths) {
        reader.result = ArchiveDecodeResult.InvalidTree; return false;
    }
    var total = literal_count + distance_count; var used: u32 = 0;
    var repeat_previous: u32 = 16; var repeat_short_zero: u32 = 17; var repeat_long_zero: u32 = 18;
    var repeat_minimum: u32 = 3; var repeat_long_minimum: u32 = 11;
    var previous_bits: u32 = 2; var short_bits: u32 = 3; var long_bits: u32 = 7;
    while used < total {
        var symbol = inflate_symbol(reader, &codes);
        if reader.result != ArchiveDecodeResult.Ok { return false; }
        if symbol <= InflateMaximumBits { lengths[used] = symbol; used++; }
        else {
            var repeated: u32 = 0; var count: u32 = 0;
            if symbol == repeat_previous {
                if used == 0 { reader.result = ArchiveDecodeResult.InvalidTree; return false; }
                repeated = lengths[used - 1]; count = repeat_minimum + inflate_bits(reader, previous_bits);
            } else {
                if symbol == repeat_short_zero { count = repeat_minimum + inflate_bits(reader, short_bits); }
                else {
                    if symbol != repeat_long_zero { reader.result = ArchiveDecodeResult.InvalidTree; return false; }
                    count = repeat_long_minimum + inflate_bits(reader, long_bits);
                }
            }
            if reader.result != ArchiveDecodeResult.Ok { return false; }
            if count > total - used { reader.result = ArchiveDecodeResult.InvalidTree; return false; }
            for (var at: u32 = 0; at < count; at++) { lengths[used] = repeated; used++; }
        }
    }
    if lengths[InflateEndCode] == 0
        || !inflate_tree(literal, &lengths[0], convert(usize, literal_count), InflateAlphabet.Literals)
        || !inflate_tree(distance, &lengths[literal_count], convert(usize, distance_count), InflateAlphabet.Distances) {
        reader.result = ArchiveDecodeResult.InvalidTree; return false;
    }
    return true;
}

fn inflate_compressed(reader: InflateReader*, literal: InflateTree*, distance: InflateTree*, limit: usize, out: ByteBuffer*): void {
    var minimum_length: u32 = 3; var maximum_length: u32 = 258;
    var literal_lengths: u32 = 8; var length_group: u32 = 4;
    var literal_distances: u32 = 4; var distance_group: u32 = 2;
    loop {
        var symbol = inflate_symbol(reader, literal);
        if reader.result != ArchiveDecodeResult.Ok || symbol == InflateEndCode { return; }
        if symbol < InflateEndCode {
            if out.length == limit { reader.result = ArchiveDecodeResult.Limit; return; }
            if !bytes_push(out, convert(u8, symbol)) { reader.result = ArchiveDecodeResult.AllocationFailure; return; }
        } else {
            if symbol > InflateLastLength { reader.result = ArchiveDecodeResult.InvalidCode; return; }
            var length = maximum_length;
            if symbol != InflateLastLength {
                length = minimum_length;
                for (var code = InflateFirstLength; code <= symbol; code++) {
                    var index = code - InflateFirstLength;
                    var extra = index < literal_lengths ? 0 : index / length_group - 1;
                    if code == symbol { length += inflate_bits(reader, extra); }
                    else { length += convert(u32, 1) << extra; }
                }
            }
            var distance_symbol = inflate_symbol(reader, distance);
            if reader.result != ArchiveDecodeResult.Ok { return; }
            if distance_symbol >= InflateValidDistances { reader.result = ArchiveDecodeResult.InvalidCode; return; }
            var backward: u32 = 1;
            for (var code: u32 = 0; code <= distance_symbol; code++) {
                var extra = code < literal_distances ? 0 : code / distance_group - 1;
                if code == distance_symbol { backward += inflate_bits(reader, extra); }
                else { backward += convert(u32, 1) << extra; }
            }
            if reader.result != ArchiveDecodeResult.Ok { return; }
            if convert(usize, backward) > out.length { reader.result = ArchiveDecodeResult.InvalidDistance; return; }
            if convert(usize, length) > limit - out.length { reader.result = ArchiveDecodeResult.Limit; return; }
            if !bytes_reserve(out, out.length + convert(usize, length)) { reader.result = ArchiveDecodeResult.AllocationFailure; return; }
            for (var at: u32 = 0; at < length; at++) {
                out.data[out.length] = out.data[out.length - convert(usize, backward)]; out.length++;
            }
        }
    }
}

// Decode one stream and report its byte extent (including final bit padding).
// Trailing bytes belong to the caller's envelope. Failure preserves both out
// and consumed. Input may borrow out's old storage until successful publication.
fn inflate_decode(data: u8*, length: usize, limit: usize, out: ByteBuffer*, consumed: usize*): ArchiveDecodeResult {
    if data == null && length != 0 { return ArchiveDecodeResult.Truncated; }
    var reader: InflateReader = { data: data, length: length, ..default };
    var next: ByteBuffer = default; defer bytes_dispose(&next);
    var literal: InflateTree = default; var distance: InflateTree = default;
    var block_bits: u32 = 2; var short_bits: u32 = 16; var short_mask: u32 = 65535;
    var final = false;
    while !final && reader.result == ArchiveDecodeResult.Ok {
        final = inflate_bits(&reader, 1) != 0;
        var block = inflate_bits(&reader, block_bits);
        if reader.result != ArchiveDecodeResult.Ok { break; }
        if block == convert(u32, InflateBlock.Stored) {
            reader.pending = 0; reader.count = 0;
            var count = inflate_bits(&reader, short_bits); var complement = inflate_bits(&reader, short_bits);
            if reader.result != ArchiveDecodeResult.Ok { break; }
            if (count ^ complement) != short_mask { reader.result = ArchiveDecodeResult.InvalidBlock; break; }
            if convert(usize, count) > reader.length - reader.at { reader.result = ArchiveDecodeResult.Truncated; break; }
            if convert(usize, count) > limit - next.length { reader.result = ArchiveDecodeResult.Limit; break; }
            if !bytes_append(&next, reader.data + reader.at, convert(usize, count)) { reader.result = ArchiveDecodeResult.AllocationFailure; break; }
            reader.at += convert(usize, count);
        } else {
            if block == convert(u32, InflateBlock.Fixed) {
                if !inflate_fixed(&literal, &distance) { reader.result = ArchiveDecodeResult.InvalidTree; break; }
            } else {
                if block == convert(u32, InflateBlock.Reserved) { reader.result = ArchiveDecodeResult.InvalidBlock; break; }
                if !inflate_dynamic(&reader, &literal, &distance) { break; }
            }
            inflate_compressed(&reader, &literal, &distance, limit, &next);
        }
    }
    if reader.result != ArchiveDecodeResult.Ok { return reader.result; }
    bytes_dispose(out); *out = next; next = default; *consumed = reader.at;
    return ArchiveDecodeResult.Ok;
}
