import 'vector';
import tower;

// A stack is a vector policy, sharing its storage and allocation contract.
fn stack(T: type): type {
    return vector(T);
}

fn stack_init(T: type, value: stack(T)*): void {
    vector_init(T, value);
}

fn stack_push(T: type, value: stack(T)*, element: T): bool {
    return vector_push(T, value, element);
}

fn stack_pop(T: type, value: stack(T)*, output: T*): bool {
    return vector_pop(T, value, output);
}

fn stack_move(T: type, destination: stack(T)*, source: stack(T)*): void {
    vector_move(T, destination, source);
}

fn stack_dispose(T: type, value: stack(T)*): void {
    vector_dispose(T, value);
}
