import tower;
import work_buffer_types;
import work_budget_types;

struct WorkSlot {
    thread: void*;
    start: void*;
    finished: void*;
    completion: void*;
    job: void*;
    execute: function(void, void*);
    busy: bool;
}

// Coordinator-owned transport descriptor. Workers borrow one slot between
// semaphore handoffs. The physical slot owner survives every admitted join.
struct WorkPool {
    slots: WorkSlot*;
    count: usize;
    running: usize;
    peak: usize;
    completion: void*;
    threaded: bool;
    custom_entry: bool;
    execute: function(void, void*);
    claim: void*;
    storage: WorkBuffer;
    resource_error: WorkBudgetError;
}

var WorkPoolMaximumCapacity: usize = 256;
