import library.testing;
import .host.memory;
import work_graph;
import vector;

fn request(g: WorkGraph*, key: u64): usize {
    var id = work_request(g, null, 1, key);
    assert(id != 0);
    return id;
}

// Suspension, redispatch and stale tickets.
test() {
    var g: WorkGraph;
    work_init(&g, 11, 29);
    var query = request(&g, 1);
    var input = request(&g, 2);
    var unused = request(&g, 3);
    assert(work_access(&g, query, 1, 1, 0, 8, WorkAccessMode.Write));
    assert(work_access(&g, input, 1, 1, 0, 8, WorkAccessMode.Write));
    assert(work_seal(&g, query));
    assert(work_seal(&g, input));
    assert(work_seal(&g, unused));
    assert(work_demand(&g, query));
    var ticket: WorkTicket;
    var old: WorkTicket;
    var spare: WorkTicket;
    assert(work_take(&g, &ticket));
    assert(ticket.task == query);
    old = ticket;
    assert(!work_suspend(&g, &ticket, 0));
    assert(work_ticket_valid(&g, &ticket));
    assert(work_suspend(&g, &ticket, input));
    assert(g.running == 0);
    assert(g.executing.length == 0);
    assert(!work_finish(&g, &old, true));
    assert(work_take(&g, &ticket));
    assert(ticket.task == input);
    assert(!work_take(&g, &spare));
    assert(work_finish(&g, &ticket, true));
    assert(work_take(&g, &ticket));
    assert(ticket.task == query);
    assert(ticket.dispatch != old.dispatch);
    assert(!work_finish(&g, &old, true));
    assert(!work_suspend(&g, &old, unused));
    assert(g.running == 1);
    assert(g.executing.length == 1);
    // Reobserving a completed input neither duplicates the edge nor its work.
    assert(work_suspend(&g, &ticket, input));
    assert(g.edges.length == 1);
    assert(work_take(&g, &ticket));
    assert(ticket.task == query);
    assert(work_task(&g, input).dispatch == 1);
    old = ticket;
    assert(work_yield(&g, &ticket));
    assert(!work_ticket_valid(&g, &old));
    assert(work_take(&g, &ticket));
    assert(ticket.task == query && ticket.dispatch != old.dispatch);
    assert(work_finish(&g, &ticket, true));
    assert(!work_take(&g, &spare));
    assert(!work_task(&g, unused).demanded);
    assert(g.running == 0);
    work_dispose(&g);
}

// Both sides of a diamond wait for a single producer.
test() {
    var g: WorkGraph;
    work_init(&g, 12, 29);
    var left = request(&g, 1);
    var right = request(&g, 2);
    var shared = request(&g, 3);
    assert(work_seal(&g, left));
    assert(work_seal(&g, right));
    assert(work_seal(&g, shared));
    assert(work_demand(&g, left));
    assert(work_demand(&g, right));
    var a: WorkTicket;
    var b: WorkTicket;
    var c: WorkTicket;
    assert(work_take(&g, &a));
    assert(work_take(&g, &b));
    assert(work_suspend(&g, &a, shared));
    assert(work_suspend(&g, &b, shared));
    assert(work_take(&g, &c));
    assert(c.task == shared);
    assert(!work_take(&g, &a));
    assert(work_finish(&g, &c, true));
    assert(work_take(&g, &a));
    assert(work_take(&g, &b));
    assert(a.task != b.task);
    assert(work_finish(&g, &b, true));
    assert(work_finish(&g, &a, true));
    assert(work_task(&g, shared).dispatch == 1);
    assert(!work_take(&g, &c));
    work_dispose(&g);
}

// A discovered read permits peers and excludes an overlapping writer.
test() {
    var g: WorkGraph;
    work_init(&g, 18, 29);
    defer work_dispose(&g);
    var query = work_request(&g, null, 1, 0);
    var input = work_request(&g, null, 2, 0);
    var writer = work_request(&g, null, 3, 0);
    var reader = work_request(&g, null, 4, 0);
    var unrelated = work_request(&g, null, 5, 0);
    assert(work_access(&g, input, 1, 1, 20, 4, WorkAccessMode.Write));
    assert(work_access(&g, writer, 1, 1, 20, 4, WorkAccessMode.Write));
    assert(work_access(&g, reader, 1, 1, 20, 4, WorkAccessMode.Read));
    assert(work_access(&g, unrelated, 1, 1, 24, 1, WorkAccessMode.Write));
    assert(work_seal(&g, query));
    assert(work_seal(&g, input));
    assert(work_seal(&g, writer));
    assert(work_seal(&g, reader));
    assert(work_seal(&g, unrelated));
    assert(work_demand(&g, query));
    var old: WorkTicket;
    var current: WorkTicket;
    var peer: WorkTicket;
    var spare: WorkTicket;
    assert(work_take(&g, &old));
    assert(work_suspend_access(&g, &old, input, 1, 1, 20, 4, WorkAccessMode.Read));
    assert(g.running == 0);
    // The new read claim must not prevent its own producer from running.
    assert(work_take(&g, &current));
    assert(current.task == input);
    assert(work_finish(&g, &current, true));
    assert(work_demand(&g, writer));
    assert(work_demand(&g, reader));
    assert(work_demand(&g, unrelated));
    assert(work_take_query(&g, &current, 1));
    var claims = g.accesses.length;
    assert(!work_suspend_access(&g, &old, input, 1, 1, 20, 4, WorkAccessMode.Write));
    assert(g.accesses.length == claims);
    assert(work_take_query(&g, &peer, 4));
    assert(work_take_query(&g, &spare, 5));
    assert(work_finish(&g, &spare, true));
    assert(!work_take_query(&g, &spare, 3));
    assert(work_finish(&g, &current, true));
    assert(!work_take_query(&g, &spare, 3));
    assert(work_finish(&g, &peer, true));
    assert(work_take_query(&g, &spare, 3));
    assert(work_finish(&g, &spare, true));
    assert(g.running == 0 && work_ok(&g));
}

// An input failure propagates to its consumer. Cancellation retires its ticket.
test() {
    var g: WorkGraph;
    work_init(&g, 13, 29);
    var query = request(&g, 1);
    var input = request(&g, 2);
    assert(work_seal(&g, query));
    assert(work_seal(&g, input));
    assert(work_demand(&g, query));
    var ticket: WorkTicket;
    assert(work_take(&g, &ticket));
    assert(work_suspend(&g, &ticket, input));
    assert(work_take(&g, &ticket));
    assert(work_finish(&g, &ticket, false));
    assert(work_task(&g, query).state == WorkState.Failed);
    assert(!work_take(&g, &ticket));
    assert(g.running == 0);
    work_dispose(&g);

    work_init(&g, 14, 29);
    query = request(&g, 1);
    input = request(&g, 2);
    assert(work_seal(&g, query));
    assert(work_seal(&g, input));
    assert(work_demand(&g, query));
    assert(work_take(&g, &ticket));
    assert(work_suspend(&g, &ticket, input));
    assert(work_take(&g, &ticket));
    work_cancel(&g);
    assert(!work_finish(&g, &ticket, true));
    assert(!work_suspend(&g, &ticket, query));
    assert(g.running == 0);
    work_dispose(&g);
}

// Report the ordered dependency cycle and the direct self-cycle.
test() {
    var g: WorkGraph;
    work_init(&g, 15, 29);
    var first = request(&g, 1);
    var second = request(&g, 2);
    assert(work_seal(&g, first));
    assert(work_seal(&g, second));
    assert(work_demand(&g, first));
    var ticket: WorkTicket;
    assert(work_take(&g, &ticket));
    assert(work_suspend(&g, &ticket, second));
    assert(work_take(&g, &ticket));
    assert(work_suspend(&g, &ticket, first));
    assert(!work_take(&g, &ticket));
    assert(g.running == 0);
    var cycle: vector(usize);
    vector_init(usize, &cycle);
    assert(work_cycle(&g, first, &cycle));
    assert(cycle.length == 3);
    assert(cycle.data[0] == first);
    assert(cycle.data[1] == second);
    assert(cycle.data[2] == first);
    vector_dispose(usize, &cycle);
    work_dispose(&g);

    work_init(&g, 16, 29);
    first = request(&g, 1);
    assert(work_seal(&g, first));
    assert(work_demand(&g, first));
    assert(work_take(&g, &ticket));
    assert(work_suspend(&g, &ticket, first));
    vector_init(usize, &cycle);
    assert(work_cycle(&g, first, &cycle));
    assert(cycle.length == 2);
    vector_dispose(usize, &cycle);
    work_dispose(&g);
}

// Query zero is a filterable value.
test() {
    var graph: WorkGraph;
    work_init(&graph, 17, 29);
    var zero = work_request(&graph, null, 0, 1);
    var other = work_request(&graph, null, 2, 1);
    assert(work_seal(&graph, zero));
    assert(work_seal(&graph, other));
    assert(work_demand(&graph, other));
    assert(work_demand(&graph, zero));
    var ticket: WorkTicket;
    assert(work_take_query(&graph, &ticket, 0));
    assert(ticket.task == zero);
    assert(work_finish(&graph, &ticket, true));
    assert(!work_take_query(&graph, &ticket, 0));
    assert(work_take(&graph, &ticket));
    assert(ticket.task == other);
    assert(work_finish(&graph, &ticket, true));
    work_dispose(&graph);
}

// A reset requires quiescence and invalidates tickets for reused task IDs.
test() {
    var graph: WorkGraph;
    work_init(&graph, 31, 29);
    assert(work_find(&graph, null, 1, 1) == 0);
    var first = request(&graph, 1);
    assert(work_find(&graph, null, 1, 1) == first);
    assert(!work_reset(&graph, 32, 29));
    assert(work_seal(&graph, first));
    assert(work_demand(&graph, first));
    var old: WorkTicket;
    assert(work_take(&graph, &old));
    assert(!work_reset(&graph, 32, 29));
    assert(work_finish(&graph, &old, true));
    assert(!work_reset(&graph, 31, 29));
    assert(work_reset(&graph, 32, 29));
    assert(work_find(&graph, null, 1, 1) == 0);
    first = request(&graph, 1);
    assert(work_seal(&graph, first));
    assert(work_demand(&graph, first));
    var current: WorkTicket;
    assert(work_take(&graph, &current));
    assert(current.task == old.task);
    assert(!work_finish(&graph, &old, true));
    assert(work_finish(&graph, &current, true));
    work_dispose(&graph);
}

// Selecting a task respects its state, dependencies and conflicting access.
test() {
    var graph: WorkGraph;
    work_init(&graph, 41, 29);
    defer work_dispose(&graph);
    var first = request(&graph, 1);
    var second = request(&graph, 2);
    var blocked = request(&graph, 3);
    assert(work_access(&graph, first, 1, 1, 0, 1, WorkAccessMode.Write));
    assert(work_access(&graph, second, 1, 1, 0, 1, WorkAccessMode.Read));
    assert(work_depend(&graph, blocked, first));
    assert(work_seal(&graph, first));
    assert(work_seal(&graph, second));
    assert(work_seal(&graph, blocked));
    assert(work_demand(&graph, first));
    assert(work_demand(&graph, second));
    assert(work_demand(&graph, blocked));
    var selected: WorkTicket;
    var spare: WorkTicket = default;
    assert(!work_take_task(&graph, &spare, 0));
    assert(!work_take_task(&graph, &spare, 999));
    assert(!work_take_task(&graph, &spare, blocked));
    assert(spare.task == 0);
    assert(work_take_task(&graph, &selected, second));
    assert(selected.task == second);
    assert(!work_take_task(&graph, &spare, first));
    assert(spare.task == 0);
    assert(work_finish(&graph, &selected, true));
    assert(!work_take_task(&graph, &spare, second));
    assert(work_take(&graph, &spare));
    assert(spare.task == first);
    assert(work_finish(&graph, &spare, true));
    assert(work_take_task(&graph, &spare, blocked));
    assert(work_finish(&graph, &spare, true));
    assert(!work_take(&graph, &spare));
    assert(graph.running == 0 && work_ok(&graph));
}
