import tower;
import bytes;
import bytes_types;
import vector;
import .compiler.utf8;

// Strict UTF-8 JSON with unique decoded object keys and Unicode scalar strings.
// Numbers retain exact source spelling; conversion is explicit. No host calls.
// The document borrows immutable input disjoint from its own storage until
// disposal. Node indices stay stable; pointers into growable storage do not.
enum JsonKind: i32 { Null, False, True, Number, String, Array, Object }
enum JsonError: i32 { Ok, Syntax, Utf8, Unicode, DuplicateKey, Limit, AllocationFailure }
struct JsonResult { error: JsonError; offset: usize; }
struct JsonLimits { nodes: usize; depth: usize; string_bytes: usize; }
struct JsonNode {
    kind: JsonKind; start: usize; length: usize;
    text: usize; text_length: usize; key: usize; key_length: usize;
    has_key: bool; first_child: usize; next: usize;
}
struct JsonDocument { source: u8*; length: usize; nodes: vector(JsonNode); strings: ByteBuffer; }
struct JsonReader { document: JsonDocument*; at: usize; limits: JsonLimits; result: JsonResult; }
var JsonNoNode: usize = ~convert(usize, 0);
enum JsonByte: u8 {
    Nul = 0, Backspace = 8, Tab = 9, LineFeed = 10, FormFeed = 12, CarriageReturn = 13,
    Space = 32, Quote = 34, Plus = 43, Comma = 44, Minus = 45, Dot = 46, Slash = 47,
    Zero = 48, Nine = 57, Colon = 58, UpperA = 65, UpperE = 69, UpperF = 70,
    ArrayBegin = 91, Escape = 92, ArrayEnd = 93, LowerA = 97, LowerB = 98,
    LowerE = 101, LowerF = 102, LowerN = 110, LowerR = 114, LowerT = 116,
    LowerU = 117, ObjectBegin = 123, ObjectEnd = 125
}

fn json_dispose(document: JsonDocument*): void {
    vector_dispose(&document.nodes); bytes_dispose(&document.strings); *document = default;
}
fn json_fail(reader: JsonReader*, error: JsonError): bool {
    if reader.result.error == JsonError.Ok { reader.result = init(JsonResult) { error: error, offset: reader.at }; }
    return false;
}
fn json_peek(reader: JsonReader*): u8 { return reader.at < reader.document.length ? reader.document.source[reader.at] : 0; }
fn json_take(reader: JsonReader*, byte: JsonByte): bool {
    if reader.at == reader.document.length || json_peek(reader) != convert(u8, byte) { return false; }
    reader.at++; return true;
}
fn json_space(reader: JsonReader*): void {
    while reader.at < reader.document.length {
        var byte = json_peek(reader);
        if byte != convert(u8, JsonByte.Space) && byte != convert(u8, JsonByte.Tab)
            && byte != convert(u8, JsonByte.LineFeed) && byte != convert(u8, JsonByte.CarriageReturn) { break; }
        reader.at++;
    }
}
fn json_append(reader: JsonReader*, data: u8*, length: usize): bool {
    var strings = &reader.document.strings;
    if length > reader.limits.string_bytes - strings.length { return json_fail(reader, JsonError.Limit); }
    return bytes_append(strings, data, length) || json_fail(reader, JsonError.AllocationFailure);
}
fn json_hex_unit(reader: JsonReader*, value: u32*): bool {
    var digits: usize = 4; var hex_bits: u32 = 4; var decimal_digits: u32 = 10;
    if digits > reader.document.length - reader.at { return json_fail(reader, JsonError.Syntax); }
    var result: u32 = 0;
    for (var at: usize = 0; at < digits; at++) {
        var byte = json_peek(reader); reader.at++;
        var digit: u32 = 0;
        if byte >= convert(u8, JsonByte.Zero) && byte <= convert(u8, JsonByte.Nine) {
            digit = convert(u32, byte - convert(u8, JsonByte.Zero));
        } else {
            if byte >= convert(u8, JsonByte.LowerA) && byte <= convert(u8, JsonByte.LowerF) {
                digit = convert(u32, byte - convert(u8, JsonByte.LowerA)) + decimal_digits;
            } else {
                if byte < convert(u8, JsonByte.UpperA) || byte > convert(u8, JsonByte.UpperF) { return json_fail(reader, JsonError.Syntax); }
                digit = convert(u32, byte - convert(u8, JsonByte.UpperA)) + decimal_digits;
            }
        }
        result = (result << hex_bits) | digit;
    }
    *value = result; return true;
}
fn json_string(reader: JsonReader*, offset: usize*, length: usize*): bool {
    if !json_take(reader, JsonByte.Quote) { return json_fail(reader, JsonError.Syntax); }
    *offset = reader.document.strings.length;
    while reader.at < reader.document.length {
        var byte = json_peek(reader); reader.at++;
        if byte == convert(u8, JsonByte.Quote) {
            *length = reader.document.strings.length - *offset;
            var terminator: u8 = 0;
            return json_append(reader, &terminator, 1);
        }
        if byte < convert(u8, JsonByte.Space) { return json_fail(reader, JsonError.Syntax); }
        if byte == convert(u8, JsonByte.Escape) {
            if reader.at == reader.document.length { return json_fail(reader, JsonError.Syntax); }
            byte = json_peek(reader); reader.at++;
            if byte == convert(u8, JsonByte.LowerU) {
                var scalar: u32 = 0;
                if !json_hex_unit(reader, &scalar) { return false; }
                var high_start: u32 = 55296; var low_start: u32 = 56320; var low_end: u32 = 57343;
                var supplementary: u32 = 65536; var surrogate_bits: u32 = 10;
                if scalar >= high_start && scalar < low_start {
                    var low: u32 = 0;
                    if !json_take(reader, JsonByte.Escape) || !json_take(reader, JsonByte.LowerU)
                        || !json_hex_unit(reader, &low) { return json_fail(reader, JsonError.Unicode); }
                    if low < low_start || low > low_end { return json_fail(reader, JsonError.Unicode); }
                    scalar = supplementary + ((scalar - high_start) << surrogate_bits) + low - low_start;
                } else {
                    if scalar >= low_start && scalar <= low_end { return json_fail(reader, JsonError.Unicode); }
                }
                var encoded: u8[4]; var capacity: usize = 4;
                var count = tower_utf8_encode(scalar, &encoded[0], capacity);
                if count == 0 { return json_fail(reader, JsonError.Unicode); }
                if !json_append(reader, &encoded[0], count) { return false; }
                continue;
            }
            if byte == convert(u8, JsonByte.LowerB) { byte = convert(u8, JsonByte.Backspace); }
            else { if byte == convert(u8, JsonByte.LowerF) { byte = convert(u8, JsonByte.FormFeed); }
            else { if byte == convert(u8, JsonByte.LowerN) { byte = convert(u8, JsonByte.LineFeed); }
            else { if byte == convert(u8, JsonByte.LowerR) { byte = convert(u8, JsonByte.CarriageReturn); }
            else { if byte == convert(u8, JsonByte.LowerT) { byte = convert(u8, JsonByte.Tab); }
            else { if byte != convert(u8, JsonByte.Quote) && byte != convert(u8, JsonByte.Escape)
                && byte != convert(u8, JsonByte.Slash) { return json_fail(reader, JsonError.Syntax); } } } } } }
        }
        if !json_append(reader, &byte, 1) { return false; }
    }
    return json_fail(reader, JsonError.Syntax);
}
fn json_digit(byte: u8): bool { return byte >= convert(u8, JsonByte.Zero) && byte <= convert(u8, JsonByte.Nine); }
fn json_digits(reader: JsonReader*): bool {
    var start = reader.at;
    while json_digit(json_peek(reader)) { reader.at++; }
    return reader.at != start || json_fail(reader, JsonError.Syntax);
}
fn json_number(reader: JsonReader*): bool {
    json_take(reader, JsonByte.Minus);
    if !json_take(reader, JsonByte.Zero) && !json_digits(reader) { return false; }
    if json_take(reader, JsonByte.Dot) && !json_digits(reader) { return false; }
    if json_take(reader, JsonByte.LowerE) || json_take(reader, JsonByte.UpperE) {
        if !json_take(reader, JsonByte.Plus) { json_take(reader, JsonByte.Minus); }
        if !json_digits(reader) { return false; }
    }
    return true;
}
fn json_keyword(reader: JsonReader*, text: u8*, length: usize): bool {
    if length > reader.document.length - reader.at { return json_fail(reader, JsonError.Syntax); }
    for (var at: usize = 0; at < length; at++) {
        if reader.document.source[reader.at + at] != text[at] { return json_fail(reader, JsonError.Syntax); }
    }
    reader.at += length; return true;
}
fn json_text_equal(document: JsonDocument*, offset: usize, length: usize, data: u8*, count: usize): bool {
    if length != count { return false; }
    for (var at: usize = 0; at < length; at++) { if document.strings.data[offset + at] != data[at] { return false; } }
    return true;
}
fn json_unique_key(reader: JsonReader*, first: usize, offset: usize, length: usize): bool {
    var at = first;
    while at != JsonNoNode {
        var node = &reader.document.nodes.data[at];
        if json_text_equal(reader.document, node.key, node.key_length, reader.document.strings.data + offset, length) {
            return json_fail(reader, JsonError.DuplicateKey);
        }
        at = node.next;
    }
    return true;
}
fn json_value(reader: JsonReader*, depth: usize): usize {
    json_space(reader);
    if depth > reader.limits.depth || reader.document.nodes.length == reader.limits.nodes {
        json_fail(reader, JsonError.Limit); return JsonNoNode;
    }
    var nodes = &reader.document.nodes;
    if !vector_reserve(nodes, nodes.length + 1) { json_fail(reader, JsonError.AllocationFailure); return JsonNoNode; }
    var index = nodes.length; nodes.length++;
    var node: JsonNode = { start: reader.at, first_child: JsonNoNode, next: JsonNoNode, ..default };
    nodes.data[index] = node;
    var byte = json_peek(reader);
    if byte == convert(u8, JsonByte.ObjectBegin) || byte == convert(u8, JsonByte.ArrayBegin) {
        var object = byte == convert(u8, JsonByte.ObjectBegin);
        var closing = object ? JsonByte.ObjectEnd : JsonByte.ArrayEnd;
        node.kind = object ? JsonKind.Object : JsonKind.Array;
        reader.at++; json_space(reader);
        var last = JsonNoNode;
        if !json_take(reader, closing) {
            loop {
                var key: usize = 0; var key_length: usize = 0;
                if object {
                    if !json_string(reader, &key, &key_length) || !json_unique_key(reader, node.first_child, key, key_length) { return JsonNoNode; }
                    json_space(reader);
                    if !json_take(reader, JsonByte.Colon) { json_fail(reader, JsonError.Syntax); return JsonNoNode; }
                }
                var child = json_value(reader, depth + 1);
                if child == JsonNoNode { return JsonNoNode; }
                nodes.data[child].key = key; nodes.data[child].key_length = key_length; nodes.data[child].has_key = object;
                if last == JsonNoNode { node.first_child = child; } else { nodes.data[last].next = child; }
                last = child; json_space(reader);
                if json_take(reader, closing) { break; }
                if !json_take(reader, JsonByte.Comma) { json_fail(reader, JsonError.Syntax); return JsonNoNode; }
                json_space(reader);
            }
        }
    } else { if byte == convert(u8, JsonByte.Quote) {
        node.kind = JsonKind.String;
        if !json_string(reader, &node.text, &node.text_length) { return JsonNoNode; }
    } else { if byte == convert(u8, JsonByte.LowerN) {
        node.kind = JsonKind.Null; if !json_keyword(reader, "null", 4) { return JsonNoNode; }
    } else { if byte == convert(u8, JsonByte.LowerT) {
        node.kind = JsonKind.True; if !json_keyword(reader, "true", 4) { return JsonNoNode; }
    } else { if byte == convert(u8, JsonByte.LowerF) {
        node.kind = JsonKind.False; if !json_keyword(reader, "false", 5) { return JsonNoNode; }
    } else {
        node.kind = JsonKind.Number;
        if !json_number(reader) { return JsonNoNode; }
    } } } } }
    node.length = reader.at - node.start; nodes.data[index] = node; return index;
}

// On failure, document is unchanged. Limits cover nodes, nesting (root depth
// zero) and decoded string storage, including one NUL terminator per string.
fn json_parse(data: u8*, length: usize, limits: JsonLimits, document: JsonDocument*): JsonResult {
    if data == null && length != 0 || tower_utf8_validate(data, length, 0) == 0 {
        return init(JsonResult) { error: JsonError.Utf8, ..default };
    }
    var next: JsonDocument = { source: data, length: length, ..default };
    defer json_dispose(&next);
    var reader: JsonReader = { document: &next, limits: limits, ..default };
    if json_value(&reader, 0) == JsonNoNode { return reader.result; }
    json_space(&reader);
    if reader.at != length { json_fail(&reader, JsonError.Syntax); return reader.result; }
    json_dispose(document); *document = next; next = default;
    return reader.result;
}
fn json_find(document: JsonDocument*, object: usize, key: u8*, length: usize): usize {
    if object >= document.nodes.length || document.nodes.data[object].kind != JsonKind.Object { return JsonNoNode; }
    var at = document.nodes.data[object].first_child;
    while at != JsonNoNode {
        var node = &document.nodes.data[at];
        if json_text_equal(document, node.key, node.key_length, key, length) { return at; }
        at = node.next;
    }
    return JsonNoNode;
}
fn json_u64(document: JsonDocument*, index: usize, value: u64*): bool {
    if index >= document.nodes.length || document.nodes.data[index].kind != JsonKind.Number { return false; }
    var node = &document.nodes.data[index]; var parsed: u64 = 0; var radix: u64 = 10;
    var maximum = ~convert(u64, 0);
    for (var at: usize = 0; at < node.length; at++) {
        var byte = document.source[node.start + at];
        if !json_digit(byte) { return false; }
        var digit = convert(u64, byte - convert(u8, JsonByte.Zero));
        if parsed > (maximum - digit) / radix { return false; }
        parsed = parsed * radix + digit;
    }
    *value = parsed; return true;
}
