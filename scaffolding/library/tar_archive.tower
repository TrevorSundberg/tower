import tower;
import bytes;
import bytes_types;
import zip_archive;

// Deterministic POSIX ustar regular-file writer. Caller chooses member order
// and permissions; uid/gid/mtime and owner names are fixed to zero/empty.
// No host filesystem access, links, PAX records or base-256 size extensions.
enum TarResult: i32 { Ok, InvalidName, DuplicateName, Unsupported, Limit, AllocationFailure }
enum TarField: usize {
    Name = 0, Mode = 100, Uid = 108, Gid = 116, Size = 124, Mtime = 136,
    Checksum = 148, Type = 156, Magic = 257, Version = 263,
    Prefix = 345
}
var TarBlockBytes: usize = 512;
var TarRecordBytes: usize = 10240;
var TarEndBlocks: usize = 2;
var TarNameBytes: usize = 100;
var TarPrefixBytes: usize = 155;
var TarShortFieldBytes: usize = 8;
var TarLongFieldBytes: usize = 12;
var TarSizeLimit: u64 = 8589934591;
var TarModeLimit: u32 = 4095;

struct TarEntry {
    name: u8*;
    name_length: usize;
    data: u8*;
    length: usize;
    mode: u32;
}

fn tar_octal(field: u8*, width: usize, value: u64): bool {
    var digit_zero: u8 = 48; var radix: u64 = 8;
    field[width - 1] = 0;
    for (var at = width - 1; at != 0; at--) {
        field[at - 1] = digit_zero + convert(u8, value % radix);
        value /= radix;
    }
    return value == 0;
}

fn tar_name_split(entry: TarEntry*): usize {
    if entry.name_length <= TarNameBytes { return 0; }
    var slash: u8 = 47;
    for (var at = entry.name_length; at != 0; at--) {
        var prefix = at - 1;
        if entry.name[prefix] == slash && prefix <= TarPrefixBytes && entry.name_length - at <= TarNameBytes { return at; }
    }
    return entry.name_length;
}

fn tar_name_conflict(left: TarEntry*, right: TarEntry*): bool {
    var count = left.name_length < right.name_length ? left.name_length : right.name_length;
    for (var at: usize = 0; at < count; at++) {
        if left.name[at] != right.name[at] { return false; }
    }
    var slash: u8 = 47;
    return left.name_length == right.name_length
        || left.name_length < right.name_length && right.name[count] == slash
        || right.name_length < left.name_length && left.name[count] == slash;
}

// Failure leaves out unchanged; input may borrow its original storage.
fn tar_write(entries: TarEntry*, count: usize, limit: usize, out: ByteBuffer*): TarResult {
    var total = convert(u64, TarBlockBytes * TarEndBlocks);
    for (var at: usize = 0; at < count; at++) {
        var entry = &entries[at];
        // Share ZIP's portable relative-member policy.
        if !zip_name_valid(entry.name, entry.name_length) { return TarResult.InvalidName; }
        if tar_name_split(entry) == entry.name_length { return TarResult.Unsupported; }
        if entry.mode > TarModeLimit || convert(u64, entry.length) > TarSizeLimit { return TarResult.Limit; }
        if entry.length != 0 && entry.data == null { return TarResult.Unsupported; }
        for (var previous: usize = 0; previous < at; previous++) {
            if tar_name_conflict(entry, &entries[previous]) { return TarResult.DuplicateName; }
        }
        var blocks = convert(u64, entry.length) / convert(u64, TarBlockBytes);
        if entry.length % TarBlockBytes != 0 { blocks++; }
        var amount = (blocks + 1) * convert(u64, TarBlockBytes);
        if amount > convert(u64, limit) || total > convert(u64, limit) - amount { return TarResult.Limit; }
        total += amount;
    }
    var padding = (convert(u64, TarRecordBytes) - total % convert(u64, TarRecordBytes)) % convert(u64, TarRecordBytes);
    if padding > convert(u64, limit) || total > convert(u64, limit) - padding { return TarResult.Limit; }
    total += padding;
    var archive: ByteBuffer = default;
    defer bytes_dispose(&archive);
    if !bytes_reserve(&archive, convert(usize, total)) { return TarResult.AllocationFailure; }
    fill(archive.data, 0, convert(usize, total));
    var position: usize = 0;
    for (var at: usize = 0; at < count; at++) {
        var entry = &entries[at];
        var header = archive.data + position;
        var split = tar_name_split(entry);
        copy(header + convert(usize, TarField.Name), entry.name + split, entry.name_length - split);
        if split != 0 { copy(header + convert(usize, TarField.Prefix), entry.name, split - 1); }
        tar_octal(header + convert(usize, TarField.Mode), TarShortFieldBytes, convert(u64, entry.mode));
        tar_octal(header + convert(usize, TarField.Uid), TarShortFieldBytes, 0);
        tar_octal(header + convert(usize, TarField.Gid), TarShortFieldBytes, 0);
        tar_octal(header + convert(usize, TarField.Size), TarLongFieldBytes, convert(u64, entry.length));
        tar_octal(header + convert(usize, TarField.Mtime), TarLongFieldBytes, 0);
        // Device fields stay empty for regular files.
        var regular_file: u8 = 48; var space: u8 = 32;
        var magic_bytes: usize = 6; var version_bytes: usize = 2;
        header[convert(usize, TarField.Type)] = regular_file;
        copy(header + convert(usize, TarField.Magic), "ustar", magic_bytes);
        copy(header + convert(usize, TarField.Version), "00", version_bytes);
        var checksum_field = header + convert(usize, TarField.Checksum);
        fill(checksum_field, space, TarShortFieldBytes);
        var checksum: u64 = 0;
        for (var byte: usize = 0; byte < TarBlockBytes; byte++) { checksum += convert(u64, header[byte]); }
        tar_octal(checksum_field, TarShortFieldBytes - 1, checksum);
        checksum_field[TarShortFieldBytes - 1] = space;
        position += TarBlockBytes;
        copy(archive.data + position, entry.data, entry.length);
        position += entry.length;
        position += (TarBlockBytes - entry.length % TarBlockBytes) % TarBlockBytes;
    }
    archive.length = convert(usize, total);
    bytes_dispose(out);
    *out = archive;
    archive = default;
    return TarResult.Ok;
}
