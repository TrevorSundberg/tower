import tower;
export fn work_thread_retention(): bool { return true; }

// Explicit Linux glibc x86_64/AArch64 ABI: pthread_t is one native word;
// sem_t is 32 bytes, aligned to eight. No host layout enters Tower constants.
extern fn pthread_create(thread: usize*, attributes: void*, entry: void*, argument: void*): i32;
extern fn pthread_join(thread: usize, result: void**): i32;
extern fn dlsym(handle: void*, name: u8*): void*;
extern fn sem_init(signal: void*, shared: i32, value: u32): i32;
extern fn sem_destroy(signal: void*): i32;
extern fn sem_post(signal: void*): i32;
extern fn sem_wait(signal: void*): i32;
extern fn sem_trywait(signal: void*): i32;
extern fn __errno_location(): i32*;

export fn work_thread_available(): bool { return true; }
extern fn get_nprocs(): i32;
export fn work_thread_capacity(): usize {
    var count = get_nprocs();
    if count < 1 { return 1; }
    return convert(usize, count > 256 ? 256 : count);
}

export fn work_thread_open(argument: void*): void* {
    var entry = dlsym(null, "work_thread_entry");
    if entry == null { return null; }
    var thread = alloc(usize, 1);
    if thread == null { return null; }
    if pthread_create(thread, null, entry, argument) != 0 {
        free(thread);
        return null;
    }
    return bits(void*, thread);
}

export fn work_thread_close(thread: void*): void {
    if thread == null { return; }
    if pthread_join(*bits(usize*, thread), null) != 0 {
        trap("Cannot join compiler worker", 0);
    }
    free(thread);
}

export fn work_signal_open(): void* {
    var signal = bits(void*, alloc(u64, 4));
    if signal == null { return null; }
    if sem_init(signal, 0, 0) != 0 {
        free(signal);
        return null;
    }
    return signal;
}

export fn work_signal_close(signal: void*): void {
    if signal == null { return; }
    if sem_destroy(signal) != 0 { trap("Cannot release compiler semaphore", 0); }
    free(signal);
}

export fn work_signal_post(signal: void*): void {
    if sem_post(signal) != 0 { trap("Cannot publish compiler work", 0); }
}

export fn work_signal_wait(signal: void*): void {
    while sem_wait(signal) != 0 {
        if *__errno_location() != 4 { trap("Cannot wait for compiler work", 0); }
    }
}

export fn work_signal_try(signal: void*): bool {
    loop {
        if sem_trywait(signal) == 0 { return true; }
        var error = *__errno_location();
        if error == 11 { return false; }
        if error != 4 { trap("Cannot inspect compiler work", 0); }
    }
}
