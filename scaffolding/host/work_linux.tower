import tower;
import .library.work_pool;
export fn work_thread_retention(): bool { return true; }

// Explicit Linux glibc x86_64/AArch64 ABI: pthread_t is one native word;
// sem_t is 32 bytes, aligned to eight. No host layout enters Tower constants.
extern fn pthread_create(thread: usize*, attributes: void*, entry: void*, argument: void*): i32;
extern fn pthread_join(thread: usize, result: void**): i32;
extern fn dlsym(handle: void*, name: u8*): void*;
extern fn sem_init(signal: void*, shared: i32, value: u32): i32;
extern fn sem_destroy(signal: void*): i32;
extern fn sem_post(signal: void*): i32;
extern fn sem_wait(signal: void*): i32;
extern fn sem_trywait(signal: void*): i32;
extern fn __errno_location(): i32*;

// glibc bits/pthreadtypes{,-arch}.h: LP64 pthread_mutex_t is 40 bytes on
// x86_64 and 48 on AArch64, aligned as long. Reserve the larger supported ABI;
// libc alone initializes/accesses the opaque storage. Its adaptive mutex uses
// bounded contention handling before the ordinary blocking wait; Tower never
// spins on opaque payloads. The gate stays process-private and nonrecursive.
var LinuxMutexStorageBytes: usize = 48;
var LinuxAdaptiveMutex: i32 = 3; // glibc PTHREAD_MUTEX_ADAPTIVE_NP.
// glibc pthread_mutexattr_t is one int on both supported LP64 targets.
extern fn pthread_mutexattr_init(attributes: i32*): i32;
extern fn pthread_mutexattr_settype(attributes: i32*, kind: i32): i32;
extern fn pthread_mutexattr_destroy(attributes: i32*): i32;
extern fn pthread_mutex_init(mutex: void*, attributes: void*): i32;
extern fn pthread_mutex_destroy(mutex: void*): i32;
extern fn pthread_mutex_lock(mutex: void*): i32;
extern fn pthread_mutex_unlock(mutex: void*): i32;

export fn work_gate_open(): void* {
    var gate = bits(void*, alloc(u64, LinuxMutexStorageBytes / sizeof(u64)));
    if gate == null { return null; }
    var attributes: i32 = 0;
    if pthread_mutexattr_init(&attributes) != 0 { free(gate); return null; }
    var initialized = pthread_mutexattr_settype(&attributes, LinuxAdaptiveMutex) == 0
        && pthread_mutex_init(gate, bits(void*, &attributes)) == 0;
    if pthread_mutexattr_destroy(&attributes) != 0 { trap("Cannot release compiler gate attributes", 0); }
    if !initialized { free(gate); return null; }
    return gate;
}
export fn work_gate_close(gate: void*): void {
    if gate == null { return; }
    if pthread_mutex_destroy(gate) != 0 { trap("Cannot release compiler exclusive gate", 0); }
    free(gate);
}
export fn work_gate_enter(gate: void*): void {
    if pthread_mutex_lock(gate) != 0 { trap("Cannot enter compiler exclusive gate", 0); }
}
export fn work_gate_leave(gate: void*): void {
    if pthread_mutex_unlock(gate) != 0 { trap("Cannot leave compiler exclusive gate", 0); }
}

export fn work_thread_available(): bool { return true; }
extern fn sched_getaffinity(pid: i32, bytes: usize, mask: usize*): i32;
extern fn compiler_buffer_allocate(bytes: usize): void*;
extern fn compiler_buffer_free(pointer: void*): void;
var LinuxAffinitySizeError: i32 = 22;

export fn work_thread_capacity(): usize {
    // glibc/Linux masks are arrays of unsigned long on both supported ABIs.
    // Query this thread each time: workers inherit affinity, but may change it.
    // One word is only the allocation-free first probe, never a CPU-ID limit.
    var local: usize = 0;
    var mask = &local;
    var bytes = sizeof(decltype(local));
    defer { if mask != &local { compiler_buffer_free(bits(void*, mask)); } }
    loop {
        fill(mask, 0, bytes);
        if sched_getaffinity(0, bytes, mask) == 0 {
            var count: usize = 0;
            for (var i: usize = 0; i < bytes / sizeof(usize); i++) {
                var word = mask[i];
                while word != 0 {
                    count++;
                    if count == WorkPoolMaximumCapacity { return count; }
                    word &= word - 1;
                }
            }
            return count;
        }
        // Zero denies admission through the existing pool/world contracts.
        // Never substitute the number of online CPUs on an unavailable query.
        if *__errno_location() != LinuxAffinitySizeError || bytes > ~convert(usize, 0) / 2 { return 0; }
        if mask != &local { compiler_buffer_free(bits(void*, mask)); }
        bytes *= 2;
        mask = bits(usize*, compiler_buffer_allocate(bytes));
        if mask == null { return 0; }
    }
}

export fn work_thread_open(argument: void*): void* {
    return work_thread_open_named(argument, "work_thread_entry", null);
}

export fn work_thread_open_named(argument: void*, posix_entry: u8*, windows_entry: u8*): void* {
    if posix_entry == null { return null; }
    var entry = dlsym(null, posix_entry);
    if entry == null { return null; }
    var thread = alloc(usize, 1);
    if thread == null { return null; }
    if pthread_create(thread, null, entry, argument) != 0 {
        free(thread);
        return null;
    }
    return bits(void*, thread);
}

export fn work_thread_close(thread: void*): void {
    if thread == null { return; }
    if pthread_join(*bits(usize*, thread), null) != 0 {
        trap("Cannot join compiler worker", 0);
    }
    free(thread);
}

export fn work_signal_open(): void* {
    var signal = bits(void*, alloc(u64, 4));
    if signal == null { return null; }
    if sem_init(signal, 0, 0) != 0 {
        free(signal);
        return null;
    }
    return signal;
}

export fn work_signal_close(signal: void*): void {
    if signal == null { return; }
    if sem_destroy(signal) != 0 { trap("Cannot release compiler semaphore", 0); }
    free(signal);
}

export fn work_signal_post(signal: void*): void {
    if sem_post(signal) != 0 { trap("Cannot publish compiler work", 0); }
}

export fn work_signal_wait(signal: void*): void {
    while sem_wait(signal) != 0 {
        if *__errno_location() != 4 { trap("Cannot wait for compiler work", 0); }
    }
}

export fn work_signal_try(signal: void*): bool {
    loop {
        if sem_trywait(signal) == 0 { return true; }
        var error = *__errno_location();
        if error == 11 { return false; }
        if error != 4 { trap("Cannot inspect compiler work", 0); }
    }
}
