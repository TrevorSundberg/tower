import tower;

extern fn GetProcessHeap(): void*;
extern fn HeapAlloc(heap: void*, flags: u32, bytes: usize): void*;
extern fn HeapReAlloc(heap: void*, flags: u32, pointer: void*, bytes: usize): void*;
extern fn HeapFree(heap: void*, flags: u32, pointer: void*): i32;
extern fn GetStdHandle(stream: u32): void*;
extern fn WriteFile(file: void*, bytes: u8*, count: u32, written: u32*, overlapped: void*): i32;
extern fn ExitProcess(status: u32): void;

const GuestWindowsStdout: u32 = 4294967285;
const GuestWindowsStderr: u32 = 4294967284;
const GuestWindowsWriteLimit: usize = 4294967295;

export fn guest_host_allocate(bytes: usize): void* {
    var empty = bytes == 0;
    if empty { bytes = 1; }
    return HeapAlloc(GetProcessHeap(), 0, bytes);
}

export fn guest_host_free(pointer: void*): void {
    var present = pointer != null;
    if present { HeapFree(GetProcessHeap(), 0, pointer); }
}

export fn guest_host_reallocate(pointer: void*, bytes: usize): void* {
    var absent = pointer == null;
    if absent { return guest_host_allocate(bytes); }
    var empty = bytes == 0;
    if empty { guest_host_free(pointer); return null; }
    return HeapReAlloc(GetProcessHeap(), 0, pointer, bytes);
}

export fn platform_write(stream: u32, bytes: u8*, count: usize): i64 {
    var id = GuestWindowsStdout();
    var error = stream == 2;
    if error { id = GuestWindowsStderr(); }
    else { var valid = stream == 1; if !valid { return -1; } }
    var total: usize = 0;
    while total < count {
        var remaining = count - total;
        var large = remaining > GuestWindowsWriteLimit();
        if large { remaining = GuestWindowsWriteLimit(); }
        var written: u32 = 0;
        var ok = WriteFile(GetStdHandle(id), &bytes[total], convert(u32, remaining), &written, null);
        var failed = ok == 0;
        if failed {
            var progressed = total != 0;
            if progressed { return convert(i64, total); }
            return -1;
        }
        total = total + convert(usize, written);
        var stopped = written == 0;
        if stopped { break; }
    }
    return convert(i64, total);
}

export fn guest_exit(status: i32): void { ExitProcess(convert(u32, status)); }
