import tower;
import ide_api;
import ide_text;
import .library.bytes_types;

// Existing syntax API, lowered for wasm32 WASI SDK 34 / libc++ __2. Nontrivial
// returns use an explicit sret pointer. Foreign containers are temporary ABI
// views only and are disposed after copying into request-owned Tower buffers.
// Only the baseline-installation compatibility call still needs this ABI.
struct IdeForeignString {
    words: usize[3];
}

extern fn `cpp_name(std::string syntax_set_bootstrap(char const*))`(result: IdeForeignString*, source: u8*): void;

extern fn `cpp_name(void operator delete(void*))`(data: u8*): void;

extern fn tower_tests(): void;

extern fn parser_tests(): void;

extern fn syntax_tests(): void;

fn ide_foreign_long(value: IdeForeignString*): bool {
    var raw = bits(u8*, value);
    var flag = raw[11] &128;
    var yes = flag != 0;
    return yes;
}

fn ide_foreign_data(value: IdeForeignString*): u8* {
    if ide_foreign_long(value) {
        return bits(u8*, value.words[0]);
    }
    return bits(u8*, value);
}

fn ide_foreign_size(value: IdeForeignString*): usize {
    if ide_foreign_long(value) {
        return value.words[1];
    }
    var raw = bits(u8*, value);
    var length = convert(usize, raw[11]);
    return length;
}

fn ide_foreign_dispose(value: IdeForeignString*): void {
    if ide_foreign_long(value) {
        `cpp_name(void operator delete(void*))`(ide_foreign_data(value));
    }
}

export fn tw_self_test(): i32 {
    tower_tests();
    parser_tests();
    syntax_tests();
    return 0;
}
