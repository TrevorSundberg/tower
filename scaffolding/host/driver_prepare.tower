import tower;
import driver_types;
import .compiler.test_file_rule;
import driver_support;

extern fn driver_parse(options: DriverOptions*, argc: usize, argv: u8**, target: u8*): bool;

extern fn driver_help(): u8*;

extern fn driver_version(): u8*;

extern fn driver_output_valid(emit: u8*): bool;

// CLI-only composition of the existing parser. 0 continues, 1 is failure,
// 2 is an already-reported successful --help/--version early exit.
export fn driver_prepare(options: DriverOptions*, argc: usize, argv: u8**, target: u8*): i32 {
    if !driver_parse(options, argc, argv, target) {
        match convert(DriverOptionError, options.error) {
            DriverOptionError.MissingValue => {
                driver_error("Missing argument for ", options.argument);
            }
            DriverOptionError.Unexpected => {
                driver_error("Unexpected argument: ", options.argument);
            }
            DriverOptionError.Jobs => {
                driver_error("Invalid worker count: ", options.argument);
            }
            DriverOptionError.UnitRetainedBytes => {
                driver_error("Invalid finite --unit-retained-bytes value: ", options.argument);
            }
            _ => {
                driver_error("Unable to allocate command-line inputs", "");
            }
        }
        return 1;
    }
    if options.version {
        driver_message(1, driver_version(), "", false);
        return 2;
    }
    if options.help {
        driver_message(1, driver_help(), "", false);
        return 2;
    }
    if options.unit_retained_policy && options.unit_count == 0 {
        driver_error("--unit-retained-bytes requires additional --unit sources", "");
        return 1;
    }
    if !test_file_rule_valid(&options.test_rule) {
        driver_error("Invalid companion suffix: ", options.test_rule.companion_suffix); return 1;
    }
    if (options.test_state[0] != 0 && options.test_mode != DriverTestMode.Run)
        || (options.test_oracle[0] != 0 && options.test_state[0] == 0) {
        driver_error("Use --test-affected directory with --test and optional --test-oracle file", ""); return 1;
    }
    if options.test_details && options.test_mode != DriverTestMode.Run {
        driver_error("--test-details requires --test", ""); return 1;
    }
    if options.test_mode != DriverTestMode.None {
        if options.source[0] == 0 || options.interpret || options.link_executable || options.library
            || options.unit_count != 0 || options.link_count != 0 || !driver_same(options.emit, "exe")
            || options.check_format || options.raw[0] != 0 || options.optimized[0] != 0
            || !driver_same(options.target, target) || !options.comments || !options.optimize
            || options.sysroot[0] != 0 || options.linker[0] != 0 || !driver_same(options.cc, "clang") {
            driver_error("Test discovery requires one native Tower source without compile or link options", ""); return 1;
        }
        if (options.test_mode == DriverTestMode.Run && options.output[0] != 0)
            || (options.depfile[0] != 0 && options.output[0] == 0) {
            driver_error("Use --list-test-files -o inventory for a dependency-tracked file list", ""); return 1;
        }
        return 0;
    }
    if options.link_executable {
        if options.output[0] == 0 || (options.source[0] == 0 && options.link_count == 0)
            || options.interpret || options.library || options.unit_count != 0 || options.check_format
            || !driver_same(options.emit, "exe") || options.linker[0] != 0 || options.raw[0] != 0
            || options.optimized[0] != 0 || options.depfile[0] != 0 || !options.comments
            || (options.source[0] != 0 && driver_same(options.source, options.output)) {
            driver_error("--link-executable requires object inputs and -o, without compilation or external-linker options", ""); return 1;
        }
        return 0;
    }
    if !driver_output_valid(options.emit) {
        driver_error("Unknown output kind: ", options.emit);
        return 1;
    }
    var formatting = driver_same(options.emit, "source");
    if options.check_format && (!formatting || options.output[0] != 0) {
        driver_error("--check-format requires source output without -o", "");
        return 1;
    }
    if formatting {
        if options.interpret || options.library || options.link_count != 0 || options.unit_count != 0
            || options.raw[0] != 0 || options.optimized[0] != 0 || options.depfile[0] != 0 || !options.comments {
            driver_error("Source formatting accepts one source and preserves comments; compilation/link options are not supported", "");
            return 1;
        }
        return 0;
    }
    if driver_same(options.target, "roku") {
        var valid = driver_same(options.emit, "exe");
        valid ||= driver_same(options.emit, "brightscript");
        if !valid {
            driver_error("Roku target emits BrightScript source; use --emit brightscript", "");
            return 1;
        }
        options.emit = "brightscript";
    }
    if driver_same(options.emit, "brightscript") {
        var invalid = options.library;
        if options.interpret {
            invalid = true;
        }
        if options.link_count != 0 {
            invalid = true;
        }
        if invalid {
            driver_error("Roku source requires a complete program without native link inputs or interpreter flags", "");
            return 1;
        }
        options.target = "wasm32-unknown-unknown";
    }
    if options.unit_count != 0 && (!driver_same(options.emit, "exe") || options.interpret || options.library
        || options.raw[0] != 0 || options.optimized[0] != 0) {
        driver_error("Additional --unit inputs require executable output without interpreter, library or single-unit IR options", "");
        return 1;
    }
    return 0;
}
