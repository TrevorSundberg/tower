import tower;
import 'platform-output';

extern fn abort(): void;
extern fn strlen(text: u8*): usize;
extern fn compiler_runtime_write(data: u8*, length: usize): void;

export fn compiler_runtime_trap(message: u8*, offset: usize): void {
    compiler_runtime_write("Tower compiler internal trap at ", 32);
    var digits: u8[80];
    var length = runtime_format_value(&digits[0], 80, 1, convert(u64, offset), convert(u32, sizeof(usize)));
    var present = length != 0;
    if present {
        // The shared integer formatter appends a newline; the trap has a suffix.
        length = length - 1;
        compiler_runtime_write(&digits[0], length);
    }
    compiler_runtime_write(": ", 2);
    compiler_runtime_write(message, strlen(message));
    compiler_runtime_write("\n", 1);
    abort();
}
