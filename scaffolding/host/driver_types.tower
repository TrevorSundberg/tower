import tower;

enum DriverOptionError: u32 { None = 0, MissingValue = 1, Unexpected = 2, Allocation = 3, Jobs = 4, UnitRetainedBytes = 5 }

// Declared multi-unit snapshots and exposed retained object bytes only. Parser,
// semantic component and foreign LLVM heap limits remain separate policies.
var DriverUnitRetainedByteLimit: usize = 268435456;

enum DriverTestMode: u8 { None, Run, ListFiles }
enum DriverFileKind: u8 { Missing, Regular, Unavailable }

struct DriverOptions {
    source: u8*;
    output: u8*;
    target: u8*;
    emit: u8*;
    cc: u8*;
    linker: u8*;
    sysroot: u8*;
    raw: u8*;
    optimized: u8*;
    bedrock: u8*;
    foundation: u8*;
    depfile: u8*;
    links: u8**;
    link_count: usize;
    units: u8**;
    unit_count: usize;
    jobs: usize;
    unit_retained_bytes: usize;
    unit_retained_policy: bool;
    optimize: bool;
    interpret: bool;
    library: bool;
    timings: bool;
    help: bool;
    version: bool;
    fast: bool;
    error: u32;
    argument: u8*;
    comments: bool;
    check_format: bool;
    link_executable: bool;
    test_mode: DriverTestMode;
}
