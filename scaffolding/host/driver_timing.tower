import tower;
import .library.bytes_types;
import .library.bytes_interface;
import driver_support;
import driver_platform;

struct DriverTiming {
    start: u64;
    previous: u64;
    values: u64[11];
    present: bool[11];
}

fn driver_timing_name(index: usize): u8* {
    match index {
        0 => {
            return "after";
        }
        1 => {
            return "before";
        }
        2 => {
            return "bootstrap";
        }
        3 => {
            return "compile";
        }
        4 => {
            return "emit";
        }
        5 => {
            return "execute";
        }
        6 => {
            return "link";
        }
        7 => {
            return "parse";
        }
        8 => {
            return "prepare";
        }
        9 => {
            return "runtimeCompile";
        }
        _ => {
            return "total";
        }
    }
}

export fn driver_timing_open(): DriverTiming* {
    var timing = alloc(DriverTiming, 1);
    var valid = timing != null;
    if valid {
        fill(timing, 0, sizeof(DriverTiming));
        timing.start = driver_clock();
        timing.previous = timing.start;
    }
    return timing;
}

export fn driver_timing_value(timing: DriverTiming*, name: u8*, nanoseconds: u64): void {
    var missing = timing == null;
    if missing {
        return;
    }
    for(var i: usize = 0; i < 11; i++) {
        if driver_same(name, driver_timing_name(i)) {
            timing.values[i] = nanoseconds;
            timing.present[i] = true;
            return;
        }
    }
}

export fn driver_timing_mark(timing: DriverTiming*, enabled: bool, name: u8*): void {
    if !enabled {
        return;
    }
    var missing = timing == null;
    if missing {
        return;
    }
    var now = driver_clock();
    var elapsed: u64 = 0;
    var ordered = now >= timing.previous;
    if ordered {
        elapsed = now - timing.previous;
    }
    driver_timing_value(timing, name, elapsed);
    timing.previous = now;
}

// Locale-independent JSON numbers, milliseconds with six fractional digits.
// Measurements are host effects only and never enter compiler/cache identity.
fn driver_timing_render(out: ByteBuffer*, timing: DriverTiming*): bool {
    var ok = driver_text(out, "Tower timings (ms): {");
    var first = true;
    for(var i: usize = 0; i < 11; i++) {
        if timing.present[i] {
            if !first {
                ok &&= driver_text(out, ",");
            }
            first = false;
            ok &&= driver_text(out, "\"");
            ok &&= driver_text(out, driver_timing_name(i));
            ok &&= driver_text(out, "\":");
            var whole = timing.values[i] / 1000000;
            var fraction = timing.values[i] % 1000000;
            ok &&= host_json_unsigned(out, whole);
            ok &&= driver_text(out, ".");
            var divisor: u64 = 100000;
            while divisor != 0 {
                var digit = fraction / divisor;
                digit = digit + 48;
                ok &&= bytes_push(out, convert(u8, digit));
                fraction = fraction % divisor;
                divisor = divisor / 10;
            }
        }
    }
    if ok {
        ok = driver_text(out, "}\n");
    }
    return ok;
}

export fn driver_timing_close(timing: DriverTiming*, enabled: bool): void {
    var missing = timing == null;
    if missing {
        return;
    }
    if enabled {
        var now = driver_clock();
        var elapsed: u64 = 0;
        var ordered = now >= timing.start;
        if ordered {
            elapsed = now - timing.start;
        }
        driver_timing_value(timing, "total", elapsed);
        var out: ByteBuffer;
        fill(&out, 0, sizeof(ByteBuffer));
        if driver_timing_render(&out, timing) {
            driver_platform_write(2, out.data, out.length);
        }
        bytes_dispose(&out);
    }
    free(timing);
}
