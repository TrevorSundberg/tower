import tower;
import driver_api;
import .compiler.execution_session;
import driver_support;
import driver_platform;
import .library.bytes_interface;
import .library.bytes_types;
import .compiler.interpreter_types;
import .compiler.semantic_program_types;
import .compiler.foundation_types;

// Shared request ownership; only platform transport remains in this host.
fn driver_execution_close(execution: ExecutionSession*): void { execution_session_close(execution); }
fn driver_execution_compile(execution: ExecutionSession*, text: u8*, length: usize, width: u32, modules: void*): bool {
    return execution_session_compile(execution, text, length, width, modules);
}
fn driver_execution_start(execution: ExecutionSession*): bool { return execution_session_start(execution); }
fn driver_execution_fast(execution: ExecutionSession*): bool { return execution_session_fast(execution); }
fn driver_execution_flush(execution: ExecutionSession*): void {
    driver_platform_write(1, execution.output.data, execution.output.length);
    execution.output.length = 0;
}

export fn im_pointer_bytes(machine: IMState*): usize {
    return convert(usize, bits(ExecutionSession*, machine).program.pointer_bytes);
}
export fn im_root(machine: IMState*): void* { return bits(ExecutionSession*, machine).program.root; }
export fn im_has_foreign(machine: IMState*): bool { return true; }
export fn im_fail(machine: IMState*, text: u8*, offset: usize): void {
    execution_session_fail(bits(ExecutionSession*, machine), text, offset);
}

extern fn abort(): void;

export fn im_missing_foreign(machine: IMState*, node: void*, offset: usize): void {
    var text: ByteBuffer;
    fill(&text, 0, sizeof(ByteBuffer));
    var function = sem_get(node);
    var ok = driver_text(&text, "No interpreter implementation registered for external function '");
    ok &&= bytes_append(&text, function.name.data, function.name.length);
    ok &&= driver_text(&text, "'");
    ok &&= host_text_terminate(&text);
    im_fail(machine, ok ? text.data: "Unable to allocate interpreter diagnostic", offset);
    bytes_dispose(&text);
}

export fn im_append(machine: IMState*, text: u8*, count: usize): void {
    execution_session_append(bits(ExecutionSession*, machine), text, count);
}

extern fn memcmp(left: u8*, right: u8*, count: usize): i32;

extern fn driver_platform_write_result(fd: i32, data: u8*, length: usize): bool;

export fn im_foreign(machine: IMState*, node: void*, args: u64*, count: usize): u64 {
    var function = sem_get(node);
    if function.name.length != 14 || memcmp(function.name.data, "platform_write", 14) != 0 || count != 3 {
        var text: ByteBuffer;
        fill(&text, 0, sizeof(ByteBuffer));
        var ok = driver_text(&text, "No native interpreter binding for '");
        ok &&= bytes_append(&text, function.name.data, function.name.length);
        ok &&= driver_text(&text, "'");
        ok &&= host_text_terminate(&text);
        im_fail(machine, ok ? text.data: "Unable to allocate interpreter diagnostic", 0);
        bytes_dispose(&text);
        return 0;
    }
    if args[0] != 1 && args[0] != 2 {
        return ~convert(u64, 0);
    }
    var data = interpreter_bytes(machine, args[1], convert(usize, args[2]), 0);
    if data == null { return ~convert(u64, 0); }
    driver_execution_flush(bits(ExecutionSession*, machine));
    if driver_platform_write_result(convert(i32, args[0]), data, convert(usize, args[2])) { return args[2]; }
    return ~convert(u64, 0);
}
