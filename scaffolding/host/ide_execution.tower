extern fn compiler_node_world(node: void*): void*;
extern fn compiler_world_work_budget(world: void*): WorkBudget*;

extern fn sem_resource_message(error: WorkBudgetError): u8*;

// Each execution owns its root, typed program indexes, cache and guest storage.
// Destruction takes the handle first; a stale handle cannot reach freed state.
fn ide_execution_close(session: ExecutionSession*): void {
    execution_session_close(session);
    free(session);
}

fn ide_execution_compile(sources: FrontendSource*, count: usize, width: u32, foundation: bool): ExecutionSession* {
    var owner = alloc(IdeExecution, 1);
    ide_require(owner != null);
    *owner = default;
    var session = &owner.execution;
    semantic_initialize(&session.program, tower_node_create(), width);
    session.machine.budget = compiler_world_work_budget(compiler_node_world(session.program.root));
    var state = ide_state();
    var rejected = false;
    if foundation {
        rejected = state.foundation_error.length != 0;
    }
    if rejected {
        ide_require(bytes_assign_text(bits(ByteBuffer*, &session.program.error), state.foundation_error.data, state.foundation_error.length));
    }
    else {
        // Retain a normal frontend session lease while borrowing its environment.
        // This is the existing module loader, including caller-supplied inputs.
        var lease = syntax_completion_create("", 0);
        var environment = frontend_module_environment(syntax_completion_module(lease));
        frontend_compile_sources(&session.program, sources, count, environment);
        syntax_destroy(lease);
    }
    if session.program.resource.error != WorkBudgetError.None {
        session.machine.storage_error = session.program.resource.error;
        session.machine.error_offset = session.program.resource.offset;
        session.machine.failed = true;
        session.machine.done = true;
        return session;
    }
    if session.program.error.length != 0 {
        im_text_fail(&session.machine, &session.error, session.program.error.data, session.program.error.length, session.program.error_offset);
    }
    session.machine.stack = 16;
    session.machine.heap = 4194304;
    interpreter_init(&session.machine);
    return session;
}

fn ide_execution_text(source: u8*, length: usize, width: u32, foundation: bool): ExecutionSession* {
    var text = ide_copy(source, length);
    var input: FrontendSource;
    input.data = text;
    input.length = length;
    var session = ide_execution_compile(&input, 1, width, foundation);
    free(text);
    return session;
}

fn ide_execution_publish(session: ExecutionSession*): u32 {
    if session.program.resource.error != WorkBudgetError.None {
        ide_static_error(sem_resource_message(session.program.resource.error));
        ide_execution_close(session);
        return 0;
    }
    var state = ide_state();
    var handle = host_handles_insert(&state.handles, 1, bits(void*, session));
    if handle == 0 {
        ide_execution_close(session);
        ide_error("Cannot allocate execution handle");
    } else {
        bits(IdeExecution*, session).handle = handle;
    }
    return handle;
}

fn ide_execution_capacity(): bool {
    var state = ide_state();
    if host_handles_count(&state.handles, 1) >= 8 {
        ide_error("Too many execution sessions");
        return false;
    }
    return true;
}

fn ide_execution_fast(session: ExecutionSession*): bool {
    if session.machine.failed || session.program.resource.error != WorkBudgetError.None { return false; }
    if session.machine.steps != 0 {
        return false;
    }
    if session.fast == null {
        session.fast = fast_interpreter_create(&session.machine);
    }
    var ready = session.fast != null;
    return ready;
}

extern fn frontend_test_selection_open(selection: TestFileSelection*, rule: TestFileRule*, entry: u8*): bool;
extern fn frontend_modules_enter_test_root(modules: void*, selection: TestFileSelection*, saved: vector(u8)*, length: usize*): u8*;
extern fn frontend_modules_leave_test_root(modules: void*, saved: vector(u8)*): void;
extern fn frontend_modules_swap_test_discovery(modules: void*, current: TestFileDiscovery*): TestFileDiscovery*;

export fn tw_exec_create_tests(modules: void*, entry: u8*, suffix: u8*, width: u32): u32 {
    if modules == null || entry == null || (width != 4 && width != 8) {
        ide_error("Invalid test compilation request"); return 0;
    }
    if !ide_execution_capacity() { return 0; }
    var rule = test_file_default_rule();
    if suffix != null { rule.companion_suffix = suffix; }
    var selection: TestFileSelection = default;
    defer test_file_selection_dispose(&selection);
    if !frontend_test_selection_open(&selection, &rule, entry) {
        ide_error("Invalid test file selection"); return 0;
    }
    var saved: vector(u8) = default;
    var length: usize = 0;
    var source = frontend_modules_enter_test_root(modules, &selection, &saved, &length);
    if source == null { ide_error("Cannot open registered test owner"); return 0; }
    defer frontend_modules_leave_test_root(modules, &saved);
    var owner = alloc(IdeExecution, 1);
    if owner == null { ide_error("Cannot allocate test execution"); return 0; }
    *owner = default;
    var session = &owner.execution;
    var discovery: TestFileDiscovery = { selection: &selection, ..default };
    {
        var previous = frontend_modules_swap_test_discovery(modules, &discovery);
        defer frontend_modules_swap_test_discovery(modules, previous);
        if execution_session_compile_tests(session, source, length, width, modules) {
            if session.program.test_count != 0 { execution_session_start(session); }
            else { session.machine.done = true; }
        }
    }
    return ide_execution_publish(session);
}

export fn tw_exec_test_count(handle: u32): usize {
    var session = ide_execution(handle);
    return session == null ? 0 : session.program.test_count;
}

export fn tw_exec_create_target(source: u8*, bytes: usize, width: u32): u32 {
    if !ide_valid(source, bytes) {
        return 0;
    }
    var valid = width == 4;
    if width == 8 {
        valid = true;
    }
    if !valid {
        ide_error("Unsupported target pointer width");
        return 0;
    }
    if !ide_execution_capacity() {
        return 0;
    }
    return ide_execution_publish(ide_execution_text(source, bytes, width, false));
}

export fn tw_exec_create(source: u8*, bytes: usize): u32 {
    return tw_exec_create_target(source, bytes, 4);
}

export fn tw_exec_create_foundation(source: u8*, bytes: usize): u32 {
    if !ide_valid(source, bytes) {
        return 0;
    }
    if !ide_execution_capacity() {
        return 0;
    }
    return ide_execution_publish(ide_execution_text(source, bytes, 4, true));
}

export fn tw_exec_create_files(sources: u8**, lengths: u32*, count: u32, width: u32): u32 {
    var valid = sources != null;
    var bad = lengths == null;
    if bad {
        valid = false;
    }
    bad = count == 0;
    if bad {
        valid = false;
    }
    bad = count > 1024;
    if bad {
        valid = false;
    }
    var allowed = width == 4;
    if width == 8 {
        allowed = true;
    }
    if !allowed {
        valid = false;
    }
    var state = ide_state();
    bad = host_handles_count(&state.handles, 1) >= 8;
    if bad {
        valid = false;
    }
    if !valid {
        ide_error("Invalid project compilation request");
        return 0;
    }
    var total: usize = 0;
    var i: usize = 0;
    for(; i < convert(usize, count); i++) {
        if !ide_valid(sources[i], convert(usize, lengths[i])) {
            return 0;
        }
        total = total + convert(usize, lengths[i]);
        bad = total > 8388608;
        if bad {
            ide_error("Project compilation limit is 8 MiB");
            return 0;
        }
    }
    var inputs = alloc(FrontendSource, convert(usize, count));
    var ok = inputs != null;
    ide_require(ok);
    i = 0;
    for(; i < convert(usize, count); i++) {
        inputs[i].data = ide_copy(sources[i], convert(usize, lengths[i]));
        inputs[i].length = convert(usize, lengths[i]);
    }
    var session = ide_execution_compile(inputs, convert(usize, count), width, false);
    i = 0;
    for(; i < convert(usize, count); i++) {
        free(inputs[i].data);
    }
    free(inputs);
    return ide_execution_publish(session);
}

export fn tw_exec_destroy(handle: u32): void {
    var state = ide_state();
    var session = bits(ExecutionSession*, host_handles_take(&state.handles, 1, handle));
    if session != null {
        ide_execution_close(session);
    }
}

export fn tw_exec_fast(handle: u32): i32 {
    var session = ide_execution(handle);
    if session == null {
        return 0;
    }
    if ide_execution_fast(session) {
        return 1;
    }
    return 0;
}

export fn tw_exec_memory(handle: u32): u8* {
    var session = ide_execution(handle);
    if session == null {
        return null;
    }
    return session.machine.memory.data;
}

export fn tw_exec_memory_size(handle: u32): usize {
    var session = ide_execution(handle);
    if session == null {
        return 0;
    }
    return session.machine.memory.length;
}

export fn tw_exec_allocate(handle: u32, size: u32): u32 {
    var session = ide_execution(handle);
    if session == null {
        return 0;
    }
    return convert(u32, interpreter_allocate(&session.machine, convert(usize, size)));
}

export fn tw_exec_deallocate(handle: u32, address: u32): void {
    var session = ide_execution(handle);
    if session != null {
        interpreter_deallocate(&session.machine, convert(u64, address));
    }
}

export fn tw_exec_fail(handle: u32, error: u8*, length: usize): void {
    var session = ide_execution(handle);
    if session == null {
        return;
    }
    im_text_fail(&session.machine, &session.error, error, length, 0);
}

export fn tw_exec_output(handle: u32, data: u8*, length: usize): void {
    var session = ide_execution(handle);
    if session == null {
        return;
    }
    var left = 65536 -session.machine.output_bytes;
    if length > left {
        session.machine.output_truncated = true;
        return;
    }
    im_text_append(&session.machine, &session.output, &session.error, data, length);
}

var IdeExecutionStepLimit: u32 = 100000;

fn ide_execution_step(session: ExecutionSession*, budget: u32): void {
    if budget > IdeExecutionStepLimit { budget = IdeExecutionStepLimit; }
    session.machine.failed ||= session.error.length != 0 || session.program.resource.error != WorkBudgetError.None;
    if session.program.resource.error != WorkBudgetError.None {
        session.machine.done = true;
        return;
    }
    var fast = session.fast != null;
    if fast {
        fast_interpreter_step(&session.machine, session.fast, convert(usize, budget));
    }
    else {
        interpreter_step(&session.machine, convert(usize, budget));
    }
}

export fn tw_exec_step(handle: u32, budget: u32): u8* {
    var session = ide_execution(handle);
    if session == null {
        return "{\"status\":\"error\",\"error\":\"Invalid execution handle\"}";
    }
    if session.program.resource.error != WorkBudgetError.None {
        session.machine.failed = true;
        session.machine.done = true;
        return "{\"status\":\"error\",\"error\":\"Compiler resource request failed\"}";
    }
    ide_execution_step(session, budget);

    var state = ide_state();
    var out = &state.execution;
    var message = session.error.data;
    var length = session.error.length;
    if session.machine.failed && length == 0 {
        message = session.machine.storage_error == WorkBudgetError.None ? "Execution failed without a diagnostic" : sem_resource_message(session.machine.storage_error);
        length = ide_length(message);
    }
    ide_require(host_execution_json(out, message, length, session.machine.error_offset, session.machine.done, session.output.data, session.output.length, session.machine.steps, session.machine.output_truncated));
    session.output.length = 0;
    return ide_result(out);
}

export fn tw_exec_fast_stats(handle: u32): u8* {
    var session = ide_execution(handle);
    var missing = session == null;
    if missing {
        return "{}";
    }
    missing = session.fast == null;
    if missing {
        return "{}";
    }
    var state = ide_state();
    var out = &state.execution;
    ide_assign(out, "{");
    var names: u8*[5];
    names[0] = "codeBytes";
    names[1] = "instructions";
    names[2] = "wideInstructions";
    names[3] = "registerCapacityBytes";
    names[4] = "cacheCapacityBytes";
    for(var i: usize = 0; i < 5; i++) {
        ide_comma(out, i);
        ide_quote(out, names[i]);
        ide_text(out, ":");
        ide_number(out, fast_interpreter_stat(session.fast, i));
    }
    ide_text(out, "}");
    return ide_result(out);
}

export fn tw_set_foundation(source: u8*, bytes: usize): i32 {
    var bad = source == null;
    if bad {
        return 0;
    }
    bad = bytes > 131072;
    if bad {
        return 0;
    }
    var text = ide_copy(source, bytes);
    var error: SyntaxVersionDiagnostic = default;
    defer syntax_version_diagnostic_dispose(&error);
    syntax_host_install(compiler_host_world(), text, true, &error);
    free(text);
    var state = ide_state();
    var diagnostic = syntax_version_diagnostic_text(&error);
    ide_assign(&state.foundation_error, diagnostic);
    return 1;
}

// Interpreter callbacks bind the existing portable engines to this request's
// owner. Host invocation is the only transport-dependent execution operation.
extern fn tw_foreign_call(handle: u32, request: u8*): u64;

export fn im_pointer_bytes(machine: IMState*): usize {
    var session = bits(ExecutionSession*, machine);
    return convert(usize, session.program.pointer_bytes);
}

export fn im_root(machine: IMState*): void* {
    var session = bits(ExecutionSession*, machine);
    return session.program.root;
}

export fn im_has_foreign(machine: IMState*): bool {
    return true;
}

export fn im_fail(machine: IMState*, text: u8*, offset: usize): void {
    var session = bits(ExecutionSession*, machine);
    im_text_fail(machine, &session.error, text, ide_length(text), offset);
}

export fn im_missing_foreign(machine: IMState*, node: void*, offset: usize): void {
    var text: ByteBuffer = default;
    ide_text(&text, "No interpreter implementation registered for external function '");
    var function = sem_get(node);
    ide_require(bytes_append(&text, function.name.data, function.name.length));
    ide_text(&text, "'");
    im_fail(machine, ide_result(&text), offset);
    bytes_dispose(&text);
}

export fn im_append(machine: IMState*, text: u8*, count: usize): void {
    var session = bits(ExecutionSession*, machine);
    im_text_append(machine, &session.output, &session.error, text, count);
}

export fn im_foreign(machine: IMState*, node: void*, args: u64*, count: usize): u64 {
    var session = bits(ExecutionSession*, machine);
    var function = sem_get(node);
    var request: ByteBuffer = default;
    ide_text(&request, "{\"name\":");
    ide_quote_bytes(&request, function.name.data, function.name.length);
    ide_field(&request, "pointerBytes", convert(usize, session.program.pointer_bytes));
    ide_text(&request, ",\"types\":[");
    var type: ByteBuffer = default;
    // Return bits cross the same transport as argument bits. Floating host
    // values require an explicit representation conversion at that boundary.
    var result_type: ByteBuffer = default;
    semantic_format_type(&function.type, bits(vector(u8)*, &result_type));
    var i: usize = 0;
    for(; i < function.parameters.length; i++) {
        var parameter = sem_get(function.parameters.data[i]);
        semantic_format_type(&parameter.type, bits(vector(u8)*, &type));
        ide_comma(&request, i);
        ide_quote_bytes(&request, type.data, type.length);
    }
    bytes_dispose(&type);
    ide_text(&request, "],\"args\":[");
    i = 0;
    for(; i < count; i++) {
        ide_comma(&request, i);
        ide_text(&request, "\"");
        ide_require(host_json_unsigned(&request, args[i]));
        ide_text(&request, "\"");
    }
    ide_text(&request, "],\"returnType\":");
    ide_quote_bytes(&request, result_type.data, result_type.length);
    bytes_dispose(&result_type);
    ide_text(&request, "}");
    var result = tw_foreign_call(bits(IdeExecution*, session).handle, ide_result(&request));
    bytes_dispose(&request);
    machine.failed ||= session.error.length != 0 || session.program.resource.error != WorkBudgetError.None;
    return result;
}
