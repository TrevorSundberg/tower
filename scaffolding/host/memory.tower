import tower;
import memory_libc;
import memory_types;

// Compiler allocation policy, separate from guest raw-address allocation.
// A null state selects production behavior; tests explicitly supply a state.
// The borrowed native allocator is the platform libc (wasi-libc in reactors).
extern fn abort(): void;

fn compiler_memory_guard(): usize {
    var guard: u64 = 16045690984833335023;
    if sizeof(usize) == 4 {
        guard = 3735928559;
    }
    return convert(usize, guard);
}

export fn compiler_node_allocate(state: CompilerNodeMemoryState*, size: usize, diagnostic: bool): void* {
    var bytes = size;
    var word = sizeof(usize);
    if diagnostic {
        var maximum: usize = 0;
        maximum--;
        var overhead = word *4;
        overhead--;
        var limit = maximum -overhead;
        if size > limit {
            return null;
        }
        var padding = word -1;
        bytes = size + padding;
        bytes = bytes / word;
        bytes = bytes * word;
        var guards = word *3;
        bytes = bytes + guards;
    }
    // A successful zero-size request still owns a releasable allocation.
    if bytes == 0 {
        bytes = 1;
    }
    var memory = compiler_host_reallocate(null, bytes);
    if memory == null {
        return null;
    }
    state.live_allocations++;
    if diagnostic {
        var header = bits(usize*, memory);
        var overhead = word *3;
        var payload = bytes -overhead;
        header[0] = payload;
        header[1] = compiler_memory_guard();
        var end = payload / word;
        end = end + 2;
        header[end] = compiler_memory_guard();
        var data = &header[2];
        fill(data, 219, payload);
        return bits(void*, data);
    }
    return memory;
}

export fn compiler_node_free(state: CompilerNodeMemoryState*, pointer: void*, diagnostic: bool): void {
    if pointer == null {
        return;
    }
    if state.live_allocations == 0 {
        abort();
        return;
    }
    var allocation = pointer;
    if diagnostic {
        var header = bits(usize*, pointer);
        header = header - 2;
        var guard = compiler_memory_guard();
        var corrupted = header[1] != guard;
        if corrupted {
            abort();
            return;
        }
        var bytes = header[0];
        var end = bytes / sizeof(usize);
        end = end + 2;
        corrupted = header[end] != guard;
        if corrupted {
            abort();
            return;
        }
        var overhead = sizeof(usize) *3;
        bytes = bytes + overhead;
        fill(header, 254, bytes);
        allocation = bits(void*, header);
    }
    state.live_allocations--;
    compiler_host_deallocate(allocation);
}

export fn compiler_host_reallocate(pointer: void*, bytes: usize): void* {
    return `c_name(void* realloc(void*, size_t))`(pointer, bytes);
}

export fn compiler_host_deallocate(pointer: void*): void {
    `c_name(void free(void*))`(pointer);
}

export fn compiler_memory_reallocate(state: CompilerMemoryState*, pointer: void*, count: usize, size: usize): void* {
    var maximum: usize = 0;
    maximum--;
    if size != 0 {
        var limit = maximum / size;
        if count > limit {
            return null;
        }
    }
    var instrumented = state != null;
    if instrumented {
        state.allocation_calls++;
        if state.fail_after != maximum {
            if state.fail_after == 0 {
                state.fail_after = maximum;
                return null;
            }
            state.fail_after--;
        }
    }
    var bytes = count *size;
    if bytes == 0 {
        compiler_memory_deallocate(state, pointer);
        return null;
    }
    var fresh = pointer == null;
    var result = compiler_host_reallocate(pointer, bytes);
    if instrumented {
        if fresh {
            if result != null {
                state.live_buffers++;
            }
        }
    }
    return result;
}

export fn compiler_memory_deallocate(state: CompilerMemoryState*, pointer: void*): void {
    if state != null {
        if pointer != null {
            state.live_buffers--;
        }
    }
    compiler_host_deallocate(pointer);
}
