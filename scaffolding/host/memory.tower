import tower;
import memory_libc;
import memory_types;

// Compiler allocation policy, separate from guest raw-address allocation.
// A null state selects production behavior; tests explicitly supply a state.
// The borrowed native allocator is the platform libc (wasi-libc in reactors).
extern fn abort(): void;

fn compiler_memory_guard(): usize {
    var guard: u64 = 16045690984833335023;
    if sizeof(usize) == 4 {
        guard = 3735928559;
    }
    return convert(usize, guard);
}

// Compiler-owned buffers carry their allocator/optional instrumentation owner.
// This private allocation header is unrelated to Foundation pointer semantics.
// Null owner uses the ordinary compiler runtime, including its explicit serial
// fault-injection profile. Legacy host instrumentation stays single-owner.
export fn compiler_node_allocate(state: CompilerNodeMemoryState*, size: usize, diagnostic: bool): void* {
    var word = sizeof(usize);
    var overhead = word * (diagnostic ? 5 : 4);
    var maximum = ~convert(usize, 0);
    if size > maximum - overhead - word { return null; }
    var payload = size == 0 ? 1 : size;
    if diagnostic { payload = (payload + word - 1) / word * word; }
    var bytes = payload + overhead;
    var allocation = state is null ? bits(void*, alloc(u8, bytes)) : compiler_host_reallocate(null, bytes);
    if allocation is null { return null; }
    var header = bits(usize*, allocation);
    header[0] = bits(usize, state);
    header[1] = payload;
    header[2] = diagnostic ? compiler_memory_guard() : 0;
    header[3] = diagnostic ? 1 : 0;
    var data = &header[4];
    if state is not null { state.live_allocations++; }
    if diagnostic {
        header[4 + payload / word] = compiler_memory_guard();
        fill(data, 219, payload);
    }
    return bits(void*, data);
}

export fn compiler_node_free(state: CompilerNodeMemoryState*, pointer: void*, diagnostic: bool): void {
    if pointer is null { return; }
    var header = bits(usize*, pointer) - 4;
    var owner = bits(CompilerNodeMemoryState*, header[0]);
    var payload = header[1];
    var guarded = header[3] != 0;
    // A public legacy free can release a Tower-owned buffer. Its captured
    // allocator policy, not the caller's default diagnostic profile, decides
    // how to reclaim it. Explicit legacy owners must still agree.
    if owner is not null {
        if owner.live_allocations == 0 || (state is not null && (state != owner || diagnostic != guarded)) { abort(); return; }
        owner.live_allocations--;
    }
    if guarded {
        var guard = compiler_memory_guard();
        if header[2] != guard || header[4 + payload / sizeof(usize)] != guard { abort(); return; }
        fill(header, 254, payload + sizeof(usize) * 5);
    }
    if owner is null { free(header); }
    else { compiler_host_deallocate(bits(void*, header)); }
}

// Production compiler paths never touch the legacy process-wide node counter.
// Both entry points use the same allocation format as its compatibility bridge.
export fn compiler_buffer_allocate(bytes: usize): void* {
    return compiler_node_allocate(null, bytes, false);
}

export fn compiler_buffer_free(pointer: void*): void {
    compiler_node_free(null, pointer, false);
}

export fn compiler_host_reallocate(pointer: void*, bytes: usize): void* {
    return `c_name(void* realloc(void*, size_t))`(pointer, bytes);
}

export fn compiler_host_deallocate(pointer: void*): void {
    `c_name(void free(void*))`(pointer);
}

export fn compiler_memory_reallocate(state: CompilerMemoryState*, pointer: void*, count: usize, size: usize): void* {
    var maximum: usize = 0;
    maximum--;
    if size != 0 {
        var limit = maximum / size;
        if count > limit {
            return null;
        }
    }
    var instrumented = state != null;
    if instrumented {
        state.allocation_calls++;
        if state.fail_after != maximum {
            if state.fail_after == 0 {
                state.fail_after = maximum;
                return null;
            }
            state.fail_after--;
        }
    }
    var bytes = count *size;
    if bytes == 0 {
        compiler_memory_deallocate(state, pointer);
        return null;
    }
    var fresh = pointer == null;
    var result = compiler_host_reallocate(pointer, bytes);
    if instrumented {
        if fresh {
            if result != null {
                state.live_buffers++;
            }
        }
    }
    return result;
}

export fn compiler_memory_deallocate(state: CompilerMemoryState*, pointer: void*): void {
    if state != null {
        if pointer != null {
            state.live_buffers--;
        }
    }
    compiler_host_deallocate(pointer);
}
