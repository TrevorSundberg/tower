import tower;
import .library.bytes_types;
import .library.bytes_interface;
import .library.vector;
import driver_support;
import driver_windows_arguments;

// x64/ARM64 Windows CRT and kernel32 ABI. These are ordinary host effects.
extern fn _write(fd: i32, data: u8*, length: u32): i32;

extern fn _spawnvp(mode: i32, executable: u8*, argv: u8**): i64;

extern fn _errno(): i32*;

extern fn QueryPerformanceCounter(value: i64*): i32;

extern fn QueryPerformanceFrequency(value: i64*): i32;

extern fn GetTempPathA(capacity: u32, output: u8*): u32;

extern fn GetTempFileNameA(directory: u8*, prefix: u8*, unique: u32, output: u8*): u32;

extern fn DeleteFileA(path: u8*): i32;

extern fn GetModuleFileNameA(module: void*, output: u8*, capacity: u32): u32;

extern fn GetFileAttributesA(path: u8*): u32;

export fn driver_platform_exists(path: u8*): bool {
    var exists = GetFileAttributesA(path) != 4294967295;
    return exists;
}

export fn driver_platform_separator(byte: u8): bool {
    var separator = byte == 47;
    if separator {
        return true;
    }
    separator = byte == 92;
    return separator;
}

export fn driver_platform_executable(out: ByteBuffer*): bool {
    var capacity: u32 = 256;
    loop {
        if !bytes_reserve(out, convert(usize, capacity)) {
            return false;
        }
        var length = GetModuleFileNameA(null, out.data, capacity);
        if length == 0 {
            return false;
        }
        if length < capacity {
            out.length = convert(usize, length);
            return host_text_terminate(out);
        }
        if capacity > 2147483647 {
            return false;
        }
        capacity = capacity * 2;
    }
}

export fn driver_clock(): u64 {
    var value: i64 = 0;
    var frequency: i64 = 0;
    var ok = QueryPerformanceCounter(&value) != 0;
    ok &&= QueryPerformanceFrequency(&frequency) != 0;
    ok &&= frequency > 0;
    if !ok {
        return 0;
    }
    var ticks = convert(u64, value);
    var rate = convert(u64, frequency);
    var seconds = ticks / rate;
    var fraction = ticks % rate;
    seconds = seconds * 1000000000;
    fraction = fraction * 1000000000;
    fraction = fraction / rate;
    var result = seconds + fraction;
    return result;
}

export fn driver_platform_write(fd: i32, data: u8*, length: usize): void {
    driver_platform_write_result(fd, data, length);
}

export fn driver_platform_write_result(fd: i32, data: u8*, length: usize): bool {
    while length != 0 {
        var amount: usize = 65536;
        if length < amount {
            amount = length;
        }
        var written = _write(fd, data, convert(u32, amount));
        if written <= 0 {
            return false;
        }
        var done = convert(usize, written);
        data = data + done;
        length = length - done;
    }
    return true;
}

export fn driver_platform_remove(path: u8*): void {
    DeleteFileA(path);
}

export fn driver_platform_temporary(out: ByteBuffer*): bool {
    var directory: u8[261];
    var length = GetTempPathA(261, &directory[0]);
    var ok = length != 0;
    ok &&= length < 261;
    ok &&= bytes_reserve(out, 261);
    ok &&= GetTempFileNameA(&directory[0], "twr", 0, out.data) != 0;
    if ok {
        out.length = strlen(out.data);
    }
    else {
        driver_error("Cannot create temporary file", "");
    }
    return ok;
}

export fn driver_platform_run(argv: u8**): i32 {
    var quoted: DriverArguments;
    driver_arguments_init(&quoted);
    var i: usize = 0;
    for(; argv[i] != null; i++) {
        var text: ByteBuffer = default;
        quoted.ok = driver_windows_quote(&text, argv[i]);
        quoted.ok &&= vector_push(&quoted.values, text.data);
        if !quoted.ok {
            bytes_dispose(&text);
            break;
        }
    }
    quoted.ok &&= vector_push(&quoted.values, null);
    var result: i32 = 1;
    if quoted.ok {
        var code = _spawnvp(0, argv[0], quoted.values.data);
        if code == -1 {
            var error = _errno();
            if *error == 2 {
                driver_error("Cannot find tool: ", argv[0]);
            }
            else {
                driver_error("Cannot execute tool: ", strerror(*error));
            }
        }
        if code == 0 {
            result = 0;
        }
    } else {
        driver_error("Unable to allocate tool arguments", "");
    }
    driver_arguments_dispose(&quoted);
    return result;
}
