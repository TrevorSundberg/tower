import tower;

extern fn _write(fd: i32, data: u8*, length: u32): i32;

const CompilerWriteChunk: usize = 65536;

export fn platform_write(stream: u32, data: u8*, length: usize): i64 {
    var valid = stream == 1;
    valid ||= stream == 2;
    if !valid {
        return -1;
    }
    var count = length;
    if count > CompilerWriteChunk() {
        count = CompilerWriteChunk();
    }
    return convert(i64, _write(convert(i32, stream), data, convert(u32, count)));
}

export fn compiler_runtime_write(data: u8*, length: usize): void {
    while length != 0 {
        var written = platform_write(2, data, length);
        if written <= 0 {
            return;
        }
        var count = convert(usize, written);
        data = data + count;
        length = length - count;
    }
}
