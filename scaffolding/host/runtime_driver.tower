import tower;
import runtime_platform;

extern fn LLVMSetValueName2(value: void*, name: u8*, length: usize): void;
extern fn strstr(text: u8*, part: u8*): u8*;

fn runtime_driver_name(module: void*, source: u8*, target: u8*): void* {
    var value = LLVMGetNamedFunction(module, source);
    if value == null || LLVMIsDeclaration(value) == 0 || LLVMGetNamedFunction(module, target) != null {
        puts("Invalid or conflicting driver foreign binding");
        puts(source);
        return null;
    }
    LLVMSetValueName2(value, target, strlen(target));
    return value;
}

// Retain the published profile spellings for bootstrap/build compatibility.
// Only the target libc stat symbol remains; no C++ containers or host globals.
export fn runtime_driver(context: void*, module: void*, profile: u8*): bool {
    var target = LLVMGetTarget(module);
    if LLVMPointerSize(LLVMGetModuleDataLayout(module)) != 8 {
        puts("Driver libc ABI requires an explicit 64-bit profile");
        return false;
    }
    var supported = false;
    var stat_name: u8* = "stat";
    if strcmp(profile, "libstdcxx") == 0 && strstr(target, "linux") != null { supported = true; }
    if (strcmp(profile, "libcxx") == 0 || strcmp(profile, "libcxx_alternate") == 0)
        && (strstr(target, "apple") != null || strstr(target, "darwin") != null) {
        supported = true;
        if strstr(target, "x86_64") == target { stat_name = "stat$INODE64"; }
    }
    if strcmp(profile, "msvc") == 0 && strstr(target, "windows-msvc") != null {
        supported = true;
        stat_name = null;
    }
    if !supported {
        puts("Unsupported driver libc ABI or target/profile mismatch");
        return false;
    }
    return stat_name is null || runtime_driver_name(module, "driver_stat", stat_name) is not null;
}
