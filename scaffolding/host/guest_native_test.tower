import tower;
import guest_entry;
import native_test_result;

extern fn open(path: u8*, flags: i32): i32;
extern fn dup3(from: i32, to: i32, flags: i32): i32;
extern fn close(fd: i32): i32;
extern fn write(fd: i32, data: u8*, length: usize): usize;
extern fn __errno_location(): i32*;
extern fn strlen(text: u8*): usize;

// Linux GNU test process only. Keep the result independent of guest stdout
// and stderr. A nested exec must not inherit the result descriptor.
var NativeTestResultDescriptor: i32 = 3;
var NativeTestWriteOnly: i32 = 1;
var NativeTestCloseOnExec: i32 = 524288;
var NativeTestInterrupted: i32 = 4;

fn native_test_write(data: u8*, length: usize): bool {
    while length != 0 {
        var written = write(NativeTestResultDescriptor, data, length);
        if written == ~convert(usize, 0) && *__errno_location() == NativeTestInterrupted { continue; }
        if written == 0 || written > length { return false; }
        data += written;
        length -= written;
    }
    return true;
}

export fn guest_native_test_trap(message: u8*, offset: usize): void {
    var result: NativeTestResult = { outcome: NativeTestOutcome.Trapped, offset: offset, message_bytes: strlen(message) };
    var ok = native_test_write(bits(u8*, &result), sizeof(NativeTestResult))
        && native_test_write(message, result.message_bytes);
    guest_exit(ok ? 1 : 2);
}

export fn guest_native_test_main(argc: i32, argv: u8**): i32 {
    if argc != 2 { return 2; }
    var fd = open(argv[1], NativeTestWriteOnly | NativeTestCloseOnExec);
    if fd < 0 { return 2; }
    if fd != NativeTestResultDescriptor {
        var installed = dup3(fd, NativeTestResultDescriptor, NativeTestCloseOnExec);
        close(fd);
        if installed < 0 { return 2; }
    }
    // The ordinary runtime entry calls the compiler's selected tower_main once.
    guest_runtime_main();
    var result: NativeTestResult = { outcome: NativeTestOutcome.Completed, ..default };
    return native_test_write(bits(u8*, &result), sizeof(NativeTestResult)) ? 0 : 2;
}
