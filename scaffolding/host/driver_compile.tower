import .library.work_budget_types;

extern fn sem_resource_message(error: WorkBudgetError): u8*;
extern fn entity_create_result(store: void*, error: WorkBudgetError*): void*;

struct DriverCompilation {
    request: DriverRequest*;
    timing: DriverTiming*;
    execution: ExecutionSession;
    backend: void*;
    generated: ByteBuffer;
    output: ByteBuffer;
    text: u8*;
    length: usize;
    width: u32;
    profile: u32;
    packaged: bool;
    preserve_foundation: bool;
}

extern fn type_object_program(root: void*): bool;
extern fn syntax_baseline_install(world: void*, environment: void*, source: u8*, foundation: bool, diagnostic: SyntaxVersionDiagnostic*): bool;
extern fn syntax_version_diagnostic_text(diagnostic: SyntaxVersionDiagnostic*): u8*;
extern fn syntax_version_diagnostic_dispose(diagnostic: SyntaxVersionDiagnostic*): void;

fn driver_install_grammar(request: DriverRequest*, canonical: bool, baseline: u32): bool {
    if baseline == SyntaxSeedBaseline { return true; }
    if canonical && !driver_request_canonical(request) {
        driver_error("", driver_request_error(request));
        return false;
    }
    if canonical { driver_request_stage(request); }
    var first = canonical ? DriverCanonicalBedrockText : DriverBedrockText;
    var diagnostic: SyntaxVersionDiagnostic = default;
    defer syntax_version_diagnostic_dispose(&diagnostic);
    var modules = driver_request_modules(request);
    var ok = syntax_baseline_install(request.world, modules, request.text[first].data, false, &diagnostic);
    if ok && baseline == SyntaxFoundationBaseline {
        ok = syntax_baseline_install(request.world, modules, request.text[first + 1].data, true, &diagnostic);
    }
    if !ok { driver_error("", syntax_version_diagnostic_text(&diagnostic)); }
    return ok;
}

fn driver_compile_report(state: DriverCompilation*, error: u8*, offset: usize): void {
    var request = state.request;
    // Original inputs remain pinned even after optimization replaces the source.
    driver_report(error, offset, request.text[DriverSourceText].data,
    request.text[DriverSourceText].length, request.options.source, request.modules);
}

fn driver_compile_execution_report(state: DriverCompilation*): void {
    var execution = &state.execution;
    var text = execution.error.length != 0 ? execution.error.data : "Execution failed without a diagnostic";
    var offset = execution.machine.error_offset;
    if execution.program.resource.error != WorkBudgetError.None {
        text = sem_resource_message(execution.program.resource.error);
        offset = execution.program.resource.offset;
    }
    driver_compile_report(state, text, offset);
}

fn driver_compile_program(state: DriverCompilation*): bool {
    if driver_execution_compile(&state.execution, state.text, state.length, state.width, driver_request_modules(state.request))
        && state.execution.program.resource.error == WorkBudgetError.None {
        return true;
    }
    driver_compile_execution_report(state);
    return false;
}

fn driver_compile_backend(state: DriverCompilation*, target: u8*, codegen: BackendCodegen): bool {
    if state.backend != null {
        backend_close(state.backend);
    }
    state.backend = backend_open_codegen(target, codegen);
    if state.backend == null {
        driver_error("Unable to allocate backend storage", "");
        return false;
    }
    if backend_error(state.backend)[0] != 0 {
        driver_error("", backend_error(state.backend));
        return false;
    }
    return true;
}

fn driver_backend_failed(state: DriverCompilation*): bool {
    driver_compile_report(state, backend_error(state.backend), backend_error_offset(state.backend));
    return false;
}

fn driver_compile_format(state: DriverCompilation*, root: void*, out: ByteBuffer*): bool {
    var formatted: FormatResult = default;
    format_entity(&formatted, root, compiler_node_type(root, CompilerSyntax), null,
    compiler_node_type(root, CompilerParserMatch));
    var ok = !formatted.failed && bytes_assign_text(out, formatted.text.data, formatted.text.length);
    format_dispose(&formatted);
    if !ok {
        driver_error("Unable to allocate canonical formatted source", "");
    }
    return ok;
}

fn driver_compile_ir(state: DriverCompilation*): bool {
    var options = state.request.options;
    if options.raw[0] == 0 && options.optimized[0] == 0 { return true; }
    var raw = backend_raw(state.backend);
    var optimized = backend_optimized(state.backend);
    return driver_write_ir(options.raw, raw, strlen(raw), options.optimized, optimized, strlen(optimized));
}

extern fn driver_write_ir(raw_path: u8*, raw: u8*, raw_length: usize, optimized_path: u8*, optimized: u8*, optimized_length: usize): bool;

fn driver_compile_normalize(state: DriverCompilation*): bool {
    if !driver_compile_program(state) {
        return false;
    }
    if !driver_compile_backend(state, state.width == 4 ? "wasm32-unknown-unknown": "wasm64-unknown-unknown", BackendCodegen.Default) {
        return false;
    }
    var program = &state.execution.program;
    if !backend_lower(state.backend, program.root, program.functions.data, program.functions.length, state.width, false)
    || !backend_optimize_interpreter(state.backend, state.request.options.optimize) {
        return driver_backend_failed(state);
    }
    if !driver_compile_ir(state) {
        return false;
    }
    var imported: SemanticProgram = default;
    var error: WorkBudgetError;
    var root = entity_create_result(compiler_world_store(state.request.world), &error);
    if root == null {
        driver_error("", sem_resource_message(error));
        return false;
    }
    semantic_initialize(&imported, root, state.width);
    if imported.resource.error != WorkBudgetError.None {
        driver_error("", sem_resource_message(imported.resource.error));
        semantic_program_dispose(&imported);
        entity_release(root);
        return false;
    }
    state.preserve_foundation = type_object_program(program.root);
    var ok = state.preserve_foundation || backend_import_foundation(state.backend, root);
    if ok {
        ok = driver_compile_format(state, state.preserve_foundation ? program.root : root, &state.generated);
    }
    else {
        driver_backend_failed(state);
    }
    semantic_program_dispose(&imported);
    entity_release(root);
    if !ok || !driver_install_grammar(state.request, true, SyntaxFoundationBaseline) {
        return false;
    }
    driver_request_stage(state.request);
    state.text = state.generated.data;
    state.length = state.generated.length;
    return true;
}

fn driver_compile_package(state: DriverCompilation*): bool {
    if !driver_install_grammar(state.request, true, SyntaxFoundationBaseline) {
        return false;
    }
    var data = state.text;
    if !execution_package_load(&state.execution, data, state.length, driver_request_modules(state.request))
        || state.execution.program.resource.error != WorkBudgetError.None {
        if state.execution.program.error.length != 0 || state.execution.program.resource.error != WorkBudgetError.None {
            driver_compile_execution_report(state);
        } else {
            driver_error("", state.execution.error.length != 0 ? state.execution.error.data : "Unable to load compiler package");
        }
        return false;
    }
    state.width = state.execution.program.pointer_bytes;
    state.profile = convert(u32, data[24]);
    state.length = bytecode_source_size(data);
    if !bytes_assign_text(&state.generated, data + 56, state.length) {
        return false;
    }
    state.text = state.generated.data;
    return true;
}

fn driver_compile_dependencies(state: DriverCompilation*, output: u8*): bool {
    if frontend_modules_depfile(state.request.modules, output, state.request.options.depfile) {
        return true;
    }
    driver_error("Cannot write dependency file: ", state.request.options.depfile);
    return false;
}

fn driver_compile_text_output(state: DriverCompilation*): i32 {
    if state.execution.program.resource.error != WorkBudgetError.None {
        driver_compile_execution_report(state);
        return 1;
    }
    var options = state.request.options;
    var emit = options.emit;
    var output = options.output;
    if output[0] == 0 {
        var suffix = ".disassembled.tower";
        if driver_same(emit, "bytecode") {
            suffix = ".towerbc";
        }
        if driver_same(emit, "c") {
            suffix = ".c";
        }
        if driver_same(emit, "brightscript") {
            suffix = ".brs";
        }
        if !bytes_append(&state.output, options.source, driver_extension(options.source))
        || !driver_text(&state.output, suffix) || !host_text_terminate(&state.output) {
            return 1;
        }
        output = state.output.data;
    }
    if !driver_output_safe(options.source, output) || !driver_compile_dependencies(state, output) {
        return 1;
    }
    var program = &state.execution.program;
    if !options.comments {
        semantic_strip_comments(program.root);
    }
    var text: ByteBuffer;
    var error: ByteBuffer;
    text = default;
    error = default;
    var ok = true;
    if driver_same(emit, "bytecode") {
        ok = driver_install_grammar(state.request, true, SyntaxFoundationBaseline);
        var profile = state.packaged ? state.profile : convert(u32, state.preserve_foundation
            ? ExecutionProfile.Canonical : options.optimize ? ExecutionProfile.Optimized : ExecutionProfile.Normalized);
        ok &&= execution_package_encode(program, driver_request_modules(state.request), profile, &text, &error);
    } else {
        if driver_same(emit, "foundation") {
            ok = driver_compile_format(state, program.root, &text);
        }
        else {
            if driver_same(emit, "c") {
                c_emit(&text, &error, program.root, state.width, options.comments);
            }
            else {
                roku_emit(&text, &error, program.root, state.width, options.comments);
            }
        }
    }
    if error.length != 0 {
        if host_text_terminate(&error) {
            driver_error("", error.data);
        }
        ok = false;
    }
    ok &&= driver_write_file(output, text.data, text.length);
    bytes_dispose(&text);
    bytes_dispose(&error);
    return ok ? 0: 1;
}

fn driver_compile_interpret(state: DriverCompilation*): i32 {
    if state.execution.machine.failed || state.execution.program.resource.error != WorkBudgetError.None {
        driver_compile_execution_report(state);
        return 1;
    }
    var options = state.request.options;
    if !driver_compile_dependencies(state, options.output) {
        return 1;
    }
    driver_timing_mark(state.timing, options.timings, "compile");
    if options.fast || state.packaged {
        if !driver_execution_fast(&state.execution) {
            driver_error("Unable to allocate interpreter cache", "");
            return 1;
        }
        driver_timing_mark(state.timing, options.timings, "prepare");
    }
    var execution = &state.execution;
    if !driver_execution_start(execution) {
        driver_compile_execution_report(state);
        return 1;
    }
    while !execution.machine.done {
        if execution.fast != null {
            fast_interpreter_step(&execution.machine, execution.fast, 10000);
        }
        else {
            interpreter_step(&execution.machine, 10000);
        }
        driver_execution_flush(execution);
    }
    driver_timing_mark(state.timing, options.timings, "execute");
    if execution.machine.failed || execution.error.length != 0 || execution.program.resource.error != WorkBudgetError.None {
        driver_compile_execution_report(state);
        return 1;
    }
    return 0;
}

fn driver_compile_object(state: DriverCompilation*, started: u64): i32 {
    if state.execution.program.resource.error != WorkBudgetError.None {
        driver_compile_execution_report(state);
        return 1;
    }
    var options = state.request.options;
    var program = &state.execution.program;
    var parsed = driver_clock();
    var retain_ir = options.raw[0] != 0 || options.optimized[0] != 0
        || driver_same(options.emit, "llvm") || driver_same(options.emit, "llvm-optimized");
    if !backend_retain_ir(state.backend, retain_ir) {
        driver_error("Cannot configure backend IR retention after lowering", ""); return 1;
    }
    if !backend_lower(state.backend, program.root, program.functions.data, program.functions.length, state.width, options.library) {
        driver_backend_failed(state);
        return 1;
    }
    var lowered = driver_clock();
    if !backend_optimize(state.backend, options.optimize) {
        driver_backend_failed(state);
        return 1;
    }
    var optimized = driver_clock();
    if !backend_emit(state.backend) {
        driver_backend_failed(state);
        return 1;
    }
    var emitted = driver_clock();
    if !driver_compile_dependencies(state, options.output) {
        return 1;
    }
    driver_timing_mark(state.timing, options.timings, "compile");
    if options.timings {
        driver_timing_value(state.timing, "parse", parsed -started);
        driver_timing_value(state.timing, "before", lowered -parsed);
        driver_timing_value(state.timing, "after", optimized -lowered);
        driver_timing_value(state.timing, "emit", emitted -optimized);
    }
    if !driver_compile_ir(state) {
        return 1;
    }
    var wasm = strstr(options.target, "wasm") == options.target;
    var windows = strstr(options.target, "windows") != null;
    var output = options.output[0] == 0 ? driver_output_name(options.emit, wasm, windows): options.output;
    if driver_same(options.emit, "object") {
        return driver_write_file(output, backend_bytes(state.backend), backend_size(state.backend)) ? 0: 1;
    }
    if driver_same(options.emit, "llvm") || driver_same(options.emit, "llvm-optimized") {
        var text = driver_same(options.emit, "llvm") ? backend_raw(state.backend): backend_optimized(state.backend);
        return driver_write_file(output, text, strlen(text)) ? 0: 1;
    }
    if !driver_same(options.emit, "exe") {
        driver_error("Unknown output kind: ", options.emit);
        return 1;
    }
    var i: usize = 0;
    while i < options.link_count {
        if !driver_platform_regular(options.links[i]) {
            driver_error("Missing link input: ", options.links[i]);
            return 1;
        }
        ++i;
    }
    var link = driver_link_open(options.target, options.cc, options.linker, options.sysroot, output,
    state.request.root, wasm, windows, state.timing, options.timings);
    if link == null {
        return 1;
    }
    link.wasm_link = backend_link_tower_wasm;
    link.native_link = backend_link_tower_native;
    i = 1;
    while i < program.functions.length {
        var function = sem_get(program.functions.data[i]);
        if function.external {
            driver_link_import(link, backend_function_name(state.backend, i));
        }
        if function.exported {
            driver_link_export(link, backend_function_name(state.backend, i));
        }
        ++i;
    }
    i = 0;
    while i < options.link_count {
        driver_link_input(link, options.links[i]);
        ++i;
    }
    return driver_link_run(link, backend_bytes(state.backend), backend_size(state.backend));
}

extern fn driver_output_name(emit: u8*, wasm: bool, windows: bool): u8*;

fn driver_compile_run(state: DriverCompilation*): i32 {
    var options = state.request.options;
    state.text = state.request.text[DriverSourceText].data;
    state.length = state.request.text[DriverSourceText].length;
    state.packaged = driver_same(options.source + driver_extension(options.source), ".towerbc");
    if state.packaged {
        if !driver_compile_package(state) {
            return 1;
        }
    } else {
        var i: usize = 0;
        while i < state.length {
            if state.text[i] == 0 {
                driver_error("Source contains NUL bytes", "");
                return 1;
            }
            ++i;
        }
        if !driver_compile_backend(state, options.target, options.optimize ? BackendCodegen.Default : BackendCodegen.None) {
            return 1;
        }
        state.width = backend_pointer_bytes(state.backend);
        var normalize = driver_same(options.emit, "bytecode") || driver_same(options.emit, "brightscript")
        ||(options.interpret && options.fast) ||(driver_same(options.emit, "c") && options.optimize);
        if normalize && !driver_compile_normalize(state) {
            return 1;
        }
        var started = driver_clock();
        if !driver_compile_program(state) {
            return 1;
        }
        var textual = driver_same(options.emit, "foundation") || driver_same(options.emit, "bytecode")
        || driver_same(options.emit, "c") || driver_same(options.emit, "brightscript");
        if !textual && !options.interpret {
            return driver_compile_object(state, started);
        }
    }
    if driver_same(options.emit, "foundation") || driver_same(options.emit, "bytecode")
    || driver_same(options.emit, "c") || driver_same(options.emit, "brightscript") {
        return driver_compile_text_output(state);
    }
    return driver_compile_interpret(state);
}

export fn driver_compile(options: DriverOptions*, resources: u8*, timing: DriverTiming*, request: DriverRequest*): i32 {
    if options.unit_count != 0 { return driver_units_compile(request, timing); }
    if !driver_request_prepare(request) {
        driver_error("", driver_request_error(request));
        return 1;
    }
    var formatting = driver_same(options.emit, "source");
    var baseline = formatting ? driver_format_grammar(options.source) : SyntaxFoundationBaseline;
    if !driver_install_grammar(request, false, baseline) {
        return 1;
    }
    driver_timing_mark(timing, options.timings, "bootstrap");
    if formatting { return driver_format(request); }
    var state: DriverCompilation = default;
    state.request = request;
    state.timing = timing;
    var result = driver_compile_run(&state);
    driver_execution_close(&state.execution);
    if state.backend != null {
        backend_close(state.backend);
    }
    bytes_dispose(&state.generated);
    bytes_dispose(&state.output);
    return result;
}
