import tower;
import platform_output;

extern fn guest_exit(status: i32): void;

export fn guest_runtime_print(kind: u32, value: u64, pointer_bytes: u32): void {
    runtime_print_value(kind, value, pointer_bytes);
}

export fn guest_runtime_trap(message: u8*, offset: usize): void {
    var length: usize = 0;
    while message[length] != 0 {
        ++length;
    }
    runtime_write_all(2, message, length);
    runtime_write_all(2, "\n", 1);
    guest_exit(1);
}
