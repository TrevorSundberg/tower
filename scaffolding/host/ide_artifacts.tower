import .library.work_budget_types;

extern fn sem_resource_message(error: WorkBudgetError): u8*;

extern fn compiler_node_type(node: void*, kind: u32): void*;

enum IdePackageError: u32 { CacheMismatch = 9 }
var IdePackageHeaderBytes: usize = 56;
var IdePackageNarrowPointerBytes: u32 = 4;
var IdePackageWidePointerBytes: u32 = 8;

fn ide_program_format(session: IdeExecution*, formatted: FormatResult*): void {
    *formatted = default;
    var present = session != null;
    present &&= session.program.error.length == 0;
    present &&= session.program.resource.error == WorkBudgetError.None;
    if present {
        format_storage_begin(formatted, session.machine.budget);
        format_entity(formatted, session.program.root, compiler_node_type(session.program.root, CompilerSyntax),
            null, compiler_node_type(session.program.root, CompilerParserMatch));
    }
}

fn ide_emit(handle: u32, flags: u32, roku: bool): u8* {
    var session = ide_execution(handle);
    if session == null {
        ide_error("Invalid execution handle");
        return null;
    }
    if session.program.resource.error != WorkBudgetError.None {
        ide_static_error(sem_resource_message(session.program.resource.error));
        return null;
    }
    var output: ByteBuffer;
    var error: ByteBuffer;
    output = default;
    error = default;
    var bit = flags &1;
    var comments = bit == 0;
    if roku {
        roku_emit(&output, &error, session.program.root, session.program.pointer_bytes, comments);
    }
    else {
        c_emit(&output, &error, session.program.root, session.program.pointer_bytes, comments);
    }
    if error.length != 0 {
        ide_error(ide_result(&error));
        bytes_dispose(&output);
        bytes_dispose(&error);
        return null;
    }
    var state = ide_state();
    ide_require(bytes_assign_text(&state.execution, output.data, output.length));
    bytes_dispose(&output);
    bytes_dispose(&error);
    return ide_result(&state.execution);
}

export fn tw_exec_c(handle: u32, flags: u32): u8* {
    return ide_emit(handle, flags, false);
}

export fn tw_exec_roku(handle: u32, flags: u32): u8* {
    return ide_emit(handle, flags, true);
}

export fn tw_exec_strip_comments(handle: u32): void {
    var session = ide_execution(handle);
    if session != null {
        semantic_strip_comments(session.program.root);
    }
}

fn ide_package_reset(): void {
    ide_static_error("");
}

// Check the exact Foundation bytes stored in the envelope once. Encoding and
// verification use that graph; an external package loader reconstructs the same
// text independently. The returned session owns fresh guest storage and nodes.
fn ide_prepare_package_text(source: u8*, length: usize, width: u32, profile: u32): IdeExecution* {
    var state = ide_state();
    var canonical = ide_execution_text(source, length, width, true);
    if canonical.program.resource.error != WorkBudgetError.None {
        ide_static_error(sem_resource_message(canonical.program.resource.error));
        ide_execution_close(canonical);
        return null;
    }
    var result = canonical.machine.storage_error;
    if canonical.machine.failed || !ide_execution_fast(canonical) {
        result = canonical.machine.storage_error;
        ide_static_error(result == WorkBudgetError.None ? "Cannot prepare .towerbc execution cache" : sem_resource_message(result));
        if canonical.error.length != 0 { ide_error(canonical.error.data); }
        ide_execution_close(canonical);
        return null;
    }
    result = bytecode_encode(canonical.fast, source, length, convert(usize, width), profile, &state.bytecode);
    if result != WorkBudgetError.None {
        ide_static_error(sem_resource_message(result));
        ide_execution_close(canonical);
        return null;
    }
    return canonical;
}

// A handle may already have executed or contain noncanonical source. Preserve
// its snapshot contract by formatting and reconstructing independent storage.
fn ide_prepare_package(handle: u32, profile: u32): IdeExecution* {
    ide_package_reset();
    var session = ide_execution(handle);
    if session != null && session.program.resource.error != WorkBudgetError.None {
        ide_static_error(sem_resource_message(session.program.resource.error));
        return null;
    }
    if session is null || session.program.error.length != 0 {
        ide_error("Cannot package an invalid program");
        return null;
    }
    var formatted: FormatResult;
    ide_program_format(session, &formatted);
    defer format_dispose(&formatted);
    if formatted.failed {
        ide_static_error(sem_resource_message(format_storage_error(&formatted)));
        return null;
    }
    return ide_prepare_package_text(formatted.text.data, formatted.text.length, session.program.pointer_bytes, profile);
}

// LLVM already supplies Foundation through the shared formatter. Accept that
// interchange text directly instead of compiling, formatting and parsing it
// again. No checked graph, execution cache or mutable world crosses workers.
export fn tw_exec_prepare_foundation_package(source: u8*, length: usize, width: u32, profile: u32): u32 {
    ide_package_reset();
    if !ide_valid(source, length) { return 0; }
    if width != IdePackageNarrowPointerBytes && width != IdePackageWidePointerBytes {
        ide_error("Unsupported target pointer width");
        return 0;
    }
    if !ide_execution_capacity() { return 0; }
    var canonical = ide_prepare_package_text(source, length, width, profile);
    if canonical is null { return 0; }
    return ide_execution_publish(canonical);
}

export fn tw_exec_prepare_package(handle: u32, profile: u32): u32 {
    if !ide_execution_capacity() { return 0; }
    var canonical = ide_prepare_package(handle, profile);
    if canonical == null { return 0; }
    return ide_execution_publish(canonical);
}

export fn tw_exec_bytecode_size(): usize {
    return ide_state().bytecode.length;
}

// The transport copies the complete package before retiring this VM-owned grant.
export fn tw_exec_bytecode_release(): void {
    work_vector_dispose(&ide_state().bytecode);
}

export fn tw_exec_bytecode_options(handle: u32, profile: u32): usize {
    var canonical = ide_prepare_package(handle, profile);
    if canonical == null { return 0; }
    ide_execution_close(canonical);
    var state = ide_state();
    return state.bytecode.length;
}

export fn tw_exec_bytecode(handle: u32): usize {
    return tw_exec_bytecode_options(handle, 0);
}

export fn tw_exec_bytecode_data(): u8* {
    var state = ide_state();
    return state.bytecode.data;
}

export fn tw_exec_load_bytecode(data: u8*, size: usize): u32 {
    if !ide_execution_capacity() {
        return 0;
    }
    ide_error("");
    var invalid = bytecode_validate(data, size);
    var rejected = invalid != 0;
    if rejected {
        ide_error(bytecode_error(invalid));
        return 0;
    }
    var source = data + IdePackageHeaderBytes;
    var length = bytecode_source_size(data);
    for(var i: usize = 0; i < length; i++) {
        rejected = source[i] == 0;
        if rejected {
            ide_error("NUL in .towerbc Foundation source");
            return 0;
        }
    }
    var session = ide_execution_text(source, length, convert(u32, bytecode_pointer_bytes(data)), true);
    if session.program.resource.error != WorkBudgetError.None {
        ide_static_error(sem_resource_message(session.program.resource.error));
        ide_execution_close(session);
        return 0;
    }
    rejected = session.machine.failed;
    if rejected {
        if session.error.length != 0 { ide_error(session.error.data); }
        else { ide_static_error(sem_resource_message(session.machine.storage_error)); }
        ide_execution_close(session);
        return 0;
    }
    var ready = ide_execution_fast(session);
    ready &&= bytecode_matches(session.fast, data);
    if !ready {
        if session.machine.storage_error != WorkBudgetError.None { ide_static_error(sem_resource_message(session.machine.storage_error)); }
        else { ide_error(bytecode_error(convert(u32, IdePackageError.CacheMismatch))); }
        ide_execution_close(session);
        return 0;
    }
    return ide_execution_publish(session);
}

fn ide_type_name(out: ByteBuffer*, type: FoundationType*): void {
    var name: vector(u8);
    vector_init(&name);
    semantic_format_type(type, &name);
    ide_quote_bytes(out, name.data, name.length);
    vector_dispose(&name);
}

export fn tw_exec_foundation(handle: u32): u8* {
    var session = ide_execution(handle);
    if session != null && session.program.resource.error != WorkBudgetError.None {
        return "{\"status\":\"error\",\"error\":\"Compiler resource request failed\"}";
    }
    var formatted: FormatResult;
    ide_program_format(session, &formatted);
    var state = ide_state();
    var out = &state.execution;
    ide_assign(out, "{\"source\":");
    if formatted.failed {
        ide_quote(out, "");
        ide_spans(out, null, 0);
    }
    else {
        ide_quote_bytes(out, formatted.text.data, formatted.text.length);
        ide_spans(out, formatted.spans.data, formatted.spans.length);
    }
    ide_text(out, ",\"types\":[");
    var present = session != null;
    present &&= session.program.error.length == 0;
    present &&= session.program.resource.error == WorkBudgetError.None;
    if present {
        var i: usize = 0;
        for(; i < session.program.types.length; i++) {
            var type = sem_get(session.program.types.data[i]);
            ide_comma(out, i);
            ide_text(out, "{\"name\":");
            ide_quote_bytes(out, type.name.data, type.name.length);
            var kind: u8* = "scalar";
            var array = type.type.scalar == SArray;
            var record = type.type.scalar == SStruct;
            var empty = type.type.scalar == SVoid;
            if array {
                kind = "array";
            }
            if record {
                kind = "struct";
            }
            if empty {
                kind = "void";
            }
            ide_string(out, "kind", kind);
            if array {
                ide_key(out, "element");
                ide_type_name(out, &type.element);
                ide_field(out, "length", type.length);
            }
            ide_field(out, "size", type.size);
            ide_field(out, "alignment", type.alignment);
            ide_text(out, ",\"fields\":[");
            var j: usize = 0;
            for(; j < type.items.length; j++) {
                var member = sem_get(type.items.data[j]);
                ide_comma(out, j);
                ide_text(out, "{\"name\":");
                ide_quote_bytes(out, member.name.data, member.name.length);
                ide_key(out, "type");
                ide_type_name(out, &member.type);
                ide_field(out, "offset", member.byte_offset);
                ide_field(out, "size", semantic_size(&member.type));
                ide_field(out, "alignment", semantic_alignment(&member.type));
                ide_text(out, "}");
            }
            ide_text(out, "]}");
        }
    }
    ide_text(out, "]}");
    format_dispose(&formatted);
    return ide_result(out);
}
