import tower;
// Release MSVC x64/ARM64 string: inline buffer/pointer, length, capacity.
export fn driver_syntax_heap(value: usize*): bool { return value[3] > 15; }
export fn driver_syntax_data(value: usize*): u8* {
    if driver_syntax_heap(value) { return bits(u8*, value[0]); }
    return bits(u8*, value);
}
extern fn driver_syntax_vector_alignment(): bool;
export fn driver_syntax_storage(value: usize*): u8* {
    var data = bits(u8*, value[0]);
    // MSVC boosts allocations of at least 4096 bytes on x86/x64 only.
    // The actual allocation address precedes the aligned character buffer.
    if driver_syntax_vector_alignment() && value[3] >= 4095 {
        return bits(u8*, *(bits(usize*, data) - 1));
    }
    return data;
}
