import tower;
import driver_posix;
import driver_support;
import .library.bytes_types;
import .library.bytes_interface;

extern fn __errno_location(): i32*;

extern fn readlink(path: u8*, output: u8*, capacity: usize): i64;

export fn driver_platform_executable(out: ByteBuffer*): bool {
    var capacity: usize = 256;
    loop {
        if bytes_reserve(out, capacity) {} else {
            return false;
        }
        var count = readlink("/proc/self/exe", out.data, capacity);
        var failed = count < 0;
        if failed {
            return false;
        }
        var length = convert(usize, count);
        var complete = length < capacity;
        if complete {
            out.length = length;
            return host_text_terminate(out);
        }
        var maximum: usize = 0;
        maximum = maximum - 1;
        var limit = maximum / 2;
        var overflow = capacity > limit;
        if overflow {
            return false;
        }
        capacity = capacity * 2;
    }
}

export fn driver_errno(): i32* {
    return __errno_location();
}

export fn driver_monotonic_clock(): i32 {
    return 1;
}

extern fn read(fd: i32, data: u8*, length: usize): i64;

extern fn pipe2(descriptors: i32*, flags: i32): i32;

const DriverCloseOnExec: i32 = 524288;

extern fn fork(): i32;

extern fn execv(file: u8*, argv: u8**): i32;

extern fn _exit(code: i32): void;

extern fn waitpid(pid: i32, status: i32*, flags: i32): i32;

export fn driver_posix_execute(executable: u8*, argv: u8**): i32 {
    // A close-on-exec pipe distinguishes exec failure from a tool returning 127.
    // The child only invokes libc async-signal-safe operations before exec/_exit.
    var descriptors: i32[2];
    var pipe_failed = pipe2(&descriptors[0], DriverCloseOnExec()) != 0;
    if pipe_failed {
        driver_error("Cannot start tool: ", strerror(driver_error_code()));
        return 1;
    }
    var pid = fork();
    var child = pid == 0;
    if child {
        close(descriptors[0]);
        execv(executable, argv);
        var error = driver_error_code();
        write(descriptors[1], bits(u8*, &error), sizeof(i32));
        _exit(127);
    }
    var fork_error = driver_error_code();
    close(descriptors[1]);
    var fork_failed = pid < 0;
    if fork_failed {
        close(descriptors[0]);
        driver_error("Cannot start tool: ", strerror(fork_error));
        return 1;
    }
    var error: i32 = 0;
    var received: usize = 0;
    while received < sizeof(i32) {
        var data = bits(u8*, &error) + received;
        var remaining = sizeof(i32) -received;
        var count = read(descriptors[0], data, remaining);
        var read_failed = count < 0;
        if read_failed {
            var read_interrupted = driver_error_code() == 4;
            if read_interrupted {
                continue;
            }
            error = 5;
            break;
        }
        var read_done = count == 0;
        if read_done {
            break;
        }
        received = received + convert(usize, count);
    }
    close(descriptors[0]);
    var status: i32 = 0;
    loop {
        var waited = waitpid(pid, &status, 0);
        var wait_done = waited == pid;
        if wait_done {
            break;
        }
        var wait_interrupted = driver_error_code() == 4;
        if wait_interrupted {
            continue;
        }
        driver_error("Cannot wait for tool: ", strerror(driver_error_code()));
        return 1;
    }
    var exec_failed = error != 0;
    if exec_failed {
        var missing_tool = error == 2;
        if missing_tool {
            driver_error("Cannot find tool: ", argv[0]);
        }
        else {
            driver_error("Cannot execute tool: ", strerror(error));
        }
        return 1;
    }
    var success = status == 0;
    if success {
        return 0;
    }
    return 1;
}
