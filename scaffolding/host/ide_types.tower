import tower;
import .library.bytes_types;
import .library.vector;
import .compiler.host_handle_types;
import .compiler.semantic_program_types;
import .compiler.interpreter_types;
import .library.work_vector_types;

// Transport ownership only. Programs own ordinary Foundation entity roots;
// the interpreter state contains disposable execution indexes over those roots.
struct IdeParser {
    syntax: void*;
    response: ByteBuffer;
}

struct IdeExecution {
    machine: IMState;
    program: SemanticProgram;
    fast: void*;
    error: work_vector(u8);
    output: work_vector(u8);
    handle: u32;
}

struct IdeState {
    handles: HostHandles;
    error: ByteBuffer;
    error_fallback: u8*; // Borrowed static presentation; never freed as a buffer.
    execution: ByteBuffer;
    completion: ByteBuffer;
    bytecode: work_vector(u8);
    foundation_error: ByteBuffer;
}
