import tower;
import driver_support;
import driver_types;
import driver_posix;
import .library.bytes_types;
import .library.bytes_interface;

extern fn getcwd(buffer: u8*, capacity: usize): u8*;

extern fn driver_stat(path: u8*, data: void*): i32;

extern fn driver_stat_mode(data: u8*): u32;
extern fn driver_posix_chmod(path: u8*, mode: u32): i32;
// Opaque host stat storage: 256 bytes, aligned to eight, covers both ABIs.
var DriverStatStorage: type = u64[32];

export fn driver_platform_make_executable(path: u8*): bool {
    var status: DriverStatStorage;
    if driver_stat(path, bits(void*, &status[0])) != 0 { return false; }
    var permission_mask: u32 = 511; var read_mask: u32 = 292; var read_to_execute: u32 = 2;
    var permissions = driver_stat_mode(bits(u8*, &status[0])) & permission_mask;
    // Preserve the creation umask and existing access; only readers gain execute.
    permissions |= (permissions & read_mask) >> read_to_execute;
    return driver_posix_chmod(path, permissions) == 0;
}

export fn driver_platform_absolute(path: u8*, out: ByteBuffer*): bool {
    if path[0] == 47 {
        return driver_text(out, path) && host_text_terminate(out);
    }
    var capacity: usize = 256;
    loop {
        if !bytes_reserve(out, capacity) {
            return false;
        }
        if getcwd(out.data, capacity) != null {
            break;
        }
        // ERANGE has the same value in the selected Linux/Darwin libc profiles.
        if driver_error_code() != 34 || capacity > ~convert(usize, 0) / 2 {
            return false;
        }
        capacity *= 2;
    }
    out.length = strlen(out.data);
    return driver_text(out, "/") && driver_text(out, path) && host_text_terminate(out);
}

extern fn readlink(path: u8*, output: u8*, capacity: usize): i64;

export fn driver_platform_file_kind(path: u8*): DriverFileKind {
    // Storage exceeds the selected platform stat layout and has 8-byte alignment.
    var status: DriverStatStorage;
    if driver_stat(path, bits(void*, &status[0])) != 0 {
        var no_entry: i32 = 2; // ENOENT on Linux and Darwin
        if driver_error_code() != no_entry { return DriverFileKind.Unavailable; }
        // stat follows links. An existing dangling link is a broken input.
        var byte: u8;
        if readlink(path, &byte, 1) >= 0 { return DriverFileKind.Unavailable; }
        return driver_error_code() == no_entry ? DriverFileKind.Missing : DriverFileKind.Unavailable;
    }
    return (driver_stat_mode(bits(u8*, &status[0])) & 61440) == 32768 ? DriverFileKind.Regular : DriverFileKind.Unavailable;
}

export fn driver_platform_regular(path: u8*): bool {
    return driver_platform_file_kind(path) == DriverFileKind.Regular;
}
