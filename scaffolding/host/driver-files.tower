import tower;
import '../compiler/host-text';
import '../library/bytes-interface';
import '../library/bytes-types';

// Opaque libc file handles are temporary platform services, not Tower values or
// program storage. Paths and bytes are explicit inputs; no host file is read
// during constant evaluation. The CLI calls these at its execution stage.
extern fn fopen(path: u8*, mode: u8*): void*;

extern fn fread(data: u8*, size: usize, count: usize, file: void*): usize;

extern fn fwrite(data: u8*, size: usize, count: usize, file: void*): usize;

extern fn ferror(file: void*): i32;

extern fn feof(file: void*): i32;

extern fn fclose(file: void*): i32;

// Success replaces out atomically, including the terminating NUL view. Failure
// leaves its old contents intact and closes the file on every path.
export fn driver_read_file(path: u8*, out: ByteBuffer*): bool {
    var file = fopen(path, "rb");
    var missing = file == null;
    if missing {
        return false;
    }
    var next: ByteBuffer;
    fill(&next, 0, sizeof(ByteBuffer));
    var chunk: u8[16384];
    var ok = true;
    loop {
        var count = fread(&chunk[0], 1, 16384, file);
        ok = bytes_append(&next, &chunk[0], count);
        if ok {} else {
            break;
        }
        var failed = ferror(file) != 0;
        if failed {
            ok = false;
            break;
        }
        var done = feof(file) != 0;
        if done {
            break;
        }
        var stalled = count == 0;
        if stalled {
            ok = false;
            break;
        }
    }
    var closed = fclose(file) == 0;
    if closed {} else {
        ok = false;
    }
    if ok {
        ok = host_text_terminate(&next);
    }
    if ok {
        bytes_dispose(out);
        out.data = next.data;
        out.length = next.length;
        out.capacity = next.capacity;
    } else {
        bytes_dispose(&next);
    }
    return ok;
}

// Output is binary (including NUL). A write/close failure is reported; callers
// must not treat a partial output file as a successful compiler artifact.
export fn driver_write_file(path: u8*, data: u8*, count: usize): bool {
    var file = fopen(path, "wb");
    var missing = file == null;
    if missing {
        return false;
    }
    var written: usize = 0;
    var ok = true;
    loop {
        var done = written == count;
        if done {
            break;
        }
        var next = data + written;
        var remaining = count - written;
        var amount = fwrite(next, 1, remaining, file);
        var stalled = amount == 0;
        if stalled {
            ok = false;
            break;
        }
        written = written + amount;
    }
    var failed = ferror(file) != 0;
    if failed {
        ok = false;
    }
    var closed = fclose(file) == 0;
    if closed {} else {
        ok = false;
    }
    return ok;
}
