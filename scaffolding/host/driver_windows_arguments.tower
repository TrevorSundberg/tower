import tower;
import .library.bytes_types;
import .library.bytes_interface;
import driver_support;

// Microsoft CRT argv encoding, including embedded quotes and trailing slashes.
// _spawnvp joins its argv with spaces; quote each argument before that boundary.
// Kept platform-independent so the exact Windows transport is tested on POSIX.
fn driver_windows_quote(out: ByteBuffer*, argument: u8*): bool {
    var ok = bytes_push(out, 34);
    var i: usize = 0;
    var slashes: usize = 0;
    loop {
        var c = argument[i];
        match c {
            92 => {
                slashes++;
            }
            _ => {
                var count = slashes;
                var escape = c == 34;
                var end = c == 0;
                if end {
                    escape = true;
                }
                if escape {
                    count = count * 2;
                }
                for(; count != 0; count--) {
                    ok &&= bytes_push(out, 92);
                }
                slashes = 0;
                if end {
                    break;
                }
                if c == 34 {
                    ok &&= bytes_push(out, 92);
                }
                ok &&= bytes_push(out, c);
            }
        }
        i++;
    }
    ok &&= bytes_push(out, 34);
    ok &&= host_text_terminate(out);
    return ok;
}
