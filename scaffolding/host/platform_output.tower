import tower;
import .library.float_text;
import .library.float_bits;
import .compiler.foundation_tags;
import runtime_output_tags;

// Formatting shared by platform print and trap paths. No host locale, sprintf,
// allocation or implicit host pointer width enters the result.
export fn runtime_format_value(output: u8*, capacity: usize, kind: u32, value: u64, pointer_bytes: u32): usize {
    var buffer: u8[80];
    var length: usize = 0;
    if kind == RuntimePrintText {
        length = convert(usize, pointer_bytes);
        if capacity <= length { return 0; }
        copy(output, bits(u8*, convert(usize, value)), length);
        output[length] = 10;
        return length + 1;
    }
    if kind == SF32 || kind == SF64 {
        length = float_text(value, kind == SF32 ? Float32Width : Float64Width, &buffer[0]);
        buffer[length++] = 10;
        if capacity < length { return 0; }
        copy(output, &buffer[0], length);
        return length;
    }
    if kind == 2 {
        if value != 0 {
            copy(&buffer[0], "true\n", 5);
            length = 5;
        } else {
            copy(&buffer[0], "false\n", 6);
            length = 6;
        }
    } else {
        if kind == 3 {
            var valid = pointer_bytes == 4;
            valid ||= pointer_bytes == 8;
            if !valid {
                return 0;
            }
            buffer[0] = 48;
            buffer[1] = 120;
            var digits = convert(usize, pointer_bytes) *2;
            length = digits + 2;
            var at = length;
            var hex = "0123456789abcdef";
            loop {
                var done = at == 2;
                if done {
                    break;
                }
                at--;
                var index = value % 16;
                buffer[at] = hex[index];
                value = value / 16;
            }
        } else {
            var narrow = kind == 0;
            var negative = false;
            if narrow {
                value = value & 4294967295;
                negative = value >= 2147483648;
            } else {
                if kind == 6 {
                    negative = value >= 9223372036854775808;
                }
            }
            if negative {
                buffer[0] = 45;
                length = 1;
                var zero: u64 = 0;
                value = zero - value;
                if narrow {
                    value = value & 4294967295;
                }
            }
            var digits: u8[24];
            var count: usize = 0;
            loop {
                var digit = value % 10;
                digit = digit + 48;
                digits[count] = convert(u8, digit);
                count++;
                value = value / 10;
                var done = value == 0;
                if done {
                    break;
                }
            }
            for(; count != 0; length++) {
                count--;
                buffer[length] = digits[count];
            }
        }
        buffer[length] = 10;
        length++;
    }
    if capacity >= length {
        copy(output, &buffer[0], length);
        return length;
    }
    return 0;
}

extern fn platform_write(stream: u32, data: u8*, length: usize): i64;

// Preserve short-write progress; an error/zero write cannot spin forever.
export fn runtime_write_all(stream: u32, data: u8*, length: usize): bool {
    var valid = stream == 1;
    valid ||= stream == 2;
    if !valid {
        return false;
    }
    var at: usize = 0;
    loop {
        if at == length {
            return true;
        }
        var remaining = length -at;
        var written = platform_write(stream, &data[at], remaining);
        if written <= 0 {
            return false;
        }
        var count = convert(u64, written);
        if count > convert(u64, remaining) {
            return false;
        }
        at = at + convert(usize, count);
    }
}

export fn runtime_print_value(kind: u32, value: u64, pointer_bytes: u32): bool {
    var buffer: u8[80];
    var length = runtime_format_value(&buffer[0], 80, kind, value, pointer_bytes);
    if length == 0 {
        return false;
    }
    return runtime_write_all(1, &buffer[0], length);
}
