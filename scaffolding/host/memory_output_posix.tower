import tower;

// POSIX and wasi-libc ssize_t have the same width as size_t. Ignore only the
// signed error sentinel; no C++ stream or locale is involved in trap reporting.
extern fn write(fd: i32, data: u8*, length: usize): usize;

const CompilerErrorStream: i32 = 2;

export fn compiler_runtime_write(data: u8*, length: usize): void {
    while length != 0 {
        var count = write(CompilerErrorStream(), data, length);
        var stopped = count == 0;
        if stopped {
            return;
        }
        var sentinel: usize = 0;
        sentinel = sentinel - 1;
        var failed = count == sentinel;
        if failed {
            return;
        }
        failed = count > length;
        if failed {
            return;
        }
        data = data + count;
        length = length - count;
    }
}

export fn platform_write(stream: u32, data: u8*, length: usize): i64 {
    var valid = stream == 1;
    if valid {} else {
        valid = stream == 2;
    }
    if valid {} else {
        return -1;
    }
    var count = write(convert(i32, stream), data, length);
    var sentinel: usize = 0;
    sentinel = sentinel - 1;
    var failed = count == sentinel;
    if failed {
        return -1;
    }
    failed = count > length;
    if failed {
        return -1;
    }
    return convert(i64, count);
}
