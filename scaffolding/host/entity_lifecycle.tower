import tower;
import .compiler.component_kinds;

// Reserved high lifecycle IDs belong to Tower compiler payloads. Native
// callback IDs retain their existing values during the remaining transition.
// Keep this object separate from allocation: utility-only clients need no graph.
extern fn foundation_node_dispose(data: void*): void;

extern fn syntax_node_dispose(data: void*): void;

extern fn node_payload_dispose(kind: u32, data: void*): void;

extern fn syntax_origin_dispose(data: void*): void;

extern fn syntax_trace_dispose(data: void*): void;

extern fn compiler_native_finalize(kind: usize, component: void*, data: void*): void;

export fn tower_entity_finalize(kind: usize, component: void*, data: void*): void {
    var origin = kind == compiler_origin_lifecycle();
    if origin {
        syntax_origin_dispose(data);
        return;
    }
    var expansion = kind == compiler_expansion_lifecycle();
    if expansion {
        syntax_trace_dispose(data);
        return;
    }
    var foundation = kind == compiler_foundation_lifecycle();
    if foundation {
        foundation_node_dispose(data);
        return;
    }
    var syntax = kind == compiler_syntax_lifecycle();
    if syntax {
        syntax_node_dispose(data);
        return;
    }
    var parser = kind >= compiler_parser_lifecycle(CompilerParserMatch());
    if parser {
        var parser_kind = compiler_parser_lifecycle(CompilerParserRule()) -kind;
        node_payload_dispose(convert(u32, parser_kind), data);
        return;
    }
    compiler_native_finalize(kind, component, data);
}
