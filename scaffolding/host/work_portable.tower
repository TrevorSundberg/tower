import tower;
export fn work_thread_retention(): bool { return false; }
export fn work_thread_pool_capacity(): usize { return work_thread_capacity(); }

export fn work_gate_open(): void* { return null; }
export fn work_gate_close(gate: void*): void {}
export fn work_gate_enter(gate: void*): void { trap("Thread transport unavailable", 0); }
export fn work_gate_leave(gate: void*): void { trap("Thread transport unavailable", 0); }

// Portable interpreted/WASI execution uses the same dispatcher and ownership
// rules. A host without shared-memory threads reports that explicitly.
export fn work_thread_available(): bool { return false; }
export fn work_thread_capacity(): usize { return 1; }
export fn work_thread_open(argument: void*): void* { return null; }
export fn work_thread_open_named(argument: void*, posix_entry: u8*, windows_entry: u8*): void* { return null; }
export fn work_thread_close(thread: void*): void {}
export fn work_signal_open(): void* { return null; }
export fn work_signal_close(signal: void*): void {}
export fn work_signal_post(signal: void*): void { trap("Thread transport unavailable", 0); }
export fn work_signal_wait(signal: void*): void { trap("Thread transport unavailable", 0); }
export fn work_signal_try(signal: void*): bool { return false; }
