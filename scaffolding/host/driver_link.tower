import tower;
import .library.bytes_types;
import .library.bytes_interface;
import driver_support;
import driver_timing;
import driver_platform;
import driver_paths;
import driver_linux_libraries;
import driver_link_input;
import driver_mapped_file;
import .backend.link_types;
import .backend.link_inputs;
import .library.vector;

struct DriverLink {
    target: u8*;
    cc: u8*;
    linker: u8*;
    sysroot: u8*;
    output: u8*;
    root: u8*;
    wasm: bool;
    windows: bool;
    timing: DriverTiming*;
    timings: bool;
    program: ByteBuffer;
    runtime: ByteBuffer;
    allowed: ByteBuffer;
    imports: ByteBuffer;
    exports: DriverArguments;
    inputs: DriverArguments;
    system_inputs: DriverArguments;
    ok: bool;
    wasm_link: function(bool, BackendLink*);
    native_link: function(bool, BackendLink*, u8*);
}

fn driver_link_uses_tower(link: DriverLink*): bool {
    if link.wasm { return link.linker[0] == 0 || driver_same(link.linker, "tower-wasm-ld"); }
    if link.windows { return link.linker[0] == 0 || driver_same(link.linker, "tower-pe-link"); }
    if strstr(link.target, "linux") != null { return link.linker[0] == 0 || driver_same(link.linker, "tower-elf-link"); }
    return strstr(link.target, "apple") != null && (driver_same(link.linker, "tower-macho-link") || (link.linker[0] == 0 && link.sysroot[0] == 0));
}

fn driver_link_generated_name(link: DriverLink*, name: ByteBuffer*, initial: u8*): bool {
    if !driver_text(name, initial) || !host_text_terminate(name) { return false; }
    loop {
        var collision = false;
        foreach (var input in &link.inputs.values) {
            if driver_same(input, name.data) { collision = true; break; }
        }
        if !collision { return true; }
        if !driver_text(name, ".") || !host_text_terminate(name) { return false; }
    }
}

export fn driver_link_open(target: u8*, cc: u8*, linker: u8*, sysroot: u8*, output: u8*, root: u8*, wasm: bool, windows: bool, timing: DriverTiming*, timings: bool): DriverLink* {
    var link = alloc(DriverLink, 1);
    if link == null {
        driver_error("Unable to allocate link storage", "");
        return null;
    }
    *link = default;
    link.target = target;
    link.cc = cc;
    link.linker = linker;
    link.sysroot = sysroot;
    link.output = output;
    link.root = root;
    link.wasm = wasm;
    link.windows = windows;
    link.timing = timing;
    link.timings = timings;
    driver_arguments_init(&link.exports);
    driver_arguments_init(&link.inputs);
    driver_arguments_init(&link.system_inputs);
    link.ok = driver_text(&link.imports, "tower_print\ntower_trap\n");
    return link;
}

export fn driver_link_import(link: DriverLink*, name: u8*): void {
    link.ok &&= driver_text(&link.imports, name);
    link.ok &&= driver_text(&link.imports, "\n");
}

export fn driver_link_export(link: DriverLink*, name: u8*): void {
    driver_argument(&link.exports, "", name);
}

export fn driver_link_input(link: DriverLink*, name: u8*): void {
    driver_argument(&link.inputs, "", name);
}

fn driver_link_compile_arguments(link: DriverLink*, args: DriverArguments*): void {
    driver_argument(args, "", link.cc);
    driver_argument(args, "--target=", link.target);
    driver_argument(args, "", "-O2");
    driver_argument(args, "", "-ffreestanding");
    driver_argument(args, "", "-fno-builtin");
    driver_argument(args, "", "-c");
    driver_argument(args, link.root, driver_runtime_resource(link.target));
    driver_argument(args, "", "-o");
    driver_argument(args, "", link.runtime.data);
    if link.sysroot[0] != 0 {
        driver_argument(args, "--sysroot=", link.sysroot);
    }
    driver_argument(args, "", "-mllvm");
    driver_argument(args, "", "-disable-loop-idiom-all");
    driver_argument(args, "", "-Wno-override-module");
}

extern fn strstr(text: u8*, part: u8*): u8*;

fn driver_runtime_resource(target: u8*): u8* {
    if strstr(target, "wasm32") == target {
        return "/runtime-wasm32.ll";
    }
    var arm = strstr(target, "aarch64") == target;
    arm ||= strstr(target, "arm64") == target;
    var x64 = strstr(target, "x86_64") == target;
    var supported = arm;
    if x64 {
        supported = true;
    }
    if !supported {
        return null;
    }
    if strstr(target, "windows") != null {
        if arm {
            return "/runtime-windows-arm64.ll";
        }
        return "/runtime-windows-x64.ll";
    }
    if strstr(target, "apple") != null {
        if arm {
            return "/runtime-macos-arm64.ll";
        }
        return "/runtime-macos-x64.ll";
    }
    if arm {
        return "/runtime-host-linux-arm64.ll";
    }
    return "/runtime-host-linux-x64.ll";
}

fn driver_link_arguments(link: DriverLink*, args: DriverArguments*): void {
    var linker = link.linker;
    if linker[0] == 0 {
        linker = link.cc;
        if link.windows {
            linker = "tower-pe-link";
        }
        if link.wasm {
            linker = "tower-wasm-ld";
        }
        if !link.wasm && !link.windows && driver_link_uses_tower(link) { linker = strstr(link.target, "linux") != null ? "tower-elf-link" : "tower-macho-link"; }
    }
    driver_argument(args, "", linker);
    if link.wasm {
        driver_argument(args, "", "--no-entry");
        driver_argument(args, "", "--export=tower_main");
        driver_argument(args, "", "--export-memory");
        driver_argument(args, "--allow-undefined-file=", link.allowed.data);
        driver_argument(args, "", "--stack-first");
        driver_argument(args, "", "-z");
        driver_argument(args, "", "stack-size=4194304");
        driver_argument(args, "", "--max-memory=268435456");
    } else {
        if link.windows {
            driver_argument(args, "", "/entry:mainCRTStartup");
            driver_argument(args, "", "/subsystem:console");
            driver_argument(args, "/out:", link.output);
        } else {
            if driver_link_uses_tower(link) {
                if strstr(link.target, "linux") != null {
                    driver_argument(args, "", "-pie"); driver_argument(args, "", "--dynamic-linker");
                    driver_argument(args, "", strstr(link.target, "aarch64") == link.target ? "/lib/ld-linux-aarch64.so.1" : "/lib64/ld-linux-x86-64.so.2");
                    foreach (var input in &link.system_inputs.values) { driver_argument(args, "", input); }
                } else {
                driver_argument(args, "", "-arch"); driver_argument(args, "", strstr(link.target, "x86_64") == link.target ? "x86_64" : "arm64");
                driver_argument(args, "", "-platform_version"); driver_argument(args, "", "macos");
                driver_argument(args, "", "11.0"); driver_argument(args, "", "11.0"); driver_argument(args, "", "-e"); driver_argument(args, "", "_main");
                }
            } else { driver_argument(args, "--target=", link.target); }
        }
    }
    driver_argument(args, "", link.program.data);
    driver_argument(args, "", link.runtime.data);
    var linux = !link.wasm && !link.windows && strstr(link.target, "linux") != null && driver_link_uses_tower(link);
    var exports = link.wasm || linux;
    if link.windows {
        exports = true;
    }
    if exports {
        var prefix = "--export=";
        if linux { prefix = "--export-dynamic-symbol="; }
        if link.windows {
            prefix = "/export:";
        }
        for(var i: usize = 0; i < link.exports.values.length; i++) {
            driver_argument(args, prefix, link.exports.values.data[i]);
        }
    } else {
        if link.sysroot[0] != 0 && !driver_link_uses_tower(link) {
            driver_argument(args, "--sysroot=", link.sysroot);
        }
    }
    for(var i: usize = 0; i < link.inputs.values.length; i++) {
        driver_argument(args, "", link.inputs.values.data[i]);
    }
    if !link.windows {
        driver_argument(args, "", "-o");
        driver_argument(args, "", link.output);
    }
}

fn driver_link_execute(link: DriverLink*, data: u8*, length: usize): i32 {
    var runtime = driver_runtime_resource(link.target);
    if runtime == null {
        driver_error("No bundled executable runtime profile for target: ", link.target);
        return 1;
    }
    var ok = link.ok;
    ok &&= link.exports.ok;
    ok &&= link.inputs.ok;
    if !ok {
        driver_error("Unable to allocate link arguments", "");
        return 1;
    }
    var internal = driver_link_uses_tower(link);
    if internal && !link.wasm && !link.windows && strstr(link.target, "linux") != null {
        var path: ByteBuffer = default; defer bytes_dispose(&path);
        if !driver_linux_library(link.target, link.sysroot, "Scrt1.o", &path) { return 1; }
        driver_argument(&link.system_inputs, "", path.data);
        if !driver_linux_library(link.target, link.sysroot, "libc.so.6", &path) { return 1; }
        driver_argument(&link.system_inputs, "", path.data);
        if !link.system_inputs.ok { return 1; }
    }
    if internal {
        if !driver_link_generated_name(link, &link.program, "tower-input.o")
            || !driver_link_generated_name(link, &link.allowed, "tower-allowed.txt") { return 1; }
    } else { if !driver_platform_temporary(&link.program) || !driver_platform_temporary(&link.allowed) { return 1; } }
    if !driver_platform_temporary(&link.runtime) {
        return 1;
    }
    if !internal && !driver_write_file(link.program.data, data, length) {
        return 1;
    }
    var compile: DriverArguments;
    driver_arguments_init(&compile);
    driver_link_compile_arguments(link, &compile);
    var result = driver_command(&compile);
    driver_arguments_dispose(&compile);
    if result != 0 {
        return result;
    }
    driver_timing_mark(link.timing, link.timings, "runtimeCompile");
    if link.wasm && !internal {
        if !driver_write_file(link.allowed.data, link.imports.data, link.imports.length) {
            driver_error("Cannot write linker import list", "");
            return 1;
        }
    }
    var args: DriverArguments;
    driver_arguments_init(&args);
    driver_link_arguments(link, &args);
    result = internal ? driver_link_bytes(link, &args, data, length) : driver_command(&args);
    driver_arguments_dispose(&args);
    driver_timing_mark(link.timing, link.timings, "link");
    return result;
}

// The CLI supplies filesystem inputs explicitly; the backend owns only byte
// plans and ECS jobs. A production binding is passed without importing the
// linker implementation into the driver or its platform policy fixtures.
fn driver_link_bytes(link: DriverLink*, args: DriverArguments*, data: u8*, length: usize): i32 {
    if !args.ok || (link.wasm ? link.wasm_link == null : link.native_link == null) { driver_error("Tower linker service unavailable", ""); return 1; }
    var backend: BackendLink = { arguments: args.values, ..default };
    var views: vector(DriverMappedFile) = default; defer driver_link_files_close(&views);
    defer {
        backend_link_inputs_release(&backend.generated); vector_dispose(&backend.generated);
        vector_dispose(&backend.output); vector_dispose(&backend.error);
    }
    var ok = backend_link_input_store(&backend.generated, link.program.data, data, length)
        && (!link.wasm || backend_link_input_store(&backend.generated, link.allowed.data, link.imports.data, link.imports.length))
        && driver_link_file(&backend, &views, link.runtime.data);
    foreach (var name in &link.inputs.values) {
        if !ok { break; }
        ok = driver_link_file(&backend, &views, name);
        if !ok { driver_error("Cannot read linker input: ", name); }
    }
    foreach (var name in &link.system_inputs.values) {
        if !ok { break; }
        ok = driver_link_file(&backend, &views, name);
        if !ok { driver_error("Cannot read target SDK input: ", name); }
    }
    if !ok { driver_error("Cannot prepare linker bytes", ""); return 1; }
    if !(link.wasm ? link.wasm_link(&backend) : link.native_link(&backend, link.target)) { driver_error("", backend.error.data); return 1; }
    if !driver_write_file(link.output, backend.output.data, backend.output.length) {
        driver_error("Cannot write linked executable: ", link.output); return 1;
    }
    if !link.wasm && !driver_platform_make_executable(link.output) { driver_error("Cannot mark executable output: ", link.output); return 1; }
    return 0;
}

fn driver_temporary_dispose(path: ByteBuffer*): void {
    if path.length != 0 {
        driver_platform_remove(path.data);
    }
    bytes_dispose(path);
}

export fn driver_link_close(link: DriverLink*): void {
    if link == null {
        return;
    }
    if driver_link_uses_tower(link) { bytes_dispose(&link.program); bytes_dispose(&link.allowed); }
    else { driver_temporary_dispose(&link.program); driver_temporary_dispose(&link.allowed); }
    driver_temporary_dispose(&link.runtime);
    bytes_dispose(&link.imports);
    driver_arguments_dispose(&link.exports);
    driver_arguments_dispose(&link.inputs);
    driver_arguments_dispose(&link.system_inputs);
    free(link);
}

// The owning wrapper releases every temporary on all ordinary failure paths.
export fn driver_link_run(link: DriverLink*, data: u8*, length: usize): i32 {
    var result = driver_link_execute(link, data, length);
    driver_link_close(link);
    return result;
}

export fn driver_write_ir(raw_path: u8*, raw: u8*, raw_count: usize, optimized_path: u8*, optimized: u8*, optimized_count: usize): bool {
    var ok = true;
    var requested = raw_path[0] != 0;
    if requested {
        ok = driver_write_file(raw_path, raw, raw_count);
    }
    requested = optimized_path[0] != 0;
    if ok {
        if requested {
            ok = driver_write_file(optimized_path, optimized, optimized_count);
        }
    }
    if !ok {
        driver_error("Cannot write LLVM output", "");
    }
    return ok;
}
