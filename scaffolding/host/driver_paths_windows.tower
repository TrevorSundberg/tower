import tower;
import driver_support;
import driver_types;
import driver_windows;
import .library.bytes_types;
import .library.bytes_interface;

export fn driver_platform_make_executable(path: u8*): bool { return true; }

extern fn GetFullPathNameA(path: u8*, capacity: u32, output: u8*, last: u8**): u32;

export fn driver_platform_absolute(path: u8*, out: ByteBuffer*): bool {
    var capacity = GetFullPathNameA(path, 0, null, null);
    if capacity == 0 || !bytes_reserve(out, convert(usize, capacity)) {
        return false;
    }
    var length = GetFullPathNameA(path, capacity, out.data, null);
    if length == 0 || length >= capacity {
        return false;
    }
    out.length = convert(usize, length);
    return true;
}

extern fn GetLastError(): u32;

export fn driver_platform_file_kind(path: u8*): DriverFileKind {
    var attributes = GetFileAttributesA(path);
    if attributes == ~convert(u32, 0) {
        var error = GetLastError();
        var file_not_found: u32 = 2;
        var path_not_found: u32 = 3;
        return error == file_not_found || error == path_not_found ? DriverFileKind.Missing : DriverFileKind.Unavailable;
    }
    return (attributes & 16) == 0 ? DriverFileKind.Regular : DriverFileKind.Unavailable;
}

export fn driver_platform_regular(path: u8*): bool {
    return driver_platform_file_kind(path) == DriverFileKind.Regular;
}
