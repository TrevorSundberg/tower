import tower;
import '../library/bytes-types';
import '../library/bytes-interface';
import 'driver-support';

// Microsoft CRT argv encoding, including embedded quotes and trailing slashes.
// _spawnvp joins its argv with spaces; quote each argument before that boundary.
// Kept platform-independent so the exact Windows transport is tested on POSIX.
fn driver_windows_quote(out: ByteBuffer*, argument: u8*): bool {
    var ok = bytes_push(out, 34);
    var i: usize = 0;
    var slashes: usize = 0;
    loop {
        var c = argument[i];
        match c {
            92 => {
                slashes = slashes + 1;
            }
            _ => {
                var count = slashes;
                var escape = c == 34;
                var end = c == 0;
                if end {
                    escape = true;
                }
                if escape {
                    count = count * 2;
                }
                while count != 0 {
                    if ok {
                        ok = bytes_push(out, 92);
                    }
                    count = count - 1;
                }
                slashes = 0;
                if end {
                    break;
                }
                var quote = c == 34;
                if quote {
                    if ok {
                        ok = bytes_push(out, 92);
                    }
                }
                if ok {
                    ok = bytes_push(out, c);
                }
            }
        }
        i = i + 1;
    }
    if ok {
        ok = bytes_push(out, 34);
    }
    if ok {
        ok = host_text_terminate(out);
    }
    return ok;
}
