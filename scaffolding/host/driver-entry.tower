import tower;
import 'driver-types';
import 'driver-prepare';
import 'driver-timing';
import 'driver-platform';
import 'driver-support';
import '../library/bytes-types';
import '../library/bytes-interface';

extern fn LLVMGetDefaultTargetTriple(): u8*;
extern fn LLVMDisposeMessage(message: u8*): void;
extern fn driver_dispose(options: DriverOptions*): void;
extern fn driver_resource_root(out: ByteBuffer*, executable: u8*): bool;
extern fn driver_compile(options: DriverOptions*, resources: u8*, timing: DriverTiming*): i32;

// One invocation owns argv-derived options and all host buffers until compilation
// returns. No process-global request state is introduced by the entry point.
// The remaining compiler adapter is synchronous; it may only borrow these views.
fn driver_entry_compile(options: DriverOptions*, timing: DriverTiming*): i32 {
    var executable: ByteBuffer;
    var resources: ByteBuffer;
    fill(&executable, 0, sizeof(ByteBuffer));
    fill(&resources, 0, sizeof(ByteBuffer));
    var located = driver_platform_executable(&executable);
    if located {
        located = driver_resource_root(&resources, executable.data);
    }
    var result: i32 = 1;
    if located {
        result = driver_compile(options, resources.data, timing);
    } else {
        driver_error("Cannot locate compiler resources", "");
    }
    bytes_dispose(&resources);
    bytes_dispose(&executable);
    return result;
}

export fn main(argc: i32, argv: u8**): i32 {
    var timing = driver_timing_open();
    var target = LLVMGetDefaultTargetTriple();
    var missing = target == null;
    if missing {
        driver_error("Cannot determine default target", "");
        driver_timing_close(timing, false);
        return 1;
    }
    var options: DriverOptions;
    var parsed = driver_prepare(&options, convert(usize, argc), argv, target);
    var status: i32 = 1;
    var ready = parsed == 0;
    if ready {
        status = driver_entry_compile(&options, timing);
    } else {
        var complete = parsed == 2;
        if complete {
            status = 0;
        }
    }
    driver_dispose(&options);
    LLVMDisposeMessage(target);
    driver_timing_close(timing, options.timings);
    return status;
}
