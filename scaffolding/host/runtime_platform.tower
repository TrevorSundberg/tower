import tower;

// Private runtime artifact production through upstream LLVM C APIs. These are
// explicit platform ABI implementations of ordinary foreign calls, not new
// Foundation operations or an alternate program representation. No JIT is used.
extern fn LLVMGetTarget(module: void*): u8*;

extern fn LLVMGetNamedFunction(module: void*, name: u8*): void*;

extern fn LLVMIsDeclaration(value: void*): i32;

extern fn LLVMGlobalGetValueType(value: void*): void*;

extern fn LLVMInt8TypeInContext(context: void*): void*;

extern fn LLVMInt32TypeInContext(context: void*): void*;

extern fn LLVMInt64TypeInContext(context: void*): void*;

extern fn LLVMVoidTypeInContext(context: void*): void*;

extern fn LLVMPointerTypeInContext(context: void*, space: u32): void*;

extern fn LLVMArrayType2(element: void*, count: u64): void*;

extern fn LLVMConstArray2(element: void*, values: void**, count: u64): void*;

extern fn LLVMConstAllOnes(type: void*): void*;

extern fn LLVMConstInt(type: void*, value: u64, signed: i32): void*;

extern fn LLVMGetModuleDataLayout(module: void*): void*;

extern fn LLVMPointerSize(layout: void*): u32;

extern fn LLVMFunctionType(result: void*, arguments: void**, count: u32, variadic: i32): void*;

extern fn LLVMAddFunction(module: void*, name: u8*, type: void*): void*;

extern fn LLVMGetNamedGlobal(module: void*, name: u8*): void*;

extern fn LLVMAddGlobal(module: void*, type: void*, name: u8*): void*;

extern fn LLVMSetInitializer(global: void*, value: void*): void;

extern fn LLVMConstNull(type: void*): void*;

extern fn LLVMSetLinkage(global: void*, linkage: u32): void;

extern fn LLVMSetAlignment(global: void*, alignment: u32): void;

extern fn LLVMCreateBuilderInContext(context: void*): void*;

extern fn LLVMDisposeBuilder(builder: void*): void;

extern fn LLVMAppendBasicBlockInContext(context: void*, function: void*, name: u8*): void*;

extern fn LLVMPositionBuilderAtEnd(builder: void*, block: void*): void;

extern fn LLVMBuildRet(builder: void*, value: void*): void*;

extern fn LLVMBuildUnreachable(builder: void*): void*;

extern fn LLVMBuildCall2(builder: void*, type: void*, function: void*, arguments: void**, count: u32, name: u8*): void*;

extern fn LLVMGetParam(function: void*, index: u32): void*;

extern fn LLVMGetInlineAsm(type: void*, assembly: u8*, bytes: usize, constraints: u8*, length: usize, effects: i32, align_stack: i32, dialect: u32, throws: i32): void*;

extern fn LLVMGetEnumAttributeKindForName(name: u8*, length: usize): u32;

extern fn LLVMCreateEnumAttribute(context: void*, kind: u32, value: u64): void*;
extern fn LLVMCreateStringAttribute(context: void*, key: u8*, key_length: u32, value: u8*, value_length: u32): void*;

extern fn LLVMAddAttributeAtIndex(function: void*, index: u32, attribute: void*): void;

extern fn strcmp(left: u8*, right: u8*): i32;

extern fn strlen(text: u8*): usize;

extern fn puts(text: u8*): i32;

var RuntimePrivateLinkage: u32 = 9;
var RuntimeFunctionAttributes: u32 = 4294967295;

fn runtime_platform_declaration(module: void*, name: u8*, type: void*): void* {
    var function = LLVMGetNamedFunction(module, name);
    if function == null {
        puts("Missing runtime platform declaration");
        puts(name);
        return null;
    }
    var valid = LLVMIsDeclaration(function) != 0;
    valid &&= LLVMGlobalGetValueType(function) == type;
    if !valid {
        puts("Runtime platform declaration has an incompatible ABI");
        puts(name);
        return null;
    }
    return function;
}

fn runtime_platform_return(context: void*, function: void*, value: void*): void {
    var builder = LLVMCreateBuilderInContext(context);
    var block = LLVMAppendBasicBlockInContext(context, function, "entry");
    LLVMPositionBuilderAtEnd(builder, block);
    LLVMBuildRet(builder, value);
    LLVMDisposeBuilder(builder);
}

fn runtime_platform_wasm(context: void*, module: void*): bool {
    var output = LLVMGetNamedFunction(module, "tower_print");
    if output != null {
        LLVMAddAttributeAtIndex(output, RuntimeFunctionAttributes, LLVMCreateStringAttribute(context, "wasm-import-module", 18, "tower", 5));
        LLVMAddAttributeAtIndex(output, RuntimeFunctionAttributes, LLVMCreateStringAttribute(context, "wasm-import-name", 16, "print", 5));
    }
    var pointer = LLVMPointerTypeInContext(context, 0);
    var signature = LLVMFunctionType(pointer, null, 0, 0);
    var state = runtime_platform_declaration(module, "guest_wasm_context", signature);
    var heap = runtime_platform_declaration(module, "guest_wasm_heap_base", signature);
    var missing = state == null;
    missing ||= heap == null;
    if missing {
        return false;
    }
    var existing = LLVMGetNamedGlobal(module, "__heap_base");
    if existing != null {
        puts("Unexpected pre-existing heap-base binding");
        return false;
    }
    var base = LLVMAddGlobal(module, LLVMInt8TypeInContext(context), "__heap_base");
    // wasm32 GuestHeap is exactly three 32-bit words: available, cursor, limit.
    // Each unshared Wasm instance owns its zero-initialized runtime storage;
    // ordinary Tower globals retain their existing initialization semantics.
    var layout = LLVMArrayType2(LLVMInt32TypeInContext(context), 3);
    var storage = LLVMAddGlobal(module, layout, "tower.runtime.wasm.heap");
    LLVMSetLinkage(storage, RuntimePrivateLinkage);
    LLVMSetAlignment(storage, 4);
    LLVMSetInitializer(storage, LLVMConstNull(layout));
    runtime_platform_return(context, state, storage);
    runtime_platform_return(context, heap, base);
    return true;
}

export fn runtime_test_state(context: void*, module: void*): bool {
    var width = LLVMPointerSize(LLVMGetModuleDataLayout(module));
    var integer = LLVMInt32TypeInContext(context);
    if width == 8 {
        integer = LLVMInt64TypeInContext(context);
    }
    else {
        if !(width == 4) {
            puts("Unsupported runtime test-state layout");
            return false;
        }
    }
    var signature = LLVMFunctionType(LLVMPointerTypeInContext(context, 0), null, 0, 0);
    var function = runtime_platform_declaration(module, "compiler_test_state", signature);
    if function == null {
        return false;
    }
    var values: void*[3];
    values[0] = LLVMConstNull(integer);
    values[1] = values[0];
    values[2] = LLVMConstAllOnes(integer);
    var global = LLVMAddGlobal(module, LLVMArrayType2(integer, 3), "tower.runtime.compiler.test");
    LLVMSetLinkage(global, RuntimePrivateLinkage);
    LLVMSetAlignment(global, width);
    LLVMSetInitializer(global, LLVMConstArray2(integer, &values[0], 3));
    runtime_platform_return(context, function, global);
    return true;
}

export fn runtime_target_registry_state(context: void*, module: void*): bool {
    var width = LLVMPointerSize(LLVMGetModuleDataLayout(module));
    var integer = LLVMInt32TypeInContext(context);
    if width == 8 { integer = LLVMInt64TypeInContext(context); }
    else {
        if width != 4 { puts("Unsupported target-registry control layout"); return false; }
    }
    var pointer = LLVMPointerTypeInContext(context, 0);
    var signature = LLVMFunctionType(pointer, null, 0, 0);
    // An otherwise empty library may optimize away its unused declaration.
    var function = LLVMGetNamedFunction(module, "backend_registry_control");
    if function == null { function = LLVMAddFunction(module, "backend_registry_control", signature); }
    else { function = runtime_platform_declaration(module, "backend_registry_control", signature); }
    if function == null { return false; }
    // Native once APIs own this zero-initialized platform word. It is object
    // production, not a change to Foundation's uninitialized storage semantics.
    var global = LLVMAddGlobal(module, integer, "tower.runtime.backend.registry");
    LLVMSetLinkage(global, RuntimePrivateLinkage);
    LLVMSetAlignment(global, width);
    LLVMSetInitializer(global, LLVMConstNull(integer));
    runtime_platform_return(context, function, global);
    return true;
}

export fn runtime_host_state(context: void*, module: void*, diagnostic: bool): bool {
    var width = LLVMPointerSize(LLVMGetModuleDataLayout(module));
    var integer = LLVMInt32TypeInContext(context);
    if width == 8 { integer = LLVMInt64TypeInContext(context); }
    else {
        if width != 4 { puts("Unsupported compiler host-state layout"); return false; }
    }
    var pointer = LLVMPointerTypeInContext(context, 0);
    var function = runtime_platform_declaration(module, "compiler_legacy_state", LLVMFunctionType(pointer, null, 0, 0));
    if function is null { return false; }
    // CompilerLegacyState: world pointer, allocation count, diagnostic profile.
    // All supported host profiles use zero for a null pointer. This private
    // storage has one coordinator owner, including shared-memory WASI builds.
    var values: void*[3];
    values[0] = LLVMConstNull(integer);
    values[1] = values[0];
    values[2] = LLVMConstInt(integer, diagnostic ? 1 : 0, 0);
    var global = LLVMAddGlobal(module, LLVMArrayType2(integer, 3), "tower.runtime.compiler.host");
    LLVMSetLinkage(global, RuntimePrivateLinkage);
    LLVMSetAlignment(global, width);
    LLVMSetInitializer(global, LLVMConstArray2(integer, &values[0], 3));
    runtime_platform_return(context, function, global);
    return true;
}

fn runtime_platform_linux(context: void*, module: void*, arm: bool): bool {
    var integer = LLVMInt64TypeInContext(context);
    var parameters: void*[7];
    var i: u32 = 0;
    while i < 7 {
        parameters[i] = integer;
        ++i;
    }
    var signature = LLVMFunctionType(integer, &parameters[0], 7, 0);
    var function = runtime_platform_declaration(module, "system_call", signature);
    if function == null {
        return false;
    }
    var assembly = "syscall";
    var constraints = "={ax},{ax},{di},{si},{dx},{r10},{r8},{r9},~{rcx},~{r11},~{memory},~{dirflag},~{fpsr},~{flags}";
    if arm {
        assembly = "svc 0";
        constraints = "={x0},{x8},{x0},{x1},{x2},{x3},{x4},{x5},~{memory}";
    }
    var instruction = LLVMGetInlineAsm(signature, assembly, strlen(assembly), constraints, strlen(constraints), 1, 0, 0, 0);
    var arguments: void*[7];
    i = 0;
    while i < 7 {
        arguments[i] = LLVMGetParam(function, i);
        ++i;
    }
    var builder = LLVMCreateBuilderInContext(context);
    LLVMPositionBuilderAtEnd(builder, LLVMAppendBasicBlockInContext(context, function, "entry"));
    var result = LLVMBuildCall2(builder, signature, instruction, &arguments[0], 7, "result");
    LLVMBuildRet(builder, result);
    var existing = LLVMGetNamedFunction(module, "_start");
    if existing != null {
        LLVMDisposeBuilder(builder);
        puts("Runtime entry is already defined");
        return false;
    }
    signature = LLVMFunctionType(LLVMVoidTypeInContext(context), null, 0, 0);
    function = LLVMAddFunction(module, "_start", signature);
    var kind = LLVMGetEnumAttributeKindForName("naked", 5);
    LLVMAddAttributeAtIndex(function, RuntimeFunctionAttributes, LLVMCreateEnumAttribute(context, kind, 0));
    LLVMPositionBuilderAtEnd(builder, LLVMAppendBasicBlockInContext(context, function, "entry"));
    assembly = "xor %rbp, %rbp\n\tand $$-16, %rsp\n\tcall tower_start";
    constraints = "~{dirflag},~{fpsr},~{flags}";
    if arm {
        assembly = "bl tower_start";
        constraints = "";
    }
    instruction = LLVMGetInlineAsm(signature, assembly, strlen(assembly), constraints, strlen(constraints), 1, 0, 0, 0);
    LLVMBuildCall2(builder, signature, instruction, null, 0, "");
    LLVMBuildUnreachable(builder);
    LLVMDisposeBuilder(builder);
    return true;
}

export fn runtime_platform(context: void*, module: void*, profile: u8*): bool {
    var target = LLVMGetTarget(module);
    if strcmp(profile, "wasm32") == 0 {
        var valid = strcmp(target, "wasm32-unknown-unknown") == 0;
        if valid {
            return runtime_platform_wasm(context, module);
        }
    }
    if strcmp(profile, "linux-x64") == 0 {
        var valid = strcmp(target, "x86_64-unknown-linux-gnu") == 0;
        if valid {
            return runtime_platform_linux(context, module, false);
        }
    }
    if strcmp(profile, "linux-arm64") == 0 {
        var valid = strcmp(target, "aarch64-unknown-linux-gnu") == 0;
        if valid {
            return runtime_platform_linux(context, module, true);
        }
    }
    puts("Unsupported runtime platform or target/profile mismatch");
    return false;
}
