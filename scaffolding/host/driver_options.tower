import tower;

// CLI parsing owns its link array and borrows argv/default-target strings.
// Keep option ordering and early --help behavior of the original native driver.
import driver_types;
import driver_link_flags;
import .library.work_pool;

fn driver_equal(a: u8*, b: u8*): bool {
    var index: usize = 0;
    loop {
        if a[index] != b[index] {
            return false;
        }
        if a[index] == 0 {
            return true;
        }
        index++;
    }
    return false;
}

export fn driver_help(): u8* {
    return "towerc source.tower -o output [--target triple|roku] [--emit object|llvm|llvm-optimized|exe|bytecode|foundation|source|c|brightscript]\n  [--unit library-source.tower] [--jobs count] [--link object-or-library] [--cc clang] [--linker tool] [--sysroot path]\n  [--raw-ir file] [--optimized-ir file] [--no-optimize] [--strip-comments] [--interpret|--interpret-fast] [--library] [--timings]\n  [--bedrock file] [--foundation file] [--depfile file] [--check-format] [--help] [--version]\n  towerc --link-executable input.o --link other.o --link library.so -o executable [--target linux-gnu-triple] [--sysroot path] [--jobs count]\n";
}

export fn driver_version(): u8* {
    return "Tower development (Tower-built compiler; external LLVM; not a portable release)\n";
}

export fn driver_dispose(options: DriverOptions*): void {
    free(options.links);
    options.links = null;
    options.link_count = 0;
    free(options.units);
    options.units = null;
    options.unit_count = 0;
}

fn driver_jobs(text: u8*): usize {
    var value: usize = 0;
    var zero: u8 = 48;
    var nine: u8 = 57;
    var radix: usize = 10;
    for (var i: usize = 0; text[i] != 0; i++) {
        if text[i] < zero || text[i] > nine { return 0; }
        var digit = convert(usize, text[i] - zero);
        if value > (WorkPoolMaximumCapacity - digit) / radix { return 0; }
        value = value * radix + digit;
    }
    return value;
}

export fn driver_parse(options: DriverOptions*, argc: usize, argv: u8**, target: u8*): bool {
    options.source = "";
    options.output = "";
    options.target = target;
    options.emit = "exe";
    options.cc = "clang";
    options.linker = "";
    options.sysroot = "";
    options.raw = "";
    options.optimized = "";
    options.bedrock = "";
    options.foundation = "";
    options.depfile = "";
    options.links = null;
    options.link_count = 0;
    options.units = null;
    options.unit_count = 0;
    options.jobs = 0;
    options.optimize = true;
    options.interpret = false;
    options.library = false;
    options.timings = false;
    options.help = false;
    options.version = false;
    options.fast = false;
    options.error = convert(u32, DriverOptionError.None);
    options.argument = "";
    options.comments = true;
    options.check_format = false;
    options.link_executable = false;
    var index: usize = 1;
    loop {
        if index >= argc {
            return true;
        }
        var arg = argv[index];
        index++;
        if driver_equal(arg, "--help") {
            options.help = true;
            return true;
        }
        if driver_equal(arg, "--version") {
            options.version = true;
            return true;
        }
        if driver_equal(arg, "--no-optimize") {
            options.optimize = false;
            continue;
        }
        if driver_equal(arg, "--link-executable") { options.link_executable = true; continue; }
        if driver_equal(arg, "--check-format") {
            options.check_format = true;
            options.emit = "source";
            continue;
        }
        if driver_equal(arg, "--strip-comments") {
            options.comments = false;
            continue;
        }
        if driver_equal(arg, "--interpret") {
            options.interpret = true;
            options.fast = false;
            continue;
        }
        if driver_equal(arg, "--interpret-fast") {
            options.interpret = true;
            options.fast = true;
            continue;
        }
        if driver_equal(arg, "--timings") {
            options.timings = true;
            continue;
        }
        if driver_equal(arg, "--library") {
            options.library = true;
            options.emit = "object";
            continue;
        }
        var slot: u8** = null;
        if driver_equal(arg, "-o") {
            slot = &options.output;
        }
        if driver_equal(arg, "--target") {
            slot = &options.target;
        }
        if driver_equal(arg, "--emit") {
            slot = &options.emit;
        }
        if driver_equal(arg, "--cc") {
            slot = &options.cc;
        }
        if driver_equal(arg, "--linker") {
            slot = &options.linker;
        }
        if driver_equal(arg, "--sysroot") {
            slot = &options.sysroot;
        }
        if driver_equal(arg, "--raw-ir") {
            slot = &options.raw;
        }
        if driver_equal(arg, "--optimized-ir") {
            slot = &options.optimized;
        }
        if driver_equal(arg, "--bedrock") {
            slot = &options.bedrock;
        }
        if driver_equal(arg, "--foundation") {
            slot = &options.foundation;
        }
        if driver_equal(arg, "--depfile") {
            slot = &options.depfile;
        }
        var link = driver_equal(arg, "--link");
        var unit = driver_equal(arg, "--unit");
        var jobs = driver_equal(arg, "--jobs");
        var valued = slot != null;
        if link || unit || jobs {
            valued = true;
        }
        if valued {
            if index == argc {
                options.error = convert(u32, DriverOptionError.MissingValue);
                options.argument = arg;
                return false;
            }
            var value = argv[index];
            index++;
            if link || unit {
                var inputs = unit ? &options.units : &options.links;
                var count = unit ? &options.unit_count : &options.link_count;
                if *inputs == null {
                    // argc bounds the number of link values. One allocation;
                    // failure leaves the options safely disposable.
                    *inputs = alloc(u8*, argc);
                    if *inputs == null {
                        options.error = convert(u32, DriverOptionError.Allocation);
                        options.argument = arg;
                        return false;
                    }
                }
                (*inputs)[*count] = value;
                (*count)++;
            } else {
                if jobs {
                    options.jobs = driver_jobs(value);
                    if options.jobs == 0 {
                        options.error = convert(u32, DriverOptionError.Jobs);
                        options.argument = value;
                        return false;
                    }
                } else { *slot = value; }
            }
            continue;
        }
        var option = arg[0] == 45;
        var have_source = options.source[0] != 0;
        if options.link_executable && (have_source || (option && driver_native_link_option(arg))) && (!option || driver_native_link_option(arg)) {
            if options.links == null { options.links = alloc(u8*, argc); }
            if options.links == null { options.error = convert(u32, DriverOptionError.Allocation); options.argument = arg; return false; }
            options.links[options.link_count++] = arg; continue;
        }
        var unexpected = option;
        if have_source {
            unexpected = true;
        }
        if unexpected {
            options.error = convert(u32, DriverOptionError.Unexpected);
            options.argument = arg;
            return false;
        }
        options.source = arg;
    }
    return true;
}
