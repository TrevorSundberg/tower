import tower;
import ide_types;
import ide_api;
import ide_state;
import ide_text;
import ide_syntax;
import .compiler.syntax_session_types;
import .compiler.syntax_types;
import .library.bytes_types;
import .library.bytes_interface;
import .library.vector;
import .compiler.format_types;

fn ide_grammar(out: ByteBuffer*, syntax: void*, query: void*): void {
    var count = syntax_session_rule_count(syntax);
    var json = out != null;
    if json {
        ide_text(out, ",\"rules\":[");
    }
    var i: usize = 0;
    for(; i < count; i++) {
        var rule = syntax_session_rule(syntax, i);
        if json {
            ide_comma(out, i);
            ide_text(out, "{\"name\":");
            ide_quote_bytes(out, rule.name, rule.name_length);
            ide_key(out, "definition");
            var definition: FormatResult = default;
            defer format_dispose(&definition);
            ide_require(syntax_session_rule_format(syntax, i, &definition));
            ide_quote_bytes(out, definition.text.data, definition.text.length);
            ide_key(out, "pending");
            ide_bool(out, syntax_session_rule_pending(syntax, i));
            ide_text(out, "}");
        } else {
            completion_offer(query, rule.name, "type", "grammar rule", 2);
        }
    }
    count = syntax_session_keyword_count(syntax);
    if json {
        ide_text(out, "],\"keywords\":[");
    }
    i = 0;
    for(; i < count; i++) {
        if json {
            ide_comma(out, i);
            ide_quote(out, syntax_session_keyword(syntax, i));
        }
        else {
            completion_offer(query, syntax_session_keyword(syntax, i), "keyword", "active grammar", 0);
        }
    }
    count = syntax_session_token_count(syntax);
    if json {
        ide_text(out, "] ,\"tokens\":[");
    }
    i = 0;
    for(; i < count; i++) {
        var item = syntax_session_token(syntax, i);
        if json {
            ide_comma(out, i);
            ide_text(out, "{\"name\":");
            ide_quote_bytes(out, item.name.data, item.name.length);
            ide_key(out, "pattern");
            ide_quote_bytes(out, item.text.data, item.text.length);
            ide_key(out, "kind");
            ide_quote_bytes(out, item.style.data, item.style.length);
            ide_key(out, "skip");
            ide_bool(out, item.kind == convert(u32, SyntaxKind.Skip));
            ide_key(out, "contextual");
            ide_bool(out, item.contextual);
            ide_text(out, "}");
        } else {
            if item.kind != convert(u32, SyntaxKind.Skip) {
                completion_offer(query, item.name.data, "type", "token rule", 2);
            }
        }
    }
    if json {
        ide_text(out, "]");
    }
}

fn ide_status(out: ByteBuffer*, syntax: void*, status: u8*): void {
    ide_assign(out, "{\"status\":");
    ide_quote(out, status);
    ide_field(out, "revision", syntax_get_revision(syntax));
    ide_field(out, "offset", ide_syntax_session(syntax).cursor);
    ide_string(out, "error", syntax_get_error(syntax));
    ide_field(out, "errorOffset", syntax_get_error_offset(syntax));
    if ide_syntax_session(syntax).error_insertion {
        ide_field(out, "errorLength", 0);
    }
}

fn ide_parser_create(source: u8*, bytes: usize, mode: u32): u32 {
    if !ide_valid(source, bytes) {
        return 0;
    }
    var state = ide_state();
    if host_handles_count(&state.handles, 0) >= 32 {
        ide_error("Too many open parser sessions");
        return 0;
    }
    var copy = ide_copy(source, bytes);
    var syntax = syntax_completion_create(copy, mode);
    free(copy);
    var error = syntax_get_error(syntax);
    var reject = mode == 0;
    reject &&= error[0] != 0;
    if reject {
        ide_error(error);
        syntax_destroy(syntax);
        return 0;
    }
    var session = alloc(IdeParser, 1);
    var failed = session == null;
    if failed {
        syntax_destroy(syntax);
        ide_error("Cannot allocate parser handle");
        return 0;
    }
    *session = default;
    session.syntax = syntax;
    var handle = host_handles_insert(&state.handles, 0, bits(void*, session));
    failed = handle == 0;
    if failed {
        syntax_destroy(syntax);
        free(session);
        ide_error("Cannot allocate parser handle");
    }
    return handle;
}

export fn tw_create(source: u8*, bytes: usize): u32 {
    return ide_parser_create(source, bytes, 0);
}

export fn tw_create_foundation(source: u8*, bytes: usize): u32 {
    return ide_parser_create(source, bytes, 1);
}

export fn tw_create_bedrock(source: u8*, bytes: usize): u32 {
    return ide_parser_create(source, bytes, 2);
}

export fn tw_destroy(handle: u32): void {
    var state = ide_state();
    var session = bits(IdeParser*, host_handles_take(&state.handles, 0, handle));
    if session == null {
        return;
    }
    syntax_destroy(session.syntax);
    bytes_dispose(&session.response);
    free(session);
}

export fn tw_reset(handle: u32, source: u8*, bytes: usize): i32 {
    if !ide_valid(source, bytes) {
        return 0;
    }
    var session = ide_parser(handle);
    if session == null {
        ide_error("Invalid session handle");
        return 0;
    }
    var copy = ide_copy(source, bytes);
    syntax_reset(session.syntax, copy, null);
    free(copy);
    session.response.length = 0;
    var error = syntax_get_error(session.syntax);
    if error[0] != 0 {
        ide_error(error);
        return 0;
    }
    return 1;
}

export fn tw_inspect(handle: u32): u8* {
    var session = ide_parser(handle);
    if session == null {
        return "{\"status\":\"error\",\"error\":\"Invalid session handle\"}";
    }
    var out = &session.response;
    var error = syntax_get_error(session.syntax);
    var failed = error[0] != 0;
    var status: u8* = "snapshot";
    if failed {
        status = "error";
    }
    ide_status(out, session.syntax, status);
    var stats = &ide_syntax_session(session.syntax).cache.index;
    ide_field(out, "grammarBuilds", stats.builds);
    ide_field(out, "grammarCacheHits", stats.hits);
    ide_field(out, "cachedGrammars", stats.entries.length);
    ide_grammar(out, session.syntax, null);
    var listing: SyntaxHighlights = default;
    defer syntax_highlights_dispose(&listing);
    ide_require(syntax_session_lexemes(session.syntax, &listing));
    ide_text(out, ",\"highlights\":[");
    var emitted: usize = 0;
    foreach (var &span in &listing.items) {
        if span.kind[0] == 0 { continue; }
        ide_comma(out, emitted++);
        ide_text(out, "{\"start\":");
        ide_number(out, span.start);
        ide_field(out, "end", span.end);
        ide_field(out, "revision", span.revision);
        ide_key(out, "kind");
        ide_quote(out, span.kind);
        ide_text(out, "}");
    }
    ide_text(out, "]}");
    return ide_result(out);
}

fn ide_spans(out: ByteBuffer*, spans: FormatSpan*, count: usize): void {
    ide_text(out, ",\"spans\":[");
    var i: usize = 0;
    for(; i < count; i++) {
        var span = &spans[i];
        ide_comma(out, i);
        ide_text(out, "{\"begin\":");
        ide_number(out, span.begin);
        ide_field(out, "end", span.end);
        ide_field(out, "source", span.source);
        ide_text(out, "}");
    }
    ide_text(out, "]");
}

export fn tw_format(handle: u32): u8* {
    var session = ide_parser(handle);
    if session == null {
        return "{\"error\":\"Invalid session handle\"}";
    }
    var out = &session.response;
    ide_assign(out, "{");
    var syntax = ide_syntax_session(session.syntax);
    if syntax.error.length != 0 || !syntax.finalized {
        ide_text(out, "\"error\":\"Formatting requires a complete, valid source document\"}");
        return ide_result(out);
    }
    var formatted: FormatResult = default;
    defer format_dispose(&formatted);
    var error: u8* = "";
    syntax_format_into(session.syntax, &formatted, &error);
    if error[0] != 0 {
        ide_text(out, "\"error\":");
        ide_quote(out, error);
    }
    else {
        ide_text(out, "\"source\":");
        ide_quote_bytes(out, formatted.text.data, formatted.text.length);
        ide_spans(out, formatted.spans.data, formatted.spans.length);
    }
    ide_text(out, "}");
    return ide_result(out);
}
