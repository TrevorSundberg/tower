import tower;
import '../compiler/host-text';
import '../library/bytes-interface';
import '../library/bytes-types';

// Ide transport policies. These consume borrowed values from the compiler;
// JSON is not a second semantic model or a Tower interchange format.
extern fn tower_utf8_validate(source: u8*, count: usize, reject_nul: u32): u32;

export fn tw_abi_version(): u32 {
    return 3;
}

export fn tw_alloc(count: usize): u8* {
    return alloc(u8, count);
}

export fn tw_free(pointer: u8*): void {
    free(pointer);
}

export fn host_source_error(source: u8*, count: usize): u8* {
    var large = count > 8388608;
    if large {
        return "Compilation source limit is 8 MiB";
    }
    var missing = source == null;
    if missing {
        return "Source must be valid UTF-8 without NUL bytes";
    }
    var valid = tower_utf8_validate(source, count, 1) != 0;
    if valid {
        return "";
    }
    return "Source must be valid UTF-8 without NUL bytes";
}

fn host_protocol_text(out: ByteBuffer*, text: u8*): bool {
    var count: usize = 0;
    loop {
        var done = text[count] == 0;
        if done {
            break;
        }
        count++;
    }
    return bytes_append(out, text, count);
}

// On allocation failure callers must discard the partial response. IDE transport
// retains the existing abort-on-transport-allocation-failure policy.
export fn host_execution_json(out: ByteBuffer*, error: u8*, error_count: usize, offset: usize, done: bool, output: u8*, output_count: usize, steps: u64, truncated: bool): bool {
    out.length = 0;
    var status: u8* = "executing";
    if done {
        status = "done";
    }
    var failed = error_count != 0;
    if failed {
        status = "error";
    }
    var ok = host_protocol_text(out, "{\"status\":\"");
    ok &&= host_protocol_text(out, status);
    ok &&= host_protocol_text(out, "\",\"error\":");
    ok &&= host_json_quote(out, error, error_count);
    ok &&= host_protocol_text(out, ",\"errorOffset\":");
    if ok {
        var wide = convert(u64, offset);
        ok = host_json_unsigned(out, wide);
    }
    ok &&= host_protocol_text(out, ",\"outputBytes\":[");
    var i: usize = 0;
    loop {
        var end = i == output_count;
        if end {
            break;
        }
        if !ok {
            break;
        }
        var comma = i != 0;
        if comma {
            ok = bytes_push(out, 44);
        }
        if ok {
            var byte = convert(u64, output[i]);
            ok = host_json_unsigned(out, byte);
        }
        i++;
    }
    ok &&= host_protocol_text(out, "],\"steps\":");
    ok &&= host_json_unsigned(out, steps);
    if ok {
        if truncated {
            ok = host_protocol_text(out, ",\"outputTruncated\":true}");
        } else {
            ok = host_protocol_text(out, ",\"outputTruncated\":false}");
        }
    }
    return ok;
}
