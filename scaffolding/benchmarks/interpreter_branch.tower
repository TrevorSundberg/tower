import foundation;

var iterations: i32 = 10000;
var period: i32 = 7;
var threshold: i32 = 3;
var i = 0;
var sum = 0;
loop {
    var stop = i == iterations;
    if stop { break; }
    var rem = i % period;
    var low = rem < threshold;
    if low { sum = sum + 1; }
    else { sum = sum - 1; }
    i = i + 1;
}
print(sum);
