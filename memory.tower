import tower;

// Raw buffers and views are ordinary structs. There are no implicit bounds checks.
struct Bytes {
    data: u8*;
    length: usize;
    capacity: usize;
}

var InitialByteCapacity: usize = 8;
var TextLength: usize = 5;

// realloc may move the buffer. Keep its old address until growth succeeds;
// on failure it still owns its old storage and the caller can safely free it.
fn append(buffer: Bytes*, value: u8): bool {
    if buffer.length == buffer.capacity {
        var maximum = ~convert(usize, 0);
        if buffer.capacity > maximum / 2 {
            return false;
        }
        var capacity = buffer.capacity == 0 ? InitialByteCapacity: buffer.capacity *2;
        var grown = realloc(u8, buffer.data, capacity);
        if grown is null {
            return false;
        }
        buffer.data = grown;
        buffer.capacity = capacity;
    }
    buffer.data[buffer.length] = value;
    buffer.length++;
    return true;
}

// Zero initialization creates an empty buffer; append allocates on first use.
var buffer: Bytes = default;
var text: u8* = "Tower";
for (var i: usize = 0; i < TextLength; i++) {
    if !append(&buffer, text[i]) {
        print("Byte buffer allocation failed");
        break;
    }
}
print(buffer.length);
if buffer.length != 0 {
    print(buffer.data[0]);
}
var fixed: i32[3];
fixed[0] = 10;
fixed[1] = 20;
fixed[2] = 12;
var values: i32* = &fixed[0];
print(values[0] + values[1] + values[2]);
free(buffer.data);
