// Raw buffers and views are ordinary structs. There are no implicit bounds checks.
struct Bytes { data: u8*; length: usize; capacity: usize; }
fn append(buffer: Bytes*, value: u8): void {
    var full: bool = buffer.length == buffer.capacity;
    if full {
        var capacity: usize = buffer.capacity * 2;
        var empty: bool = capacity == 0;
        if empty { capacity = 8; }
        buffer.data = realloc(u8, buffer.data, capacity);
        buffer.capacity = capacity;
    }
    buffer.data[buffer.length] = value;
    buffer.length = buffer.length + 1;
}
var buffer: Bytes;
buffer.data = null;
buffer.length = 0;
buffer.capacity = 0;
var ref: Bytes* = &buffer;
var text: u8* = "Tower";
var i: usize = 0;
loop {
    var done: bool = i == 5;
    if done { break; }
    append(ref, text[i]);
    i = i + 1;
}
print(buffer.length);
print(buffer.data[0]);
var fixed: i32[3];
fixed[0] = 10;
fixed[1] = 20;
fixed[2] = 12;
var values: i32* = &fixed[0];
var result: i32 = values[0] + values[1];
result = result + values[2];
print(result);
free(buffer.data);
