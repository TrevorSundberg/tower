import tower;

// Type and integer arguments determine the fields of a concrete struct.
fn buffer(T: type, size: usize): type {
    struct Result {
        data: T[size];
    }
    return Result;
}

fn stack(T: type): type {
    struct Result {
        // Four inline slots are enough for the two sample values below.
        storage: buffer(T, 4);
        count: usize;
    }
    return Result;
}

// This small example assumes there is space to push and a value to pop.
fn push(T: type, values: stack(T)*, value: T): void {
    values.storage.data[values.count] = value;
    values.count++;
}

fn pop(T: type, values: stack(T)*): T {
    values.count--;
    return values.storage.data[values.count];
}

// This stack stores its fixed array inline; it never allocates heap memory.
var values: stack(i32) = default;
// The typed stack argument lets Tower infer T = i32 for these calls.
push(&values, 10);
push(&values, 20);
print(pop(&values));
print(pop(&values));
