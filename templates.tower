// Type and integer arguments determine the fields of a concrete struct.
fn buffer(T: type, size: usize): type {
    struct Result {
        data: T[size];
    }
    return Result;
}

fn stack(T: type): type {
    struct Result {
        storage: buffer(T, 4);
        count: usize;
    }
    return Result;
}

// This small example assumes there is space to push and a value to pop.
fn push(T: type, values: stack(T)*, value: T): void {
    values.storage.data[values.count] = value;
    values.count = values.count + 1;
}

fn pop(T: type, values: stack(T)*): T {
    values.count = values.count - 1;
    return values.storage.data[values.count];
}

var values: stack(i32);
values.count = 0;
push(i32, &values, 10);
push(i32, &values, 20);
print(pop(i32, &values));
print(pop(i32, &values));
