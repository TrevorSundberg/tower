+// Nominal integer representations and members survive Foundation round trips.
+// Tower may add automatic discriminants; canonical Foundation makes each explicit.
+parse CoreEnumInteger = Number | '-' Number;
+parse CoreEnumMember = $name:Identifier '=' $value:CoreEnumInteger;
+parse CoreEnumMembers = CoreEnumMember | CoreEnumMembers ',' CoreEnumMember;
+parse CoreEnum = 'enum' $name:Identifier ':' $type:CoreType '{' $fields:CoreEnumMembers ','? '}';
+parse Statement |= CoreEnum;
+
+// Raw memory and external symbols; safety policies can be layered above these.
+parse CoreExternal = 'extern' 'fn' $name:Identifier '(' $params:CoreParameters? ')' ':' $type:CoreType ';';
+parse CoreExport = 'export' 'fn' $name:Identifier '(' $params:CoreParameters? ')' ':' $type:CoreType $body:CoreBlock;
