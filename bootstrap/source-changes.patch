+parse CoreTypeArgument = CoreType | Number | '-' Number;
+parse CoreTypeArguments = CoreTypeArgument | CoreTypeArguments ',' CoreTypeArgument;
+parse CoreLocation = $name:Identifier | $base:CoreLocation '.' $field:Identifier;
+parse CoreOperand = CoreLocation | Number | '-' Number | FloatNumber | '-' FloatNumber | 'true' | 'false' | 'null' | String;
