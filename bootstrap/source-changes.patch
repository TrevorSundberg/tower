                   | CoreFunction | CoreReturn | CoreStruct | CoreEnum | CoreExternal | CoreExport
-                  | TowerConstant | TowerExportedConstant | TowerMatch | TowerWhile | TowerExpressionStatement;
+                  | TowerConstant | TowerExportedConstant | TowerMatch | TowerWhile | TowerFor | TowerExpressionStatement;
