import tower;

// Explicitly owned ring buffer. Push/pop currently support scalar/pointer T.
// Growth preserves FIFO order, and invalidates all borrowed element pointers.
// Initialize once, dispose once. Direct field mutation must preserve invariants.
fn queue(T: type): type {
    struct Result {
        data: T*;
        length: usize;
        capacity: usize;
        head: usize;
    }
    return Result;
}

fn queue_init(T: type, value: queue(T)*): void {
    value.data = null;
    value.length = 0;
    value.capacity = 0;
    value.head = 0;
}

fn queue_reserve(T: type, value: queue(T)*, needed: usize): bool {
    if needed <= value.capacity {
        return true;
    }
    var size = sizeof(T);
    if size == 0 {
        return false;
    }
    var maximum: usize = 0;
    maximum--;
    var limit = maximum / size;
    if needed > limit {
        return false;
    }
    var capacity = value.capacity *2;
    if capacity < value.capacity {
        capacity = needed;
    }
    var small = capacity < 8;
    if small {
        capacity = 8;
    }
    small = capacity < needed;
    if small {
        capacity = needed;
    }
    if capacity > limit {
        capacity = needed;
    }
    var next = alloc(T, capacity);
    if next == null {
        return false;
    }
    var i: usize = 0;
    var at = value.head;
    for(; i != value.length; i++) {
        next[i] = value.data[at];
        at++;
        if at == value.capacity {
            at = 0;
        }
    }
    free(value.data);
    value.data = next;
    value.capacity = capacity;
    value.head = 0;
    return true;
}

fn queue_push(T: type, value: queue(T)*, element: T): bool {
    var needed = value.length + 1;
    if needed == 0 {
        return false;
    }
    if !queue_reserve(value, needed) {
        return false;
    }
    // Avoid head + length overflowing even for a maximum-width capacity.
    var remaining = value.capacity -value.head;
    var at: usize = 0;
    if value.length >= remaining {
        at = value.length - remaining;
    } else {
        at = value.head + value.length;
    }
    value.data[at] = element;
    value.length = needed;
    return true;
}

// Output must be valid T storage outside remaining live elements. Failure
// (empty queue or null output) changes neither the queue nor the output.
fn queue_pop(T: type, value: queue(T)*, output: T*): bool {
    var empty = value.length == 0;
    if empty {
        return false;
    }
    if output == null {
        return false;
    }
    *output = value.data[value.head];
    value.head++;
    value.length--;
    empty = value.length == 0;
    var end = value.head == value.capacity;
    if empty {
        end = true;
    }
    if end {
        value.head = 0;
    }
    return true;
}

fn queue_dispose(T: type, value: queue(T)*): void {
    free(value.data);
    queue_init(value);
}

fn queue_move(T: type, destination: queue(T)*, source: queue(T)*): void {
    if destination == source {
        return;
    }
    queue_dispose(destination);
    destination.data = source.data;
    destination.length = source.length;
    destination.capacity = source.capacity;
    destination.head = source.head;
    queue_init(source);
}

// A finite FIFO view. Structural mutation of the owner invalidates this borrow.
// The initial head/length/capacity are captured once, with no hidden allocation.
fn queue_iteration(T: type): type {
    struct Result {
        data: T*;
        remaining: usize;
        capacity: usize;
        position: usize;
        current: usize;
    }
    return Result;
}

fn queue_iterate_begin(T: type, source: queue(T)*, state: queue_iteration(T)*): void {
    state.data = source.data;
    state.remaining = source.length;
    state.capacity = source.capacity;
    state.position = source.head;
    state.current = source.head;
}

fn queue_iterate_next(T: type, source: queue(T)*, state: queue_iteration(T)*): bool {
    if state.remaining == 0 {
        return false;
    }
    state.current = state.position;
    state.position++;
    if state.position == state.capacity {
        state.position = 0;
    }
    state.remaining--;
    return true;
}

fn queue_iterate_element(T: type, source: queue(T)*, state: queue_iteration(T)*): T* {
    return &state.data[state.current];
}

fn queue_iterate_end(T: type, source: queue(T)*, state: queue_iteration(T)*): void {}
