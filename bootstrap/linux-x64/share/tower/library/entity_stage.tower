import tower;
import entities;
import entity_types;
import work_vector;
import work_vector_types;
import work_budget_types;

// A worker owns these actual canonical entities, not a shadow graph or commands
// containing another node model. Existing parent links and dense type indexes
// remain unchanged until the coordinator publishes after all readers join.
struct EntityStage {
    anchor: Entity*;
    nodes: work_vector(EntityStageNode);
    references: work_vector(Entity*);
    held: usize;
    cancellations: work_vector(EntityStageCancellation);
    leases: work_vector(EntityStageLease);
    storage: EntityComponentPool;
    buffers: EntityComponentPool;
}

// One complete payload's pending references. Context and borrowed fields stay
// private and address-stable until hold/publication or discard, after join.
struct EntityStageCancellation {
    first: usize;
    stop: usize;
    cancel: function(void, void*);
    context: void*;
}

struct EntityStageNode {
    node: Entity*;
    name: u8*;
}

// Private stages publish their descriptor pages intact, including unused slots.
var EntityStageInitialDescriptorRows: usize = 8;

struct EntityStageLease {
    node: Entity*;
    components: usize;
}

struct EntityStageCount {
    entity: Entity*;
    children: usize;
    instances: usize;
}

export fn entity_stage_open(anchor: Entity*): EntityStage* {
    var error: WorkBudgetError;
    return entity_stage_open_result(anchor, &error);
}

// Coordinator-only lifetime acquisition. The required result belongs to this
// call, never to a shared store error slot or another worker's stage.
export fn entity_stage_open_result(anchor: Entity*, error: WorkBudgetError*): EntityStage* {
    if error == null { return null; }
    *error = WorkBudgetError.Invalid;
    if anchor == null || anchor.stage != null { return null; }
    if anchor.store.reclaiming != 0 { *error = WorkBudgetError.Busy; return null; }
    if anchor.references == ~convert(usize, 0) { *error = WorkBudgetError.Exhausted; return null; }
    var stage = entity_owned_allocate_result(EntityStage, &anchor.store.buffers, anchor.store.budget, 1, error);
    if stage == null { return null; }
    *stage = default;
    stage.anchor = anchor;
    entity_retain(anchor);
    *error = WorkBudgetError.None;
    return stage;
}

// The stage owner may enumerate its private leases before publication.
export fn entity_stage_lease_at(stage: EntityStage*, index: usize): Entity* {
    return index < stage.leases.length ? stage.leases.data[index].node : null;
}

// Coordinator-only, before pinning. The scheduler must own exclusive access to
// this entity's component list and writable payloads for the entire lease. Its
// existing identity/containment/type indexes remain published and stable. New
// attachments are visible through this owner's lookup only, not typed queries.
export fn entity_stage_lease(stage: EntityStage*, node: Entity*): bool {
    return entity_stage_lease_result(stage, node) == WorkBudgetError.None;
}

export fn entity_stage_lease_result(stage: EntityStage*, node: Entity*): WorkBudgetError {
    if stage == null || stage.anchor == null || node == null
        || node.store != stage.anchor.store || node.registered { return WorkBudgetError.Invalid; }
    // A finalizer may operate on separately owned live entities. It may never
    // lease the zero-reference entity currently being reclaimed.
    if node.store.views != 0 || (node.store.reclaiming != 0 && node.references == 0) { return WorkBudgetError.Busy; }
    if node.stage == bits(void*, stage) { return WorkBudgetError.None; }
    if node.stage != null { return WorkBudgetError.Busy; }
    if stage.leases.length >= ~convert(usize, 0) / sizeof(EntityStageLease) { return WorkBudgetError.Invalid; }
    var error = work_vector_reserve_result(&stage.leases, stage.anchor.store.budget, stage.leases.length + 1);
    if error != WorkBudgetError.None { return error; }
    var lease = &stage.leases.data[stage.leases.length];
    lease.node = node;
    lease.components = node.component_count;
    stage.leases.length++;
    node.stage = bits(void*, stage);
    node.storage = &stage.storage;
    return WorkBudgetError.None;
}

// Only the owning worker calls create/component_add on its staged nodes.
// No retain/release/attach/register/remove is permitted until publication.
// Queue payload-owned shared references with entity_stage_references instead.
export fn entity_stage_create(stage: EntityStage*, parent: Entity*): Entity* {
    var error: WorkBudgetError;
    return entity_stage_create_result(stage, parent, &error);
}

fn entity_stage_create_admission(stage: EntityStage*, parent: Entity*): WorkBudgetError {
    if stage == null || stage.anchor == null || parent == null
        || parent.store != stage.anchor.store { return WorkBudgetError.Invalid; }
    if parent.stage != null && parent.stage != bits(void*, stage) { return WorkBudgetError.Busy; }
    if stage.nodes.length >= ~convert(usize, 0) / sizeof(EntityStageNode) { return WorkBudgetError.Invalid; }
    return WorkBudgetError.None;
}

// The owning worker receives a private result; published store state is untouched.
export fn entity_stage_create_result(stage: EntityStage*, parent: Entity*, error: WorkBudgetError*): Entity* {
    if error == null { return null; }
    *error = entity_stage_create_admission(stage, parent);
    if *error != WorkBudgetError.None { return null; }
    *error = work_vector_reserve_result(&stage.nodes, stage.anchor.store.budget, stage.nodes.length + 1);
    if *error != WorkBudgetError.None { return null; }
    // Grow once when the first page's worth of nodes is live. Smaller stages
    // stay compact, and successive dense pages share the doubled row limit.
    var rows = EntityStageInitialDescriptorRows;
    if stage.nodes.length >= rows { rows *= 2; }
    var node = entity_owned_allocate_rows_result(Entity, &stage.buffers, parent.store.budget, 1,
        rows, error);
    // The larger page is optional under a finite byte budget. Keep the
    // original page grant admissible and propagate physical allocation errors.
    if node == null && *error == WorkBudgetError.Capacity && rows > EntityStageInitialDescriptorRows {
        node = entity_owned_allocate_rows_result(Entity, &stage.buffers, parent.store.budget, 1,
            EntityStageInitialDescriptorRows, error);
    }
    if node == null { return null; }
    *node = default;
    node.store = parent.store;
    node.references = 1;
    node.parent = parent; // Borrowed for provenance, not yet parent containment.
    node.stage = bits(void*, stage);
    node.storage = &stage.storage;
    stage.nodes.data[stage.nodes.length].node = node;
    stage.nodes.data[stage.nodes.length].name = null;
    stage.nodes.length++;
    *error = WorkBudgetError.None;
    return node;
}

fn entity_stage_count(counts: work_vector(EntityStageCount)*, node: Entity*): EntityStageCount* {
    var hash = bits(usize, node) / 16;
    hash ^= hash >> 16;
    var mask = counts.length - 1;
    var index = hash & mask;
    while counts.data[index].entity != null && counts.data[index].entity != node {
        index = (index + 1) & mask;
    }
    counts.data[index].entity = node;
    return &counts.data[index];
}

// Failure in preparation leaves all semantic identities/links/index lengths
// unchanged. Capacity may grow, so publication requires an unpinned store even
// when preparation fails. No fallible allocation remains after preparation.
fn entity_stage_prepare_result(stage: EntityStage*): WorkBudgetError {
    var store = stage.anchor.store;
    if store.views != 0 { return WorkBudgetError.Busy; }
    var result = entity_stage_names_result(stage);
    if result != WorkBudgetError.None { return result; }
    var count = stage.nodes.length;
    var maximum = ~convert(usize, 0);
    if count > maximum - store.next_id { return WorkBudgetError.Exhausted; }
    if count > maximum - store.entity_count { return WorkBudgetError.Invalid; }
    var components: usize = 0;
    for(var i: usize = 0; i < count; ++i) {
        var node = stage.nodes.data[i].node;
        if node.component_count > maximum - components { return WorkBudgetError.Invalid; }
        components += node.component_count;
    }
    for(var i: usize = 0; i < stage.leases.length; ++i) {
        var lease = &stage.leases.data[i];
        if lease.components > lease.node.component_count { return WorkBudgetError.Invalid; }
        var added = lease.node.component_count - lease.components;
        if added > maximum - components { return WorkBudgetError.Invalid; }
        components += added;
    }
    if count == 0 && components == 0 { return entity_stage_hold_result(stage); }
    if components > maximum - store.component_count { return WorkBudgetError.Invalid; }
    if components > maximum - count { return WorkBudgetError.Invalid; }
    var entries = components + count;
    if entries > maximum / 2 { return WorkBudgetError.Invalid; }
    var capacity: usize = 8;
    while capacity < entries * 2 {
        if capacity > maximum / 2 { return WorkBudgetError.Invalid; }
        capacity *= 2;
    }
    if capacity > maximum / sizeof(EntityStageCount) { return WorkBudgetError.Invalid; }
    var counts: work_vector(EntityStageCount) = default;
    result = work_vector_reserve_result(&counts, store.budget, capacity);
    if result != WorkBudgetError.None { return result; }
    defer work_vector_dispose(&counts);
    counts.length = capacity;
    fill(counts.data, 0, capacity * sizeof(EntityStageCount));
    for(var i: usize = 0; i < count; ++i) {
        var node = stage.nodes.data[i].node;
        entity_stage_count(&counts, node.parent).children++;
        for(var j: usize = 0; j < node.component_count; ++j) {
            entity_stage_count(&counts, node.components[j].type).instances++;
        }
    }
    for(var i: usize = 0; i < stage.leases.length; ++i) {
        var lease = &stage.leases.data[i];
        for(var j = lease.components; j < lease.node.component_count; ++j) {
            entity_stage_count(&counts, lease.node.components[j].type).instances++;
        }
    }
    for(var i: usize = 0; i < capacity && result == WorkBudgetError.None; ++i) {
        var entry = &counts.data[i];
        var node = entry.entity;
        if node == null { continue; }
        if entry.children > maximum - node.child_count
            || entry.instances > maximum - node.instance_count { result = WorkBudgetError.Invalid; break; }
        var children = node.child_count + entry.children;
        var instances = node.instance_count + entry.instances;
        if children > maximum / sizeof(EntityChild) || instances > maximum / sizeof(EntityComponent*) {
            result = WorkBudgetError.Invalid;
            break;
        }
        if children > node.child_capacity {
            result = entity_children_resize_result(node, children);
            if result != WorkBudgetError.None { break; }
        }
        if instances > node.instance_capacity {
            var memory = entity_buffer_resize_result(store.budget, node.instances, instances, node.instance_count, &result);
            if memory == null { break; }
            node.instances = memory;
            node.instance_capacity = instances;
        }
    }
    if result != WorkBudgetError.None { return result; }
    for(var i: usize = 0; result == WorkBudgetError.None && i < stage.nodes.length; i++) {
        result = entity_table_prepare_result(stage.nodes.data[i].node, null, null);
    }
    for(var i: usize = 0; result == WorkBudgetError.None && i < stage.leases.length; i++) {
        var lease = &stage.leases.data[i];
        // Staged component lists only append. Payload-only leases retain their
        // published membership and need no destination row reservation.
        if lease.node.component_count != lease.components {
            result = entity_table_prepare_result(lease.node, null, null);
        }
    }
    // Reserve type ownership together with queued payload ownership. A queued
    // target may itself be a component type; both increments share its limit.
    var reserved: usize = 0;
    if result == WorkBudgetError.None {
        while reserved < counts.length {
            var entry = &counts.data[reserved];
            if entry.entity != null {
                if entry.instances > maximum - entry.entity.references {
                    result = WorkBudgetError.Exhausted;
                    break;
                }
                entry.entity.references += entry.instances;
            }
            reserved++;
        }
        if result == WorkBudgetError.None { result = entity_stage_hold_result(stage); }
    }
    if result != WorkBudgetError.None {
        for(var i: usize = 0; i < reserved; i++) {
            var entry = &counts.data[i];
            if entry.entity != null { entry.entity.references -= entry.instances; }
        }
        foreach(var &entry in &stage.nodes) { entity_table_unprepare(entry.node); }
        foreach(var &lease in &stage.leases) { entity_table_unprepare(lease.node); }
    }
    return result;
}

fn entity_stage_components(node: Entity*, first: usize): void {
    for(var j = first; j < node.component_count; ++j) {
        var component = node.components[j];
        var type = component.type;
        component.type_index = type.instance_count;
        type.instances[type.instance_count] = component;
        type.instance_count++;
        // Preparation already reserved this component's type ownership.
        node.store.component_count++;
    }
}

export fn entity_stage_publish(stage: EntityStage*): bool {
    return entity_stage_publish_result(stage) == WorkBudgetError.None;
}

export fn entity_stage_publish_result(stage: EntityStage*): WorkBudgetError {
    if stage == null || stage.anchor == null { return WorkBudgetError.Invalid; }
    var result = entity_stage_prepare_result(stage);
    if result != WorkBudgetError.None { return result; }
    var store = stage.anchor.store;
    for(var i: usize = 0; i < stage.nodes.length; ++i) {
        var node = stage.nodes.data[i].node;
        node.id = store.next_id;
        store.next_id++;
        store.entity_count++;
        node.stage = null;
        node.storage = null;
        entity_stage_components(node, 0);
        entity_table_publish(node);
        // Transfer the stage's one reference into its parent's ownership.
        var parent = node.parent;
        parent.children[parent.child_count].entity = node;
        parent.children[parent.child_count].name = stage.nodes.data[i].name;
        parent.child_count++;
    }
    for(var i: usize = 0; i < stage.leases.length; ++i) {
        var lease = &stage.leases.data[i];
        lease.node.stage = null;
        lease.node.storage = null;
        if lease.node.component_count != lease.components {
            entity_stage_components(lease.node, lease.components);
            entity_table_publish(lease.node);
        }
    }
    work_vector_dispose(&stage.nodes);
    work_vector_dispose(&stage.references);
    work_vector_dispose(&stage.cancellations);
    work_vector_dispose(&stage.leases);
    entity_component_pool_transfer(&stage.storage, &store.storage);
    entity_component_pool_transfer(&stage.buffers, &store.buffers);
    var anchor = stage.anchor;
    entity_owned_free(stage);
    entity_release(anchor);
    return WorkBudgetError.None;
}

// Call only after the owning worker joins. Finalizers run on the coordinator;
// discarded payloads must not have escaped into an existing published payload.
export fn entity_stage_discard(stage: EntityStage*): void {
    if entity_stage_discard_result(stage) != WorkBudgetError.None { trap("Cannot discard unowned stage references", 0); }
}

// Cancellable payloads need no retain to discard. Legacy queue entries have no
// way to clear borrowed fields: acquire them first, or leave the entire stage
// intact with an exact error. Never invoke a finalizer on unowned references.
export fn entity_stage_discard_result(stage: EntityStage*): WorkBudgetError {
    if stage == null || stage.anchor == null || stage.held > stage.references.length { return WorkBudgetError.Invalid; }
    if stage.held != stage.references.length {
        var covered = stage.held;
        foreach(var &entry in &stage.cancellations) {
            if entry.stop <= stage.held { continue; }
            if entry.first != covered { break; }
            covered = entry.stop;
        }
        if covered != stage.references.length {
            var error = entity_stage_hold_result(stage);
            if error != WorkBudgetError.None { return error; }
        }
        foreach(var &entry in &stage.cancellations) {
            if entry.first >= stage.held { entry.cancel(entry.context); }
        }
    }
    for(var i: usize = 0; i < stage.nodes.length; ++i) {
        var node = stage.nodes.data[i].node;
        for(var j: usize = 0; j < node.component_count; ++j) {
            var component = node.components[j];
            if component.type.layout.lifecycle != 0 {
                tower_entity_finalize(component.type.layout.lifecycle, component, component.data);
            }
            entity_component_free(component);
        }
        entity_components_free(node);
        entity_children_free(node);
        entity_buffer_free(node.instances);
        entity_owned_free(stage.nodes.data[i].name);
        entity_owned_free(node);
    }
    for(var i: usize = 0; i < stage.leases.length; ++i) {
        var lease = &stage.leases.data[i];
        var node = lease.node;
        for(var j = lease.components; j < node.component_count; ++j) {
            var component = node.components[j];
            if component.type.layout.lifecycle != 0 {
                tower_entity_finalize(component.type.layout.lifecycle, component, component.data);
            }
            entity_component_free(component);
        }
        node.component_count = lease.components;
        node.stage = null;
        node.storage = null;
    }
    work_vector_dispose(&stage.nodes);
    work_vector_dispose(&stage.references);
    work_vector_dispose(&stage.cancellations);
    work_vector_dispose(&stage.leases);
    if stage.storage.owned != null || stage.buffers.owned != null { trap("Live discarded stage storage", 0); }
    var anchor = stage.anchor;
    entity_owned_free(stage);
    entity_release(anchor);
    return WorkBudgetError.None;
}

// Names are owned by the stage until publication transfers them into containment.
// Collision checks and shared parent updates happen only on the coordinator.
export fn entity_stage_create_named(stage: EntityStage*, parent: Entity*, name: u8*): Entity* {
    var error: WorkBudgetError;
    return entity_stage_create_named_result(stage, parent, name, &error);
}

export fn entity_stage_create_named_result(stage: EntityStage*, parent: Entity*, name: u8*, error: WorkBudgetError*): Entity* {
    if error == null { return null; }
    *error = entity_stage_create_admission(stage, parent);
    if *error != WorkBudgetError.None { return null; }
    if name == null || *name == 0 { return entity_stage_create_result(stage, parent, error); }
    var length: usize = 0;
    var maximum = ~convert(usize, 0);
    while name[length] != 0 && length != maximum { length++; }
    if length == maximum { *error = WorkBudgetError.Invalid; return null; }
    var owned = entity_owned_allocate_result(u8, &stage.buffers, stage.anchor.store.budget, length + 1, error);
    if owned == null { return null; }
    copy(owned, name, length + 1);
    var node = entity_stage_create_result(stage, parent, error);
    if node == null { entity_owned_free(owned); return null; }
    stage.nodes.data[stage.nodes.length - 1].name = owned;
    return node;
}

struct EntityStageNameIndex { parent: Entity*; name: u8*; }

fn entity_stage_names_result(stage: EntityStage*): WorkBudgetError {
    var count: usize = 0;
    foreach(var &entry in &stage.nodes) { if entry.name != null { count++; } }
    if count == 0 { return WorkBudgetError.None; }
    var maximum = ~convert(usize, 0);
    if count > maximum / 2 { return WorkBudgetError.Invalid; }
    var capacity: usize = 4;
    while capacity < count * 2 {
        if capacity > maximum / 2 { return WorkBudgetError.Invalid; }
        capacity *= 2;
    }
    if capacity > maximum / sizeof(EntityStageNameIndex) { return WorkBudgetError.Invalid; }
    var error: WorkBudgetError;
    var names = entity_buffer_resize_result(EntityStageNameIndex, stage.anchor.store.budget, null, capacity, 0, &error);
    if names == null { return error; }
    defer entity_buffer_free(names);
    fill(names, 0, capacity * sizeof(EntityStageNameIndex));
    var mask = capacity - 1;
    foreach(var &entry in &stage.nodes) {
        if entry.name == null { continue; }
        var parent = entry.node.parent;
        if entity_member_index(parent, entry.name) < parent.child_count { return WorkBudgetError.Invalid; }
        var hash = bits(usize, parent) / sizeof(Entity*);
        for(var i: usize = 0; entry.name[i] != 0; i++) { hash = (hash * 33) ^ convert(usize, entry.name[i]); }
        var index = hash & mask;
        while names[index].parent != null {
            if names[index].parent == parent && entity_name_equal(names[index].name, entry.name) {
                return WorkBudgetError.Invalid;
            }
            index = (index + 1) & mask;
        }
        names[index].parent = parent;
        names[index].name = entry.name;
    }
    return WorkBudgetError.None;
}

// Queue exactly the references owned by completed private payloads. Their
// ordinary finalizers release these references on destruction/discard. Inputs
// must remain live until hold: keep their source owner alive or retain the pin.
// The worker only changes its stage; it never touches shared reference counts.
export fn entity_stage_references(stage: EntityStage*, nodes: Entity**, count: usize): bool {
    return entity_stage_references_result(stage, nodes, count) == WorkBudgetError.None;
}

export fn entity_stage_references_result(stage: EntityStage*, nodes: Entity**, count: usize): WorkBudgetError {
    return entity_stage_references_record_result(stage, nodes, count, null, null);
}

fn entity_stage_references_record_result(stage: EntityStage*, nodes: Entity**, count: usize,
    cancel: function(void, void*), context: void*): WorkBudgetError {
    if stage == null || stage.anchor == null || (count != 0 && nodes == null)
        || count > ~convert(usize, 0) - stage.references.length { return WorkBudgetError.Invalid; }
    var needed = stage.references.length + count;
    if needed > ~convert(usize, 0) / sizeof(Entity*) { return WorkBudgetError.Invalid; }
    // A live slice of this queue may be reused, but reserve can move it. Keep
    // its index until growth completes; reject spare storage before reading it.
    var borrowed = false;
    var offset: usize = 0;
    if count != 0 && stage.references.data != null {
        var address = bits(usize, nodes);
        var start = bits(usize, stage.references.data);
        if address >= start && address - start < stage.references.capacity * sizeof(Entity*) {
            var distance = address - start;
            offset = distance / sizeof(Entity*);
            if distance % sizeof(Entity*) != 0 || offset >= stage.references.length
                || count > stage.references.length - offset { return WorkBudgetError.Invalid; }
            borrowed = true;
        }
    }
    var nonempty = false;
    for(var i: usize = 0; i < count; i++) {
        var node = nodes[i];
        if node != null && (node.store != stage.anchor.store || node.stage != null) { return WorkBudgetError.Invalid; }
        nonempty ||= node != null;
    }
    if !nonempty { return WorkBudgetError.None; }
    if cancel != null {
        if stage.cancellations.length >= ~convert(usize, 0) / sizeof(EntityStageCancellation) { return WorkBudgetError.Invalid; }
        var error = work_vector_reserve_result(&stage.cancellations, stage.anchor.store.budget, stage.cancellations.length + 1);
        if error != WorkBudgetError.None { return error; }
    }
    var error = work_vector_reserve_result(&stage.references, stage.anchor.store.budget, needed);
    if error != WorkBudgetError.None { return error; }
    if borrowed { nodes = &stage.references.data[offset]; }
    var first = stage.references.length;
    for(var i: usize = 0; i < count; i++) {
        if nodes[i] != null { stage.references.data[stage.references.length++] = nodes[i]; }
    }
    if cancel != null {
        stage.cancellations.data[stage.cancellations.length++] = {
            first: first, stop: stage.references.length, cancel: cancel, context: context };
    }
    return WorkBudgetError.None;
}

// Coordinator only, after the worker joins and before releasing the last input
// pin. This transfers queued ownership into references without publishing rows.
// Publication retries do not retain twice. The compatibility wrapper fails
// fast on error; recoverable callers use the checked form while inputs live.
export fn entity_stage_hold(stage: EntityStage*): void {
    if entity_stage_hold_result(stage) != WorkBudgetError.None { trap("Cannot hold stage references", 0); }
}

export fn entity_stage_hold_result(stage: EntityStage*): WorkBudgetError {
    if stage == null || stage.anchor == null || stage.held > stage.references.length { return WorkBudgetError.Invalid; }
    var stop = stage.held;
    var error = WorkBudgetError.None;
    while stop < stage.references.length {
        var node = stage.references.data[stop];
        if node.stage != null { error = WorkBudgetError.Busy; break; }
        if node.references == ~convert(usize, 0) { error = WorkBudgetError.Exhausted; break; }
        node.references++;
        stop++;
    }
    if error != WorkBudgetError.None {
        // No callbacks or ownership publication occurred. Restore raw counts,
        // including zero-count entities still protected by the input view.
        while stop > stage.held { stage.references.data[--stop].references--; }
        return error;
    }
    stage.held = stop;
    return WorkBudgetError.None;
}

// Admission is private and atomic: reserve cancellation metadata before queue
// growth, then install borrowed fields only after success. Cancel clears those
// fields without releasing their targets; ordinary finalizers still free owned
// buffers. A callback must not mutate this stage/queue or other payloads.
export fn entity_stage_references_cancellable_result(stage: EntityStage*, nodes: Entity**, count: usize,
    cancel: function(void, void*), context: void*): WorkBudgetError {
    if cancel == null { return WorkBudgetError.Invalid; }
    return entity_stage_references_record_result(stage, nodes, count, cancel, context);
}
