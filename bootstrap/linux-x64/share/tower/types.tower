import foundation_syntax;

// Signedness is part of the primitive representation contract, not a host
// promotion rule. Widths are target bits; supported widths are 8, 16, 32 and 64.
fn signed_integer(width: address_type()): type { return integer_type(width, 1); }
fn unsigned_integer(width: address_type()): type { return integer_type(width, 0); }

var i8: type = signed_integer(8);
var u8: type = unsigned_integer(8);
var i16: type = signed_integer(16);
var u16: type = unsigned_integer(16);
var i32: type = signed_integer(32);
var u32: type = unsigned_integer(32);
var i64: type = signed_integer(64);
var u64: type = unsigned_integer(64);
var f32: type = float_type(32);
var f64: type = float_type(64);
var bool: type = boolean_type();
var void: type = empty_type();
// This representation takes its width from the explicit target description.
var usize: type = address_type();
