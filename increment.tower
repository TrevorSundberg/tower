import tower;

// tower.tower supplies typed prefix/postfix ++ and -- for integer and pointer
// locations. These ordinary helpers show the equivalent i32 operations.
fn post_increment(p: i32*): i32 {
    var old: i32 = *p;
    *p = old + 1;
    return old;
}

fn pre_increment(p: i32*): i32 {
    var next: i32 = *p;
    next++;
    *p = next;
    return next;
}

var value: i32 = 5;
var before: i32 = value++;
// 5: the old value, then 6: the updated variable.
print(before);
print(value);
var after: i32 = ++value;
// 7: the new value, then 7: the updated variable.
print(after);
print(value);

// Discarding the result uses the same rules.
value++;
++value;
// Calls accept increment results too: prints 9, then value becomes 10.
print(value++);
