import tower;

// Tower supplies expressions and control flow. Add one small statement ourselves:
// the replacement expands into an ordinary assignment before execution.
parse Statement |= 'increment' $name:Identifier ';'
    => replace { $name = $name + 1; };

var count = 0;
var total = 0;
while count < 5 {
    increment count;
    total += count;
}
print(total);

// Aliases share the same typed storage.
var alias = &total;
(*alias)++;
print(total);
