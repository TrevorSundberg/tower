import tower;
import vector;

// A derived dependency/execution index, never a second semantic graph. Subjects
// are borrowed shared entities; their payloads remain owned by the caller.
// Exactly one coordinator mutates this index. Workers receive immutable tickets
// and isolated inputs, then return owned results for coordinator publication.
// These functions do not make the entity store or arbitrary payloads thread safe.
enum WorkState: u32 {
    Building, Waiting, Ready, Running, Succeeded, Failed, Cancelled
}
enum WorkError: u32 {
    None, Memory, Invalid
}

struct WorkTask {
    subject: void*;
    query: u32;
    argument: u64;
    state: WorkState;
    demanded: bool;
    blocked: bool;
    dependencies: usize;
    consumers: usize;
    remaining: usize;
    visit: u64;
    active: bool;
}

struct WorkEdge {
    consumer: usize;
    dependency: usize;
    next_dependency: usize;
    next_consumer: usize;
}

struct WorkTicket {
    task: usize;
    revision: u64;
    profile: u64;
}

struct WorkFrame {
    task: usize;
    edge: usize;
}

struct WorkGraph {
    tasks: vector(WorkTask);
    edges: vector(WorkEdge);
    task_index: vector(usize);
    edge_index: vector(usize);
    ready: vector(usize);
    scratch: vector(usize);
    frames: vector(WorkFrame);
    head: usize;
    running: usize;
    revision: u64;
    profile: u64;
    sweep: u64;
    cancelled: bool;
    error: WorkError;
}

fn work_init(g: WorkGraph*, revision: u64, profile: u64): void {
    fill(g, 0, sizeof(WorkGraph));
    g.revision = revision;
    g.profile = profile;
    g.error = WorkError.None;
}

fn work_dispose(g: WorkGraph*): void {
    vector_dispose(WorkTask, &g.tasks);
    vector_dispose(WorkEdge, &g.edges);
    vector_dispose(usize, &g.task_index);
    vector_dispose(usize, &g.edge_index);
    vector_dispose(usize, &g.ready);
    vector_dispose(usize, &g.scratch);
    vector_dispose(WorkFrame, &g.frames);
    fill(g, 0, sizeof(WorkGraph));
}

fn work_ok(g: WorkGraph*): bool {
    if g.cancelled {
        return false;
    }
    var ok = g.error == WorkError.None;
    return ok;
}

fn work_memory(g: WorkGraph*, ok: bool): bool {
    if ok {} else {
        g.error = WorkError.Memory;
    }
    return ok;
}

// Handles are one-based, stable across storage growth. No pointers into the
// task/edge arrays survive a call that may grow them. Hash order is never output
// order; tasks and edges retain deterministic coordinator insertion order.
fn work_task(g: WorkGraph*, id: usize): WorkTask* {
    var invalid = id == 0;
    if invalid {} else {
        invalid = id > g.tasks.length;
    }
    if invalid {
        return null;
    }
    var index = id - 1;
    return &g.tasks.data[index];
}

fn work_mix(hash: u64, value: u64): u64 {
    var result = hash ^ value;
    result = result * 1099511628211;
    var high = result / 4294967296;
    result = result ^ high;
    return result;
}

fn work_key(subject: void*, query: u32, argument: u64): u64 {
    var address = bits(usize, subject);
    var hash = work_mix(14695981039346656037, convert(u64, address));
    hash = work_mix(hash, convert(u64, query));
    return work_mix(hash, argument);
}

fn work_edge_key(consumer: usize, dependency: usize): u64 {
    var hash = work_mix(14695981039346656037, convert(u64, consumer));
    return work_mix(hash, convert(u64, dependency));
}

fn work_bucket(hash: u64, count: usize): usize {
    var mask = count - 1;
    var index = hash & convert(u64, mask);
    return convert(usize, index);
}

fn work_index(g: WorkGraph*, edges: bool): bool {
    var index = &g.task_index;
    var count = g.tasks.length;
    if edges {
        index = &g.edge_index;
        count = g.edges.length;
    }
    var limit = index.length / 2;
    var enough = count < limit;
    if enough {
        return true;
    }
    var size = index.length * 2;
    var overflow = size < index.length;
    if overflow {
        g.error = WorkError.Memory;
        return false;
    }
    var small = size < 16;
    if small {
        size = 16;
    }
    if work_memory(g, vector_reserve(usize, index, size)) {} else {
        return false;
    }
    index.length = size;
    var bytes = size * sizeof(usize);
    fill(index.data, 0, bytes);
    var i: usize = 0;
    while i < count {
        var hash: u64 = 0;
        if edges {
            var edge = &g.edges.data[i];
            hash = work_edge_key(edge.consumer, edge.dependency);
        } else {
            var task = &g.tasks.data[i];
            hash = work_key(task.subject, task.query, task.argument);
        }
        var at = work_bucket(hash, size);
        while index.data[at] != 0 {
            at = at + 1;
            at = work_bucket(convert(u64, at), size);
        }
        index.data[at] = i + 1;
        i = i + 1;
    }
    return true;
}

// All key fields compare exactly. A graph's explicit profile covers target,
// semantics and capability policy; callers must not reuse it for another profile.
fn work_request(g: WorkGraph*, subject: void*, query: u32, argument: u64): usize {
    if work_ok(g) {} else {
        return 0;
    }
    if work_index(g, false) {} else {
        return 0;
    }
    var hash = work_key(subject, query, argument);
    var at = work_bucket(hash, g.task_index.length);
    while g.task_index.data[at] != 0 {
        var id = g.task_index.data[at];
        var task = work_task(g, id);
        var same = task.subject == subject;
        if same {
            same = task.query == query;
        }
        if same {
            same = task.argument == argument;
        }
        if same {
            return id;
        }
        at = at + 1;
        at = work_bucket(convert(u64, at), g.task_index.length);
    }
    var size = g.tasks.length + 1;
    var overflow = size == 0;
    if overflow {
        g.error = WorkError.Memory;
        return 0;
    }
    if work_memory(g, vector_reserve(WorkTask, &g.tasks, size)) {} else {
        return 0;
    }
    var task = &g.tasks.data[g.tasks.length];
    fill(task, 0, sizeof(WorkTask));
    task.subject = subject;
    task.query = query;
    task.argument = argument;
    task.state = WorkState.Building;
    g.tasks.length = size;
    g.task_index.data[at] = size;
    return size;
}

// Edges may only be declared before a consumer is sealed. Duplicate reads do not
// grow the graph, including high-fan-in queries. No per-query adjacency allocation.
fn work_depend(g: WorkGraph*, consumer: usize, dependency: usize): bool {
    if work_ok(g) {} else {
        return false;
    }
    var task = work_task(g, consumer);
    var input = work_task(g, dependency);
    var invalid = task == null;
    if invalid {} else {
        invalid = input == null;
    }
    if invalid {} else {
        invalid = task.state != WorkState.Building;
    }
    if invalid {
        g.error = WorkError.Invalid;
        return false;
    }
    if work_index(g, true) {} else {
        return false;
    }
    var hash = work_edge_key(consumer, dependency);
    var at = work_bucket(hash, g.edge_index.length);
    while g.edge_index.data[at] != 0 {
        var index = g.edge_index.data[at] - 1;
        var edge = &g.edges.data[index];
        var same = edge.consumer == consumer;
        if same {
            same = edge.dependency == dependency;
        }
        if same {
            return true;
        }
        at = at + 1;
        at = work_bucket(convert(u64, at), g.edge_index.length);
    }
    var size = g.edges.length + 1;
    var overflow = size == 0;
    if overflow {
        g.error = WorkError.Memory;
        return false;
    }
    if work_memory(g, vector_reserve(WorkEdge, &g.edges, size)) {} else {
        return false;
    }
    var edge = &g.edges.data[g.edges.length];
    edge.consumer = consumer;
    edge.dependency = dependency;
    edge.next_dependency = task.dependencies;
    edge.next_consumer = input.consumers;
    task.dependencies = size;
    input.consumers = size;
    g.edges.length = size;
    g.edge_index.data[at] = size;
    return true;
}

fn work_enqueue(g: WorkGraph*, id: usize): bool {
    var task = work_task(g, id);
    var ready = task.state == WorkState.Waiting;
    if ready {
        ready = task.remaining == 0;
    }
    if ready {
        ready = task.demanded;
    }
    if ready {
        if work_memory(g, vector_push(usize, &g.ready, id)) {} else {
            return false;
        }
        task.state = WorkState.Ready;
    }
    return true;
}

fn work_seal(g: WorkGraph*, id: usize): bool {
    if work_ok(g) {} else {
        return false;
    }
    var task = work_task(g, id);
    var invalid = task == null;
    if invalid {} else {
        invalid = task.state != WorkState.Building;
    }
    if invalid {
        g.error = WorkError.Invalid;
        return false;
    }
    task.state = WorkState.Waiting;
    var blocked = task.blocked;
    var at = task.dependencies;
    while at != 0 {
        var index = at - 1;
        var edge = &g.edges.data[index];
        var input = work_task(g, edge.dependency);
        var failed = input.state == WorkState.Failed;
        if failed {
            blocked = true;
        }
        var pending = input.state != WorkState.Succeeded;
        if pending {
            task.remaining = task.remaining + 1;
        }
        at = edge.next_dependency;
    }
    if blocked {
        return work_fail(g, id);
    }
    return work_enqueue(g, id);
}

fn work_demand(g: WorkGraph*, id: usize): bool {
    if work_ok(g) {} else {
        return false;
    }
    g.scratch.length = 0;
    if work_memory(g, vector_push(usize, &g.scratch, id)) {} else {
        return false;
    }
    var current: usize = 0;
    while vector_pop(usize, &g.scratch, &current) {
        var task = work_task(g, current);
        var invalid = task == null;
        if invalid {} else {
            invalid = task.state == WorkState.Building;
        }
        if invalid {
            g.error = WorkError.Invalid;
            return false;
        }
        if task.demanded {
            continue;
        }
        task.demanded = true;
        var failed = task.state == WorkState.Failed;
        if failed {
            continue;
        }
        var at = task.dependencies;
        while at != 0 {
            var index = at - 1;
            var edge = &g.edges.data[index];
            if work_memory(g, vector_push(usize, &g.scratch, edge.dependency)) {} else {
                return false;
            }
            at = edge.next_dependency;
        }
        if work_enqueue(g, current) {} else {
            return false;
        }
    }
    return true;
}

// Taking up to N tickets gives an executor a ready batch; the queue itself is
// coordinator-owned. Publish results in semantic/source order when order matters,
// never in worker completion order. Ticket failure preserves the output.
fn work_take(g: WorkGraph*, output: WorkTicket*): bool {
    if work_ok(g) {} else {
        return false;
    }
    var missing = output == null;
    if missing {
        return false;
    }
    while g.head < g.ready.length {
        var id = g.ready.data[g.head];
        g.head = g.head + 1;
        var task = work_task(g, id);
        var ready = task.state == WorkState.Ready;
        if ready {
            task.state = WorkState.Running;
            g.running = g.running + 1;
            output.task = id;
            output.revision = g.revision;
            output.profile = g.profile;
            return true;
        }
    }
    g.ready.length = 0;
    g.head = 0;
    return false;
}

// A failed task blocks every dependent task without invoking it. Recoverable
// language results belong in task payloads, not in this infrastructure status.
fn work_fail(g: WorkGraph*, id: usize): bool {
    g.scratch.length = 0;
    if work_memory(g, vector_push(usize, &g.scratch, id)) {} else {
        return false;
    }
    var current: usize = 0;
    while vector_pop(usize, &g.scratch, &current) {
        var task = work_task(g, current);
        var failed = task.state == WorkState.Failed;
        var building = task.state == WorkState.Building;
        if building {
            failed = task.blocked;
        }
        if failed {
            continue;
        }
        task.blocked = true;
        if building {} else {
            task.state = WorkState.Failed;
        }
        var at = task.consumers;
        while at != 0 {
            var index = at - 1;
            var edge = &g.edges.data[index];
            if work_memory(g, vector_push(usize, &g.scratch, edge.consumer)) {} else {
                return false;
            }
            at = edge.next_consumer;
        }
    }
    return true;
}

fn work_finish(g: WorkGraph*, ticket: WorkTicket*, success: bool): bool {
    if work_ok(g) {} else {
        return false;
    }
    var task = work_task(g, ticket.task);
    var valid = task != null;
    if valid {
        valid = task.state == WorkState.Running;
    }
    if valid {
        valid = ticket.revision == g.revision;
    }
    if valid {
        valid = ticket.profile == g.profile;
    }
    if valid {} else {
        return false;
    }
    g.running = g.running - 1;
    if success {} else {
        return work_fail(g, ticket.task);
    }
    task.state = WorkState.Succeeded;
    var at = task.consumers;
    while at != 0 {
        var index = at - 1;
        var edge = &g.edges.data[index];
        var consumer = work_task(g, edge.consumer);
        var waiting = consumer.state == WorkState.Waiting;
        if waiting {
            consumer.remaining = consumer.remaining - 1;
            if work_enqueue(g, edge.consumer) {} else {
                return false;
            }
        }
        at = edge.next_consumer;
    }
    return true;
}

// Cancellation invalidates all outstanding receipts. Workers must still release
// their own unpublished results; this index neither frees nor mutates payloads.
fn work_cancel(g: WorkGraph*): void {
    g.cancelled = true;
    g.running = 0;
    g.ready.length = 0;
    g.head = 0;
    var i: usize = 0;
    while i < g.tasks.length {
        var task = &g.tasks.data[i];
        var complete = task.state == WorkState.Succeeded;
        if complete {} else {
            task.state = WorkState.Cancelled;
        }
        i = i + 1;
    }
}

fn work_frame(g: WorkGraph*, id: usize): bool {
    var size = g.frames.length + 1;
    if work_memory(g, vector_reserve(WorkFrame, &g.frames, size)) {} else {
        return false;
    }
    var task = work_task(g, id);
    var frame = &g.frames.data[g.frames.length];
    frame.task = id;
    frame.edge = task.dependencies;
    task.visit = g.sweep;
    task.active = true;
    g.frames.length = size;
    return true;
}

// Iterative DFS reports the actual closed cycle, without a host-stack or fixed
// nesting limit. Ready/running work is not a cycle. The returned handles borrow
// subjects from this graph; the caller owns the output vector.
fn work_cycle(g: WorkGraph*, root: usize, output: vector(usize)*): bool {
    output.length = 0;
    if work_ok(g) {} else {
        return false;
    }
    var missing = work_task(g, root) == null;
    if missing {
        g.error = WorkError.Invalid;
        return false;
    }
    g.sweep = g.sweep + 1;
    var overflow = g.sweep == 0;
    if overflow {
        var i: usize = 0;
        while i < g.tasks.length {
            g.tasks.data[i].visit = 0;
            i = i + 1;
        }
        g.sweep = 1;
    }
    g.frames.length = 0;
    if work_frame(g, root) {} else {
        return false;
    }
    while g.frames.length != 0 {
        var top = g.frames.length - 1;
        var frame = &g.frames.data[top];
        var exhausted = frame.edge == 0;
        if exhausted {
            var task = work_task(g, frame.task);
            task.active = false;
            g.frames.length = top;
            continue;
        }
        var index = frame.edge - 1;
        var edge = &g.edges.data[index];
        frame.edge = edge.next_dependency;
        var task = work_task(g, edge.dependency);
        var waiting = task.state == WorkState.Waiting;
        if waiting {} else {
            continue;
        }
        var seen = task.visit == g.sweep;
        if seen {
            if task.active {
                var i: usize = 0;
                while g.frames.data[i].task != edge.dependency {
                    i = i + 1;
                }
                while i < g.frames.length {
                    if work_memory(g, vector_push(usize, output, g.frames.data[i].task)) {} else {
                        return false;
                    }
                    i = i + 1;
                }
                return work_memory(g, vector_push(usize, output, edge.dependency));
            }
        } else {
            if work_frame(g, edge.dependency) {} else {
                return false;
            }
        }
    }
    return false;
}
