import tower;

// Raw, explicitly owned storage. Initialize/dispose once; growth invalidates
// element pointers. Push currently accepts scalar/pointer elements, not copies
// of aggregate values. Type construction and specialization use shared nodes.
fn vector(T: type): type {
    struct Result {
        data: T*;
        length: usize;
        capacity: usize;
    }
    return Result;
}

fn vector_init(T: type, value: vector(T)*): void {
    value.data = null;
    value.length = 0;
    value.capacity = 0;
}

fn vector_reserve(T: type, value: vector(T)*, needed: usize): bool {
    var enough = needed <= value.capacity;
    if enough {
        return true;
    }
    var maximum: usize = 0;
    maximum--;
    var size = sizeof(T);
    var empty_type = size == 0;
    if empty_type {
        return false;
    }
    var limit = maximum / size;
    var impossible = needed > limit;
    if impossible {
        return false;
    }
    var capacity = value.capacity *2;
    var wrapped = capacity < value.capacity;
    if wrapped {
        capacity = needed;
    }
    var small = capacity < 8;
    if small {
        capacity = 8;
    }
    small = capacity < needed;
    if small {
        capacity = needed;
    }
    var large = capacity > limit;
    if large {
        capacity = needed;
    }
    var next = realloc(T, value.data, capacity);
    var failed = next == null;
    if failed {
        return false;
    }
    value.data = next;
    value.capacity = capacity;
    return true;
}

fn vector_push(T: type, value: vector(T)*, element: T): bool {
    var needed = value.length + 1;
    var overflow = needed == 0;
    if overflow {
        return false;
    }
    var ok = vector_reserve(T, value, needed);
    if ok {
        value.data[value.length] = element;
        value.length = needed;
    }
    return ok;
}

fn vector_dispose(T: type, value: vector(T)*): void {
    free(value.data);
    vector_init(T, value);
}

// Empty/null-output failure preserves both storage and the output value.
// Output must be valid T storage outside the remaining live elements.
fn vector_pop(T: type, value: vector(T)*, output: T*): bool {
    var empty = value.length == 0;
    if empty {
        return false;
    }
    var missing = output == null;
    if missing {
        return false;
    }
    var last = value.length -1;
    *output = value.data[last];
    value.length = last;
    return true;
}

// Both values must be initialized independent owners (or the same owner).
// Transfer replaces/disposes destination storage and empties the source.
// Scalar/pointer elements have no implicit destruction or deep ownership here.
fn vector_move(T: type, destination: vector(T)*, source: vector(T)*): void {
    var same = destination == source;
    if same {
        return;
    }
    vector_dispose(T, destination);
    destination.data = source.data;
    destination.length = source.length;
    destination.capacity = source.capacity;
    vector_init(T, source);
}
