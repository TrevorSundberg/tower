import tower;

// The platform implements only thread and semaphore primitives. All admission,
// ownership and dispatch are Tower. Jobs borrow pinned component payloads. The
// coordinator owns busy/count; workers only access a slot between handoffs.
extern fn work_thread_available(): bool;
extern fn work_thread_capacity(): usize;
// True only when keeping idle threads cannot exhaust a fixed host worker set
// needed by another world or phase. This controls lifetime, not job semantics.
extern fn work_thread_retention(): bool;
extern fn work_thread_open(argument: void*): void*;
// Native services may select a separately linked Tower callback. The callback
// still uses this pool's slot handoff, completion and cancellation protocol.
extern fn work_thread_open_named(argument: void*, posix_entry: u8*, windows_entry: u8*): void*;
extern fn work_thread_close(thread: void*): void;
extern fn work_signal_open(): void*;
extern fn work_signal_close(signal: void*): void;
extern fn work_signal_post(signal: void*): void;
extern fn work_signal_wait(signal: void*): void;
extern fn work_signal_try(signal: void*): bool;
extern fn work_kernel_execute(job: void*): void;

struct WorkSlot {
    thread: void*;
    start: void*;
    finished: void*;
    completion: void*;
    job: void*;
    busy: bool;
}

struct WorkPool {
    slots: WorkSlot*;
    count: usize;
    running: usize;
    peak: usize;
    completion: void*;
    threaded: bool;
}

var WorkPoolMaximumCapacity: usize = 256;

fn work_pool_wait(slot: WorkSlot*): void* {
    work_signal_wait(slot.start);
    return slot.job;
}

fn work_pool_complete(slot: WorkSlot*): void {
    work_signal_post(slot.finished);
    work_signal_post(slot.completion);
}

fn work_pool_entry(argument: void*): void* {
    var slot = bits(WorkSlot*, argument);
    loop {
        var job = work_pool_wait(slot);
        if job == null {
            return null;
        }
        work_kernel_execute(job);
        // finished publishes this slot's payload; completion wakes the owner.
        // Never read job/busy again until the next start semaphore acquisition.
        work_pool_complete(slot);
    }
}

fn work_pool_open(pool: WorkPool*, capacity: usize): bool {
    return work_pool_open_named(pool, capacity, null, null);
}

fn work_pool_open_named(pool: WorkPool*, capacity: usize, entry: u8*, windows_entry: u8*): bool {
    *pool = default;
    if capacity == 0 || capacity > WorkPoolMaximumCapacity {
        return false;
    }
    // A caller's budget is an upper bound, not permission to exhaust a fixed
    // transport. Browser workers report one lane inside a worker so nested
    // phases execute inline instead of waiting on their occupied outer slots.
    var available = work_thread_capacity();
    if available == 0 { return false; }
    if capacity > available { capacity = available; }
    pool.threaded = work_thread_available() && capacity > 1;
    if !pool.threaded {
        capacity = 1;
    }
    pool.slots = alloc(WorkSlot, capacity);
    if pool.slots == null {
        return false;
    }
    fill(pool.slots, 0, capacity * sizeof(WorkSlot));
    if !pool.threaded {
        pool.count = 1;
        return true;
    }
    pool.completion = work_signal_open();
    if pool.completion == null {
        work_pool_close(pool);
        return false;
    }
    while pool.count < capacity {
        var slot = &pool.slots[pool.count];
        slot.completion = pool.completion;
        slot.start = work_signal_open();
        slot.finished = work_signal_open();
        pool.count++;
        if slot.start == null || slot.finished == null {
            work_pool_close(pool);
            return false;
        }
        slot.thread = entry == null && windows_entry == null ? work_thread_open(bits(void*, slot))
            : work_thread_open_named(bits(void*, slot), entry, windows_entry);
        if slot.thread == null {
            work_pool_close(pool);
            return false;
        }
    }
    return true;
}

// Admission only. A serial caller executes its own kernel before receiving;
// threaded slots execute through the callback selected when opening the pool.
fn work_pool_admit(pool: WorkPool*, job: void*): bool {
    if job == null || pool.running == pool.count {
        return false;
    }
    var index: usize = 0;
    while index < pool.count {
        var slot = &pool.slots[index];
        if !slot.busy {
            slot.job = job;
            slot.busy = true;
            pool.running++;
            if pool.running > pool.peak {
                pool.peak = pool.running;
            }
            if pool.threaded {
                work_signal_post(slot.start);
            }
            return true;
        }
        index++;
    }
    return false;
}

fn work_pool_submit(pool: WorkPool*, job: void*): bool {
    if !work_pool_admit(pool, job) { return false; }
    if !pool.threaded { work_kernel_execute(job); }
    return true;
}

// Exactly one consumed completion token accounts for one returned result. A
// worker may finish in any order; callers publish in semantic order if needed.
fn work_pool_receive(pool: WorkPool*, wait: bool): void* {
    if pool.running == 0 {
        return null;
    }
    if pool.threaded {
        if wait {
            work_signal_wait(pool.completion);
        } else {
            if !work_signal_try(pool.completion) {
                return null;
            }
        }
    }
    var index: usize = 0;
    while index < pool.count {
        var slot = &pool.slots[index];
        if slot.busy && (!pool.threaded || work_signal_try(slot.finished)) {
            var job = slot.job;
            slot.job = null;
            slot.busy = false;
            pool.running--;
            return job;
        }
        index++;
    }
    trap("Worker completion has no owning slot", 0);
    return null;
}

fn work_pool_close(pool: WorkPool*): void {
    // Cancellation drains already admitted finite kernels before reclaiming
    // their views. It must not kill threads or free a payload still in use.
    while pool.running != 0 {
        work_pool_receive(pool, true);
    }
    var index: usize = 0;
    while index < pool.count {
        var slot = &pool.slots[index];
        if slot.thread != null {
            slot.job = null;
            work_signal_post(slot.start);
            work_thread_close(slot.thread);
        }
        work_signal_close(slot.start);
        work_signal_close(slot.finished);
        index++;
    }
    work_signal_close(pool.completion);
    free(pool.slots);
    *pool = default;
}
