import tower;
import work_budget;
import work_budget_types;
import work_buffer_types;

extern fn compiler_buffer_allocation_size(bytes: usize): usize;
extern fn compiler_buffer_allocate(bytes: usize): void*;
extern fn compiler_buffer_free(memory: void*): void;
extern fn compiler_buffer_alignment(): usize;

var WorkBufferInitialElements: usize = 8;

fn work_buffer_release(data: void*, reservation: WorkReservation*): void {
    compiler_buffer_free(data);
    if reservation.active
        && work_budget_release_result(reservation.owner, reservation) != WorkBudgetError.None {
        trap("Invalid retained buffer budget receipt", 0);
    }
}

fn work_buffer_dispose(buffer: WorkBuffer*): void {
    work_buffer_release(bits(void*, buffer.data), &buffer.reservation);
    *buffer = default;
}

// The typed vector owns these fields. Borrow their slots synchronously instead
// of specializing the transactional buffer protocol for every payload type.
// No pointer or receipt escapes; failure preserves all four owner fields.
fn work_buffer_vector_reserve(data: u8**, length: usize, capacity: usize*, reservation: WorkReservation*,
    budget: WorkBudget*, needed: usize, size: usize, alignment: usize): WorkBudgetError {
    var buffer = init(WorkBuffer) {data: *data, capacity: *capacity * size, reservation: *reservation};
    var result = work_buffer_grow_elements(&buffer, budget, length, *capacity, needed, size, alignment);
    if result != WorkBudgetError.None { return result; }
    *data = buffer.data;
    *capacity = buffer.capacity / size;
    *reservation = buffer.reservation;
    return WorkBudgetError.None;
}

// Reserve the whole replacement before allocation: old and new coexist during
// the copy. On any denial/overflow/allocation failure the old owner is intact.
// A null budget is the explicit standalone boundary, never a global fallback.
// Count the known compiler header, not allocator-private overhead or RSS.
fn work_buffer_resize(buffer: WorkBuffer*, budget: WorkBudget*, bytes: usize, preserve: usize): WorkBudgetError {
    if buffer == null || preserve > buffer.capacity || preserve > bytes
        || (buffer.data != null && buffer.reservation.owner != budget) { return WorkBudgetError.Invalid; }
    if bytes == buffer.capacity { return WorkBudgetError.None; }
    if bytes == 0 { work_buffer_dispose(buffer); return WorkBudgetError.None; }
    var allocated = compiler_buffer_allocation_size(bytes);
    if allocated == 0 { return WorkBudgetError.Invalid; }
    // A representable physical buffer larger than the configured cap is a
    // capacity denial, not a malformed execution-lane reservation.
    if budget != null && budget.initialized && allocated > budget.bytes { return WorkBudgetError.Capacity; }
    var next: WorkBuffer = default;
    if budget != null {
        var result = work_budget_reserve_result(budget, 0, 0, allocated, &next.reservation);
        if result != WorkBudgetError.None { return result; }
    }
    next.data = bits(u8*, compiler_buffer_allocate(bytes));
    if next.data == null {
        work_buffer_dispose(&next);
        return WorkBudgetError.Memory;
    }
    next.capacity = bytes;
    if preserve != 0 { copy(next.data, buffer.data, preserve); }
    work_buffer_dispose(buffer);
    *buffer = next;
    return WorkBudgetError.None;
}

// The typed vector checks its owner, live length and no-growth fast path first.
// Share the remaining growth policy without specializing it for every element
// type. buffer is a transactional borrow; failure leaves it and its owner intact.
fn work_buffer_grow_elements(buffer: WorkBuffer*, budget: WorkBudget*, length: usize,
    capacity: usize, needed: usize, size: usize, alignment: usize): WorkBudgetError {
    if size == 0 || alignment > compiler_buffer_alignment()
        || needed > ~convert(usize, 0) / size { return WorkBudgetError.Invalid; }
    var next_capacity = capacity * 2;
    if next_capacity < capacity { next_capacity = needed; }
    if next_capacity < WorkBufferInitialElements { next_capacity = WorkBufferInitialElements; }
    if next_capacity < needed || next_capacity > ~convert(usize, 0) / size { next_capacity = needed; }
    return work_buffer_resize(buffer, budget, next_capacity * size, length * size);
}

// Both operands are independent initialized owners. Borrowed aliases are not
// copies of these descriptors. Transfer does not acquire a second byte grant.
fn work_buffer_move(destination: WorkBuffer*, source: WorkBuffer*): void {
    if destination == source { return; }
    work_buffer_dispose(destination);
    *destination = *source;
    *source = default;
}

fn work_buffer_swap(left: WorkBuffer*, right: WorkBuffer*): void {
    var previous = *left;
    *left = *right;
    *right = previous;
}
