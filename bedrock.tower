// This bedrock.tower is loaded first, then foundation.tower.
// GrammarPattern reads /patterns/ for token and skip rules.
// GrammarTemplate reads {replacement bodies} with balanced braces.
skip Whitespace = /[ \t\r\n]+/;
skip LineComment = /\/\/[^\r\n]*/ as comment;
skip BlockComment = /\/\*([^*]|\*+[^*/])*\*+\// as comment;
token Identifier = /[A-Za-z_][A-Za-z0-9_]*|`([^`\\\r\n]|\\[nrt\\`])*`/ as identifier;
token String = /"([^"\\\r\n]|\\[nrt\\'"])*"|'([^'\\\r\n]|\\[nrt\\'"])*'/ as string;
token GrammarPattern = /\/([^/\\\[\r\n]|\\[^\r\n]|\[([^\\\]\r\n]|\\[^\r\n])*\])*\// when expected as pattern;
token GrammarCharacter = /[^{}\r\n]/ when expected as operator;
parse GrammarDeclaration = 'parse' $name:Identifier $op:GrammarAssignment $alternatives:GrammarAlternatives $replacement:GrammarReplacement ';';
parse GrammarTemplate = '{' GrammarTemplateItems '}';
parse GrammarTemplateItems = GrammarTemplateItems GrammarTemplateItem | ;
parse GrammarTemplateItem = GrammarTemplate | [^'{' '}'] | GrammarCharacter;
parse GrammarTokenDeclaration = 'token' $name:Identifier '=' $pattern:GrammarPattern $mode:GrammarTokenMode $style:GrammarStyle ';';
parse GrammarSkipDeclaration = 'skip' $name:Identifier '=' $pattern:GrammarPattern $mode:GrammarTokenMode $style:GrammarStyle ';';
parse GrammarTokenMode = | 'when' 'expected';
parse GrammarAssignment = '=' | '|=';
parse GrammarReplacement = | '=>' 'replace' $body:GrammarTemplate;
parse GrammarAlternatives = $previous:GrammarAlternatives '|' $sequence:GrammarSequence
                           | $sequence:GrammarSequence;
parse GrammarSequence = $previous:GrammarSequence $term:GrammarTerm | ;
parse GrammarTerm = $atom:GrammarAtom $suffix:GrammarSuffix;
parse GrammarSuffix = '*' | '+' | '?' | ;
parse GrammarAtom = $literal:String | $reference:Identifier | '$' $capture:Identifier
                   | '$' $capture:Identifier ':' $reference:Identifier | '[^' $set:GrammarTokenSet ']';
parse GrammarTokenSet = $previous:GrammarTokenSet $literal:String | ;
parse GrammarStyle = | 'as' $kind:Identifier;
parse ImportPath = $previous:ImportPath '.' $segment:Identifier | $segment:Identifier;
parse ImportDeclaration = 'import' $name:ImportPath ';' | 'import' $name:String ';';
