// C++ always parses this file. These rules govern foundation.tower and later source.
// GrammarPattern and GrammarTemplate are native scanner primitives.
skip Whitespace = /[ \t\r\n]+/;
skip LineComment = /\/\/[^\r\n]*/ as comment;
skip BlockComment = /\/\*([^*]|\*+[^*/])*\*+\// as comment;
token Identifier = /[A-Za-z_][A-Za-z0-9_]*|`([^`\\\r\n]|\\[nrt\\`])*`/ as identifier;
token String = /"([^"\\\r\n]|\\[nrt\\'"])*"|'([^'\\\r\n]|\\[nrt\\'"])*'/ as string;
parse GrammarDeclaration = 'parse' $name:Identifier $op:GrammarAssignment $alternatives:GrammarAlternatives $replacement:GrammarReplacement ';';
parse GrammarTokenDeclaration = 'token' $name:Identifier '=' $pattern:GrammarPattern $style:GrammarStyle ';';
parse GrammarSkipDeclaration = 'skip' $name:Identifier '=' $pattern:GrammarPattern $style:GrammarStyle ';';
parse GrammarAssignment = '=' | '|=';
parse GrammarReplacement = | '=>' 'replace' $body:GrammarTemplate;
parse GrammarAlternatives = $previous:GrammarAlternatives '|' $sequence:GrammarSequence | $sequence:GrammarSequence;
parse GrammarSequence = $previous:GrammarSequence $term:GrammarTerm | ;
parse GrammarTerm = $atom:GrammarAtom $suffix:GrammarSuffix;
parse GrammarSuffix = '*' | '+' | '?' | ;
parse GrammarAtom = $literal:String | $reference:Identifier | '$' $capture:Identifier | '$' $capture:Identifier ':' $reference:Identifier;
parse GrammarStyle = | 'as' $kind:Identifier;
