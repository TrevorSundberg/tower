import bedrock;

// These are ordinary Tower declarations, editable while you type.
// Add hyphens and non-ASCII Unicode characters to identifiers.
[identifier] token Identifier = /[A-Za-z_\u{80}-\u{10ffff}][A-Za-z_0-9\u{80}-\u{10ffff}-]*/;
// Decimal numbers, with an optional fractional part.
[number] token Number = /[0-9]+(\.[0-9]+)?/;
// Extra token types work too. Longest match makes 0xff a Hex, not Number 0.
[number] token Hex = /0x[0-9A-Fa-f]+/;
[comment] skip HashComment = /#[^\r\n]*/;

parse Value = Identifier | Number | String | Hex;
parse Statement = Value ';';
parse Pair = Identifier ':' Number ';';
parse Statement |= Pair;
// Later grammar literals would use backticks too, so define the rules above first.
[string] token String = /`[^`\r\n]*`/;
player-name;
café;
3.14;
`hello from Tower`;
0xff;
# Comments are defined in Tower too.
// Token replacement takes effect only after this declaration.
[identifier] token Identifier = /@[A-Za-z_][A-Za-z_0-9]*/;
@player;
// This also changes subsequent declaration names; the rules above are already installed.
@score: 42.5;
