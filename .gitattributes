# The project journal preserves concurrent append-only entries from each writer.
docs/temporal-opcode-research-journal.md merge=union

# Tower is not registered in GitHub Linguist yet. Do not mislabel it as another
# language; this keeps source eligible once upstream recognizes .tower.
*.tower linguist-detectable=true

# Dependency sources and compiled distribution artifacts are not authored source.
third_party/** linguist-vendored=true
bootstrap/linux-x64/towerc binary linguist-generated=true
bootstrap/linux-x64/** -text linguist-generated=true
bootstrap/linux-x64/SHA256SUMS text eol=lf
bootstrap/source-changes.patch -text linguist-generated=true
playground/dist/** linguist-generated=true

# Scope-test fixtures are editor tests, not upstream classifier samples.
editors/tower/tests/** linguist-detectable=false
