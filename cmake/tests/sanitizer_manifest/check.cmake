# Run after configuring this fixture; no compiler or instrumentation execution.
cmake_minimum_required(VERSION 3.20)
if(NOT FIXTURE_BINARY_DIR)
  message(FATAL_ERROR "Pass -DFIXTURE_BINARY_DIR=<configured fixture directory>")
endif()
get_filename_component(root "${FIXTURE_BINARY_DIR}" ABSOLUTE)
set(expected "# Configured objects, not an execution receipt. Object\tTower source\tOriginal IR\tInstrumented IR\tMode\n")
foreach(name IN ITEMS common nested/common probe "receipt with space")
  string(APPEND expected "${root}/${name}.o\t${CMAKE_CURRENT_LIST_DIR}/inputs with spaces/${name}.tower\t${root}/${name}-original.ll\t${root}/${name}-address.ll\taddress\n")
endforeach()
file(READ "${root}/sanitizer-objects.tsv" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Configured inventory differs: require all four exact sorted objects once, including nested deferred producers and paths with spaces")
endif()
message(STATUS "All four exact configured objects occur once; no execution evidence claimed")
