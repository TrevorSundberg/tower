# Match the public driver's terminal stderr line after a successful invocation.
function(register_language_tests name owner count)
  # CTest evaluates installed registrations in the moved kit's working directory.
  get_filename_component(registry "CTestTestfile.cmake" REALPATH BASE_DIR ".")
  get_filename_component(suite_dir "${registry}" DIRECTORY)
  get_filename_component(source "@scc_root@/${owner}.tower" ABSOLUTE BASE_DIR "${suite_dir}")
  set(outcome "tests passed")
  if(count EQUAL 1)
    set(outcome "test passed")
  elseif(count EQUAL 0)
    set(outcome "tests selected")
  endif()
  set(test_args ${ARGN})
  if(ARGV3 STREQUAL "INTERPRETED")
    list(POP_FRONT test_args)
  else()
    list(PREPEND test_args --test-native-runtime "@scc_objects@/guest-native-test.o")
  endif()
  foreach(jobs IN ITEMS 1 4)
    set(test "tower-selected-${name}-jobs-${jobs}")
    add_test("${test}" "@scc_bin@/tower-selected-test-count" "${count} ${outcome} for ${source}"
      "@scc_bin@/towerc" --test "${source}"
      --jobs "${jobs}" --test-details ${test_args})
    set_tests_properties("${test}" PROPERTIES TIMEOUT 60 LABELS "native;focused")
  endforeach()
endfunction()

set(narrow_abi_tests "@narrow_abi_tests@")
if(narrow_abi_tests)
  register_language_tests(narrow-foreign tests/narrow_foreign 3 --link "@scc_objects@/narrow-foreign-library.o")
endif()

set(driver_tests "@TOWER_DRIVER_TESTS@")
set(compiler_memory_links --link "@scc_objects@/tower-compiler-bytes.o"
  --link "@scc_objects@/tower-compiler-utf8.o" --link "@scc_objects@/libtower-compiler-memory.a")
if(driver_tests)
  set(scc_suffix_args)
  # Default owner discovery includes the five tests of its budget dependency.
  set(scc_count 7)
  if(DEFINED ENV{TOWER_SCC_TEST_SUFFIX})
    list(APPEND scc_suffix_args --test-suffix "$ENV{TOWER_SCC_TEST_SUFFIX}")
    if(NOT "$ENV{TOWER_SCC_TEST_SUFFIX}" STREQUAL "_test.tower")
      set(scc_count 2)
    endif()
  endif()
  register_language_tests(graph-components library/graph_components ${scc_count}
    ${scc_suffix_args} --link "@scc_objects@/runtime-instrumented.o" ${compiler_memory_links})
  foreach(owner IN ITEMS stack queue)
    register_language_tests(${owner} library/${owner} 2 ${compiler_memory_links})
  endforeach()
  register_language_tests(compiler-buffer-contract tests/compiler_buffer_contract 3 ${compiler_memory_links})
  register_language_tests(sha256 library/sha256 7)
  register_language_tests(float-bits library/float_bits 9)
  # Default discovery also reaches the nine float_bits declarations.
  register_language_tests(float-text library/float_text 14)
  register_language_tests(float-text-direct library/float_text_test 5)
  register_language_tests(float-text-round-trips tests/decimal_round_trips 15)
  register_language_tests(float-text-round-trips-direct tests/decimal_round_trips_test 1)
  register_language_tests(work-graph library/work_graph 13 --link "@scc_objects@/libtower-compiler-memory.a")
  register_language_tests(work-graph-direct library/work_graph_test 8 --link "@scc_objects@/libtower-compiler-memory.a")
  register_language_tests(work-budget library/work_budget 5 ${compiler_memory_links})
  register_language_tests(work-budget-direct library/work_budget_test 5 ${compiler_memory_links})
  # The serial fault fixture also discovers its budget dependency's five tests.
  set(arena_fault_links --link "@scc_objects@/runtime-instrumented.o" ${compiler_memory_links})
  register_language_tests(work-arena-faults tests/work_arena_fault_fixture 7 ${arena_fault_links})
  register_language_tests(work-arena-faults-direct tests/work_arena_fault_fixture_test 2 ${arena_fault_links})
  if("@triple@" MATCHES "^x86_64-.*linux")
    # Four real pthreads meet at the fixture barrier even at one compiler job.
    set(arena_memory --link "@scc_objects@/libtower-compiler-memory.a")
    register_language_tests(work-arena-shared tests/work_arena_shared_fixture 8 ${arena_memory})
    register_language_tests(work-arena-shared-direct tests/work_arena_shared_fixture_test 3 ${arena_memory})
  endif()
  register_language_tests(gzip library/gzip 5 --link "@scc_objects@/tower-compiler-utf8.o"
    --link "@scc_objects@/libtower-compiler-memory.a")
endif()

# The stage and page fixtures each supply their own payload finalizer.
register_language_tests(entity-stage-ownership library/entity_stage 2
  --test-suffix _ownership_test.tower ${compiler_memory_links})
register_language_tests(entity-stage-ownership-direct library/entity_stage_ownership_test 2
  --test-suffix _ownership_test.tower ${compiler_memory_links})

# Nested fixture stdout/file access belongs to the interpreter. The other
# three guests run the real entity implementation with native memory providers.
register_language_tests(entities tests/entities 6 INTERPRETED)
register_language_tests(entity-views tests/entity_views 6 --link "@scc_objects@/libtower-compiler-memory.a")
register_language_tests(generic-registry tests/generic_registry 6 --link "@scc_objects@/libtower-compiler-memory.a")
register_language_tests(entity-store tests/entity_store 6 --link "@scc_objects@/runtime-instrumented.o"
  --link "@scc_objects@/libtower-compiler-memory.a")

register_language_tests(cfg-exchange tests/semantic_statements_cfg_inputs/exchange 1 INTERPRETED)
register_language_tests(cfg-exchange-direct tests/semantic_statements_cfg_inputs/exchange_test 1 INTERPRETED)
