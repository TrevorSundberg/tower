# Compose declarations from the authoritative shared components. No copied IR.
file(READ "${ROOT}/scaffolding/library/vector.tower" source)
file(READ "${ROOT}/scaffolding/compiler/foundation-nodes.tower" nodes)
string(FIND "${nodes}" "export fn foundation_node_size" end)
string(SUBSTRING "${nodes}" 0 ${end} nodes)
string(APPEND source "\n${nodes}")
foreach(name IN ITEMS text foreign-reader foreign-declarators foreign-operators foreign-itanium foreign-microsoft foreign-api foreign-symbol bindings context target lowering pipeline disassembly linker)
  file(READ "${ROOT}/scaffolding/backend/${name}.tower" module)
  string(APPEND source "\n${module}")
endforeach()
if(HOST_TRIPLE MATCHES "windows")
  set(file_profile windows)
else()
  set(file_profile posix)
endif()
file(READ "${ROOT}/scaffolding/backend/file-${file_profile}.tower" module)
string(APPEND source "\n${module}")
if(LLVM_CONFIG_DIR AND NOT WASM_ONLY)
  # Mirror the configured upstream C target lists, including targets outside the
  # browser's intentionally smaller WebAssembly/X86/AArch64 dependency closure.
  set(module "// Generated Tower declarations from upstream configured target lists.\n")
  set(initializers "")
  foreach(spec IN ITEMS "Targets;LLVM_TARGET;TargetInfo,Target,TargetMC" "AsmPrinters;LLVM_ASM_PRINTER;AsmPrinter" "Disassemblers;LLVM_DISASSEMBLER;Disassembler")
    list(GET spec 0 file)
    list(GET spec 1 macro)
    list(GET spec 2 parts)
    string(REPLACE "," ";" parts "${parts}")
    file(STRINGS "${LLVM_CONFIG_DIR}/${file}.def" definitions REGEX "^${macro}\\(")
    foreach(definition IN LISTS definitions)
      string(REGEX REPLACE "^${macro}\\(([A-Za-z0-9_]+)\\).*$" "\\1" name "${definition}")
      foreach(part IN LISTS parts)
        string(APPEND module "extern fn LLVMInitialize${name}${part}(): void;\n\n")
        string(APPEND initializers "    LLVMInitialize${name}${part}();\n")
      endforeach()
    endforeach()
  endforeach()
  string(APPEND module "fn backend_initialize_targets(): void {\n${initializers}}\n")
elseif(WASM_ONLY)
  file(READ "${ROOT}/scaffolding/backend/targets-wasm.tower" module)
else()
  file(READ "${ROOT}/scaffolding/backend/targets-native.tower" module)
endif()
string(APPEND source "\n${module}")
if(WASI_HOST)
  foreach(name IN ITEMS wasi-support linker-wasi session session-wasi)
    file(READ "${ROOT}/scaffolding/backend/${name}.tower" module)
    string(APPEND source "\n${module}")
  endforeach()
  if(WASM_ONLY)
    set(linker_flavor wasm)
  else()
    set(linker_flavor cross)
  endif()
  file(READ "${ROOT}/scaffolding/backend/linker-wasi-${linker_flavor}.tower" module)
  string(APPEND source "\n${module}")
endif()
if(TESTS)
  file(READ "${ROOT}/scaffolding/tests/foreign-names.tower" module)
  string(APPEND source "\n${module}")
  file(READ "${ROOT}/scaffolding/tests/backend.tower" module)
  string(APPEND source "\n${module}")
endif()
file(WRITE "${OUTPUT}" "${source}")
