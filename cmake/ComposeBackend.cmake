include("${CMAKE_CURRENT_LIST_DIR}/TowerModule.cmake")
tower_import("${ROOT}/scaffolding/compiler/foundation_types.tower")
foreach(name IN ITEMS text foreign_reader foreign_declarators foreign_operators foreign_itanium foreign_microsoft foreign_api foreign_symbol bindings context target lowering pipeline import_bindings import_foundation import_values import_instructions import_module disassembly linker)
  tower_import("${ROOT}/scaffolding/backend/${name}.tower")
endforeach()
if(HOST_TRIPLE MATCHES "windows")
  set(file_profile windows)
else()
  set(file_profile posix)
endif()
tower_import("${ROOT}/scaffolding/backend/file_${file_profile}.tower")
if(LLVM_CONFIG_DIR AND NOT WASM_ONLY)
  # Mirror the configured upstream C target lists, including targets outside the
  # browser's intentionally smaller WebAssembly/X86/AArch64 dependency closure.
  set(module "import tower;\n// Generated Tower declarations from upstream configured target lists.\n")
  set(initializers "")
  foreach(spec IN ITEMS "Targets;LLVM_TARGET;TargetInfo,Target,TargetMC" "AsmPrinters;LLVM_ASM_PRINTER;AsmPrinter" "Disassemblers;LLVM_DISASSEMBLER;Disassembler")
    list(GET spec 0 file)
    list(GET spec 1 macro)
    list(GET spec 2 parts)
    string(REPLACE "," ";" parts "${parts}")
    file(STRINGS "${LLVM_CONFIG_DIR}/${file}.def" definitions REGEX "^${macro}\\(")
    foreach(definition IN LISTS definitions)
      string(REGEX REPLACE "^${macro}\\(([A-Za-z0-9_]+)\\).*$" "\\1" name "${definition}")
      foreach(part IN LISTS parts)
        string(APPEND module "extern fn LLVMInitialize${name}${part}(): void;\n\n")
        string(APPEND initializers "    LLVMInitialize${name}${part}();\n")
      endforeach()
    endforeach()
  endforeach()
  string(APPEND module "export fn backend_register_targets(): void {\n${initializers}}\n")
  string(REGEX REPLACE "\\.tower$" "" target_stem "${OUTPUT}")
  set(targets "${target_stem}_targets.tower")
  file(WRITE "${targets}" "${module}")
  tower_import("${targets}")
elseif(WASM_ONLY)
  tower_import("${ROOT}/scaffolding/backend/targets_wasm.tower")
else()
  tower_import("${ROOT}/scaffolding/backend/targets_native.tower")
endif()
if(WASI_HOST)
  set(target_once_profile wasi)
elseif(HOST_TRIPLE MATCHES "linux")
  set(target_once_profile linux)
elseif(HOST_TRIPLE MATCHES "apple|darwin")
  set(target_once_profile macos)
elseif(HOST_TRIPLE MATCHES "windows")
  set(target_once_profile windows)
else()
  message(FATAL_ERROR "No LLVM target registry initialization profile for ${HOST_TRIPLE}")
endif()
tower_import("${ROOT}/scaffolding/backend/target_once_${target_once_profile}.tower")
if(NOT WASI_HOST)
  tower_import("${ROOT}/scaffolding/backend/units.tower")
endif()
if(WASI_HOST)
  foreach(name IN ITEMS wasi_support linker_wasi reactor session session_wasi source_session)
    tower_import("${ROOT}/scaffolding/backend/${name}.tower")
  endforeach()
  if(WASM_ONLY)
    set(linker_flavor wasm)
  else()
    set(linker_flavor cross)
  endif()
  tower_import("${ROOT}/scaffolding/backend/linker_wasi_${linker_flavor}.tower")
  tower_import("${ROOT}/scaffolding/host/llvm_worker.tower")
  file(READ "${RUNTIME_SOURCE}" runtime_source)
endif()
if(TESTS)
  tower_import("${ROOT}/scaffolding/tests/foreign_names.tower")
  tower_import("${ROOT}/scaffolding/tests/backend.tower")
  if(WASI_HOST)
    tower_import("${ROOT}/scaffolding/tests/backend_source.tower")
  endif()
endif()
string(APPEND source "${runtime_source}")
file(WRITE "${OUTPUT}" "${source}")
