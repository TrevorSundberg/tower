# Imports are not implemented yet. Reuse the authoritative component definitions
# verbatim; compile their implementation only in the existing component object.
file(READ "${ROOT}/scaffolding/library/vector.tower" source)
foreach(pair IN ITEMS "foundation-nodes;export fn foundation_node_size" "parser-nodes;extern fn tower_utf8_decode")
  list(GET pair 0 name)
  list(GET pair 1 boundary)
  file(READ "${ROOT}/scaffolding/compiler/${name}.tower" module)
  string(FIND "${module}" "${boundary}" end)
  if(end LESS 0)
    message(FATAL_ERROR "Missing component declaration boundary in ${name}.tower")
  endif()
  string(SUBSTRING "${module}" 0 ${end} declarations)
  string(APPEND source "\n${declarations}")
endforeach()
foreach(name IN ITEMS context definitions support types values statements lifecycle)
  file(READ "${ROOT}/scaffolding/compiler/semantic-${name}.tower" module)
  string(APPEND source "\n${module}")
endforeach()
file(WRITE "${OUTPUT}" "${source}")
