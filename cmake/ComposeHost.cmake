# Reuse the byte-buffer declaration; its implementation remains one shared object.
file(READ "${ROOT}/scaffolding/library/bytes.tower" bytes)
string(FIND "${bytes}" "export fn bytes_init" end)
if(end LESS 0)
  message(FATAL_ERROR "ByteBuffer declaration boundary missing")
endif()
string(SUBSTRING "${bytes}" 0 ${end} source)
string(APPEND source "\nextern fn bytes_reserve(buffer: ByteBuffer*, needed: usize): bool;\nextern fn bytes_append(buffer: ByteBuffer*, source: u8*, count: usize): bool;\nextern fn bytes_push(buffer: ByteBuffer*, value: u8): bool;\nextern fn bytes_dispose(buffer: ByteBuffer*): void;\n")
file(READ "${ROOT}/scaffolding/host/memory.tower" memory)
string(APPEND source "\n${memory}")
if(DRIVER)
  file(READ "${DRIVER}" driver)
  string(APPEND source "\n${driver}")
  file(READ "${ROOT}/scaffolding/host/driver-services.tower" services)
  string(APPEND source "\n${services}")
  file(READ "${ROOT}/scaffolding/host/driver-files.tower" files)
  string(APPEND source "\n${files}")
endif()
foreach(module IN ITEMS host-text host-handles)
  file(READ "${ROOT}/scaffolding/compiler/${module}.tower" text)
  string(APPEND source "\n${text}")
endforeach()
file(READ "${ROOT}/scaffolding/host/browser-protocol.tower" protocol)
string(APPEND source "\n${protocol}")
if(TESTS)
  file(READ "${TESTS}" runtime_tests)
  file(READ "${ROOT}/scaffolding/tests/host.tower" tests)
  string(APPEND source "\n${runtime_tests}\n${tests}")
  file(READ "${ROOT}/scaffolding/tests/host-services.tower" services_tests)
  string(APPEND source "\n${services_tests}")
endif()
file(WRITE "${OUTPUT}" "${source}")
