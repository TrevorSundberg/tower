include("${CMAKE_CURRENT_LIST_DIR}/TowerModule.cmake")
tower_import("${ROOT}/scaffolding/library/bytes_interface.tower")
tower_import("${ROOT}/scaffolding/host/memory.tower")
if(MODULE_PLATFORM STREQUAL "wasi")
  tower_import("${ROOT}/scaffolding/host/module_path_wasi.tower")
else()
  tower_import("${ROOT}/scaffolding/host/module_path.tower")
  tower_import("${ROOT}/scaffolding/host/module_path_${MODULE_PLATFORM}.tower")
  if(NOT MODULE_PLATFORM STREQUAL "windows")
    tower_import("${ROOT}/scaffolding/host/module_path_posix.tower")
  endif()
endif()
if(DRIVER)
  tower_import("${DRIVER}")
  tower_import("${ROOT}/scaffolding/host/driver_services.tower")
  tower_import("${ROOT}/scaffolding/host/driver_files.tower")
endif()
foreach(name IN ITEMS host_text host_handles)
  tower_import("${ROOT}/scaffolding/compiler/${name}.tower")
endforeach()
tower_import("${ROOT}/scaffolding/host/ide_protocol.tower")
if(TESTS)
  tower_import("${TESTS}")
  tower_import("${ROOT}/scaffolding/tests/host.tower")
  tower_import("${ROOT}/scaffolding/tests/host_services.tower")
endif()
file(WRITE "${OUTPUT}" "${source}")
