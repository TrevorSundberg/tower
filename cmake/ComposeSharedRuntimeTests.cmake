file(READ "${ROOT}/scaffolding/library/vector.tower" source)
file(READ "${ROOT}/scaffolding/compiler/foundation-nodes.tower" foundation)
string(FIND "${foundation}" "export fn foundation_node_size" boundary)
if(boundary LESS 0)
  message(FATAL_ERROR "Missing shared Foundation declaration boundary")
endif()
string(SUBSTRING "${foundation}" 0 ${boundary} foundation)
file(READ "${ROOT}/scaffolding/tests/shared-entities.tower" tests)
file(WRITE "${OUTPUT}" "${source}\n${foundation}\n${tests}")
