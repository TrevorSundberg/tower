# Temporary composition until Tower imports exist. Templates precede their users.
file(READ "${VECTOR}" vector)
file(READ "${PAYLOADS}" payloads)
file(READ "${LEXER}" lexer)
file(READ "${REGEX}" regex)
file(READ "${AUTOMATON}" automaton)
file(READ "${LOWERING}" lowering)
file(READ "${LR}" lr)
file(READ "${STATES}" states)
file(READ "${LALR}" lalr)
file(READ "${RUNTIME}" runtime)
file(READ "${PARSER}" parser)
file(READ "${GRAMMAR}" grammar)
file(READ "${FOUNDATION}" foundation)
file(READ "${TREE}" tree)
file(READ "${SYNTAX_LEXER}" syntax_lexer)
file(READ "${SOURCE}" source)
file(READ "${SYNTAX}" syntax)
file(READ "${READER}" reader)
file(READ "${VALIDATION}" validation)
set(formatter "")
foreach(module IN ITEMS format format-foundation format-grammar format-source)
  file(READ "${FORMAT_DIR}/${module}.tower" part)
  string(APPEND formatter "\n${part}")
endforeach()
file(READ "${EMISSION}" emission)
file(READ "${EXPANSION}" expansion)
file(READ "${REPLACEMENTS}" replacements)
file(READ "${TEMPLATE}" template)
file(READ "${SCAN}" scan)
if(EMISSION_TESTS)
  file(READ "${EMISSION_TESTS}" emission_tests)
  file(READ "${TEMPLATE_TESTS}" template_tests)
  file(READ "${SCAN_TESTS}" scan_tests)
endif()
if(EXPANSION_TESTS)
  file(READ "${EXPANSION_TESTS}" expansion_tests)
  file(READ "${REPLACEMENT_TESTS}" replacement_tests)
endif()
file(WRITE "${OUTPUT}" "${vector}\n${payloads}\n${lexer}\n${regex}\n${automaton}\n${lowering}\n${lr}\n${states}\n${lalr}\n${runtime}\n${parser}\n${grammar}\n${tree}\n${foundation}\n${syntax_lexer}\n${source}\n${syntax}\n${reader}\n${validation}\n${formatter}\n${emission}\n${expansion}\n${replacements}\n${template}\n${scan}\n${emission_tests}\n${expansion_tests}\n${replacement_tests}\n${template_tests}\n${scan_tests}")
