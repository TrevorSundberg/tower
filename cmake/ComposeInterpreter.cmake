# Compose shared declarations, without compiling their exported implementations twice.
file(READ "${ROOT}/scaffolding/library/vector.tower" vector)
file(READ "${ROOT}/scaffolding/compiler/foundation-nodes.tower" foundation)
string(FIND "${foundation}" "export fn foundation_node_size" end)
if(end LESS 0)
  message(FATAL_ERROR "Foundation component declaration boundary missing")
endif()
string(SUBSTRING "${foundation}" 0 ${end} foundation)
file(READ "${ROOT}/scaffolding/core.hpp" core)
set(tags "")
foreach(pair IN ITEMS "CoreKind:K" "CoreOp:O" "CoreScalar:S")
  string(REPLACE ":" ";" pair "${pair}")
  list(GET pair 0 enum)
  list(GET pair 1 prefix)
  string(REGEX MATCH "enum class ${enum} \\{([^}]+)\\}" declaration "${core}")
  string(REGEX REPLACE "enum class ${enum} \\{|\\}" "" names "${declaration}")
  string(REPLACE "," ";" names "${names}")
  set(index 0)
  foreach(name IN LISTS names)
    string(STRIP "${name}" name)
    string(APPEND tags "fn ${prefix}${name}(): u32 { return ${index}; }\n")
    math(EXPR index "${index} + 1")
  endforeach()
endforeach()
file(READ "${ROOT}/scaffolding/compiler/interpreter-abi.tower" abi)
file(READ "${ROOT}/scaffolding/compiler/interpreter.tower" interpreter)
file(READ "${ROOT}/scaffolding/compiler/interpreter-storage.tower" storage)
file(READ "${ROOT}/scaffolding/compiler/fast-interpreter.tower" fast)
file(READ "${ROOT}/scaffolding/compiler/bytecode-package.tower" package)
set(tests "")
if(TESTS)
  file(READ "${ROOT}/scaffolding/tests/interpreter-storage.tower" tests)
endif()
file(WRITE "${OUTPUT}" "${vector}\n${foundation}\n${tags}\n${abi}\n${storage}\n${interpreter}\n${fast}\n${package}\n${tests}")
