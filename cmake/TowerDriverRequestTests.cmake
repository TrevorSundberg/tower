# Real compiler environments, instrumented allocations and Tower-only checks.
# This fragment runs after the ordinary driver/backend target composition.
function(tower_driver_request_tests)
  if(NOT TOWER_DRIVER_TESTS OR NOT TARGET tower-backend-native)
    return()
  endif()
  get_property(triple GLOBAL PROPERTY TOWER_COMPILER_TRIPLE)
  get_property(source GLOBAL PROPERTY TOWER_DRIVER_PRODUCTION_SOURCE)
  if(triple MATCHES "windows")
    set(platform windows)
  else()
    set(platform posix)
  endif()
  string(APPEND source "import tests.driver_request_${platform};\n")
  set(input "${CMAKE_CURRENT_BINARY_DIR}/tower_driver_request_tests.tower")
  file(GENERATE OUTPUT "${input}" CONTENT "${source}import tests.driver_request_main;\n")
  tower_runtime_object(tower-driver-request-tests "${input}" "${triple}")
  get_target_property(sources towerc SOURCES)
  list(REMOVE_ITEM sources "${CMAKE_CURRENT_BINARY_DIR}/tower-driver.o")
  get_target_property(libraries towerc LINK_LIBRARIES)
  list(REMOVE_ITEM libraries tower-compiler-interpreter)
  tower_compiler_evaluation()
  list(APPEND libraries tower-compiler-evaluation)
  get_property(runtime_instrumented GLOBAL PROPERTY TOWER_RUNTIME_INSTRUMENTED_OBJECT)
  add_executable(tower-driver-request-tests ${sources} "${tower-driver-request-tests_OBJECT}" "${runtime_instrumented}")
  set_target_properties(tower-driver-request-tests PROPERTIES LINKER_LANGUAGE CXX)
  target_compile_options(tower-driver-request-tests PRIVATE -fno-exceptions)
  target_compile_definitions(tower-driver-request-tests PRIVATE TOWER_COMPILER_MEMORY_TESTS=1)
  target_link_libraries(tower-driver-request-tests PRIVATE ${libraries})
  add_test(NAME tower-driver-request COMMAND tower-driver-request-tests "${CMAKE_CURRENT_BINARY_DIR}/share/tower")
  set_tests_properties(tower-driver-request PROPERTIES WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/tower-driver-checks")

  if(NOT CMAKE_CROSSCOMPILING AND NOT TOWER_SANITIZER AND triple MATCHES "^x86_64-.*linux.*gnu")
    # Supply the selected guest with the standalone's platform and allocation services.
    set(provider "${CMAKE_CURRENT_BINARY_DIR}/tower_driver_request_services.tower")
    file(GENERATE OUTPUT "${provider}" CONTENT "${source}")
    tower_runtime_object(driver-request-platform "${provider}" "${triple}")
    add_library(tower-driver-request-services SHARED ${sources} "${driver-request-platform_OBJECT}" "${runtime_instrumented}")
    set_target_properties(tower-driver-request-services PROPERTIES LINKER_LANGUAGE CXX)
    target_link_libraries(tower-driver-request-services PRIVATE ${libraries})
    target_link_options(tower-driver-request-services PRIVATE "LINKER:-z,defs")
    get_property(guest GLOBAL PROPERTY TOWER_GUEST_native-test_OBJECT)
    add_dependencies(tower-driver-request-tests tower-driver-request-services tower-selected-test-count tower-guest-native-test)
    foreach(selection IN ITEMS owner direct)
      set(file driver_request)
      if(selection STREQUAL "direct")
        set(file driver_request_test)
      endif()
      set(entry "${CMAKE_CURRENT_SOURCE_DIR}/scaffolding/tests/${file}.tower")
      foreach(jobs IN ITEMS 1 4)
        set(name "tower-driver-request-${selection}-jobs-${jobs}")
        add_test(NAME "${name}" COMMAND tower-selected-test-count "5 tests passed for ${entry}"
          "${TOWER_BOOTSTRAP_COMPILER}" --test "${entry}" --jobs "${jobs}" --test-details
          --test-native-runtime "${guest}" --link "$<TARGET_FILE:tower-driver-request-services>"
          --link "-Wl,-rpath,$<TARGET_FILE_DIR:tower-driver-request-services>")
        set_tests_properties("${name}" PROPERTIES WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/tower-driver-checks"
          ENVIRONMENT "TOWER_DRIVER_REQUEST_ROOT=${CMAKE_CURRENT_BINARY_DIR}/share/tower" TIMEOUT 60 LABELS "native;focused")
      endforeach()
    endforeach()
  endif()
endfunction()
