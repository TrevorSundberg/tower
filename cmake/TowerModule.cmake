# Generate a module manifest. Tower owns dependency discovery, ordering, parsing,
# identity and diagnostics; CMake selects the platform's implementation modules.
set(source "import tower;\n")
function(tower_import path)
  get_filename_component(directory "${OUTPUT}" DIRECTORY)
  get_filename_component(absolute "${path}" ABSOLUTE)
  get_filename_component(library "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scaffolding" ABSOLUTE)
  file(RELATIVE_PATH name "${library}" "${absolute}")
  if(name MATCHES "^\\.\\./" OR IS_ABSOLUTE "${name}")
    file(RELATIVE_PATH name "${directory}" "${absolute}")
  endif()
  if(IS_ABSOLUTE "${name}")
    # Separate Windows drives have no relative spelling. Keep the complete path.
    set(spelling "\"${name}\"")
  else()
    string(REGEX REPLACE "\\.tower$" "" name "${name}")
    set(spelling "")
    while(name MATCHES "^\\.\\./")
      string(APPEND spelling ".")
      string(SUBSTRING "${name}" 3 -1 name)
    endwhile()
    string(REPLACE "/" ";" parts "${name}")
    set(separator "")
    foreach(part IN LISTS parts)
      if(NOT part MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        # User-selected checkout/build directories need not follow our naming rule.
        string(REPLACE "`" "\\`" part "${part}")
        set(part "`${part}`")
      endif()
      string(APPEND spelling "${separator}${part}")
      set(separator ".")
    endforeach()
  endif()
  set(source "${source}import ${spelling};\n" PARENT_SCOPE)
endfunction()
