import session;
import backend.text;

fn malformed(file: u8*): void {
    run_file(file);
    expect_field("status", "error", file);
    assert(execution_steps() == 0, file);
    var error = execution_text("error");
    defer free(error);
    assert(backend_contains(error, "Missing foundation tree") || backend_contains(error, "missing capture"), file);
}

test() {
    malformed("core_if.tower");
    malformed("core_assign.tower");
    malformed("core_call_statement.tower");
    malformed("core_address.tower");
    malformed("core_load.tower");
    malformed("core_call.tower");
    malformed("core_function.tower");
}
