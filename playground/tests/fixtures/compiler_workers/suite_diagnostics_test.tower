import suite;

test() {
    var first = "semantic_invalid/enum_number.tower";
    var second = "semantic_invalid/enum_mix.tower";
    var serial = completed(start_invalid(first, second, 1, 0));
    var parallel = completed(start_invalid(first, second, 2, 0));
    check_failure(serial, parallel);
    assert(admissions(parallel) == 2, "Failure must prevent admission of later units");
    assert(publication_count(parallel) == 0, "Failed build published an object");
}
