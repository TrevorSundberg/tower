import platform_observations;

fn check_compiled(fixture: u8*): void {
    platform_llvm(fixture);
    if (!field_is("compilation", "compiled")) {
        var diagnostic = observed("diagnostic");
        defer free(diagnostic.data);
        assert(false, diagnostic.data);
    }
}

test() {
    check_compiled("provider");
    check_compiled("consumer");

    platform_llvm("direct");
    assert(field_is("output", "42\n"), "Call the exported function directly");
    platform_llvm("table");
    assert(field_is("output", "42\n"), "Call the function retrieved from the Wasm table");
}
