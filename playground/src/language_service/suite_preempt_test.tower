import suite;
import reply_test;

test() {
    var document = request("document", '{"method":"document"}');
    var completion = request("complete", '{"method":"complete"}');
    assert(is_null(await_result(document)), "Preempted document resolves to null");
    assert(terminated(0), "Preempted document worker retired");
    assert(worker_count() == 2, "Foreground completion created a second worker");
    assert(text_is(posted_field(1, 0, "method"), "complete"), "Replacement worker received completion");

    var id = posted_id(1, 0);
    reply(0, id, '{"options":["stale"]}');
    reply(1, id, '{"options":["current"]}');
    var options = reply_array(await_result(completion), "options", 1);
    assert(text_is(field(options, "0"), "current"), "Completion uses the current worker reply");
}
