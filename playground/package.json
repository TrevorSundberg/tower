{
  "name": "tower-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "npm run test:ide && node --test tests/*.test.mjs",
    "test:ide": "node scripts/test-ide.mjs",
    "test:roku": "node --test --test-concurrency=1 tests/roku/*.test.mjs",
    "test:browser": "playwright test",
    "test:compiler": "node scripts/test-compiler-project.mjs",
    "test:deployment": "node scripts/verify-local.mjs",
    "profile": "node scripts/profile-execution.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@lezer/highlight": "1.2.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "brighterscript": "0.73.8",
    "brs-node": "2.7.1",
    "esbuild": "0.25.12"
  }
}
